@{
    ViewData["Title"] = "Campus Setup";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3">Campus Setup</h4>

                    <div id="msgBox" class="alert d-none"></div>

                    <input type="hidden" id="CampusId" />

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Campus Name</label>
                            <input type="text" id="Name" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Campus Code</label>
                            <input type="text" id="Code" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Campus Type</label>
                            <select id="CampusType" class="form-select">
                                <option value="">Select</option>
                                <option value="Main">Main</option>
                                <option value="Branch">Branch</option>
                                <option value="Academic">Academic</option>
                                <option value="Administrative">Administrative</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Contact Number</label>
                            <input type="text" id="ContactNumber" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email" id="Email" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Country</label>
                            <input type="text" id="Country" class="form-control" value="Bangladesh" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Division</label>
                            <input type="text" id="Division" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">District</label>
                            <input type="text" id="District" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Thana</label>
                            <input type="text" id="Thana" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Post Code</label>
                            <input type="text" id="PostCode" class="form-control" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Address</label>
                            <textarea id="Address" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Principal Name</label>
                            <input type="text" id="PrincipalName" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Head Name</label>
                            <input type="text" id="HeadName" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Display Order</label>
                            <input type="number" id="DisplayOrder" class="form-control" value="1" min="1" />
                        </div>

                        <div class="col-md-3">
                            <div class="form-check mt-4">
                                <input class="form-check-input" type="checkbox" id="IsMainCampus" />
                                <label class="form-check-label" for="IsMainCampus">Main Campus</label>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-check mt-4">
                                <input class="form-check-input" type="checkbox" id="IsActive" checked />
                                <label class="form-check-label" for="IsActive">Active</label>
                            </div>
                        </div>

                        <div class="col-12 mt-3">
                            <button type="button" id="btnSave" class="btn btn-primary">
                                Save Campus
                            </button>
                            <button type="button" id="btnReset" class="btn btn-outline-secondary ms-2">
                                Reset
                            </button>
                            <a href="/Dashboard/Index" class="btn btn-outline-dark ms-2">
                                Dashboard
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold mb-0">Campus List</h4>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered align-middle" id="campusTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Code</th>
                                    <th>Type</th>
                                    <th>Contact</th>
                                    <th>Main</th>
                                    <th>Active</th>
                                    <th style="width:140px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="7" class="text-center text-muted">Loading...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-3">
                        <a href="/Account/AcademicSetup" class="btn btn-success">
                            Save & Continue
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/account/campusSetup.js"></script>
}