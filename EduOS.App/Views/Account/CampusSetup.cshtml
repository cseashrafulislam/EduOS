@{
    ViewData["Title"] = "Campus Setup";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-11">

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-lg-5">

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                        <div>
                            <h3 class="fw-bold mb-2">Campus Setup</h3>
                            <p class="text-muted mb-0">
                                Add your main campus or branch campuses to continue onboarding.
                            </p>
                        </div>

                        <button type="button"
                                class="btn btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#campusModal">
                            <i class="bi bi-plus-circle me-1"></i>
                            Add Campus
                        </button>
                    </div>

                    <div id="alertContainer"></div>

                    <div id="campusList">
                        <div class="text-center py-4 text-muted">
                            Loading campuses...
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a href="/Account/PlanSelection" class="btn btn-outline-secondary">
                            Back
                        </a>

                        <button type="button" id="continueBtn" class="btn btn-success" disabled>
                            Continue
                        </button>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="campusModal" tabindex="-1" aria-labelledby="campusModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">

            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="campusModalLabel">Campus Information</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="campusForm" novalidate>
                <div class="modal-body">
                    <input type="hidden" id="campusId" name="id" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="campusName" class="form-label">
                                Campus Name <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="campusName" name="name" class="form-control" />
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="col-md-6">
                            <label for="campusCode" class="form-label">Campus Code</label>
                            <input type="text" id="campusCode" name="code" class="form-control" />
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="col-md-6">
                            <label for="campusPhone" class="form-label">Phone</label>
                            <input type="text" id="campusPhone" name="phone" class="form-control" />
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="col-md-6">
                            <label for="campusEmail" class="form-label">Email</label>
                            <input type="email" id="campusEmail" name="email" class="form-control" />
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="col-12">
                            <label for="campusAddress" class="form-label">Address</label>
                            <textarea id="campusAddress" name="address" class="form-control" rows="3"></textarea>
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="col-md-6">
                            <label for="campusHeadName" class="form-label">Head Name</label>
                            <input type="text" id="campusHeadName" name="headName" class="form-control" />
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="isHeadOffice" name="isHeadOffice" />
                                <label class="form-check-label" for="isHeadOffice">
                                    Head Office / Main Campus
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" id="saveCampusBtn" class="btn btn-primary">
                        Save campus
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/account/campus-setup.js"></script>
}