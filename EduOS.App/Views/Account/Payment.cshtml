@{
    ViewData["Title"] = T["PaymentTitle"];
    Layout = "_OnboardingLayout";

    var bangladeshToday = DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(6)).ToString("yyyy-MM-dd");
    var pageStrings = new
    {
        culture = CultureInfo.CurrentUICulture.Name,
        isBangla = CultureInfo.CurrentUICulture.Name.StartsWith("bn", StringComparison.OrdinalIgnoreCase),
        noInvoice = T["NoInvoiceSelected"].Value,
        invoiceLoadFailed = T["InvoiceLoadFailed"].Value,
        invoiceTemplate = T["InvoiceLabelTemplate"].Value,
        subscription = T["Subscription"].Value,
        discount = T["Discount"].Value,
        tax = T["Tax"].Value,
        totalDue = T["TotalDue"].Value,
        periodTemplate = T["BillingPeriodTemplate"].Value,
        loading = T["Loading"].Value,
        retry = T["Retry"].Value,
        networkError = T["NetworkError"].Value,
        initiating = T["PaymentInitiating"].Value,
        payTemplate = T["PaySecurelyTemplate"].Value,
        gatewayFailed = T["PaymentGatewayFailed"].Value,
        invalidGatewayUrl = T["InvalidGatewayUrl"].Value,
        bankUnavailable = T["ManualPaymentUnavailable"].Value,
        bank = T["BankLabel"].Value,
        accountName = T["AccountNameLabel"].Value,
        accountNumber = T["AccountNumberLabel"].Value,
        routingNumber = T["RoutingNumberLabel"].Value,
        branch = T["BranchLabel"].Value,
        reference = T["ReferenceLabel"].Value,
        receiptRequired = T["DepositSlipRequired"].Value,
        receiptInvalid = T["DepositSlipInvalid"].Value,
        requiredFields = T["ManualPaymentFieldsRequired"].Value,
        submitting = T["Submitting"].Value,
        submitLabel = T["SubmitForVerification"].Value,
        submitFailed = T["ManualPaymentSubmitFailed"].Value,
        submitted = T["ManualPaymentSubmitted"].Value,
        alreadyPaid = T["InvoiceAlreadyPaid"].Value,
        awaiting = T["PaymentAwaitingVerification"].Value,
        processing = T["PaymentProcessing"].Value,
        continueSetup = T["ContinueSetup"].Value,
        reload = T["ReloadStatus"].Value
    };
    var pageJson = System.Text.Json.JsonSerializer.Serialize(pageStrings);
}

<article class="setup-page payment-page" aria-labelledby="paymentTitle">
    <header class="setup-header">
        <div>
            <p class="dashboard-eyebrow">@T["Onboarding_Payment_Name"]</p>
            <h2 id="paymentTitle">@T["PaymentTitle"]</h2>
            <p>@T["PaymentHelp"]</p>
        </div>
    </header>

    <div id="alertContainer" class="d-none" role="alert" tabindex="-1"></div>
    <div id="paymentStatus" class="d-none payment-status-panel" role="status" aria-live="polite"></div>

    <div class="payment-layout">
        <section class="payment-methods" aria-labelledby="paymentMethodTitle">
            <div class="setup-section-heading">
                <h3 id="paymentMethodTitle">@T["PaymentMethod"]</h3>
            </div>

            <div class="payment-method-grid" id="paymentMethods">
                <button type="button" class="payment-method-card" data-method="aamarpay" aria-pressed="false">
                    <span class="payment-method-icon" aria-hidden="true">⌁</span>
                    <span>
                        <strong>@T["OnlinePayment"]</strong>
                        <small>@T["OnlinePaymentHelp"]</small>
                    </span>
                    <span aria-hidden="true">›</span>
                </button>

                <button type="button" class="payment-method-card" data-method="manual" aria-pressed="false">
                    <span class="payment-method-icon" aria-hidden="true">৳</span>
                    <span>
                        <strong>@T["BankTransfer"]</strong>
                        <small>@T["BankTransferHelp"]</small>
                    </span>
                    <span aria-hidden="true">›</span>
                </button>
            </div>

            <div id="aamarpaySection" class="payment-method-section" hidden>
                <p class="setup-info-note">@T["SecureGatewayHelp"]</p>
                <button type="button" class="btn btn-primary btn-lg w-100" id="payOnlineBtn"
                        data-loading-label="@T["PaymentInitiating"]">
                    @T["PaySecurely"] <span id="onlineAmountLabel">৳0</span>
                </button>
            </div>

            <div id="manualSection" class="payment-method-section" hidden>
                <section class="bank-information" aria-labelledby="bankInformationTitle">
                    <h3 id="bankInformationTitle">@T["BankAccountHeading"]</h3>
                    <div id="bankDetails" aria-live="polite">
                        <p class="text-muted mb-0">@T["LoadingBankInfo"]</p>
                    </div>
                </section>

                <form id="manualForm" enctype="multipart/form-data" novalidate>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="payerBankName" class="form-label">@T["PayerBankName"] <span class="required-mark">*</span></label>
                            <input type="text" id="payerBankName" name="payerBankName" class="form-control" maxlength="150" required autocomplete="organization" />
                        </div>
                        <div class="col-md-6">
                            <label for="payerAccountNumber" class="form-label">@T["PayerAccountNumber"] <span class="required-mark">*</span></label>
                            <input type="text" id="payerAccountNumber" name="payerAccountNumber" class="form-control" maxlength="100" required inputmode="numeric" autocomplete="off" />
                        </div>
                        <div class="col-md-6">
                            <label for="depositSlipNumber" class="form-label">@T["DepositSlipNumber"] <span class="required-mark">*</span></label>
                            <input type="text" id="depositSlipNumber" name="depositSlipNumber" class="form-control" maxlength="100" required autocomplete="off" />
                        </div>
                        <div class="col-md-6">
                            <label for="depositDate" class="form-label">@T["DepositDate"] <span class="required-mark">*</span></label>
                            <input type="date" id="depositDate" name="depositDate" class="form-control" max="@bangladeshToday" required />
                        </div>
                        <div class="col-md-6">
                            <label for="manualAmount" class="form-label">@T["AmountPaid"]</label>
                            <input type="number" id="manualAmount" name="amount" class="form-control" step="0.01" readonly aria-readonly="true" />
                        </div>
                        <div class="col-md-6">
                            <label for="paymentNote" class="form-label">@T["NoteOptional"]</label>
                            <input type="text" id="paymentNote" name="note" class="form-control" maxlength="500" />
                        </div>
                        <div class="col-12">
                            <label for="depositSlipFile" class="form-label">@T["UploadDepositSlip"] <span class="required-mark">*</span></label>
                            <label class="receipt-upload" id="uploadZone" for="depositSlipFile">
                                <input type="file" name="depositSlip" id="depositSlipFile" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" required />
                                <span class="receipt-upload-icon" aria-hidden="true">⇧</span>
                                <span id="uploadText">@T["UploadReceiptHelp"]</span>
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 mt-3" id="submitManualBtn"
                            data-idle-label="@T["SubmitForVerification"]" data-loading-label="@T["Submitting"]">
                        @T["SubmitForVerification"]
                    </button>
                    <p class="payment-verification-note">@T["ManualVerificationTime"]</p>
                </form>
            </div>
        </section>

        <aside class="invoice-summary" aria-labelledby="orderSummaryTitle">
            <h3 id="orderSummaryTitle">@T["OrderSummary"]</h3>
            <div id="invoiceDetails" aria-live="polite" aria-busy="true">
                <div class="setup-empty-state" role="status">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span>@T["Loading"]</span>
                </div>
            </div>
        </aside>
    </div>
</article>

<script id="paymentStrings" type="application/json">@Html.Raw(pageJson)</script>
<script src="~/js/account/payment.js" asp-append-version="true"></script>
