@{
    ViewData["Title"] = "Signup Success";
    Layout = "_PublicLayout";
}

<section class="status-card" aria-labelledby="signupSuccessTitle">
    <div class="status-mark" aria-hidden="true">✓</div>
    <h1 id="signupSuccessTitle">@T["SignupSuccessTitle"]</h1>
    <p>@T["SignupSuccessMessage"]</p>
    <a href="/Account/Login" class="btn btn-primary auth-primary-action mt-4 px-4">@T["GoToLogin"]</a>
</section>
