@{
    ViewData["Title"] = "Setup complete";
    Layout = "_Layout";
}

<section class="status-card in-app-status" aria-labelledby="onboardingCompleteTitle">
    <div class="status-mark" aria-hidden="true">✓</div>
    <h1 id="onboardingCompleteTitle">@T["OnboardingReadyTitle"]</h1>
    <p>@T["OnboardingReadyMessage"]</p>

    <div class="next-steps">
        <div class="fw-bold mb-2 small text-uppercase text-muted">@T["SuggestedNextSteps"]</div>
        <div class="next-step-item"><span class="next-step-check" aria-hidden="true">✓</span><span>@T["AddStudentsTeachers"]</span></div>
        <div class="next-step-item"><span class="next-step-check" aria-hidden="true">✓</span><span>@T["SetupClassesSubjects"]</span></div>
        <div class="next-step-item"><span class="next-step-check" aria-hidden="true">✓</span><span>@T["ConfigureFeeStructure"]</span></div>
        <div class="next-step-item"><span class="next-step-check" aria-hidden="true">✓</span><span>@T["InviteTeamMembers"]</span></div>
    </div>

    <div class="d-grid gap-2">
        <a href="/Dashboard" class="btn btn-primary auth-primary-action">@T["GoToDashboard"]</a>
        <a href="/Account/InstitutionProfile" class="btn btn-link text-muted">@T["ReviewSettings"]</a>
    </div>
</section>
