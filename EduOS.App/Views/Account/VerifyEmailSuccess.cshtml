@{
    ViewData["Title"] = "Email Verified";
    Layout = "_PublicLayout";
}

<section class="status-card" aria-labelledby="verifiedTitle">
    <div class="status-mark" aria-hidden="true">✓</div>
    <h1 id="verifiedTitle">@T["EmailVerifiedTitle"]</h1>
    <p>@T["EmailVerifiedMessage"]</p>
    <a href="/Account/Login" class="btn btn-primary auth-primary-action mt-4 px-4">@T["GoToLogin"]</a>
</section>
