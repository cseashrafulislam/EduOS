@section Scripts {

    <script src="~/js/account/academic-setup.js"
            asp-append-version="true">
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // ============================================================
            // MAIN ADD TERM BUTTON
            // ============================================================

            const addTermMainBtn = document.getElementById('addTermMainBtn');

            if (addTermMainBtn) {

                addTermMainBtn.addEventListener('click', function (e) {

                    if (!Array.isArray(window.academicYears) &&
                        typeof academicYears === 'undefined') {
                        return;
                    }

                    const years = typeof academicYears !== 'undefined'
                        ? academicYears
                        : [];

                    if (years.length === 0) {

                        e.preventDefault();
                        e.stopPropagation();

                        const modalElement =
                            document.getElementById('termModal');

                        const existingModal =
                            bootstrap.Modal.getInstance(modalElement);

                        if (existingModal) {
                            existingModal.hide();
                        }

                        if (typeof showAlert === 'function') {
                            showAlert(
                                'warning',
                                'Please create an academic year before adding a term.'
                            );
                        }

                        return;
                    }

                    if (typeof resetTermForm === 'function') {
                        resetTermForm();
                    }

                    if (typeof populateAcademicYearDropdown === 'function') {
                        populateAcademicYearDropdown();
                    }

                    const title =
                        document.getElementById('termModalLabel');

                    if (title) {
                        title.textContent = 'Add Academic Term';
                    }

                    const label =
                        document.getElementById('termYearLabel');

                    if (label) {
                        label.textContent = 'Select an academic year';
                    }
                });
            }

        });
    </script>
}
