<article class="setup-page" aria-labelledby="academicSetupTitle">
    <header class="setup-header setup-header-actions">
        <div>
            <p class="dashboard-eyebrow">@T["Onboarding_AcademicSetup_Name"]</p>
            <h2 id="academicSetupTitle">@T["AcademicSetupTitle"]</h2>
            <p>@T["AcademicSetupHelp"]</p>
