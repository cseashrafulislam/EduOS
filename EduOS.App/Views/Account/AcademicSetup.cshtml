@{
    ViewData["Title"] = "Academic Setup";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-11">

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-lg-5">

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                        <div>
                            <h3 class="fw-bold mb-2">Academic Setup</h3>
                            <p class="text-muted mb-0">
                                Add academic years and optional terms/semesters for your institution.
                            </p>
                        </div>

                        <button type="button"
                                class="btn btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#academicYearModal">
                            <i class="bi bi-plus-circle me-1"></i>
                            Add Academic Year
                        </button>
                    </div>

                    <div id="alertContainer"></div>

                    <div id="yearList">
                        <div class="text-center py-4 text-muted">
                            Loading academic years...
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a href="/Account/CampusSetup" class="btn btn-outline-secondary">
                            Back
                        </a>

                        <button type="button" id="continueBtn" class="btn btn-success" disabled>
                            Continue
                        </button>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<!-- Academic Year Modal -->
<div class="modal fade" id="academicYearModal" tabindex="-1" aria-labelledby="academicYearModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">

            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="academicYearModalLabel">Academic Year</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="academicYearForm" novalidate>
                <div class="modal-body">
                    <input type="hidden" id="yearId" name="id" />

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label for="yearName" class="form-label">
                                Year Name <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   id="yearName"
                                   name="name"
                                   class="form-control"
                                   placeholder="2026 or 2026-2027" />
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="col-md-6">
                            <label for="yearStartDate" class="form-label">
                                Start Date <span class="text-danger">*</span>
                            </label>
                            <input type="date"
                                   id="yearStartDate"
                                   name="startDate"
                                   class="form-control" />
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="col-md-6">
                            <label for="yearEndDate" class="form-label">
                                End Date <span class="text-danger">*</span>
                            </label>
                            <input type="date"
                                   id="yearEndDate"
                                   name="endDate"
                                   class="form-control" />
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="col-12">
                            <div class="form-check mt-2">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="isCurrent"
                                       name="isCurrent" />
                                <label class="form-check-label" for="isCurrent">
                                    Mark as current academic year
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" id="saveYearBtn" class="btn btn-primary">
                        Save year
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- Academic Term Modal -->
<div class="modal fade" id="termModal" tabindex="-1" aria-labelledby="termModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">

            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold" id="termModalLabel">Academic Term</h5>
                    <div id="termYearLabel" class="small text-muted"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="termForm" novalidate>
                <div class="modal-body">
                    <input type="hidden" id="termId" name="id" />

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label for="termYearId" class="form-label">
                                Academic Year <span class="text-danger">*</span>
                            </label>
                            <select id="termYearId" name="academicYearId" class="form-select">
                                <option value="">Select academic year</option>
                            </select>
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="col-md-12">
                            <label for="termName" class="form-label">
                                Term Name <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   id="termName"
                                   name="name"
                                   class="form-control"
                                   placeholder="Term 1 / Semester 1" />
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="col-md-6">
                            <label for="termStartDate" class="form-label">Start Date</label>
                            <input type="date"
                                   id="termStartDate"
                                   name="startDate"
                                   class="form-control" />
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="col-md-6">
                            <label for="termEndDate" class="form-label">End Date</label>
                            <input type="date"
                                   id="termEndDate"
                                   name="endDate"
                                   class="form-control" />
                            <div class="invalid-feedback"></div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" id="saveTermBtn" class="btn btn-primary">
                        Save term
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/account/academic-setup.js"></script>
}