@{
    ViewData["Title"] = "Payment cancelled";
    Layout = "_Layout";
}

<section class="status-card in-app-status" aria-labelledby="paymentCancelledTitle">
    <div class="status-mark status-mark-warning" aria-hidden="true">!</div>
    <h1 id="paymentCancelledTitle">@T["PaymentCancelledTitle"]</h1>
    <p>@T["PaymentCancelledMessage"]</p>

    <div class="d-grid gap-2 mt-4">
        <a href="/Account/PlanSelection" class="btn btn-primary auth-primary-action">@T["ChoosePlan"]</a>
        <a href="/Dashboard" class="btn btn-link text-muted">@T["BackToDashboard"]</a>
    </div>
</section>
