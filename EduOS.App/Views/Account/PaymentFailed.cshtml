@{
    ViewData["Title"] = "Payment failed";
    Layout = "_Layout";
}

<section class="status-card in-app-status" aria-labelledby="paymentFailedTitle">
    <div class="status-mark status-mark-danger" aria-hidden="true">×</div>
    <h1 id="paymentFailedTitle">@T["PaymentFailedTitle"]</h1>
    <p>@T["PaymentFailedMessage"]</p>
    <p class="small">@T["PaymentFailureReasons"]</p>

    <div class="d-grid gap-2 mt-4">
        <a href="/Account/PlanSelection" class="btn btn-primary auth-primary-action">@T["TryAgain"]</a>
        <a href="/Dashboard" class="btn btn-link text-muted">@T["ContinueWithTrial"]</a>
    </div>
</section>
