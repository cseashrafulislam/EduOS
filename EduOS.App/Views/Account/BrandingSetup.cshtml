@using EduOS.Core.Settings
@using Microsoft.Extensions.Options
@inject IOptions<TenantPortalSettings> PortalOptions
@{
    ViewData["Title"] = "BrandingSetupTitle";
    Layout = "_OnboardingLayout";
    var baseDomain = (PortalOptions.Value.BaseDomain ?? "eduos.com").Trim().Trim('.');
    var pageStrings = new
    {
        loading = T["Loading"].Value,
        loadFailed = T["ProfileLoadFailed"].Value,
        networkError = T["NetworkError"].Value,
        checking = T["CheckingAvailability"].Value,
        available = T["SubdomainAvailable"].Value,
        unavailable = T["SubdomainUnavailable"].Value,
        checkFailed = T["SubdomainCheckFailed"].Value,
        subdomainSaved = T["SubdomainSaved"].Value,
        saveSubdomain = T["SaveSubdomain"].Value,
        subdomainSaveFailed = T["SubdomainSaveFailed"].Value,
        uploadSuccess = T["UploadedSuccessfully"].Value,
        uploadFailed = T["UploadFailed"].Value,
        removeFailed = T["RemoveFailed"].Value,
        removeLogoConfirm = T["RemoveLogoConfirm"].Value,
        removeFaviconConfirm = T["RemoveFaviconConfirm"].Value,
        logoAlt = T["LogoPreview"].Value,
        faviconAlt = T["FaviconPreview"].Value,
        saving = T["Saving"].Value,
        saveAndContinue = T["SaveAndContinue"].Value,
        saveFailed = T["BrandingSaveFailed"].Value,
        stepFailed = T["StepCompletionFailed"].Value,
        continueSetup = T["ContinueSetup"].Value,
        dashboard = T["Dashboard"].Value
    };
    var pageJson = System.Text.Json.JsonSerializer.Serialize(pageStrings);
}

<article class="setup-page" aria-labelledby="brandingSetupTitle">
    <header class="setup-header">
        <div>
            <p class="dashboard-eyebrow">@T["Onboarding_BrandingSetup_Name"]</p>
            <h2 id="brandingSetupTitle">@T["BrandingSetupTitle"]</h2>
            <p>@T["BrandingSetupHelp"]</p>
        </div>
    </header>

    <div id="alertContainer" class="d-none" role="alert" tabindex="-1"></div>

    <section class="setup-section" aria-labelledby="portalAddressTitle">
        <div class="setup-section-heading">
            <h3 id="portalAddressTitle">@T["PortalAddress"]</h3>
            <p>@T["PortalAddressHelp"]</p>
        </div>
        <div class="portal-address-row">
            <div>
                <label class="form-label" for="subdomainInput">@T["PortalSubdomain"] <span class="required-mark">*</span></label>
                <div class="input-group">
                    <input id="subdomainInput" class="form-control font-monospace" type="text"
                           minlength="3" maxlength="50" pattern="[a-z0-9](?:[a-z0-9-]*[a-z0-9])?"
                           autocomplete="off" autocapitalize="none" spellcheck="false"
                           placeholder="@T["SubdomainPlaceholder"]" required />
                    <span class="input-group-text">.@baseDomain</span>
                </div>
                <div id="availabilityMsg" class="availability-msg" aria-live="polite"></div>
            </div>
            <button type="button" class="btn btn-outline-primary align-self-end" id="saveSubdomainBtn" data-idle-label="@T["SaveSubdomain"]" disabled>
                @T["SaveSubdomain"]
            </button>
        </div>
    </section>

    <section class="setup-section" aria-labelledby="assetsTitle">
        <div class="setup-section-heading">
            <h3 id="assetsTitle">@T["LogoAndFavicon"]</h3>
            <p>@T["BrandAssetsHelp"]</p>
        </div>
        <div class="brand-assets-grid">
            <div class="brand-asset-card">
                <span class="form-label">@T["Logo"]</span>
                <button type="button" id="logoPreview" class="brand-asset-preview logo-preview" aria-label="@T["UploadLogo"]">
                    <span class="brand-asset-placeholder" aria-hidden="true">L</span>
                </button>
                <div class="brand-asset-actions">
                    <button type="button" class="btn btn-outline-primary btn-sm" id="uploadLogoBtn">@T["Upload"]</button>
                    <button type="button" class="btn btn-outline-danger btn-sm" id="removeLogoBtn" hidden>@T["Remove"]</button>
                </div>
                <small class="text-muted">@T["LogoUploadHelp"]</small>
                <input type="file" id="logoInput" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" hidden />
            </div>
            <div class="brand-asset-card">
                <span class="form-label">@T["Favicon"]</span>
                <button type="button" id="faviconPreview" class="brand-asset-preview favicon-preview" aria-label="@T["UploadFavicon"]">
                    <span class="brand-asset-placeholder" aria-hidden="true">F</span>
                </button>
                <div class="brand-asset-actions">
                    <button type="button" class="btn btn-outline-primary btn-sm" id="uploadFaviconBtn">@T["Upload"]</button>
                    <button type="button" class="btn btn-outline-danger btn-sm" id="removeFaviconBtn" hidden>@T["Remove"]</button>
                </div>
                <small class="text-muted">@T["FaviconUploadHelp"]</small>
                <input type="file" id="faviconInput" accept=".jpg,.jpeg,.png,image/jpeg,image/png" hidden />
            </div>
        </div>
    </section>

    <form id="brandingForm" class="setup-form">
        <section class="setup-section" aria-labelledby="brandColorsTitle">
            <div class="setup-section-heading">
                <h3 id="brandColorsTitle">@T["BrandColors"]</h3>
                <p>@T["BrandColorsHelp"]</p>
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="primaryColorText">@T["PrimaryColor"]</label>
                    <div class="color-input-group">
                        <input type="color" class="color-swatch" id="primaryColor" value="#1E40AF" aria-label="@T["PrimaryColor"]" />
                        <input type="text" class="form-control font-monospace" id="primaryColorText" value="#1E40AF" maxlength="7" pattern="#[0-9A-Fa-f]{6}" required />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="secondaryColorText">@T["SecondaryColor"]</label>
                    <div class="color-input-group">
                        <input type="color" class="color-swatch" id="secondaryColor" value="#64748B" aria-label="@T["SecondaryColor"]" />
                        <input type="text" class="form-control font-monospace" id="secondaryColorText" value="#64748B" maxlength="7" pattern="#[0-9A-Fa-f]{6}" required />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="accentColorText">@T["AccentColor"]</label>
                    <div class="color-input-group">
                        <input type="color" class="color-swatch" id="accentColor" value="#F59E0B" aria-label="@T["AccentColor"]" />
                        <input type="text" class="form-control font-monospace" id="accentColorText" value="#F59E0B" maxlength="7" pattern="#[0-9A-Fa-f]{6}" required />
                    </div>
                </div>
            </div>
        </section>

        <div class="setup-guidance" role="note">@T["BrandingRequiredNote"]</div>
        <footer class="setup-actions">
            <a asp-controller="Account" asp-action="ModuleSetup" class="btn btn-outline-secondary">@T["Back"]</a>
            <button type="submit" id="saveBrandingBtn" class="btn btn-primary" data-idle-label="@T["SaveAndContinue"]" data-loading-label="@T["Saving"]">@T["SaveAndContinue"]</button>
        </footer>
    </form>
</article>

<script id="brandingSetupStrings" type="application/json">@Html.Raw(pageJson)</script>
<script src="~/js/account/branding-setup.js" asp-append-version="true"></script>
