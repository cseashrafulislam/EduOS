@{
    ViewData["Title"] = "Institution Profile Setup";
    Layout = "_OnboardingLayout";

    var pageStrings = new
    {
        useBangla = CultureInfo.CurrentUICulture.Name.StartsWith("bn", StringComparison.OrdinalIgnoreCase),
        selectType = T["SelectInstitutionType"].Value,
        loadingTypes = T["LoadingInstitutionTypes"].Value,
        catalogFailed = T["CatalogLoadFailed"].Value,
        institutionRequired = T["InstitutionNameRequired"].Value,
        institutionTypeRequired = T["InstitutionTypeRequired"].Value,
        ownerRequired = T["OwnerNameRequired"].Value,
        invalidEmail = T["ValidEmailRequired"].Value,
        invalidWebsite = T["ValidWebsiteRequired"].Value,
        saveFailed = T["ProfileSaveFailed"].Value,
        loadFailed = T["ProfileLoadFailed"].Value,
        networkError = T["NetworkError"].Value,
        saving = T["Saving"].Value,
        saveContinue = T["SaveAndContinue"].Value
    };
    var pageJson = System.Text.Json.JsonSerializer.Serialize(pageStrings);
}

<article class="setup-page" aria-labelledby="profileTitle">
    <header class="setup-header">
        <div>
            <p class="dashboard-eyebrow">@T["Onboarding_InstitutionProfile_Name"]</p>
            <h2 id="profileTitle">@T["InstitutionProfileSetupTitle"]</h2>
            <p>@T["InstitutionProfileSetupHelp"]</p>
        </div>
        <span class="setup-header-icon" aria-hidden="true">
            <svg class="edu-icon"><use href="/images/eduos-icons.svg#institution" /></svg>
        </span>
    </header>

    <div id="alertContainer" class="d-none" role="alert" tabindex="-1"></div>

    <form id="profileForm" class="setup-form" enctype="multipart/form-data" novalidate>
        <section class="setup-section" aria-labelledby="basicInformationTitle">
            <div class="setup-section-heading">
                <h3 id="basicInformationTitle">@T["BasicInformation"]</h3>
                <p>@T["RequiredFieldsHelp"]</p>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="institutionName" class="form-label">@T["InstitutionName"] <span class="required-mark" aria-hidden="true">*</span></label>
                    <input type="text" id="institutionName" name="institutionName" class="form-control"
                           maxlength="200" autocomplete="organization" required aria-required="true" />
                    <div class="invalid-feedback"></div>
                </div>
                <div class="col-md-6">
                    <label for="institutionType" class="form-label">@T["InstitutionType"] <span class="required-mark" aria-hidden="true">*</span></label>
                    <select id="institutionType" name="institutionType" class="form-select" disabled required aria-required="true">
                        <option value="">@T["LoadingInstitutionTypes"]</option>
                    </select>
                    <div class="invalid-feedback"></div>
                </div>
                <div class="col-md-6">
                    <label for="ownerName" class="form-label">@T["OwnerAdminName"] <span class="required-mark" aria-hidden="true">*</span></label>
                    <input type="text" id="ownerName" name="ownerName" class="form-control"
                           maxlength="150" autocomplete="name" required aria-required="true" />
                    <div class="invalid-feedback"></div>
                </div>
                <div class="col-md-6">
                    <label for="ownerDesignation" class="form-label">@T["OwnerDesignation"]</label>
                    <input type="text" id="ownerDesignation" name="ownerDesignation" class="form-control" maxlength="100" />
                    <div class="invalid-feedback"></div>
                </div>
                <div class="col-md-6">
                    <label for="ownerPhone" class="form-label">@T["OwnerPhone"]</label>
                    <input type="tel" id="ownerPhone" name="ownerPhone" class="form-control" maxlength="20"
                           inputmode="tel" autocomplete="tel" placeholder="01700000000" />
                    <div class="invalid-feedback"></div>
                </div>
                <div class="col-md-6">
                    <label for="ownerEmail" class="form-label">@T["OwnerEmail"]</label>
                    <input type="email" id="ownerEmail" name="ownerEmail" class="form-control" maxlength="150" autocomplete="email" />
                    <div class="invalid-feedback"></div>
                </div>
            </div>
        </section>

        <section class="setup-section" aria-labelledby="contactInformationTitle">
            <div class="setup-section-heading">
                <h3 id="contactInformationTitle">@T["ContactInformation"]</h3>
                <p>@T["ContactInformationHelp"]</p>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="phone" class="form-label">@T["InstitutionPhone"]</label>
                    <input type="tel" id="phone" name="phone" class="form-control" maxlength="20" inputmode="tel" autocomplete="tel" />
                    <div class="invalid-feedback"></div>
                </div>
                <div class="col-md-6">
                    <label for="website" class="form-label">@T["Website"]</label>
                    <input type="url" id="website" name="website" class="form-control" maxlength="200"
                           inputmode="url" autocomplete="url" placeholder="https://example.edu.bd" />
                    <div class="invalid-feedback"></div>
                </div>
                <div class="col-12">
                    <label for="address" class="form-label">@T["Address"]</label>
                    <textarea id="address" name="address" class="form-control" maxlength="500" rows="3" autocomplete="street-address"></textarea>
                    <div class="invalid-feedback"></div>
                </div>
            </div>
        </section>

        <section class="setup-section" aria-labelledby="locationInformationTitle">
            <div class="setup-section-heading">
                <h3 id="locationInformationTitle">@T["LocationInformation"]</h3>
                <p>@T["BangladeshLocationHelp"]</p>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="city" class="form-label">@T["CityDistrict"]</label>
                    <input type="text" id="city" name="city" class="form-control" maxlength="100" autocomplete="address-level2" />
                    <div class="invalid-feedback"></div>
                </div>
                <div class="col-md-6">
                    <label for="state" class="form-label">@T["Division"]</label>
                    <input type="text" id="state" name="state" class="form-control" maxlength="100" autocomplete="address-level1" />
                    <div class="invalid-feedback"></div>
                </div>
                <div class="col-md-6">
                    <label for="country" class="form-label">@T["Country"]</label>
                    <input type="text" id="country" name="country" class="form-control" maxlength="100" value="Bangladesh" autocomplete="country-name" />
                    <div class="invalid-feedback"></div>
                </div>
                <div class="col-md-6">
                    <label for="postalCode" class="form-label">@T["PostalCode"]</label>
                    <input type="text" id="postalCode" name="postalCode" class="form-control" maxlength="20" inputmode="numeric" autocomplete="postal-code" />
                    <div class="invalid-feedback"></div>
                </div>
            </div>
        </section>

        <footer class="setup-actions">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">@T["BackToDashboard"]</a>
            <button type="submit" id="saveProfileBtn" class="btn btn-primary"
                    data-idle-label="@T["SaveAndContinue"]" data-loading-label="@T["Saving"]">
                @T["SaveAndContinue"]
            </button>
        </footer>
    </form>
</article>

<script id="institutionProfileStrings" type="application/json">@Html.Raw(pageJson)</script>
<script src="~/js/account/institution-profile.js" asp-append-version="true"></script>
