@{
    Layout = null;
    var email = ViewBag.Email as string ?? "";
    var token = ViewBag.Token as string ?? "";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Reset Password</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="container mt-5">
        <div class="card mx-auto p-4" style="max-width:500px">

            <h3 class="mb-3">Reset Password</h3>

            <input id="Email" class="form-control mb-3" value="@email" readonly />
            <input id="Token" type="hidden" value="@token" />

            <input id="Password" type="password" class="form-control mb-3" placeholder="New Password" />
            <input id="ConfirmPassword" type="password" class="form-control mb-3" placeholder="Confirm Password" />

            <button id="btnReset" class="btn btn-success w-100">
                Reset Password
            </button>

            <div id="msg" class="mt-3"></div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        $("#btnReset").click(function() {
            $.ajax({
                url: "/api/auth/reset-password",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({
                    email: $("#Email").val(),
                    token: $("#Token").val(),
                    newPassword: $("#Password").val(),
                    confirmPassword: $("#ConfirmPassword").val()
                }),
                success: function(res) {
                    $("#msg").html("<span class='text-success'>Password reset successful.</span>");
                    setTimeout(function() {
                        window.location.href = "/Account/Login";
                    }, 1200);
                },
                error: function(xhr) {
                    let msg = "Password reset failed.";
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        msg = xhr.responseJSON.message;
                    }
                    $("#msg").html("<span class='text-danger'>" + msg + "</span>");
                }
            });
        });
    </script>

</body>
</html>