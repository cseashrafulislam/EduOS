@{
    ViewData["Title"] = "ResetPasswordTitle";
    Layout = "_PublicLayout";
    var email = ViewBag.Email as string ?? string.Empty;
    var token = ViewBag.Token as string ?? string.Empty;
}

<section class="auth-card" aria-labelledby="resetPasswordTitle">
    <div class="auth-heading">
        <h1 id="resetPasswordTitle">@T["ResetPasswordTitle"]</h1>
        <p>@T["ResetPasswordHelp"]</p>
    </div>

    <div id="alertContainer" class="d-none" role="alert" aria-live="polite" tabindex="-1"></div>

    <form id="resetPasswordForm" novalidate
          data-min-length-message="@T["PasswordMinSix"]"
          data-mismatch-message="@T["PasswordsDoNotMatch"]"
          data-resetting="@T["Resetting"]"
          data-reset-label="@T["ResetPassword"]"
          data-reset-failed="@T["ResetFailed"]"
          data-network-message="@T["NetworkError"]"
          data-success-message="@T["PasswordResetSuccess"]">
        <div class="mb-3">
            <label class="form-label" for="resetEmail">@T["EmailAddress"]</label>
            <input type="email" id="resetEmail" class="form-control" value="@email"
                   autocomplete="email" readonly />
        </div>

        <input id="resetToken" type="hidden" value="@token" />

        <div class="mb-3">
            <label class="form-label" for="newPassword">@T["NewPassword"]</label>
            <input id="newPassword" type="password" class="form-control"
                   autocomplete="new-password" minlength="6" required />
            <div class="invalid-feedback"></div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="confirmPassword">@T["ConfirmPassword"]</label>
            <input id="confirmPassword" type="password" class="form-control"
                   autocomplete="new-password" minlength="6" required />
            <div class="invalid-feedback"></div>
        </div>

        <button id="resetBtn" type="submit" class="btn btn-primary auth-primary-action w-100"
                data-idle-label="@T["ResetPassword"]" data-loading-label="@T["Resetting"]">
            @T["ResetPassword"]
        </button>
    </form>

    <p class="auth-meta text-center mt-3 mb-0">
        <a href="/Account/Login">@T["BackToLogin"]</a>
    </p>
</section>

@section Scripts {
    <script src="~/js/account/auth-forms.js" asp-append-version="true"></script>
}
