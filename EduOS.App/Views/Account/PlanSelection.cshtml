@{
    ViewData["Title"] = T["PlanSelectionTitle"];
    Layout = "_OnboardingLayout";

    var pageStrings = new
    {
        culture = CultureInfo.CurrentUICulture.Name,
        isBangla = CultureInfo.CurrentUICulture.Name.StartsWith("bn", StringComparison.OrdinalIgnoreCase),
        loading = T["LoadingPlans"].Value,
        loadFailed = T["PlansLoadFailed"].Value,
        noPlans = T["NoPlansAvailable"].Value,
        retry = T["Retry"].Value,
        recommended = T["MostPopular"].Value,
        free = T["Free"].Value,
        daysTrialTemplate = T["DaysTrialTemplate"].Value,
        perPeriodTemplate = T["PerPeriodTemplate"].Value,
        setupFeeTemplate = T["SetupFeeTemplate"].Value,
        studentsTemplate = T["UpToStudentsTemplate"].Value,
        teachersTemplate = T["TeachersTemplate"].Value,
        campusesTemplate = T["CampusesTemplate"].Value,
        moreFeaturesTemplate = T["MoreFeaturesTemplate"].Value,
        selectPlanTemplate = T["SelectPlanAriaTemplate"].Value,
        selected = T["Selected"].Value,
        processing = T["Processing"].Value,
        continueLabel = T["ContinueToPayment"].Value,
        createFailed = T["SubscriptionCreateFailed"].Value,
        networkError = T["NetworkError"].Value,
        recovering = T["ExistingSubscriptionRedirecting"].Value,
        periods = new Dictionary<string, string>
        {
            ["1"] = T["PeriodMonth"].Value,
            ["2"] = T["PeriodThreeMonths"].Value,
            ["3"] = T["PeriodSixMonths"].Value,
            ["4"] = T["PeriodYear"].Value
        }
    };
    var pageJson = System.Text.Json.JsonSerializer.Serialize(pageStrings);
}

<article class="setup-page plan-selection-page" aria-labelledby="planSelectionTitle">
    <header class="setup-header">
        <div>
            <p class="dashboard-eyebrow">@T["Onboarding_PlanSelection_Name"]</p>
            <h2 id="planSelectionTitle">@T["PlanSelectionTitle"]</h2>
            <p>@T["PlanSelectionHelp"]</p>
        </div>
    </header>

    <div id="alertContainer" class="d-none" role="alert" tabindex="-1"></div>

    <section aria-labelledby="billingCycleTitle">
        <div class="setup-section-heading">
            <h3 id="billingCycleTitle">@T["BillingCycleLabel"]</h3>
        </div>
        <div class="billing-cycle-tabs" id="billingToggle" role="group" aria-label="@T["BillingCycleLabel"]">
            <button type="button" class="active" data-cycle="1" aria-pressed="true">@T["Monthly"]</button>
            <button type="button" data-cycle="2" aria-pressed="false">
                <span>@T["Quarterly"]</span><small>@T["QuarterlySaving"]</small>
            </button>
            <button type="button" data-cycle="3" aria-pressed="false">
                <span>@T["HalfYearly"]</span><small>@T["HalfYearlySaving"]</small>
            </button>
            <button type="button" data-cycle="4" aria-pressed="false">
                <span>@T["Yearly"]</span><small>@T["YearlySaving"]</small>
            </button>
        </div>
    </section>

    <section id="plansGrid" class="plan-selection-grid" aria-live="polite" aria-busy="true">
        <div class="setup-empty-state" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>@T["LoadingPlans"]</span>
        </div>
    </section>

    <footer class="setup-actions plan-selection-actions">
        <p class="setup-safe-note"><span aria-hidden="true">✓</span> @T["PlanSelectionSafeNote"]</p>
        <button type="button" class="btn btn-primary" id="continueBtn" disabled
                data-idle-label="@T["ContinueToPayment"]" data-loading-label="@T["Processing"]">
            @T["ContinueToPayment"]
        </button>
    </footer>
</article>

<script id="planSelectionStrings" type="application/json">@Html.Raw(pageJson)</script>
<script src="~/js/account/plan-selection.js" asp-append-version="true"></script>
