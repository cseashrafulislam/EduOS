@{
    var profileBn = CultureInfo.CurrentUICulture.Name == "bn-BD";
    ViewData["Title"] = profileBn ? "আমার প্রোফাইল" : "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">

    @Html.AntiForgeryToken()

    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-11">

            <div id="alertContainer" aria-live="polite"></div>

            <!-- =====================================================
                 PAGE HEADER
                 ===================================================== -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div>
                    <h3 class="fw-bold mb-1">@(profileBn ? "আমার প্রোফাইল" : "My Profile")</h3>
                    <p class="text-muted mb-0">
                        @(profileBn ? "আপনার ব্যক্তিগত তথ্য ও অ্যাকাউন্টের নিরাপত্তা পরিচালনা করুন।" : "Manage your personal information and account security.")
                    </p>
                </div>

                <a href="/" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    @(profileBn ? "ফিরে যান" : "Back")
                </a>
            </div>

            <div class="row g-4">

                <!-- =====================================================
                     PROFILE SUMMARY
                     ===================================================== -->
                <div class="col-lg-4">

                    <div class="card shadow-sm border-0 rounded-4 h-100">
                        <div class="card-body text-center p-4">

                            <div id="profileAvatar"
                                 class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center fw-bold mb-3"
                                 style="width:100px;height:100px;font-size:32px;">
                                U
                            </div>

                            <h5 id="profileDisplayName" class="fw-bold mb-1">
                                @(profileBn ? "লোড হচ্ছে..." : "Loading...")
                            </h5>

                            <div id="profileDisplayEmail"
                                 class="text-muted small mb-3">
                            </div>

                            <p class="small text-muted mb-3"><span>@T["Language"]:</span> <span id="profileLanguage">—</span></p>

                            <span class="badge bg-success-subtle text-success px-3 py-2">
                                <i class="bi bi-check-circle me-1"></i>
                                @(profileBn ? "সক্রিয় অ্যাকাউন্ট" : "Active Account")
                            </span>

                        </div>
                    </div>

                </div>

                <!-- =====================================================
                     PROFILE INFORMATION
                     ===================================================== -->
                <div class="col-lg-8">

                    <div class="card shadow-sm border-0 rounded-4">
                        <div class="card-header bg-white border-0 p-4 pb-0">

                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-person-circle text-primary fs-4"></i>

                                <div>
                                    <h5 class="fw-bold mb-1">
                                        @(profileBn ? "ব্যক্তিগত তথ্য" : "Personal Information")
                                    </h5>

                                    <div class="small text-muted">
                                        @(profileBn ? "আপনার অ্যাকাউন্টের তথ্য হালনাগাদ করুন।" : "Update your account information.")
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="card-body p-4">

                            <form id="profileForm" novalidate>

                                <div class="row g-3">

                                    <!-- FULL NAME -->
                                    <div class="col-md-6">

                                        <label for="fullName"
                                               class="form-label">
                                            @(profileBn ? "পূর্ণ নাম" : "Full Name")
                                            <span class="text-danger">*</span>
                                        </label>

                                        <input type="text"
                                               id="fullName"
                                               class="form-control"
                                               maxlength="150"
                                               autocomplete="name"
                                               placeholder="@(profileBn ? "পূর্ণ নাম লিখুন" : "Enter full name")" />

                                        <div class="invalid-feedback"></div>

                                    </div>

                                    <!-- EMAIL -->
                                    <div class="col-md-6">

                                        <label for="email"
                                               class="form-label">
                                            @(profileBn ? "ইমেইল ঠিকানা" : "Email Address")
                                        </label>

                                        <input type="email"
                                               id="email"
                                               class="form-control"
                                               readonly />

                                        <div class="form-text">
                                            @(profileBn ? "ইমেইল পরিবর্তনের জন্য আলাদা যাচাই প্রয়োজন।" : "Email change requires a separate verification process.")
                                        </div>

                                    </div>

                                    <!-- PHONE -->
                                    <div class="col-md-6">

                                        <label for="phoneNumber"
                                               class="form-label">
                                            @(profileBn ? "ফোন নম্বর" : "Phone Number")
                                        </label>

                                        <input type="tel"
                                               id="phoneNumber"
                                               class="form-control"
                                               maxlength="30"
                                               autocomplete="tel"
                                               placeholder="@(profileBn ? "ফোন নম্বর লিখুন" : "Enter phone number")" />

                                    </div>

                                    <!-- ADDRESS -->
                                    <div class="col-12">

                                        <label for="address"
                                               class="form-label">
                                            @(profileBn ? "ঠিকানা" : "Address")
                                        </label>

                                        <textarea id="address"
                                                  class="form-control"
                                                  rows="3"
                                                  maxlength="500"
                                                  placeholder="@(profileBn ? "ঠিকানা লিখুন" : "Enter address")"></textarea>

                                    </div>

                                </div>

                                <div class="d-flex justify-content-end mt-4">

                                    <button type="submit"
                                            id="saveProfileBtn"
                                            class="btn btn-primary" disabled>

                                        <i class="bi bi-check-circle me-1"></i>
                                        @(profileBn ? "পরিবর্তন সংরক্ষণ করুন" : "Save Changes")

                                    </button>

                                </div>

                            </form>

                        </div>
                    </div>

                    <!-- Optional MFA: a user opts in from Profile, never during first login. -->
                    <section class="card shadow-sm border-0 rounded-4 mt-4" aria-labelledby="mfaTitle">
                        <div class="card-header bg-white border-0 p-4 pb-0">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-shield-check text-primary fs-4" aria-hidden="true"></i>
                                <div>
                                    <h5 id="mfaTitle" class="fw-bold mb-1">@(profileBn ? "দুই ধাপের যাচাই (ঐচ্ছিক)" : "Two-Factor Authentication (Optional)")</h5>
                                    <p class="small text-muted mb-0">@(profileBn ? "ইচ্ছা করলে অ্যাকাউন্টে অথেনটিকেটর যুক্ত করুন।" : "Add an authenticator to your account only if you choose to.")</p>
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <p class="mb-2">@(profileBn ? "অবস্থা:" : "Status:") <span id="mfaStatus" role="status" aria-live="polite">@(profileBn ? "যাচাই হচ্ছে..." : "Checking...")</span></p>
                            <p id="mfaStatusHelp" class="small text-muted mb-3">@(profileBn ? "MFA চালু না করা পর্যন্ত পাসওয়ার্ড দিয়েই লগইন করা যাবে।" : "Password login works normally until you enable MFA.")</p>
                            <a id="mfaSetupLink" class="btn btn-outline-primary d-none" href="/Account/MfaSetup">
                                <i class="bi bi-shield-plus me-1" aria-hidden="true"></i> Set Up MFA
                            </a>
                            <div id="mfaManagement" class="d-none mt-3">
                                <p class="small text-muted">@(profileBn ? "নিরাপত্তার জন্য বর্তমান পাসওয়ার্ড এবং অথেনটিকেটর বা রিকভারি কোড দিন।" : "For security, confirm your password and a current authenticator or recovery code.")</p>
                                <label for="mfaManagePassword" class="form-label">@(profileBn ? "বর্তমান পাসওয়ার্ড" : "Current password")</label>
                                <input id="mfaManagePassword" type="password" autocomplete="current-password" class="form-control mb-2" />
                                <label for="mfaManageCode" class="form-label">@(profileBn ? "অথেনটিকেটর বা রিকভারি কোড" : "Authenticator or recovery code")</label>
                                <input id="mfaManageCode" type="text" autocomplete="one-time-code" class="form-control mb-2" />
                                <div class="form-check mb-3">
                                    <input id="mfaManageRecovery" class="form-check-input" type="checkbox" />
                                    <label for="mfaManageRecovery" class="form-check-label">@(profileBn ? "পরিবর্তে রিকভারি কোড ব্যবহার করুন" : "Use recovery code instead")</label>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    <button id="mfaRegenerateBtn" type="button" class="btn btn-outline-primary" disabled>@(profileBn ? "নতুন রিকভারি কোড তৈরি করুন" : "Regenerate recovery codes")</button>
                                    <button id="mfaDisableBtn" type="button" class="btn btn-outline-danger" disabled>@(profileBn ? "MFA বন্ধ করুন" : "Disable MFA")</button>
                                </div>
                                <div id="mfaNewCodesPanel" class="mt-3 d-none">
                                    <strong>@(profileBn ? "নতুন রিকভারি কোড নিরাপদে রাখুন। আগের কোডগুলো আর কাজ করবে না।" : "Save these new recovery codes securely. Older codes no longer work.")</strong>
                                    <ul id="mfaNewCodes" class="mt-2"></ul>
                                    <a href="/Account/Login" class="btn btn-primary">@(profileBn ? "আবার সাইন ইন করুন" : "Sign in again")</a>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="card shadow-sm border-0 rounded-4 mt-4" aria-labelledby="sessionsTitle">
                        <div class="card-header bg-white border-0 p-4 pb-0 d-flex align-items-center justify-content-between">
                            <h5 id="sessionsTitle" class="fw-bold mb-0">@T["ActiveSessions"]</h5>
                            <details class="position-relative">
                                <summary class="btn btn-sm btn-outline-secondary" aria-label="@T["SessionHelpLabel"]" title="@T["SessionHelpLabel"]">
                                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                                </summary>
                                <div class="card shadow-sm position-absolute end-0 mt-1 p-3 small" style="width:min(18rem,80vw);z-index:20;">@T["SessionHelpText"]</div>
                            </details>
                        </div>
                        <div class="card-body p-4">
                            <div id="sessionList" role="list" aria-live="polite"
                                 data-current="@T["ThisDevice"]" data-other="@T["OtherSession"]"
                                 data-empty="@T["NoActiveSessions"]" data-loading-error="@T["SessionListFailed"]"
                                 data-revoke="@T["RevokeSession"]" data-revoke-error="@T["SessionRevokeFailed"]"
                                 data-password-required="@T["SessionPasswordRequired"]">@T["LoadingSessions"]</div>
                            <hr />
                            <label for="sessionRevokePassword" class="form-label">@T["SessionManagementPassword"]</label>
                            <input id="sessionRevokePassword" type="password" class="form-control mb-2" autocomplete="current-password" />
                            <div class="d-flex flex-wrap gap-2">
                                <button id="sessionRevokeOthersBtn" type="button" class="btn btn-outline-primary"
                                        data-required="@T["SessionPasswordRequired"]"
                                        data-success="@T["OtherSessionsRevoked"]"
                                        data-failed="@T["OtherSessionsRevokeFailed"]" disabled>@T["SignOutOtherDevices"]</button>
                                <button id="sessionRevokeAllBtn" type="button" class="btn btn-outline-danger" disabled>@T["SignOutAllDevices"]</button>
                            </div>
                        </div>
                    </section>

                    <!-- =================================================
                         PASSWORD
                         ================================================= -->
                    <div class="card shadow-sm border-0 rounded-4 mt-4">

                        <div class="card-header bg-white border-0 p-4 pb-0">

                            <div class="d-flex align-items-center gap-2">

                                <i class="bi bi-shield-lock text-primary fs-4"></i>

                                <div>
                                    <h5 class="fw-bold mb-1">
                                        @(profileBn ? "পাসওয়ার্ড পরিবর্তন" : "Change Password")
                                    </h5>

                                    <div class="small text-muted">
                                        @(profileBn ? "অ্যাকাউন্ট সুরক্ষিত রাখতে শক্তিশালী পাসওয়ার্ড ব্যবহার করুন।" : "Use a strong password to protect your account.")
                                    </div>
                                </div>

                            </div>

                        </div>

                        <div class="card-body p-4">

                            <form id="passwordForm" novalidate>

                                <div class="row g-3">

                                    <!-- CURRENT PASSWORD -->
                                    <div class="col-12">

                                        <label for="currentPassword"
                                               class="form-label">
                                            @(profileBn ? "বর্তমান পাসওয়ার্ড" : "Current Password")
                                            <span class="text-danger">*</span>
                                        </label>

                                        <div class="input-group">

                                            <input type="password"
                                                   id="currentPassword"
                                                   class="form-control"
                                                   autocomplete="current-password"
                                                   placeholder="@(profileBn ? "বর্তমান পাসওয়ার্ড লিখুন" : "Enter current password")" />

                                            <button type="button"
                                                    class="btn btn-outline-secondary password-toggle"
                                            aria-label="@(profileBn ? "পাসওয়ার্ড দেখান বা লুকান" : "Show or hide password")"
                                            data-target="currentPassword">
                                                <i class="bi bi-eye"></i>
                                            </button>

                                            <div class="invalid-feedback"></div>

                                        </div>

                                    </div>

                                    <!-- NEW PASSWORD -->
                                    <div class="col-md-6">

                                        <label for="newPassword"
                                               class="form-label">
                                            @(profileBn ? "নতুন পাসওয়ার্ড" : "New Password")
                                            <span class="text-danger">*</span>
                                        </label>

                                        <div class="input-group">

                                            <input type="password"
                                                   id="newPassword"
                                                   class="form-control"
                                                   autocomplete="new-password"
                                                   placeholder="@(profileBn ? "নতুন পাসওয়ার্ড লিখুন" : "Enter new password")" />

                                            <button type="button"
                                                    class="btn btn-outline-secondary password-toggle"
                                            aria-label="@(profileBn ? "পাসওয়ার্ড দেখান বা লুকান" : "Show or hide password")"
                                            data-target="newPassword">
                                                <i class="bi bi-eye"></i>
                                            </button>

                                        </div>

                                        <div id="newPasswordError"
                                             class="text-danger small mt-1">
                                        </div>

                                    </div>

                                    <!-- CONFIRM PASSWORD -->
                                    <div class="col-md-6">

                                        <label for="confirmPassword"
                                               class="form-label">
                                            @(profileBn ? "পাসওয়ার্ড নিশ্চিত করুন" : "Confirm Password")
                                            <span class="text-danger">*</span>
                                        </label>

                                        <div class="input-group">

                                            <input type="password"
                                                   id="confirmPassword"
                                                   class="form-control"
                                                   autocomplete="new-password"
                                                   placeholder="@(profileBn ? "নতুন পাসওয়ার্ড নিশ্চিত করুন" : "Confirm new password")" />

                                            <button type="button"
                                                    class="btn btn-outline-secondary password-toggle"
                                            aria-label="@(profileBn ? "পাসওয়ার্ড দেখান বা লুকান" : "Show or hide password")"
                                            data-target="confirmPassword">
                                                <i class="bi bi-eye"></i>
                                            </button>

                                        </div>

                                        <div id="confirmPasswordError"
                                             class="text-danger small mt-1">
                                        </div>

                                    </div>

                                </div>

                                <div class="d-flex justify-content-end mt-4">

                                    <button type="submit"
                                            id="changePasswordBtn"
                                            class="btn btn-warning" disabled>

                                        <i class="bi bi-shield-check me-1"></i>
                                        Change Password

                                    </button>

                                </div>

                            </form>

                        </div>
                    </div>

                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/account/profile.js"
            asp-append-version="true"></script>
}