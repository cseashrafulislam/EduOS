@{
    ViewData["Title"] = "GatewaySetupTitle";
    Layout = "_OnboardingLayout";
    var pageStrings = new
    {
        loadFailed = T["GatewayLoadFailed"].Value,
        networkError = T["NetworkError"].Value,
        saving = T["Saving"].Value,
        smsSaved = T["SmsSettingsSaved"].Value,
        emailSaved = T["EmailSettingsSaved"].Value,
        saveFailed = T["GatewaySaveFailed"].Value,
        finishing = T["FinishingSetup"].Value,
        finishSetup = T["FinishSetup"].Value,
        completionFailed = T["OnboardingCompletionFailed"].Value,
        continueSetup = T["ContinueSetup"].Value,
        dashboard = T["Dashboard"].Value
    };
    var pageJson = System.Text.Json.JsonSerializer.Serialize(pageStrings);
}

<article class="setup-page" aria-labelledby="gatewaySetupTitle">
    <header class="setup-header">
        <div>
            <p class="dashboard-eyebrow">@T["Onboarding_GatewaySetup_Name"]</p>
            <h2 id="gatewaySetupTitle">@T["GatewaySetupTitle"]</h2>
            <p>@T["GatewaySetupHelp"]</p>
        </div>
    </header>

    <div id="alertContainer" class="d-none" role="alert" tabindex="-1"></div>

    <section class="setup-section gateway-card" aria-labelledby="smsGatewayTitle">
        <div class="gateway-header">
            <div class="setup-section-heading mb-0">
                <h3 id="smsGatewayTitle">@T["SmsGateway"]</h3>
                <p>@T["SmsGatewayHelp"]</p>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="smsEnabled" />
                <label class="form-check-label" for="smsEnabled">@T["Enable"]</label>
            </div>
        </div>
        <form id="smsForm" class="setup-form mt-3">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="smsProvider">@T["Provider"]</label>
                    <select class="form-select" id="smsProvider">
                        <option value="">@T["SelectProvider"]</option>
                        <option value="BulkSMSBD">BulkSMSBD</option>
                        <option value="SslWireless">SSL Wireless</option>
                        <option value="MimSms">MIM SMS</option>
                        <option value="Twilio">Twilio</option>
                        <option value="Custom">@T["CustomProvider"]</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="smsSenderId">@T["SenderId"]</label>
                    <input type="text" class="form-control" id="smsSenderId" maxlength="20" autocomplete="off" />
                </div>
                <div class="col-12">
                    <label class="form-label" for="smsApiUrl">@T["ApiUrl"]</label>
                    <input type="url" class="form-control" id="smsApiUrl" maxlength="2048" inputmode="url" placeholder="https://api.example.com/send" />
                </div>
                <div class="col-12">
                    <label class="form-label" for="smsApiKey">@T["ApiKey"]</label>
                    <input type="password" class="form-control" id="smsApiKey" maxlength="1000" autocomplete="new-password" />
                    <small class="text-muted">@T["SecretStoredHelp"]</small>
                </div>
            </div>
            <div><button type="submit" class="btn btn-outline-primary" id="saveSmsBtn" data-idle-label="@T["SaveSmsSettings"]">@T["SaveSmsSettings"]</button></div>
        </form>
    </section>

    <section class="setup-section gateway-card" aria-labelledby="emailGatewayTitle">
        <div class="gateway-header">
            <div class="setup-section-heading mb-0">
                <h3 id="emailGatewayTitle">@T["EmailGateway"]</h3>
                <p>@T["EmailGatewayHelp"]</p>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="emailEnabled" />
                <label class="form-check-label" for="emailEnabled">@T["Enable"]</label>
            </div>
        </div>
        <form id="emailForm" class="setup-form mt-3">
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label" for="smtpHost">@T["SmtpHost"]</label>
                    <input type="text" class="form-control" id="smtpHost" maxlength="253" inputmode="url" placeholder="smtp.example.com" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="smtpPort">@T["SmtpPort"]</label>
                    <select class="form-select" id="smtpPort">
                        <option value="587">587</option>
                        <option value="465">465</option>
                        <option value="25">25</option>
                        <option value="2525">2525</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="smtpUsername">@T["Username"]</label>
                    <input type="text" class="form-control" id="smtpUsername" maxlength="320" autocomplete="off" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="smtpPassword">@T["Password"]</label>
                    <input type="password" class="form-control" id="smtpPassword" maxlength="1000" autocomplete="new-password" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="fromEmail">@T["FromEmail"]</label>
                    <input type="email" class="form-control" id="fromEmail" maxlength="320" autocomplete="email" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="fromName">@T["FromName"]</label>
                    <input type="text" class="form-control" id="fromName" maxlength="150" />
                </div>
                <div class="col-12">
                    <div class="form-check setup-check-control">
                        <input class="form-check-input" type="checkbox" id="useSsl" checked />
                        <label class="form-check-label" for="useSsl">@T["UseSsl"]</label>
                    </div>
                </div>
            </div>
            <div><button type="submit" class="btn btn-outline-primary" id="saveEmailBtn" data-idle-label="@T["SaveEmailSettings"]">@T["SaveEmailSettings"]</button></div>
        </form>
    </section>

    <div class="setup-guidance" role="note">@T["GatewayOptionalNote"]</div>
    <footer class="setup-actions">
        <button type="button" class="btn btn-outline-secondary" id="skipBtn">@T["SkipAndFinish"]</button>
        <button type="button" class="btn btn-success" id="finishBtn" data-idle-label="@T["FinishSetup"]">@T["FinishSetup"]</button>
    </footer>
</article>

<script id="gatewaySetupStrings" type="application/json">@Html.Raw(pageJson)</script>
<script src="~/js/account/gateway-setup.js" asp-append-version="true"></script>
