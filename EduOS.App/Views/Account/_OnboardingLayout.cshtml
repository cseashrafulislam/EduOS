@{
    Layout = "_Layout";

    var onboardingStrings = new
    {
        culture = CultureInfo.CurrentUICulture.Name,
        optional = T["Optional"].Value,
        loading = T["Loading"].Value,
        loadFailed = T["OnboardingLoadFailed"].Value,
        retry = T["Retry"].Value,
        stepsCompletedTemplate = T["StepsCompletedTemplate"].Value,
        steps = new Dictionary<string, object>
        {
            ["EmailVerification"] = new { name = T["Onboarding_EmailVerification_Name"].Value, description = T["Onboarding_EmailVerification_Description"].Value },
            ["InstitutionProfile"] = new { name = T["Onboarding_InstitutionProfile_Name"].Value, description = T["Onboarding_InstitutionProfile_Description"].Value },
            ["PlanSelection"] = new { name = T["Onboarding_PlanSelection_Name"].Value, description = T["Onboarding_PlanSelection_Description"].Value },
            ["Payment"] = new { name = T["Onboarding_Payment_Name"].Value, description = T["Onboarding_Payment_Description"].Value },
            ["CampusSetup"] = new { name = T["Onboarding_CampusSetup_Name"].Value, description = T["Onboarding_CampusSetup_Description"].Value },
            ["AcademicSetup"] = new { name = T["Onboarding_AcademicSetup_Name"].Value, description = T["Onboarding_AcademicSetup_Description"].Value },
            ["BrandingSetup"] = new { name = T["Onboarding_BrandingSetup_Name"].Value, description = T["Onboarding_BrandingSetup_Description"].Value },
            ["GeneralSettings"] = new { name = T["Onboarding_GeneralSettings_Name"].Value, description = T["Onboarding_GeneralSettings_Description"].Value },
            ["GatewaySetup"] = new { name = T["Onboarding_GatewaySetup_Name"].Value, description = T["Onboarding_GatewaySetup_Description"].Value }
        }
    };
    var onboardingJson = System.Text.Json.JsonSerializer.Serialize(onboardingStrings);
}

<div class="onboarding-wrapper">
    <div class="row g-0">
        <div class="col-lg-4 col-xl-3">
            <aside class="onboarding-sidebar" aria-labelledby="setupWizardTitle">
                <h2 class="h5 mb-3" id="setupWizardTitle">@T["SetupWizard"]</h2>

                <div class="onboarding-progress">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small text-muted">@T["Progress"]</span>
                        <span class="small fw-bold" id="progressText">0%</span>
                    </div>
                    <div class="progress-bar-custom" id="progressTrack" role="progressbar"
                         aria-label="@T["Progress"]" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                        <div class="progress-bar-fill" id="progressBar"></div>
                    </div>
                    <div class="mt-2 small text-muted" id="completedSummary">
                        @T["StepsCompleted", 0, 0]
                    </div>
                </div>

                <nav id="stepsList" aria-label="@T["SetupWizard"]">
                    <div class="text-center py-4 text-muted small" role="status">
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        <span>@T["Loading"]</span>
                    </div>
                </nav>
            </aside>
        </div>

        <div class="col-lg-8 col-xl-9">
            <div class="onboarding-content">
                @RenderBody()
            </div>
        </div>
    </div>
</div>

<script>
    (() => {
        'use strict';

        const i18n = @Html.Raw(onboardingJson);

        function localizeStep(step) {
            return i18n.steps[step.code] || {
                name: step.name || '',
                description: step.description || ''
            };
        }

        function updateProgress(status) {
            const percentage = Math.min(100, Math.max(0, Number(status.progressPercentage) || 0));
            const completed = Number(status.completedSteps) || 0;
            const total = Number(status.totalSteps) || 0;
            const localizedPercentage = `${percentage.toLocaleString(i18n.culture)}%`;

            document.getElementById('progressBar').style.width = `${percentage}%`;
            document.getElementById('progressText').textContent = localizedPercentage;

            const progressTrack = document.getElementById('progressTrack');
            progressTrack.setAttribute('aria-valuenow', String(percentage));
            document.getElementById('completedSummary').textContent = i18n.stepsCompletedTemplate
                .replace('{completed}', completed.toLocaleString(i18n.culture))
                .replace('{total}', total.toLocaleString(i18n.culture));
        }

        function createStepLink(step) {
            const text = localizeStep(step);
            const link = document.createElement('a');
            link.className = 'step-item';

            if (step.isCurrent) {
                link.classList.add('current');
                link.setAttribute('aria-current', 'step');
            }
            if (step.isCompleted) link.classList.add('completed');

            if (step.isLocked) {
                link.classList.add('locked');
                link.setAttribute('aria-disabled', 'true');
                link.tabIndex = -1;
            } else {
                link.href = step.url;
            }

            const icon = document.createElement('span');
            icon.className = 'step-icon';
            icon.setAttribute('aria-hidden', 'true');
            icon.textContent = step.isCompleted
                ? '✓'
                : (Number(step.order) || 0).toLocaleString(i18n.culture);

            const content = document.createElement('span');
            content.className = 'step-content';

            const name = document.createElement('span');
            name.className = 'step-name';
            name.textContent = text.name;

            if (step.isSkippable) {
                const badge = document.createElement('span');
                badge.className = 'step-skip-badge';
                badge.textContent = i18n.optional;
                name.append(' ', badge);
            }

            const description = document.createElement('span');
            description.className = 'step-desc';
            description.textContent = text.description;

            content.append(name, description);
            link.append(icon, content);
            return link;
        }

        function renderSidebar(status) {
            updateProgress(status);
            const list = document.getElementById('stepsList');
            list.replaceChildren(...(Array.isArray(status.steps) ? status.steps.map(createStepLink) : []));
        }

        function showLoadError() {
            const list = document.getElementById('stepsList');
            const error = document.createElement('div');
            error.className = 'onboarding-error';
            error.setAttribute('role', 'alert');

            const message = document.createElement('div');
            message.textContent = i18n.loadFailed;

            const retry = document.createElement('button');
            retry.type = 'button';
            retry.className = 'btn btn-sm btn-outline-danger mt-2';
            retry.textContent = i18n.retry;
            retry.addEventListener('click', loadOnboardingStatus);

            error.append(message, retry);
            list.replaceChildren(error);
        }

        async function loadOnboardingStatus() {
            try {
                const response = await fetch('/api/onboarding/status', {
                    cache: 'no-store',
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json' }
                });

                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                const payload = await response.json();
                if (!payload.success || !payload.data) throw new Error('Invalid onboarding response');
                renderSidebar(payload.data);
            } catch (error) {
                console.warn('EduOS onboarding status was unavailable.', error);
                showLoadError();
            }
        }

        document.addEventListener('DOMContentLoaded', loadOnboardingStatus, { once: true });
    })();
</script>
