@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Forgot Password</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: linear-gradient(120deg,#0f172a,#1e293b);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .forgot-card {
            width: 100%;
            max-width: 460px;
            border-radius: 14px;
            box-shadow: 0 15px 40px rgba(0,0,0,.25);
        }

        .title {
            font-size: 26px;
            font-weight: 700;
            color: #2563eb;
        }

        .sub-text {
            color: #6b7280;
            font-size: 14px;
        }
    </style>
</head>
<body>

    <div class="card forgot-card p-4">
        <div class="text-center mb-3">
            <div class="title">Forgot Password</div>
            <div class="sub-text">
                Enter your registered email to receive a password reset link.
            </div>
        </div>

        <div id="msgBox" class="alert d-none"></div>

        <div class="mb-3">
            <label>Email Address</label>
            <input type="email" id="Email" class="form-control" placeholder="admin@school.com" />
        </div>

        <button id="btnSend" class="btn btn-primary w-100">Send Reset Link</button>

        <div class="text-center mt-3">
            <a href="/Account/Login" class="text-decoration-none">Back to Login</a>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        $("#btnSend").click(function() {
            const email = $("#Email").val().trim();

            if (!email) {
                return showMsg("Email is required.", "danger");
            }

            $("#btnSend").prop("disabled", true).text("Sending...");

            $.ajax({
                url: "/api/auth/forgot-password",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ email: email }),
                success: function(res) {
                    showMsg(res.message || "Reset link sent to your email.", "success");
                },
                error: function(xhr) {
                    let msg = "Failed to send reset link.";
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        msg = xhr.responseJSON.message;
                    }
                    showMsg(msg, "danger");
                },
                complete: function() {
                    $("#btnSend").prop("disabled", false).text("Send Reset Link");
                }
            });
        });

        function showMsg(message, type) {
            $("#msgBox")
                .removeClass("d-none alert-success alert-danger")
                .addClass("alert-" + type)
                .text(message);
        }
    </script>

</body>
</html>