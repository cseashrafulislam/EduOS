@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_PublicLayout";
}

<section class="auth-card" aria-labelledby="forgotPasswordTitle">
    <div class="auth-heading">
        <h1 id="forgotPasswordTitle">@T["ForgotPasswordTitle"]</h1>
        <p>@T["ForgotPasswordHelp"]</p>
    </div>

    <div id="alertContainer" class="d-none" role="alert" aria-live="polite" tabindex="-1"></div>

    <form id="forgotPasswordForm" novalidate
          data-email-required="@T["EmailRequired"]"
          data-sending="@T["Sending"]"
          data-send-label="@T["SendResetLink"]"
          data-request-failed="@T["ResetRequestFailed"]"
          data-network-message="@T["NetworkError"]"
          data-sent-title="@T["ResetEmailSentTitle"]"
          data-sent-message="@T["ResetEmailSentMessage"]"
          data-back-label="@T["BackToLogin"]">
        <div class="mb-3">
            <label class="form-label" for="email">@T["EmailAddress"]</label>
            <input type="email" id="email" class="form-control" autocomplete="email"
                   inputmode="email" placeholder="admin@example.edu.bd" required />
        </div>

        <button id="forgotBtn" type="submit" class="btn btn-primary auth-primary-action w-100"
                data-idle-label="@T["SendResetLink"]" data-loading-label="@T["Sending"]">
            @T["SendResetLink"]
        </button>
    </form>

    <p class="auth-meta text-center mt-3 mb-0">
        <a href="/Account/Login">@T["BackToLogin"]</a>
    </p>
</section>

@section Scripts {
    <script src="~/js/account/auth-forms.js" asp-append-version="true"></script>
}
