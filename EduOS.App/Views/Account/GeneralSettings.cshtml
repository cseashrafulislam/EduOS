@{
    ViewData["Title"] = "GeneralSettingsTitle";
    Layout = "_OnboardingLayout";
    var pageStrings = new
    {
        loadFailed = T["ProfileLoadFailed"].Value,
        networkError = T["NetworkError"].Value,
        saving = T["Saving"].Value,
        saveAndContinue = T["SaveAndContinue"].Value,
        saveFailed = T["GeneralSettingsSaveFailed"].Value,
        stepFailed = T["StepCompletionFailed"].Value,
        continuing = T["Continuing"].Value,
        skipForNow = T["SkipForNow"].Value,
        continueSetup = T["ContinueSetup"].Value,
        dashboard = T["Dashboard"].Value
    };
    var pageJson = System.Text.Json.JsonSerializer.Serialize(pageStrings);
}

<article class="setup-page" aria-labelledby="generalSettingsTitle">
    <header class="setup-header">
        <div>
            <p class="dashboard-eyebrow">@T["Onboarding_GeneralSettings_Name"]</p>
            <h2 id="generalSettingsTitle">@T["GeneralSettingsTitle"]</h2>
            <p>@T["GeneralSettingsHelp"]</p>
        </div>
    </header>

    <div id="alertContainer" class="d-none" role="alert" tabindex="-1"></div>

    <form id="settingsForm" class="setup-form">
        <section class="setup-section" aria-labelledby="regionalPreferencesTitle">
            <div class="setup-section-heading">
                <h3 id="regionalPreferencesTitle">@T["RegionalPreferences"]</h3>
                <p>@T["RegionalPreferencesHelp"]</p>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="currency">@T["Currency"]</label>
                    <select class="form-select" id="currency" required>
                        <option value="BDT">@T["CurrencyBDT"]</option>
                        <option value="USD">@T["CurrencyUSD"]</option>
                        <option value="INR">@T["CurrencyINR"]</option>
                        <option value="GBP">@T["CurrencyGBP"]</option>
                        <option value="EUR">@T["CurrencyEUR"]</option>
                        <option value="AED">@T["CurrencyAED"]</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="currencySymbol">@T["CurrencySymbol"]</label>
                    <input type="text" class="form-control" id="currencySymbol" maxlength="10" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="timeZone">@T["TimeZone"]</label>
                    <select class="form-select" id="timeZone" required>
                        <option value="Asia/Dhaka">Asia/Dhaka (UTC+6)</option>
                        <option value="Asia/Kolkata">Asia/Kolkata (UTC+5:30)</option>
                        <option value="Asia/Karachi">Asia/Karachi (UTC+5)</option>
                        <option value="Asia/Dubai">Asia/Dubai (UTC+4)</option>
                        <option value="UTC">UTC</option>
                        <option value="Europe/London">Europe/London</option>
                        <option value="America/New_York">America/New_York</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="language">@T["Language"]</label>
                    <select class="form-select" id="language" required>
                        <option value="en">English</option>
                        <option value="bn-BD">বাংলা</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="dateFormat">@T["DateFormat"]</label>
                    <select class="form-select" id="dateFormat" required>
                        <option value="dd-MM-yyyy">DD-MM-YYYY</option>
                        <option value="dd/MM/yyyy">DD/MM/YYYY</option>
                        <option value="yyyy-MM-dd">YYYY-MM-DD</option>
                        <option value="MM-dd-yyyy">MM-DD-YYYY</option>
                    </select>
                </div>
            </div>
        </section>

        <div class="setup-guidance" role="note">@T["RegionalDefaultsNote"]</div>
        <footer class="setup-actions">
            <button type="button" class="btn btn-outline-secondary" id="skipBtn" data-idle-label="@T["SkipForNow"]" data-loading-label="@T["Continuing"]">@T["SkipForNow"]</button>
            <button type="submit" class="btn btn-primary" id="saveSettingsBtn" data-idle-label="@T["SaveAndContinue"]" data-loading-label="@T["Saving"]">@T["SaveAndContinue"]</button>
        </footer>
    </form>
</article>

<script id="generalSettingsStrings" type="application/json">@Html.Raw(pageJson)</script>
<script src="~/js/account/general-settings.js" asp-append-version="true"></script>
