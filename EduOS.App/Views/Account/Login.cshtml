@{
    ViewData["Title"] = "Login";
    Layout = "_PublicLayout";
}

<section class="auth-card" aria-labelledby="loginTitle">
    <div class="auth-heading">
        <h1 id="loginTitle">@T["LogInTitle"]</h1>
        <p>@T["LoginSubtitle"]</p>
    </div>

    <div id="alertContainer" class="d-none" role="alert" aria-live="polite" tabindex="-1"></div>

    <form id="loginForm" novalidate
          data-required-message="@T["EmailPasswordRequired"]"
          data-invalid-message="@T["InvalidCredentials"]"
          data-network-message="@T["NetworkError"]"
          data-inactive-message="@T["AccountDeactivated"]"
          data-verify-message="@T["VerifyBeforeLogin"]"
          data-locked-message="@T["AccountLocked"]">
        <div class="mb-3">
            <label class="form-label" for="userNameOrEmail">@T["UsernameOrEmail"]</label>
            <input type="text" id="userNameOrEmail" class="form-control" autocomplete="username"
                   maxlength="256" placeholder="Username or email address" required />
        </div>

        <div class="mb-3">
            <label class="form-label" for="password">@T["Password"]</label>
            <input type="password" id="password" class="form-control"
                   autocomplete="current-password" required />
        </div>

        <div id="institutionChoicePanel" class="mb-3" hidden>
            <label class="form-label" for="institutionChoice">Select institution</label>
            <select id="institutionChoice" class="form-select" aria-label="Select your institution"></select>
            <small class="form-text text-muted">Your institution determines which permissions are available.</small>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div class="form-check">
                <input type="checkbox" id="rememberMe" class="form-check-input" />
                <label class="form-check-label auth-meta" for="rememberMe">@T["RememberMe"]</label>
            </div>
            <a href="/Account/ForgotPassword" class="auth-meta text-decoration-none">@T["ForgotPasswordQuestion"]</a>
        </div>

        <button id="loginBtn" type="submit" class="btn btn-primary auth-primary-action w-100"
                data-idle-label="@T["SignIn"]" data-loading-label="@T["SigningIn"]"
                data-reset-success="@T["PasswordResetSuccess"]"
                               data-password-changed-success="@T["PasswordChangedSignInAgain"]">
            @T["SignIn"]
        </button>

        <p class="auth-meta text-center mt-3 mb-0">
            @T["NoAccount"]
            <a href="/Account/Signup">@T["SignUpNow"]</a>
        </p>
    </form>
</section>

@section Scripts {
    <script src="~/js/account/login.js" asp-append-version="true"></script>
}
