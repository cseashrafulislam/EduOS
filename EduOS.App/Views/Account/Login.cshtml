@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment DemoHost
@inject Microsoft.Extensions.Configuration.IConfiguration DemoConfiguration
@{
    ViewData["Title"] = "Login";
    Layout = "_PublicLayout";
    var demoEnabled = string.Equals(DemoHost.EnvironmentName, "Staging", StringComparison.OrdinalIgnoreCase)
        && string.Equals(DemoConfiguration["DemoData:Enabled"], "true", StringComparison.OrdinalIgnoreCase);
}

<section class="auth-card" aria-labelledby="loginTitle">
    <div class="auth-heading">
        <h1 id="loginTitle">@T["LogInTitle"]</h1>
        <p>@T["LoginSubtitle"]</p>
        <button class="icon-button page-help-trigger" id="pageContextHelp" type="button"
                aria-haspopup="dialog" aria-controls="pageHelpDrawer"
                aria-label="@T["FullPageManual"]" title="@T["FullPageManual"]">ⓘ</button>
    </div>

    <div id="alertContainer" class="d-none" role="alert" aria-live="polite" tabindex="-1"></div>

    <form id="loginForm" novalidate
          data-required-message="@T["EmailPasswordRequired"]"
          data-invalid-message="@T["InvalidCredentials"]"
          data-network-message="@T["NetworkError"]"
          data-inactive-message="@T["AccountDeactivated"]"
          data-verify-message="@T["VerifyBeforeLogin"]"
          data-locked-message="@T["AccountLocked"]"
          data-select-institution-message="@T["InstitutionChoicePrompt"]"
          data-institution-label="@T["Institution"]">
        <div class="mb-3">
            <label class="form-label" for="userNameOrEmail">@T["UsernameOrEmail"]</label>
            <input type="text" id="userNameOrEmail" class="form-control" autocomplete="username"
                   maxlength="256" placeholder="@T["UsernameEmailPlaceholder"]" required />
        </div>

        <div class="mb-3">
            <label class="form-label" for="password">@T["Password"]</label>
            <input type="password" id="password" class="form-control"
                   autocomplete="current-password" required />
        </div>

        <div id="institutionChoicePanel" class="mb-3" hidden>
            <label class="form-label" for="institutionChoice">@T["SelectInstitutionForLogin"]</label>
            <select id="institutionChoice" class="form-select" aria-label="@T["SelectInstitutionForLogin"]"></select>
            <small class="form-text text-muted">@T["InstitutionChoiceHelp"]</small>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div class="form-check">
                <input type="checkbox" id="rememberMe" class="form-check-input" />
                <label class="form-check-label auth-meta" for="rememberMe">@T["RememberMe"]</label>
            </div>
            <a href="/Account/ForgotPassword" class="auth-meta text-decoration-none">@T["ForgotPasswordQuestion"]</a>
        </div>

        <button id="loginBtn" type="submit" class="btn btn-primary auth-primary-action w-100"
                data-idle-label="@T["SignIn"]" data-loading-label="@T["SigningIn"]"
                data-reset-success="@T["PasswordResetSuccess"]"
                               data-password-changed-success="@T["PasswordChangedSignInAgain"]">
            @T["SignIn"]
        </button>

        @if (demoEnabled)
        {
            <div class="mt-3 border rounded-3 p-3" aria-label="Demo role sign in">
                <button type="button" class="btn btn-outline-primary w-100" data-demo-toggle
                        aria-expanded="false" aria-controls="demoLoginPanel">
                    Demo Login / ডেমো লগইন
                </button>
                <div id="demoLoginPanel" class="mt-3" data-demo-password="@DemoConfiguration["DemoData:SharedPassword"]" hidden>
                    <label class="form-label" for="demoRole">Choose demo role / রোল নির্বাচন</label>
                    <select id="demoRole" class="form-select mb-2">
                        @foreach (var role in EduOS.Persistence.Seed.DemoInstitutionSeeder.Roles)
                        {
                            <option value="@EduOS.Persistence.Seed.DemoInstitutionSeeder.EmailFor(role)">@role</option>
                        }
                    </select>
                    <button class="btn btn-outline-primary w-100" type="button" data-demo-login>
                        Sign in with selected role
                    </button>
                </div>
            </div>
        }

        <p class="auth-meta text-center mt-3 mb-0">
            @T["NoAccount"]
            <a href="/Account/Signup">@T["SignUpNow"]</a>
        </p>
    </form>
</section>

<dialog class="page-help-drawer" id="pageHelpDrawer" aria-labelledby="pageHelpTitle" aria-modal="true">
    <div class="page-help-heading">
        <h2 id="pageHelpTitle">@T["FullPageManual"]</h2>
        <button type="button" id="pageHelpClose" class="icon-button" aria-label="@T["Close"]">×</button>
    </div>
    <div id="pageHelpContent" class="page-help-content"></div>
</dialog>

@section Scripts {
    <script src="~/js/account/login.js" asp-append-version="true"></script>
    <script src="~/js/platform/page-context-help.js" asp-append-version="true"></script>
}
