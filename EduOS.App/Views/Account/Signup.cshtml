@{
    ViewData["Title"] = "Institution Sign Up";
    Layout = "_PublicLayout";
}

<section class="auth-card auth-card-wide" aria-labelledby="signupTitle">
    <div class="auth-heading">
        <h1 id="signupTitle">@T["SignupTitle"]</h1>
        <p>@T["SignupSubtitle"]</p>
    </div>

    <div id="alertContainer" class="d-none" role="alert" aria-live="polite" tabindex="-1"></div>

    <form id="signupForm" novalidate
          data-creating-label="@T["CreatingAccount"]"
          data-create-label="@T["CreateInstitutionAccount"]"
          data-institution-required="@T["InstitutionNameRequired"]"
          data-institution-type-required="@T["InstitutionTypeRequired"]"
          data-owner-required="@T["OwnerNameRequired"]"
          data-email-required="@T["ValidEmailRequired"]"
          data-password-min="@T["PasswordMinSix"]"
          data-password-mismatch="@T["PasswordsDoNotMatch"]"
          data-terms-required="@T["MustAgreeTerms"]"
          data-signup-failed="@T["SignupFailed"]"
          data-network-message="@T["NetworkError"]"
          data-catalog-failed="@T["CatalogLoadFailed"]"
          data-select-type="@T["SelectInstitutionType"]"
          data-account-exists="@T["AccountAlreadyExists"]"
          data-very-weak="@T["VeryWeak"]"
          data-weak="@T["Weak"]"
          data-fair="@T["Fair"]"
          data-strong="@T["Strong"]"
          data-very-strong="@T["VeryStrong"]">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="institutionName">@T["InstitutionName"]</label>
                <input type="text" id="institutionName" class="form-control"
                       autocomplete="organization" placeholder="@T["InstitutionNameExample"]" required />
                <div class="invalid-feedback"></div>
            </div>

            <div class="col-md-6">
                <label class="form-label" for="institutionType">@T["InstitutionType"]</label>
                <select id="institutionType" class="form-select" required disabled>
                    <option value="">@T["LoadingInstitutionTypes"]</option>
                </select>
                <div class="invalid-feedback"></div>
            </div>

            <div class="col-md-6">
                <label class="form-label" for="ownerName">@T["OwnerAdminName"]</label>
                <input type="text" id="ownerName" class="form-control" autocomplete="name"
                       placeholder="@T["OwnerNameExample"]" required />
                <div class="invalid-feedback"></div>
            </div>

            <div class="col-md-6">
                <label class="form-label" for="email">@T["EmailAddress"]</label>
                <input type="email" id="email" class="form-control" autocomplete="email"
                       inputmode="email" placeholder="admin@example.edu.bd" required />
                <div class="invalid-feedback"></div>
            </div>

            <div class="col-md-6">
                <label class="form-label" for="phone">@T["PhoneNumber"]</label>
                <input type="tel" id="phone" class="form-control" autocomplete="tel"
                       inputmode="tel" placeholder="@T["BangladeshPhoneExample"]" />
                <div class="invalid-feedback"></div>
            </div>

            <div class="col-md-6">
                <label class="form-label" for="password">@T["Password"]</label>
                <input type="password" id="password" class="form-control" autocomplete="new-password"
                       minlength="6" placeholder="@T["EnterPassword"]" required />
                <div class="password-strength" aria-hidden="true">
                    <div id="strengthBar" class="progress-bar"></div>
                </div>
                <small id="strengthLabel" class="auth-meta"></small>
                <div class="invalid-feedback"></div>
            </div>

            <div class="col-md-6">
                <label class="form-label" for="confirmPassword">@T["ConfirmPassword"]</label>
                <input type="password" id="confirmPassword" class="form-control"
                       autocomplete="new-password" minlength="6" required />
                <div class="invalid-feedback"></div>
            </div>

            <div class="col-12">
                <div class="form-check mt-1">
                    <input class="form-check-input" type="checkbox" id="agreeTerms" required />
                    <label class="form-check-label auth-meta" for="agreeTerms">@T["AgreeTerms"]</label>
                    <div class="invalid-feedback"></div>
                </div>
            </div>

            <div class="col-12">
                <button type="submit" id="signupBtn" class="btn btn-primary auth-primary-action w-100"
                        data-idle-label="@T["CreateInstitutionAccount"]" data-loading-label="@T["CreatingAccount"]">
                    @T["CreateInstitutionAccount"]
                </button>
            </div>

            <div class="col-12 text-center auth-meta">
                @T["AlreadyHaveAccount"] <a href="/Account/Login">@T["SignIn"]</a>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <script src="~/js/account/signup.js" asp-append-version="true"></script>
}
