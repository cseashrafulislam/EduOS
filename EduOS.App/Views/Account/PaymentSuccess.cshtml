@{
    ViewData["Title"] = "Payment successful";
    Layout = "_Layout";
    var transactionReference = Context.Request.Query["txn"].ToString();
}

<section class="status-card in-app-status" aria-labelledby="paymentSuccessTitle">
    <div class="status-mark" aria-hidden="true">✓</div>
    <h1 id="paymentSuccessTitle">@T["PaymentSuccessfulTitle"]</h1>
    <p>@T["PaymentSuccessfulMessage"]</p>

    @if (!string.IsNullOrWhiteSpace(transactionReference))
    {
        <div class="transaction-reference">
            <strong>@T["Transaction"]:</strong> @transactionReference
        </div>
    }

    <div class="d-grid gap-2 mt-4">
        <a href="/Account/CampusSetup" class="btn btn-primary auth-primary-action">@T["ContinueSetup"]</a>
        <a href="/Dashboard" class="btn btn-link text-muted">@T["GoToDashboard"]</a>
    </div>
</section>
