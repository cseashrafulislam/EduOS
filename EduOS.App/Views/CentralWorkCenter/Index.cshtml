@{
    ViewData["Title"] = "My Work & Approvals";
    var bn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
}
<section class="container-fluid cwc-page py-2" id="centralWorkCenter"
         aria-label="@(bn ? "আমার কাজ ও অনুমোদন" : "My Work & Approvals")">
    @* The application shell already renders the page heading. No duplicate heading here. *@
    <div id="cwcAlert" class="d-none" role="status" aria-live="polite"></div>
    <button id="cwcRetry" class="btn btn-outline-primary btn-sm mb-2" type="button" hidden>@(bn ? "আবার চেষ্টা করুন" : "Try again")</button>
    <div class="card border-0 shadow-sm cwc-filters mb-2">
        <div class="card-body p-3">
            <form id="cwcFilters" class="row g-2 align-items-end" role="search">
                <div class="col-12 col-sm-6 col-xl-3">
                    <label for="cwcReference" class="form-label">@(bn ? "রেফারেন্স" : "Reference")</label>
                    <input id="cwcReference" class="form-control form-control-sm" type="search" maxlength="80"
                           autocomplete="off" placeholder="@(bn ? "রেফারেন্স নম্বর খুঁজুন" : "Search reference number")" />
                </div>
                <div class="col-6 col-sm-6 col-xl-2">
                    <label for="cwcSource" class="form-label">@(bn ? "কাজের ধরন" : "Work type")</label>
                    <select id="cwcSource" class="form-select form-select-sm">
                        <option value="">@(bn ? "সব ধরনের কাজ" : "All work types")</option>
                        <option value="ProcurementRequisition">@(bn ? "ক্রয় চাহিদাপত্র" : "Purchase requisitions")</option>
                        <option value="ProcurementPurchaseOrder">@(bn ? "ক্রয়াদেশ" : "Purchase orders")</option>
                        <option value="FacilityVisitorPolicy">@(bn ? "ভিজিটর নীতি" : "Visitor policies")</option>
                        <option value="AccountingJournal">@(bn ? "জার্নাল" : "Accounting journals")</option>
                    </select>
                </div>
                <div class="col-6 col-sm-6 col-xl-2">
                    <label for="cwcCampus" class="form-label">@(bn ? "ক্যাম্পাস" : "Campus")</label>
                    <select id="cwcCampus" class="form-select form-select-sm">
                        <option value="">@(bn ? "সব ক্যাম্পাস" : "All campuses")</option>
                    </select>
                </div>
                <div class="col-6 col-sm-6 col-xl-2">
                    <label for="cwcOrder" class="form-label">@(bn ? "ক্রম" : "Sort by")</label>
                    <select id="cwcOrder" class="form-select form-select-sm">
                        <option value="oldest">@(bn ? "পুরোনো আগে" : "Oldest first")</option>
                        <option value="newest">@(bn ? "নতুন আগে" : "Newest first")</option>
                    </select>
                </div>
                <div class="col-6 col-sm-3 col-xl-1">
                    <label for="cwcPageSize" class="form-label">@(bn ? "সারি" : "Rows")</label>
                    <select id="cwcPageSize" class="form-select form-select-sm">
                        <option>10</option><option selected>25</option><option>50</option>
                    </select>
                </div>
                <div class="col-12 col-sm-auto col-xl-2 d-flex align-items-center gap-2">
                    <button class="btn btn-primary btn-sm" type="submit">@(bn ? "খুঁজুন" : "Search")</button>
                    <button id="cwcClear" class="btn btn-outline-secondary btn-sm" type="button">@(bn ? "মুছুন" : "Clear")</button>
                </div>
            </form>
        </div>
    </div>
    <section aria-label="@(bn ? "আমার অপেক্ষমাণ কাজের সারাংশ" : "My actionable work summary")" class="mb-2">
        <div id="cwcSummary" class="cwc-summary-grid" aria-live="polite">
            <p class="small text-muted mb-0">@(bn ? "কাজের সংখ্যা লোড হচ্ছে…" : "Loading pending counts…")</p>
        </div>
    </section>
    <div class="card border-0 shadow-sm cwc-results">
        <div class="card-header bg-white d-flex align-items-center justify-content-between flex-wrap gap-2 py-2 px-3">
            <div class="cwc-result-heading">
                <h2 class="h6 fw-semibold mb-0">@(bn ? "অপেক্ষমাণ অনুমোদন" : "Pending approvals")</h2>
                <p id="cwcScope" class="small text-muted mb-0" aria-live="polite"></p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button id="cwcExport" type="button" class="btn btn-outline-secondary btn-sm" disabled>@(bn ? "CSV" : "Export CSV")</button>
                <button id="cwcPrint" type="button" class="btn btn-outline-secondary btn-sm" disabled>@(bn ? "প্রিন্ট" : "Print")</button>
            </div>
        </div>
        <div class="table-responsive" id="cwcPrintable">
            <table class="table table-hover align-middle cwc-table mb-0" aria-label="@(bn ? "অপেক্ষমাণ অনুমোদন" : "Pending approvals")">
                <thead><tr>
                    <th scope="col">@(bn ? "ধরন" : "Work type")</th>
                    <th scope="col">@(bn ? "রেফারেন্স" : "Reference")</th>
                    <th scope="col">@(bn ? "ক্যাম্পাস" : "Campus")</th>
                    <th scope="col">@(bn ? "অবস্থা" : "Status")</th>
                    <th scope="col">@(bn ? "জমার সময়" : "Submitted")</th>
                    <th scope="col" class="text-end">@(bn ? "বিস্তারিত" : "Details")</th>
                </tr></thead>
                <tbody id="cwcRows"></tbody>
            </table>
        </div>
        <div class="card-footer bg-white d-flex justify-content-between align-items-center flex-wrap gap-2 px-3 py-2">
            <p class="small text-muted mb-0">@(bn ? "অনুমোদন ও পোস্টিং মূল মডিউলে হবে। CSV ও প্রিন্ট শুধু এই পৃষ্ঠার অনুমোদিত তথ্য।" : "Review and approve in the source module. Only authorized rows on this page are exported or printed.")</p>
            <nav class="d-flex align-items-center gap-2" aria-label="@(bn ? "পৃষ্ঠা পরিবর্তন" : "Work list pages")">
                <button id="cwcPrevious" class="btn btn-outline-secondary btn-sm" type="button">@(bn ? "আগের" : "Previous")</button>
                <span id="cwcPage" class="small text-muted text-nowrap" aria-live="polite"></span>
                <button id="cwcNext" class="btn btn-outline-secondary btn-sm" type="button">@(bn ? "পরের" : "Next")</button>
            </nav>
        </div>
    </div>
</section>
<style>
    #centralWorkCenter { max-width: 100%; }
    #centralWorkCenter .cwc-filters, #centralWorkCenter .cwc-results { border-radius: .7rem; }
    #centralWorkCenter .cwc-filters .form-label { font-size: .78rem; font-weight: 600; margin-bottom: .22rem; }
    #centralWorkCenter .cwc-filters .btn { min-height: 31px; }
    #centralWorkCenter .cwc-summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(155px, 1fr)); gap: .55rem; }
    #centralWorkCenter .cwc-summary-card { display: block; width: 100%; padding: .6rem .8rem; border: 1px solid var(--bs-border-color, #dee2e6); background: var(--bs-body-bg, #fff); border-radius: .6rem; text-align: left; line-height: 1.3; min-height: 70px; }
    #centralWorkCenter .cwc-summary-card:hover, #centralWorkCenter .cwc-summary-card:focus-visible { border-color: #3b82c4; box-shadow: 0 0 0 .15rem rgba(37, 99, 172, .09); }
    #centralWorkCenter .cwc-summary-card[aria-pressed="true"] { border-color: #2563a7; background: #f0f6ff; }
    #centralWorkCenter .cwc-summary-label { display: block; color: var(--bs-secondary-color, #637084); font-size: .76rem; }
    #centralWorkCenter .cwc-summary-count { display: block; font-weight: 700; font-size: 1.35rem; color: #174a83; margin-top: .18rem; }
    #centralWorkCenter .cwc-summary-card:disabled { opacity: .65; cursor: wait; }
    #centralWorkCenter .cwc-result-heading { min-width: 0; }
    #centralWorkCenter .cwc-result-heading p { font-size: .75rem; }
    #centralWorkCenter .cwc-table th { font-size: .76rem; font-weight: 650; color: var(--bs-secondary-color, #607086); white-space: nowrap; background: var(--bs-tertiary-bg, #f8fafc); }
    #centralWorkCenter .cwc-table td { font-size: .84rem; padding-top: .55rem; padding-bottom: .55rem; }
    #centralWorkCenter .cwc-table td:nth-child(2) { font-weight: 600; }
    #centralWorkCenter .cwc-table td:nth-child(6) { text-align: right; white-space: nowrap; }
    #centralWorkCenter .cwc-state { display: inline-block; padding: .2rem .5rem; border-radius: 1rem; font-size: .74rem; font-weight: 600; color: #6a4b10; background: #fff3cd; }
    #centralWorkCenter .cwc-state-cancel { color: #9a3412; background: #ffedd5; }
    @@media (max-width: 575.98px) {
        #centralWorkCenter .cwc-summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        #centralWorkCenter .cwc-table { min-width: 670px; }
    }
    @@media print {
        body * { visibility: hidden !important; }
        #centralWorkCenter, #cwcScope, #cwcPage,
        #cwcPrintable, #cwcPrintable * { visibility: visible !important; }
        #centralWorkCenter { position: absolute; left: 0; top: 0; width: 100%; }
        #cwcPrintable { overflow: visible !important; }
        #cwcPrintable table { width: 100%; font-size: 10pt; }
        #cwcPrintable th:last-child, #cwcPrintable td:last-child { display: none !important; }
    }
</style>
@section Scripts { <script src="~/js/platform/central-work-center.js" asp-append-version="true"></script> }
