@{
    ViewData["Title"] = "My Work & Approvals";
    var bn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
}
<section class="container-fluid py-3" id="centralWorkCenter" aria-label="@(bn ? "আমার কাজ ও অনুমোদন" : "My Work & Approvals")">
    <header class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <h1 class="h4 mb-0">@(bn ? "আমার কাজ ও অনুমোদন" : "My Work & Approvals")</h1>
    </header>
    <div id="cwcAlert" class="d-none" role="status" aria-live="polite"></div>
    <button id="cwcRetry" class="btn btn-outline-primary btn-sm mb-2" type="button" hidden>@(bn ? "আবার চেষ্টা করুন" : "Retry loading")</button>
    <form id="cwcFilters" class="row g-2 mb-3">
        <div class="col-12 col-sm-4 col-lg-3">
            <label for="cwcCampus" class="form-label">@(bn ? "ক্যাম্পাস আইডি (ঐচ্ছিক)" : "Campus ID (optional)")</label>
            <input id="cwcCampus" class="form-control" type="number" min="1" step="1" inputmode="numeric" />
        </div>
        <div class="col-12 col-sm-4 col-lg-3">
            <label for="cwcSource" class="form-label">@(bn ? "কাজের ধরন" : "Work type")</label>
            <select id="cwcSource" class="form-select">
                <option value="">@(bn ? "সব অনুমোদন" : "All approvals")</option>
                <option value="ProcurementRequisition">@(bn ? "ক্রয় চাহিদাপত্র" : "Purchase requisitions")</option>
                <option value="ProcurementPurchaseOrder">@(bn ? "ক্রয়াদেশ" : "Purchase orders")</option>
                <option value="FacilityVisitorPolicy">@(bn ? "ভিজিটর নীতি" : "Visitor policies")</option>
                <option value="AccountingJournal">@(bn ? "জার্নাল" : "Accounting journals")</option>
            </select>
        </div>
        <div class="col-12 col-sm-4 col-lg-3">
            <label for="cwcReference" class="form-label">@(bn ? "রেফারেন্স খুঁজুন" : "Search reference")</label>
            <input id="cwcReference" class="form-control" type="search" maxlength="80"
                   autocomplete="off" placeholder="@(bn ? "নম্বর লিখুন" : "Reference number")" />
        </div>
        <div class="col-12 col-sm-4 col-lg-2">
            <label for="cwcOrder" class="form-label">@(bn ? "ক্রম" : "Order")</label>
            <select id="cwcOrder" class="form-select">
                <option value="oldest">@(bn ? "পুরোনো আগে" : "Oldest first")</option>
                <option value="newest">@(bn ? "নতুন আগে" : "Newest first")</option>
            </select>
        </div>
        <div class="col-12 col-sm-2 col-lg-2">
            <label for="cwcPageSize" class="form-label">@(bn ? "প্রতি পৃষ্ঠা" : "Page size")</label>
            <select id="cwcPageSize" class="form-select"><option>10</option><option selected>25</option><option>50</option></select>
        </div>
        <div class="col-12 col-sm-3 align-self-end">
            <button class="btn btn-primary" type="submit">@(bn ? "তালিকা দেখুন" : "Load pending work")</button>
        </div>
    </form>
    <p class="small text-muted">@(bn ? "প্রতিষ্ঠানব্যাপী Finance journal দেখতে ক্যাম্পাস ফিল্টার খালি রাখুন। অনুমোদন ও Posting মূল Finance পৃষ্ঠাতেই হবে।" : "Leave campus blank to include institution-wide Finance journals. Approvals and posting remain in the Finance module.")</p>
    <p id="cwcScope" class="small text-muted" aria-live="polite"></p>
    <section aria-label="@(bn ? "আমার অপেক্ষমাণ কাজের সারাংশ" : "My actionable work summary")" class="mb-3">
        <div id="cwcSummary" class="row g-2" aria-live="polite">
            <div class="col-12 small text-muted">@(bn ? "কাজের সংখ্যা লোড হচ্ছে…" : "Loading actionable counts…")</div>
        </div>
        <p class="small text-muted mt-2 mb-0">@(bn ? "সংখ্যাগুলো অনুমোদিত ক্যাম্পাস ও দায়িত্ব অনুযায়ী সার্ভার থেকে গণনা করা হয়। কোনো কার্ডে ক্লিক করলে সেই কাজের তালিকা খুলবে।" : "Counts are server-calculated for your authorized campus and role. Select a card to filter the work list.")</p>
    </section>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <button id="cwcExport" type="button" class="btn btn-outline-secondary btn-sm" disabled>@(bn ? "এই পৃষ্ঠা CSV" : "Export current page (CSV)")</button>
        <button id="cwcPrint" type="button" class="btn btn-outline-secondary btn-sm" disabled>@(bn ? "এই পৃষ্ঠা প্রিন্ট" : "Print current page")</button>
        <span class="small text-muted">@(bn ? "শুধু এই পৃষ্ঠার অনুমোদিত ফলাফল; সম্পূর্ণ হিসাব রিপোর্ট নয়।" : "Only authorized rows on this page; not a full accounting report.")</span>
    </div>
    <div class="table-responsive" id="cwcPrintable">
        <table class="table table-striped table-hover" aria-label="@(bn ? "অপেক্ষমাণ অনুমোদন" : "Pending approvals")">
            <thead><tr>
                <th scope="col">@(bn ? "বিভাগ" : "Module")</th>
                <th scope="col">@(bn ? "নম্বর" : "Reference")</th>
                <th scope="col">@(bn ? "ক্যাম্পাস" : "Campus")</th>
                <th scope="col">@(bn ? "অবস্থা" : "State")</th>
                <th scope="col">@(bn ? "জমার সময় (স্থানীয়)" : "Submitted (local time)")</th>
                <th scope="col">@(bn ? "বিস্তারিত" : "Open source")</th>
            </tr></thead>
            <tbody id="cwcRows"></tbody>
        </table>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button id="cwcPrevious" class="btn btn-outline-secondary btn-sm" type="button">@(bn ? "আগের" : "Previous")</button>
        <span id="cwcPage" aria-live="polite"></span>
        <button id="cwcNext" class="btn btn-outline-secondary btn-sm" type="button">@(bn ? "পরের" : "Next")</button>
    </div>
</section>
<style>
    @@media print {
        body * { visibility: hidden !important; }
        #centralWorkCenter, #centralWorkCenter h1, #cwcScope, #cwcPage,
        #cwcPrintable, #cwcPrintable * { visibility: visible !important; }
        #centralWorkCenter { position: absolute; left: 0; top: 0; width: 100%; }
        #cwcPrintable { overflow: visible !important; }
        #cwcPrintable table { width: 100%; font-size: 10pt; }
        #cwcPrintable th:last-child, #cwcPrintable td:last-child { display: none !important; }
    }
</style>
@section Scripts { <script src="~/js/platform/central-work-center.js" asp-append-version="true"></script> }
