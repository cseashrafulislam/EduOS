@using System.Globalization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var bn = CultureInfo.CurrentUICulture.Name == "bn-BD";
    var section = ViewData["AcademicSection"] as string ?? "years";
    var feature = section switch
    {
        "departments" => (En: "Departments", Bn: "বিভাগ"),
        "terms" => (En: "Terms / Semesters", Bn: "টার্ম / সেমিস্টার"),
        "classes" => (En: "Programmes, Classes & Grades", Bn: "প্রোগ্রাম, শ্রেণি ও গ্রেড"),
        "sections" => (En: "Academic Batches", Bn: "একাডেমিক ব্যাচ"),
        "rooms" => (En: "Rooms", Bn: "কক্ষ"),
        "subjects" => (En: "Subjects", Bn: "বিষয়"),
        "curricula" => (En: "Curriculum", Bn: "পাঠ্যক্রম"),
        "offerings" => (En: "Subject Offerings", Bn: "ব্যাচের বিষয় অফার"),
        _ => (En: "Academic Years", Bn: "শিক্ষাবর্ষ")
    };
    ViewData["Title"] = bn ? feature.Bn : feature.En;
}
<div id="academicManagement" class="container-fluid py-2" data-bangla="@(bn ? "true" : "false")" data-active-feature="@(section)">
    @Html.AntiForgeryToken()
    <div id="academicNotice" class="alert d-none" role="alert" aria-live="polite"></div>
    <section data-section="departments" class="card border-0 shadow-sm @(section == "departments" ? "" : "d-none")">
        <div class="card-body">
            <div class="row g-2 mb-3">
                <div class="col-md-6"><label for="departmentSearch" class="form-label">@(bn ? "নাম / কোডের শুরু দিয়ে খুঁজুন" : "Search name / code prefix")</label><input id="departmentSearch" class="form-control" maxlength="80" /></div>
                <div class="col-md-3 d-flex align-items-end"><button id="departmentSearchButton" type="button" class="btn btn-outline-primary">@(bn ? "খুঁজুন" : "Search")</button></div>
            </div>
            <form id="departmentForm" class="row g-2 align-items-end mb-3">
                <input id="departmentId" type="hidden" /><input id="departmentVersion" type="hidden" />
                <div class="col-md-4"><label for="departmentName" class="form-label">@(bn ? "নাম *" : "Name *")</label><input id="departmentName" class="form-control" maxlength="150" required /></div>
                <input id="departmentCode" type="hidden" />
                <div class="col-md-4"><label for="departmentDescription" class="form-label">@(bn ? "বিবরণ" : "Description")</label><input id="departmentDescription" class="form-control" maxlength="500" /></div>
                <div class="col-md-1"><label class="form-check"><input id="departmentActive" type="checkbox" class="form-check-input" checked /><span class="form-check-label">@(bn ? "সক্রিয়" : "Active")</span></label></div>
                <div class="col-md-2 d-flex gap-2"><button id="departmentSave" type="submit" class="btn btn-primary">@(bn ? "বিভাগ যোগ করুন" : "Create Department")</button><button id="departmentCancel" type="button" class="btn btn-outline-secondary">@(bn ? "পরিষ্কার" : "Clear")</button></div>
            </form>
            <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th scope="col">@(bn ? "নাম" : "Name")</th><th scope="col">@(bn ? "কোড" : "Code")</th><th scope="col">@(bn ? "বিবরণ" : "Description")</th><th scope="col">@(bn ? "অবস্থা" : "Status")</th><th scope="col">@(bn ? "কাজ" : "Action")</th></tr></thead><tbody id="departmentRows"></tbody></table></div>
            <div class="d-flex gap-2 align-items-center"><button id="departmentPrev" type="button" class="btn btn-sm btn-outline-secondary">@(bn ? "আগের" : "Previous")</button><span id="departmentPage" class="small text-muted"></span><button id="departmentNext" type="button" class="btn btn-sm btn-outline-secondary">@(bn ? "পরের" : "Next")</button><button id="departmentCsv" type="button" class="btn btn-sm btn-outline-primary ms-auto">@(bn ? "দেখানো তথ্য CSV" : "Export visible CSV")</button></div>
        </div>
    </section>
    <section data-section="years" class="card border-0 shadow-sm @(section == "years" ? "" : "d-none")">
        <div class="card-body">
            <form id="yearForm" class="row g-3 mb-3">
                <input id="yearId" type="hidden" /><input id="yearVersion" type="hidden" />
                <div class="col-lg-5"><label for="yearName" class="form-label">@(bn ? "নাম *" : "Name *")</label><input id="yearName" class="form-control" maxlength="100" required placeholder="Academic 2026" /></div>
                <input id="yearCode" type="hidden" />
                <div class="col-lg-3"><label for="yearCampus" class="form-label">@(bn ? "ক্যাম্পাস" : "Campus")</label><select id="yearCampus" class="form-select"></select></div>
                <div class="col-lg-2"><label for="yearStart" class="form-label">@(bn ? "শুরুর তারিখ *" : "Start date *")</label><input id="yearStart" type="date" class="form-control" required /></div>
                <div class="col-lg-2"><label for="yearEnd" class="form-label">@(bn ? "শেষ তারিখ *" : "End date *")</label><input id="yearEnd" type="date" class="form-control" required /></div>
                <div class="col-md-4"><label for="yearCycle" class="form-label">@(bn ? "সময়কাল" : "Cycle")</label><select id="yearCycle" class="form-select"><option value="1">@(bn ? "বার্ষিক" : "Annual")</option><option value="2">@(bn ? "সেমিস্টার" : "Semester")</option><option value="3">@(bn ? "ট্রাইমেস্টার" : "Trimester")</option><option value="4">@(bn ? "ত্রৈমাসিক" : "Quarterly")</option><option value="5">@(bn ? "মডিউলার" : "Modular")</option><option value="6">@(bn ? "ব্যাচভিত্তিক" : "Batch-based")</option></select></div>
                <div class="col-md-3 academic-check-cell"><label class="form-check academic-check-control"><input id="yearCurrent" type="checkbox" class="form-check-input" /><span class="form-check-label">@(bn ? "বর্তমান শিক্ষাবর্ষ" : "Current year")</span></label></div>
                <div class="col-md-5 academic-form-actions"><button type="submit" class="btn btn-primary">@(bn ? "শিক্ষাবর্ষ সংরক্ষণ" : "Save Year")</button><button type="button" data-reset="year" class="btn btn-outline-secondary">@(bn ? "পরিষ্কার" : "Clear")</button></div>
            </form>
            <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th scope="col">@(bn ? "শিক্ষাবর্ষ" : "Year")</th><th scope="col">@(bn ? "কোড" : "Code")</th><th scope="col">@(bn ? "ক্যাম্পাস" : "Campus")</th><th scope="col">@(bn ? "তারিখ" : "Dates")</th><th scope="col">@(bn ? "বর্তমান" : "Current")</th><th scope="col">@(bn ? "কার্যক্রম" : "Actions")</th></tr></thead><tbody id="yearRows"></tbody></table></div>
        </div>
    </section>
    <section data-section="terms" class="card border-0 shadow-sm @(section == "terms" ? "" : "d-none")">
        <div class="card-body">
            <form id="termForm" class="row g-3 mb-3">
                <input id="termId" type="hidden" /><input id="termVersion" type="hidden" />
                <div class="col-md-6"><label for="termYear" class="form-label">@(bn ? "শিক্ষাবর্ষ *" : "Academic year *")</label><select id="termYear" class="form-select" required></select></div>
                <div class="col-md-6"><label for="termName" class="form-label">@(bn ? "টার্মের নাম *" : "Term name *")</label><input id="termName" class="form-control" maxlength="100" required /></div>
                <input id="termCode" type="hidden" />
                <div class="col-md-4"><label for="termStart" class="form-label">@(bn ? "শুরুর তারিখ *" : "Start date *")</label><input id="termStart" type="date" class="form-control" required /></div>
                <div class="col-md-4"><label for="termEnd" class="form-label">@(bn ? "শেষ তারিখ *" : "End date *")</label><input id="termEnd" type="date" class="form-control" required /></div>
                <div class="col-md-4 academic-check-cell"><label class="form-check academic-check-control"><input id="termCurrent" type="checkbox" class="form-check-input" /><span class="form-check-label">@(bn ? "বর্তমান টার্ম" : "Current term")</span></label></div>
                <div class="col-12 academic-form-actions"><button type="submit" class="btn btn-primary">@(bn ? "টার্ম সংরক্ষণ" : "Save Term")</button><button type="button" data-reset="term" class="btn btn-outline-secondary">@(bn ? "পরিষ্কার" : "Clear")</button></div>
            </form>
            <div class="table-responsive"><table class="table table-hover"><thead><tr><th scope="col">@(bn ? "টার্ম" : "Term")</th><th scope="col">@(bn ? "শিক্ষাবর্ষ" : "Year")</th><th scope="col">@(bn ? "কোড" : "Code")</th><th scope="col">@(bn ? "তারিখ" : "Dates")</th><th scope="col">@(bn ? "বর্তমান" : "Current")</th><th scope="col">@(bn ? "কার্যক্রম" : "Actions")</th></tr></thead><tbody id="termRows"></tbody></table></div>
        </div>
    </section>
    <section data-section="classes" class="card border-0 shadow-sm @(section == "classes" ? "" : "d-none")">
        <div class="card-body">
            <form id="programForm" class="row g-2 align-items-end mb-4">
                <p class="col-12 small text-muted mb-0">@(bn ? "অভ্যন্তরীণ কোড সিস্টেম নিজে তৈরি করবে।" : "Internal Code is generated automatically.")</p>
                <div class="col-md-3"><label for="programName" class="form-label">@(bn ? "প্রোগ্রামের নাম *" : "Programme name *")</label><input id="programName" class="form-control" maxlength="200" required placeholder="Secondary" /></div>
                <input id="programCode" type="hidden" />
                <div class="col-md-2"><label for="programDuration" class="form-label">@(bn ? "মাস" : "Months")</label><input id="programDuration" type="number" min="0" max="1200" value="0" class="form-control" /></div>
                <div class="col-md-3"><label for="programCampus" class="form-label">@(bn ? "যেসব ক্যাম্পাসে থাকবে (একাধিক নির্বাচন)" : "Offered at campuses (Ctrl/Cmd + click)")</label><select id="programCampus" class="form-select" multiple size="3" aria-describedby="programCampusHelp"></select><small id="programCampusHelp" class="visually-hidden">@(bn ? "সব ক্যাম্পাস হলে ফাঁকা রাখুন।" : "Leave empty for all campuses.")</small></div>
                <div class="col-md-2"><label for="programDepartment" class="form-label">@(bn ? "বিভাগ" : "Department")</label><select id="programDepartment" class="form-select"><option value="">@(bn ? "বিভাগ নেই" : "No department")</option></select><button type="submit" class="btn btn-primary w-100 mt-2">@(bn ? "প্রোগ্রাম যোগ করুন" : "Add Programme")</button></div>
            </form>
            <h3 class="visually-hidden">@(bn ? "উপলব্ধ প্রোগ্রাম" : "Available programmes")</h3>
            <div id="programList" class="mb-2"></div>
            <div class="table-responsive mb-3"><table class="table table-hover align-middle">
                <thead><tr><th scope="col">@(bn ? "প্রোগ্রাম" : "Programme")</th><th scope="col">@(bn ? "ক্যাম্পাসভিত্তিক উপলব্ধতা" : "Campus availability")</th><th scope="col">@(bn ? "কাজ" : "Action")</th></tr></thead>
                <tbody id="programCampusRows"></tbody>
            </table></div>
            <div class="border rounded p-3 mb-4">
                <h3 class="visually-hidden">Programme metadata &amp; department reassignment</h3>
                <div class="row g-2 mb-2">
                    <div class="col-md-6"><label for="programmeSearch" class="form-label">@(bn ? "প্রোগ্রামের নাম / কোড" : "Programme name / code prefix")</label><input id="programmeSearch" class="form-control" maxlength="80" /></div>
                    <div class="col-md-2 d-flex align-items-end"><button id="programmeSearchButton" type="button" class="btn btn-outline-primary">@(bn ? "খুঁজুন" : "Search")</button></div>
                </div>
                <div class="table-responsive"><table class="table table-hover align-middle">
                    <thead><tr><th scope="col">@(bn ? "প্রোগ্রাম" : "Programme")</th><th scope="col">@(bn ? "কোড" : "Code")</th><th scope="col">@(bn ? "বিভাগ" : "Department")</th><th scope="col">@(bn ? "মাস" : "Months")</th><th scope="col">@(bn ? "অবস্থা" : "Status")</th><th scope="col">@(bn ? "কাজ" : "Action")</th></tr></thead>
                    <tbody id="programmeRows"></tbody>
                </table></div>
                <div class="d-flex gap-2 align-items-center mb-3">
                    <button id="programmePrev" type="button" class="btn btn-sm btn-outline-secondary">@(bn ? "আগের" : "Previous")</button>
                    <span id="programmePage" class="small text-muted"></span>
                    <button id="programmeNext" type="button" class="btn btn-sm btn-outline-secondary">@(bn ? "পরের" : "Next")</button>
                    <button id="programmeCsv" type="button" class="btn btn-sm btn-outline-primary ms-auto">@(bn ? "দেখানো তথ্য CSV" : "Export visible CSV")</button>
                </div>
                <form id="programmeEditForm" class="row g-2 d-none">
                    <input id="programmeEditId" type="hidden" /><input id="programmeEditVersion" type="hidden" />
                    <div class="col-md-2"><label for="programmeEditCode" class="form-label">@(bn ? "কোড (অপরিবর্তনীয়)" : "Code (immutable)")</label><input id="programmeEditCode" class="form-control" readonly /></div>
                    <div class="col-md-4"><label for="programmeEditName" class="form-label">@(bn ? "নাম *" : "Name *")</label><input id="programmeEditName" class="form-control" maxlength="200" required /></div>
                    <div class="col-md-3"><label for="programmeEditShortName" class="form-label">@(bn ? "সংক্ষিপ্ত নাম" : "Short name")</label><input id="programmeEditShortName" class="form-control" maxlength="100" /></div>
                    <div class="col-md-3"><label for="programmeEditDuration" class="form-label">@(bn ? "মেয়াদ (মাস)" : "Duration (months)")</label><input id="programmeEditDuration" type="number" min="0" max="1200" class="form-control" required /></div>
                    <div class="col-md-4"><label for="programmeDepartmentSearch" class="form-label">@(bn ? "বিভাগ খুঁজুন" : "Find department by prefix")</label><div class="input-group"><input id="programmeDepartmentSearch" class="form-control" maxlength="80" /><button id="programmeDepartmentSearchButton" type="button" class="btn btn-outline-secondary">@(bn ? "খুঁজুন" : "Find")</button></div></div>
                    <div class="col-md-4"><label for="programmeEditDepartment" class="form-label">@(bn ? "বিভাগ" : "Department")</label><select id="programmeEditDepartment" class="form-select"><option value="">@(bn ? "বিভাগ নেই" : "No department")</option></select></div>
                    <div class="col-md-4"><label for="programmeEditAward" class="form-label">@(bn ? "সনদের নাম" : "Award title")</label><input id="programmeEditAward" class="form-control" maxlength="150" /></div>
                    <div class="col-md-6"><label for="programmeEditDescription" class="form-label">@(bn ? "বিবরণ" : "Description")</label><textarea id="programmeEditDescription" class="form-control" rows="2" maxlength="1000"></textarea></div>
                    <div class="col-md-2"><label for="programmeEditOrder" class="form-label">@(bn ? "প্রদর্শনের ক্রম" : "Display order")</label><input id="programmeEditOrder" type="number" min="0" class="form-control" required /></div>
                    <div class="col-md-2 d-flex align-items-center"><label class="form-check"><input id="programmeEditAdmissions" type="checkbox" class="form-check-input" /><span class="form-check-label">@(bn ? "ভর্তি চালু" : "Admissions open")</span></label></div>
                    <div class="col-md-2 d-flex align-items-center"><label class="form-check"><input id="programmeEditActive" type="checkbox" class="form-check-input" /><span class="form-check-label">@(bn ? "সক্রিয়" : "Active")</span></label></div>
                    <div class="col-12 d-flex gap-2"><button id="programmeEditSave" type="submit" class="btn btn-primary">@(bn ? "তথ্য সংরক্ষণ" : "Save metadata")</button><button id="programmeEditCancel" type="button" class="btn btn-outline-secondary">@(bn ? "বাতিল" : "Cancel")</button></div>
                </form>
            </div>
            <form id="programAllocationForm" class="card border-primary mb-4 d-none">
                <div class="card-body">
                    <div class="small fw-semibold"><span id="allocationProgramName" aria-live="polite"></span></div>
                    <input id="allocationProgramId" type="hidden" />
                    <input id="allocationRowVersion" type="hidden" />
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label for="allocationCampuses" class="form-label">@(bn ? "অনুমোদিত ক্যাম্পাস (একাধিক নির্বাচন)" : "Allowed campuses (Ctrl/Cmd + click)")</label>
                            <select id="allocationCampuses" class="form-select" multiple size="5"></select>
                        </div>
                        <div class="col-md-4">
                            <label for="allocationPrimary" class="form-label">@(bn ? "প্রধান ক্যাম্পাস" : "Primary campus")</label>
                            <select id="allocationPrimary" class="form-select"></select>
                            <div class="form-check mt-3">
                                <input id="allocationAllowAll" type="checkbox" class="form-check-input" />
                                <label for="allocationAllowAll" class="form-check-label">Unrestricted — allow all tenant campuses</label>
                            </div>
                            <small class="visually-hidden">@(bn ? "ব্যাচে ব্যবহৃত ক্যাম্পাস সরানো যাবে না। সীমিত প্রোগ্রামের জন্য প্রধান ক্যাম্পাস আবশ্যক।" : "Removing a campus is blocked when existing academic batches depend on it. A primary campus is required for restricted programmes.")</small>
                        </div>
                        <div class="col-md-3 d-flex align-items-end gap-2">
                            <button type="submit" class="btn btn-primary">@(bn ? "ক্যাম্পাস বরাদ্দ সংরক্ষণ" : "Save allocation")</button>
                            <button id="allocationCancel" type="button" class="btn btn-outline-secondary">@(bn ? "বাতিল" : "Cancel")</button>
                        </div>
                    </div>
                </div>
            </form>
            <form id="levelForm" class="row g-2 align-items-end mb-3">
                <p class="col-12 small text-muted mb-0">@(bn ? "অভ্যন্তরীণ কোড সিস্টেম নিজে তৈরি করবে।" : "Internal Code is generated automatically.")</p>
                <div class="col-md-3"><label for="levelProgram" class="form-label">@(bn ? "প্রোগ্রাম *" : "Programme *")</label><select id="levelProgram" class="form-select" required></select></div>
                <div class="col-md-3"><label for="levelName" class="form-label">@(bn ? "শ্রেণি / গ্রেডের নাম *" : "Class / Grade name *")</label><input id="levelName" class="form-control" required maxlength="150" placeholder="Grade 9" /></div>
                <input id="levelCode" type="hidden" />
                <div class="col-md-2"><label for="levelNumber" class="form-label">@(bn ? "শ্রেণির নম্বর *" : "Level number *")</label><input id="levelNumber" class="form-control" required type="number" min="1" max="1000" value="1" /></div>
                <div class="col-md-2"><button class="btn btn-primary w-100" type="submit">@(bn ? "শ্রেণি যোগ করুন" : "Add Class")</button></div>
            </form>
            <div class="border rounded p-3">
                <h3 class="visually-hidden">@(bn ? "শ্রেণি / গ্রেড পরিচালনা" : "Class / Grade administration")</h3>
                <form id="levelSearchForm" class="row g-2 mb-3">
                    <div class="col-md-5"><label for="levelSearch" class="form-label">@(bn ? "শ্রেণির নাম / কোড" : "Level name / code prefix")</label><input id="levelSearch" maxlength="80" class="form-control" /></div>
                    <div class="col-md-4"><label for="levelProgramFilter" class="form-label">@(bn ? "প্রোগ্রাম" : "Programme")</label><select id="levelProgramFilter" class="form-select"></select></div>
                    <div class="col-md-3 d-flex align-items-end gap-2"><button type="submit" class="btn btn-outline-primary">@(bn ? "খুঁজুন" : "Search")</button><button id="levelCsv" type="button" class="btn btn-outline-secondary">@(bn ? "দেখানো তথ্য CSV" : "Export visible CSV")</button></div>
                </form>
                <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th scope="col">@(bn ? "শ্রেণি / গ্রেড" : "Class / Grade")</th><th scope="col">@(bn ? "কোড" : "Code")</th><th scope="col">@(bn ? "প্রোগ্রাম" : "Programme")</th><th scope="col">@(bn ? "শ্রেণি" : "Level")</th><th scope="col">@(bn ? "পরবর্তী শ্রেণি" : "Progression")</th><th scope="col">@(bn ? "অবস্থা" : "Status")</th><th scope="col">@(bn ? "কাজ" : "Action")</th></tr></thead><tbody id="levelRows"></tbody></table></div>
