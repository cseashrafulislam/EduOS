@{
    ViewData["Title"] = "Academic Setup & Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="academicManagement" class="container-fluid py-4">
    @Html.AntiForgeryToken()
    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h4 fw-bold mb-1">Academic Setup &amp; Management</h1>
            <p class="text-muted mb-0">Years, terms, class programmes, class levels, sections, subjects and curriculum.</p>
        </div>
        <button id="academicRefresh" type="button" class="btn btn-outline-secondary">Refresh</button>
    </div>
    <div id="academicNotice" class="alert d-none" role="alert" aria-live="polite"></div>
    <ul class="nav nav-tabs flex-wrap mb-3" role="tablist" aria-label="Academic setup">
        <li class="nav-item"><button data-panel="departments" class="nav-link" type="button">Departments</button></li>
        <li class="nav-item"><button data-panel="years" class="nav-link active" type="button">Academic Years</button></li>
        <li class="nav-item"><button data-panel="terms" class="nav-link" type="button">Terms</button></li>
        <li class="nav-item"><button data-panel="classes" class="nav-link" type="button">Classes / Grades</button></li>
        <li class="nav-item"><button data-panel="sections" class="nav-link" type="button">Sections</button></li>
        <li class="nav-item"><button data-panel="rooms" class="nav-link" type="button">Rooms</button></li>
        <li class="nav-item"><button data-panel="subjects" class="nav-link" type="button">Subjects</button></li>
        <li class="nav-item"><button data-panel="curricula" class="nav-link" type="button">Curriculum</button></li>
        <li class="nav-item"><button data-panel="offerings" class="nav-link" type="button">Subject Offerings</button></li>
    </ul>
    <section data-section="departments" class="card border-0 shadow-sm d-none">
        <div class="card-body">
            <h2 class="h5">Academic departments</h2>
            <p class="small text-muted">Organize programmes by department. Active programmes prevent department deactivation. Codes are immutable.</p>
            <div class="row g-2 mb-3">
                <div class="col-md-6"><label for="departmentSearch" class="form-label">Search name / code prefix</label><input id="departmentSearch" class="form-control" maxlength="80" /></div>
                <div class="col-md-3 d-flex align-items-end"><button id="departmentSearchButton" type="button" class="btn btn-outline-primary">Search</button></div>
            </div>
            <form id="departmentForm" class="row g-2 align-items-end mb-3">
                <input id="departmentId" type="hidden" /><input id="departmentVersion" type="hidden" />
                <div class="col-md-3"><label for="departmentName" class="form-label">Name *</label><input id="departmentName" class="form-control" maxlength="150" required /></div>
                <div class="col-md-2"><label for="departmentCode" class="form-label">Code *</label><input id="departmentCode" class="form-control" maxlength="30" required /></div>
                <div class="col-md-4"><label for="departmentDescription" class="form-label">Description</label><input id="departmentDescription" class="form-control" maxlength="500" /></div>
                <div class="col-md-1"><label class="form-check"><input id="departmentActive" type="checkbox" class="form-check-input" checked /><span class="form-check-label">Active</span></label></div>
                <div class="col-md-2 d-flex gap-2"><button id="departmentSave" type="submit" class="btn btn-primary">Create Department</button><button id="departmentCancel" type="button" class="btn btn-outline-secondary">Clear</button></div>
            </form>
            <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Name</th><th>Code</th><th>Description</th><th>Status</th><th>Action</th></tr></thead><tbody id="departmentRows"></tbody></table></div>
            <div class="d-flex gap-2 align-items-center"><button id="departmentPrev" type="button" class="btn btn-sm btn-outline-secondary">Previous</button><span id="departmentPage" class="small text-muted"></span><button id="departmentNext" type="button" class="btn btn-sm btn-outline-secondary">Next</button><button id="departmentCsv" type="button" class="btn btn-sm btn-outline-primary ms-auto">Export visible CSV</button></div>
        </div>
    </section>
    <section data-section="years" class="card border-0 shadow-sm">
        <div class="card-body">
            <h2 class="h5">Academic years</h2>
            <form id="yearForm" class="row g-3 mb-3">
                <input id="yearId" type="hidden" /><input id="yearVersion" type="hidden" />
                <div class="col-lg-3"><label for="yearName" class="form-label">Name *</label><input id="yearName" class="form-control" maxlength="100" required placeholder="Academic 2026" /></div>
                <div class="col-lg-2"><label for="yearCode" class="form-label">Code *</label><input id="yearCode" class="form-control" maxlength="30" required placeholder="2026" /></div>
                <div class="col-lg-3"><label for="yearCampus" class="form-label">Campus</label><select id="yearCampus" class="form-select"></select></div>
                <div class="col-lg-2"><label for="yearStart" class="form-label">Start date *</label><input id="yearStart" type="date" class="form-control" required /></div>
                <div class="col-lg-2"><label for="yearEnd" class="form-label">End date *</label><input id="yearEnd" type="date" class="form-control" required /></div>
                <div class="col-md-4"><label for="yearCycle" class="form-label">Cycle</label><select id="yearCycle" class="form-select"><option value="1">Annual</option><option value="2">Semester</option><option value="3">Trimester</option><option value="4">Quarterly</option><option value="5">Modular</option><option value="6">Batch-based</option></select></div>
                <div class="col-md-3 d-flex align-items-end"><label class="form-check"><input id="yearCurrent" type="checkbox" class="form-check-input" /><span class="form-check-label">Current year</span></label></div>
                <div class="col-md-5 d-flex align-items-end gap-2"><button type="submit" class="btn btn-primary">Save Year</button><button type="button" data-reset="year" class="btn btn-outline-secondary">Clear</button></div>
            </form>
            <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Year</th><th>Code</th><th>Campus</th><th>Dates</th><th>Current</th><th>Actions</th></tr></thead><tbody id="yearRows"></tbody></table></div>
        </div>
    </section>
    <section data-section="terms" class="card border-0 shadow-sm d-none">
        <div class="card-body">
            <h2 class="h5">Terms / Semesters</h2>
            <form id="termForm" class="row g-3 mb-3">
                <input id="termId" type="hidden" /><input id="termVersion" type="hidden" />
                <div class="col-md-4"><label for="termYear" class="form-label">Academic year *</label><select id="termYear" class="form-select" required></select></div>
                <div class="col-md-4"><label for="termName" class="form-label">Term name *</label><input id="termName" class="form-control" maxlength="100" required /></div>
                <div class="col-md-4"><label for="termCode" class="form-label">Code</label><input id="termCode" class="form-control" maxlength="30" /></div>
                <div class="col-md-3"><label for="termStart" class="form-label">Start date *</label><input id="termStart" type="date" class="form-control" required /></div>
                <div class="col-md-3"><label for="termEnd" class="form-label">End date *</label><input id="termEnd" type="date" class="form-control" required /></div>
                <div class="col-md-2 d-flex align-items-end"><label class="form-check"><input id="termCurrent" type="checkbox" class="form-check-input" /><span class="form-check-label">Current term</span></label></div>
                <div class="col-md-4 d-flex align-items-end gap-2"><button type="submit" class="btn btn-primary">Save Term</button><button type="button" data-reset="term" class="btn btn-outline-secondary">Clear</button></div>
            </form>
            <div class="table-responsive"><table class="table table-hover"><thead><tr><th>Term</th><th>Year</th><th>Code</th><th>Dates</th><th>Current</th><th>Actions</th></tr></thead><tbody id="termRows"></tbody></table></div>
        </div>
    </section>
    <section data-section="classes" class="card border-0 shadow-sm d-none">
        <div class="card-body">
            <h2 class="h5">Class programmes and grades</h2>
            <p class="text-muted small">Programme = academic stream (e.g. Secondary); Level = Class/Grade within that programme. Do not duplicate records per section.</p>
            <form id="programForm" class="row g-2 align-items-end mb-4">
                <div class="col-md-3"><label for="programName" class="form-label">Programme name *</label><input id="programName" class="form-control" maxlength="200" required placeholder="Secondary" /></div>
                <div class="col-md-2"><label for="programCode" class="form-label">Code *</label><input id="programCode" class="form-control" maxlength="50" required placeholder="SEC" /></div>
                <div class="col-md-2"><label for="programDuration" class="form-label">Months</label><input id="programDuration" type="number" min="0" max="1200" value="0" class="form-control" /></div>
                <div class="col-md-3"><label for="programCampus" class="form-label">Offered at campuses (Ctrl/Cmd + click)</label><select id="programCampus" class="form-select" multiple size="3" aria-describedby="programCampusHelp"></select><small id="programCampusHelp" class="text-muted">Leave empty for all campuses.</small></div>
                <div class="col-md-2"><label for="programDepartment" class="form-label">Department</label><select id="programDepartment" class="form-select"><option value="">No department</option></select><button type="submit" class="btn btn-primary w-100 mt-2">Add Programme</button></div>
            </form>
            <h3 class="h6">Available programmes</h3>
            <div id="programList" class="mb-2"></div>
            <div class="table-responsive mb-3"><table class="table table-hover align-middle">
                <thead><tr><th>Programme</th><th>Campus availability</th><th>Action</th></tr></thead>
                <tbody id="programCampusRows"></tbody>
            </table></div>
            <div class="border rounded p-3 mb-4">
                <h3 class="h6">Programme metadata &amp; department reassignment</h3>
                <p class="small text-muted">Search active or inactive programmes. Programme codes and campus allocation are managed separately. Duration and deactivation changes are blocked when active academic dependencies exist.</p>
                <div class="row g-2 mb-2">
                    <div class="col-md-6"><label for="programmeSearch" class="form-label">Programme name / code prefix</label><input id="programmeSearch" class="form-control" maxlength="80" /></div>
                    <div class="col-md-2 d-flex align-items-end"><button id="programmeSearchButton" type="button" class="btn btn-outline-primary">Search</button></div>
                </div>
                <div class="table-responsive"><table class="table table-hover align-middle">
                    <thead><tr><th>Programme</th><th>Code</th><th>Department</th><th>Months</th><th>Status</th><th>Action</th></tr></thead>
                    <tbody id="programmeRows"></tbody>
                </table></div>
                <div class="d-flex gap-2 align-items-center mb-3">
                    <button id="programmePrev" type="button" class="btn btn-sm btn-outline-secondary">Previous</button>
                    <span id="programmePage" class="small text-muted"></span>
                    <button id="programmeNext" type="button" class="btn btn-sm btn-outline-secondary">Next</button>
                    <button id="programmeCsv" type="button" class="btn btn-sm btn-outline-primary ms-auto">Export visible CSV</button>
                </div>
                <form id="programmeEditForm" class="row g-2 d-none">
                    <input id="programmeEditId" type="hidden" /><input id="programmeEditVersion" type="hidden" />
                    <div class="col-md-2"><label for="programmeEditCode" class="form-label">Code (immutable)</label><input id="programmeEditCode" class="form-control" readonly /></div>
                    <div class="col-md-4"><label for="programmeEditName" class="form-label">Name *</label><input id="programmeEditName" class="form-control" maxlength="200" required /></div>
                    <div class="col-md-3"><label for="programmeEditShortName" class="form-label">Short name</label><input id="programmeEditShortName" class="form-control" maxlength="100" /></div>
                    <div class="col-md-3"><label for="programmeEditDuration" class="form-label">Duration (months)</label><input id="programmeEditDuration" type="number" min="0" max="1200" class="form-control" required /></div>
                    <div class="col-md-4"><label for="programmeDepartmentSearch" class="form-label">Find department by prefix</label><div class="input-group"><input id="programmeDepartmentSearch" class="form-control" maxlength="80" /><button id="programmeDepartmentSearchButton" type="button" class="btn btn-outline-secondary">Find</button></div></div>
                    <div class="col-md-4"><label for="programmeEditDepartment" class="form-label">Department</label><select id="programmeEditDepartment" class="form-select"><option value="">No department</option></select></div>
                    <div class="col-md-4"><label for="programmeEditAward" class="form-label">Award title</label><input id="programmeEditAward" class="form-control" maxlength="150" /></div>
                    <div class="col-md-6"><label for="programmeEditDescription" class="form-label">Description</label><textarea id="programmeEditDescription" class="form-control" rows="2" maxlength="1000"></textarea></div>
                    <div class="col-md-2"><label for="programmeEditOrder" class="form-label">Display order</label><input id="programmeEditOrder" type="number" min="0" class="form-control" required /></div>
                    <div class="col-md-2 d-flex align-items-center"><label class="form-check"><input id="programmeEditAdmissions" type="checkbox" class="form-check-input" /><span class="form-check-label">Admissions open</span></label></div>
                    <div class="col-md-2 d-flex align-items-center"><label class="form-check"><input id="programmeEditActive" type="checkbox" class="form-check-input" /><span class="form-check-label">Active</span></label></div>
                    <div class="col-12 d-flex gap-2"><button id="programmeEditSave" type="submit" class="btn btn-primary">Save metadata</button><button id="programmeEditCancel" type="button" class="btn btn-outline-secondary">Cancel</button></div>
                </form>
            </div>
            <form id="programAllocationForm" class="card border-primary mb-4 d-none">
                <div class="card-body">
                    <h3 class="h6">Manage campuses: <span id="allocationProgramName"></span></h3>
                    <input id="allocationProgramId" type="hidden" />
                    <input id="allocationRowVersion" type="hidden" />
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label for="allocationCampuses" class="form-label">Allowed campuses (Ctrl/Cmd + click)</label>
                            <select id="allocationCampuses" class="form-select" multiple size="5"></select>
                        </div>
                        <div class="col-md-4">
                            <label for="allocationPrimary" class="form-label">Primary campus</label>
                            <select id="allocationPrimary" class="form-select"></select>
                            <div class="form-check mt-3">
                                <input id="allocationAllowAll" type="checkbox" class="form-check-input" />
                                <label for="allocationAllowAll" class="form-check-label">Unrestricted — allow all tenant campuses</label>
                            </div>
                            <small class="text-muted">Removing a campus is blocked when existing academic batches depend on it. A primary campus is required for restricted programmes.</small>
                        </div>
                        <div class="col-md-3 d-flex align-items-end gap-2">
                            <button type="submit" class="btn btn-primary">Save allocation</button>
                            <button id="allocationCancel" type="button" class="btn btn-outline-secondary">Cancel</button>
                        </div>
                    </div>
                </div>
            </form>
            <form id="levelForm" class="row g-2 align-items-end mb-3">
                <div class="col-md-3"><label for="levelProgram" class="form-label">Programme *</label><select id="levelProgram" class="form-select" required></select></div>
                <div class="col-md-3"><label for="levelName" class="form-label">Class / Grade name *</label><input id="levelName" class="form-control" required maxlength="150" placeholder="Grade 9" /></div>
                <div class="col-md-2"><label for="levelCode" class="form-label">Code *</label><input id="levelCode" class="form-control" required maxlength="50" placeholder="G9" /></div>
                <div class="col-md-2"><label for="levelNumber" class="form-label">Level number *</label><input id="levelNumber" class="form-control" required type="number" min="1" max="1000" value="1" /></div>
                <div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Add Class</button></div>
            </form>
            <div class="border rounded p-3">
                <h3 class="h6">Class / Grade administration</h3>
                <p class="small text-muted">Search active and inactive levels. Codes and programme are immutable. Changing progression, number or status is blocked when batches or curriculum mappings exist.</p>
                <form id="levelSearchForm" class="row g-2 mb-3">
                    <div class="col-md-5"><label for="levelSearch" class="form-label">Level name / code prefix</label><input id="levelSearch" maxlength="80" class="form-control" /></div>
                    <div class="col-md-4"><label for="levelProgramFilter" class="form-label">Programme</label><select id="levelProgramFilter" class="form-select"></select></div>
                    <div class="col-md-3 d-flex align-items-end gap-2"><button type="submit" class="btn btn-outline-primary">Search</button><button id="levelCsv" type="button" class="btn btn-outline-secondary">Export visible CSV</button></div>
                </form>
                <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Class / Grade</th><th>Code</th><th>Programme</th><th>Level</th><th>Progression</th><th>Status</th><th>Action</th></tr></thead><tbody id="levelRows"></tbody></table></div>
                <div class="d-flex align-items-center gap-2 mb-3"><button id="levelPrev" type="button" class="btn btn-sm btn-outline-secondary">Previous</button><span id="levelPage" class="small text-muted"></span><button id="levelNext" type="button" class="btn btn-sm btn-outline-secondary">Next</button></div>
                <form id="levelEditForm" class="row g-2 align-items-end border rounded p-3 d-none">
                    <input id="levelEditId" type="hidden" /><input id="levelEditVersion" type="hidden" />
                    <div class="col-md-3"><span id="levelEditContext" class="small text-muted"></span><label for="levelEditName" class="form-label d-block">Name *</label><input id="levelEditName" class="form-control" maxlength="150" required /></div>
                    <div class="col-md-2"><label for="levelEditNumber" class="form-label">Level number</label><input id="levelEditNumber" type="number" min="1" max="1000" class="form-control" required /></div>
                    <div class="col-md-2"><label for="levelEditOrder" class="form-label">Display order</label><input id="levelEditOrder" type="number" min="0" class="form-control" required /></div>
                    <div class="col-md-2"><label class="form-check"><input id="levelEditPromotable" type="checkbox" class="form-check-input" /><span class="form-check-label">Promotable</span></label><label class="form-check"><input id="levelEditTerminal" type="checkbox" class="form-check-input" /><span class="form-check-label">Terminal</span></label></div>
                    <div class="col-md-1"><label class="form-check"><input id="levelEditActive" type="checkbox" class="form-check-input" /><span class="form-check-label">Active</span></label></div>
                    <div class="col-md-2 d-flex gap-2"><button type="submit" class="btn btn-primary">Save</button><button id="levelEditCancel" type="button" class="btn btn-outline-secondary">Cancel</button></div>
                </form>
            </div>
            <div class="border rounded p-3 mt-4" id="trackWorkspace">
                <h3 class="h6">Academic tracks / streams</h3>
                <p class="small text-muted">Programme-specific or institution-wide streams. Track code and programme scope remain immutable. Existing batches and curricula prevent deactivation.</p>
                <form id="trackSearchForm" class="row g-2 mb-3">
                    <div class="col-md-4"><label for="trackSearch" class="form-label">Name / code prefix</label><input id="trackSearch" class="form-control" maxlength="80" /></div>
                    <div class="col-md-4"><label for="trackProgramFilter" class="form-label">Programme</label><select id="trackProgramFilter" class="form-select"></select></div>
                    <div class="col-md-4 d-flex align-items-end gap-2"><button type="submit" class="btn btn-outline-primary">Search</button><button id="trackCsv" type="button" class="btn btn-outline-secondary">Export visible CSV</button></div>
                </form>
                <form id="trackCreateForm" class="row g-2 align-items-end mb-3">
                    <div class="col-md-3"><label for="trackCreateProgram" class="form-label">Programme</label><select id="trackCreateProgram" class="form-select"></select></div>
                    <div class="col-md-3"><label for="trackCreateName" class="form-label">Track name *</label><input id="trackCreateName" class="form-control" maxlength="150" required /></div>
                    <div class="col-md-2"><label for="trackCreateCode" class="form-label">Code *</label><input id="trackCreateCode" class="form-control" maxlength="50" required /></div>
                    <div class="col-md-2"><label for="trackCreateOrder" class="form-label">Order</label><input id="trackCreateOrder" type="number" class="form-control" min="0" value="0" required /></div>
                    <div class="col-md-2"><label class="form-check"><input id="trackCreateDefault" type="checkbox" class="form-check-input" /><span class="form-check-label">Default</span></label><button type="submit" class="btn btn-primary mt-1">Add track</button></div>
                    <div class="col-12"><label for="trackCreateDescription" class="form-label">Description</label><input id="trackCreateDescription" class="form-control" maxlength="500" /></div>
                </form>
                <div class="row g-2 mb-2">
                    <div class="col-md-5"><label for="trackProgrammeLookup" class="form-label">Find programmes by prefix (for large catalogs)</label><input id="trackProgrammeLookup" class="form-control" maxlength="80" /></div>
                    <div class="col-md-2 d-flex align-items-end"><button id="trackProgrammeLookupButton" type="button" class="btn btn-sm btn-outline-secondary">Find programmes</button></div>
                </div>
                <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Track</th><th>Code</th><th>Programme</th><th>Default</th><th>Status</th><th>Action</th></tr></thead><tbody id="trackRows"></tbody></table></div>
                <div class="d-flex align-items-center gap-2 mb-3"><button id="trackPrev" type="button" class="btn btn-sm btn-outline-secondary">Previous</button><span id="trackPage" class="small text-muted"></span><button id="trackNext" type="button" class="btn btn-sm btn-outline-secondary">Next</button></div>
                <form id="trackEditForm" class="row g-2 align-items-end border rounded p-3 d-none">
                    <input id="trackEditId" type="hidden" /><input id="trackEditVersion" type="hidden" />
                    <div class="col-md-3"><span id="trackEditContext" class="small text-muted"></span><label for="trackEditName" class="form-label d-block">Name *</label><input id="trackEditName" class="form-control" maxlength="150" required /></div>
                    <div class="col-md-4"><label for="trackEditDescription" class="form-label">Description</label><input id="trackEditDescription" class="form-control" maxlength="500" /></div>
                    <div class="col-md-2"><label for="trackEditOrder" class="form-label">Display order</label><input id="trackEditOrder" type="number" min="0" class="form-control" required /></div>
                    <div class="col-md-3"><label class="form-check"><input id="trackEditDefault" type="checkbox" class="form-check-input" /><span class="form-check-label">Default</span></label><label class="form-check"><input id="trackEditActive" type="checkbox" class="form-check-input" /><span class="form-check-label">Active</span></label></div>
                    <div class="col-12 d-flex gap-2"><button type="submit" class="btn btn-primary">Save track</button><button id="trackEditCancel" type="button" class="btn btn-outline-secondary">Cancel</button></div>
                </form>
            </div>
        </div>
    </section>
    <section data-section="rooms" class="card border-0 shadow-sm d-none">
        <div class="card-body">
            <h2 class="h5">Academic rooms</h2>
            <p class="text-muted small">Campus-scoped timetable rooms. Codes and campuses are immutable. Capacity decreases and deactivation require timetable reconciliation and are not available here.</p>
            <form id="roomSearchForm" class="row g-2 mb-3">
                <div class="col-md-5"><label for="roomSearch" class="form-label">Room name/code prefix</label><input id="roomSearch" class="form-control" maxlength="80" /></div>
                <div class="col-md-4"><label for="roomCampusFilter" class="form-label">Campus</label><select id="roomCampusFilter" class="form-select"></select></div>
                <div class="col-md-3 d-flex align-items-end gap-2"><button type="submit" class="btn btn-outline-primary">Search</button><button id="roomCsv" type="button" class="btn btn-outline-secondary">Export CSV</button></div>
            </form>
            <form id="roomCreateForm" class="row g-2 align-items-end mb-3">
                <div class="col-md-2"><label for="roomCreateCampus" class="form-label">Campus *</label><select id="roomCreateCampus" class="form-select" required></select></div>
                <div class="col-md-3"><label for="roomCreateName" class="form-label">Name *</label><input id="roomCreateName" class="form-control" maxlength="100" required /></div>
                <div class="col-md-2"><label for="roomCreateCode" class="form-label">Code *</label><input id="roomCreateCode" class="form-control" maxlength="50" required /></div>
                <div class="col-md-2"><label for="roomCreateCapacity" class="form-label">Capacity</label><input id="roomCreateCapacity" type="number" class="form-control" min="0" max="100000" value="40" required /></div>
                <div class="col-md-2"><label for="roomCreateType" class="form-label">Type</label><input id="roomCreateType" class="form-control" maxlength="100" /></div>
                <div class="col-md-1"><button type="submit" class="btn btn-primary">Add</button></div>
            </form>
            <div class="table-responsive"><table class="table table-hover"><thead><tr><th>Name</th><th>Code</th><th>Campus</th><th>Type</th><th>Capacity</th><th>Status</th><th>Action</th></tr></thead><tbody id="roomRows"></tbody></table></div>
            <div class="d-flex gap-2 align-items-center mb-3"><button id="roomPrev" type="button" class="btn btn-sm btn-outline-secondary">Previous</button><span id="roomPage" class="small text-muted"></span><button id="roomNext" type="button" class="btn btn-sm btn-outline-secondary">Next</button></div>
            <form id="roomEditForm" class="row g-2 align-items-end border rounded p-3 d-none">
                <input id="roomEditId" type="hidden" /><input id="roomEditVersion" type="hidden" />
                <div class="col-md-3"><span id="roomEditContext" class="small text-muted"></span></div>
                <div class="col-md-3"><label for="roomEditName" class="form-label">Name *</label><input id="roomEditName" class="form-control" maxlength="100" required /></div>
                <div class="col-md-2"><label for="roomEditCapacity" class="form-label">Capacity</label><input id="roomEditCapacity" type="number" class="form-control" min="0" max="100000" required /></div>
                <div class="col-md-2"><label for="roomEditType" class="form-label">Type</label><input id="roomEditType" class="form-control" maxlength="100" /></div>
                <div class="col-md-2 d-flex gap-2"><button type="submit" class="btn btn-primary">Save</button><button id="roomCancel" type="button" class="btn btn-outline-secondary">Cancel</button></div>
            </form>
        </div>
    </section>
    <section data-section="sections" class="card border-0 shadow-sm d-none">
        <div class="card-body">
            <h2 class="h5">Sections / Cohorts</h2>
            <p class="small text-muted">Section is recorded as an Academic Batch and remains tied to campus, year, programme and class.</p>
            <form id="sectionForm" class="row g-2 align-items-end mb-3">
                <div class="col-md-3"><label for="sectionCampus" class="form-label">Campus *</label><select id="sectionCampus" class="form-select" required></select></div>
                <div class="col-md-3"><label for="sectionYear" class="form-label">Academic year *</label><select id="sectionYear" class="form-select" required></select></div>
                <div class="col-md-3"><label for="sectionProgram" class="form-label">Programme *</label><select id="sectionProgram" class="form-select" required></select></div>
                <div class="col-md-3"><label for="sectionLevel" class="form-label">Class / Grade *</label><select id="sectionLevel" class="form-select" required></select></div>
                <div class="col-md-3"><label for="sectionTerm" class="form-label">Term (optional)</label><select id="sectionTerm" class="form-select"></select></div>
                <div class="col-md-3"><label for="sectionName" class="form-label">Section *</label><input id="sectionName" class="form-control" maxlength="150" required placeholder="Grade 9 — A" /></div>
                <div class="col-md-3"><label for="sectionCode" class="form-label">Code *</label><input id="sectionCode" class="form-control" maxlength="50" required placeholder="G9-A" /></div>
                <div class="col-md-2"><label for="sectionCapacity" class="form-label">Capacity</label><input id="sectionCapacity" class="form-control" type="number" min="0" max="100000" value="40" /></div>
                <div class="col-md-3"><label for="sectionStart" class="form-label">Section start *</label><input id="sectionStart" type="date" class="form-control" required /></div>
                <div class="col-md-3"><label for="sectionEnd" class="form-label">Section end *</label><input id="sectionEnd" type="date" class="form-control" required /></div>
                <div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Add Section</button></div>
            </form>
            <div class="table-responsive"><table class="table table-hover"><thead><tr><th>Section</th><th>Code</th><th>Campus</th><th>Year</th><th>Class</th><th>Capacity</th></tr></thead><tbody id="sectionRows"></tbody></table></div>
            <hr />
            <h3 class="h6">All sections — administration register</h3>
            <p class="small text-muted">Search across active and inactive sections. Campus, year, programme, class, dates and code are immutable here. Capacity can only increase; reductions and closure require a separate enrollment-safe reconciliation.</p>
            <form id="batchSearchForm" class="row g-2 align-items-end mb-3">
                <div class="col-md-4"><label for="batchSearch" class="form-label">Name / code prefix</label><input id="batchSearch" maxlength="80" class="form-control" /></div>
                <div class="col-md-3"><label for="batchCampusFilter" class="form-label">Campus</label><select id="batchCampusFilter" class="form-select"><option value="">All campuses</option></select></div>
                <div class="col-md-3"><label for="batchYearFilter" class="form-label">Academic year</label><select id="batchYearFilter" class="form-select"><option value="">All years</option></select></div>
                <div class="col-md-2"><button type="submit" class="btn btn-outline-primary w-100">Search</button></div>
            </form>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span id="batchPageStatus" class="small text-muted" aria-live="polite"></span>
                <button id="batchExport" type="button" class="btn btn-sm btn-outline-secondary">Export visible CSV</button>
            </div>
            <div class="table-responsive"><table class="table table-striped table-hover"><thead><tr><th>Section</th><th>Campus</th><th>Year</th><th>Programme / Class</th><th>Capacity</th><th>Status</th><th>Action</th></tr></thead><tbody id="batchRegisterRows"></tbody></table></div>
            <div class="d-flex gap-2 mb-3">
                <button id="batchPrevious" type="button" class="btn btn-sm btn-outline-secondary">Previous</button>
                <button id="batchNext" type="button" class="btn btn-sm btn-outline-secondary">Next</button>
            </div>
            <form id="batchEditForm" class="row g-2 align-items-end border rounded p-3 d-none" aria-label="Edit section metadata">
                <input id="batchEditId" type="hidden" /><input id="batchEditVersion" type="hidden" />
                <div class="col-12"><strong id="batchEditContext"></strong></div>
                <div class="col-md-5"><label for="batchEditName" class="form-label">Section name *</label><input id="batchEditName" class="form-control" maxlength="150" required /></div>
                <div class="col-md-2"><label for="batchEditCapacity" class="form-label">Capacity *</label><input id="batchEditCapacity" class="form-control" type="number" min="0" max="100000" required /></div>
                <div class="col-md-2"><label for="batchEditOrder" class="form-label">Display order</label><input id="batchEditOrder" class="form-control" type="number" min="0" required /></div>
                <div class="col-md-3"><button type="submit" class="btn btn-primary w-100">Save section</button></div>
                <div class="col-12"><button id="batchEditCancel" type="button" class="btn btn-link">Cancel</button></div>
            </form>
        </div>
    </section>
    <section data-section="subjects" class="card border-0 shadow-sm d-none">
        <div class="card-body">
            <h2 class="h5">Subjects</h2>
            <form id="subjectForm" class="row g-2 align-items-end mb-3">
                <div class="col-md-4"><label for="subjectName" class="form-label">Subject name *</label><input id="subjectName" required maxlength="200" class="form-control" /></div>
                <div class="col-md-3"><label for="subjectCode" class="form-label">Code *</label><input id="subjectCode" required maxlength="50" class="form-control" /></div>
                <div class="col-md-3"><label for="subjectCredits" class="form-label">Default credits</label><input id="subjectCredits" type="number" min="0" max="1000" step="0.01" value="0" class="form-control" /></div>
                <div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Add Subject</button></div>
            </form>
            <div class="table-responsive"><table class="table table-hover"><thead><tr><th>Subject</th><th>Code</th><th>Credit hours</th></tr></thead><tbody id="subjectRows"></tbody></table></div>
        </div>
    </section>
    <section data-section="curricula" class="card border-0 shadow-sm d-none">
        <div class="card-body">
            <h2 class="h5">Curriculum versions &amp; subject mapping</h2>
            <p class="small text-muted">Create a new curriculum version for historical changes. Existing curriculum assignments are not silently overwritten.</p>
            <form id="curriculumForm" class="row g-2 align-items-end mb-4">
                <div class="col-md-3"><label for="curriculumProgram" class="form-label">Programme *</label><select id="curriculumProgram" class="form-select" required></select></div>
                <div class="col-md-3"><label for="curriculumName" class="form-label">Curriculum name *</label><input id="curriculumName" maxlength="150" class="form-control" required /></div>
                <div class="col-md-2"><label for="curriculumCode" class="form-label">Code *</label><input id="curriculumCode" maxlength="50" class="form-control" required /></div>
                <div class="col-md-2"><label for="curriculumVersion" class="form-label">Version *</label><input id="curriculumVersion" type="number" min="1" value="1" class="form-control" required /></div>
                <div class="col-md-2"><label for="curriculumFrom" class="form-label">Effective from *</label><input id="curriculumFrom" type="date" class="form-control" required /></div>
                <div class="col-md-3 d-flex align-items-end"><label class="form-check"><input id="curriculumCurrent" type="checkbox" class="form-check-input" /><span class="form-check-label">Current curriculum</span></label></div>
                <div class="col-md-3"><button type="submit" class="btn btn-primary w-100">Create Curriculum</button></div>
            </form>
            <div class="mb-3"><a asp-controller="AcademicManagement" asp-action="Prerequisites" class="btn btn-outline-primary">Manage Subject Prerequisites</a></div>
            <h3 class="h6">Add subject to an existing curriculum</h3>
            <form id="curriculumSubjectForm" class="row g-2 align-items-end mb-4">
                <div class="col-md-3"><label for="curriculumSelection" class="form-label">Curriculum *</label><select id="curriculumSelection" class="form-select" required></select></div>
                <div class="col-md-3"><label for="mappingLevel" class="form-label">Class *</label><select id="mappingLevel" class="form-select" required></select></div>
                <div class="col-md-3"><label for="mappingSubject" class="form-label">Subject *</label><select id="mappingSubject" class="form-select" required></select></div>
                <div class="col-md-1"><label for="mappingMarks" class="form-label">Marks</label><input id="mappingMarks" type="number" min="1" max="100000" value="100" class="form-control" /></div>
                <div class="col-md-1"><label for="mappingPassMarks" class="form-label">Pass</label><input id="mappingPassMarks" type="number" min="0" max="100000" value="33" class="form-control" required /></div>
                <div class="col-md-2"><button type="submit" class="btn btn-outline-primary w-100">Add Mapping</button></div>
            </form>
            <div class="table-responsive"><table class="table table-hover"><thead><tr><th>Curriculum</th><th>Programme</th><th>Version</th><th>Effective</th><th>Subjects</th></tr></thead><tbody id="curriculumRows"></tbody></table></div>
        </div>
    </section>
    <section data-section="offerings" class="card border-0 shadow-sm d-none">
        <div class="card-body">
            <h2 class="h5">Batch subject offerings</h2>
            <p class="text-muted small">Publish curriculum subjects to a batch before student enrollment. Campus, curriculum version and academic dates are validated by the server. Only tenant administrators can change offerings. Seat utilization counts pending reservations and approved/completed registrations; rejected/dropped registrations release seats.</p>
            <div class="row g-2 mb-3">
                <div class="col-md-5"><label for="offeringBatch" class="form-label">Academic batch *</label><select id="offeringBatch" class="form-select"></select></div>
                <div class="col-md-4"><label for="offeringSearch" class="form-label">Search offering code / subject</label><input id="offeringSearch" maxlength="80" class="form-control" /></div>
                <div class="col-md-3 d-flex align-items-end"><button id="offeringSearchButton" type="button" class="btn btn-outline-primary">Search</button></div>
            </div>
            <form id="offeringForm" class="row g-2 align-items-end mb-3">
                <input id="offeringReference" type="hidden" /><input id="offeringVersion" type="hidden" />
                <div class="col-md-4"><label for="offeringCurriculumSubject" class="form-label">Curriculum subject *</label><select id="offeringCurriculumSubject" class="form-select" required></select></div>
                <div class="col-md-2"><label for="offeringCode" class="form-label">Offering code *</label><input id="offeringCode" maxlength="50" class="form-control" required /></div>
                <div class="col-md-2"><label for="offeringCapacity" class="form-label">Capacity *</label><input id="offeringCapacity" type="number" min="1" max="100000" class="form-control" required /></div>
                <div class="col-md-2"><label for="offeringDelivery" class="form-label">Delivery</label><select id="offeringDelivery" class="form-select"><option value="1">On campus</option><option value="2">Online live</option><option value="3">Self-paced</option><option value="4">Hybrid</option></select></div>
                <div class="col-md-2 d-flex align-items-end"><label class="form-check"><input id="offeringActive" type="checkbox" class="form-check-input" checked /><span class="form-check-label">Active</span></label></div>
                <div class="col-md-4 d-flex gap-2"><button id="offeringSave" type="submit" class="btn btn-primary">Create Offering</button><button id="offeringCancel" type="button" class="btn btn-outline-secondary">Clear</button></div>
            </form>
            <div id="offeringMessage" role="status" aria-live="polite" class="small text-muted mb-2"></div>
            <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Code</th><th>Subject</th><th>Capacity</th><th>Pending</th><th>Allocated</th><th>Reserved</th><th>Available</th><th>Mode</th><th>Status</th><th>Action</th></tr></thead><tbody id="offeringRows"></tbody></table></div>
            <div class="d-flex align-items-center gap-2"><button id="offeringPrevious" type="button" class="btn btn-sm btn-outline-secondary">Previous</button><span id="offeringPage" class="small text-muted"></span><button id="offeringNext" type="button" class="btn btn-sm btn-outline-secondary">Next</button><button id="offeringCsv" type="button" class="btn btn-sm btn-outline-primary ms-auto">Export visible CSV</button></div>
        </div>
    </section>
    <p class="small text-muted mt-3">Lists are bounded for responsiveness. Use an exact prefix search in the API catalog for larger institutions.</p>
</div>
@section Scripts {
    <script src="~/js/academic/management.js" asp-append-version="true"></script>
    <script src="~/js/academic/management-forms.js" asp-append-version="true"></script>
    <script src="~/js/academic/subject-offerings.js" asp-append-version="true"></script>
    <script src="~/js/academic/departments.js" asp-append-version="true"></script>
    <script src="~/js/academic/programmes.js" asp-append-version="true"></script>
    <script src="~/js/academic/batches.js" asp-append-version="true"></script>
    <script src="~/js/academic/rooms.js" asp-append-version="true"></script>
    <script src="~/js/academic/levels.js" asp-append-version="true"></script>
    <script src="~/js/academic/tracks.js" asp-append-version="true"></script>
}
