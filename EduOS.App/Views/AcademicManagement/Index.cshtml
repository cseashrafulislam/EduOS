                <div class="col-12"><strong>Editing subject: <span id="subjectEditCode"></span></strong></div>
                <div class="col-md-4"><label for="subjectEditName" class="form-label">@(bn ? "নাম *" : "Name *")</label><input id="subjectEditName" maxlength="200" required class="form-control" /></div>
                <div class="col-md-3"><label for="subjectEditShortName" class="form-label">@(bn ? "সংক্ষিপ্ত নাম" : "Short name")</label><input id="subjectEditShortName" maxlength="50" class="form-control" /></div>
                <div class="col-md-2"><label for="subjectEditCredits" class="form-label">@(bn ? "ডিফল্ট ক্রেডিট" : "Default credits")</label><input id="subjectEditCredits" type="number" min="0" max="1000" step="0.01" required class="form-control" /></div>
                <div class="col-md-2"><label class="form-check"><input id="subjectEditActive" type="checkbox" class="form-check-input" /><span class="form-check-label">@(bn ? "সক্রিয়" : "Active")</span></label></div>
                <div class="col-md-3"><button type="submit" class="btn btn-primary w-100">@(bn ? "বিষয় সংরক্ষণ" : "Save subject")</button></div>
                <div class="col-md-2"><button id="subjectEditCancel" type="button" class="btn btn-outline-secondary w-100">@(bn ? "বাতিল" : "Cancel")</button></div>
            </form>
        </div>
    </section>
    <section data-section="curricula" class="card border-0 shadow-sm @(section == "curricula" ? "" : "d-none")">
        <div class="card-body">
            <form id="curriculumForm" class="row g-2 align-items-end mb-4">
                <p class="col-12 small text-muted mb-0">@(bn ? "অভ্যন্তরীণ কোড সিস্টেম নিজে তৈরি করবে।" : "Internal Code is generated automatically.")</p>
                <div class="col-md-3"><label for="curriculumProgram" class="form-label">@(bn ? "প্রোগ্রাম *" : "Programme *")</label><select id="curriculumProgram" class="form-select" required></select></div>
                <div class="col-md-3"><label for="curriculumName" class="form-label">@(bn ? "পাঠ্যক্রমের নাম *" : "Curriculum name *")</label><input id="curriculumName" maxlength="150" class="form-control" required /></div>
                <input id="curriculumCode" type="hidden" />
                <div class="col-md-2"><label for="curriculumVersion" class="form-label">@(bn ? "সংস্করণ *" : "Version *")</label><input id="curriculumVersion" type="number" min="1" value="1" class="form-control" required /></div>
                <div class="col-md-2"><label for="curriculumFrom" class="form-label">@(bn ? "কার্যকর হবে *" : "Effective from *")</label><input id="curriculumFrom" type="date" class="form-control" required /></div>
                <div class="col-12 academic-curriculum-actions">
                    <label class="form-check academic-check-control" for="curriculumCurrent"><input id="curriculumCurrent" type="checkbox" class="form-check-input" /><span class="form-check-label">@(bn ? "বর্তমান পাঠ্যক্রম" : "Current curriculum")</span></label>
                    <button type="submit" class="btn btn-primary academic-curriculum-create">@(bn ? "পাঠ্যক্রম তৈরি" : "Create Curriculum")</button>
                </div>
            </form>
            <div class="academic-curriculum-related"><a asp-controller="AcademicManagement" asp-action="Prerequisites" class="btn btn-outline-primary">@(bn ? "বিষয়ের পূর্বশর্ত পরিচালনা" : "Manage Subject Prerequisites")</a></div>
            <h3 class="visually-hidden">@(bn ? "বিদ্যমান পাঠ্যক্রমে বিষয় যোগ" : "Add subject to an existing curriculum")</h3>
            <form id="curriculumSubjectForm" class="row g-2 align-items-end mb-4">
                <div class="col-md-3"><label for="curriculumSelection" class="form-label">@(bn ? "পাঠ্যক্রম *" : "Curriculum *")</label><select id="curriculumSelection" class="form-select" required></select></div>
                <div class="col-md-3"><label for="mappingLevel" class="form-label">@(bn ? "শ্রেণি *" : "Class *")</label><select id="mappingLevel" class="form-select" required></select></div>
                <div class="col-md-3"><label for="mappingSubject" class="form-label">@(bn ? "বিষয় *" : "Subject *")</label><select id="mappingSubject" class="form-select" required></select></div>
                <div class="col-md-1"><label for="mappingMarks" class="form-label">@(bn ? "নম্বর" : "Marks")</label><input id="mappingMarks" type="number" min="1" max="100000" value="100" class="form-control" /></div>
                <div class="col-md-1"><label for="mappingPassMarks" class="form-label">@(bn ? "পাস নম্বর" : "Pass")</label><input id="mappingPassMarks" type="number" min="0" max="100000" value="33" class="form-control" required /></div>
                <div class="col-md-2"><button id="curriculumMappingSubmit" type="submit" class="btn btn-outline-primary w-100" disabled>@(bn ? "ম্যাপিং যোগ" : "Add Mapping")</button></div>
            </form>
            <p id="curriculumMappingNotice" class="small text-muted" aria-live="polite"></p>
            <form id="curriculumSearchForm" class="row g-2 align-items-end mb-3">
                <div class="col-md-3"><label for="curriculumSearch" class="form-label">@(bn ? "নাম / কোডের শুরু" : "Name / code prefix")</label><input id="curriculumSearch" maxlength="80" class="form-control" /></div>
                <div class="col-md-3"><label for="curriculumProgramFilter" class="form-label">@(bn ? "প্রোগ্রাম" : "Programme")</label><select id="curriculumProgramFilter" class="form-select"></select></div>
                <div class="col-md-2"><label for="curriculumEffectiveOn" class="form-label">@(bn ? "কার্যকরের তারিখ" : "Effective on")</label><input id="curriculumEffectiveOn" type="date" class="form-control" /></div>
                <div class="col-md-4 d-flex gap-2"><button type="submit" class="btn btn-outline-primary">@(bn ? "সংস্করণ খুঁজুন" : "Search versions")</button><button id="curriculumCsv" type="button" class="btn btn-outline-secondary">@(bn ? "দেখানো তথ্য CSV" : "Export visible CSV")</button></div>
            </form>
            <div class="table-responsive"><table class="table table-hover"><thead><tr><th scope="col">@(bn ? "পাঠ্যক্রম" : "Curriculum")</th><th scope="col">@(bn ? "প্রোগ্রাম" : "Programme")</th><th scope="col">@(bn ? "সংস্করণ" : "Version")</th><th scope="col">@(bn ? "কার্যকরের সময়" : "Effective dates")</th><th scope="col">@(bn ? "বিষয়সমূহ" : "Subjects")</th><th scope="col">@(bn ? "বিষয় অফারিং" : "Offerings")</th><th scope="col">@(bn ? "ভর্তি তালিকা" : "Enrollments")</th><th scope="col">@(bn ? "অবস্থা" : "Status")</th><th scope="col">@(bn ? "কাজ" : "Action")</th></tr></thead><tbody id="curriculumRows"></tbody></table></div>
            <div class="d-flex align-items-center gap-2 mb-3"><button id="curriculumPrevious" type="button" class="btn btn-sm btn-outline-secondary">@(bn ? "আগের" : "Previous")</button><span id="curriculumPage" class="small text-muted" aria-live="polite"></span><button id="curriculumNext" type="button" class="btn btn-sm btn-outline-secondary">@(bn ? "পরের" : "Next")</button></div>
            <div id="curriculumDetails" class="border rounded p-3 d-none" aria-live="polite"></div>
        </div>
    </section>
    <section data-section="offerings" class="card border-0 shadow-sm @(section == "offerings" ? "" : "d-none")">
        <div class="card-body">
            <div class="row g-2 mb-3">
                <div class="col-md-5"><label for="offeringBatch" class="form-label">@(bn ? "একাডেমিক ব্যাচ *" : "Academic batch *")</label><select id="offeringBatch" class="form-select"></select></div>
                <div class="col-md-4"><label for="offeringSearch" class="form-label">@(bn ? "অফারিং কোড / বিষয় খুঁজুন" : "Search offering code / subject")</label><input id="offeringSearch" maxlength="80" class="form-control" /></div>
                <div class="col-md-3 d-flex align-items-end"><button id="offeringSearchButton" type="button" class="btn btn-outline-primary">@(bn ? "খুঁজুন" : "Search")</button></div>
            </div>
            <form id="offeringForm" class="row g-2 align-items-end mb-3">
                <p class="col-12 small text-muted mb-0">@(bn ? "কোড সিস্টেম নিজে তৈরি করবে।" : "Code is generated automatically.")</p>
                <input id="offeringReference" type="hidden" /><input id="offeringVersion" type="hidden" />
                <div class="col-md-4"><label for="offeringSection" class="form-label">@(bn ? "একাডেমিক শাখা *" : "Academic section *")</label><select id="offeringSection" class="form-select" required></select></div>
                <div class="col-md-4"><label for="offeringCurriculumSubject" class="form-label">@(bn ? "পাঠ্যক্রমের বিষয় *" : "Curriculum subject *")</label><select id="offeringCurriculumSubject" class="form-select" required></select></div>
                <input id="offeringCode" type="hidden" />
                <div class="col-md-2"><label for="offeringCapacity" class="form-label">@(bn ? "আসনসংখ্যা *" : "Capacity *")</label><input id="offeringCapacity" type="number" min="1" max="100000" class="form-control" required /></div>
                <div class="col-md-2"><label for="offeringDelivery" class="form-label">@(bn ? "শিক্ষাদানের ধরন" : "Delivery")</label><select id="offeringDelivery" class="form-select"><option value="1">@(bn ? "ক্যাম্পাসে" : "On campus")</option><option value="2">@(bn ? "অনলাইন লাইভ" : "Online live")</option><option value="3">@(bn ? "স্বগতিতে" : "Self-paced")</option><option value="4">@(bn ? "মিশ্র" : "Hybrid")</option></select></div>
                <div class="col-md-2 academic-check-cell"><label class="form-check academic-check-control"><input id="offeringActive" type="checkbox" class="form-check-input" checked /><span class="form-check-label">@(bn ? "সক্রিয়" : "Active")</span></label></div>
                <div class="col-md-4 d-flex gap-2"><button id="offeringSave" type="submit" class="btn btn-primary">@(bn ? "অফারিং তৈরি" : "Create Offering")</button><button id="offeringCancel" type="button" class="btn btn-outline-secondary">@(bn ? "পরিষ্কার" : "Clear")</button></div>
            </form>
            <div id="offeringMessage" role="status" aria-live="polite" class="small text-muted mb-2"></div>
            <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th scope="col">@(bn ? "কোড" : "Code")</th><th scope="col">@(bn ? "শাখা" : "Section")</th><th scope="col">@(bn ? "বিষয়" : "Subject")</th><th scope="col">@(bn ? "আসনসংখ্যা" : "Capacity")</th><th scope="col">@(bn ? "অপেক্ষমাণ" : "Pending")</th><th scope="col">@(bn ? "বরাদ্দ" : "Allocated")</th><th scope="col">@(bn ? "সংরক্ষিত" : "Reserved")</th><th scope="col">@(bn ? "উপলব্ধ" : "Available")</th><th scope="col">@(bn ? "ধরন" : "Mode")</th><th scope="col">@(bn ? "অবস্থা" : "Status")</th><th scope="col">@(bn ? "কাজ" : "Action")</th></tr></thead><tbody id="offeringRows"></tbody></table></div>
            <div class="d-flex align-items-center gap-2"><button id="offeringPrevious" type="button" class="btn btn-sm btn-outline-secondary">@(bn ? "আগের" : "Previous")</button><span id="offeringPage" class="small text-muted"></span><button id="offeringNext" type="button" class="btn btn-sm btn-outline-secondary">@(bn ? "পরের" : "Next")</button><button id="offeringCsv" type="button" class="btn btn-sm btn-outline-primary ms-auto">@(bn ? "দেখানো তথ্য CSV" : "Export visible CSV")</button></div>
        </div>
    </section>
</div>
@section Scripts {
    <script src="~/js/platform/form-guard.js" asp-append-version="true"></script>
    <script src="~/js/academic/management.js" asp-append-version="true"></script>
    <script src="~/js/academic/management-forms.js" asp-append-version="true"></script>
    @if (section is "departments" or "classes")
    {
        <script src="~/js/academic/departments.js" asp-append-version="true"></script>
    }
    @if (section == "classes")
    {
        <script src="~/js/academic/programmes.js" asp-append-version="true"></script>
        <script src="~/js/academic/levels.js" asp-append-version="true"></script>
        <script src="~/js/academic/tracks.js" asp-append-version="true"></script>
    }
    @if (section == "sections")
    {
        <script src="~/js/academic/batches.js" asp-append-version="true"></script>
    }
    @if (section == "rooms")
    {
        <script src="~/js/academic/rooms.js" asp-append-version="true"></script>
    }
    @if (section == "subjects")
    {
        <script src="~/js/academic/subjects.js" asp-append-version="true"></script>
    }
    @if (section == "curricula")
    {
        <script src="~/js/academic/curricula.js" asp-append-version="true"></script>
    }
    @if (section == "offerings")
    {
        <script src="~/js/academic/subject-offerings.js" asp-append-version="true"></script>
    }
}
