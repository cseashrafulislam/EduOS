@using System.Globalization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var bn = CultureInfo.CurrentUICulture.Name == "bn-BD";
    ViewData["Title"] = bn ? "একাডেমিক শাখা" : "Academic Sections";
}
<div id="academicSectionsPage" class="container-fluid py-2">
    @Html.AntiForgeryToken()
    <div id="sectionNotice" class="alert d-none" role="status" aria-live="polite"></div>
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <a href="/AcademicManagement/Batches" class="btn btn-sm btn-outline-secondary academic-related-link">@(bn ? "একাডেমিক ব্যাচ" : "Academic Batches")</a>
            <form id="sectionCreateForm" class="row g-3 align-items-end">
                <input type="hidden" id="sectionId" />
                <input type="hidden" id="sectionVersion" />
                <div class="col-md-4">
                    <label class="form-label" for="sectionCampus">@(bn ? "ক্যাম্পাস" : "Campus") *</label>
                    <select id="sectionCampus" class="form-select" required><option value="">@(bn ? "ক্যাম্পাস নির্বাচন" : "Select campus")</option></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="sectionLevel">@(bn ? "শ্রেণি / গ্রেড" : "Class / Grade") *</label>
                    <select id="sectionLevel" class="form-select" required><option value="">@(bn ? "শ্রেণি নির্বাচন" : "Select class")</option></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="sectionName">@(bn ? "শাখার নাম" : "Section Name") *</label>
                    <input id="sectionName" class="form-control" maxlength="150" required placeholder="@(bn ? "শাখা A" : "Section A")" />
                </div>
                @* The authorized API generates Section Code; editing uses the existing immutable value. *@
                <input id="sectionCode" type="hidden" />
                <div class="col-12 small text-muted">@(bn ? "শাখার কোড সিস্টেম নিজে তৈরি করবে; তালিকায় কোড দেখা যাবে।" : "Section Code is generated automatically and shown in the directory.")</div>
                <div class="col-md-3">
                    <label class="form-label" for="sectionCapacity">@(bn ? "আসনসংখ্যা" : "Capacity") *</label>
                    <input id="sectionCapacity" class="form-control" type="number" min="0" max="100000" value="40" required />
                </div>
                <div class="col-md-6 d-flex gap-2 align-items-end">
                    <button id="sectionSave" class="btn btn-primary" type="submit">@(bn ? "শাখা যোগ করুন" : "Add Section")</button>
                    <button id="sectionCancel" class="btn btn-outline-secondary" type="button">@(bn ? "ফর্ম পরিষ্কার" : "Clear")</button>
                </div>
                <div class="col-12">
                    <details id="sectionAdvanced" class="border rounded p-3">
                        <summary>@(bn ? "অতিরিক্ত সেটিংস (ঐচ্ছিক)" : "Additional settings (optional)")</summary>
                        <div class="row g-3 mt-1">
                            <div class="col-md-3">
                                <label class="form-label" for="sectionOrder">@(bn ? "ক্রম" : "Display order")</label>
                                <input id="sectionOrder" type="number" min="0" class="form-control" value="0" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="sectionActive">@(bn ? "অবস্থা" : "Status")</label>
                                <select id="sectionActive" class="form-select"><option value="true">@(bn ? "সক্রিয়" : "Active")</option><option value="false">@(bn ? "নিষ্ক্রিয়" : "Inactive")</option></select>
                            </div>
                        </div>
                    </details>
                </div>
            </form>
            <div class="academic-directory">
                <div class="d-flex flex-wrap gap-2 align-items-center academic-directory-search">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                    <input id="sectionFilter" class="form-control" maxlength="80" aria-label="Search sections" placeholder="Name / Code" />
                    <button id="sectionFilterButton" type="button" class="btn btn-outline-primary">@(bn ? "খুঁজুন" : "Search")</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr>
                        <th scope="col">@(bn ? "শাখা" : "Section")</th><th scope="col">@(bn ? "ক্যাম্পাস" : "Campus")</th>
                        <th scope="col">@(bn ? "শ্রেণি" : "Class")</th><th scope="col">@(bn ? "কোড" : "Code")</th>
                        <th scope="col">@(bn ? "আসন" : "Seats")</th><th scope="col">@(bn ? "অবস্থা" : "Status")</th>
                        <th scope="col">@(bn ? "কার্যক্রম" : "Actions")</th>
                    </tr></thead>
                    <tbody id="sectionRows"><tr><td colspan="7" class="text-muted">@(bn ? "লোড হচ্ছে…" : "Loading...")</td></tr></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <button id="sectionPrevious" type="button" class="btn btn-outline-secondary btn-sm">@(bn ? "আগের" : "Previous")</button>
                <span id="sectionPageStatus" class="small text-muted" aria-live="polite"></span>
                <button id="sectionNext" type="button" class="btn btn-outline-secondary btn-sm">@(bn ? "পরের" : "Next")</button>
            </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/platform/form-guard.js" asp-append-version="true"></script>
    <script src="~/js/academic/section-register.js" asp-append-version="true"></script>
}
