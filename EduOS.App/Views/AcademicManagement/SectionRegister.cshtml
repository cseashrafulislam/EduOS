@using System.Globalization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var bn = CultureInfo.CurrentUICulture.Name == "bn-BD";
    ViewData["Title"] = bn ? "একাডেমিক শাখা" : "Academic Sections";
}
<div id="academicSectionsPage" class="container-fluid py-4">
    @Html.AntiForgeryToken()
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <p class="small text-muted mb-1">@(bn ? "একাডেমিক ব্যবস্থাপনা / সেটিংস" : "Academic Management / Settings")</p>
            <h1 class="h4 fw-bold mb-1">@(bn ? "একাডেমিক শাখা" : "Academic Sections")</h1>
            <p class="text-muted mb-0">@(bn ? "ক্যাম্পাস ও শ্রেণির অধীনে A, B, C শাখা তৈরি করুন। কোনো ব্যাচ প্রয়োজন নেই।"
                : "Create A, B or C teaching groups for a class and campus. No academic batch is required.")</p>
        </div>
        <a href="/AcademicManagement/Batches" class="btn btn-outline-secondary">@(bn ? "একাডেমিক ব্যাচ" : "Academic Batches")</a>
    </div>
    <div id="sectionNotice" class="alert d-none" role="status" aria-live="polite"></div>
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <form id="sectionCreateForm" class="row g-3 align-items-end">
                <input type="hidden" id="sectionId" />
                <input type="hidden" id="sectionVersion" />
                <div class="col-md-4">
                    <label class="form-label" for="sectionCampus">@(bn ? "ক্যাম্পাস" : "Campus") *</label>
                    <select id="sectionCampus" class="form-select" required><option value="">@(bn ? "ক্যাম্পাস নির্বাচন" : "Select campus")</option></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="sectionLevel">@(bn ? "শ্রেণি / গ্রেড" : "Class / Grade") *</label>
                    <select id="sectionLevel" class="form-select" required><option value="">@(bn ? "শ্রেণি নির্বাচন" : "Select class")</option></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="sectionName">@(bn ? "শাখার নাম" : "Section Name") *</label>
                    <input id="sectionName" class="form-control" maxlength="150" required placeholder="Section A" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="sectionCode">@(bn ? "কোড" : "Code") *</label>
                    <input id="sectionCode" class="form-control" maxlength="50" required placeholder="A" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="sectionCapacity">@(bn ? "আসনসংখ্যা" : "Capacity") *</label>
                    <input id="sectionCapacity" class="form-control" type="number" min="0" max="100000" value="40" required />
                </div>
                <div class="col-md-6 d-flex gap-2 align-items-end">
                    <button id="sectionSave" class="btn btn-primary" type="submit">@(bn ? "শাখা যোগ করুন" : "Add Section")</button>
                    <button id="sectionCancel" class="btn btn-outline-secondary" type="button">@(bn ? "ফর্ম পরিষ্কার" : "Clear")</button>
                </div>
                <div class="col-12">
                    <details id="sectionAdvanced" class="border rounded p-3">
                        <summary>@(bn ? "অতিরিক্ত সেটিংস (ঐচ্ছিক)" : "Additional settings (optional)")</summary>
                        <div class="row g-3 mt-1">
                            <div class="col-md-3">
                                <label class="form-label" for="sectionOrder">@(bn ? "ক্রম" : "Display order")</label>
                                <input id="sectionOrder" type="number" min="0" class="form-control" value="0" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="sectionActive">@(bn ? "অবস্থা" : "Status")</label>
                                <select id="sectionActive" class="form-select"><option value="true">Active</option><option value="false">Inactive</option></select>
                            </div>
                        </div>
                    </details>
                </div>
            </form>
        </div>
    </div>
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2 justify-content-between align-items-end mb-3">
                <div>
                    <h2 class="h6 mb-1">@(bn ? "শাখার তালিকা" : "Section Register")</h2>
                    <p class="small text-muted mb-0">@(bn ? "একই শ্রেণিতে A, B, C আলাদা শাখা হবে।" : "Sections belong to classes, not batches.")</p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <input id="sectionFilter" class="form-control" maxlength="80" aria-label="Search sections" placeholder="Name / Code" />
                    <button id="sectionFilterButton" type="button" class="btn btn-outline-primary">@(bn ? "খুঁজুন" : "Search")</button>
                    <button id="sectionRefresh" type="button" class="btn btn-outline-secondary">@(bn ? "রিফ্রেশ" : "Refresh")</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr>
                        <th>@(bn ? "শাখা" : "Section")</th><th>@(bn ? "ক্যাম্পাস" : "Campus")</th>
                        <th>@(bn ? "শ্রেণি" : "Class")</th><th>@(bn ? "কোড" : "Code")</th>
                        <th>@(bn ? "আসন" : "Seats")</th><th>@(bn ? "অবস্থা" : "Status")</th>
                        <th>@(bn ? "কার্যক্রম" : "Actions")</th>
                    </tr></thead>
                    <tbody id="sectionRows"><tr><td colspan="7" class="text-muted">Loading...</td></tr></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <button id="sectionPrevious" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
                <span id="sectionPageStatus" class="small text-muted" aria-live="polite"></span>
                <button id="sectionNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/platform/form-guard.js" asp-append-version="true"></script>
    <script src="~/js/academic/section-register.js" asp-append-version="true"></script>
}
