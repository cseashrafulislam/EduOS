@{ ViewData["Title"] = "My Legal Agreements"; }
<section class="container-fluid py-4" data-legal-mode="user">
    <h2>My legal agreements</h2>
    <p class="text-muted">Review current legal documents and your recorded acceptances.</p>
    <div id="legalAlert" class="alert d-none" role="alert" aria-live="polite"></div>
    <div id="legalCurrentRows" class="d-grid gap-3 mb-4"></div>
    <div class="card"><div class="card-body"><h3 class="h5">Acceptance history</h3><div id="legalHistoryRows" class="d-grid gap-2"></div></div></div>
</section>
@section Scripts { <script src="~/js/platform/legal-documents.js" asp-append-version="true"></script> }
