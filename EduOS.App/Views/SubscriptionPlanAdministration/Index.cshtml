@{
    ViewData["Title"] = "Subscription Plan Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section id="subscriptionPlanAdministration" class="container-fluid py-3">
    @Html.AntiForgeryToken()
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div><h1 class="h4">Subscription Plan Management</h1>
            <p class="text-muted">Manage public availability, pricing, resource limits and plan features. Existing subscription price snapshots are unchanged.</p></div>
        <button id="planRefresh" class="btn btn-outline-secondary" type="button">Refresh</button>
    </div>
    <p id="planMessage" role="status" aria-live="polite"></p>
    <div class="table-responsive"><table class="table table-striped table-sm">
        <thead><tr><th>Plan</th><th>Code</th><th>Monthly</th><th>Yearly</th><th>Subscription status</th><th>Public pricing</th><th>Actions</th></tr></thead>
        <tbody id="planRows"><tr><td colspan="7">Loading…</td></tr></tbody>
    </table></div>
    <section id="planConfiguration" class="card mt-3" hidden aria-label="Edit plan configuration">
        <div class="card-body">
            <h2 id="planConfigurationTitle" class="h5">Edit plan</h2>
            <form id="planConfigurationForm">
                <div class="row g-2">
                    <div class="col-md-3"><label for="planMonthly" class="form-label">Monthly price</label><input id="planMonthly" class="form-control" type="number" min="0" max="9999999999999999" step="0.01" required /></div>
                    <div class="col-md-3"><label for="planYearly" class="form-label">Yearly price</label><input id="planYearly" class="form-control" type="number" min="0" max="9999999999999999" step="0.01" required /></div>
                    <div class="col-md-2"><label for="planTrial" class="form-label">Trial days</label><input id="planTrial" class="form-control" type="number" min="0" max="365" step="1" required /></div>
                    <div class="col-md-2"><label for="planStudents" class="form-label">Max students</label><input id="planStudents" class="form-control" type="number" min="0" step="1" required /></div>
                    <div class="col-md-2"><label for="planEmployees" class="form-label">Max employees</label><input id="planEmployees" class="form-control" type="number" min="0" step="1" required /></div>
                    <div class="col-md-2"><label for="planUsers" class="form-label">Max users</label><input id="planUsers" class="form-control" type="number" min="0" step="1" required /></div>
                    <div class="col-md-2"><label for="planCampuses" class="form-label">Max campuses</label><input id="planCampuses" class="form-control" type="number" min="0" step="1" required /></div>
                    <div class="col-md-2"><label for="planStorage" class="form-label">Max storage (MB)</label><input id="planStorage" class="form-control" type="number" min="0" step="1" required /></div>
                </div>
                <h3 class="h6 mt-3">Plan features</h3>
                <p class="text-muted small">Enable features and optionally set non-negative limits. Leave a limit blank for unlimited.</p>
                <div id="planFeatureRows" class="row g-2"></div>
                <div class="mt-3 d-flex gap-2"><button id="planSave" type="submit" class="btn btn-primary">Save configuration</button>
                <button id="planCancel" type="button" class="btn btn-outline-secondary">Cancel</button></div>
            </form>
        </div>
    </section>
</section>
@section Scripts {
    <script src="~/js/platform/subscription-plan-administration.js" asp-append-version="true"></script>
}
