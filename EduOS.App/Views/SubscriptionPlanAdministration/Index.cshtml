@{
    var bn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
    ViewData["Title"] = bn ? "সাবস্ক্রিপশন প্ল্যান" : "Subscription Plans";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section id="subscriptionPlanAdministration" class="container-fluid px-0" data-bangla="@(bn ? "true" : "false")">
    @Html.AntiForgeryToken()
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <p class="small text-muted mb-0">@(bn ? "প্ল্যানের মূল্য, সীমা, ফিচার ও নতুন নিবন্ধনের উপলব্ধতা পরিচালনা করুন। বিদ্যমান সাবস্ক্রিপশনের মূল্য-স্ন্যাপশট বদলাবে না।" : "Manage plan pricing, limits, features and new-signup availability. Existing subscription price snapshots remain unchanged.")</p>
        <button id="planRetry" class="btn btn-outline-secondary btn-sm" type="button" hidden>@(bn ? "আবার চেষ্টা করুন" : "Try again")</button>
    </div>
    <p id="planMessage" class="small mb-2" role="status" aria-live="polite"></p>
    <div class="table-responsive border rounded-3">
        <table class="table table-hover table-sm align-middle mb-0">
            <caption class="visually-hidden">@(bn ? "সাবস্ক্রিপশন প্ল্যান ও মূল্য" : "Subscription plan pricing and availability")</caption>
            <thead class="table-light"><tr>
                <th scope="col">@(bn ? "প্ল্যান" : "Plan")</th>
                <th scope="col">@(bn ? "কোড" : "Code")</th>
                <th scope="col">@(bn ? "মাসিক" : "Monthly")</th>
                <th scope="col">@(bn ? "বার্ষিক" : "Yearly")</th>
                <th scope="col">@(bn ? "সাবস্ক্রিপশন" : "Subscription status")</th>
                <th scope="col">@(bn ? "পাবলিক মূল্য" : "Public pricing")</th>
                <th scope="col">@(bn ? "কাজ" : "Actions")</th>
            </tr></thead>
            <tbody id="planRows"><tr><td colspan="7">@(bn ? "প্ল্যান আনা হচ্ছে…" : "Loading plans…")</td></tr></tbody>
        </table>
    </div>
    <section id="planConfiguration" class="card border rounded-3 mt-3" hidden aria-labelledby="planConfigurationTitle">
        <div class="card-body p-3">
            <h2 id="planConfigurationTitle" class="h6 mb-3">@(bn ? "প্ল্যান সম্পাদনা" : "Edit plan")</h2>
            <form id="planConfigurationForm">
                <div class="row g-2">
                    <div class="col-6 col-md-3">
                        <label for="planMonthly" class="form-label">@(bn ? "মাসিক মূল্য" : "Monthly price")</label>
                        <input id="planMonthly" class="form-control" type="number" inputmode="decimal" min="0" max="9999999999999999" step="0.01" required />
                    </div>
                    <div class="col-6 col-md-3">
                        <label for="planYearly" class="form-label">@(bn ? "বার্ষিক মূল্য" : "Yearly price")</label>
                        <input id="planYearly" class="form-control" type="number" inputmode="decimal" min="0" max="9999999999999999" step="0.01" required />
                    </div>
                    <div class="col-6 col-md-2">
                        <label for="planTrial" class="form-label">@(bn ? "ট্রায়াল (দিন)" : "Trial days")</label>
                        <input id="planTrial" class="form-control" type="number" min="0" max="365" step="1" required />
                    </div>
                    <div class="col-6 col-md-2">
                        <label for="planStudents" class="form-label">@(bn ? "সর্বোচ্চ শিক্ষার্থী" : "Max students")</label>
                        <input id="planStudents" class="form-control" type="number" min="0" step="1" required />
                    </div>
                    <div class="col-6 col-md-2">
                        <label for="planEmployees" class="form-label">@(bn ? "সর্বোচ্চ কর্মী" : "Max employees")</label>
                        <input id="planEmployees" class="form-control" type="number" min="0" step="1" required />
                    </div>
                    <div class="col-6 col-md-2">
                        <label for="planUsers" class="form-label">@(bn ? "সর্বোচ্চ ব্যবহারকারী" : "Max users")</label>
                        <input id="planUsers" class="form-control" type="number" min="0" step="1" required />
                    </div>
                    <div class="col-6 col-md-2">
                        <label for="planCampuses" class="form-label">@(bn ? "সর্বোচ্চ ক্যাম্পাস" : "Max campuses")</label>
                        <input id="planCampuses" class="form-control" type="number" min="0" step="1" required />
                    </div>
                    <div class="col-6 col-md-2">
                        <label for="planStorage" class="form-label">@(bn ? "স্টোরেজ (MB)" : "Storage (MB)")</label>
                        <input id="planStorage" class="form-control" type="number" min="0" step="1" required />
                    </div>
                </div>
                <div class="mt-3 mb-2">
                    <h3 class="h6 mb-1">@(bn ? "প্ল্যানের ফিচার" : "Plan features")</h3>
                    <p class="small text-muted mb-0">@(bn ? "ফিচার চালু করুন; প্রয়োজন হলে অঋণাত্মক সীমা দিন। ফাঁকা রাখলে সীমাহীন।" : "Enable features; optional non-negative limits. Leave blank for unlimited.")</p>
                </div>
                <div id="planFeatureRows" class="row g-2"></div>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button id="planSave" type="submit" class="btn btn-primary">@(bn ? "প্ল্যান সংরক্ষণ" : "Save configuration")</button>
                    <button id="planCancel" type="button" class="btn btn-outline-secondary">@(bn ? "বাতিল" : "Cancel")</button>
                </div>
            </form>
        </div>
    </section>
</section>
@section Scripts {
    <script src="~/js/platform/subscription-plan-administration.js" asp-append-version="true"></script>
}
