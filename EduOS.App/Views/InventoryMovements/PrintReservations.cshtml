@model EduOS.Core.Common.PagedResult<EduOS.Core.DTOs.Inventory.InventoryReservationRegisterRowDto>
@using System.Globalization
@{
    Layout = null;
    var bn = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
}
<!doctype html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>@(bn ? "স্টক রিজার্ভেশন প্রতিবেদন" : "Stock reservation reconciliation")</title>
    <style>
        body { font-family: system-ui, sans-serif; margin: 1rem; color: #17212d; }
        h1 { font-size: 1.2rem; margin-bottom: .4rem; }
        .meta { font-size: .8rem; margin-bottom: .7rem; }
        table { width: 100%; border-collapse: collapse; font-size: .76rem; }
        th, td { border: 1px solid #bfc8d1; padding: .35rem; text-align: left; overflow-wrap: anywhere; }
        th { background: #edf1f5; }
        @@page { size: A4 landscape; margin: 10mm; }
        @@media print { .actions { display: none; } body { margin: 0; } }
    </style>
    <script src="~/js/attendance/print-roster.js" asp-append-version="true" defer></script>
</head>
<body>
    <div class="actions"><button id="printRoster" type="button">@(bn ? "প্রিন্ট করুন" : "Print")</button></div>
    <h1>@(bn ? "স্টক রিজার্ভেশন ও রিকনসিলিয়েশন" : "Stock reservations and reconciliation")</h1>
    <p class="meta">@(bn ? "অনুমোদিত রেকর্ড" : "Authorized records"): @Model.TotalCount ·
        @(bn ? "প্রতিবেদন তৈরি (UTC)" : "Generated (UTC)"): @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)
        · @(bn ? "পরিমাণ পণ্যের নিজস্ব এককে" : "Quantities use each item's own unit")</p>
    <table>
        <thead><tr>
            <th>@(bn ? "মুভমেন্ট" : "Movement")</th>
            <th>@(bn ? "স্টোর" : "Store")</th>
            <th>@(bn ? "পণ্য" : "Item")</th>
            <th>@(bn ? "লট" : "Lot")</th>
            <th>@(bn ? "অবস্থা" : "State")</th>
            <th>@(bn ? "চাহিদা" : "Requested")</th>
            <th>@(bn ? "সরবরাহ" : "Fulfilled")</th>
            <th>@(bn ? "রিজার্ভ" : "Reserved")</th>
            <th>@(bn ? "মুক্ত" : "Released")</th>
            <th>@(bn ? "একক" : "Unit")</th>
            <th>@(bn ? "বয়স (দিন)" : "Age (days)")</th>
            <th>@(bn ? "মেয়াদ (UTC)" : "Deadline (UTC)")</th>
        </tr></thead>
        <tbody>
        @foreach (var row in Model.Items)
        {
            <tr>
                <td>@row.MovementNumber</td><td>@row.FromLocationId</td>
                <td>@row.ItemCode — @row.ItemName</td><td>@(row.LotOrBatchNo ?? "—")</td>
                <td>@row.StateCode @(row.IsOverdue ? "!" : "")</td>
                <td>@row.RequestedQuantity.ToString(CultureInfo.InvariantCulture)</td>
                <td>@row.FulfilledQuantity.ToString(CultureInfo.InvariantCulture)</td>
                <td>@row.ReservedQuantity.ToString(CultureInfo.InvariantCulture)</td>
                <td>@row.ReleasedQuantity.ToString(CultureInfo.InvariantCulture)</td>
                <td>@row.UnitCode</td>
                <td>@(row.HoldAgeDays?.ToString(CultureInfo.InvariantCulture) ?? "—")</td>
                <td>@(row.ReservationExpiresAtUtc?.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>
</body>
</html>
