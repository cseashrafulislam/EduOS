@{
    var bn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
}
<div class="card mb-3"><div class="card-body">
    <h3 class="h5">@(bn ? "সক্রিয় স্টক রিজার্ভেশন" : "Active stock reservations")</h3>
    <form id="inventoryReservationFilter" class="row g-2 mb-2">
        <div class="col-md-4"><label for="inventoryReservationSearch" class="form-label">@(bn ? "মুভমেন্ট, পণ্য বা লট" : "Movement, item or lot")</label>
            <input id="inventoryReservationSearch" class="form-control" maxlength="100" autocomplete="off" /></div>
        <div class="col-md-4"><label for="inventoryReservationLocation" class="form-label">@(bn ? "স্টোর" : "Store")</label>
            <select id="inventoryReservationLocation" class="form-select"><option value="">@(bn ? "সব অনুমোদিত স্টোর" : "All accessible stores")</option></select></div>
        <div class="col-md-4 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary">@(bn ? "খুঁজুন" : "Search")</button>
            <button type="button" id="inventoryReservationPrint" class="btn btn-outline-secondary">@(bn ? "প্রিন্ট" : "Print")</button>
            <button type="button" id="inventoryReservationExport" class="btn btn-outline-secondary">@(bn ? "CSV এক্সপোর্ট" : "Export CSV")</button>
        </div>
    </form>
    <div class="form-check mb-2"><input id="inventoryReservationIncludeClosed" class="form-check-input" type="checkbox" />
        <label for="inventoryReservationIncludeClosed" class="form-check-label">@(bn ? "মেয়াদোত্তীর্ণ, বাতিল ও সম্পন্ন রিজার্ভেশন দেখুন" : "Include expired, released and fulfilled reservations")</label>
    </div>
    <div class="form-check mb-2"><input id="inventoryReservationOverdueOnly" class="form-check-input" type="checkbox" />
        <label for="inventoryReservationOverdueOnly" class="form-check-label">@(bn ? "শুধু মেয়াদ পেরোনো সক্রিয় রিজার্ভেশন" : "Overdue active reservations only")</label>
    </div>
    <div class="table-responsive"><table class="table table-striped table-sm">
        <thead><tr>
            <th scope="col">@(bn ? "মুভমেন্ট" : "Movement")</th>
            <th scope="col">@(bn ? "ধরন" : "Type")</th>
            <th scope="col">@(bn ? "পণ্য" : "Item")</th>
            <th scope="col">@(bn ? "লট" : "Lot")</th>
            <th scope="col">@(bn ? "স্টোর" : "Store")</th>
            <th scope="col">@(bn ? "চাহিদা / সরবরাহ / অবশিষ্ট" : "Requested / fulfilled / held")</th>
            <th scope="col">@(bn ? "রিজার্ভের সময়" : "Held since")</th>
            <th scope="col">@(bn ? "বয়স (দিন)" : "Age (days)")</th>
            <th scope="col">@(bn ? "মেয়াদ / অবস্থা" : "Deadline / status")</th>
            <th scope="col">@(bn ? "কার্যক্রম" : "Actions")</th>
        </tr></thead>
        <tbody id="inventoryReservationRows"></tbody>
    </table></div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" id="inventoryReservationPrev" class="btn btn-outline-secondary btn-sm">@(bn ? "আগের" : "Previous")</button>
        <span id="inventoryReservationPage" aria-live="polite"></span>
        <button type="button" id="inventoryReservationNext" class="btn btn-outline-secondary btn-sm">@(bn ? "পরের" : "Next")</button>
    </div>
</div></div>

<dialog id="inventoryExpiryScheduleDialog" class="border rounded shadow p-3" aria-labelledby="inventoryExpiryScheduleTitle">
    <form id="inventoryExpiryScheduleForm">
        <h3 id="inventoryExpiryScheduleTitle" class="h5">@(bn ? "রিজার্ভেশনের মেয়াদ নির্ধারণ" : "Set reservation deadline")</h3>
        <label for="inventoryExpiryDeadline" class="form-label">@(bn ? "মেয়াদ শেষ হবে" : "Deadline")</label>
        <input id="inventoryExpiryDeadline" type="datetime-local" class="form-control" required />
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" id="inventoryExpiryScheduleCancel" class="btn btn-outline-secondary">@(bn ? "বাতিল" : "Cancel")</button>
            <button type="submit" id="inventoryExpiryScheduleSubmit" class="btn btn-primary">@(bn ? "সংরক্ষণ" : "Save deadline")</button>
        </div>
    </form>
</dialog>
<dialog id="inventoryExpiryConfirmDialog" class="border rounded shadow p-3" aria-labelledby="inventoryExpiryConfirmTitle">
    <form id="inventoryExpiryConfirmForm">
        <h3 id="inventoryExpiryConfirmTitle" class="h5">@(bn ? "মেয়াদোত্তীর্ণ রিজার্ভেশন বন্ধ" : "Expire reservation")</h3>
        <label for="inventoryExpiryReason" class="form-label">@(bn ? "অনুমোদিত কারণ" : "Approved reason")</label>
        <textarea id="inventoryExpiryReason" class="form-control" rows="3" minlength="10" maxlength="400" required></textarea>
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" id="inventoryExpiryConfirmCancel" class="btn btn-outline-secondary">@(bn ? "বাতিল" : "Cancel")</button>
            <button type="submit" id="inventoryExpiryConfirmSubmit" class="btn btn-danger">@(bn ? "মেয়াদ শেষ করুন" : "Expire hold")</button>
        </div>
    </form>
</dialog>
