@{
    var bn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
}
<div class="card mb-3"><div class="card-body">
    <h3 class="h5">@(bn ? "সক্রিয় স্টক রিজার্ভেশন" : "Active stock reservations")</h3>
    <form id="inventoryReservationFilter" class="row g-2 mb-2">
        <div class="col-md-4"><label for="inventoryReservationSearch" class="form-label">@(bn ? "মুভমেন্ট, পণ্য বা লট" : "Movement, item or lot")</label>
            <input id="inventoryReservationSearch" class="form-control" maxlength="100" autocomplete="off" /></div>
        <div class="col-md-4"><label for="inventoryReservationLocation" class="form-label">@(bn ? "স্টোর" : "Store")</label>
            <select id="inventoryReservationLocation" class="form-select"><option value="">@(bn ? "সব অনুমোদিত স্টোর" : "All accessible stores")</option></select></div>
        <div class="col-md-4 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary">@(bn ? "খুঁজুন" : "Search")</button>
            <button type="button" id="inventoryReservationExport" class="btn btn-outline-secondary">@(bn ? "CSV এক্সপোর্ট" : "Export CSV")</button>
        </div>
    </form>
    <div class="table-responsive"><table class="table table-striped table-sm">
        <thead><tr>
            <th scope="col">@(bn ? "মুভমেন্ট" : "Movement")</th>
            <th scope="col">@(bn ? "ধরন" : "Type")</th>
            <th scope="col">@(bn ? "পণ্য" : "Item")</th>
            <th scope="col">@(bn ? "লট" : "Lot")</th>
            <th scope="col">@(bn ? "স্টোর" : "Store")</th>
            <th scope="col">@(bn ? "চাহিদা / সরবরাহ / অবশিষ্ট" : "Requested / fulfilled / held")</th>
            <th scope="col">@(bn ? "রিজার্ভের সময়" : "Held since")</th>
        </tr></thead>
        <tbody id="inventoryReservationRows"></tbody>
    </table></div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" id="inventoryReservationPrev" class="btn btn-outline-secondary btn-sm">@(bn ? "আগের" : "Previous")</button>
        <span id="inventoryReservationPage" aria-live="polite"></span>
        <button type="button" id="inventoryReservationNext" class="btn btn-outline-secondary btn-sm">@(bn ? "পরের" : "Next")</button>
    </div>
</div></div>
