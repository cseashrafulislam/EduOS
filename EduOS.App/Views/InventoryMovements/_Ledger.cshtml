<div class="card mb-3"><div class="card-body">
    <h3 class="h5">Movement ledger</h3>
    <form id="movementFilter" class="row g-2 mb-2">
        <div class="col-md-3"><label for="movementFromDate" class="form-label">From date</label><input id="movementFromDate" class="form-control" type="date" /></div>
        <div class="col-md-3"><label for="movementToDate" class="form-label">To date</label><input id="movementToDate" class="form-control" type="date" /></div>
        <div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary" type="submit">Search</button></div>
    </form>
    <div class="table-responsive"><table class="table table-striped"><thead><tr><th>Number</th><th>Type</th><th>Date</th><th>From</th><th>To</th><th>Status</th><th>Lines</th><th>Actions</th></tr></thead><tbody id="movementRows"></tbody></table></div>
    <div class="d-flex gap-2 align-items-center"><button id="movementPrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button><span id="movementPage"></span><button id="movementNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button></div>
</div></div>
<div class="card mb-3"><div class="card-body">
    <h3 class="h5">Stock balance</h3>
    <form id="movementBalanceForm" class="row g-2">
        <div class="col-md-4"><label for="balanceItem" class="form-label">Item</label><select id="balanceItem" class="form-select"></select></div>
        <div class="col-md-4"><label for="balanceLocation" class="form-label">Location</label><select id="balanceLocation" class="form-select"></select></div>
        <div class="col-md-2 d-flex align-items-end"><button type="submit" class="btn btn-outline-primary">Get balance</button></div>
    </form>
    <div id="movementBalanceResult" class="mt-3" aria-live="polite"></div>
</div></div>