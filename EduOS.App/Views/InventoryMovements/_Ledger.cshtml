@{
    var bn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
}
<div class="card mb-3"><div class="card-body">
    <h3 class="h5">@(bn ? "স্টক মুভমেন্ট লেজার" : "Movement ledger")</h3>
    <form id="movementFilter" class="row g-2 mb-2">
        <div class="col-md-3"><label for="movementFromDate" class="form-label">@(bn ? "শুরুর তারিখ" : "From date")</label><input id="movementFromDate" class="form-control" type="date" /></div>
        <div class="col-md-3"><label for="movementToDate" class="form-label">@(bn ? "শেষ তারিখ" : "To date")</label><input id="movementToDate" class="form-control" type="date" /></div>
        <div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary" type="submit">@(bn ? "খুঁজুন" : "Search")</button></div>
    </form>
    <div class="table-responsive"><table class="table table-striped"><thead><tr>
        <th>@(bn ? "নম্বর" : "Number")</th><th>@(bn ? "ধরন" : "Type")</th><th>@(bn ? "তারিখ" : "Date")</th>
        <th>@(bn ? "উৎস" : "From")</th><th>@(bn ? "গন্তব্য" : "To")</th>
        <th>@(bn ? "অবস্থা" : "Status")</th><th>@(bn ? "লাইন" : "Lines")</th><th>@(bn ? "কার্যক্রম" : "Actions")</th>
    </tr></thead><tbody id="movementRows"></tbody></table></div>
    <div class="d-flex gap-2 align-items-center">
        <button id="movementPrev" type="button" class="btn btn-outline-secondary btn-sm">@(bn ? "আগের" : "Previous")</button>
        <span id="movementPage" aria-live="polite"></span>
        <button id="movementNext" type="button" class="btn btn-outline-secondary btn-sm">@(bn ? "পরের" : "Next")</button>
    </div>
</div></div>
<div class="card mb-3"><div class="card-body">
    <h3 class="h5">@(bn ? "স্টক ব্যালেন্স ও রিজার্ভেশন" : "Stock balance and reservations")</h3>
    <form id="movementBalanceForm" class="row g-2">
        <div class="col-md-4"><label for="balanceItem" class="form-label">@(bn ? "পণ্য" : "Item")</label><select id="balanceItem" class="form-select"></select></div>
        <div class="col-md-4"><label for="balanceLocation" class="form-label">@(bn ? "স্টোর" : "Location")</label><select id="balanceLocation" class="form-select"></select></div>
        <div class="col-md-2 d-flex align-items-end"><button type="submit" class="btn btn-outline-primary">@(bn ? "ব্যালেন্স দেখুন" : "Get balance")</button></div>
    </form>
    <div id="movementBalanceResult" class="mt-3" aria-live="polite"></div>
</div></div>
<dialog id="inventoryReleaseDialog" class="border rounded shadow p-3" aria-labelledby="inventoryReleaseTitle">
    <form id="inventoryReleaseForm">
        <h3 id="inventoryReleaseTitle" class="h5">@(bn ? "রিজার্ভেশন বাতিল" : "Release stock reservation")</h3>
        <label for="inventoryReleaseReason" class="form-label">@(bn ? "কারণ" : "Reason")</label>
        <textarea id="inventoryReleaseReason" class="form-control" rows="3" minlength="10" maxlength="400" required></textarea>
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button id="inventoryReleaseCancel" type="button" class="btn btn-outline-secondary">@(bn ? "ফিরে যান" : "Cancel")</button>
            <button id="inventoryReleaseSubmit" type="submit" class="btn btn-danger">@(bn ? "রিজার্ভেশন ছাড়ুন" : "Release")</button>
        </div>
    </form>
</dialog>
