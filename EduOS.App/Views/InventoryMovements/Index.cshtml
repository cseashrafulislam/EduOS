@{
    ViewData["Title"] = "Inventory Movements";
    var canCreate = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("InventoryManager") || User.IsInRole("StoreKeeper");
    var canPost = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("InventoryManager");
    var canReverse = User.IsInRole("TenantAdmin") || User.IsInRole("Principal");
}
<section id="inventoryMovements" class="container-fluid py-3" data-create="@canCreate.ToString().ToLowerInvariant()" data-post="@canPost.ToString().ToLowerInvariant()" data-reverse="@canReverse.ToString().ToLowerInvariant()">
    <header class="d-flex justify-content-between align-items-center mb-3 gap-2"><div>
        <h2>@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn" ? "স্টক মুভমেন্ট" : "Inventory Movements")</h2>
        <details class="small"><summary class="btn btn-link btn-sm p-0" aria-label="Inventory movement help">ⓘ @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn" ? "সহায়তা" : "Help")</summary>
            <div class="small text-muted">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn" ?
                "ইস্যু বা ট্রান্সফার ড্রাফট রিজার্ভ করুন; অনুমোদিত পোস্টিংয়ে রিজার্ভেশন ব্যবহার হবে। ছাড়তে কারণ দিন। পোস্ট করা লেজার অপরিবর্তনীয়।" :
                "Reserve issue or transfer drafts before approval; posting consumes their hold. Release requires a reason. Posted ledger entries are immutable.")</div>
        </details></div><a class="btn btn-outline-secondary" href="/InventoryCatalog/Index">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn" ? "পণ্যের তালিকা" : "Inventory Catalog")</a></header>
    <div id="movementAlert" class="d-none" role="alert"></div>
    @if (canCreate) { @await Html.PartialAsync("_Create") }
    @if (canCreate) {
        <div class="card mb-3"><div class="card-body">
            <h3 class="h5">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn" ? "ট্রান্সফার গ্রহণ" : "Receive in-transit stock")</h3>
            <form id="transferReceiveForm" class="row g-2">
                <div class="col-md-8"><label for="transferDispatchReference" class="form-label">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn" ? "ডিসপ্যাচ নম্বর বা UUID" : "Dispatch number or UUID")</label>
                    <input id="transferDispatchReference" class="form-control" required maxlength="36" autocomplete="off" /></div>
                <div class="col-md-4 d-flex align-items-end"><button class="btn btn-primary" type="submit">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn" ? "স্টক গ্রহণ করুন" : "Receive stock")</button></div>
            </form>
        </div></div>
    }
    @await Html.PartialAsync("_Ledger")
    @await Html.PartialAsync("_Reservations")
    @await Html.PartialAsync("_Reorder")
    @await Html.PartialAsync("_StockPosition")
    @await Html.PartialAsync("_LotAging")
    @await Html.PartialAsync("_ItemHistory")
</section>
@section Scripts { <script type="module" src="~/js/inventory/movements.js" asp-append-version="true"></script> }