@{
    var taskPage = ViewData["MovementTask"]?.ToString() ?? "all";
    var showTransactions = taskPage is "all" or "transactions";
    var showAdjustments = taskPage is "all" or "adjustments";
    var showCounts = taskPage is "all" or "counts";
    var showReports = taskPage is "all" or "reports";
    var inBangla = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
    ViewData["Title"] = taskPage switch
    {
        "transactions" => inBangla ? "স্টক গ্রহণ ও ইস্যু" : "Stock Transactions",
        "adjustments" => inBangla ? "স্টক সমন্বয়" : "Stock Adjustments",
        "counts" => inBangla ? "স্টক গণনা" : "Physical Stock Counts",
        "reports" => inBangla ? "স্টক প্রতিবেদন" : "Stock Reports",
        _ => inBangla ? "স্টক মুভমেন্ট" : "Inventory Movements"
    };
    var canCreate = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("InventoryManager") || User.IsInRole("StoreKeeper");
    var canPost = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("InventoryManager");
    var canReverse = User.IsInRole("TenantAdmin") || User.IsInRole("Principal");
}
<section id="inventoryMovements" class="container-fluid py-3" data-task-page="@taskPage" data-create="@canCreate.ToString().ToLowerInvariant()" data-post="@canPost.ToString().ToLowerInvariant()" data-reverse="@canReverse.ToString().ToLowerInvariant()" data-user-id="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)">
    <header class="d-flex justify-content-between align-items-center mb-3 gap-2"><div>
        <h2>@ViewData["Title"]</h2>
        </div><a class="btn btn-outline-secondary" href="/InventoryCatalog/Index">@(inBangla ? "পণ্যের তালিকা" : "Inventory Catalog")</a></header>
    <div id="movementAlert" class="d-none" role="alert"></div>
    @if (showTransactions)
    {
    <div data-inventory-area="transactions">
    @if (canCreate) { @await Html.PartialAsync("_Create") }
    @if (canCreate) {
        <div class="card mb-3"><div class="card-body">
            <h3 class="h5">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn" ? "ট্রান্সফার গ্রহণ" : "Receive in-transit stock")</h3>
            <form id="transferReceiveForm" class="row g-2">
                <div class="col-md-8"><label for="transferDispatchReference" class="form-label">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn" ? "ডিসপ্যাচ নম্বর বা UUID" : "Dispatch number or UUID")</label>
                    <input id="transferDispatchReference" class="form-control" required maxlength="36" autocomplete="off" /></div>
                <div class="col-md-4 d-flex align-items-end"><button class="btn btn-primary" type="submit">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn" ? "স্টক গ্রহণ করুন" : "Receive stock")</button></div>
            </form>
        </div></div>
    }
    @await Html.PartialAsync("_Ledger")
    </div>
    }
    @if (showAdjustments && canCreate)
    {
        <div data-inventory-area="adjustments">@await Html.PartialAsync("_Adjustments")</div>
    }
    @if (showCounts)
    {
        <div data-inventory-area="counts">@await Html.PartialAsync("_PhysicalCounts")</div>
    }
    @if (showReports)
    {
    <div data-inventory-area="reports">
        @await Html.PartialAsync("_Reservations")
        @await Html.PartialAsync("_Reorder")
        @await Html.PartialAsync("_StockPosition")
        @await Html.PartialAsync("_LotAging")
        @await Html.PartialAsync("_ItemHistory")
    </div>
    }
</section>
@section Scripts { <script src="~/js/platform/task-workspace-locales.js" asp-append-version="true"></script><script src="~/js/platform/form-guard.js" asp-append-version="true"></script><script type="module" src="~/js/inventory/movements.js" asp-append-version="true"></script> }
