@{
    ViewData["Title"] = "My Submissions";
}
<section class="container-fluid py-3" id="mySubmissionApp">
    <header class="mb-3 d-flex align-items-center justify-content-between gap-2">
        <h1 class="h4 mb-0">My Assignment Submissions</h1>
        <details class="small"><summary class="btn btn-outline-secondary btn-sm" aria-label="Assignment submission help" title="Help">ⓘ</summary>
            <div class="border rounded p-2 mt-1">Submit one answer with up to 10 scanned files (5 MB each). Submitted work cannot be replaced. Only you and authorized course staff can download it.</div>
        </details>
    </header>
    <a asp-controller="Learning" asp-action="Index" class="btn btn-outline-secondary mb-3">Back to Learning</a>
    <div id="mySubmissionAlert" class="d-none" role="alert" tabindex="-1"></div>
    <div class="card mb-3"><div class="card-body row g-2">
        <div class="col-md-9"><label for="mySubmissionSearch" class="form-label">Search</label><input id="mySubmissionSearch" class="form-control" maxlength="80" /></div>
        <div class="col-md-3"><button id="mySubmissionRefresh" type="button" class="btn btn-primary w-100">Refresh</button></div>
        <div class="col-12 d-flex gap-2"><button id="mySubmissionCsv" type="button" class="btn btn-outline-secondary btn-sm">CSV</button><button id="mySubmissionPrint" type="button" class="btn btn-outline-secondary btn-sm">Print</button><span id="mySubmissionCount" class="ms-auto small"></span></div>
    </div></div>
    <div class="card mb-3"><div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0">
        <thead><tr><th>Course</th><th>Assignment</th><th>Due</th><th>Status</th><th>Marks</th><th>Action</th></tr></thead>
        <tbody id="mySubmissionRows"><tr><td colspan="6" class="p-3">Loading...</td></tr></tbody>
    </table></div><div class="card-footer d-flex gap-2 align-items-center">
        <button id="mySubmissionPrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
        <span id="mySubmissionPage">Page 1</span>
        <button id="mySubmissionNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
    </div></div>
    <form id="mySubmissionForm" class="card mb-3" hidden>
        <div class="card-header"><h2 id="mySubmissionHeading" class="h6 mb-0">Submit assignment</h2></div>
        <div class="card-body">
            <div id="mySubmissionRubricPreview" class="small text-muted mb-2" aria-live="polite"></div>
            <label for="mySubmissionText" class="form-label">Answer</label>
            <textarea id="mySubmissionText" maxlength="4000" rows="4" class="form-control mb-3"></textarea>
            <label for="mySubmissionUploadFiles" class="form-label">Attachments (maximum 10, 5 MB each)</label>
            <input id="mySubmissionUploadFiles" type="file" multiple accept=".jpg,.jpeg,.png,.webp,.pdf,.doc,.docx" class="form-control mb-3" />
            <button id="mySubmissionSend" type="submit" class="btn btn-primary">Submit</button>
            <button id="mySubmissionCancel" type="button" class="btn btn-outline-secondary">Cancel</button>
        </div>
    </form>
    <div class="card" id="mySubmissionFilePanel" hidden>
        <div class="card-header d-flex align-items-center justify-content-between">Submission details
            <button id="mySubmissionFileClose" class="btn btn-outline-secondary btn-sm" type="button">Close</button>
        </div>
        <div class="card-body border-bottom"><div id="mySubmissionFeedback" class="small" style="white-space:pre-wrap;overflow-wrap:anywhere;"></div>
            <div id="mySubmissionRubricBreakdown" class="mt-2 small"></div></div>
        <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>File</th><th>Action</th></tr></thead><tbody id="mySubmissionFileRows"></tbody></table></div>
    </div>
</section>
@section Scripts { <script src="~/js/learning/my-submissions.js" asp-append-version="true"></script> }
