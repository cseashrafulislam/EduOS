@{
    ViewData["Title"] = "Learning Management";
    var canAuthor = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("Teacher");
    var isStudent = User.IsInRole("Student");
    var isManager = User.IsInRole("TenantAdmin") || User.IsInRole("Principal");
}
<section class="container-fluid py-3" id="learningApp" data-author="@canAuthor.ToString().ToLowerInvariant()" data-student="@isStudent.ToString().ToLowerInvariant()" data-manager="@isManager.ToString().ToLowerInvariant()">
    <header class="d-flex align-items-center gap-2 mb-3"><h2 class="h4 mb-0">Learning Management</h2>
        <details class="position-relative"><summary class="btn btn-sm btn-outline-secondary" aria-label="Learning page help" title="Help">ⓘ</summary>
            <div class="card position-absolute p-2 shadow-sm" style="width:min(20rem,80vw);z-index:10;">Choose a course to view lessons and assignments. Instructors publish content; enrolled students submit work and track progress. Archived completed courses are read-only.</div>
        </details></header>
    <div class="mb-3"><a class="btn btn-outline-primary" asp-controller="Learning" asp-action="Quizzes">Quiz Assessment</a> <a class="btn btn-outline-primary" asp-controller="Learning" asp-action="LiveClasses">Live Classes</a> <a class="btn btn-outline-primary" asp-controller="Learning" asp-action="CourseContent">Course Sections &amp; Resources</a> <a class="btn btn-outline-primary" asp-controller="Learning" asp-action="AssignmentFiles">Assignment Files</a> @if(canAuthor) { <a class="btn btn-outline-primary" asp-controller="Learning" asp-action="CourseCompletions">Course Completions</a> } @if(isStudent) { <a class="btn btn-primary" asp-controller="Learning" asp-action="MySubmissions">My Submissions</a> }</div>
    <div id="learningAlert" role="alert" tabindex="-1" class="d-none" aria-live="polite"></div>
    @if(isStudent)
    {
        <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
            <label class="form-check-label"><input id="learningIncludeArchived" type="checkbox" class="form-check-input me-1" /> Include archived completed courses in courses and progress</label>
            <button id="learningHistoricalExport" type="button" class="btn btn-outline-secondary btn-sm">Export visible courses (CSV)</button>
        </div>
        <section class="card mb-3" aria-labelledby="learningMyProgressHeading">
            <div class="card-header d-flex flex-wrap justify-content-between gap-2 align-items-center">
                <h3 class="h6 mb-0" id="learningMyProgressHeading">My course progress</h3>
                <div class="d-flex gap-2">
                    <button id="learningMyProgressRefresh" type="button" class="btn btn-outline-primary btn-sm">Refresh progress</button>
                    <button id="learningMyProgressExport" type="button" class="btn btn-outline-secondary btn-sm">Export visible page (CSV)</button>
                </div>
            </div>
            <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0">
                <thead><tr><th>Course</th><th>Enrollment</th><th>Lessons</th><th>Graded assignments</th><th>Passed quizzes</th><th>Lesson completion</th></tr></thead>
                <tbody id="learningMyProgressRows"><tr><td colspan="6">Loading progress…</td></tr></tbody>
            </table></div>
            <div class="card-footer d-flex justify-content-end align-items-center gap-2">
                <button id="learningMyProgressPrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
                <span id="learningMyProgressPage" aria-live="polite">Page 1</span>
                <button id="learningMyProgressNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
            </div>
        </section>
        <section class="card mb-3" id="lmsProgressConsentApp" data-mode="student"
            data-lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
            <div class="card-header d-flex align-items-center gap-2">
                <h3 class="h6 mb-0">Guardian learning-progress access / অভিভাবকের অগ্রগতি দেখার অনুমতি</h3>
                <details><summary class="btn btn-sm btn-outline-secondary" aria-label="Progress sharing help">ⓘ</summary>
                    <span class="small">Consent applies only to the selected course enrollment and can be revoked.</span>
                </details>
            </div>
            <div class="card-body">
                <div id="lmsProgressConsentAlert" class="d-none" role="alert" aria-live="polite"></div>
                <div class="row g-2 align-items-end">
                    <div class="col-md-5"><label class="form-label" for="lmsProgressConsentEnrollment">Course / কোর্স</label>
                        <select id="lmsProgressConsentEnrollment" class="form-select"></select></div>
                    <div class="col-md-4"><label class="form-label" for="lmsProgressConsentGuardian">Guardian / অভিভাবক</label>
                        <select id="lmsProgressConsentGuardian" class="form-select"></select></div>
                    <div class="col-md-3"><button id="lmsProgressConsentGrant" type="button" class="btn btn-primary w-100" disabled>Allow / অনুমতি দিন</button></div>
                </div>
                <div id="lmsProgressConsentGrants" class="mt-3" aria-live="polite"></div>
                <div class="d-flex align-items-center gap-2">
                    <button id="lmsProgressConsentPrev" class="btn btn-sm btn-outline-secondary" type="button">Previous / আগের</button>
                    <span id="lmsProgressConsentPage"></span>
                    <button id="lmsProgressConsentNext" class="btn btn-sm btn-outline-secondary" type="button">Next / পরের</button>
                </div>
            </div>
        </section>
        <div id="learningHistoricalNotice" class="alert alert-info d-none" role="status">Archived course: published lessons and assignments are available for historical reading only. New progress and submissions are disabled.</div>
    }
    @if(canAuthor) { <div id="learningAuthoringLock" class="alert alert-warning d-none" role="status" aria-live="polite"></div> }
    <div class="card mb-3"><div class="card-body row g-2 align-items-end"><div class="col-md-9"><label for="learningCourse" class="form-label">Course</label><select id="learningCourse" class="form-select"><option value="">Loading courses…</option></select></div>@if(canAuthor) { <div class="col-md-3"><button id="learningEditCourse" type="button" class="btn btn-outline-secondary w-100">Edit selected course</button></div> }
    <div class="col-md-3"><button id="learningRefresh" type="button" class="btn btn-outline-primary w-100">Refresh courses</button></div><div class="col-12 d-flex align-items-center justify-content-end gap-2"><button id="learningCoursePrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button><span id="learningCoursePage">Page 1</span><button id="learningCourseNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button></div></div></div>
    @if(canAuthor)
    {
        <section class="card mb-3">
            <div class="card-header"><h3 class="h6 m-0">Create or update a course</h3></div>
            <form id="learningCourseForm" class="card-body row g-2 align-items-end">
                <div class="col-md-4"><label for="learningProgram" class="form-label">Academic program</label><select id="learningProgram" class="form-select"><option value="">Loading…</option></select></div>
                <div class="col-md-4"><label for="learningSubject" class="form-label">Subject</label><select id="learningSubject" class="form-select"><option value="">Loading…</option></select></div>
                @if(isManager)
                {
                    <div class="col-md-4"><label for="learningInstructor" class="form-label">Instructor</label><select id="learningInstructor" class="form-select"><option value="">Loading instructors…</option></select></div>
                }
                <div class="col-md-4"><label for="learningCode" class="form-label">Course code</label><input id="learningCode" class="form-control" maxlength="50" required /></div><div class="col-md-4"><label for="learningTitle" class="form-label">Course title</label><input id="learningTitle" class="form-control" maxlength="200" required /></div>
                <div class="col-md-10"><label for="learningDescription" class="form-label">Description</label><textarea id="learningDescription" class="form-control" rows="2" maxlength="4000"></textarea></div>
                <div class="col-md-2"><button id="learningSaveCourse" class="btn btn-primary w-100" type="submit">Save course</button></div><div class="col-md-2"><button id="learningResetCourse" type="button" class="btn btn-outline-secondary w-100">Clear</button></div><div class="col-12 d-flex gap-3"><label><input id="learningSelfPaced" type="checkbox" /> Self-paced</label><label><input id="learningCourseActive" type="checkbox" checked /> Active</label></div>
            </form>
        </section>
    }
    <section class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center"><h3 class="h6 m-0">Lessons</h3><span id="learningProgress" class="small text-muted"></span></div>
        <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead><tr><th>Order</th><th>Lesson</th><th>Content / resource</th><th>Action</th></tr></thead><tbody id="learningLessons"><tr><td colspan="4" class="text-muted text-center p-3">Choose a course.</td></tr></tbody></table></div>
        <div class="card-footer d-flex flex-wrap align-items-center gap-2">
            <button id="learningLessonPrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
            <span id="learningLessonPage" class="small text-muted">Page 1</span>
            <button id="learningLessonNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
            <button id="learningLessonExport" type="button" class="btn btn-outline-secondary btn-sm ms-auto">Export visible lessons (CSV)</button>
        </div>
        @if(canAuthor)
        {
            <form id="learningLessonForm" class="card-body border-top row g-2 align-items-end">
                <div class="col-md-2"><label for="learningOrder" class="form-label">Order</label><input id="learningOrder" type="number" min="1" max="10000" value="1" class="form-control" required /></div>
                <div class="col-md-5"><label for="learningLessonTitle" class="form-label">Lesson title</label><input id="learningLessonTitle" maxlength="200" class="form-control" required /></div>
                <div class="col-md-5"><label for="learningVideo" class="form-label">Video link</label><input id="learningVideo" maxlength="500" class="form-control" /></div>
                <div class="col-12"><label for="learningContent" class="form-label">Content</label><textarea id="learningContent" maxlength="4000" rows="3" class="form-control"></textarea></div>
                <div class="col-12"><label><input id="learningLessonPublished" type="checkbox" /> Published</label></div><div class="col-12 d-flex gap-2"><button id="learningSaveLesson" type="submit" class="btn btn-outline-primary">Save lesson</button><button id="learningResetLesson" type="button" class="btn btn-outline-secondary">Clear</button></div>
            </form>
        }
    </section>
    <section class="card mb-3">
        <div class="card-header"><h3 class="h6 m-0">Assignments</h3></div>
        <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead><tr><th>Assignment</th><th>Due date</th><th>Full marks</th><th>Submission</th><th>Action</th></tr></thead><tbody id="learningAssignments"><tr><td colspan="5" class="text-muted text-center p-3">Choose a course.</td></tr></tbody></table></div>
        <div class="card-footer d-flex flex-wrap align-items-center gap-2">
            <button id="learningAssignmentPrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
            <span id="learningAssignmentPage" class="small text-muted">Page 1</span>
            <button id="learningAssignmentNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
            <button id="learningAssignmentExport" type="button" class="btn btn-outline-secondary btn-sm ms-auto">Export visible assignments (CSV)</button>
        </div>
        @if(canAuthor)
        {
            <form id="learningAssignmentForm" class="card-body border-top row g-2 align-items-end">
                <div class="col-md-5"><label for="learningAssignmentTitle" class="form-label">Assignment title</label><input id="learningAssignmentTitle" maxlength="200" class="form-control" required /></div>
                <div class="col-md-3"><label for="learningDue" class="form-label">Due date and time</label><input id="learningDue" type="datetime-local" class="form-control" /></div>
                <div class="col-md-2"><label for="learningTotal" class="form-label">Full marks</label><input id="learningTotal" type="number" min="0" max="100000" value="100" class="form-control" required /></div>
                <div class="col-md-2"><button id="learningSaveAssignment" class="btn btn-outline-primary w-100" type="submit">Save</button></div>
                <div class="col-12"><label for="learningInstructions" class="form-label">Instructions</label><textarea id="learningInstructions" maxlength="4000" rows="2" class="form-control"></textarea></div><div class="col-12 d-flex gap-3"><label><input id="learningAssignmentPublished" type="checkbox" /> Published</label><button id="learningResetAssignment" type="button" class="btn btn-outline-secondary btn-sm">Clear assignment</button></div>
            </form>
        }
    </section>
    @if(canAuthor)
    {
        <section class="card mb-3" id="learningReviewPanel">
            <div class="card-header"><h3 class="h6 m-0">Submission review and grading</h3></div>
            <div class="card-body row g-2 align-items-end">
                <div class="col-md-8"><label for="learningReviewAssignment" class="form-label">Assignment</label><select id="learningReviewAssignment" class="form-select"><option value="">Choose an assignment</option></select></div>
                <div class="col-md-4"><button id="learningReviewRefresh" type="button" class="btn btn-outline-primary w-100">Refresh submissions</button></div>
            </div>
            <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead><tr><th>Student</th><th>Submitted</th><th>Answer</th><th>Status</th><th>Marks / feedback</th><th>Action</th></tr></thead><tbody id="learningReviewRows"><tr><td colspan="6" class="text-muted">Choose an assignment.</td></tr></tbody></table></div>
            <div class="card-footer d-flex align-items-center gap-2"><button id="learningReviewPrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button><span id="learningReviewPage" class="small text-muted">Page 1</span><button id="learningReviewNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button></div>
        </section>
    }
</section>
@section Scripts {
    @if (User.IsInRole("Student")) { <script src="~/js/learning/progress-guardian.js" asp-append-version="true"></script> } <script src="~/js/learning/index.js" asp-append-version="true"></script> }
