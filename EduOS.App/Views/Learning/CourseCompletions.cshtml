@{
    ViewData["Title"] = "LMS Course Completion Register";
}
<section class="container-fluid py-3" id="lmsCompletionApp">
    <header class="d-flex align-items-center mb-3 gap-2">
        <h2 class="h4 mb-0">Course Completion Register</h2>
        <details id="lmsCompletionHelp" class="position-relative">
            <summary class="btn btn-sm btn-outline-secondary" aria-label="Completion register help" title="Help">ⓘ</summary>
            <div class="card position-absolute p-2 shadow-sm" style="width: min(20rem, 80vw); z-index: 10;">
                Filter enrollments by student, verify lessons, graded assignments and passed quizzes before completing. Export up to 250 filtered rows; narrow the search for larger registers.
            </div>
        </details>
    </header>
    <div id="lmsCompletionAlert" class="d-none" role="alert" tabindex="-1" aria-live="polite"></div>
    <div class="card mb-3"><div class="card-body row g-2 align-items-end">
        <div class="col-lg-6"><label class="form-label" for="lmsCompletionCourse">Course</label><select id="lmsCompletionCourse" class="form-select"><option value="">Loading courses…</option></select></div>
        <div class="col-lg-4"><label class="form-label" for="lmsCompletionSearch">Student name or code</label><input id="lmsCompletionSearch" maxlength="100" class="form-control" /></div>
        <div class="col-lg-2"><button id="lmsCompletionSearchButton" type="button" class="btn btn-primary w-100">Search</button></div>
        <div class="col-12 d-flex gap-2 align-items-center">
            <button id="lmsCompletionCoursePrev" type="button" class="btn btn-outline-secondary btn-sm">Previous courses</button>
            <span id="lmsCompletionCoursePage" class="small text-muted"></span>
            <button id="lmsCompletionCourseNext" type="button" class="btn btn-outline-secondary btn-sm">Next courses</button>
        </div>
    </div></div>
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Enrollment eligibility</strong>
            <div><button id="lmsCompletionCsv" type="button" class="btn btn-sm btn-outline-secondary">Export filtered CSV (max 250)</button>
            <button id="lmsCompletionPrint" type="button" class="btn btn-sm btn-outline-secondary">Print visible page</button></div>
        </div>
        <div class="table-responsive"><table id="lmsCompletionTable" class="table table-sm table-striped align-middle mb-0">
            <thead><tr><th>Student</th><th>State</th><th>Lessons</th><th>Assignments</th><th>Quizzes</th><th>Eligibility / reason</th><th>Action</th></tr></thead>
            <tbody id="lmsCompletionRows"><tr><td colspan="7" class="text-muted">Select a course.</td></tr></tbody>
        </table></div>
        <div class="card-footer d-flex align-items-center gap-2">
            <button id="lmsCompletionPrev" type="button" class="btn btn-sm btn-outline-secondary">Previous</button>
            <span id="lmsCompletionPage" class="small text-muted"></span>
            <button id="lmsCompletionNext" type="button" class="btn btn-sm btn-outline-secondary">Next</button>
        </div>
    </div>
    <section id="lmsInstructorLessonPanel" class="card mt-3 d-none" aria-labelledby="lmsInstructorLessonHeading" data-lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h3 class="h6 mb-0" id="lmsInstructorLessonHeading">Lesson progress</h3>
            <div class="d-flex gap-2 flex-wrap">
                <button id="lmsInstructorLessonExport" type="button" class="btn btn-sm btn-outline-secondary">Export lesson CSV (max 250)</button>
                <button id="lmsInstructorLessonClose" type="button" class="btn btn-sm btn-outline-secondary" aria-label="Close lesson progress">Close</button>
            </div>
        </div>
        <div id="lmsInstructorLessonAlert" class="d-none" role="alert" aria-live="polite"></div>
        <div class="table-responsive"><table class="table table-sm table-striped mb-0">
            <thead><tr><th scope="col">Lesson</th><th scope="col">Progress</th><th scope="col">Completed</th><th scope="col">Completed at</th></tr></thead>
            <tbody id="lmsInstructorLessonRows"><tr><td colspan="4">Select a learner.</td></tr></tbody>
        </table></div>
        <div class="card-footer d-flex align-items-center justify-content-end gap-2">
            <button id="lmsInstructorLessonPrev" type="button" class="btn btn-sm btn-outline-secondary">Previous</button>
            <span id="lmsInstructorLessonPage" aria-live="polite"></span>
            <button id="lmsInstructorLessonNext" type="button" class="btn btn-sm btn-outline-secondary">Next</button>
        </div>
    </section>
</section>
@section Scripts {
    <script src="~/js/learning/completion-report.js" asp-append-version="true"></script>
    <script src="~/js/learning/instructor-lesson-progress.js" asp-append-version="true"></script>
    <script src="~/js/learning/course-completions.js" asp-append-version="true"></script>
}
