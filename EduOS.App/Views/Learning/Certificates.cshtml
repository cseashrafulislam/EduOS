@{
    ViewData["Title"] = "LMS Completion Certificates";
    var guardianMode = ViewData["LmsGuardianMode"] is true;
    var studentMode = User.IsInRole("Student") &&
        !User.IsInRole("Teacher") && !User.IsInRole("Principal") && !User.IsInRole("TenantAdmin");
}
<section id="lmsCertificateApp" class="container-fluid py-3" data-student-mode="@studentMode.ToString().ToLowerInvariant()" data-guardian-mode="@guardianMode.ToString().ToLowerInvariant()">
    <header class="d-flex align-items-center gap-2 mb-3">
        <h2 class="h4 mb-0" data-lms-i18n="title">LMS Completion Certificates</h2>
        <details id="lmsCertificateHelp" class="position-relative">
            <summary class="btn btn-sm btn-outline-secondary" aria-label="Certificate help" title="Help">ⓘ</summary>
            <div class="card position-absolute shadow-sm p-2" style="width:min(20rem,80vw);z-index:10" data-lms-i18n="help">
                Certificates are issued only for verified completed courses. Revocation keeps the original record; reissue creates a new revision.
            </div>
        </details>
    </header>
    <div id="lmsCertificateAlert" class="d-none" role="alert" aria-live="polite" tabindex="-1"></div>
    @if (!studentMode && !guardianMode)
    {
        <div class="card mb-3"><div class="card-body">
            <label for="lmsCertificateCourse" class="form-label" data-lms-i18n="course">Course</label>
            <select id="lmsCertificateCourse" class="form-select"><option value="">Loading…</option></select>
            <div class="d-flex gap-2 align-items-center mt-2">
                <button id="lmsCertificateCoursePrev" class="btn btn-sm btn-outline-secondary" type="button" data-lms-i18n="previous">Previous</button>
                <span id="lmsCertificateCoursePage" class="small text-muted"></span>
                <button id="lmsCertificateCourseNext" class="btn btn-sm btn-outline-secondary" type="button" data-lms-i18n="next">Next</button>
            </div>
        </div></div>
    }
    <div class="card mb-3" id="lmsCertificateRegister">
        <div class="card-header"><strong data-lms-i18n="register">Certificate register</strong></div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead><tr>
                    <th data-lms-i18n="learner">Learner</th><th data-lms-i18n="course">Course</th>
                    <th data-lms-i18n="revision">Revision</th><th data-lms-i18n="issued">Issued</th>
                    <th data-lms-i18n="status">Status</th><th data-lms-i18n="action">Action</th>
                </tr></thead>
                <tbody id="lmsCertificateRows"><tr><td colspan="6" data-lms-i18n="loading">Loading…</td></tr></tbody>
            </table>
        </div>
        <div class="card-footer d-flex gap-2 align-items-center">
            <button id="lmsCertificatePrev" type="button" class="btn btn-sm btn-outline-secondary" data-lms-i18n="previous">Previous</button>
            <span id="lmsCertificatePage" class="small text-muted"></span>
            <button id="lmsCertificateNext" type="button" class="btn btn-sm btn-outline-secondary" data-lms-i18n="next">Next</button>
        </div>
    </div>
    <div id="lmsCertificateDetail" class="d-none">
        <div class="d-flex gap-2 mb-2 flex-wrap">
            <a id="lmsCertificatePrint" class="btn btn-primary btn-sm disabled" target="_blank" rel="noopener noreferrer" aria-disabled="true" tabindex="-1" data-lms-i18n="print">Print / Save PDF</a>
            @if (User.IsInRole("TenantAdmin") || User.IsInRole("Principal"))
            {
                <button id="lmsCertificateRevoke" class="btn btn-outline-danger btn-sm" type="button" data-lms-i18n="revoke">Revoke</button>
                <button id="lmsCertificateReissue" class="btn btn-outline-primary btn-sm" type="button" data-lms-i18n="reissue">Reissue</button>
            }
        </div>
        <article id="lmsCertificateDocument" class="card p-4 p-md-5" aria-label="LMS course completion certificate">
            <div class="text-center">
                <h2 class="h3" data-lms-i18n="documentTitle">Certificate of Course Completion</h2>
                <p class="text-muted" data-lms-i18n="documentSubtitle">EduOS Learning Management System</p>
                <h3 id="lmsCertificateStudent" class="h4 mt-4"></h3>
                <p data-lms-i18n="completed">has completed the course</p>
                <h4 id="lmsCertificateTitle" class="h5"></h4>
                <p id="lmsCertificateCode"></p>
                <p id="lmsCertificateDates"></p>
                <p id="lmsCertificateEvidence" class="small"></p>
                <p id="lmsCertificateReference" class="small text-muted"></p>
                <strong id="lmsCertificateStatus"></strong>
            </div>
        </article>
        @if (studentMode)
        {
            <section class="card mt-3 d-none" id="lmsCertificatePublicSharing" aria-label="Public certificate verification">
                <div class="card-header"><strong>Public verification / সর্বজনীন যাচাই</strong></div>
                <div class="card-body">
                    <div class="d-flex gap-2 flex-wrap">
                        <button id="lmsPublicEnable" class="btn btn-sm btn-outline-primary" type="button">Create / Rotate link · লিংক তৈরি</button>
                        <button id="lmsPublicDisable" class="btn btn-sm btn-outline-danger" type="button" disabled>Disable link · বন্ধ করুন</button>
                    </div>
                    <div id="lmsPublicStatus" class="small mt-2" aria-live="polite"></div>
                    <div id="lmsPublicLinkWrap" class="d-none mt-2">
                        <label class="form-label" for="lmsPublicLink">Shareable verification link / যাচাইয়ের লিংক</label>
                        <div class="d-flex gap-2">
                            <input id="lmsPublicLink" class="form-control" type="text" readonly autocomplete="off" />
                            <button id="lmsPublicCopy" class="btn btn-sm btn-outline-secondary" type="button">Copy / কপি</button>
                        </div>
                    </div>
                </div>
            </section>
            <section class="card mt-3" id="lmsCertificateSharing" aria-label="Certificate guardian sharing">
                <div class="card-header"><strong data-lms-i18n="sharing">Guardian access</strong></div>
                <div class="card-body">
                    <label for="lmsCertificateGuardian" class="form-label" data-lms-i18n="chooseGuardian">Guardian</label>
                    <div class="d-flex flex-wrap gap-2">
                        <select id="lmsCertificateGuardian" class="form-select flex-grow-1" style="max-width:25rem"></select>
                        <button id="lmsCertificateGrant" type="button" class="btn btn-outline-primary" data-lms-i18n="share">Allow access</button>
                    </div>
                    <div id="lmsCertificateGrants" class="mt-3" aria-live="polite"></div>
                </div>
            </section>
        }
        @if (User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("Teacher"))
        {
            <div class="card mt-3" id="lmsCertificateAudit">
                <div class="card-header"><strong data-lms-i18n="history">Issuance history</strong></div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th data-lms-i18n="event">Event</th><th data-lms-i18n="when">When</th><th data-lms-i18n="actor">Actor ID</th></tr></thead>
                        <tbody id="lmsCertificateAuditRows"></tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</section>
<style>
@@media print {
    body * { visibility: hidden !important; }
    #lmsCertificateDocument, #lmsCertificateDocument * { visibility: visible !important; }
    #lmsCertificateDocument { position: absolute; inset: 0 auto auto 0; width: 100%; border: 0 !important; box-shadow: none !important; }
    @@page { size: A4 portrait; margin: 18mm; }
}
</style>
@section Scripts {
    <script src="~/js/learning/certificates.js" asp-append-version="true"></script>
    @if (studentMode)
    {
        <script src="~/js/learning/certificate-sharing.js" asp-append-version="true"></script>
        <script src="~/js/learning/certificate-public-sharing.js" asp-append-version="true"></script>
    }
}
