@{
    ViewData["Title"] = "LMS Live Classes";
    var author = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("Teacher");
    var manager = User.IsInRole("TenantAdmin") || User.IsInRole("Principal");
}
<section id="liveClassApp" class="container-fluid py-3" data-author="@author.ToString().ToLowerInvariant()" data-manager="@manager.ToString().ToLowerInvariant()">
    <header class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
        <div><h2 class="h4 mb-1">Live Classes</h2><p class="text-muted mb-0">Course sessions, meeting access, and historical recordings for eligible students.</p></div>
        <div class="d-flex gap-2"><a asp-controller="Learning" asp-action="Index" class="btn btn-outline-secondary">Learning</a><button id="liveExport" type="button" class="btn btn-outline-success">Export recordings CSV</button><button id="livePrint" type="button" class="btn btn-outline-primary">Print schedule</button></div>
    </header>
    <div id="liveAlert" class="d-none" role="alert" aria-live="polite" tabindex="-1"></div>
    @if (author)
    {
        <div id="liveLock" class="alert alert-warning" role="status" aria-live="polite">Checking course authoring permissions…</div>
    }
    <section class="card mb-3">
        <div class="card-body row g-2 align-items-end">
            <div class="col-md-9"><label class="form-label" for="liveCourse">Course</label><select id="liveCourse" class="form-select"><option value="">Loading courses…</option></select></div>
            <div class="col-md-3"><button id="liveRefresh" type="button" class="btn btn-outline-primary w-100">Refresh</button></div>
            <div class="col-12 d-flex align-items-center gap-2"><button id="liveCoursePrev" type="button" class="btn btn-outline-secondary btn-sm">Previous courses</button><span id="liveCoursePage" class="small">Page 1</span><button id="liveCourseNext" type="button" class="btn btn-outline-secondary btn-sm">Next courses</button></div>
        </div>
    </section>
    @if (author)
    {
        <form id="liveForm" class="card mb-3">
            <div class="card-header"><h3 class="h6 m-0" id="liveFormTitle">Schedule a class</h3></div>
            <div class="card-body row g-2 align-items-end">
                <div class="col-md-5"><label for="liveTitle" class="form-label">Class title</label><input id="liveTitle" class="form-control" maxlength="200" required /></div>
                @if (manager)
                {
                    <div class="col-md-7"><label for="liveInstructor" class="form-label">Instructor</label><select id="liveInstructor" class="form-select" required><option value="">Choose instructor</option></select></div>
                }
                <div class="col-md-3"><label for="liveStart" class="form-label">Starts (local time)</label><input id="liveStart" type="datetime-local" class="form-control" required /></div>
                <div class="col-md-3"><label for="liveEnd" class="form-label">Ends (local time)</label><input id="liveEnd" type="datetime-local" class="form-control" required /></div>
                <div class="col-md-3"><label for="liveJoin" class="form-label">HTTPS meeting link</label><input id="liveJoin" type="url" pattern="https://.*" maxlength="1000" class="form-control" placeholder="https://…" /></div>
                <div class="col-md-3"><label for="liveRecording" class="form-label">HTTPS recording link</label><input id="liveRecording" type="url" pattern="https://.*" maxlength="1000" class="form-control" /></div>
                <div class="col-12 d-flex gap-2"><button id="liveSave" type="submit" class="btn btn-primary">Save class</button><button id="liveClear" type="button" class="btn btn-outline-secondary">New class</button></div>
                <p class="small text-muted mb-0">Only active instructors with a valid campus assignment and curriculum offering can be scheduled. Sessions may not overlap or exceed four hours. Changes require the latest row version.</p>
            </div>
        </form>
    }
    <section class="card">
        <div class="card-header"><h3 class="h6 m-0">Course schedule</h3></div>
        <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>Class</th><th>Instructor</th><th>Starts</th><th>Ends</th><th>Resources</th><th class="live-actions">Action</th></tr></thead>
            <tbody id="liveRows"><tr><td colspan="6" class="text-muted text-center p-3">Select a course.</td></tr></tbody>
        </table></div>
        <div class="card-footer text-muted small">Schedule: past 30 days through the next 365 days. Student access is restricted by course enrollment, campus and instructor assignment.</div>
    </section>

    @if (author)
    {
        <section class="card mt-3" aria-labelledby="livePendingTitle">
            <div class="card-header d-flex justify-content-between align-items-center gap-2">
                <h3 id="livePendingTitle" class="h6 m-0">Sessions awaiting recording publication</h3>
                <span id="livePendingCount" class="small text-muted" aria-live="polite">0 sessions</span>
            </div>
            <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0">
                <thead><tr><th>Class</th><th>Instructor</th><th>Ended</th><th class="live-actions">Action</th></tr></thead>
                <tbody id="livePendingRows"><tr><td colspan="4" class="text-muted text-center p-3">Select a course.</td></tr></tbody>
            </table></div>
            <div class="card-footer d-flex gap-2 align-items-center">
                <button id="livePendingPrev" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous</button>
                <span id="livePendingPage" class="small">Page 1</span>
                <button id="livePendingNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next</button>
            </div>
        </section>
        <form id="livePublishForm" class="card mt-3 d-none">
            <div class="card-header"><h3 class="h6 m-0">Publish a completed session recording</h3></div>
            <div class="card-body row g-2 align-items-end">
                <div class="col-md-12"><strong id="livePublishClass"></strong></div>
                <div class="col-md-9"><label class="form-label" for="livePublishUrl">HTTPS recording URL</label>
                    <input id="livePublishUrl" class="form-control" type="url" pattern="https://.*" maxlength="1000" required /></div>
                <div class="col-md-3"><button id="livePublishSave" type="submit" class="btn btn-primary w-100">Publish recording</button></div>
                <p class="small text-muted mb-0">Publication is append-only. Once published, the URL cannot be replaced. Completed courses cannot receive new publications.</p>
            </div>
        </form>
    }
    <section class="card mt-3" aria-labelledby="liveRecordingsTitle">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h3 id="liveRecordingsTitle" class="h6 m-0">Historical class recordings</h3>
            <span id="liveRecordingCount" class="small text-muted" aria-live="polite">0 recordings</span>
        </div>
        <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>Class</th><th>Instructor</th><th>Session date</th><th>Recording</th></tr></thead>
            <tbody id="liveRecordingRows"><tr><td colspan="4" class="text-muted text-center p-3">Select a course.</td></tr></tbody>
        </table></div>
        <div class="card-footer d-flex flex-wrap align-items-center gap-2">
            <button id="liveRecordingPrev" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous recordings</button>
            <span id="liveRecordingPage" class="small">Page 1</span>
            <button id="liveRecordingNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next recordings</button>
            <span class="small text-muted ms-auto">Only past sessions with recordings are shown. Completed students retain read-only access to eligible historical classes.</span>
        </div>
    </section>
</section>
<style media="print">.live-actions,#liveForm,#liveRefresh,#livePrint,#liveExport,#liveCoursePrev,#liveCourseNext,#liveRecordingPrev,#liveRecordingNext,#livePendingPrev,#livePendingNext,#livePublishForm,.btn,nav,.sidebar{display:none!important}#liveClassApp{width:100%!important}</style>
@section Scripts { <script src="~/js/learning/live-classes.js" asp-append-version="true"></script> }
