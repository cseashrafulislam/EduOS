@{
    ViewData["Title"] = "Audit Logs";
}
<section class="container-fluid py-3" aria-labelledby="auditTitle">
    <header class="d-flex flex-wrap justify-content-between gap-2 align-items-start mb-3">
        <div>
            <h2 id="auditTitle">Audit Logs</h2>
            <p class="text-muted mb-0">Tenant-scoped system activity. All date filters are UTC.</p>
        </div>
    </header>
    <div id="auditAlert" class="d-none" role="alert" tabindex="-1"></div>
    <section class="card mb-3" aria-labelledby="auditFiltersTitle">
        <div class="card-body">
            <h3 id="auditFiltersTitle" class="h6">Filters</h3>
            <form id="auditFilterForm" class="row g-2 align-items-end">
                <div class="col-sm-6 col-lg-2"><label for="auditFrom" class="form-label">From (UTC)</label><input id="auditFrom" class="form-control" type="date" /></div>
                <div class="col-sm-6 col-lg-2"><label for="auditTo" class="form-label">To (UTC)</label><input id="auditTo" class="form-control" type="date" /></div>
                <div class="col-sm-6 col-lg-2"><label for="auditEntity" class="form-label">Entity name</label><input id="auditEntity" class="form-control" maxlength="120" autocomplete="off" /></div>
                <div class="col-sm-6 col-lg-2"><label for="auditAction" class="form-label">Action</label><select id="auditAction" class="form-select"><option value="">All actions</option><option value="Create">Create</option><option value="Update">Update</option><option value="Delete">Delete</option></select></div>
                <div class="col-sm-6 col-lg-2"><label for="auditUserId" class="form-label">User ID</label><input id="auditUserId" type="number" min="1" step="1" class="form-control" /></div>
                <div class="col-sm-6 col-lg-2"><label for="auditStatus" class="form-label">Outcome</label><select id="auditStatus" class="form-select"><option value="">All</option><option value="true">Success</option><option value="false">Failed</option></select></div>
                <div class="col-12 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">Apply filters</button>
                    <button id="auditClear" type="button" class="btn btn-outline-secondary">Clear</button>
                    <button id="auditExport" type="button" class="btn btn-outline-success">Export filtered CSV (max 1,000)</button>
                </div>
            </form>
        </div>
    </section>
    <section id="auditInsights" class="card mb-3" aria-labelledby="auditStatsTitle">
        <div class="card-body">
            <h3 id="auditStatsTitle" class="h6 mb-1">Activity overview</h3>
            <p class="text-muted small">Uses the same tenant-scoped filters as the activity table. Today, last 7 days and last month are UTC periods.</p>
            <p id="auditStatsStatus" class="small text-muted" role="status" aria-live="polite">Loading overview…</p>
            <div class="row g-2">
                <div class="col-6 col-md-4 col-xl-2"><div class="border rounded p-3 h-100"><div class="small text-muted">Total</div><strong id="auditStatTotal" class="fs-5">—</strong></div></div>
                <div class="col-6 col-md-4 col-xl-2"><div class="border rounded p-3 h-100"><div class="small text-muted">Today</div><strong id="auditStatToday" class="fs-5">—</strong></div></div>
                <div class="col-6 col-md-4 col-xl-2"><div class="border rounded p-3 h-100"><div class="small text-muted">Last 7 days</div><strong id="auditStatWeek" class="fs-5">—</strong></div></div>
                <div class="col-6 col-md-4 col-xl-2"><div class="border rounded p-3 h-100"><div class="small text-muted">Last month</div><strong id="auditStatMonth" class="fs-5">—</strong></div></div>
                <div class="col-6 col-md-4 col-xl-2"><div class="border rounded p-3 h-100"><div class="small text-muted">Successful</div><strong id="auditStatSuccess" class="fs-5">—</strong></div></div>
                <div class="col-6 col-md-4 col-xl-2"><div class="border rounded p-3 h-100"><div class="small text-muted">Failed</div><strong id="auditStatFailed" class="fs-5">—</strong></div></div>
                <div class="col-6 col-md-4 col-xl-2"><div class="border rounded p-3 h-100"><div class="small text-muted">Created</div><strong id="auditStatCreated" class="fs-5">—</strong></div></div>
                <div class="col-6 col-md-4 col-xl-2"><div class="border rounded p-3 h-100"><div class="small text-muted">Updated</div><strong id="auditStatUpdated" class="fs-5">—</strong></div></div>
                <div class="col-6 col-md-4 col-xl-2"><div class="border rounded p-3 h-100"><div class="small text-muted">Deleted</div><strong id="auditStatDeleted" class="fs-5">—</strong></div></div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-lg-6"><h4 class="h6">Most active entities</h4><div class="table-responsive"><table class="table table-sm"><thead><tr><th scope="col">Entity</th><th scope="col" class="text-end">Operations</th></tr></thead><tbody id="auditTopEntities"></tbody></table></div></div>
                <div class="col-lg-6"><h4 class="h6">Most active users</h4><div class="table-responsive"><table class="table table-sm"><thead><tr><th scope="col">User</th><th scope="col" class="text-end">Operations</th></tr></thead><tbody id="auditTopUsers"></tbody></table></div></div>
            </div>
        </div>
    </section>
    <section class="card" aria-labelledby="auditResultsTitle">
        <div class="card-body">
            <div class="d-flex justify-content-between flex-wrap gap-2 mb-2 align-items-center">
                <h3 id="auditResultsTitle" class="h6 mb-0">Activity</h3>
                <span id="auditCount" class="text-muted small" aria-live="polite"></span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr><th>UTC time</th><th>User</th><th>Action</th><th>Entity</th><th>Record</th><th>IP</th><th>Outcome</th></tr></thead>
                    <tbody id="auditRows"><tr><td colspan="7" class="text-center text-muted">Loading…</td></tr></tbody>
                </table>
            </div>
            <nav class="d-flex flex-wrap justify-content-between align-items-center gap-2" aria-label="Audit history pages">
                <button type="button" id="auditPrevious" class="btn btn-outline-secondary btn-sm">Previous</button>
                <span id="auditPage" class="text-muted small" aria-live="polite"></span>
                <button type="button" id="auditNext" class="btn btn-outline-secondary btn-sm">Next</button>
            </nav>
        </div>
    </section>
</section>
@section Scripts {
    <script src="~/js/audit-logs/index.js" asp-append-version="true"></script>
    <script src="~/js/audit-logs/statistics.js" asp-append-version="true"></script>
}
