@{
    ViewData["Title"] = "Audit Logs";
}
<section class="container-fluid py-3" aria-labelledby="auditTitle">
    <header class="d-flex flex-wrap justify-content-between gap-2 align-items-start mb-3">
        <div>
            <h2 id="auditTitle">Audit Logs</h2>
            <p class="text-muted mb-0">Tenant-scoped system activity. All date filters are UTC.</p>
        </div>
    </header>
    <div id="auditAlert" class="d-none" role="alert" tabindex="-1"></div>
    <section class="card mb-3" aria-labelledby="auditFiltersTitle">
        <div class="card-body">
            <h3 id="auditFiltersTitle" class="h6">Filters</h3>
            <form id="auditFilterForm" class="row g-2 align-items-end">
                <div class="col-sm-6 col-lg-2"><label for="auditFrom" class="form-label">From (UTC)</label><input id="auditFrom" class="form-control" type="date" /></div>
                <div class="col-sm-6 col-lg-2"><label for="auditTo" class="form-label">To (UTC)</label><input id="auditTo" class="form-control" type="date" /></div>
                <div class="col-sm-6 col-lg-2"><label for="auditEntity" class="form-label">Entity name</label><input id="auditEntity" class="form-control" maxlength="120" autocomplete="off" /></div>
                <div class="col-sm-6 col-lg-2"><label for="auditAction" class="form-label">Action</label><select id="auditAction" class="form-select"><option value="">All actions</option><option value="Create">Create</option><option value="Update">Update</option><option value="Delete">Delete</option></select></div>
                <div class="col-sm-6 col-lg-2"><label for="auditUserId" class="form-label">User ID</label><input id="auditUserId" type="number" min="1" step="1" class="form-control" /></div>
                <div class="col-sm-6 col-lg-2"><label for="auditStatus" class="form-label">Outcome</label><select id="auditStatus" class="form-select"><option value="">All</option><option value="true">Success</option><option value="false">Failed</option></select></div>
                <div class="col-12 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">Apply filters</button>
                    <button id="auditClear" type="button" class="btn btn-outline-secondary">Clear</button>
                </div>
            </form>
        </div>
    </section>
    <section class="card" aria-labelledby="auditResultsTitle">
        <div class="card-body">
            <div class="d-flex justify-content-between flex-wrap gap-2 mb-2 align-items-center">
                <h3 id="auditResultsTitle" class="h6 mb-0">Activity</h3>
                <span id="auditCount" class="text-muted small" aria-live="polite"></span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr><th>UTC time</th><th>User</th><th>Action</th><th>Entity</th><th>Record</th><th>IP</th><th>Outcome</th></tr></thead>
                    <tbody id="auditRows"><tr><td colspan="7" class="text-center text-muted">Loading…</td></tr></tbody>
                </table>
            </div>
            <nav class="d-flex flex-wrap justify-content-between align-items-center gap-2" aria-label="Audit history pages">
                <button type="button" id="auditPrevious" class="btn btn-outline-secondary btn-sm">Previous</button>
                <span id="auditPage" class="text-muted small" aria-live="polite"></span>
                <button type="button" id="auditNext" class="btn btn-outline-secondary btn-sm">Next</button>
            </nav>
        </div>
    </section>
</section>
@section Scripts {
    <script src="~/js/audit-logs/index.js" asp-append-version="true"></script>
}
