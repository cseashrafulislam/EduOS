@{
    ViewData["Title"] = "Admission Cash Fee Receipts";
}
<section id="admissionCashWorkspace" class="container-fluid py-3">
    <header class="mb-3">
        <h2>Admission application fee · Cash receipt</h2>
        <p class="text-muted">Institution administrator only. A successful BDT cash receipt and its balanced, posted institutional GL journal are saved together. No gateway, bank transfer or subscription payments.</p>
        <a href="/Admissions/Index" class="btn btn-outline-secondary btn-sm">Admission applications</a>
    </header>
    @Html.AntiForgeryToken()
    <div id="admissionCashNotice" class="alert alert-info" role="status" aria-live="polite">Search for an existing admission application.</div>
    <form id="admissionCashSearchForm" class="card card-body mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-9">
                <label class="form-label" for="admissionCashSearch">Application number, applicant name or receipt</label>
                <input id="admissionCashSearch" class="form-control" minlength="2" maxlength="100" autocomplete="off" required />
            </div>
            <div class="col-md-3"><button class="btn btn-primary w-100" type="submit">Find application</button></div>
        </div>
    </form>
    <div class="card card-body mb-3">
        <h3 class="h5">Matching applicants</h3>
        <div class="table-responsive"><table class="table table-sm table-striped align-middle">
            <thead><tr><th>Application</th><th>Applicant</th><th>Campus</th><th>Fee</th><th>Payment</th><th>Action</th></tr></thead>
            <tbody id="admissionCashApplicants"></tbody>
        </table></div>
    </div>
    <div id="admissionCashCollectPanel" class="card card-body mb-3" hidden>
        <h3 class="h5">Collect one-time cash application fee</h3>
        <p id="admissionCashSelected" class="text-muted" aria-live="polite"></p>
        <form id="admissionCashCollectForm">
            <div class="row g-3">
                <div class="col-md-3"><label class="form-label" for="admissionCashDate">Payment date</label>
                    <input id="admissionCashDate" class="form-control" type="date" required /></div>
                <div class="col-md-3"><label class="form-label" for="admissionCashPeriod">Open accounting period</label>
                    <select id="admissionCashPeriod" class="form-select" required></select></div>
                <div class="col-md-3"><label class="form-label" for="admissionCashLedger">Cash-in-hand asset ledger</label>
                    <select id="admissionCashLedger" class="form-select" required></select></div>
                <div class="col-md-3"><label class="form-label" for="admissionIncomeLedger">Admission fee income ledger</label>
                    <select id="admissionIncomeLedger" class="form-select" required></select></div>
            </div>
            <div class="mt-3">
                <button id="admissionCashCollect" class="btn btn-success" type="submit">Collect cash and post GL</button>
                <p class="small text-muted mt-2">The amount is taken from the canonical intake form. The selected period must cover the payment date. This action is irreversible without a controlled accounting reversal.</p>
            </div>
        </form>
    </div>
    <section id="admissionCashReceiptPrint" class="card card-body mb-3" hidden aria-labelledby="admissionCashReceiptHeading">
        <h3 id="admissionCashReceiptHeading" class="h5">Admission fee receipt / ভর্তি ফি রসিদ</h3>
        <dl class="row mb-2">
            <dt class="col-sm-3">Receipt</dt><dd class="col-sm-9" id="cashReceiptNumber"></dd>
            <dt class="col-sm-3">Application</dt><dd class="col-sm-9" id="cashReceiptApplication"></dd>
            <dt class="col-sm-3">Applicant</dt><dd class="col-sm-9" id="cashReceiptApplicant"></dd>
            <dt class="col-sm-3">Campus</dt><dd class="col-sm-9" id="cashReceiptCampus"></dd>
            <dt class="col-sm-3">Date</dt><dd class="col-sm-9" id="cashReceiptDate"></dd>
            <dt class="col-sm-3">Amount</dt><dd class="col-sm-9" id="cashReceiptAmount"></dd>
            <dt class="col-sm-3">Posted journal</dt><dd class="col-sm-9" id="cashReceiptJournal"></dd>
        </dl>
        <button id="admissionCashPrintButton" type="button" class="btn btn-outline-primary d-print-none">Print receipt</button>
    </section>
</section>
<style>
@@media print {
    body * { visibility: hidden !important; }
    #admissionCashReceiptPrint, #admissionCashReceiptPrint * { visibility: visible !important; }
    #admissionCashReceiptPrint { position: absolute; top: 0; left: 0; width: 100%; border: 0 !important; }
}
</style>
@section Scripts {
    <script src="~/js/admissions/cash-receipts.js" asp-append-version="true"></script>
}
