@{ var canManage = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("InventoryManager"); }
<div class="card mb-3"><div class="card-body">
    <h3 class="h5">Asset custody &amp; maintenance</h3>
    <p id="assetSelected" class="text-muted">Select an asset from the register to see its assignments.</p>
    <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Assigned</th><th>Assignee</th><th>Returned</th><th>State</th>@if(canManage){<th>Action</th>}</tr></thead><tbody id="assetHistoryRows"></tbody></table></div>
    <hr /><h4 class="h6">Maintenance history</h4>
    <p class="text-muted small">Completed maintenance entries for the selected asset. Entries are read-only; amounts are in BDT.</p>
    <div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>Date</th><th>Work</th><th>Service provider</th><th>Cost (BDT)</th><th>Next maintenance</th></tr></thead><tbody id="assetMaintenanceHistoryRows"><tr><td colspan="5">Select an asset to view maintenance.</td></tr></tbody></table></div>
    <div class="d-flex gap-2 align-items-center mb-3"><button id="assetMaintenancePrev" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous</button><span id="assetMaintenancePage" aria-live="polite"></span><button id="assetMaintenanceNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next</button></div>
    @if(canManage)
    {
        <form id="assetAssignForm" class="row g-2 mb-3">
            <h4 class="h6">Assign selected asset</h4>
            <div class="col-md-3"><label for="assetAssigneeType" class="form-label">Assignee type</label><select id="assetAssigneeType" class="form-select"><option value="employee">Employee</option><option value="student">Student</option><option value="unit">Organization unit</option></select></div>
            <div class="col-md-5"><label for="assetAssignee" class="form-label">Employee / student reference GUID or unit ID</label><input id="assetAssignee" class="form-control" required /></div>
            <div class="col-md-2"><label for="assetAssignedOn" class="form-label">Date</label><input id="assetAssignedOn" type="date" class="form-control" required /></div>
            <div class="col-md-2 d-flex align-items-end"><button type="submit" class="btn btn-primary">Assign</button></div>
        </form>
        <form id="assetTransferForm" class="row g-2 mb-3 border rounded p-3 d-none">
            <input type="hidden" id="assetTransferAssignmentId" />
            <input type="hidden" id="assetTransferVersion" />
            <div class="col-12 d-flex justify-content-between align-items-center">
                <h4 class="h6 mb-0">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn" ? "সম্পদের দায়িত্ব হস্তান্তর" : "Transfer asset custody")</h4>
                <button type="button" id="assetTransferCancel" class="btn btn-outline-secondary btn-sm">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn" ? "বাতিল" : "Cancel")</button>
            </div>
            <div class="col-md-3"><label for="assetTransferType" class="form-label">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn" ? "নতুন দায়িত্বপ্রাপ্তের ধরন" : "New custodian type")</label>
                <select id="assetTransferType" class="form-select"><option value="employee">Employee</option><option value="student">Student</option><option value="unit">Organization unit</option></select></div>
            <div class="col-md-4"><label for="assetTransferTarget" class="form-label">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn" ? "নতুন দায়িত্বপ্রাপ্তের রেফারেন্স" : "New custodian reference")</label>
                <input id="assetTransferTarget" class="form-control" maxlength="80" required /></div>
            <div class="col-md-2"><label for="assetTransferredOn" class="form-label">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn" ? "হস্তান্তরের তারিখ" : "Transfer date")</label>
                <input id="assetTransferredOn" type="date" class="form-control" required /></div>
            <div class="col-md-3"><label for="assetTransferReason" class="form-label">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn" ? "কারণ" : "Reason")</label>
                <input id="assetTransferReason" class="form-control" maxlength="500" required /></div>
            <div class="col-12"><button id="assetTransferSubmit" type="submit" class="btn btn-primary">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn" ? "হস্তান্তর নিশ্চিত করুন" : "Confirm transfer")</button></div>
        </form>
        <form id="assetMaintenanceForm" class="row g-2">
            <h4 class="h6">Record maintenance for selected asset</h4>
            <div class="col-md-3"><label for="assetMaintenanceDate" class="form-label">Date</label><input id="assetMaintenanceDate" type="date" class="form-control" required /></div>
            <div class="col-md-5"><label for="assetWork" class="form-label">Work performed</label><input id="assetWork" maxlength="200" class="form-control" required /></div>
            <div class="col-md-2"><label for="assetMaintenanceCost" class="form-label">Cost (BDT)</label><input id="assetMaintenanceCost" type="number" min="0" step="0.01" value="0" class="form-control" required /></div>
            <div class="col-md-2"><label for="assetNextMaintenance" class="form-label">Next date</label><input id="assetNextMaintenance" type="date" class="form-control" /></div>
            <div class="col-md-4"><label for="assetProvider" class="form-label">Service provider</label><input id="assetProvider" maxlength="200" class="form-control" /></div>
            <div class="col-md-6"><label for="assetRemarks" class="form-label">Remarks</label><input id="assetRemarks" maxlength="950" class="form-control" /></div>
            <div class="col-md-2 d-flex align-items-end"><button type="submit" class="btn btn-success">Record</button></div>
        </form>
    }
</div></div>
