@{ var canManage = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("InventoryManager"); }
<div class="card mb-3"><div class="card-body">
    <h3 class="h5">Asset register</h3>
    <form id="assetSearchForm" class="row g-2 mb-2"><div class="col-md-9"><label for="assetSearch" class="form-label">Search tag, name or serial</label><input id="assetSearch" maxlength="100" class="form-control" /></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary" type="submit">Search</button></div></form>
    <div class="table-responsive"><table class="table table-striped table-sm"><thead><tr><th>Tag</th><th>Asset</th><th>Category</th><th>Cost (BDT)</th><th>State</th><th>Status</th><th>Actions</th></tr></thead><tbody id="assetRows"></tbody></table></div>
    <div class="d-flex gap-2 align-items-center"><button id="assetPrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button><span id="assetPage"></span><button id="assetNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button></div>
    @if(canManage)
    {
        <hr /><h4 class="h6">Register / edit asset</h4>
        <form id="assetForm" class="row g-2">
            <input id="assetReference" type="hidden" /><input id="assetVersion" type="hidden" />
            <div class="col-md-3"><label for="assetTag" class="form-label">Asset tag</label><input id="assetTag" maxlength="100" class="form-control" required /></div>
            <div class="col-md-5"><label for="assetName" class="form-label">Asset name</label><input id="assetName" maxlength="200" class="form-control" required /></div>
            <div class="col-md-4"><label for="assetCategory" class="form-label">Category</label><select id="assetCategory" class="form-select" required></select></div>
            <div class="col-md-3"><label for="assetCampus" class="form-label">Campus ID (blank: institution-wide)</label><input id="assetCampus" type="number" min="1" class="form-control" /></div>
            <div class="col-md-3"><label for="assetLocation" class="form-label">Location</label><select id="assetLocation" class="form-select"><option value="">None</option></select></div>
            <div class="col-md-3"><label for="assetItem" class="form-label">Inventory item</label><select id="assetItem" class="form-select"><option value="">None</option></select></div>
            <div class="col-md-3"><label for="assetSerial" class="form-label">Serial</label><input id="assetSerial" maxlength="100" class="form-control" /></div>
            <div class="col-md-3"><label for="assetPurchaseDate" class="form-label">Purchase date</label><input id="assetPurchaseDate" type="date" class="form-control" /></div>
            <div class="col-md-3"><label for="assetCost" class="form-label">Purchase cost (BDT)</label><input id="assetCost" type="number" step="0.01" min="0" class="form-control" /></div>
            <div class="col-md-3"><label><input id="assetActive" type="checkbox" checked /> Active</label></div>
            <div class="col-12"><button class="btn btn-success" type="submit">Save asset</button> <button id="assetNew" class="btn btn-outline-secondary" type="button">New asset</button></div>
        </form>
    }
</div></div>
