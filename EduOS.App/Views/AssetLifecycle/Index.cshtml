@{
    ViewData["Title"] = "Fixed Assets";
    var canManage = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("InventoryManager");
    var canCategory = User.IsInRole("TenantAdmin") || User.IsInRole("Principal");
}
<section id="assetWorkspace" class="container-fluid py-3" data-can-manage="@canManage.ToString().ToLowerInvariant()" data-can-category="@canCategory.ToString().ToLowerInvariant()">
    <header class="mb-3"><h2>Fixed Assets &amp; Custody</h2><p class="text-muted">Asset register, assignment, return and maintenance history. Institutional assets are separate from SaaS billing.</p></header>
    <div id="assetAlert" class="d-none" role="alert"></div>
    @await Html.PartialAsync("_Catalog")
    @await Html.PartialAsync("_MaintenanceDue")
    @await Html.PartialAsync("_Custody")
</section>
@section Scripts {
    <script type="module" src="~/js/inventory/assets.js" asp-append-version="true"></script>
}
