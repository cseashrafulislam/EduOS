@{
    ViewData["Title"]="Student Readmission";
    Layout="~/Views/Shared/_Layout.cshtml";
}
<section id="readmissionWorkspace" class="container-fluid py-4">
    @Html.AntiForgeryToken()
    <header class="d-flex justify-content-between align-items-center mb-3">
        <div><h1 class="h4">Student Readmission</h1>
            <p class="text-muted">Re-enroll a previously exited student. Historical enrollments and exits remain unchanged.</p></div>
        <a class="btn btn-outline-secondary" asp-controller="Students" asp-action="Index">Student Directory</a>
    </header>
    <div id="readmissionAlert" class="alert d-none" role="alert" tabindex="-1"></div>
    <div class="row g-3">
        <div class="col-lg-5"><div class="card shadow-sm"><div class="card-body">
            <h2 class="h5">Find student</h2>
            <form id="readmissionSearch" class="input-group mb-3">
                <input id="readmissionQuery" class="form-control" minlength="2" maxlength="100"
                    placeholder="Name or student code" aria-label="Student search" required />
                <button class="btn btn-outline-primary" type="submit">Search</button>
            </form>
            <div id="readmissionMatches" class="list-group"></div>
            <p id="readmissionStudent" class="mt-3 fw-semibold" aria-live="polite"></p>
        </div></div></div>
        <div class="col-lg-7"><div id="readmissionEditor" class="card shadow-sm d-none"><div class="card-body">
            <h2 class="h5">New academic placement</h2>
            <form id="readmissionForm" class="row g-3">
                <div class="col-12"><label for="readmissionBatch" class="form-label">Academic year / batch *</label>
                    <select id="readmissionBatch" class="form-select" required></select></div>
                <div class="col-md-6"><label for="readmissionRoll" class="form-label">New roll *</label>
                    <input id="readmissionRoll" class="form-control" maxlength="50" required /></div>
                <div class="col-12"><label for="readmissionReason" class="form-label">Readmission reason *</label>
                    <textarea id="readmissionReason" class="form-control" rows="3" maxlength="450" required></textarea></div>
                <div class="col-12"><p class="small text-muted">Campus, curriculum, dates, seat capacity, roll and prior exit are validated on the server.</p>
                    <button id="readmissionSubmit" class="btn btn-primary" type="submit">Confirm readmission</button></div>
            </form>
        </div></div></div>
    </div>
</section>
@section Scripts { <script src="~/js/students/readmissions.js" asp-append-version="true"></script> }
