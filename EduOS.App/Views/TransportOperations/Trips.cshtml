@{
    ViewData["Title"] = "Transport trips";
}
<section class="container-fluid py-3" id="transportTrips" aria-labelledby="transportTripsTitle"
    data-can-correct="@(User.IsInRole("TenantAdmin") || User.IsInRole("Principal") ? "true" : "false")">
    <header class="d-flex align-items-center gap-2 mb-3">
        <h1 class="h4 mb-0" id="transportTripsTitle">Trip dispatch / ট্রিপ পরিচালনা</h1>
        <details class="ms-auto">
            <summary class="btn btn-sm btn-outline-secondary" aria-label="Trip dispatch guidance">i</summary>
            <div class="small mt-2" style="max-width:22rem">Plan a vehicle's pickup or drop trip. Dispatch only today's eligible trip after rechecking safety, driver and seats. Record boarding/drop/no-show before closing a trip. Completion locks attendance and preserves the frozen manifest. / উপস্থিতি শেষে ট্রিপ বন্ধ করুন; রেকর্ড অপরিবর্তিত থাকবে।</div>
        </details>
    </header>
    <p id="tripStatus" role="status" aria-live="polite" class="small text-muted"></p>
    <form id="tripPlanForm" class="row g-2 mb-3">
        @Html.AntiForgeryToken()
        <div class="col-sm-4 col-lg-3"><label for="tripDate" class="form-label">Date / তারিখ</label><input id="tripDate" class="form-control" type="date" required /></div>
        <div class="col-sm-4 col-lg-3"><label for="tripRoute" class="form-label">Route / রুট</label><select id="tripRoute" class="form-select" required><option value="">Loading…</option></select></div>
        <div class="col-sm-4 col-lg-3"><label for="tripVehicle" class="form-label">Vehicle / গাড়ি</label><select id="tripVehicle" class="form-select" required><option value="">Loading…</option></select></div>
        <div class="col-sm-4 col-lg-2"><label for="tripDirection" class="form-label">Direction / দিক</label><select id="tripDirection" class="form-select"><option value="Pickup">Pickup / উঠানো</option><option value="Drop">Drop / নামানো</option></select></div>
        <div class="col-sm-4 col-lg-1 d-flex align-items-end"><button id="tripPlan" class="btn btn-primary w-100" type="submit">Plan</button></div>
    </form>
    <div class="row g-2 align-items-end mb-3" aria-label="Schedule service dates">
        <div class="col-sm-4 col-lg-3">
            <label class="form-label" for="tripScheduleEnd">Schedule through / শেষ তারিখ</label>
            <input class="form-control" id="tripScheduleEnd" type="date" required />
        </div>
        <div class="col-sm-4 col-lg-3">
            <div class="form-check">
                <input class="form-check-input" id="tripScheduleWeekend" type="checkbox" />
                <label class="form-check-label" for="tripScheduleWeekend">Skip Fri–Sat / শুক্র–শনি বাদ</label>
            </div>
        </div>
        <div class="col-sm-4 col-lg-3">
            <div class="form-check">
                <input class="form-check-input" id="tripScheduleAcademicCalendar" type="checkbox" />
                <label class="form-check-label" for="tripScheduleAcademicCalendar">Use campus calendar / ক্যাম্পাস ক্যালেন্ডার</label>
            </div>
        </div>
        <div class="col-sm-4 col-lg-3">
            <button id="tripSchedule" class="btn btn-outline-primary w-100" type="button">Schedule 1–7 days / সূচি তৈরি</button>
        </div>
        <div class="col-12"><span id="tripCalendarStatus" role="status" aria-live="polite" class="small text-muted"></span></div>
    </div>
    <div class="d-flex gap-2 mb-2"><button id="tripReload" class="btn btn-outline-primary btn-sm" type="button">Refresh / রিফ্রেশ</button></div>
    <div class="table-responsive"><table class="table table-sm table-hover align-middle">
        <thead><tr><th>Campus</th><th>Route</th><th>Vehicle</th><th>Date</th><th>Direction</th><th>Status</th><th>Riders</th><th>Action</th></tr></thead>
        <tbody id="tripRows"></tbody>
    </table></div>
    <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
        <button id="tripPrev" class="btn btn-outline-secondary btn-sm" type="button">Previous</button>
        <span id="tripPage" class="small text-muted"></span>
        <button id="tripNext" class="btn btn-outline-secondary btn-sm" type="button">Next</button>
    </div>
    <section id="tripManifestPanel" hidden aria-labelledby="tripManifestTitle">
        <h2 id="tripManifestTitle" class="h5">Frozen rider manifest / যাত্রী তালিকা</h2>
        <div class="d-flex gap-2 mb-2"><button id="tripExport" class="btn btn-outline-primary btn-sm" type="button">CSV</button><button id="tripMarkRemainingNoShow" class="btn btn-outline-warning btn-sm" type="button" hidden>Mark awaiting NoShow / অবশিষ্ট অনুপস্থিত</button><button id="tripPrint" class="btn btn-outline-secondary btn-sm" type="button">Print full manifest / সম্পূর্ণ প্রিন্ট</button>@if (User.IsInRole("TenantAdmin") || User.IsInRole("Principal")) { <button id="tripAudit" class="btn btn-outline-secondary btn-sm" type="button">Attendance audit / উপস্থিতি নিরীক্ষা</button> }</div>
        <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Student code</th><th>Pickup</th><th>Drop</th><th>Attendance / উপস্থিতি</th><th>Action / কার্যক্রম</th></tr></thead><tbody id="tripManifestRows"></tbody></table></div>
        <div class="d-flex gap-2 align-items-center"><button id="tripRiderPrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button><span id="tripRiderPage" class="small text-muted"></span><button id="tripRiderNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button></div>
    </section>
    @if (User.IsInRole("TenantAdmin") || User.IsInRole("Principal"))
    {
        <dialog id="tripAuditDialog" class="border rounded shadow p-3" aria-labelledby="tripAuditTitle" style="width:min(96vw,70rem);max-height:90vh">
            <h2 id="tripAuditTitle" class="h5">Attendance event audit / উপস্থিতির নিরীক্ষা</h2>
            <p id="tripAuditStatus" class="small text-muted" role="status" aria-live="polite"></p>
            <div class="d-flex flex-wrap gap-2 mb-2">
                <button id="tripAuditExport" class="btn btn-outline-primary btn-sm" type="button">Full CSV / সম্পূর্ণ CSV</button>
                <button id="tripAuditPrint" class="btn btn-outline-secondary btn-sm" type="button">Print full audit / সম্পূর্ণ প্রিন্ট</button>
                <button id="tripAuditClose" class="btn btn-outline-secondary btn-sm ms-auto" type="button">Close / বন্ধ</button>
            </div>
            <div class="table-responsive"><table class="table table-sm">
                <thead><tr><th>Student</th><th>Seq.</th><th>Event</th><th>Corrected from</th><th>Reason / কারণ</th><th>Recorded UTC</th><th>Actor ID</th></tr></thead>
                <tbody id="tripAuditRows"></tbody>
            </table></div>
            <div class="d-flex justify-content-between align-items-center gap-2">
                <button id="tripAuditPrev" class="btn btn-outline-secondary btn-sm" type="button">Previous</button>
                <span id="tripAuditPage" class="small text-muted"></span>
                <button id="tripAuditNext" class="btn btn-outline-secondary btn-sm" type="button">Next</button>
            </div>
        </dialog>
    }
    <dialog id="tripCorrectionDialog" class="border rounded shadow p-3" aria-labelledby="tripCorrectionTitle" style="width:min(95vw,30rem)">
        <form id="tripCorrectionForm">
            <h2 id="tripCorrectionTitle" class="h5">Correct attendance / উপস্থিতি সংশোধন</h2>
            <p id="tripCorrectionStudent" class="small fw-semibold"></p>
            <p id="tripCorrectionState" class="small text-muted"></p>
            <label for="tripCorrectionReason" class="form-label">Reason / কারণ (15–500)</label>
            <textarea id="tripCorrectionReason" class="form-control" required minlength="15" maxlength="500" rows="3"></textarea>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button id="tripCorrectionCancel" class="btn btn-outline-secondary" type="button">Cancel / বাতিল</button>
                <button class="btn btn-primary" type="submit">Save correction / সংরক্ষণ</button>
            </div>
        </form>
    </dialog>
</section>
@section Scripts {
    <script src="~/js/transport-operations/session-guard.js" asp-append-version="true"></script>
    <script src="~/js/transport-operations/trips.js" asp-append-version="true"></script>
}
