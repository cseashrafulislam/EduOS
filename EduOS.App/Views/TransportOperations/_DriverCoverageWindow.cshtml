<section class="card mb-3" id="transportDriverCoverageWindowPanel"><div class="card-body">
    <h3 class="h5">Multi-day driver coverage and dispatch gaps</h3>
    <p class="small text-muted">Tenant administrators only. Review every day in a future 1–30 day window, including non-peak gaps. Read-only planning: no driver names, license numbers, student identities or fares.</p>
    <form id="transportDriverCoverageWindowFilters" class="row g-2 mb-2">
        <div class="col-md-2"><label for="transportDriverCoverageWindowFrom" class="form-label">From</label><input id="transportDriverCoverageWindowFrom" class="form-control" type="date" required /></div>
        <div class="col-md-2"><label for="transportDriverCoverageWindowTo" class="form-label">To</label><input id="transportDriverCoverageWindowTo" class="form-control" type="date" required /></div>
        <div class="col-md-3"><label for="transportDriverCoverageWindowCampus" class="form-label">Campus</label><select id="transportDriverCoverageWindowCampus" class="form-select"><option value="">All campuses</option></select></div>
        <div class="col-md-3"><label for="transportDriverCoverageWindowSearch" class="form-label">Vehicle / campus</label><input id="transportDriverCoverageWindowSearch" class="form-control" type="search" maxlength="100" /></div>
        <div class="col-md-2"><label for="transportDriverCoverageWindowAttention" class="form-label">View</label><select id="transportDriverCoverageWindowAttention" class="form-select"><option value="true">Needs attention</option><option value="false">All vehicles</option></select></div>
        <div class="col-12 d-flex gap-2"><button type="submit" class="btn btn-outline-primary">Check window</button><button id="transportDriverCoverageWindowExport" class="btn btn-outline-success" type="button" disabled>Export CSV</button></div>
    </form>
    <div id="transportDriverCoverageWindowStatus" class="small text-muted mb-2" role="status" aria-live="polite">Loading…</div>
    <div class="table-responsive"><table class="table table-sm table-hover align-middle">
        <thead><tr><th>Campus</th><th>Vehicle</th><th>Peak reserved / seats</th><th>Peak date</th><th>Min free</th><th>Risk days</th><th>First risk date</th><th>First issue</th></tr></thead>
        <tbody id="transportDriverCoverageWindowRows"><tr><td colspan="8">Loading…</td></tr></tbody>
    </table></div>
    <div class="d-flex align-items-center justify-content-between gap-2">
        <button id="transportDriverCoverageWindowPrev" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous</button>
        <span id="transportDriverCoverageWindowPage" class="small text-muted"></span>
        <button id="transportDriverCoverageWindowNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next</button>
    </div>
</div></section>
