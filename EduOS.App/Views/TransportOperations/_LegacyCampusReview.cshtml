<section class="card mb-3" id="transportLegacyCampusPanel">
    <div class="card-body">
        <h3 class="h5">Historical route and vehicle campus review</h3>
        <p class="text-muted small">Institution administrators can review records created before campus assignment was required. Only records with no historical rider, route/vehicle or driver links can be assigned here. Linked records require separate Platform and Finance reconciliation; no campus is inferred automatically.</p>
        @Html.AntiForgeryToken()
        <div id="transportLegacyCampusAlert" class="d-none" role="status" aria-live="polite"></div>
        <div class="d-flex flex-wrap align-items-end gap-2 mb-3">
            <div><label class="form-label" for="transportLegacyTargetCampus">Approved target campus</label><select id="transportLegacyTargetCampus" class="form-select"><option value="">Loading campuses…</option></select></div>
            <button type="button" id="transportLegacyRefresh" class="btn btn-outline-primary">Refresh review</button>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead><tr><th>Record type</th><th>Route / vehicle</th><th>Historical links</th><th>Decision</th></tr></thead>
                <tbody id="transportLegacyRows"><tr><td colspan="4">Loading historical records…</td></tr></tbody>
            </table>
        </div>
        <p id="transportLegacyLimitNote" class="small text-muted mb-0"></p>
    </div>
</section>
