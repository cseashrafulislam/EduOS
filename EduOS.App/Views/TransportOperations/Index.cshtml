@{
    ViewData["Title"] = "Transport";
    var canManage = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("TransportManager");
}
<section class="container-fluid py-3" aria-labelledby="transportTitle">
    <header class="mb-3"><h2 id="transportTitle">Transport operations</h2><p class="text-muted">Routes, vehicles and student transport assignments.</p></header>
    <div id="transportAlert" class="d-none" role="alert" tabindex="-1"></div>
    <section class="card mb-3"><div class="card-body">
        <h3 class="h5">My current assignment</h3><div id="transportMine" class="text-muted">Loading…</div>
    </div></section>
    @if (canManage)
    {
    <section class="card mb-3"><div class="card-body">
        <h3 class="h5">Available routes and vehicles</h3>
        <div class="row g-3">
            <div class="col-lg-6"><h4 class="h6">Routes</h4><ul id="transportRouteList" class="list-group"><li class="list-group-item">Loading routes…</li></ul></div>
            <div class="col-lg-6"><h4 class="h6">Vehicles</h4><ul id="transportVehicleList" class="list-group"><li class="list-group-item">Loading vehicles…</li></ul></div>
        </div>
    </div></section>
    }
    @if (canManage)
    {
    <section class="card mb-3" id="transportRouteSetupPanel"><div class="card-body">
        <h3 class="h5">Route and ordered stop setup</h3>
        <p class="text-muted small">Create a campus-scoped route and its ordered stops. Activate or deactivate routes in the inventory; routes with active riders or vehicle assignments cannot be retired. Finance manages fares separately.</p>
        <div id="transportRouteSetupAlert" class="d-none" role="alert" tabindex="-1"></div>
        <form id="transportRouteSetupForm" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-4"><label for="transportRouteSetupCampus" class="form-label">Campus</label><select id="transportRouteSetupCampus" class="form-select" required><option value="">Loading…</option></select></div>
            <div class="col-md-4"><label for="transportRouteSetupName" class="form-label">Route name</label><input id="transportRouteSetupName" class="form-control" maxlength="150" required /></div>
            <div class="col-md-4"><label for="transportRouteSetupCode" class="form-label">Route code</label><input id="transportRouteSetupCode" class="form-control" maxlength="50" required /></div>
            <div class="col-12"><label for="transportRouteSetupStops" class="form-label">Stops in travel order (one per line)</label><textarea id="transportRouteSetupStops" class="form-control" rows="4" maxlength="7550" required placeholder="Main gate&#10;City centre&#10;North stop"></textarea></div>
            <div class="col-12"><button id="transportRouteSetupSave" type="submit" class="btn btn-primary">Create route with stops</button></div>
        </form>
        <hr />
        <h4 class="h6">Campus route inventory</h4>
        <form id="transportRouteSetupSearchForm" class="row g-2 mb-2">
            <div class="col-md-4"><label for="transportRouteSetupFilterCampus" class="visually-hidden">Filter campus</label><select id="transportRouteSetupFilterCampus" class="form-select"><option value="">All authorized campuses</option></select></div>
            <div class="col-md-6"><label for="transportRouteSetupSearch" class="visually-hidden">Search routes</label><input id="transportRouteSetupSearch" class="form-control" maxlength="100" placeholder="Search route name or code" /></div>
            <div class="col-md-2"><button type="submit" class="btn btn-outline-primary w-100">Search</button></div>
        </form>
        <div class="table-responsive"><table class="table table-sm table-hover"><thead><tr><th>Campus</th><th>Code</th><th>Route</th><th>Stops</th><th>Status</th></tr></thead><tbody id="transportRouteSetupRows"><tr><td colspan="5">Loading…</td></tr></tbody></table></div>
        <div class="d-flex align-items-center justify-content-between gap-2">
            <button id="transportRouteSetupPrev" class="btn btn-outline-secondary btn-sm" type="button">Previous</button>
            <span id="transportRouteSetupPageInfo" class="small text-muted"></span>
            <button id="transportRouteSetupNext" class="btn btn-outline-secondary btn-sm" type="button">Next</button>
        </div>
    </div></section>
    }
    @if (canManage) { <partial name="_VehicleSetup" /> }
    @if (canManage) { <partial name="_RouteVehicleLinks" /> }
    @if (canManage) { <partial name="_StopDemand" /> <partial name="_RiderReadiness" /> <partial name="_CapacityReport" /> <partial name="_SeatForecast" /> <partial name="_FleetInsights" /> }
    @if (User.IsInRole("TenantAdmin")) { <partial name="_DriverRegistry" /> <partial name="_DriverLicenseCompliance" /> <partial name="_DriverReadiness" /> <partial name="_VehicleDriverLinks" /> }
    @if (canManage)
    {
        <section class="card mb-3"><div class="card-body">
            <h3 class="h5">Assign transport</h3>
            <form id="transportAssignmentForm" class="row g-3">
                <div class="col-md-7"><label class="form-label" for="transportStudentSearch">Search eligible students</label><input id="transportStudentSearch" class="form-control" type="search" placeholder="Name or student code" maxlength="100" /></div>
                <div class="col-md-5 d-flex align-items-end gap-2"><button id="transportFindStudents" type="button" class="btn btn-outline-primary">Find</button><button id="transportMoreStudents" type="button" class="btn btn-outline-secondary">Next page</button></div>
                <div class="col-md-12"><label class="form-label" for="transportStudent">Student enrollment</label><select id="transportStudent" class="form-select" required><option value="">Search eligible students</option></select></div>
                <div class="col-md-6"><label class="form-label" for="transportRoute">Route</label><select id="transportRoute" class="form-select" required><option value="">Select route</option></select></div>
                <div class="col-md-6"><label class="form-label" for="transportVehicle">Vehicle</label><select id="transportVehicle" class="form-select" required><option value="">Select vehicle</option></select></div>
                <div class="col-md-6"><label class="form-label" for="transportPickup">Pickup stop</label><select id="transportPickup" class="form-select"><option value="">No assigned pickup stop</option></select></div>
                <div class="col-md-6"><label class="form-label" for="transportDrop">Drop stop</label><select id="transportDrop" class="form-select"><option value="">No assigned drop stop</option></select></div>
                <div class="col-md-6"><label class="form-label" for="transportStart">Start date</label><input id="transportStart" type="date" class="form-control" required /></div>
                <div class="col-md-6"><label class="form-label" for="transportEnd">End date (optional)</label><input id="transportEnd" type="date" class="form-control" aria-describedby="transportEndHelp" /><small id="transportEndHelp" class="text-muted">Leave blank for open-ended service; the route-vehicle link must also be open-ended.</small></div>
                <div class="col-md-6"><label class="form-label" for="transportFare">Monthly fare (optional)</label><input id="transportFare" type="number" step="0.01" min="0" class="form-control" placeholder="Use route default" /></div>
                <div class="col-12"><button id="transportSave" class="btn btn-primary" type="submit">Assign transport</button></div>
            </form>
            <p class="small text-muted mb-0 mt-2">Only active enrolments are selectable. The server validates route, vehicle assignment, stop, campus and capacity before saving.</p>
        </div></section>
        <section class="card"><div class="card-body">
            <h3 class="h5">Active assignments</h3>
            <form id="transportActiveSearch" class="d-flex gap-2">
                <input id="transportActiveTerm" class="form-control" maxlength="100" placeholder="Search student" />
                <button type="submit" class="btn btn-outline-primary">Search</button>
            </form>
            <div class="table-responsive mt-3"><table class="table table-hover align-middle">
                <thead><tr><th>Student</th><th>Route</th><th>Vehicle</th><th>Start</th><th>End</th><th>Action</th></tr></thead>
                <tbody id="transportActiveRows"><tr><td colspan="6">Loading…</td></tr></tbody>
            </table></div>
            <div class="d-flex gap-3 align-items-center justify-content-between">
                <button id="transportPrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
                <span id="transportPageInfo" class="small text-muted"></span>
                <button id="transportNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
            </div>
        </div></section>
        <section id="transportUpcomingStartPanel" class="card mt-3" hidden><div class="card-body">
            <h3 class="h5">Reschedule upcoming rider start</h3>
            <p id="transportUpcomingStartDetails" class="text-muted small"></p>
            <form id="transportUpcomingStartForm" class="row g-2">
                <div class="col-md-6"><label for="transportUpcomingStartDate" class="form-label">New start date</label>
                    <input id="transportUpcomingStartDate" type="date" class="form-control" required /></div>
                <div class="col-md-6 d-flex align-items-end gap-2">
                    <button id="transportUpcomingStartSave" class="btn btn-primary" type="submit">Reschedule</button>
                    <button id="transportUpcomingStartCancel" class="btn btn-outline-secondary" type="button">Cancel</button>
                </div>
            </form>
            <p class="small text-muted mt-2 mb-0">Pre-start reservations only. Existing route, vehicle, stops, end date and fare remain unchanged. Availability and capacity are checked again.</p>
        </div></section>
        <section id="transportUpcomingRiderExtensionPanel" class="card mt-3" hidden><div class="card-body">
            <h3 class="h5">Extend scheduled rider reservation</h3>
            <p id="transportUpcomingRiderExtensionDetails" class="text-muted small"></p>
            <form id="transportUpcomingRiderExtensionForm" class="row g-2">
                <div class="col-md-6"><label for="transportUpcomingRiderExtensionDate" class="form-label">New reservation end date</label>
                    <input id="transportUpcomingRiderExtensionDate" type="date" class="form-control" required /></div>
                <div class="col-md-6 d-flex align-items-end gap-2">
                    <button id="transportUpcomingRiderExtensionSave" type="submit" class="btn btn-primary">Extend scheduled end</button>
                    <button id="transportUpcomingRiderExtensionCancel" type="button" class="btn btn-outline-secondary">Cancel</button>
                </div>
            </form>
            <p class="small text-muted mt-2 mb-0">Future, finite reservations only. Route, vehicle, stops and monthly fare stay unchanged; campus, route pairing, enrollment and seat capacity are revalidated.</p>
        </div></section>
        <section id="transportNoChargeShorteningPanel" class="card mt-3" hidden><div class="card-body">
            <h3 class="h5">Shorten scheduled no-charge rider reservation</h3>
            <p id="transportNoChargeShorteningDetails" class="text-muted small"></p>
            <form id="transportNoChargeShorteningForm" class="row g-2">
                <div class="col-md-6"><label for="transportNoChargeShorteningDate" class="form-label">New reservation end date</label>
                    <input id="transportNoChargeShorteningDate" type="date" class="form-control" required /></div>
                <div class="col-md-6 d-flex align-items-end gap-2">
                    <button id="transportNoChargeShorteningSave" type="submit" class="btn btn-primary">Shorten scheduled end</button>
                    <button id="transportNoChargeShorteningCancel" type="button" class="btn btn-outline-secondary">Cancel</button>
                </div>
            </form>
            <p class="small text-muted mt-2 mb-0">Future, zero-fare, finite reservations only. Shortening releases seat-days. Charged changes require Finance approval.</p>
        </div></section>
        <section id="transportRiderExtensionPanel" class="card mt-3" hidden><div class="card-body">
            <h3 class="h5">Extend operating rider reservation</h3>
            <p id="transportRiderExtensionDetails" class="text-muted small"></p>
            <form id="transportRiderExtensionForm" class="row g-2">
                <div class="col-md-6"><label for="transportRiderExtensionDate" class="form-label">New reservation end date</label>
                    <input id="transportRiderExtensionDate" type="date" class="form-control" required /></div>
                <div class="col-md-6 d-flex align-items-end gap-2">
                    <button id="transportRiderExtensionSave" type="submit" class="btn btn-primary">Extend reservation</button>
                    <button id="transportRiderExtensionCancel" type="button" class="btn btn-outline-secondary">Cancel</button>
                </div>
            </form>
            <p class="small text-muted mt-2 mb-0">The route, vehicle, stops and monthly fare stay unchanged. Campus, pairing dates and peak seat capacity are revalidated.</p>
        </div></section>
        <section id="transportStopCorrectionPanel" class="card mt-3" hidden><div class="card-body">
            <h3 class="h5" id="transportStopCorrectionTitle">Correct rider stops</h3>
            <p id="transportStopCorrectionDetails" class="text-muted small"></p>
            <form id="transportStopCorrectionForm" class="row g-2">
                <div class="col-md-5"><label for="transportCorrectPickup" class="form-label">Pickup stop</label><select id="transportCorrectPickup" class="form-select"></select></div>
                <div class="col-md-5"><label for="transportCorrectDrop" class="form-label">Drop stop</label><select id="transportCorrectDrop" class="form-select"></select></div>
                <div class="col-md-2 d-flex align-items-end gap-2"><button id="transportCorrectSave" class="btn btn-primary" type="submit">Save</button><button id="transportCorrectCancel" class="btn btn-outline-secondary" type="button">Cancel</button></div>
            </form>
            <p class="small text-muted mt-2 mb-0" id="transportStopCorrectionHelp">For future or currently operating assignments. Route, vehicle and monthly fare remain unchanged; campus, stops and capacity are revalidated.</p>
        </div></section>
        <section id="transportOperatingTransferPanel" class="card mt-3" hidden><div class="card-body">
            <h3 class="h5">Transfer an operating rider to another vehicle</h3>
            <p id="transportOperatingTransferDetails" class="small text-muted"></p>
            <form id="transportOperatingTransferForm" class="row g-2">
                <div class="col-md-4"><label for="transportOperatingTransferDate" class="form-label">Effective date</label>
                    <input id="transportOperatingTransferDate" type="date" class="form-control" required /></div>
                <div class="col-md-5"><label for="transportOperatingTransferVehicle" class="form-label">Available destination vehicle</label>
                    <select id="transportOperatingTransferVehicle" class="form-select" required></select></div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button id="transportOperatingTransferSave" type="submit" class="btn btn-primary">Transfer</button>
                    <button id="transportOperatingTransferCancel" type="button" class="btn btn-outline-secondary">Cancel</button>
                </div>
            </form>
            <div class="d-flex align-items-center gap-3 mt-2">
                <button id="transportOperatingTransferPrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
                <span id="transportOperatingTransferPageInfo" class="small text-muted"></span>
                <button id="transportOperatingTransferNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
            </div>
            <p class="small text-muted mt-2 mb-0">Same route and stops, unchanged monthly fare. Original reservation ends the day before transfer; destination reservation begins on the effective date. No ledger writes.</p>
        </div></section>
        <section id="transportVehicleChangePanel" class="card mt-3" hidden><div class="card-body">
            <h3 class="h5">Change vehicle for upcoming rider</h3>
            <p id="transportVehicleChangeDetails" class="text-muted small"></p>
            <form id="transportVehicleChangeForm" class="row g-2">
                <div class="col-md-8"><label for="transportVehicleChangeChoice" class="form-label">Available vehicles on this route</label>
                    <select id="transportVehicleChangeChoice" class="form-select" required></select></div>
                <div class="col-md-4 d-flex align-items-end gap-2"><button id="transportVehicleChangeSave" class="btn btn-primary" type="submit">Change vehicle</button>
                    <button id="transportVehicleChangeCancel" class="btn btn-outline-secondary" type="button">Cancel</button></div>
            </form>
            <div class="d-flex align-items-center gap-3 mt-2">
                <button id="transportVehicleChangePrev" type="button" class="btn btn-outline-secondary btn-sm">Previous vehicles</button>
                <span id="transportVehicleChangePageInfo" class="small text-muted"></span>
                <button id="transportVehicleChangeNext" type="button" class="btn btn-outline-secondary btn-sm">Next vehicles</button>
            </div>
            <p class="small text-muted mt-2 mb-0">Only future reservations. Route, pickup/drop stops and monthly fare are unchanged; seat capacity is rechecked when saving.</p>
        </div></section>
    }
    @if (canManage) {
        <section class="card mt-3" aria-labelledby="transportUpcomingCancelTitle"><div class="card-body">
            <h3 id="transportUpcomingCancelTitle" class="h5">Cancel upcoming transport reservations</h3>
            <p class="small text-muted">Only reservations starting after today are shown. Cancelling releases the reserved seat; no fares or payments are modified.</p>
            <form id="transportUpcomingCancelSearch" class="d-flex gap-2">
                <label class="visually-hidden" for="transportUpcomingCancelTerm">Search upcoming reservations</label>
                <input id="transportUpcomingCancelTerm" class="form-control" maxlength="100" placeholder="Search student or route" />
                <button type="submit" class="btn btn-outline-primary">Search</button>
            </form>
            <div class="table-responsive mt-3"><table class="table table-sm table-hover align-middle">
                <thead><tr><th>Student</th><th>Campus</th><th>Route</th><th>Vehicle</th><th>Starts</th><th>Action</th></tr></thead>
                <tbody id="transportUpcomingCancelRows"><tr><td colspan="6">Loading…</td></tr></tbody>
            </table></div>
            <div class="d-flex justify-content-between align-items-center gap-2">
                <button id="transportUpcomingCancelPrev" class="btn btn-outline-secondary btn-sm" type="button">Previous</button>
                <span id="transportUpcomingCancelPageInfo" class="small text-muted"></span>
                <button id="transportUpcomingCancelNext" class="btn btn-outline-secondary btn-sm" type="button">Next</button>
            </div>
        </div></section>
    }
    @if (canManage) { <partial name="_AssignmentHistory" /> <partial name="_RiderTurnover" /> }
</section>
@section Scripts {
    <script src="~/js/transport-operations/index.js" asp-append-version="true"></script>
    @if (canManage) { <script src="~/js/transport-operations/upcoming-cancellation.js" asp-append-version="true"></script> }
    @if (canManage) { <script src="~/js/transport-operations/upcoming-vehicle-change.js" asp-append-version="true"></script> }
    @if (canManage) { <script src="~/js/transport-operations/upcoming-start-reschedule.js" asp-append-version="true"></script> }
    @if (canManage) { <script src="~/js/transport-operations/upcoming-rider-extension.js" asp-append-version="true"></script> }
    @if (canManage) { <script src="~/js/transport-operations/upcoming-no-charge-shortening.js" asp-append-version="true"></script> }
    @if (canManage) { <script src="~/js/transport-operations/operating-vehicle-transfer.js" asp-append-version="true"></script> }
    @if (canManage) { <script src="~/js/transport-operations/assignment-history.js" asp-append-version="true"></script> }
    @if (canManage) { <script src="~/js/transport-operations/rider-turnover.js" asp-append-version="true"></script> }
    @if (canManage) { <script src="~/js/transport-operations/rider-readiness.js" asp-append-version="true"></script> }
    <script src="~/js/transport-operations/route-setup.js" asp-append-version="true"></script>
    <script src="~/js/transport-operations/vehicle-setup.js" asp-append-version="true"></script>
    <script src="~/js/transport-operations/route-vehicle-core.js" asp-append-version="true"></script>
    <script src="~/js/transport-operations/route-vehicle-catalog.js" asp-append-version="true"></script>
    <script src="~/js/transport-operations/route-vehicle-campuses.js" asp-append-version="true"></script>
    <script src="~/js/transport-operations/route-vehicle-choices.js" asp-append-version="true"></script>
    <script src="~/js/transport-operations/route-vehicle-create.js" asp-append-version="true"></script>
    <script src="~/js/transport-operations/route-vehicle-render.js" asp-append-version="true"></script>
    <script src="~/js/transport-operations/route-vehicle-close.js" asp-append-version="true"></script>
    <script src="~/js/transport-operations/route-vehicle-extend.js" asp-append-version="true"></script>
    <script src="~/js/transport-operations/route-vehicle-upcoming-extend.js" asp-append-version="true"></script>
    <script src="~/js/transport-operations/route-vehicle-reschedule.js" asp-append-version="true"></script>
    <script src="~/js/transport-operations/route-vehicle-upcoming-change.js" asp-append-version="true"></script>

    <script src="~/js/transport-operations/route-vehicle-cancel.js" asp-append-version="true"></script>
    <script src="~/js/transport-operations/route-vehicle-list.js" asp-append-version="true"></script>
    <script src="~/js/transport-operations/stop-demand.js" asp-append-version="true"></script>
    <script src="~/js/transport-operations/capacity-report.js" asp-append-version="true"></script>
    @if (canManage) { <script src="~/js/transport-operations/seat-forecast.js" asp-append-version="true"></script> }
    <script src="~/js/transport-operations/fleet-insights.js" asp-append-version="true"></script>
    @if (User.IsInRole("TenantAdmin")) { <script src="~/js/transport-operations/driver-registry.js" asp-append-version="true"></script> }
    @if (User.IsInRole("TenantAdmin")) { <script src="~/js/transport-operations/driver-license-compliance.js" asp-append-version="true"></script> }
    @if (User.IsInRole("TenantAdmin")) { <script src="~/js/transport-operations/driver-readiness.js" asp-append-version="true"></script> }
    @if (User.IsInRole("TenantAdmin")) { <script src="~/js/transport-operations/vehicle-driver-core.js" asp-append-version="true"></script> }
    @if (User.IsInRole("TenantAdmin")) { <script src="~/js/transport-operations/vehicle-driver-options.js" asp-append-version="true"></script> }
    @if (User.IsInRole("TenantAdmin")) { <script src="~/js/transport-operations/vehicle-driver-reschedule.js" asp-append-version="true"></script> }
    @if (User.IsInRole("TenantAdmin")) { <script src="~/js/transport-operations/vehicle-driver-upcoming-extend.js" asp-append-version="true"></script> }
    @if (User.IsInRole("TenantAdmin")) { <script src="~/js/transport-operations/vehicle-driver-upcoming-change.js" asp-append-version="true"></script> }
    @if (User.IsInRole("TenantAdmin")) { <script src="~/js/transport-operations/vehicle-driver-list.js" asp-append-version="true"></script> }
    @if (User.IsInRole("TenantAdmin")) { <script src="~/js/transport-operations/vehicle-driver-create.js" asp-append-version="true"></script> }
    @if (User.IsInRole("TenantAdmin")) { <script src="~/js/transport-operations/vehicle-driver-replace-options.js" asp-append-version="true"></script> }
    @if (User.IsInRole("TenantAdmin")) { <script src="~/js/transport-operations/vehicle-driver-replace.js" asp-append-version="true"></script> }
    @if (User.IsInRole("TenantAdmin")) { <script src="~/js/transport-operations/vehicle-driver-replace-submit.js" asp-append-version="true"></script> }
    @if (User.IsInRole("TenantAdmin")) { <script src="~/js/transport-operations/vehicle-driver-init.js" asp-append-version="true"></script> }
}
