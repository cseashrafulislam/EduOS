<section class="card mb-3" id="transportRiderReadinessPanel"><div class="card-body">
    <h3 class="h5">Rider assignment readiness</h3>
    <p class="small text-muted">Review active and upcoming transport assignments with invalid enrollment, route, vehicle, pickup/drop stops or effective route-vehicle linkage. Only opaque assignment references are shown; no student identity or fare data. A snapshot does not replace dispatch checks.</p>
    <form id="transportRiderReadinessFilters" class="row g-2 mb-2">
        <div class="col-md-4"><label class="form-label" for="transportRiderReadinessCampus">Campus</label><select id="transportRiderReadinessCampus" class="form-select"><option value="">All authorized campuses</option></select></div>
        <div class="col-md-4"><label class="form-label" for="transportRiderReadinessSearch">Route / vehicle / campus</label><input id="transportRiderReadinessSearch" class="form-control" type="search" maxlength="100" /></div>
        <div class="col-md-2"><label class="form-label" for="transportRiderReadinessMode">View</label><select id="transportRiderReadinessMode" class="form-select"><option value="true">Needs attention</option><option value="false">All assignments</option></select></div>
        <div class="col-md-2 d-flex align-items-end"><button type="submit" class="btn btn-outline-primary w-100">Apply</button></div>
    </form>
    <button id="transportRiderReadinessExport" type="button" class="btn btn-outline-success btn-sm mb-2" disabled>Export filtered CSV</button>
    <div id="transportRiderReadinessStatus" class="small text-muted mb-2" role="status" aria-live="polite">Loading…</div>
    <div class="table-responsive"><table class="table table-sm table-hover align-middle"><thead><tr><th>Assignment reference</th><th>Campus</th><th>Route</th><th>Vehicle</th><th>Starts</th><th>Ends</th><th>Readiness</th></tr></thead><tbody id="transportRiderReadinessRows"><tr><td colspan="7">Loading…</td></tr></tbody></table></div>
    <div class="d-flex align-items-center justify-content-between gap-2">
        <button id="transportRiderReadinessPrev" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous</button>
        <span id="transportRiderReadinessPage" class="small text-muted"></span>
        <button id="transportRiderReadinessNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next</button>
    </div>
</div></section>
