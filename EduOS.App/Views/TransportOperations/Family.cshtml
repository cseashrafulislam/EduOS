@{
    ViewData["Title"] = "My transport schedule";
}
<section class="container-fluid py-3" id="transportFamilyPanel" aria-labelledby="transportFamilyTitle">
    <header class="d-flex align-items-center gap-2 mb-3">
        <h1 class="h4 mb-0" id="transportFamilyTitle">My transport schedule / আমার পরিবহন সূচি</h1>
        <details class="ms-auto">
            <summary class="btn btn-sm btn-outline-secondary" aria-label="Transport schedule guidance">i</summary>
            <div class="small mt-2" style="max-width: 22rem">
                View only your own or currently linked child's assigned pickup/drop plan for today or the next 30 days.
                This is not live tracking, a trip record or attendance confirmation.
            </div>
        </details>
    </header>
    <form id="transportFamilyFilters" class="row g-2 mb-3">
        <div class="col-sm-5 col-md-3">
            <label class="form-label" for="transportFamilyDate">Service date / তারিখ</label>
            <input class="form-control" id="transportFamilyDate" type="date" required />
        </div>
        <div class="col-auto align-self-end">
            <button class="btn btn-primary" type="submit">View / দেখুন</button>
        </div>
        <div class="col-auto align-self-end">
            <button class="btn btn-outline-secondary" id="transportFamilyExport" type="button" disabled>CSV</button>
        </div>
    </form>
    <p id="transportFamilyStatus" class="small text-muted" role="status" aria-live="polite"></p>
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead><tr><th>Student / শিক্ষার্থী</th><th>Campus</th><th>Route</th><th>Vehicle</th><th>Pickup</th><th>Drop</th><th>From</th><th>Until</th></tr></thead>
            <tbody id="transportFamilyRows"></tbody>
        </table>
    </div>
    <div class="d-flex justify-content-between align-items-center gap-2">
        <button class="btn btn-outline-secondary btn-sm" id="transportFamilyPrev" type="button" disabled>Previous</button>
        <span id="transportFamilyPage" class="small text-muted"></span>
        <button class="btn btn-outline-secondary btn-sm" id="transportFamilyNext" type="button" disabled>Next</button>
    </div>
</section>
@section Scripts {
    <script src="~/js/transport-operations/family-schedule.js" asp-append-version="true"></script>
}
