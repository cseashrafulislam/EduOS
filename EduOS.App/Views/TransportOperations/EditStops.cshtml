@{
    ViewData["Title"] = "Edit route stops";
}
<section class="container-fluid py-3" aria-labelledby="stopEditorTitle">
    <a asp-controller="TransportOperations" asp-action="Index" class="btn btn-link ps-0">← Transport operations</a>
    <div class="card"><div class="card-body" id="transportRouteStopEditor" data-reference="@ViewBag.RouteReference">
        <h2 class="h5" id="stopEditorTitle">Edit, reorder and manage route stops</h2>
        <p class="text-muted small">Stop IDs and linked rider pickup/drop-off references remain unchanged. Deactivation is blocked while active or future rider reservations reference a stop, and the last active stop cannot be disabled. Fares are managed by Finance.</p>
        <div id="transportRouteStopAlert" class="d-none" role="alert" tabindex="-1"></div>
        <h3 id="transportRouteStopName" class="h6">Loading route…</h3>
        <form id="transportRouteStopAddForm" class="d-flex gap-2 mb-3">
            <input id="transportRouteStopNewName" class="form-control" required maxlength="150" aria-label="New stop name" placeholder="New stop name" />
            <button id="transportRouteStopAdd" class="btn btn-outline-primary" type="submit">Add stop</button>
        </form>
        <form id="transportRouteStopForm">
            @Html.AntiForgeryToken()
            <div id="transportRouteStopRows" class="d-grid gap-2 mb-3"></div>
            <button id="transportRouteStopSave" class="btn btn-primary" type="submit" disabled>Save names and order</button>
        </form>
    </div></div>
</section>
@section Scripts {
    <script src="~/js/transport-operations/route-stops-editor.js" asp-append-version="true"></script>
}
