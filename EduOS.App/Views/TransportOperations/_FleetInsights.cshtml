<section class="card mb-3" id="transportFleetInsightsPanel"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center gap-2">
        <div><h3 class="h5 mb-1">Fleet health snapshot</h3>
            <p class="small text-muted mb-0">Uses the capacity report's campus and search filters. Aggregate counts only; no student, driver or financial information.</p></div>
        @if (User.IsInRole("TenantAdmin") || User.IsInRole("Principal"))
        {
            <a href="/OperationsInsights/Index" class="btn btn-outline-secondary btn-sm">Combined insights</a>
        }
        <div class="d-flex gap-2"><button id="transportFleetInsightsExport" class="btn btn-outline-success btn-sm" type="button" disabled>Export CSV</button><button id="transportFleetInsightsRefresh" class="btn btn-outline-primary btn-sm" type="button">Refresh</button></div>
    </div>
    <div id="transportFleetInsightsStatus" role="status" aria-live="polite" class="small text-muted mt-2">Loading…</div>
    <div id="transportFleetInsightsMetrics" class="row row-cols-2 row-cols-md-4 g-2 mt-1" aria-label="Fleet metrics"></div>
</div></section>
