<section class="card mb-3" id="transportVehicleDriverPanel"><div class="card-body">
    <h3 class="h5">Vehicle–driver assignments</h3>
    <p class="small text-muted">TenantAdmin only. One current assignment per driver and vehicle; assignment ends at license expiry at the latest. Close riders before ending an active vehicle's driver assignment. Reschedule a future driver's start date directly from the history row without changing its vehicle, driver or end date. After renewing a driver's license, extend an upcoming or operating assignment directly from the history row; the server checks campus, license, conflicts and row version.</p>
    <div id="transportVehicleDriverAlert" class="d-none" role="alert" tabindex="-1"></div>
    <form id="transportVehicleDriverForm" class="row g-2 mb-3">
        @Html.AntiForgeryToken()
        <div class="col-md-4"><label for="transportVehicleDriverVehicleSearch" class="form-label">Find vehicle</label><div class="input-group"><input id="transportVehicleDriverVehicleSearch" class="form-control" maxlength="100" placeholder="Vehicle number" /><button type="button" id="transportVehicleDriverFindVehicles" class="btn btn-outline-secondary">Find</button></div></div>
        <div class="col-md-4"><label for="transportVehicleDriverDriverSearch" class="form-label">Find driver</label><div class="input-group"><input id="transportVehicleDriverDriverSearch" class="form-control" maxlength="100" placeholder="Driver name" /><button type="button" id="transportVehicleDriverFindDrivers" class="btn btn-outline-secondary">Find</button></div></div>
        <div class="col-md-4"><label for="transportVehicleDriverVehicle" class="form-label">Vehicle</label><select id="transportVehicleDriverVehicle" class="form-select" required><option value="">Find a vehicle</option></select></div>
        <div class="col-md-4"><label for="transportVehicleDriverDriver" class="form-label">Licensed driver</label><select id="transportVehicleDriverDriver" class="form-select" required><option value="">Find a driver</option></select></div>
        <div class="col-md-3"><label for="transportVehicleDriverFrom" class="form-label">Effective from</label><input id="transportVehicleDriverFrom" class="form-control" type="date" required /></div>
        <div class="col-md-3"><label for="transportVehicleDriverTo" class="form-label">Effective to (optional)</label><input id="transportVehicleDriverTo" class="form-control" type="date" /><div class="form-text">Defaults to license expiry.</div></div>
        <div class="col-md-2 d-flex align-items-end"><button id="transportVehicleDriverAssign" type="submit" class="btn btn-primary w-100">Assign driver</button></div>
    </form>
    <section class="border rounded p-3 mb-3" aria-labelledby="transportVehicleDriverReplaceTitle">
        <h4 id="transportVehicleDriverReplaceTitle" class="h6">Replace operating vehicle driver</h4>
        <p class="small text-muted">Select a licensed replacement driver in the assignment form above, then find the active vehicle below. The replacement is effective today and preserves riders and monetary terms.</p>
        <form id="transportVehicleDriverReplaceForm" class="row g-2">
            <div class="col-md-5"><label for="transportVehicleDriverReplaceSearch" class="form-label">Find operating vehicle</label>
                <div class="input-group"><input id="transportVehicleDriverReplaceSearch" class="form-control" maxlength="100" placeholder="Vehicle or current driver" />
                <button id="transportVehicleDriverReplaceFind" type="button" class="btn btn-outline-secondary">Find</button></div></div>
            <div class="col-md-5"><label for="transportVehicleDriverReplaceSource" class="form-label">Active assignment</label>
                <select id="transportVehicleDriverReplaceSource" class="form-select" required><option value="">Find a vehicle</option></select></div>
            <div class="col-md-2 d-flex align-items-end"><button type="submit" class="btn btn-outline-primary w-100">Replace driver</button></div>
        </form>
    </section>
    <section id="transportUpcomingDriverChangePanel" class="border rounded p-3 mb-3" hidden aria-labelledby="transportUpcomingDriverChangeTitle">
        <h4 id="transportUpcomingDriverChangeTitle" class="h6">Change scheduled driver</h4>
        <p id="transportUpcomingDriverChangeContext" class="small text-muted"></p>
        <p class="small text-muted">Future reservations only. Vehicle, effective dates and rider coverage remain unchanged. Choose an active, unassigned driver licensed for the entire reservation.</p>
        <form id="transportUpcomingDriverChangeSearchForm" class="row g-2 mb-2">
            <div class="col-md-9"><label for="transportUpcomingDriverChangeSearch" class="form-label">Find eligible driver</label>
                <input id="transportUpcomingDriverChangeSearch" class="form-control" maxlength="100" placeholder="Driver name" /></div>
            <div class="col-md-3 d-flex align-items-end"><button type="submit" class="btn btn-outline-secondary w-100">Search</button></div>
        </form>
        <form id="transportUpcomingDriverChangeForm" class="row g-2">
            <div class="col-md-8"><label for="transportUpcomingDriverChangeChoice" class="form-label">Replacement driver</label>
                <select id="transportUpcomingDriverChangeChoice" class="form-select" required></select></div>
            <div class="col-md-4 d-flex align-items-end gap-2">
                <button id="transportUpcomingDriverChangeSave" type="submit" class="btn btn-primary" disabled>Save</button>
                <button id="transportUpcomingDriverChangeCancel" type="button" class="btn btn-outline-secondary">Cancel</button>
            </div>
        </form>
        <div class="d-flex justify-content-between align-items-center gap-2 mt-2">
            <button id="transportUpcomingDriverChangePrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
            <span id="transportUpcomingDriverChangePageInfo" class="small text-muted"></span>
            <button id="transportUpcomingDriverChangeNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
        </div>
    </section>
    <h4 class="h6">Vehicle–driver assignment history</h4>
    <form id="transportVehicleDriverSearchForm" class="row g-2 mb-2">
        <div class="col-md-4"><label for="transportVehicleDriverCampus" class="visually-hidden">Campus</label><select id="transportVehicleDriverCampus" class="form-select"><option value="">All campuses</option></select></div>
        <div class="col-md-6"><label for="transportVehicleDriverSearch" class="visually-hidden">Search</label><input id="transportVehicleDriverSearch" class="form-control" maxlength="100" placeholder="Vehicle, driver or campus" /></div>
        <div class="col-md-2"><button type="submit" class="btn btn-outline-primary w-100">Search</button></div>
    </form>
    <div class="form-check mb-2"><input id="transportVehicleDriverScheduledOnly" type="checkbox" class="form-check-input" /><label class="form-check-label" for="transportVehicleDriverScheduledOnly">Upcoming assignments only</label></div>
    <div class="d-flex justify-content-end mb-2"><button id="transportVehicleDriverExport" type="button" class="btn btn-outline-success btn-sm" disabled>Export filtered history (CSV)</button></div>
    <div class="table-responsive"><table class="table table-sm table-hover align-middle">
        <thead><tr><th>Campus</th><th>Vehicle</th><th>Driver</th><th>License expires</th><th>From</th><th>To</th><th>Status</th><th>Action</th></tr></thead>
        <tbody id="transportVehicleDriverRows"><tr><td colspan="8">Loading…</td></tr></tbody>
    </table></div>
    <div class="d-flex justify-content-between align-items-center gap-2">
        <button id="transportVehicleDriverPrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
        <span id="transportVehicleDriverPageInfo" class="small text-muted"></span>
        <button id="transportVehicleDriverNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
    </div>
</div></section>
