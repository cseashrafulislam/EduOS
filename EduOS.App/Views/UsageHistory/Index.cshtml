@{ ViewData["Title"] = "Institution Usage History"; }
<div class="container-fluid py-3">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h2>Institution Usage History</h2>
        <a href="/IntegrationAdministration/Index" class="btn btn-outline-secondary btn-sm">Back to Integration Administration</a>
    </div>
    <p class="text-muted">Daily tenant-scoped snapshots of active students, employees and campuses. A day is determined by the institution timezone, falling back to UTC. Capturing twice on the same day returns the original snapshot.</p>
    <div class="alert alert-info" role="note">Storage, SMS and email metering are not connected to this capture. Their existing database fields are not displayed as measured values.</div>
    @Html.AntiForgeryToken()
    <section class="card mb-3" aria-labelledby="uhQuotaTitle">
        <div class="card-body">
            <h3 id="uhQuotaTitle" class="h5">Subscription quota comparison</h3>
            <p class="text-muted small mb-2">Compares the most recent saved daily snapshot with current plan limits. These counts are not live. A zero plan limit means unlimited. Storage, SMS and email are not metered here.</p>
            <div id="uhQuotaInfo" role="status" aria-live="polite">Loading quota comparison...</div>
            <div class="table-responsive mt-2"><table class="table table-sm">
                <thead><tr><th>Resource</th><th>Saved count</th><th>Plan limit</th><th>Utilization</th><th>Status</th></tr></thead>
                <tbody id="uhQuotaRows"></tbody>
            </table></div>
        </div>
    </section>
    <div class="alert alert-secondary" role="status" id="uhAutomationStatus" aria-live="polite">Checking automatic daily capture status...</div>
    <p class="text-muted small">The background worker checks each active, onboarded institution once per hour and saves at most one snapshot per institution-local day. A missing snapshot can still be captured manually. Automatic capture depends on the background worker running.</p>
    <button id="uhCapture" type="button" class="btn btn-primary mb-3">Capture today's usage</button>
    <button id="uhRefresh" type="button" class="btn btn-outline-secondary mb-3">Refresh</button>
    <form method="get" action="/api/usage-history/export" class="row g-2 align-items-end mb-3">
        <div class="col-sm-3"><label class="form-label" for="uhFrom">Export from (local day)</label><input id="uhFrom" name="fromDate" type="date" class="form-control" /></div>
        <div class="col-sm-3"><label class="form-label" for="uhTo">Export through (local day)</label><input id="uhTo" name="toDate" type="date" class="form-control" /></div>
        <div class="col-sm-3"><button type="submit" class="btn btn-outline-primary">Export CSV</button></div>
        <div class="col-12 small text-muted">Exports up to 366 days of saved snapshots; unmetered SMS, email and storage are excluded.</div>
    </form>
    <div id="uhStatus" role="status" aria-live="polite" class="small mb-3 text-muted"></div>
    <div class="card"><div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm table-striped">
                <thead><tr><th>Local day</th><th>Active students</th><th>Active employees</th><th>Active campuses</th></tr></thead>
                <tbody id="uhRows"></tbody>
            </table>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <button id="uhPrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
            <span id="uhPage"></span>
            <button id="uhNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
        </div>
    </div></div>
</div>
@section Scripts { <script src="~/js/usage-history/index.js" asp-append-version="true"></script> }
