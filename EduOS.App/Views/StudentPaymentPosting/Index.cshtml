@using System.Globalization
@{
    var bn = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
    string L(string en, string bd) => bn ? bd : en;
    ViewData["Title"] = L("Student Cash Receipt GL Posting", "শিক্ষার্থী নগদ রসিদ GL পোস্টিং");
    var canPost = User.IsInRole("TenantAdmin") || User.IsInRole("Principal");
}
<section class="container-fluid py-2" id="studentPaymentPosting" data-post="@canPost.ToString().ToLowerInvariant()">
    <p class="small text-muted mb-2">@L("Post collected cash to an eligible cash ledger only after the corresponding invoice GL is posted. SaaS billing is separate.", "সংশ্লিষ্ট ইনভয়েস GL পোস্ট হওয়ার পরই অনুমোদিত নগদ খাতায় রসিদ পোস্ট করুন। SaaS বিলিং আলাদা।")</p>
    @Html.AntiForgeryToken()
    <div id="paymentPostingNotice" class="alert d-none" role="alert" aria-live="polite"></div>
    <form id="paymentPostingFilters" class="card card-body mb-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-3"><label for="paymentPostingCampus" class="form-label">@L("Campus", "ক্যাম্পাস")</label>
                <select id="paymentPostingCampus" class="form-select"><option value="">@L("All authorized campuses", "অনুমোদিত সব ক্যাম্পাস")</option></select></div>
            <div class="col-md-3"><label for="paymentPostingSearch" class="form-label">@L("Receipt / student", "রসিদ / শিক্ষার্থী")</label>
                <input id="paymentPostingSearch" class="form-control" maxlength="100" autocomplete="off" /></div>
            <div class="col-md-3"><label for="paymentPostingPeriod" class="form-label">@L("Open accounting period", "খোলা হিসাবকাল")</label>
                <select id="paymentPostingPeriod" class="form-select"><option value="">@L("Choose a period", "হিসাবকাল বাছুন")</option></select></div>
            <div class="col-md-3"><label for="paymentPostingCash" class="form-label">@L("Cash-in-hand GL account", "নগদ GL হিসাবখাতা")</label>
                <select id="paymentPostingCash" class="form-select"><option value="">@L("Choose cash ledger", "নগদ খাতা বাছুন")</option></select></div>
            <div class="col-12 d-flex align-items-center justify-content-end flex-wrap gap-3">
                <div class="form-check"><input id="paymentPostingUnposted" class="form-check-input" type="checkbox" checked /><label for="paymentPostingUnposted" class="form-check-label">@L("Unposted only", "শুধু পোস্ট হয়নি")</label></div>
                <button type="submit" class="btn btn-primary">@L("Find receipts", "রসিদ খুঁজুন")</button>
            </div>
        </div>
    </form>
    <div class="card card-body">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <h2 class="h6 mb-0">@L("Student cash receipts", "শিক্ষার্থীর নগদ রসিদ")</h2>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="StudentInvoicePosting" asp-action="Index" class="btn btn-outline-primary btn-sm">@L("Post invoices first", "আগে ইনভয়েস পোস্ট করুন")</a>
                <a asp-controller="FeeOperations" asp-action="Ledger" class="btn btn-outline-secondary btn-sm">@L("Fee operations", "ফি কার্যক্রম")</a>
            </div>
        </div>
        <div class="table-responsive"><table class="table table-striped table-sm align-middle">
            <thead><tr><th>@L("Receipt", "রসিদ")</th><th>@L("Student", "শিক্ষার্থী")</th><th>@L("Campus", "ক্যাম্পাস")</th><th>@L("Date", "তারিখ")</th><th>@L("Amount", "পরিমাণ")</th><th>@L("Status", "অবস্থা")</th><th>@L("Journal", "জার্নাল")</th>@if(canPost){<th>@L("Action", "কাজ")</th>}</tr></thead>
            <tbody id="paymentPostingRows"></tbody>
        </table></div>
        <div class="d-flex align-items-center gap-2">
            <button id="paymentPostingPrev" type="button" class="btn btn-outline-secondary btn-sm">@L("Previous", "আগের")</button>
            <span id="paymentPostingPage" aria-live="polite"></span>
            <button id="paymentPostingNext" type="button" class="btn btn-outline-secondary btn-sm">@L("Next", "পরের")</button>
        </div>
    </div>
    <p class="small text-muted mt-2">@L("One campus per receipt. Invoice GL must be posted first. Receipts with multiple receivable accounts inside one invoice require allocation-level accounting and are rejected. Posted journals are immutable.", "প্রতি রসিদে একটি ক্যাম্পাস। আগে ইনভয়েস GL পোস্ট করতে হবে। একটি ইনভয়েসে একাধিক প্রাপ্য হিসাব থাকলে বণ্টনভিত্তিক হিসাব ছাড়া পোস্টিং গ্রহণযোগ্য নয়। পোস্ট করা জার্নাল অপরিবর্তনীয়।")</p>
</section>
@section Scripts { <script src="~/js/finance/student-payment-posting.js" asp-append-version="true"></script> }
