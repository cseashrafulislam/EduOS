@{
    var bn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
    ViewData["Title"] = bn ? "প্রোডাক্ট মডিউল" : "Product Modules";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section id="platformModuleAdministration" class="container-fluid px-0" data-bangla="@(bn ? "true" : "false")">
    @Html.AntiForgeryToken()
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <p class="small text-muted mb-0">@(bn ? "মডিউলের নাম, ক্রম ও নতুন ব্যবহারে উপলব্ধতা নির্ধারণ করুন। Code ও Core status অপরিবর্তনীয়; ব্যবহৃত মডিউল বন্ধ করা যাবে না।" : "Configure module labels, order and availability. Codes and core status are immutable; in-use modules cannot be disabled.")</p>
        <button id="moduleRetry" type="button" class="btn btn-sm btn-outline-secondary" hidden>@(bn ? "আবার চেষ্টা করুন" : "Try again")</button>
    </div>
    <p id="moduleMessage" class="small mb-2" role="status" aria-live="polite"></p>
    <div class="table-responsive border rounded-3">
        <table class="table table-hover table-sm align-middle mb-0">
            <caption class="visually-hidden">@(bn ? "প্রোডাক্ট মডিউল ক্যাটালগ" : "Product module catalog")</caption>
            <thead class="table-light"><tr>
                <th scope="col">@(bn ? "কোড" : "Code")</th>
                <th scope="col">@(bn ? "নাম" : "Name")</th>
                <th scope="col">@(bn ? "মূল মডিউল" : "Core")</th>
                <th scope="col">@(bn ? "ক্রম" : "Order")</th>
                <th scope="col">@(bn ? "অবস্থা" : "Availability")</th>
                <th scope="col">@(bn ? "কাজ" : "Actions")</th>
            </tr></thead>
            <tbody id="moduleRows"><tr><td colspan="6">@(bn ? "মডিউল আনা হচ্ছে…" : "Loading modules…")</td></tr></tbody>
        </table>
    </div>
    <section id="moduleEditor" class="card border rounded-3 p-3 mt-3" aria-labelledby="moduleEditorTitle" hidden>
        <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
            <h2 id="moduleEditorTitle" class="h6 mb-0">@(bn ? "মডিউল সম্পাদনা" : "Edit module")</h2>
            <span id="moduleEditCode" class="badge text-bg-secondary" aria-label="@(bn ? "অপরিবর্তনীয় সিস্টেম কোড" : "Immutable module code")"></span>
        </div>
        <form id="moduleForm">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label" for="moduleEditName">@(bn ? "মডিউলের নাম" : "Module name")</label>
                    <input id="moduleEditName" class="form-control" maxlength="150" required />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label" for="moduleEditOrder">@(bn ? "তালিকার ক্রম" : "Display order")</label>
                    <input id="moduleEditOrder" type="number" class="form-control" min="0" max="100000" step="1" required />
                </div>
                <div class="col-12">
                    <label class="form-label" for="moduleEditDescription">@(bn ? "বিবরণ" : "Description")</label>
                    <textarea id="moduleEditDescription" class="form-control" maxlength="500" rows="2"></textarea>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input id="moduleEditActive" type="checkbox" role="switch" class="form-check-input" />
                        <label class="form-check-label" for="moduleEditActive">@(bn ? "ক্যাটালগে উপলব্ধ" : "Available in product catalog")</label>
                    </div>
                    <p id="moduleCoreWarning" class="small text-muted mb-0 mt-1" hidden>@(bn ? "মূল মডিউল সব সময় সক্রিয় থাকবে।" : "Core modules must remain active.")</p>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button id="moduleSave" class="btn btn-primary" type="submit">@(bn ? "সংরক্ষণ করুন" : "Save changes")</button>
                <button id="moduleCancel" class="btn btn-outline-secondary" type="button">@(bn ? "বাতিল" : "Cancel")</button>
            </div>
        </form>
    </section>
</section>
@section Scripts {
    <script src="~/js/platform/product-module-administration.js" asp-append-version="true"></script>
}
