@{
    ViewData["Title"] = "Product Module Catalog";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section id="platformModuleAdministration" class="container-fluid py-3">
    @Html.AntiForgeryToken()
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h4">Product Module Catalog</h1>
            <p class="text-muted">Edit module labels, ordering and availability. Codes and core status are immutable. Modules used by institution presets or tenants cannot be disabled.</p>
        </div>
        <button id="moduleRefresh" type="button" class="btn btn-outline-secondary">Refresh</button>
    </div>
    <p id="moduleMessage" role="status" aria-live="polite"></p>
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead><tr><th>Code</th><th>Name</th><th>Core</th><th>Order</th><th>Availability</th><th>Action</th></tr></thead>
            <tbody id="moduleRows"><tr><td colspan="6">Loading…</td></tr></tbody>
        </table>
    </div>
    <section id="moduleEditor" class="card p-3 mt-3" hidden>
        <h2 class="h5">Edit module <span id="moduleEditCode"></span></h2>
        <form id="moduleForm">
            <div class="mb-3">
                <label class="form-label" for="moduleEditName">Name</label>
                <input id="moduleEditName" class="form-control" maxlength="150" required />
            </div>
            <div class="mb-3">
                <label class="form-label" for="moduleEditDescription">Description</label>
                <textarea id="moduleEditDescription" class="form-control" maxlength="500" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label" for="moduleEditOrder">Display order</label>
                <input id="moduleEditOrder" type="number" class="form-control" min="0" max="100000" step="1" required />
            </div>
            <div class="form-check mb-3">
                <input id="moduleEditActive" type="checkbox" class="form-check-input" />
                <label class="form-check-label" for="moduleEditActive">Available in the product catalog</label>
            </div>
            <p id="moduleCoreWarning" class="text-muted" hidden>Core modules must remain active.</p>
            <button id="moduleSave" class="btn btn-primary" type="submit">Save changes</button>
            <button id="moduleCancel" class="btn btn-outline-secondary" type="button">Cancel</button>
        </form>
    </section>
</section>
@section Scripts {
    <script src="~/js/platform/product-module-administration.js" asp-append-version="true"></script>
}
