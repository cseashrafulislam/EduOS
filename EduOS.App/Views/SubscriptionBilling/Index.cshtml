@{
    ViewData["Title"] = "Subscription & Billing";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid py-3" id="subscriptionBillingApp">
    @Html.AntiForgeryToken()
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div><h1 class="h4">Subscription &amp; Billing</h1><p class="text-muted">Current plan, invoices, payments and renewal.</p></div>
        <button id="sbRefresh" type="button" class="btn btn-outline-secondary">Refresh</button>
    </div>
    <div id="sbAlert" role="alert" aria-live="polite" class="alert d-none"></div>
    <section class="card mb-3"><div class="card-body">
        <h2 class="h5">Current subscription</h2><div id="sbCurrent">Loading…</div>
        <div id="sbActions" class="d-flex gap-2 mt-2"></div>
    </div></section>
    <section class="card mb-3"><div class="card-body">
        <h2 class="h5">Expiry &amp; renewal</h2>
        <p id="sbLifecycle" role="status" aria-live="polite">Loading renewal status…</p>
        <div id="sbRenewalActions"></div>
    </div></section>
    <section class="card mb-3"><div class="card-body">
        <h2 class="h5">Next renewal</h2>
        <p id="sbUpcoming" role="status" aria-live="polite">Loading renewal options…</p>
        <div id="sbRenewActions" class="d-flex gap-2"></div>
    </div></section>
    <section class="card mb-3"><div class="card-body">
        <h2 class="h5">Invoices</h2>
        <p class="small text-muted">Download a tenant-scoped CSV of any invoice with its original line items, taxes, paid amount and outstanding balance. The export is read-only.</p>
        <p class="small text-muted">Outstanding renewal invoices can send an in-app payment reminder to active institution owners. Reminders are limited to once per local day; no email, SMS, or payment is initiated.</p>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <label for="sbInvoiceState" class="small mb-0">Invoice status</label>
            <select id="sbInvoiceState" class="form-select form-select-sm" style="max-width:190px">
                <option value="">All statuses</option>
                <option value="2">Issued</option>
                <option value="3">Partially paid</option>
                <option value="4">Paid</option>
                <option value="1">Draft</option>
                <option value="5">Cancelled</option>
                <option value="6">Refunded</option>
            </select>
        </div>
        <div class="table-responsive"><table class="table table-sm table-striped">
            <thead><tr><th>Invoice</th><th>Date</th><th>Due date</th><th>Total</th><th>Paid</th><th>Outstanding</th><th>Status</th><th>Action</th></tr></thead>
            <tbody id="sbInvoiceRows"></tbody>
        </table></div>
        <nav class="d-flex align-items-center gap-2 mb-3" aria-label="Invoice history pages">
            <button id="sbInvoicePrev" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous invoices</button>
            <span id="sbInvoicePage" class="small text-muted" aria-live="polite">Page 1</span>
            <button id="sbInvoiceNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next invoices</button>
        </nav>
        <div id="sbInvoiceDetails" class="mt-3" aria-live="polite"></div>
        <div id="sbPayments" aria-live="polite"></div>
    </div></section>
    <section class="card"><div class="card-body">
        <h2 class="h5">Subscription history</h2>
        <div class="table-responsive"><table class="table table-sm">
            <thead><tr><th>Plan</th><th>Cycle</th><th>Start</th><th>End</th><th>Status</th><th>Auto-renew</th></tr></thead>
            <tbody id="sbHistoryRows"></tbody>
        </table></div>
        <div class="d-flex align-items-center gap-2">
            <button id="sbPrev" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous</button>
            <span id="sbPage" class="small text-muted">Page 1</span>
            <button id="sbNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next</button>
        </div>
    </div></section>
</div>
<script src="~/js/subscription-billing/index.js" asp-append-version="true"></script>
