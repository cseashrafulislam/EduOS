@{
    var bn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
    ViewData["Title"] = bn ? "স্বীকৃতি ও মান নিশ্চিতকরণ" : "Accreditation & Quality Assurance";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var coordinator = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("AccreditationCoordinator");
}
<style media="print">
    body * { visibility: hidden !important; }
    #accReport, #accReport * { visibility: visible !important; }
    #accReport { position: absolute; left: 0; top: 0; width: 100%; border: 0 !important; box-shadow: none !important; }
    #accReportForm, #accCsv, #accGapCsv, #accPrint { display: none !important; }
    #accGapRun { display: none !important; }
</style>
<div class="container-fluid py-4" id="accreditationWorkspace">
    @Html.AntiForgeryToken()
    <div class="d-flex justify-content-end mb-3"><a class="btn btn-outline-primary" asp-controller="Accreditation" asp-action="Obe"
        data-a-en="University OBE attainment" data-a-bn="বিশ্ববিদ্যালয় OBE মূল্যায়ন">University OBE attainment</a></div>
    <div id="accreditationNotice" class="alert d-none" role="status" aria-live="polite"></div>
    <div class="row g-3">
        <div class="col-xl-4">
            @if (coordinator)
            {
                <section class="card border-0 shadow-sm mb-3" aria-labelledby="accFrameworkHeading">
                    <div class="card-body">
                        <h2 id="accFrameworkHeading" class="h5" data-a-en="Framework versions" data-a-bn="মানদণ্ড কাঠামোর সংস্করণ">Framework versions</h2>
                        <form id="accFrameworkForm">
                            <label for="accFrameworkCode" class="form-label" data-a-en="Framework code" data-a-bn="কাঠামো কোড">Framework code</label>
                            <input id="accFrameworkCode" class="form-control mb-2" maxlength="40" required pattern="[A-Za-z0-9_]+" />
                            <label for="accFrameworkName" class="form-label" data-a-en="Name" data-a-bn="নাম">Name</label>
                            <input id="accFrameworkName" class="form-control mb-2" maxlength="200" required />
                            <label for="accFrameworkVersion" class="form-label" data-a-en="Version" data-a-bn="সংস্করণ">Version</label>
                            <input id="accFrameworkVersion" type="number" class="form-control mb-2" min="1" max="1000" value="1" required />
                            <button class="btn btn-outline-primary" type="submit" data-a-en="Create draft version" data-a-bn="খসড়া সংস্করণ তৈরি">Create draft version</button>
                        </form>
                        <hr />
                        <label for="accFrameworkManage" class="form-label" data-a-en="Draft framework" data-a-bn="খসড়া কাঠামো">Draft framework</label>
                        <select id="accFrameworkManage" class="form-select mb-2"></select>
                        <form id="accStandardForm">
                            <label for="accStandardCode" class="form-label" data-a-en="Standard code" data-a-bn="মানদণ্ড কোড">Standard code</label>
                            <input id="accStandardCode" class="form-control mb-2" maxlength="40" required />
                            <label for="accStandardTitle" class="form-label" data-a-en="Standard title" data-a-bn="মানদণ্ড শিরোনাম">Standard title</label>
                            <input id="accStandardTitle" class="form-control mb-2" maxlength="200" required />
                            <label for="accStandardRubric" class="form-label" data-a-en="Evaluation rubric" data-a-bn="মূল্যায়ন নির্দেশিকা">Evaluation rubric</label>
                            <textarea id="accStandardRubric" class="form-control mb-2" minlength="10" maxlength="2000" required rows="2"></textarea>
                            <label for="accStandardRequired" class="form-label" data-a-en="Required evidence" data-a-bn="প্রয়োজনীয় প্রমাণ">Required evidence</label>
                            <textarea id="accStandardRequired" class="form-control mb-2" minlength="10" maxlength="2000" required rows="2"></textarea>
                            <label for="accStandardValidity" class="form-label" data-a-en="Approval validity (days)" data-a-bn="অনুমোদনের মেয়াদ (দিন)">Approval validity (days)</label>
                            <input id="accStandardValidity" type="number" class="form-control mb-2" min="1" max="3650" value="365" required />
                            <label for="accStandardQuorum" class="form-label" data-a-en="Independent reviewers required" data-a-bn="প্রয়োজনীয় স্বাধীন পর্যালোচক">Independent reviewers required</label>
                            <select id="accStandardQuorum" class="form-select mb-2"><option value="1">1</option><option value="2">2</option><option value="3">3</option></select>
                            <label class="form-check mb-2"><input id="accRequiresOutcome" type="checkbox" class="form-check-input" />
                                <span data-a-en="Require program learning outcome mapping" data-a-bn="প্রোগ্রাম শিক্ষণফল ম্যাপিং আবশ্যক">Require program learning outcome mapping</span></label>
                            <label class="form-check mb-2"><input id="accRequiresPublished" type="checkbox" class="form-check-input" />
                                <span data-a-en="Require published academic result evidence" data-a-bn="প্রকাশিত একাডেমিক ফলাফলের প্রমাণ আবশ্যক">Require published academic result evidence</span></label>
                            <button id="accStandardSave" class="btn btn-outline-primary" type="submit" data-a-en="Add standard" data-a-bn="মানদণ্ড যোগ">Add standard</button>
                        </form>
                        <hr />
                        <h3 class="h6" data-a-en="Versioned program learning outcomes" data-a-bn="সংস্করণভিত্তিক প্রোগ্রাম শিক্ষণফল">Versioned program learning outcomes</h3>
                        <p class="small text-muted" data-a-en="Select a campus and program in the assessment form first. New versions preserve the prior wording for historical audits." data-a-bn="প্রথমে মূল্যায়ন ফর্মে ক্যাম্পাস ও প্রোগ্রাম নির্বাচন করুন। নতুন সংস্করণে আগের বিবরণ অক্ষত থাকে।">Select a campus and program in the assessment form first. New versions preserve the prior wording for historical audits.</p>
                        <form id="accOutcomeForm" class="mb-3">
                            <label for="accOutcomeCode" class="form-label">PLO code</label>
                            <input id="accOutcomeCode" class="form-control mb-2" maxlength="40" pattern="[A-Za-z0-9_]+" required />
                            <label for="accOutcomeVersion" class="form-label">Version</label>
                            <input id="accOutcomeVersion" class="form-control mb-2" type="number" min="1" max="1000" value="1" required />
                            <label for="accOutcomeText" class="form-label" data-a-en="Outcome statement" data-a-bn="শিক্ষণফল বিবরণ">Outcome statement</label>
                            <textarea id="accOutcomeText" class="form-control mb-2" minlength="10" maxlength="1000" rows="2" required></textarea>
                            <button class="btn btn-sm btn-outline-primary" type="submit" data-a-en="Save immutable outcome version" data-a-bn="অপরিবর্তনীয় শিক্ষণফল সংরক্ষণ">Save immutable outcome version</button>
                        </form>
                        <h3 class="h6" data-a-en="Draft standard → outcome map" data-a-bn="খসড়া মানদণ্ড → শিক্ষণফল ম্যাপিং">Draft standard → outcome map</h3>
                        <form id="accOutcomeMapForm">
                            <label for="accMapStandard" class="form-label">Draft standard</label>
                            <select id="accMapStandard" class="form-select mb-2" required></select>
                            <label for="accMapOutcome" class="form-label">Program outcome</label>
                            <select id="accMapOutcome" class="form-select mb-2" required></select>
                            <button class="btn btn-sm btn-outline-primary" type="submit" data-a-en="Link to draft standard" data-a-bn="খসড়া মানদণ্ডে সংযুক্ত করুন">Link to draft standard</button>
                        </form>
                        <button id="accFrameworkPublish" class="btn btn-outline-success mt-3" type="button" data-a-en="Independent publish" data-a-bn="স্বতন্ত্র প্রকাশ অনুমোদন">Independent publish</button>
                        <p class="small text-muted mb-0 mt-2" data-a-en="The draft creator cannot publish their own version. Published standards cannot be changed." data-a-bn="খসড়া প্রস্তুতকারী নিজে প্রকাশ করতে পারবেন না। প্রকাশিত মানদণ্ড আর বদলানো যাবে না।">The draft creator cannot publish their own version. Published standards cannot be changed.</p>
                    </div>
                </section>
            }
            <section class="card border-0 shadow-sm" aria-labelledby="accCreateHeading">
                <div class="card-body">
                    <h2 id="accCreateHeading" class="h5" data-a-en="New evidence assessment" data-a-bn="নতুন প্রমাণ মূল্যায়ন">New evidence assessment</h2>
                    <form id="accCreateForm">
                        <label for="accCampus" class="form-label" data-a-en="Campus" data-a-bn="ক্যাম্পাস">Campus</label>
                        <select id="accCampus" class="form-select mb-2" required></select>
                        <label for="accProgram" class="form-label" data-a-en="Program (optional)" data-a-bn="প্রোগ্রাম (ঐচ্ছিক)">Program (optional)</label>
                        <select id="accProgram" class="form-select mb-2"></select>
                        <label for="accFramework" class="form-label" data-a-en="Published framework" data-a-bn="প্রকাশিত কাঠামো">Published framework</label>
                        <select id="accFramework" class="form-select mb-2" required></select>
                        <label for="accStandard" class="form-label" data-a-en="Standard" data-a-bn="মানদণ্ড">Standard</label>
                        <select id="accStandard" class="form-select mb-2" required></select>
                        <label for="accPeriodFrom" class="form-label" data-a-en="Assessment period from" data-a-bn="মূল্যায়ন শুরুর তারিখ">Assessment period from</label>
                        <input id="accPeriodFrom" type="date" class="form-control mb-2" required />
                        <label for="accPeriodTo" class="form-label" data-a-en="Assessment period to" data-a-bn="মূল্যায়ন শেষের তারিখ">Assessment period to</label>
                        <input id="accPeriodTo" type="date" class="form-control mb-2" required />
                        <label for="accEvidence" class="form-label" data-a-en="Evidence summary" data-a-bn="প্রমাণের সারসংক্ষেপ">Evidence summary</label>
                        <textarea id="accEvidence" class="form-control mb-2" rows="4" minlength="30" maxlength="3000" required></textarea>
                        <button id="accCreateButton" type="submit" class="btn btn-primary" data-a-en="Save evidence draft" data-a-bn="প্রমাণের খসড়া সংরক্ষণ">Save evidence draft</button>
                    </form>
                </div>
            </section>
        </div>
        <div class="col-xl-8">
            <section class="card border-0 shadow-sm" aria-labelledby="accQueueHeading">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                        <h2 id="accQueueHeading" class="h5 mb-0" data-a-en="Accreditation evidence queue" data-a-bn="স্বীকৃতি প্রমাণের তালিকা">Accreditation evidence queue</h2>
                        <button id="accRefresh" type="button" class="btn btn-sm btn-outline-secondary" data-a-en="Refresh" data-a-bn="রিফ্রেশ">Refresh</button>
                    </div>
                    <div class="table-responsive"><table class="table table-sm table-striped">
                        <thead><tr><th data-a-en="Standard" data-a-bn="মানদণ্ড">Standard</th><th data-a-en="Period" data-a-bn="সময়কাল">Period</th><th data-a-en="Status" data-a-bn="অবস্থা">Status</th><th data-a-en="Action" data-a-bn="কার্যক্রম">Action</th></tr></thead>
                        <tbody id="accRows"></tbody>
                    </table></div>
                    <div class="d-flex justify-content-between align-items-center">
                        <button id="accPrevious" type="button" class="btn btn-sm btn-outline-secondary" data-a-en="Previous" data-a-bn="আগের">Previous</button>
                        <span id="accPage" aria-live="polite"></span>
                        <button id="accNext" type="button" class="btn btn-sm btn-outline-secondary" data-a-en="Next" data-a-bn="পরের">Next</button>
                    </div>
                </div>
            </section>
            <section id="accDetail" class="card border-0 shadow-sm mt-3 d-none" aria-labelledby="accDetailHeading">
                <div class="card-body">
                    <h2 id="accDetailHeading" class="h5" data-a-en="Assessment and review" data-a-bn="মূল্যায়ন ও পর্যালোচনা">Assessment and review</h2>
                    <div id="accSummary" class="mb-3"></div>
                    <div id="accSensitive" class="mb-3"></div>
                    <section id="accAcademicEvidenceBox" class="border rounded p-3 mb-3 d-none">
                        <h3 class="h6" data-a-en="Published academic result evidence" data-a-bn="প্রকাশিত একাডেমিক ফলাফলের প্রমাণ">Published academic result evidence</h3>
                        <form id="accAcademicEvidenceForm" class="mb-2 d-none">
                            <label for="accAcademicResultId" class="form-label" data-a-en="Published result record ID" data-a-bn="প্রকাশিত ফলাফলের রেকর্ড আইডি">Published result record ID</label>
                            <input id="accAcademicResultId" class="form-control mb-2" type="number" min="1" step="1" required />
                            <button class="btn btn-sm btn-outline-primary" type="submit" data-a-en="Link published result" data-a-bn="প্রকাশিত ফলাফল সংযুক্ত করুন">Link published result</button>
                        </form>
                        <div id="accAcademicEvidenceList" class="small"></div>
                    </section>
                    <form id="accActionForm">
                        <label for="accAction" class="form-label" data-a-en="Available action" data-a-bn="অনুমোদিত কার্যক্রম">Available action</label>
                        <select id="accAction" class="form-select mb-2" required></select>
                        <div id="accEditBox" class="d-none">
                            <label for="accEditEvidence" class="form-label" data-a-en="Revised evidence summary" data-a-bn="সংশোধিত প্রমাণের সারসংক্ষেপ">Revised evidence summary</label>
                            <textarea id="accEditEvidence" class="form-control mb-2" rows="4" minlength="30" maxlength="3000"></textarea>
                        </div>
                        <div id="accReviewerBox" class="d-none">
                            <label for="accReviewer" class="form-label" data-a-en="Independent reviewers (Ctrl/Shift to select multiple)" data-a-bn="স্বতন্ত্র পর্যালোচক (একাধিক নির্বাচনের জন্য Ctrl/Shift)">Independent reviewers (Ctrl/Shift to select multiple)</label>
                            <select id="accReviewer" class="form-select mb-2" multiple size="5"></select>
                        </div>
                        <label for="accReason" class="form-label" data-a-en="Decision reason" data-a-bn="সিদ্ধান্তের কারণ">Decision reason</label>
                        <textarea id="accReason" class="form-control mb-2" maxlength="500" rows="2"></textarea>
                        <label id="accConflictLabel" class="form-check mb-2 d-none">
                            <input id="accConflict" type="checkbox" class="form-check-input" />
                            <span class="form-check-label" data-a-en="I have no conflict of interest" data-a-bn="আমার কোনো স্বার্থের সংঘাত নেই">I have no conflict of interest</span>
                        </label>
                        <button id="accConfirm" type="submit" class="btn btn-primary" data-a-en="Confirm action" data-a-bn="কার্যক্রম নিশ্চিত করুন">Confirm action</button>
                    </form>
                    <section class="border-top mt-4 pt-3" aria-labelledby="accFilesHeading">
                        <h3 id="accFilesHeading" class="h6" data-a-en="Private accreditation evidence files" data-a-bn="গোপন স্বীকৃতি প্রমাণ ফাইল">Private accreditation evidence files</h3>
                        <p class="small text-muted" data-a-en="Scanned PDF/images only, maximum 5 MB each and five per evidence version." data-a-bn="শুধু স্ক্যান করা PDF/ছবি; প্রতিটি সর্বোচ্চ ৫ এমবি এবং প্রতি সংস্করণে পাঁচটি।">Scanned PDF/images only, maximum 5 MB each and five per evidence version.</p>
                        <form id="accFileForm" class="d-none mb-3">
                            <div><label class="form-label" for="accFileInput" data-a-en="Evidence attachment" data-a-bn="প্রমাণ সংযুক্তি">Evidence attachment</label>
                                <input id="accFileInput" class="form-control" type="file" accept=".pdf,.png,.jpg,.jpeg,.webp" required /></div>
                            <button id="accFileUpload" class="btn btn-sm btn-outline-primary" type="submit" data-a-en="Upload scanned evidence" data-a-bn="স্ক্যান করা প্রমাণ আপলোড">Upload scanned evidence</button>
                        </form>
                        <div id="accFileRows" class="small"></div>
                        <div class="d-flex align-items-center justify-content-between mt-2">
                            <button id="accFilesPrev" class="btn btn-sm btn-outline-secondary" type="button" data-a-en="Previous files" data-a-bn="আগের ফাইল">Previous files</button>
                            <span id="accFilesPage" class="small" aria-live="polite"></span>
                            <button id="accFilesNext" class="btn btn-sm btn-outline-secondary" type="button" data-a-en="Next files" data-a-bn="পরের ফাইল">Next files</button>
                        </div>
                    </section>
                    <h3 class="h6 mt-4" data-a-en="Immutable decision history" data-a-bn="অপরিবর্তনীয় সিদ্ধান্ত ইতিহাস">Immutable decision history</h3>
                    <div id="accHistory" class="small"></div>
                </div>
            </section>
            <section id="accReport" class="card border-0 shadow-sm mt-3" aria-labelledby="accReportHeading">
                <div class="card-body">
                    <h2 id="accReportHeading" class="h5" data-a-en="Accreditation audit summary" data-a-bn="স্বীকৃতি অডিট সারসংক্ষেপ">Accreditation audit summary</h2>
                    <form id="accReportForm" class="row g-2 align-items-end">
                        <div class="col-md-4"><label class="form-label" for="accReportCampus" data-a-en="Campus" data-a-bn="ক্যাম্পাস">Campus</label><select id="accReportCampus" class="form-select" required></select></div>
                        <div class="col-md-3"><label class="form-label" for="accReportFrom" data-a-en="From" data-a-bn="শুরু">From</label><input id="accReportFrom" type="date" class="form-control" required /></div>
                        <div class="col-md-3"><label class="form-label" for="accReportTo" data-a-en="To" data-a-bn="শেষ">To</label><input id="accReportTo" type="date" class="form-control" required /></div>
                        <div class="col-md-2"><button id="accReportRun" type="submit" class="btn btn-outline-primary" data-a-en="Run report" data-a-bn="রিপোর্ট দেখুন">Run report</button></div>
                    </form>
                    <div class="table-responsive mt-3"><table class="table table-sm">
                        <thead><tr><th>Framework</th><th>Standard</th><th>Total</th><th>Approved</th><th>Pending</th><th>Expired</th></tr></thead>
                        <tbody id="accReportRows"></tbody>
                    </table></div>
                    <div class="border-top pt-3 mt-3">
                        <h3 class="h6" data-a-en="Compliance gaps and renewal forecast" data-a-bn="কমপ্লায়েন্স ঘাটতি ও নবায়ন পূর্বাভাস">Compliance gaps and renewal forecast</h3>
                        <p class="small text-muted" data-a-en="Select a program for program-level evidence, or leave blank for institution-wide standards. Choose the renewal warning period." data-a-bn="প্রোগ্রামভিত্তিক প্রমাণের জন্য প্রোগ্রাম নির্বাচন করুন; প্রতিষ্ঠানভিত্তিক মানদণ্ডের জন্য ফাঁকা রাখুন। নবায়নের সতর্কতার সময় নির্ধারণ করুন।">Select a program for program-level evidence, or leave blank for institution-wide standards. Choose the renewal warning period.</p>
                        <div class="d-flex gap-2 align-items-end flex-wrap mb-2">
                            <div><label for="accGapProgram" class="form-label" data-a-en="Program scope" data-a-bn="প্রোগ্রামের পরিসর">Program scope</label>
                                <select id="accGapProgram" class="form-select"></select></div>
                            <div><label for="accRenewDays" class="form-label" data-a-en="Renewal warning (days)" data-a-bn="নবায়ন সতর্কতা (দিন)">Renewal warning (days)</label>
                                <input id="accRenewDays" type="number" class="form-control" min="1" max="365" value="30" /></div>
                            <button id="accGapRun" class="btn btn-sm btn-outline-primary" type="button" data-a-en="Analyze gaps" data-a-bn="ঘাটতি বিশ্লেষণ">Analyze gaps</button>
                        </div>
                        <div class="table-responsive"><table class="table table-sm table-striped">
                            <thead><tr><th>Framework</th><th>Standard</th><th>Status</th><th>Expiry</th><th>PLO mapped</th><th>Published evidence</th></tr></thead>
                            <tbody id="accGapRows"></tbody>
                        </table></div>
                    </div>
                    <a id="accCsv" href="#" class="btn btn-sm btn-outline-success d-none" download data-a-en="Download verified CSV" data-a-bn="যাচাইকৃত CSV ডাউনলোড">Download verified CSV</a>
