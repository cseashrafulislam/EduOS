@{
    ViewData["Title"] = "Purchase Orders";
    var maker = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") ||
        User.IsInRole("InventoryManager") || User.IsInRole("StoreKeeper");
    var checker = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") ||
        User.IsInRole("InventoryManager");
}
<section class="container-fluid py-3" id="poWorkspace"
         data-maker="@maker.ToString().ToLowerInvariant()" data-checker="@checker.ToString().ToLowerInvariant()"
         data-user-id="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)">
    <header class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div class="d-flex align-items-center gap-2">
            <h1 class="h4 mb-0" data-i18n="title">Purchase orders</h1>
            <button id="poHelp" type="button" class="btn btn-outline-secondary btn-sm" aria-expanded="false"
                    aria-controls="poHelpText" aria-label="Page help">ⓘ</button>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="ProcurementRequisitions" asp-action="Index" class="btn btn-outline-secondary btn-sm" data-i18n="requisitions">Requisitions</a>
            <a asp-controller="ProcurementSuppliers" asp-action="Index" class="btn btn-outline-secondary btn-sm" data-i18n="suppliers">Suppliers</a>
            <button id="poExport" type="button" class="btn btn-outline-secondary btn-sm" data-i18n="export">CSV</button>
            @if (maker) { <button id="poNew" type="button" class="btn btn-primary btn-sm" data-i18n="new">New order</button> }
        </div>
    </header>
    <div id="poHelpText" class="alert alert-light border d-none" role="note" data-i18n="help">Create from an approved requisition and approved campus supplier. A separate checker must approve the order.</div>
    <div id="poAlert" class="d-none" role="status" aria-live="polite"></div>
    <form id="poFilters" class="row g-2 mb-3">
        <div class="col-12 col-md-3"><label class="form-label" for="poCampus" data-i18n="campus">Campus ID</label>
            <input id="poCampus" class="form-control" type="number" min="1" /></div>
        <div class="col-6 col-md-3"><label class="form-label" for="poState" data-i18n="status">Status</label>
            <select id="poState" class="form-select"><option value="" data-i18n="all">All</option><option>Draft</option><option>Submitted</option><option>Approved</option><option>Rejected</option><option>Cancelled</option></select></div>
        <div class="col-6 col-md-4"><label class="form-label" for="poSearch" data-i18n="search">Search</label>
            <input id="poSearch" class="form-control" maxlength="100" /></div>
        <div class="col-12 col-md-2 d-flex align-items-end"><button type="submit" class="btn btn-outline-primary w-100" data-i18n="filter">Filter</button></div>
    </form>
    <div class="table-responsive"><table class="table table-hover table-striped">
        <thead><tr><th data-i18n="number">Order</th><th data-i18n="campus">Campus</th><th data-i18n="supplier">Supplier</th><th data-i18n="status">Status</th><th data-i18n="total">Total BDT</th><th data-i18n="actions">Actions</th></tr></thead>
        <tbody id="poRows"></tbody>
    </table></div>
    <div class="d-flex align-items-center gap-2">
        <button id="poPrev" type="button" class="btn btn-outline-secondary btn-sm" data-i18n="previous">Previous</button>
        <span id="poPage" aria-live="polite"></span>
        <button id="poNext" type="button" class="btn btn-outline-secondary btn-sm" data-i18n="next">Next</button>
    </div>
    <dialog id="poCreateDialog" class="border rounded shadow p-0" style="width:min(95vw,720px);max-height:90vh">
        <form id="poCreateForm" class="p-3">
            <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h5 mb-0" data-i18n="new">New order</h2>
                <button id="poCreateClose" type="button" class="btn-close" aria-label="Close"></button></div>
            <input id="poRequestId" type="hidden" /><input id="poReqId" type="hidden" /><input id="poSupplierId" type="hidden" />
            <div class="row g-2">
                <div class="col-12 col-md-4"><label for="poFormCampus" class="form-label" data-i18n="campus">Campus ID</label>
                    <input id="poFormCampus" type="number" min="1" required class="form-control" /></div>
                <div class="col-12 col-md-8"><label for="poExpected" class="form-label" data-i18n="expected">Expected delivery</label>
                    <input id="poExpected" type="date" class="form-control" /></div>
            </div>
            <div class="row g-2 mt-1">
                <div class="col-12 col-md-6"><label for="poReqSearch" class="form-label" data-i18n="requisition">Approved requisition</label>
                    <div class="input-group"><input id="poReqSearch" class="form-control" maxlength="100" />
                        <button id="poFindReq" type="button" class="btn btn-outline-primary" data-i18n="find">Find</button></div>
                    <div id="poReqResults" class="list-group mt-1" aria-live="polite"></div>
                    <div id="poReqSelected" class="small mt-1"></div></div>
                <div class="col-12 col-md-6"><label for="poSupplierSearch" class="form-label" data-i18n="supplier">Approved supplier</label>
                    <div class="input-group"><input id="poSupplierSearch" class="form-control" maxlength="100" />
                        <button id="poFindSupplier" type="button" class="btn btn-outline-primary" data-i18n="find">Find</button></div>
                    <div id="poSupplierResults" class="list-group mt-1" aria-live="polite"></div>
                    <div id="poSupplierSelected" class="small mt-1"></div></div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button id="poCreateCancel" type="button" class="btn btn-outline-secondary" data-i18n="close">Close</button>
                <button id="poCreateSave" type="submit" class="btn btn-primary" data-i18n="create">Create draft</button>
            </div>
        </form>
    </dialog>
    <dialog id="poDetailDialog" class="border rounded shadow p-0" style="width:min(95vw,760px);max-height:90vh">
        <div class="p-3">
            <div class="d-flex justify-content-between align-items-center"><h2 class="h5" data-i18n="details">Order details</h2>
                <button id="poDetailClose" type="button" class="btn-close" aria-label="Close"></button></div>
            <div id="poDetailSummary" class="mb-2"></div>
            <div class="table-responsive"><table class="table table-sm"><thead><tr><th data-i18n="item">Item ID</th><th data-i18n="quantity">Quantity</th><th data-i18n="price">Unit price</th></tr></thead><tbody id="poDetailLines"></tbody></table></div>
            <div id="poDetailActions" class="d-flex flex-wrap justify-content-end gap-2"></div>
        </div>
    </dialog>
    <dialog id="poDecisionDialog" class="border rounded shadow p-3" style="width:min(95vw,440px)">
        <form id="poDecisionForm"><h2 id="poDecisionTitle" class="h5"></h2>
            <label for="poReason" class="form-label" data-i18n="reason">Reason</label>
            <textarea id="poReason" class="form-control" maxlength="500" rows="2"></textarea>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button id="poDecisionCancel" type="button" class="btn btn-outline-secondary" data-i18n="close">Close</button>
                <button id="poDecisionConfirm" type="submit" class="btn btn-primary" data-i18n="confirm">Confirm</button>
            </div>
        </form>
    </dialog>
</section>
@section Scripts { <script src="~/js/procurement/purchase-orders.js" asp-append-version="true"></script> }
