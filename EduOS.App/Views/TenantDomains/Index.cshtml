@{
    ViewData["Title"] = "Custom Domains";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="container-fluid" id="tenantDomainWorkspace">
    @Html.AntiForgeryToken()
    <h2>Custom Domain Management</h2>
    <p class="text-muted">Register a hostname, publish its DNS TXT ownership proof, verify it, then select the primary domain. DNS verification does not automatically configure TLS certificates, reverse proxy routing or DNS A/CNAME records.</p>
    <form id="domainRegistration" class="row g-2 align-items-end mb-3">
        <div class="col-md-8"><label class="form-label" for="domainHost">Custom hostname</label><input id="domainHost" class="form-control" placeholder="portal.school.example.com" maxlength="253" autocomplete="off" required /></div>
        <div class="col-md-4"><button id="domainRegisterButton" class="btn btn-primary" type="submit">Register / Rotate pending challenge</button></div>
    </form>
    <div id="domainNotice" role="status" aria-live="polite" class="mb-3"></div>
    <div id="domainChallenge" class="alert alert-info" hidden>
        <h3 class="h6">DNS TXT record — copy this now (shown once)</h3>
        <div><strong>Name:</strong> <code id="domainRecordName"></code></div>
        <div><strong>Type:</strong> TXT</div>
        <div><strong>Value:</strong> <code id="domainRecordValue"></code></div>
        <p class="mb-0 mt-2">Wait for DNS propagation, then select Verify. Keep the record published while this hostname is active.</p>
    </div>
    <div class="table-responsive"><table class="table table-striped table-sm align-middle">
        <thead><tr><th>Hostname</th><th>Verification</th><th>Active</th><th>Primary</th><th>Verified UTC</th><th>Actions</th></tr></thead>
        <tbody id="domainRows"></tbody>
    </table></div>
    <button type="button" id="domainRefresh" class="btn btn-outline-secondary">Refresh</button>
</section>
@section Scripts {
    <script src="~/js/platform/tenant-domains.js" asp-append-version="true"></script>
}
