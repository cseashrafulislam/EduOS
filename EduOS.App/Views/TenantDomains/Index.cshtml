@{
    var bn = System.Globalization.CultureInfo.CurrentUICulture.Name == "bn-BD";
    ViewData["Title"] = bn ? "নিজস্ব ডোমেইন" : "Custom Domains";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="container-fluid" id="tenantDomainWorkspace">
    @Html.AntiForgeryToken()
    <h2>@(bn ? "নিজস্ব ডোমেইন পরিচালনা" : "Custom Domain Management")</h2>
    <form id="domainRegistration" class="row g-2 align-items-end mb-3">
        <div class="col-md-8"><label class="form-label" for="domainHost">@(bn ? "নিজস্ব হোস্টনেম" : "Custom hostname")</label><input id="domainHost" class="form-control" placeholder="portal.school.example.com" maxlength="253" autocomplete="off" required /></div>
        <div class="col-md-4"><button id="domainRegisterButton" class="btn btn-primary" type="submit">@(bn ? "নিবন্ধন / অপেক্ষমাণ যাচাই বদলান" : "Register / Rotate pending challenge")</button></div>
    </form>
    <div id="domainNotice" role="status" aria-live="polite" class="mb-3"></div>
    <div id="domainChallenge" class="alert alert-info" hidden>
        <h3 class="h6">@(bn ? "DNS TXT রেকর্ড — এখনই কপি করুন (একবারই দেখানো হয়)" : "DNS TXT record — copy this now (shown once)")</h3>
        <div><strong>@(bn ? "নাম:" : "Name:")</strong> <code id="domainRecordName"></code></div>
        <div><strong>@(bn ? "ধরন:" : "Type:")</strong> TXT</div>
        <div><strong>@(bn ? "মান:" : "Value:")</strong> <code id="domainRecordValue"></code></div>
        <p class="mb-0 mt-2">@(bn ? "DNS পরিবর্তন কার্যকর হলে যাচাই করুন। ডোমেইন সক্রিয় থাকা পর্যন্ত TXT রেকর্ডটি রাখুন।" : "Wait for DNS propagation, then select Verify. Keep the record published while this hostname is active.")</p>
    </div>
    <div class="table-responsive"><table class="table table-striped table-sm align-middle">
        <thead><tr><th>@(bn ? "হোস্টনেম" : "Hostname")</th><th>@(bn ? "যাচাই" : "Verification")</th><th>@(bn ? "সক্রিয়" : "Active")</th><th>@(bn ? "প্রধান" : "Primary")</th><th>@(bn ? "যাচাইয়ের সময় (UTC)" : "Verified UTC")</th><th>@(bn ? "কাজ" : "Actions")</th></tr></thead>
        <tbody id="domainRows"></tbody>
    </table></div>
    <button type="button" id="domainRefresh" class="btn btn-outline-secondary">@(bn ? "রিফ্রেশ" : "Refresh")</button>
</section>
@section Scripts {
    <script src="~/js/platform/tenant-domains.js" asp-append-version="true"></script>
}
