@{
    ViewData["Title"] = "Supplier Invoices & Matching";
    var maker = User.IsInRole("TenantAdmin") || User.IsInRole("Accountant");
    var reviewer = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("Accountant");
}
<section id="supplierInvoiceMatch" class="container-fluid py-3"
         data-maker="@maker.ToString().ToLowerInvariant()" data-reviewer="@reviewer.ToString().ToLowerInvariant()"
         data-user-id="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)">
    <header class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h4 mb-0" data-en="Supplier invoices &amp; matching" data-bn="সরবরাহকারী ইনভয়েস ও মিল যাচাই">Supplier invoices &amp; matching</h1>
        <div class="d-flex gap-2 align-items-center">
            <button id="simHelp" type="button" class="btn btn-outline-secondary btn-sm" aria-controls="simGuidance" aria-expanded="false" aria-label="Matching help / সহায়তা">ⓘ</button>
            <a asp-controller="ProcurementGoodsReceipts" asp-action="Index" class="btn btn-outline-secondary btn-sm" data-en="Goods receipts" data-bn="পণ্য গ্রহণ">Goods receipts</a>
            <a href="/ProcurementSupplierReturns" class="btn btn-outline-secondary btn-sm" data-en="Supplier returns / credits" data-bn="পণ্য ফেরত / ক্রেডিট">Supplier returns / credits</a>
        </div>
    </header>
    <div id="simGuidance" class="alert alert-secondary small d-none" role="note">
        <span data-en="Match an approved PO to posted receipts; the preview never books a payable. Both Inventory and Finance modules must be enabled for this financial workspace. Save a supplier invoice, submit it for a separate Finance reviewer, then post it to the existing GL in an open period. Corrections use an independently approved reversal; no supplier cash payment is sent here."
              data-bn="অনুমোদিত ক্রয়াদেশ ও গৃহীত পণ্য মিলিয়ে প্রিভিউ করুন। এই আর্থিক পেজ ব্যবহারে ইনভেন্টরি ও ফাইন্যান্স উভয় মডিউল চালু থাকতে হবে। খসড়া ইনভয়েস সংরক্ষণ ও জমার পর আলাদা ফাইন্যান্স রিভিউয়ার খোলা মেয়াদে বিদ্যমান GL-এ পোস্ট করবেন। সংশোধনে আলাদা রিভার্সাল অনুমোদন লাগবে; এখানে টাকা পাঠানো হয় না।">Match an approved PO to posted receipts; the preview never books a payable. Both Inventory and Finance modules must be enabled for this financial workspace. Save a supplier invoice, submit it for a separate Finance reviewer, then post it to the existing GL in an open period. Corrections use an independently approved reversal; no supplier cash payment is sent here.</span>
    </div>
    <div id="simStatus" role="status" aria-live="polite" class="d-none"></div>
    <form id="simInvoiceFilters" class="row g-2 align-items-end mb-3">
        <div class="col-7 col-sm-4"><label for="simState" class="form-label" data-en="Supplier invoices" data-bn="সরবরাহকারী ইনভয়েস">Supplier invoices</label>
            <select id="simState" class="form-select"><option value="">All / সব</option><option>Draft</option><option>Submitted</option><option>Posted</option><option>Rejected</option><option>Reversed</option></select></div>
        <div class="col-5 col-sm-3"><button type="submit" class="btn btn-outline-primary w-100">Filter / ফিল্টার</button></div>
        <div class="col-12 col-sm-3"><button id="simExport" type="button" class="btn btn-outline-secondary w-100">CSV</button></div>
    </form>
    <div class="table-responsive mb-2"><table class="table table-sm table-striped"><thead><tr><th>Invoice</th><th>PO</th><th>Status</th><th>Amount BDT</th><th>Journal</th><th>Actions</th></tr></thead>
        <tbody id="simInvoiceRows"></tbody></table></div>
    <nav class="d-flex align-items-center gap-2 mb-4" aria-label="Supplier invoice pages">
        <button type="button" id="simPrev" class="btn btn-outline-secondary btn-sm">Previous</button>
        <span id="simPage" aria-live="polite"></span>
        <button type="button" id="simNext" class="btn btn-outline-secondary btn-sm">Next</button>
    </nav>
    <section id="supplierSettlement" class="border rounded p-3 mb-4" aria-labelledby="ssTitle"
             data-maker="@maker.ToString().ToLowerInvariant()" data-reviewer="@reviewer.ToString().ToLowerInvariant()">
        <h2 id="ssTitle" class="h6" data-en="Supplier payable settlement" data-bn="সরবরাহকারী দায় পরিশোধ">Supplier payable settlement</h2>
        <p class="small text-muted" data-en="Prepare and independently approve a bank disbursement. Only after external bank confirmation can Finance post the canonical GL. Reversal requires another independent decision; EduOS does not transfer bank funds."
           data-bn="ব্যাংক পরিশোধ প্রস্তুত ও স্বতন্ত্র অনুমোদন করুন। বাইরে ব্যাংক নিশ্চিত করলে তবেই ফাইন্যান্স মূল GL পোস্ট করবে। রিভার্সালে আলাদা স্বতন্ত্র অনুমোদন লাগে; EduOS নিজে ব্যাংকে টাকা পাঠায় না।">Prepare and independently approve a bank disbursement. Only after external bank confirmation can Finance post the canonical GL. Reversal requires another independent decision; EduOS does not transfer bank funds.</p>
        <p id="ssSelected" class="small fw-semibold" role="status" aria-live="polite" data-en="Open a posted supplier invoice and select Settlement." data-bn="পোস্টকৃত ইনভয়েস খুলে Settlement নির্বাচন করুন।">Open a posted supplier invoice and select Settlement.</p>
        <p id="ssStatus" class="small" role="status" aria-live="polite"></p>
        @if (maker) {
        <form id="ssForm" class="row g-2 align-items-end d-none">
            <div class="col-sm-3"><label for="ssAmount" class="form-label" data-en="Amount BDT" data-bn="টাকার পরিমাণ">Amount BDT</label><input id="ssAmount" type="number" min="0.01" step="0.01" class="form-control" required /></div>
            <div class="col-sm-3"><label for="ssDate" class="form-label" data-en="Planned date" data-bn="পরিকল্পিত তারিখ">Planned date</label><input id="ssDate" type="date" class="form-control" required /></div>
            <div class="col-sm-3"><label for="ssPeriod" class="form-label" data-en="Open period" data-bn="খোলা হিসাবকাল">Open period</label><select id="ssPeriod" class="form-select" required></select></div>
            <div class="col-sm-3"><label for="ssBank" class="form-label" data-en="Bank account" data-bn="ব্যাংক হিসাব">Bank account</label><select id="ssBank" class="form-select" required></select></div>
            <div class="col-12"><label for="ssReason" class="form-label" data-en="Documented reason (10–500)" data-bn="কারণ (১০–৫০০)">Documented reason (10–500)</label><textarea id="ssReason" class="form-control" minlength="10" maxlength="500" rows="2" required></textarea></div>
            <div class="col-12"><button id="ssSubmit" type="submit" class="btn btn-primary" data-en="Submit instruction (no payment)" data-bn="নির্দেশনা জমা (পরিশোধ নয়)">Submit instruction (no payment)</button></div>
        </form>}
        <div class="table-responsive mt-3"><table class="table table-sm table-striped"><thead><tr><th>Reference</th><th>State</th><th>Amount BDT</th><th>Planned</th><th>Maker</th><th>Action</th></tr></thead><tbody id="ssRows"></tbody></table></div>
        <nav class="d-flex gap-2 align-items-center"><button id="ssPrev" class="btn btn-outline-secondary btn-sm" type="button">Previous</button><span id="ssPage"></span><button id="ssNext" class="btn btn-outline-secondary btn-sm" type="button">Next</button></nav>
        <dialog id="ssWithdrawDialog" class="border rounded shadow p-0" aria-labelledby="ssWithdrawTitle" style="width:min(96vw,520px)">
            <form id="ssWithdrawForm" class="p-3">
                <h3 id="ssWithdrawTitle" class="h6" data-en="Withdraw submitted settlement instruction" data-bn="জমা দেওয়া পরিশোধ নির্দেশনা প্রত্যাহার">Withdraw submitted settlement instruction</h3>
                <p class="small text-muted" data-en="Only the original maker may withdraw before independent approval. The audit remains; no GL or bank transaction occurs."
                   data-bn="স্বতন্ত্র অনুমোদনের আগে শুধু মূল প্রস্তুতকারী প্রত্যাহার করতে পারবেন। অডিট থাকবে; GL বা ব্যাংক লেনদেন হবে না।">Only the original maker may withdraw before independent approval. The audit remains; no GL or bank transaction occurs.</p>
                <label for="ssWithdrawReason" class="form-label" data-en="Withdrawal reason (10–400)" data-bn="প্রত্যাহারের কারণ (১০–৪০০)">Withdrawal reason (10–400)</label>
                <textarea id="ssWithdrawReason" class="form-control" minlength="10" maxlength="400" rows="3" required></textarea>
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="button" id="ssWithdrawClose" class="btn btn-outline-secondary" data-en="Keep instruction" data-bn="নির্দেশনা রাখুন">Keep instruction</button>
                    <button id="ssWithdrawSubmit" type="submit" class="btn btn-outline-danger" data-en="Confirm withdrawal" data-bn="প্রত্যাহার নিশ্চিত করুন">Confirm withdrawal</button>
                </div>
            </form>
        </dialog>
        <dialog id="ssReviewDialog" class="border rounded shadow p-0" aria-labelledby="ssReviewTitle" style="width:min(96vw,520px)">
            <form id="ssReviewForm" class="p-3">
                <h3 id="ssReviewTitle" class="h6">Independent Finance decision / স্বতন্ত্র সিদ্ধান্ত</h3>
                <p class="small text-muted">Approval does not post a journal or execute payment.</p>
                <label for="ssDecision" class="form-label">Decision / সিদ্ধান্ত</label><select id="ssDecision" class="form-select"><option value="Approve">Approve instruction</option><option value="Reject">Reject</option></select>
                <label for="ssReviewReason" class="form-label mt-2">Evidence / কারণ (10–400)</label><textarea id="ssReviewReason" class="form-control" minlength="10" maxlength="400" rows="2" required></textarea>
                <div class="d-flex justify-content-end gap-2 mt-3"><button type="button" id="ssClose" class="btn btn-outline-secondary">Cancel</button><button id="ssReviewSubmit" type="submit" class="btn btn-primary">Confirm</button></div>
            </form>
        </dialog>
        <dialog id="ssPostDialog" class="border rounded shadow p-0" aria-labelledby="ssPostTitle" style="width:min(96vw,520px)">
            <form id="ssPostForm" class="p-3">
                <h3 id="ssPostTitle" class="h6" data-en="Confirm bank disbursement and post GL" data-bn="ব্যাংক পরিশোধ নিশ্চিত করে GL পোস্ট">Confirm bank disbursement and post GL</h3>
                <p class="small text-muted" data-en="Only use a completed external bank transaction. The date must match the approved instruction and its accounting period must remain open."
                   data-bn="শুধু বাইরে সম্পন্ন ব্যাংক লেনদেনের তথ্য দিন। তারিখ অনুমোদিত নির্দেশনার সমান ও হিসাবকাল খোলা থাকতে হবে।">Only use a completed external bank transaction. The date must match the approved instruction and its accounting period must remain open.</p>
                <label for="ssExecutedDate" class="form-label" data-en="Confirmed execution date" data-bn="নিশ্চিত পরিশোধের তারিখ">Confirmed execution date</label>
                <input id="ssExecutedDate" type="date" class="form-control" required />
                <label for="ssBankReference" class="form-label mt-2" data-en="External bank transaction reference (6–100)" data-bn="বাইরের ব্যাংক লেনদেন রেফারেন্স (৬–১০০)">External bank transaction reference (6–100)</label>
                <input id="ssBankReference" type="text" class="form-control" minlength="6" maxlength="100" pattern="[A-Za-z0-9][A-Za-z0-9./:_-]{5,99}" autocomplete="off" required />
                <div class="d-flex justify-content-end gap-2 mt-3"><button type="button" id="ssPostClose" class="btn btn-outline-secondary" data-en="Cancel" data-bn="বাতিল">Cancel</button><button type="submit" id="ssPostSubmit" class="btn btn-primary" data-en="Post confirmed payment" data-bn="নিশ্চিত পরিশোধ পোস্ট">Post confirmed payment</button></div>
            </form>
        </dialog>
        <dialog id="ssReverseDialog" class="border rounded shadow p-0" aria-labelledby="ssReverseTitle" style="width:min(96vw,520px)">
            <form id="ssReverseForm" class="p-3">
                <h3 id="ssReverseTitle" class="h6" data-en="Request full GL settlement reversal" data-bn="সম্পূর্ণ GL পরিশোধ রিভার্সালের আবেদন">Request full GL settlement reversal</h3>
                <label for="ssReverseDate" class="form-label" data-en="Reversal date" data-bn="রিভার্সাল তারিখ">Reversal date</label><input id="ssReverseDate" type="date" class="form-control" required />
                <label for="ssReversePeriod" class="form-label mt-2" data-en="Open accounting period" data-bn="খোলা হিসাবকাল">Open accounting period</label><select id="ssReversePeriod" class="form-select" required></select>
                <label for="ssReverseReason" class="form-label mt-2" data-en="Full reversal reason (10–800)" data-bn="সম্পূর্ণ রিভার্সালের কারণ (১০–৮০০)">Full reversal reason (10–800)</label><textarea id="ssReverseReason" class="form-control" minlength="10" maxlength="800" rows="2" required></textarea>
                <div class="d-flex justify-content-end gap-2 mt-3"><button type="button" id="ssReverseClose" class="btn btn-outline-secondary" data-en="Cancel" data-bn="বাতিল">Cancel</button><button type="submit" id="ssReverseSubmit" class="btn btn-outline-danger" data-en="Submit reversal request" data-bn="রিভার্সালের আবেদন জমা">Submit reversal request</button></div>
            </form>
        </dialog>
        <dialog id="ssContraDialog" class="border rounded shadow p-0" aria-labelledby="ssContraTitle" style="width:min(96vw,520px)">
            <form id="ssContraForm" class="p-3">
                <h3 id="ssContraTitle" class="h6" data-en="Independent settlement reversal decision" data-bn="স্বতন্ত্র পরিশোধ রিভার্সাল সিদ্ধান্ত">Independent settlement reversal decision</h3>
                <label for="ssContraDecision" class="form-label" data-en="Decision" data-bn="সিদ্ধান্ত">Decision</label><select id="ssContraDecision" class="form-select"><option value="Approve">Approve &amp; post contra GL</option><option value="Reject">Reject</option></select>
                <label for="ssContraReason" class="form-label mt-2" data-en="Decision evidence (10–300)" data-bn="সিদ্ধান্তের কারণ (১০–৩০০)">Decision evidence (10–300)</label><textarea id="ssContraReason" class="form-control" minlength="10" maxlength="300" rows="2" required></textarea>
                <div class="d-flex justify-content-end gap-2 mt-3"><button type="button" id="ssContraClose" class="btn btn-outline-secondary" data-en="Cancel" data-bn="বাতিল">Cancel</button><button type="submit" id="ssContraSubmit" class="btn btn-outline-danger" data-en="Confirm decision" data-bn="সিদ্ধান্ত নিশ্চিত">Confirm decision</button></div>
            </form>
        </dialog>
    </section>
    <section id="supplierPayableAging" class="border rounded p-3 mb-4" aria-labelledby="paTitle">
        <h2 id="paTitle" class="h6" data-en="Supplier payable aging — source-linked net GL" data-bn="সরবরাহকারীর দায়ের বয়স — উৎস-সংযুক্ত নেট GL">Supplier payable aging — source-linked net GL</h2>
        <p class="small text-muted" data-en="Net = posted AP minus verified, posted settlement journals (plus approved compensating reversals). Pending instructions do not count as paid. Unlinked bank entries are excluded; this is NOT bank-statement reconciliation."
           data-bn="নেট = পোস্টকৃত দায় থেকে যাচাইকৃত পোস্টকৃত পরিশোধ বাদ (অনুমোদিত রিভার্সাল যোগ)। অপেক্ষমাণ নির্দেশনা পরিশোধ নয়। উৎসবিহীন ব্যাংক লেনদেন বাদ; এটি ব্যাংক স্টেটমেন্টের পূর্ণ মিল নয়।">Net = posted AP minus verified, posted settlement journals (plus approved compensating reversals). Pending instructions do not count as paid. Unlinked bank entries are excluded; this is NOT bank-statement reconciliation.</p>
        <form id="paForm" class="row g-2 align-items-end mb-2">
            <div class="col-12 col-sm-4"><label for="paDate" class="form-label" data-en="Due-date reference" data-bn="নির্ধারিত তারিখের ভিত্তি">Due-date reference</label><input id="paDate" type="date" class="form-control" required /></div>
            <div class="col-12 col-sm-3"><label class="form-check-label d-flex gap-2 align-items-center pb-2"><input id="paOverdue" type="checkbox" class="form-check-input"/><span data-en="Overdue only" data-bn="শুধু মেয়াদোত্তীর্ণ">Overdue only</span></label></div>
            <div class="col-6 col-sm-2"><button class="btn btn-outline-primary w-100" type="submit" data-en="Apply" data-bn="প্রয়োগ">Apply</button></div>
            <div class="col-6 col-sm-2"><button id="paExport" class="btn btn-outline-secondary w-100" type="button">CSV</button></div>
        </form>
        <p id="paStatus" role="status" aria-live="polite" class="small"></p>
        <div class="table-responsive"><table class="table table-sm table-striped"><thead><tr>
            <th>Invoice</th><th>PO</th><th>Supplier</th><th>Campus</th><th>Due</th><th>Days</th><th>Bucket</th><th>Gross BDT</th><th>Posted BDT</th><th>Net BDT</th><th>Pending BDT</th><th>Integrity</th><th>Reversal</th>
        </tr></thead><tbody id="paRows"></tbody></table></div>
        <nav class="d-flex align-items-center gap-2" aria-label="Payable aging pages">
            <button id="paPrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
            <span id="paPage" aria-live="polite"></span>
            <button id="paNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
        </nav>
    </section>
    <form id="simSearchForm" class="row g-2 align-items-end mb-3">
        <div class="col-9 col-md-5"><label for="simSearch" class="form-label" data-en="Approved purchase order" data-bn="অনুমোদিত ক্রয়াদেশ">Approved purchase order</label>
            <input id="simSearch" class="form-control" maxlength="100" autocomplete="off" placeholder="Order number / ক্রয়াদেশ" /></div>
        <div class="col-3 col-md-2"><button type="submit" class="btn btn-outline-primary w-100" data-en="Find" data-bn="খুঁজুন">Find</button></div>
    </form>
    <div id="simOrderResults" class="list-group mb-3" aria-live="polite"></div>
    <form id="simPreviewForm" class="d-none">
        <h2 id="simOrderTitle" class="h6 mb-3"></h2>
        <div class="row g-2 mb-3"><div class="col-sm-6 col-lg-4">
            <label for="simMode" class="form-label" data-en="Invoice price policy" data-bn="ইনভয়েসের মূল্যনীতি">Invoice price policy</label>
            <select id="simMode" class="form-select"><option value="Automatic">Automatic / স্বয়ংক্রিয় (PO price)</option>
                <option value="ManualFinal">Manual Final / চূড়ান্ত মূল্য</option>
                <option value="AutoPlusManual">Auto + Manual Correction / সংশোধন</option></select>
        </div></div>
        @if (maker)
        {
            <div class="row g-2 mb-3">
                <div class="col-sm-4"><label for="simInvoiceNo" class="form-label">Supplier Invoice No / নম্বর</label>
                    <input id="simInvoiceNo" maxlength="100" class="form-control" autocomplete="off" /></div>
                <div class="col-sm-4"><label for="simInvoiceDate" class="form-label">Invoice Date / তারিখ</label>
                    <input type="date" id="simInvoiceDate" class="form-control" /></div>
                <div class="col-sm-4"><label for="simDueDate" class="form-label">Due Date / শেষ তারিখ</label>
                    <input type="date" id="simDueDate" class="form-control" /></div>
            </div>
        }
        <div class="table-responsive"><table class="table table-sm table-striped align-middle">
            <thead><tr><th scope="col">Receipt / গ্রহণ</th><th scope="col">Item / পণ্য</th><th scope="col">Lot / ব্যাচ</th>
                <th scope="col">Received / গৃহীত</th><th scope="col">PO price</th><th scope="col">Posted cost</th>
                <th scope="col">Invoice Qty / পরিমাণ</th><th scope="col" id="simAmountTitle">Price / correction</th><th scope="col">Variance reason / কারণ</th></tr></thead>
            <tbody id="simRows"></tbody>
        </table></div>
        @if (maker)
        {
            <label for="simReason" class="form-label">Invoice evidence / ইনভয়েস বিবরণ (10–800)</label>
            <textarea id="simReason" class="form-control mb-3" rows="2" minlength="10" maxlength="800"></textarea>
        }
        <div class="d-flex justify-content-end gap-2 mb-3 flex-wrap">
            <button type="submit" id="simRun" class="btn btn-outline-primary" data-en="Preview matching" data-bn="মিল যাচাই করুন">Preview matching</button>
            @if (maker) { <button type="button" id="simSave" class="btn btn-primary">Save invoice draft / খসড়া সংরক্ষণ</button> }
        </div>
    </form>
    <div id="simResult" class="d-none" aria-live="polite">
        <h2 class="h6" data-en="Read-only comparison" data-bn="শুধু-পাঠযোগ্য তুলনা">Read-only comparison</h2>
        <p id="simSummary" class="small fw-semibold"></p>
        <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Receipt</th><th>Item</th><th>Qty</th><th>Invoice Price</th><th>Invoice Amount (BDT)</th><th>Stock Value Difference (BDT)</th></tr></thead>
            <tbody id="simResultLines"></tbody></table></div>
    </div>
    <dialog id="simDetailDialog" aria-labelledby="simDetailTitle" class="border rounded shadow p-0" style="width:min(96vw,850px);max-height:90vh">
        <div class="p-3"><div class="d-flex justify-content-between align-items-center mb-2">
            <h2 id="simDetailTitle" class="h5 mb-0">Supplier invoice / ইনভয়েস</h2>
            <button type="button" id="simDetailClose" class="btn-close" aria-label="Close"></button></div>
            <p id="simDetailSummary" class="small"></p>
            <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Item</th><th>Quantity</th><th>PO Price</th><th>Stock Cost</th><th>Invoice Price</th><th>Amount</th></tr></thead><tbody id="simDetailLines"></tbody></table></div>
            <div id="simDetailActions" class="d-flex justify-content-end gap-2 flex-wrap"></div>
        </div>
    </dialog>
    <dialog id="simReviewDialog" aria-labelledby="simReviewTitle" class="border rounded shadow p-0" style="width:min(96vw,670px);max-height:90vh">
        <form id="simReviewForm" class="p-3"><div class="d-flex justify-content-between align-items-center mb-3">
            <h2 id="simReviewTitle" class="h5 mb-0">Independent Finance approval / যাচাই</h2>
            <button type="button" id="simReviewClose" class="btn-close" aria-label="Close"></button></div>
            <label for="simDecision" class="form-label">Decision / সিদ্ধান্ত</label>
            <select id="simDecision" class="form-select mb-2"><option value="Approve">Approve &amp; post payable</option><option value="Reject">Reject</option></select>
            <div id="simAccountPanel" class="row g-2 mb-2">
                <div class="col-12"><label for="simPeriod" class="form-label">Open period / হিসাবকাল</label><select id="simPeriod" class="form-select"></select></div>
                <div class="col-12"><label for="simAssetAccount" class="form-label">Inventory asset debit / সম্পদ ডেবিট</label><select id="simAssetAccount" class="form-select"></select></div>
                <div class="col-12"><label for="simPayableAccount" class="form-label">Supplier payable credit / দায় ক্রেডিট</label><select id="simPayableAccount" class="form-select"></select></div>
                <div class="col-12"><label for="simVarianceAccount" class="form-label">Price variance expense (if any) / মূল্যপার্থক্য</label><select id="simVarianceAccount" class="form-select"></select></div>
            </div>
            <label for="simReviewReason" class="form-label">Finance evidence / সিদ্ধান্তের কারণ (10–800)</label>
            <textarea id="simReviewReason" class="form-control" rows="2" minlength="10" maxlength="800" required></textarea>
            <div class="d-flex justify-content-end gap-2 mt-3"><button type="button" id="simReviewCancel" class="btn btn-outline-secondary">Cancel</button>
                <button type="submit" id="simReviewSubmit" class="btn btn-primary">Confirm / নিশ্চিত</button></div>
        </form>
    </dialog>
    <dialog id="simReversalDialog" aria-labelledby="simReversalTitle" class="border rounded shadow p-0" style="width:min(96vw,600px);max-height:90vh">
        <form id="simReversalForm" class="p-3"><div class="d-flex justify-content-between align-items-center mb-3">
            <h2 id="simReversalTitle" class="h5 mb-0">Request payable reversal / দায় রিভার্স</h2>
            <button type="button" id="simReversalClose" class="btn-close" aria-label="Close"></button></div>
            <label for="simReversalDate" class="form-label">Reversal date / তারিখ</label><input type="date" required id="simReversalDate" class="form-control mb-2" />
            <label for="simReversalPeriod" class="form-label">Open period / হিসাবকাল</label><select id="simReversalPeriod" class="form-select mb-2"></select>
            <label for="simReversalReason" class="form-label">Reason / কারণ (10–800)</label><textarea id="simReversalReason" required minlength="10" maxlength="800" rows="2" class="form-control"></textarea>
            <div class="d-flex justify-content-end gap-2 mt-3"><button type="button" id="simReversalCancel" class="btn btn-outline-secondary">Cancel</button>
                <button type="submit" id="simReversalSubmit" class="btn btn-primary">Request contra / অনুরোধ</button></div>
        </form>
    </dialog>
    <dialog id="simContraReviewDialog" aria-labelledby="simContraReviewTitle" class="border rounded shadow p-0" style="width:min(96vw,600px);max-height:90vh">
        <form id="simContraReviewForm" class="p-3"><div class="d-flex justify-content-between align-items-center mb-3">
            <h2 id="simContraReviewTitle" class="h5 mb-0">Independent reversal decision / রিভার্সাল যাচাই</h2>
            <button type="button" id="simContraReviewClose" class="btn-close" aria-label="Close"></button></div>
            <p class="small text-muted">Approval posts an exact compensating GL entry. Rejection leaves the original payable posted.</p>
            <label for="simContraDecision" class="form-label">Decision / সিদ্ধান্ত</label>
            <select id="simContraDecision" class="form-select mb-2"><option value="Approve">Approve contra posting</option><option value="Reject">Reject reversal request</option></select>
            <label for="simContraReason" class="form-label">Independent Finance evidence / কারণ (10–800)</label>
            <textarea id="simContraReason" required minlength="10" maxlength="800" rows="2" class="form-control"></textarea>
            <div class="d-flex justify-content-end gap-2 mt-3"><button type="button" id="simContraReviewCancel" class="btn btn-outline-secondary">Cancel</button>
                <button type="submit" id="simContraReviewSubmit" class="btn btn-primary">Confirm / নিশ্চিত</button></div>
        </form>
    </dialog>
</section>
@section Scripts { <script src="~/js/procurement/supplier-invoice-matching.js" asp-append-version="true"></script><script src="~/js/procurement/supplier-payable-aging.js" asp-append-version="true"></script><script src="~/js/procurement/supplier-settlement-instructions.js" asp-append-version="true"></script> }
