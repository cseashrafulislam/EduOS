@{
    ViewData["Title"] = "Purchase Requisitions";
    var maker = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") ||
        User.IsInRole("InventoryManager") || User.IsInRole("StoreKeeper");
    var checker = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("InventoryManager");
}
<section class="container-fluid py-3" id="procurementWorkspace" data-maker="@maker.ToString().ToLowerInvariant()"
         data-checker="@checker.ToString().ToLowerInvariant()" data-user-id="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)">
    <header class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <h1 class="h4 mb-0" data-i18n="title">Purchase requisitions</h1>
            <button class="btn btn-outline-secondary btn-sm" type="button" id="prHelp"
                    aria-label="Page help" aria-expanded="false">ⓘ</button>
        </div>
        <div class="d-flex gap-2">
            @if(checker) { <button class="btn btn-outline-primary btn-sm" type="button" id="prPending" aria-pressed="false" data-i18n="pending">Pending approvals</button> }
            <button class="btn btn-outline-secondary btn-sm" type="button" id="prExport" data-i18n="export">Excel / CSV</button>
            @if(maker) { <button class="btn btn-primary btn-sm" type="button" id="prNew" data-i18n="new">New requisition</button> }
        </div>
    </header>
    <div id="prHelpText" class="alert alert-light border d-none" role="note" data-i18n="help">Submit a draft for independent approval. Approval does not create stock or financial postings.</div>
    <div id="prAlert" class="d-none" role="status" aria-live="polite"></div>
    <form id="prFilters" class="row g-2 mb-3">
        <div class="col-12 col-md-3"><label for="prCampus" class="form-label" data-i18n="campus">Campus ID</label>
            <input id="prCampus" type="number" min="1" class="form-control" required /></div>
        <div class="col-6 col-md-3"><label for="prState" class="form-label" data-i18n="status">Status</label>
            <select id="prState" class="form-select"><option value="" data-i18n="all">All</option><option>Draft</option><option>Submitted</option><option>Approved</option><option>Rejected</option><option>Cancelled</option></select></div>
        <div class="col-6 col-md-4"><label for="prSearch" class="form-label" data-i18n="search">Search</label>
            <input id="prSearch" class="form-control" maxlength="100" /></div>
        <div class="col-12 col-md-2 d-flex align-items-end"><button class="btn btn-outline-primary w-100" type="submit" data-i18n="filter">Filter</button></div>
    </form>
    <div class="table-responsive"><table class="table table-striped table-hover">
        <thead><tr><th data-i18n="number">Number</th><th data-i18n="purpose">Purpose</th><th data-i18n="status">Status</th><th data-i18n="total">Estimated total</th><th data-i18n="created">Created</th><th data-i18n="actions">Actions</th></tr></thead>
        <tbody id="prRows"></tbody></table></div>
    <div class="d-flex align-items-center gap-2 mb-3">
        <button id="prPrev" class="btn btn-outline-secondary btn-sm" type="button" data-i18n="previous">Previous</button>
        <span id="prPage" aria-live="polite"></span>
        <button id="prNext" class="btn btn-outline-secondary btn-sm" type="button" data-i18n="next">Next</button>
    </div>
    <dialog id="prDialog" class="border rounded shadow p-0" style="width:min(95vw,850px);max-height:90vh">
        <form id="prForm" class="p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0" data-i18n="details">Requisition details</h2>
                <button id="prClose" type="button" class="btn-close" aria-label="Close"></button>
            </div>
            <input id="prId" type="hidden" /><input id="prVersion" type="hidden" /><input id="prRequestId" type="hidden" />
            <div class="row g-2">
                <div class="col-md-4"><label for="prFormCampus" class="form-label" data-i18n="campus">Campus ID</label>
                    <input id="prFormCampus" type="number" min="1" class="form-control" required /></div>
                <div class="col-md-8"><label for="prPurpose" class="form-label" data-i18n="purpose">Purpose</label>
                    <input id="prPurpose" class="form-control" maxlength="500" minlength="10" required /></div>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-3 mb-2">
                <h3 class="h6 mb-0" data-i18n="items">Requested items</h3>
                <button id="prAddLine" type="button" class="btn btn-outline-primary btn-sm" data-i18n="add">Add line</button>
            </div>
            <div id="prLines"></div>
            <section id="prItemDialog" class="border rounded p-2 mt-2" hidden aria-label="Choose inventory item">
                <h3 class="h6" data-i18n="choose">Choose inventory item</h3>
                <div id="prItemSearch" class="d-flex gap-2 mb-2">
                    <input id="prItemTerm" class="form-control" maxlength="100" aria-label="Item search" />
                    <button id="prItemSearchButton" class="btn btn-primary" type="button" data-i18n="search">Search</button>
                </div>
                <div id="prItemResults" class="list-group mb-2"></div>
                <button id="prItemClose" class="btn btn-outline-secondary btn-sm" type="button" data-i18n="close">Close</button>
            </section>
            <div class="mt-3">
                <button id="prHistoryButton" class="btn btn-outline-secondary btn-sm" type="button" data-i18n="history" hidden>Decision history</button>
                <section id="prHistory" class="border rounded p-2 mt-2" aria-label="Requisition history" hidden>
                    <ol id="prHistoryRows" class="list-group list-group-numbered mb-2"></ol>
                    <div class="d-flex align-items-center gap-2">
                        <button id="prHistoryPrev" class="btn btn-outline-secondary btn-sm" type="button" data-i18n="previous">Previous</button>
                        <span id="prHistoryPage" aria-live="polite"></span>
                        <button id="prHistoryNext" class="btn btn-outline-secondary btn-sm" type="button" data-i18n="next">Next</button>
                    </div>
                </section>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button id="prDismiss" type="button" class="btn btn-outline-secondary" data-i18n="close">Close</button>
                <button id="prSave" type="submit" class="btn btn-primary" data-i18n="save">Save draft</button>
            </div>
        </form>
    </dialog>

</section>
@section Scripts { <script src="~/js/procurement/requisitions.js" asp-append-version="true"></script> }
