@{
    ViewData["Title"] = "StudentDirectory";
    var strings = new
    {
        culture = CultureInfo.CurrentUICulture.Name,
        loading = T["LoadingStudents"].Value,
        empty = T["NoStudents"].Value,
        loadFailed = T["StudentsLoadFailed"].Value,
        detailsFailed = T["StudentDetailsFailed"].Value,
        retry = T["Retry"].Value,
        view = T["ViewDetails"].Value,
        studentCode = T["StudentCode"].Value,
        roll = T["Roll"].Value,
        academicUnit = T["AcademicUnit"].Value,
        academicYear = T["AcademicYear"].Value,
        section = T["Section"].Value,
        status = T["Status"].Value,
        dateOfBirth = T["DateOfBirth"].Value,
        gender = T["Gender"].Value,
        fullContact = T["FullContact"].Value,
        address = T["Address"].Value,
        admissionDate = T["AdmissionDate"].Value,
        guardian = T["GuardianInformation"].Value,
        enrollment = T["EnrollmentHistory"].Value,
        previous = T["Previous"].Value,
        next = T["Next"].Value,
        page = T["Page"].Value
    };
    var pageJson = System.Text.Json.JsonSerializer.Serialize(strings);
}

<section class="admission-page" aria-labelledby="studentDirectoryTitle">
    <header class="content-header-card">
        <div>
            <p class="dashboard-eyebrow">@T["Students"]</p>
            <h2 id="studentDirectoryTitle">@T["StudentDirectory"]</h2>
            <p>@T["StudentDirectoryHelp"]</p>
        </div>
        @if (User.IsInRole("TenantAdmin"))
        {
            <a class="btn btn-primary" asp-controller="EnrollmentManagement" asp-action="Index">Enroll Existing Student</a>
        }
        @if (User.IsInRole("TenantAdmin") || User.IsInRole("AdmissionOfficer"))
        {
            <a class="btn btn-outline-primary" asp-controller="LearnerIdentities" asp-action="Index">Register Learner Identity</a>
        }
        @if (User.IsInRole("TenantAdmin"))
        {
            <a class="btn btn-outline-danger" asp-controller="StudentLifecycle" asp-action="Index">Final Exit / TC</a>
            <a class="btn btn-outline-success" asp-controller="StudentReadmissions" asp-action="Index">Readmission</a>
            <a class="btn btn-outline-primary" asp-controller="StudentTransferRequests" asp-action="Index">Transfer Requests</a>
            <a class="btn btn-outline-primary" asp-controller="StudentGuardians" asp-action="Index">Manage Guardians</a>
        }
        @if (User.IsInRole("TenantAdmin"))
        {
            <a class="btn btn-outline-primary" data-student-promotion-link asp-controller="StudentProgressions" asp-action="Index">Promotion / Repeat</a>
        }
    </header>

    <div id="studentAlert" class="d-none" role="alert" tabindex="-1"></div>
    <section class="content-card" aria-labelledby="studentListTitle">
        <div class="content-card-heading"><h3 id="studentListTitle">@T["Students"]</h3></div>
        <form id="studentFilters" class="admission-filters" role="search">
            <label class="visually-hidden" for="studentSearch">@T["SearchStudents"]</label>
            <input class="form-control" id="studentSearch" maxlength="100" placeholder="@T["SearchStudents"]" />
            <label class="visually-hidden" for="studentStatus">@T["Status"]</label>
            <select class="form-select" id="studentStatus">
                <option value="">@T["AllStatuses"]</option>
                <option value="Active">@T["Active"]</option>
                <option value="Suspended">@T["Suspended"]</option>
                <option value="TC">@T["Transferred"]</option>
                <option value="Passed">@T["Passed"]</option>
                <option value="Dropout">@T["Dropout"]</option>
                <option value="Archived">@T["Archived"]</option>
            </select>
            <button class="btn btn-outline-primary" type="submit">@T["Search"]</button>
        </form>
        <div id="studentList" class="admission-list" aria-live="polite" aria-busy="true"></div>
        <nav class="admission-pagination" aria-label="@T["StudentPagination"]">
            <button id="studentPrevious" class="btn btn-sm btn-outline-secondary" type="button">@T["Previous"]</button>
            <span id="studentPageStatus"></span>
            <button id="studentNext" class="btn btn-sm btn-outline-secondary" type="button">@T["Next"]</button>
        </nav>
    </section>
</section>

<div class="modal fade" id="studentModal" tabindex="-1" aria-labelledby="studentModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-4">
            <div class="modal-header">
                <h2 class="modal-title h5" id="studentModalTitle">@T["StudentProfile"]</h2>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
            </div>
            <div class="modal-body">
                <dl id="studentDetails" class="admission-details"></dl>
                @if (User.IsInRole("TenantAdmin"))
                {
                    <section class="border rounded p-3 mb-3" aria-labelledby="studentPhotoTitle">
                        <h3 id="studentPhotoTitle" class="h6">Student profile photo</h3>
                        <img id="studentPhotoPreview" alt="Student profile photo" width="120" height="120" class="d-none rounded border mb-2" style="object-fit:cover" />
                        <form id="studentPhotoForm" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <label class="form-label" for="studentPhotoFile">Choose a JPG, PNG or WebP image (maximum 2 MB)</label>
                            <input id="studentPhotoFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" required />
                            <button id="studentPhotoSubmit" class="btn btn-outline-primary btn-sm mt-2" type="submit">Save photo</button>
                            <div id="studentPhotoStatus" role="status" aria-live="polite" class="small mt-2"></div>
                        </form>
                    </section>
                }
                @if (User.IsInRole("TenantAdmin"))
                {
                    <section class="border rounded p-3 mb-3" aria-labelledby="studentContactTitle">
                        <h3 id="studentContactTitle" class="h6">Student contact profile</h3>
                        <p class="small text-muted">Update institution contact details only. Identity, enrollment and historical snapshots remain unchanged.</p>
                        <form id="studentContactForm" autocomplete="off">
                            @Html.AntiForgeryToken()
                            <div class="row g-2">
                                <div class="col-md-6"><label class="form-label" for="studentContactPhone">Phone</label>
                                    <input id="studentContactPhone" class="form-control" maxlength="30" /></div>
                                <div class="col-md-6"><label class="form-label" for="studentContactEmail">Email</label>
                                    <input id="studentContactEmail" type="email" class="form-control" maxlength="200" /></div>
                                <div class="col-12"><label class="form-label" for="studentContactAddress">Contact address</label>
                                    <textarea id="studentContactAddress" class="form-control" rows="2" maxlength="1000"></textarea></div>
                                <div class="col-md-4"><label class="form-label" for="studentContactLanguage">Preferred language</label>
                                    <select id="studentContactLanguage" class="form-select">
                                        <option value="bn-BD">Bangla</option><option value="en-BD">English (Bangladesh)</option>
                                        <option value="en-US">English (US)</option>
                                    </select></div>
                                <div class="col-md-8"><label class="form-label" for="studentContactReason">Change reason</label>
                                    <input id="studentContactReason" class="form-control" required minlength="10" maxlength="500" placeholder="Why is the contact information changing?" /></div>
                            </div>
                            <button id="studentContactSave" type="submit" class="btn btn-outline-primary btn-sm mt-2" disabled>Save contact profile</button>
                            <div id="studentContactStatus" role="status" aria-live="polite" class="small mt-2"></div>
                        </form>
                    </section>
                }
                @if (User.IsInRole("TenantAdmin"))
                {
                    <section class="border rounded p-3 mb-3" aria-labelledby="studentOperationalTitle">
                        <h3 id="studentOperationalTitle" class="h6">Student operational status</h3>
                        <p class="small text-muted">Suspend or reactivate an active enrollment's student. Exit, readmission, seat allocation and historic records are managed separately.</p>
                        <form id="studentOperationalStatusForm" autocomplete="off">
                            @Html.AntiForgeryToken()
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="form-label" for="studentOperationalTarget">New status</label>
                                    <select id="studentOperationalTarget" class="form-select" required>
                                        <option value="Suspended">Suspended</option>
                                        <option value="Active">Active</option>
                                    </select>
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label" for="studentOperationalReason">Reason</label>
                                    <input id="studentOperationalReason" class="form-control" required minlength="10" maxlength="500" placeholder="Record the authorized reason" />
                                </div>
                            </div>
                            <button id="studentOperationalSave" type="submit" class="btn btn-outline-warning btn-sm mt-2" disabled>Update status</button>
                            <div id="studentOperationalMessage" role="status" aria-live="polite" class="small mt-2"></div>
                        </form>
                    </section>
                }
                <section aria-labelledby="guardianTitle"><h3 class="h6" id="guardianTitle">@T["GuardianInformation"]</h3><div id="studentGuardians" class="admission-list"></div></section>
                <section class="mt-4" aria-labelledby="enrollmentTitle"><h3 class="h6" id="enrollmentTitle">@T["EnrollmentHistory"]</h3><div id="studentEnrollments" class="admission-list"></div></section>
                @if (User.IsInRole("TenantAdmin"))
                {
                    <section class="mt-4" aria-labelledby="lifecycleTimelineTitle">
                        <h3 class="h6" id="lifecycleTimelineTitle">Lifecycle history</h3>
                        <p class="small text-muted">Historical status, progression and exit events. Visible to institution administrators only.</p>
                        <div id="studentLifecycleTimeline" aria-live="polite"></div>
                        <nav class="d-flex align-items-center gap-2 mt-2" aria-label="Lifecycle history pages">
                            <button id="studentLifecyclePrevious" class="btn btn-sm btn-outline-secondary" type="button" disabled>Previous</button>
                            <span id="studentLifecyclePage" class="small text-muted" aria-live="polite"></span>
                            <button id="studentLifecycleNext" class="btn btn-sm btn-outline-secondary" type="button" disabled>Next</button>
                        </nav>
                    </section>
                }
            </div>
            <div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">@T["Close"]</button></div>
        </div>
    </div>
</div>

<script id="studentStrings" type="application/json">@Html.Raw(pageJson)</script>

@section Scripts {
    <script src="~/js/students/index.js" asp-append-version="true"></script>
    @if (User.IsInRole("TenantAdmin"))
    {
        <script src="~/js/students/lifecycle-timeline.js" asp-append-version="true"></script>
        <script src="~/js/students/photo.js" asp-append-version="true"></script>
        <script src="~/js/students/contact-profile.js" asp-append-version="true"></script>
        <script src="~/js/students/operational-status.js" asp-append-version="true"></script>
    }
}
