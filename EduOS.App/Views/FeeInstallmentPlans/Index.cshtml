@{
    ViewData["Title"] = "Student Instalment Agreements";
}
<section id="feePlanApp" class="container-fluid py-3">
    <header class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 d-print-none">
        <div class="d-flex align-items-center gap-2">
            <h1 class="h4 mb-0">Student Instalment Agreements</h1>
            <details class="position-relative">
                <summary class="btn btn-outline-secondary btn-sm" aria-label="Instalment plan help" title="Plan guide">ⓘ</summary>
                <div class="position-absolute border rounded bg-body p-2 small shadow-sm" style="z-index:5;width:min(23rem,80vw);right:0">
                    Search a student, choose their academic batch and monthly fee structure, then save a gross plan draft. Submit for independent tenant-admin approval. Approved plans preserve due dates and fee-head amounts but do not issue invoices or collect money. Legacy monthly billing is blocked for planned months until approved invoice linkage is implemented. Cancellation is audited and blocked once invoices exist.
                </div>
            </details>
        </div>
        <a class="btn btn-outline-secondary btn-sm" href="/FeeOperations/Index">Fees &amp; Billing</a>
    </header>
    <div id="feePlanNotice" class="alert d-none d-print-none" role="status" aria-live="polite" tabindex="-1"></div>
    <form id="feePlanCreate" class="card card-body mb-3 d-print-none">
        @Html.AntiForgeryToken()
        <div class="row g-2 align-items-end">
            <div class="col-lg-3"><label class="form-label" for="feePlanStudentSearch">Student code or name</label>
                <input id="feePlanStudentSearch" class="form-control" minlength="2" maxlength="100" autocomplete="off" required />
                <select id="feePlanStudent" class="form-select mt-1" required aria-label="Matched student"><option value="">Search for student</option></select></div>
            <div class="col-lg-3"><label class="form-label" for="feePlanBatch">Academic batch</label>
                <select id="feePlanBatch" class="form-select" required><option value="">Loading…</option></select></div>
            <div class="col-lg-3"><label class="form-label" for="feePlanStructure">Monthly fee structure</label>
                <select id="feePlanStructure" class="form-select" required><option value="">Choose batch</option></select></div>
            <div class="col-lg-2"><label class="form-label" for="feePlanMonth">Start month</label>
                <input id="feePlanMonth" type="month" class="form-control" required /></div>
            <div class="col-lg-1"><label class="form-label" for="feePlanMonths">Months</label>
                <select id="feePlanMonths" class="form-select"><option>1</option><option>3</option><option selected>6</option><option>9</option><option>12</option></select></div>
            <div class="col-12 d-flex justify-content-end"><button id="feePlanSave" type="submit" class="btn btn-primary">Save Draft</button></div>
        </div>
    </form>
    <section class="card mb-3">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <strong>Agreement register</strong>
            <div class="d-flex align-items-center gap-2 d-print-none">
                <label for="feePlanCampus" class="visually-hidden">Campus</label>
                <select id="feePlanCampus" class="form-select form-select-sm"><option value="">All authorized campuses</option></select>
                <button id="feePlanRefresh" class="btn btn-outline-secondary btn-sm" type="button">Refresh</button>
                <button id="feePlanCsv" class="btn btn-outline-primary btn-sm" type="button" disabled>Export Page CSV</button>
                <button id="feePlanPrint" class="btn btn-outline-secondary btn-sm" type="button" disabled>Print</button>
            </div>
        </div>
        <div class="table-responsive"><table class="table table-sm table-striped mb-0">
            <thead><tr><th>Student</th><th>Months</th><th>Campus</th><th>Status</th>
                <th class="text-end">Gross BDT</th><th class="d-print-none">Action</th></tr></thead>
            <tbody id="feePlanRows"><tr><td colspan="6" class="text-muted text-center p-3">Loading…</td></tr></tbody>
        </table></div>
        <div class="card-footer d-flex justify-content-end align-items-center gap-2 d-print-none">
            <button id="feePlanPrevious" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous</button>
            <span id="feePlanPage" class="small"></span>
            <button id="feePlanNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next</button>
        </div>
    </section>
    <section id="feePlanDetail" class="card d-none" aria-live="polite">
        <div class="card-header d-flex justify-content-between align-items-center gap-2">
            <strong id="feePlanDetailTitle">Agreement</strong>
            <div class="d-flex gap-2 d-print-none">
                <button id="feePlanSubmit" class="btn btn-outline-primary btn-sm" type="button">Submit</button>
                @if (User.IsInRole("TenantAdmin"))
                {
                    <button id="feePlanApprove" class="btn btn-primary btn-sm" type="button">Approve</button>
                    <button id="feePlanCancel" class="btn btn-outline-danger btn-sm" type="button">Cancel</button>
                }
            </div>
        </div>
        <div class="table-responsive"><table class="table table-sm mb-0">
            <thead><tr><th>Month</th><th>Due date</th><th>Fee head</th><th class="text-end">Gross BDT</th></tr></thead>
            <tbody id="feePlanDetailRows"></tbody>
        </table></div>
        <div id="feePlanHistory" class="card-footer small"></div>
    </section>
    <dialog id="feePlanCancelDialog" class="border rounded shadow p-3" aria-labelledby="feePlanCancelHeading">
        <form id="feePlanCancelForm" method="dialog" class="d-grid gap-2" style="width:min(26rem,80vw)">
            <h2 id="feePlanCancelHeading" class="h5">Cancel agreement</h2>
            <label class="form-label" for="feePlanCancelReason">Reason</label>
            <textarea id="feePlanCancelReason" class="form-control" maxlength="250" rows="3" required></textarea>
            <div class="d-flex justify-content-end gap-2">
                <button type="button" id="feePlanCancelDismiss" class="btn btn-outline-secondary">Keep agreement</button>
                <button type="submit" class="btn btn-danger">Confirm cancellation</button>
            </div>
        </form>
    </dialog>
</section>
@section Scripts {
    <script src="~/js/finance/fee-installment-plans.js" asp-append-version="true"></script>
}
