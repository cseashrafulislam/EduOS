@{
    ViewData["Title"] = "Student Instalment Agreements";
}
<section id="feePlanApp" class="container-fluid py-2">

    <div id="feePlanNotice" class="alert d-none d-print-none" role="status" aria-live="polite" tabindex="-1"></div>
    <form id="feePlanCreate" class="card card-body mb-2 d-print-none">
        @Html.AntiForgeryToken()
        <div class="row g-2 align-items-end">
            <div class="col-lg-3"><label class="form-label" for="feePlanStudentSearch">Student code or name</label>
                <input id="feePlanStudentSearch" class="form-control" minlength="2" maxlength="100" autocomplete="off" required />
                <select id="feePlanStudent" class="form-select mt-1" required aria-label="Matched student"><option value="">Search for student</option></select></div>
            <div class="col-lg-3"><label class="form-label" for="feePlanBatch">Academic batch</label>
                <select id="feePlanBatch" class="form-select" required><option value="">Loading…</option></select></div>
            <div class="col-lg-3"><label class="form-label" for="feePlanStructure">Monthly fee structure</label>
                <select id="feePlanStructure" class="form-select" required><option value="">Choose batch</option></select></div>
            <div class="col-lg-2"><label class="form-label" for="feePlanMonth">Start month</label>
                <input id="feePlanMonth" type="month" class="form-control" required /></div>
            <div class="col-lg-1"><label class="form-label" for="feePlanMonths">Months</label>
                <select id="feePlanMonths" class="form-select"><option>1</option><option>3</option><option selected>6</option><option>9</option><option>12</option></select></div>
            <div class="col-lg-6"><label class="form-label" for="feePlanWeights">Monthly shares (%) — optional</label>
                <input id="feePlanWeights" class="form-control" maxlength="100" inputmode="decimal" autocomplete="off" placeholder="Example for 3 months: 50,25,25" /></div>
            <div class="col-12 d-flex justify-content-end"><button id="feePlanSave" type="submit" class="btn btn-primary">Save Draft</button></div>
        </div>
    </form>
    <section class="card mb-3">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <strong>Agreement register</strong>
            <div class="d-flex flex-wrap align-items-center gap-2 d-print-none">
                <a class="btn btn-outline-secondary btn-sm" href="/FeeOperations/Index">Fees &amp; Billing</a>
                <label for="feePlanCampus" class="visually-hidden">Campus</label>
                <select id="feePlanCampus" class="form-select form-select-sm"><option value="">All authorized campuses</option></select>
                <label for="feePlanFilterSearch" class="visually-hidden">Search student code or name</label>
                <input id="feePlanFilterSearch" type="search" class="form-control form-control-sm" maxlength="100" placeholder="Search student" autocomplete="off" />
                <label for="feePlanState" class="visually-hidden">Agreement status</label>
                <select id="feePlanState" class="form-select form-select-sm" aria-label="Agreement status">
                    <option value="">All states</option><option value="1">Draft</option>
                    <option value="2">Submitted</option><option value="3">Approved</option>
                    <option value="4">Cancelled</option>
                </select>
                @if (User.IsInRole("TenantAdmin"))
                {
                    <label class="d-flex align-items-center gap-1 small text-nowrap mb-0" for="feePlanMyQueue">
                        <input id="feePlanMyQueue" type="checkbox" class="form-check-input mt-0" />
                        My approval queue
                    </label>
                }
                <button id="feePlanRefresh" class="btn btn-outline-secondary btn-sm" type="button">Apply filters</button>
                <button id="feePlanCsv" class="btn btn-outline-primary btn-sm" type="button" disabled>Export Page CSV</button>
                <button id="feePlanPrint" class="btn btn-outline-secondary btn-sm" type="button" disabled>Print</button>
            </div>
        </div>
        <div class="table-responsive"><table class="table table-sm table-striped mb-0">
            <thead><tr><th>Student</th><th>Months</th><th>Campus</th><th>Status</th>
                <th class="text-end">Gross BDT</th><th class="d-print-none">Action</th></tr></thead>
            <tbody id="feePlanRows"><tr><td colspan="6" class="text-muted text-center p-3">Loading…</td></tr></tbody>
        </table></div>
        <div class="card-footer d-flex justify-content-end align-items-center gap-2 d-print-none">
            <button id="feePlanPrevious" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous</button>
            <span id="feePlanPage" class="small"></span>
            <button id="feePlanNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next</button>
        </div>
    </section>
    <section id="feePlanDetail" class="card d-none" aria-live="polite">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <strong id="feePlanDetailTitle">Agreement</strong>
            <div class="d-flex flex-wrap gap-2 d-print-none">
                <button id="feePlanAuditOpen" class="btn btn-outline-secondary btn-sm" type="button">Billing Audit</button>
                <button id="feePlanSubmit" class="btn btn-outline-primary btn-sm" type="button">Submit</button>
                <label for="feePlanIssueMonth" class="visually-hidden">Invoice month</label>
                <select id="feePlanIssueMonth" class="form-select form-select-sm" hidden aria-label="Approved invoice month"></select>
                <button id="feePlanPreview" class="btn btn-outline-secondary btn-sm" type="button" hidden>Preview Month</button>
                <button id="feePlanIssue" class="btn btn-outline-success btn-sm" type="button" hidden>Issue Month Invoice</button>
                @if (User.IsInRole("TenantAdmin"))
                {
                    <button id="feePlanApprove" class="btn btn-primary btn-sm" type="button">Approve</button>
                    <button id="feePlanReplace" class="btn btn-outline-primary btn-sm" type="button" hidden>Replace Agreement</button>
                    <button id="feePlanCancel" class="btn btn-outline-danger btn-sm" type="button">Cancel</button>
                }
            </div>
        </div>
        <div class="table-responsive"><table class="table table-sm mb-0">
            <thead><tr><th>Month</th><th>Due date</th><th>Fee head</th><th class="text-end">Gross BDT</th><th>Invoice</th></tr></thead>
            <tbody id="feePlanDetailRows"></tbody>
        </table></div>
        <div id="feePlanHistory" class="card-footer small"></div>
    </section>
    <section id="feePlanAudit" class="card mt-3 d-none" aria-live="polite">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <strong>Instalment billing reconciliation</strong>
            <div class="d-flex gap-2 d-print-none">
                <button id="feePlanAuditCsv" type="button" class="btn btn-outline-primary btn-sm" disabled>Export Audit CSV</button>
                <button id="feePlanAuditPrint" type="button" class="btn btn-outline-secondary btn-sm" disabled>Print Audit</button>
            </div>
        </div>
        <div id="feePlanAuditSummary" class="card-body small"></div>
        <div class="table-responsive"><table class="table table-sm table-striped mb-0">
            <thead><tr><th>Month</th><th>Due</th><th class="text-end">Contract gross</th>
                <th>Invoice</th><th class="text-end">Invoice net</th><th class="text-end">Paid</th>
                <th class="text-end">Due</th><th>Status</th><th>Review findings</th></tr></thead>
            <tbody id="feePlanAuditRows"></tbody>
        </table></div>
    </section>
    <style media="print">
        #feePlanApp.audit-print #feePlanCreate,
        #feePlanApp.audit-print > section.card:not(#feePlanAudit),
        #feePlanApp.audit-print #feePlanNotice { display:none!important; }
        #feePlanApp.audit-print #feePlanAudit { display:block!important; }
    </style>
    <dialog id="feePlanPreviewDialog" class="border rounded shadow p-3" aria-labelledby="feePlanPreviewHeading">
        <div class="d-grid gap-2" style="width:min(40rem,85vw)">
            <h2 id="feePlanPreviewHeading" class="h5">Monthly invoice preview</h2>
            <div id="feePlanPreviewSummary" class="fw-semibold" aria-live="polite"></div>
            <div class="table-responsive"><table class="table table-sm mb-0">
                <thead><tr><th>Fee head</th><th>Due date</th><th class="text-end">Gross</th>
                    <th class="text-end">Discount</th><th class="text-end">Net</th></tr></thead>
                <tbody id="feePlanPreviewRows"></tbody>
            </table></div>
            <div class="d-flex justify-content-end gap-2">
                <button id="feePlanPreviewClose" type="button" class="btn btn-outline-secondary">Close</button>
                <button id="feePlanPreviewIssue" type="button" class="btn btn-primary">Issue this invoice</button>
            </div>
        </div>
    </dialog>
    <dialog id="feePlanReplaceDialog" class="border rounded shadow p-3" aria-labelledby="feePlanReplaceHeading">
        <form id="feePlanReplaceForm" class="d-grid gap-2" style="width:min(28rem,80vw)">
            <h2 id="feePlanReplaceHeading" class="h5">Request agreement replacement</h2>
            <label for="feePlanReplaceStructure" class="form-label">Replacement monthly fee structure</label>
            <select id="feePlanReplaceStructure" class="form-select" required></select>
            <label for="feePlanReplaceWeights" class="form-label">New monthly shares (%) — optional</label>
            <input id="feePlanReplaceWeights" class="form-control" maxlength="100" inputmode="decimal" autocomplete="off" placeholder="Blank for equal monthly shares" />
            <label for="feePlanReplaceReason" class="form-label">Reason for replacement</label>
            <textarea id="feePlanReplaceReason" class="form-control" minlength="3" maxlength="150" rows="3" required></textarea>
            <div class="d-flex justify-content-end gap-2">
                <button id="feePlanReplaceDismiss" type="button" class="btn btn-outline-secondary">Keep agreement</button>
                <button id="feePlanReplaceConfirm" type="submit" class="btn btn-primary">Submit replacement</button>
            </div>
        </form>
    </dialog>
    <dialog id="feePlanCancelDialog" class="border rounded shadow p-3" aria-labelledby="feePlanCancelHeading">
        <form id="feePlanCancelForm" method="dialog" class="d-grid gap-2" style="width:min(26rem,80vw)">
            <h2 id="feePlanCancelHeading" class="h5">Cancel agreement</h2>
            <label class="form-label" for="feePlanCancelReason">Reason</label>
            <textarea id="feePlanCancelReason" class="form-control" maxlength="250" rows="3" required></textarea>
            <div class="d-flex justify-content-end gap-2">
                <button type="button" id="feePlanCancelDismiss" class="btn btn-outline-secondary">Keep agreement</button>
                <button type="submit" class="btn btn-danger">Confirm cancellation</button>
            </div>
        </form>
    </dialog>
</section>
@section Scripts {
    <script src="~/js/finance/fee-installment-plans.js" asp-append-version="true"></script>
}
