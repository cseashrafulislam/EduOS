@{
    ViewData["Title"] = "Grade Scheme Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="container-fluid py-4" id="gradeSchemeWorkspace">
    @Html.AntiForgeryToken()
    <header class="d-flex justify-content-between flex-wrap gap-2 mb-3">
        <div><h1 class="h4 mb-1">Grade schemes</h1>
            <p class="text-muted mb-0">Create grading policies and inspect their rules. Saved schemes are immutable; create a new code for a revised policy.</p></div>
        <a asp-controller="AssessmentAdministration" asp-action="Index" class="btn btn-outline-secondary">Exam marks &amp; results</a>
    </header>
    <div id="gradeSchemeNotice" class="alert d-none" role="alert" aria-live="polite"></div>
    <div class="card mb-3" id="gradeSchemeCreatePanel"><div class="card-body">
        <h2 class="h6">New grade scheme</h2>
        <form id="gradeSchemeForm">
            <div class="row g-3">
                <div class="col-md-4"><label for="gradeSchemeCode" class="form-label">Code</label>
                    <input id="gradeSchemeCode" class="form-control" maxlength="50" required /></div>
                <div class="col-md-5"><label for="gradeSchemeName" class="form-label">Name</label>
                    <input id="gradeSchemeName" class="form-control" maxlength="150" required /></div>
                <div class="col-md-3"><label for="gradeSchemeProgram" class="form-label">Program ID (optional)</label>
                    <input id="gradeSchemeProgram" type="number" class="form-control" min="1" step="1" placeholder="Tenant-wide if blank" /></div>
                <div class="col-auto form-check ms-3"><input id="gradeSchemeActive" class="form-check-input" type="checkbox" checked />
                    <label for="gradeSchemeActive" class="form-check-label">Active</label></div>
                <div class="col-auto form-check"><input id="gradeSchemeDefault" class="form-check-input" type="checkbox" />
                    <label for="gradeSchemeDefault" class="form-check-label">Default for this program scope</label></div>
                <div class="col-md-4"><label for="gradeSchemeGpaMode" class="form-label">GPA calculation</label>
                    <select id="gradeSchemeGpaMode" class="form-select">
                        <option value="overall">Overall percentage</option>
                        <option value="credits">Course credits (weighted)</option>
                    </select></div>
            </div>
            <p class="small text-muted mt-3 mb-2">Rules must cover 0.00–100.00 continuously in 0.01 increments, without overlaps. Grade letters must be unique.</p>
            <div class="table-responsive"><table class="table table-sm align-middle">
                <thead><tr><th>From %</th><th>To %</th><th>Letter</th><th>Point</th><th>Fail</th><th>Action</th></tr></thead>
                <tbody id="gradeSchemeRuleEditor"></tbody>
            </table></div>
            <div class="d-flex gap-2 flex-wrap">
                <button id="gradeSchemeAddRule" type="button" class="btn btn-outline-secondary">Add grade interval</button>
                <button id="gradeSchemeSave" type="submit" class="btn btn-primary">Create immutable scheme</button>
                <button id="gradeSchemeClear" type="button" class="btn btn-outline-secondary">Clear</button>
            </div>
        </form>
    </div></div>
    <div class="card"><div class="card-body">
        <h2 class="h6">Grade scheme register</h2>
        <div class="d-flex flex-wrap gap-2 align-items-end mb-3">
            <div class="flex-grow-1"><label for="gradeSchemeSearch" class="form-label">Name or code</label>
                <input id="gradeSchemeSearch" class="form-control" maxlength="100" /></div>
            <div class="form-check mb-2"><input id="gradeSchemeActiveOnly" type="checkbox" class="form-check-input" />
                <label for="gradeSchemeActiveOnly" class="form-check-label">Active only</label></div>
            <button id="gradeSchemeRefresh" type="button" class="btn btn-outline-primary">Search</button>
            <button id="gradeSchemeCsv" type="button" class="btn btn-outline-secondary">CSV (current page)</button>
            <button id="gradeSchemePrint" type="button" class="btn btn-outline-secondary">Print</button>
        </div>
        <div class="table-responsive"><table class="table table-sm table-hover">
            <thead><tr><th>Code</th><th>Name</th><th>Program</th><th>GPA</th><th>Rules</th><th>Active</th><th>Default</th><th class="grade-scheme-action">Details</th></tr></thead>
            <tbody id="gradeSchemeRows"></tbody>
        </table></div>
        <div class="d-flex justify-content-between align-items-center">
            <span id="gradeSchemeCount" class="text-muted small"></span>
            <div class="d-flex gap-2">
                <button id="gradeSchemePrev" type="button" class="btn btn-sm btn-outline-secondary">Previous</button>
                <button id="gradeSchemeNext" type="button" class="btn btn-sm btn-outline-secondary">Next</button>
            </div>
        </div>
        <div id="gradeSchemeDetail" class="mt-3 d-none" aria-live="polite">
            <h3 id="gradeSchemeDetailTitle" class="h6"></h3>
            <p class="small text-muted">Read-only grade rules. Changes require a new version/code.</p>
            <div class="table-responsive"><table class="table table-sm">
                <thead><tr><th>From</th><th>To</th><th>Letter</th><th>Point</th><th>Fail</th></tr></thead>
                <tbody id="gradeSchemeDetailRules"></tbody>
            </table></div>
        </div>
    </div></div>
</section>
<style>
@@media print {
    #gradeSchemeCreatePanel, #gradeSchemeRefresh, #gradeSchemeCsv, #gradeSchemePrint,
    #gradeSchemeSearch, #gradeSchemeActiveOnly, #gradeSchemePrev, #gradeSchemeNext,
    #gradeSchemeNotice, .grade-scheme-action { display: none !important; }
}
</style>
@section Scripts { <script src="~/js/assessment/grade-schemes.js" asp-append-version="true"></script> }
