@{
    ViewData["Title"] = "Exam Marks & Results";
    var canPublish = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("VicePrincipal") || User.IsInRole("ExamController");
}
<section class="container-fluid py-3" id="examWorkflow" data-can-publish="@canPublish.ToString().ToLowerInvariant()">
    @Html.AntiForgeryToken()
    <header class="mb-3 d-flex flex-wrap align-items-start gap-2">
        <h2 class="h4 mb-0">Exam Marks & Results</h2>
        <a class="btn btn-sm btn-outline-primary" asp-controller="AssessmentAdministration" asp-action="MarkReviews">Marks review</a>
        @if (canPublish) { <a class="btn btn-sm btn-outline-primary" asp-controller="AssessmentAdministration" asp-action="GradeDistribution">Grade distribution</a> }
        @if (canPublish) { <a class="btn btn-sm btn-outline-primary" asp-controller="AssessmentAdministration" asp-action="ResultRescrutiny">Result re-scrutiny</a> }
        @if (canPublish) { <a class="btn btn-sm btn-outline-primary" asp-controller="AssessmentAdministration" asp-action="ResultFollowUp">Result follow-up</a> }
        <details class="ms-auto small">
            <summary class="btn btn-sm btn-outline-secondary" aria-label="Exam workflow help">ⓘ</summary>
            <div class="border rounded p-2 mt-1" style="max-width: 22rem" role="note">
                Enter marks while open. Controllers verify every batch before locking; locked results are read-only.
            </div>
        </details>
    </header>
    <div id="examAlert" class="d-none" tabindex="-1" role="alert" aria-live="polite"></div>
    <form id="examScopeSearch" class="card card-body mb-2" role="search">
        <div class="row g-2 align-items-end">
            <div class="col-md-6"><label for="examScopeTerm" class="form-label">Find assessment, batch or subject</label><input id="examScopeTerm" class="form-control" type="search" maxlength="100" placeholder="Search authorized assessment scopes" /></div>
            <div class="col-md-auto"><button id="examScopeApply" class="btn btn-outline-primary" type="submit">Search</button></div>
            <div class="col-md-auto d-flex gap-2 align-items-center"><button id="examScopePrev" class="btn btn-outline-secondary" type="button" disabled>Previous</button><button id="examScopeNext" class="btn btn-outline-secondary" type="button" disabled>Next</button></div>
            <div class="col-md-auto"><span id="examScopePageInfo" class="small text-muted" role="status" aria-live="polite">Loading scopes…</span></div>
        </div>
    </form>
    <form id="examFilters" class="card card-body mb-3">
        <div class="row g-3 align-items-end">
            <div class="col-lg-4"><label for="examExam" class="form-label">Assessment</label><select id="examExam" class="form-select" required><option value="">Loading assessments…</option></select></div>
            <div class="col-lg-4"><label for="examBatch" class="form-label">Batch / Section</label><select id="examBatch" class="form-select" required><option value="">Select assessment first</option></select></div>
            <div class="col-lg-4"><label for="examSubject" class="form-label">Subject</label><select id="examSubject" class="form-select" required><option value="">Select batch first</option></select></div>
            <div class="col-12 d-flex flex-wrap gap-2"><button id="examLoadRoster" type="submit" class="btn btn-primary">Load marks register</button>@if (canPublish) { <button id="examLoadResults" type="button" class="btn btn-outline-primary" disabled>View published results</button> }</div>
        </div>
    </form>
    @if (canPublish)
    {
        <section class="card mb-3" aria-labelledby="examStateHeading">
            <div class="card-body d-flex flex-wrap align-items-center gap-2">
                <h3 id="examStateHeading" class="h6 mb-0">Assessment approval &amp; lock</h3>
                <span id="examStateCurrent" class="badge text-bg-secondary" role="status" aria-live="polite">Select an assessment</span>
                <button id="examStateAdvance" type="button" class="btn btn-sm btn-outline-primary ms-auto" disabled>Next stage</button>
            </div>
        </section>
        <section class="card mb-3" aria-labelledby="examCreditHeading">
            <div class="card-body d-flex flex-wrap align-items-center gap-2">
                <h3 id="examCreditHeading" class="h6 mb-0">Transcript credit &amp; attempt policy</h3>
                <label for="examAttemptMode" class="small">Attempt</label>
                <select id="examAttemptMode" class="form-select form-select-sm w-auto" disabled>
                    <option value="0">Regular</option><option value="1">Retake (failed course)</option>
                    <option value="2">Improvement (passed course)</option>
                </select>
                <div class="form-check ms-2"><input id="examCountsTowardCgpa" class="form-check-input" type="checkbox" disabled />
                    <label for="examCountsTowardCgpa" class="form-check-label">Include this final exam in cumulative GPA</label></div>
                <button id="examSaveCreditPolicy" class="btn btn-sm btn-outline-primary ms-auto" type="button" disabled>Save draft setting</button>
                <a class="btn btn-sm btn-outline-secondary" asp-controller="AssessmentAdministration" asp-action="Attempts">Retake / Improvement approvals</a>
                <span id="examCreditInfo" class="small text-muted" role="status" aria-live="polite">Choose a draft assessment.</span>
            </div>
        </section>
    }
    <section class="card mb-3" aria-labelledby="examRosterHeading">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <h3 id="examRosterHeading" class="h6 m-0">Subject marks register</h3><div class="d-flex flex-wrap gap-2 align-items-center"><span id="examRosterInfo" class="small text-muted" role="status" aria-live="polite"></span><button id="examMarksCsv" type="button" class="btn btn-sm btn-outline-secondary" disabled>Page CSV</button></div>
        </div>
        <form id="examRosterSearchForm" class="card-body py-2 d-flex flex-wrap gap-2 align-items-end" role="search">
            <div><label for="examRosterSearch" class="form-label mb-1">Roll, student code or name</label>
                <input id="examRosterSearch" type="search" class="form-control form-control-sm" maxlength="100" autocomplete="off" /></div>
            <button class="btn btn-sm btn-outline-primary" type="submit">Find students</button>
        </form>
        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle mb-0">
                <thead><tr><th scope="col">Roll</th><th scope="col">Student code</th><th scope="col">Student</th><th scope="col">Mark</th><th scope="col">Absent</th><th scope="col">Withheld</th><th scope="col">Grade</th></tr></thead>
                <tbody id="examRoster"><tr><td colspan="7" class="text-center text-muted p-4">Choose assessment, batch and subject.</td></tr></tbody>
            </table>
        </div>
        <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <button id="examRosterPrev" class="btn btn-sm btn-outline-secondary" type="button" disabled>Previous</button>
                <span id="examRosterPageInfo" class="small text-muted" role="status" aria-live="polite"></span>
                <button id="examRosterNext" class="btn btn-sm btn-outline-secondary" type="button" disabled>Next</button>
            </div>
            <button id="examSaveMarks" class="btn btn-primary" disabled type="button">Save changed marks</button>
        </div>
    </section>
    @if (canPublish)
    {
        <section class="card mb-3" aria-labelledby="examReadinessHeading">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h3 id="examReadinessHeading" class="h6 m-0">Pre-publication evidence review</h3>
                <div class="d-flex gap-2"><button id="examReadinessLoad" class="btn btn-sm btn-outline-primary" type="button">Check batch</button><button id="examReadinessCsv" class="btn btn-sm btn-outline-secondary" type="button" disabled>Page CSV</button></div>
            </div>
            <div class="card-body">
                <p class="small text-muted">Review missing mandatory registrations, marks and withheld evidence. Unregistered electives are excluded. This page is not a global publication approval; draft preview validates the full batch.</p>
                <div class="table-responsive"><table class="table table-sm table-hover"><thead><tr><th>Roll</th><th>Code</th><th>Student</th><th>Subjects</th><th>Marks</th><th>Absent</th><th>Issues</th></tr></thead><tbody id="examReadinessRows"><tr><td colspan="7" class="text-center text-muted">Select a batch and check evidence.</td></tr></tbody></table></div>
                <div class="d-flex flex-wrap justify-content-between gap-2"><span id="examReadinessInfo" role="status" aria-live="polite" class="small text-muted"></span><div class="d-flex gap-2"><button id="examReadinessPrev" class="btn btn-sm btn-outline-secondary" type="button" disabled>Previous</button><button id="examReadinessNext" class="btn btn-sm btn-outline-secondary" type="button" disabled>Next</button></div></div>
            </div>
        </section>
        <section class="card mb-3" id="examMarkChanges" aria-labelledby="examMarkChangesHeading">
            <div class="card-header d-flex flex-wrap align-items-center gap-2">
                <h3 id="examMarkChangesHeading" class="h6 m-0">Marks change register</h3>
                <button id="examMarkChangesLoad" class="btn btn-sm btn-outline-primary ms-auto" type="button">Load changes</button>
                <button id="examMarkChangesCsv" class="btn btn-sm btn-outline-secondary" type="button" disabled>Page CSV</button>
            </div>
            <div class="card-body">
                <div id="examMarkChangesStatus" class="small text-muted mb-2" role="status" aria-live="polite"></div>
                <div class="table-responsive"><table class="table table-sm table-hover">
                    <thead><tr><th>UTC time</th><th>Registration ID</th><th>Action</th><th>Before</th><th>After</th><th>Actor ID</th></tr></thead>
                    <tbody id="examMarkChangesRows"><tr><td colspan="6" class="text-muted text-center">Select a subject and load changes.</td></tr></tbody>
                </table></div>
                <div class="d-flex justify-content-end gap-2">
                    <button id="examMarkChangesPrev" class="btn btn-sm btn-outline-secondary" type="button" disabled>Previous</button>
                    <button id="examMarkChangesNext" class="btn btn-sm btn-outline-secondary" type="button" disabled>Next</button>
                </div>
            </div>
        </section>
        <section class="card mb-3" aria-labelledby="examResultsHeading">
            <div class="card-header d-flex justify-content-between flex-wrap align-items-center gap-2"><h3 class="h6 m-0" id="examResultsHeading">Result sheet</h3><div class="d-flex flex-wrap gap-2"><button id="examGenerate" type="button" class="btn btn-outline-primary" disabled>Preview draft</button><button id="examResultsCsv" type="button" class="btn btn-outline-secondary">Results CSV</button><button id="examPublish" type="button" class="btn btn-danger" disabled>Publish results</button></div></div>
            <div class="card-body"><p id="examResultSummary" class="small text-muted mb-2">Choose a batch to preview draft results or view a published snapshot.</p>
                <div class="row g-2 mb-3"><div class="col-auto form-check ms-2"><input id="examVisibleStudent" type="checkbox" class="form-check-input" checked /><label for="examVisibleStudent" class="form-check-label">Visible to students</label></div><div class="col-auto form-check ms-2"><input id="examVisibleGuardian" type="checkbox" class="form-check-input" checked /><label for="examVisibleGuardian" class="form-check-label">Visible to guardians</label></div><div class="col-md-5"><label for="examPublishNote" class="form-label">Publication note (optional)</label><input id="examPublishNote" class="form-control" maxlength="1000" /></div></div>
                <div class="table-responsive"><table class="table table-sm table-hover"><thead><tr><th>Position</th><th>Roll</th><th>Student</th><th>Marks</th><th>Percentage</th><th>Credits</th><th>GPA</th><th>CGPA</th><th>Grade</th><th>Status</th></tr></thead><tbody id="examResults"></tbody></table></div>
            </div>
        </section>
        <section class="card mb-3" id="examPublicationRegister" aria-labelledby="examPublicationHeading">
            <div class="card-header d-flex flex-wrap justify-content-between gap-2 align-items-center">
                <h3 class="h6 m-0" id="examPublicationHeading">Publication history &amp; tabulation</h3>
                <span class="small text-muted">Authorized examination administration only</span>
            </div>
            <div class="card-body">
                <form id="examHistoryFilters" class="row g-2 align-items-end mb-3">
                    <div class="col-auto"><button id="examHistoryLoad" class="btn btn-outline-primary" type="submit">Load publication versions</button></div>
                    <div class="col-md-4"><label for="examHistoryVersion" class="form-label">Published / withdrawn version</label>
                        <select id="examHistoryVersion" class="form-select" disabled><option value="">Load versions first</option></select></div>
                    <div class="col-auto"><button id="examHistoryWithdraw" class="btn btn-outline-danger" type="button" disabled>Withdraw version</button></div>
                    <div class="col-auto"><button id="examHistoryPrev" class="btn btn-outline-secondary" type="button" disabled>Previous versions</button></div>
                    <div class="col-auto"><button id="examHistoryNext" class="btn btn-outline-secondary" type="button" disabled>Next versions</button></div>
                </form>
                <div id="examHistoryInfo" class="small text-muted mb-2" role="status" aria-live="polite">Choose an assessment and batch, then load versions.</div>
                <div id="examHistoryDetails" class="small mb-3" role="status" aria-live="polite"></div>
                <section class="border rounded p-2 mb-3" aria-labelledby="examIntegrityHeading">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <h4 id="examIntegrityHeading" class="h6 mb-0">Historical snapshot integrity</h4>
                        <button id="examIntegrityLoad" class="btn btn-sm btn-outline-primary ms-auto" type="button" disabled>Inspect version</button>
                        <button id="examIntegrityCsv" class="btn btn-sm btn-outline-secondary" type="button" disabled>Page CSV</button>
                    </div>
                    <div id="examIntegrityInfo" class="small text-muted mb-2" role="status" aria-live="polite">Select a finalized version to inspect saved evidence.</div>
                    <div class="table-responsive"><table class="table table-sm table-hover align-middle">
                        <thead><tr><th scope="col">Snapshot ID</th><th scope="col">Enrollment ID</th><th scope="col">Issue</th></tr></thead>
                        <tbody id="examIntegrityRows"><tr><td colspan="3" class="text-center text-muted">No version inspected.</td></tr></tbody>
                    </table></div>
                    <div class="d-flex justify-content-end gap-2">
                        <button id="examIntegrityPrev" class="btn btn-sm btn-outline-secondary" type="button" disabled>Previous</button>
                        <button id="examIntegrityNext" class="btn btn-sm btn-outline-secondary" type="button" disabled>Next</button>
                    </div>
                </section>
                <section id="examComparisonSection" class="border rounded p-2 mb-3" aria-labelledby="examComparisonHeading">
                    <h4 id="examComparisonHeading" class="h6">Historical result comparison</h4>
                    <form id="examComparisonFilters" class="row g-2 align-items-end mb-2">
                        <div class="col-md-4"><label for="examComparisonSearch" class="form-label">Roll, student code or name</label>
                            <input id="examComparisonSearch" class="form-control" type="search" maxlength="100" autocomplete="off" /></div>
                        <div class="col-auto form-check ms-2"><input id="examComparisonChangedOnly" class="form-check-input" type="checkbox" checked />
                            <label for="examComparisonChangedOnly" class="form-check-label">Changes only</label></div>
                        <div class="col-auto"><button id="examComparisonLoad" class="btn btn-sm btn-outline-primary" type="submit" disabled>Compare with previous version</button></div>
                        <div class="col-auto"><button id="examComparisonCsv" class="btn btn-sm btn-outline-secondary" type="button" disabled>Page CSV</button></div>
                        <div class="col-auto"><button id="examComparisonPrint" class="btn btn-sm btn-outline-secondary" type="button" disabled>Print page</button></div>
                    </form>
                    <div id="examComparisonInfo" class="small text-muted mb-2" role="status" aria-live="polite">Select a finalized version.</div>
                    <div class="table-responsive"><table class="table table-sm table-hover align-middle">
                        <thead><tr><th>Roll</th><th>Student code</th><th>Student</th><th>Change</th>
                            <th>Marks before</th><th>Marks after</th><th>GPA before</th><th>GPA after</th>
                            <th>Grade before</th><th>Grade after</th><th>Result before</th><th>Result after</th></tr></thead>
                        <tbody id="examComparisonRows"><tr><td colspan="12" class="text-center text-muted">No comparison loaded.</td></tr></tbody>
                    </table></div>
                    <div class="d-flex justify-content-end gap-2">
                        <button id="examComparisonPrev" class="btn btn-sm btn-outline-secondary" type="button" disabled>Previous</button>
                        <button id="examComparisonNext" class="btn btn-sm btn-outline-secondary" type="button" disabled>Next</button>
                    </div>
                </section>
                <form id="examTabulationFilters" class="row g-2 align-items-end mb-2">
                    <div class="col-md-5"><label for="examTabulationSearch" class="form-label">Find roll, student code or name</label>
                        <input id="examTabulationSearch" class="form-control" type="search" maxlength="100" autocomplete="off" /></div>
                    <div class="col-auto"><button id="examTabulationLoad" class="btn btn-primary" type="submit" disabled>View saved tabulation</button></div>
                    <div class="col-auto"><button id="examTabulationCsv" class="btn btn-outline-secondary" type="button" disabled>Page CSV</button></div>
                    <div class="col-auto"><button id="examTabulationPrint" class="btn btn-outline-secondary" type="button" disabled>Print</button></div>
                </form>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle">
                        <thead><tr><th>Position</th><th>Roll</th><th>Student code</th><th>Student</th><th>Obtained</th><th>Maximum</th><th>Percentage</th><th>GPA</th><th>CGPA</th><th>Grade</th><th>Status</th></tr></thead>
                        <tbody id="examTabulationRows"><tr><td colspan="11" class="text-muted text-center p-3">Select a saved publication version.</td></tr></tbody>
                    </table>
                </div>
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <span id="examTabulationInfo" class="small text-muted" role="status" aria-live="polite">Saved marks/grades are historical snapshots; student display names come from the current authorized directory.</span>
                    <div class="d-flex gap-2"><button id="examTabulationPrev" class="btn btn-sm btn-outline-secondary" type="button" disabled>Previous page</button>
                        <button id="examTabulationNext" class="btn btn-sm btn-outline-secondary" type="button" disabled>Next page</button></div>
                </div>
            </div>
        </section>
    }
    <div class="d-flex justify-content-end mb-3"><button id="examPrint" type="button" class="btn btn-outline-secondary">Print current register</button></div>
</section>
<style>
@@media print {
    #examScopeSearch, #examFilters, #examAlert, #examStateAdvance, #examSaveMarks, #examPublish, #examGenerate,
    #examLoadResults, #examMarksCsv, #examResultsCsv, #examPrint, #examReadinessLoad,
    #examRosterSearchForm, #examRosterPrev, #examRosterNext, #examSaveMarks,
    #examReadinessCsv, #examReadinessPrev, #examReadinessNext,
    #examComparisonFilters, #examComparisonPrev, #examComparisonNext,
    #examHistoryFilters, #examTabulationFilters, #examHistoryInfo, #examHistoryDetails,
    #examIntegrityLoad, #examIntegrityCsv, #examIntegrityPrev, #examIntegrityNext,
    #examTabulationPrev, #examTabulationNext, #examMarkChangesLoad,
    #examMarkChangesCsv, #examMarkChangesPrev, #examMarkChangesNext { display:none!important; }
}
@@media print {
    body.exam-comparison-print #examWorkflow > :not(#examPublicationRegister) { display:none!important; }
    body.exam-comparison-print #examPublicationRegister > .card-header { display:none!important; }
    body.exam-comparison-print #examPublicationRegister > .card-body > :not(#examComparisonSection) { display:none!important; }
    body.exam-comparison-print #examComparisonSection { display:block!important; border:none!important; }
}
</style>
@section Scripts {
    <script src="~/js/assessment/workflow.js" asp-append-version="true"></script>
    <script src="~/js/assessment/publication-register.js" asp-append-version="true"></script>
    <script src="~/js/assessment/mark-changes.js" asp-append-version="true"></script>
}
