@{
    ViewData["Title"] = "Marks Submission & Review";
    var canReview = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") ||
        User.IsInRole("VicePrincipal") || User.IsInRole("ExamController");
}
<section class="container-fluid py-3" id="markReviewWorkspace" data-can-review="@canReview.ToString().ToLowerInvariant()">
    @Html.AntiForgeryToken()
    <header class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <h1 class="h4 mb-0">Marks submission &amp; review</h1>
        <details class="ms-auto small">
            <summary class="btn btn-sm btn-outline-secondary" aria-label="Marks review help">ⓘ</summary>
            <div class="border rounded p-2 mt-1" role="note" style="max-width:22rem">
                Teachers submit complete subject marks. A different authorized reviewer approves or rejects them.
                Rejected marks can be corrected and resubmitted; approved marks are locked.
            </div>
        </details>
    </header>
    <div id="markReviewNotice" class="d-none" role="alert" aria-live="polite"></div>
    <form id="markReviewSearch" class="card card-body mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-5"><label class="form-label" for="markReviewTerm">Assessment, batch or subject</label>
                <input id="markReviewTerm" class="form-control" type="search" maxlength="100" /></div>
            <div class="col-auto"><button class="btn btn-primary" type="submit">Search</button></div>
            <div class="col-auto"><button class="btn btn-outline-secondary" type="button" id="markReviewPrev">Previous</button></div>
            <div class="col-auto"><button class="btn btn-outline-secondary" type="button" id="markReviewNext">Next</button></div>
            <div class="col-auto"><span id="markReviewPage" class="small text-muted" aria-live="polite"></span></div>
        </div>
        <div class="mt-3"><label class="form-label" for="markReviewSubject">Authorized subject</label>
            <select id="markReviewSubject" class="form-select" required><option value="">Select subject</option></select></div>
    </form>
    @if (canReview) {
        <section class="card mb-3" id="markReviewQueuePanel">
            <div class="card-header"><h2 class="h6 mb-0">Reviewer decision queue</h2></div>
            <div class="card-body">
                <form id="markReviewQueueSearch" class="row g-2 align-items-end">
                    <div class="col-md-5"><label class="form-label" for="markReviewQueueTerm">Assessment, batch or subject</label>
                        <input id="markReviewQueueTerm" type="search" maxlength="100" class="form-control" /></div>
                    <div class="col-md-3"><label class="form-label" for="markReviewQueueStatus">Decision</label>
                        <select id="markReviewQueueStatus" class="form-select">
                            <option value="Pending">Pending review</option><option value="Rejected">Rejected</option>
                            <option value="Approved">Approved</option><option value="Unsubmitted">Unsubmitted</option>
                            <option value="All">All</option>
                        </select></div>
                    <div class="col-auto"><button type="submit" class="btn btn-primary">Filter</button></div>
                </form>
            </div>
            <div class="table-responsive"><table class="table table-sm table-hover mb-0">
                <thead><tr><th>Assessment</th><th>Batch</th><th>Subject</th><th>Status</th><th>Last decision (UTC)</th><th>Action</th></tr></thead>
                <tbody id="markReviewQueueRows"><tr><td colspan="6">Loading review queue…</td></tr></tbody>
            </table></div>
            <div class="card-body d-flex flex-wrap align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="markReviewQueuePrev">Previous</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="markReviewQueueNext">Next</button>
                <span class="small text-muted" id="markReviewQueuePage" role="status" aria-live="polite"></span>
                <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" id="markReviewQueueCsv">CSV (current page)</button>
            </div>
        </section>
    }
    <section class="card mb-3">
        <div class="card-body d-flex flex-wrap align-items-center gap-2">
            <strong id="markReviewStatus" role="status" aria-live="polite">Select a subject</strong>
            <button id="markReviewSubmit" class="btn btn-sm btn-primary ms-auto" type="button" disabled>Submit marks</button>
            @if (canReview) {
                <button id="markReviewApprove" class="btn btn-sm btn-success" type="button" disabled>Approve</button>
                <button id="markReviewReject" class="btn btn-sm btn-outline-danger" type="button" disabled>Reject</button>
            }
        </div>
    </section>
    <section class="card">
        <div class="card-header d-flex justify-content-between align-items-center gap-2">
            <h2 class="h6 mb-0">Decision history</h2>
            <div class="d-flex gap-2"><button id="markReviewCsv" type="button" class="btn btn-sm btn-outline-secondary" disabled>CSV (latest 50)</button>
                <button id="markReviewPrint" type="button" class="btn btn-sm btn-outline-secondary">Print</button></div>
        </div>
        <div class="table-responsive"><table class="table table-sm table-hover mb-0">
            <thead><tr><th>UTC time</th><th>Decision</th><th>Reviewer / submitter ID</th><th>Reason</th></tr></thead>
            <tbody id="markReviewRows"><tr><td colspan="4">No subject selected.</td></tr></tbody>
        </table></div>
        <div class="card-footer small text-muted" id="markReviewCount" role="status"></div>
    </section>
</section>
<style>@@media print { #markReviewQueuePanel,#markReviewSearch,#markReviewNotice,#markReviewSubmit,#markReviewApprove,#markReviewReject,#markReviewCsv,#markReviewPrint { display:none!important; } }</style>
@section Scripts { <script src="~/js/assessment/mark-reviews.js" asp-append-version="true"></script> }
