@{
    ViewData["Title"] = "Component Marks Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="container-fluid py-4" id="componentMarksWorkspace">
    @Html.AntiForgeryToken()
    <header class="mb-3">
        <div class="d-flex align-items-center gap-2"><h1 class="h4 mb-0">Assessment component marks</h1>
            <details class="ms-auto small"><summary class="btn btn-outline-secondary btn-sm" aria-label="Component marks guide">ⓘ</summary>
                <div class="border rounded p-2 mt-1" role="note">Choose an authorized subject and component. Subject marks must exist before component marks can be saved. Published results are read-only; CSV and print include only the visible page.</div>
            </details></div>
    </header>
    <div id="componentMarksNotice" class="alert d-none" role="alert" aria-live="polite"></div>
    <form id="componentMarksFilters" class="card card-body mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-lg-4"><label class="form-label" for="cmScope">Assessment / Batch / Subject</label>
                <select id="cmScope" class="form-select" required><option value="">Loading…</option></select></div>
            <div class="col-lg-4"><label class="form-label" for="cmComponent">Component</label>
                <select id="cmComponent" class="form-select" required><option value="">Load a subject first</option></select></div>
            <div class="col-lg-3"><label class="form-label" for="cmSearch">Student search</label><input id="cmSearch" type="search" maxlength="100" class="form-control" placeholder="Roll, code or name" /></div>
            <div class="col-auto"><label class="form-label" for="cmPageSize">Rows</label><select id="cmPageSize" class="form-select"><option value="25">25</option><option value="50" selected>50</option><option value="100">100</option></select></div>
            <div class="col-auto"><button type="submit" class="btn btn-primary" id="cmLoad">Load roster</button></div>
            <div class="col-auto"><button type="button" class="btn btn-outline-secondary" id="cmCsv">CSV</button></div>
            <div class="col-auto"><button type="button" class="btn btn-outline-secondary" id="cmPrint">Print</button></div>
        </div>
    </form>
    <div class="card">
        <div class="card-header d-flex flex-wrap justify-content-between gap-2">
            <strong id="cmHeading">Component marks register</strong><span id="cmInfo" class="small text-muted"></span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead><tr><th>Roll</th><th>Student code</th><th>Student</th><th>Mark</th><th>Absent</th><th>Withheld</th><th>Saved</th><th>Subject total</th><th>Calculated</th><th>Reconciliation</th></tr></thead>
                <tbody id="cmRows"><tr><td colspan="10" class="text-muted p-3">Choose an assessment to load the roster.</td></tr></tbody>
            </table>
        </div>
        <div class="card-footer d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2"><button type="button" id="cmPrev" class="btn btn-outline-secondary btn-sm" disabled>Previous</button><span id="cmPageInfo" class="small" aria-live="polite"></span><button type="button" id="cmNext" class="btn btn-outline-secondary btn-sm" disabled>Next</button></div>
            <button type="button" id="cmSave" class="btn btn-primary" disabled>Save changed marks</button>
        </div>
    </div>
</section>
<style>
@@media print {
    #componentMarksFilters, #cmSave, #cmPrev, #cmNext, #componentMarksNotice { display:none!important; }
}
</style>
@section Scripts { <script src="~/js/assessment/component-marks.js" asp-append-version="true"></script> }
