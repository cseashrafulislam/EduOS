@{
    ViewData["Title"] = "Career Employer Verification / নিয়োগদাতা যাচাই";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="careerEmployerWorkspace" class="container-fluid py-4">
    @Html.AntiForgeryToken()
    <header class="mb-3"><h1 class="h4 fw-bold" data-i18n="heading">Career employer verification</h1></header>
    <div id="careerEmployerNotice" class="alert d-none" role="status" aria-live="polite"></div>
    <div class="row g-3">
        <section class="col-lg-4" aria-labelledby="careerCreateHeading">
            <div class="card shadow-sm border-0"><div class="card-body">
                <h2 id="careerCreateHeading" class="h5" data-i18n="createHeading">Register employer for verification</h2>
                <form id="careerEmployerCreate">
                    <label for="careerCampus" class="form-label" data-i18n="campus">Campus</label>
                    <select id="careerCampus" class="form-select mb-3" required></select>
                    <label for="careerName" class="form-label" data-i18n="name">Employer name</label>
                    <input id="careerName" class="form-control mb-3" minlength="3" maxlength="160" required />
                    <label for="careerWebsite" class="form-label" data-i18n="website">HTTPS website (optional)</label>
                    <input id="careerWebsite" type="url" class="form-control mb-3" maxlength="300" placeholder="https://example.org" />
                    <button id="careerCreateButton" class="btn btn-primary" type="submit" data-i18n="save">Save draft</button>
                </form>
            </div></div>
        </section>
        <section class="col-lg-8" aria-labelledby="careerListHeading">
            <div class="card shadow-sm border-0"><div class="card-body">
                <h2 id="careerListHeading" class="h5" data-i18n="listHeading">Employer verification queue</h2>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <label for="careerStatus" class="visually-hidden" data-i18n="filter">Status</label>
                    <select id="careerStatus" class="form-select" style="max-width:220px">
                        <option value="0" data-i18n="all">All employers</option>
                        <option value="1" data-i18n="draft">Awaiting verification</option>
                        <option value="2" data-i18n="verified">Verified</option>
                    </select>
                    <button id="careerRefresh" class="btn btn-outline-secondary" type="button" data-i18n="refresh">Refresh</button>
                    <a id="careerExport" class="btn btn-outline-secondary disabled" aria-disabled="true" data-i18n="export">Export verified page CSV</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-sm align-middle">
                        <thead><tr><th data-i18n="name">Employer name</th><th data-i18n="campus">Campus</th><th data-i18n="website">Website</th><th data-i18n="filter">Status</th><th data-i18n="actions">Actions</th></tr></thead>
                        <tbody id="careerEmployerRows"><tr><td colspan="5" data-i18n="loading">Loading…</td></tr></tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <button id="careerPrevious" class="btn btn-sm btn-outline-secondary" type="button" data-i18n="previous">Previous</button>
                    <span id="careerPage" aria-live="polite"></span>
                    <button id="careerNext" class="btn btn-sm btn-outline-secondary" type="button" data-i18n="next">Next</button>
                </div>
            </div></div>
        </section>
    </div>
</div>
@section Scripts {
    <script src="~/js/alumni/career-employers.js" asp-append-version="true"></script>
}
