@{
    var bn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
    ViewData["Title"] = bn ? "এন্টারপ্রাইজ লেজার ট্রেস" : "Enterprise Ledger Trace";
}
<section class="container-fluid py-3" id="v3LedgerTrace" data-language="@(bn ? "bn" : "en")">
    <header class="d-flex align-items-start justify-content-between gap-2 mb-3">
        <h2 class="h4 mb-0">@ViewData["Title"]</h2>
        <details class="small"><summary class="btn btn-link btn-sm" aria-label="@(bn ? "সহায়তা" : "Help")">ⓘ</summary>
            <p class="small mb-0">@(bn ? "স্টক ও অবচয়ের জার্নাল এবং ক্রয় আদেশের অনুমোদিত উৎস যাচাই করুন। ক্রয় আদেশ থেকে স্টক বা জার্নাল পোস্টিং অনুমান করা হয় না।" : "Inspect stock/depreciation journals or approved purchase-order provenance. Purchase orders do not imply stock receipt or Finance posting.")</p>
        </details>
    </header>
    <form id="v3TraceForm" class="row g-2 mb-3">
        <div class="col-sm-4 col-lg-3">
            <label class="form-label" for="v3TraceKind">@(bn ? "প্রমাণের ধরন" : "Evidence type")</label>
            <select id="v3TraceKind" class="form-select">
                <option value="stock">@(bn ? "স্টক মুভমেন্ট" : "Stock movement")</option>
                <option value="asset">@(bn ? "সম্পদ অবচয় রান" : "Asset depreciation run")</option>
                <option value="procurement">@(bn ? "ক্রয় আদেশের প্রমাণ" : "Purchase order commitment")</option>
            </select>
        </div>
        <div class="col-sm-8 col-lg-5">
            <label class="form-label" for="v3TraceReference">@(bn ? "রেফারেন্স UUID" : "Reference UUID")</label>
            <input id="v3TraceReference" class="form-control" required maxlength="36" autocomplete="off" />
        </div>
        <div class="col-sm-4 col-lg-2 d-flex align-items-end">
            <button class="btn btn-primary w-100" type="submit">@(bn ? "ট্রেস দেখুন" : "Trace")</button>
        </div>
    </form>
    <p id="v3TraceMessage" class="small" role="status" aria-live="polite"></p>
    <div id="v3TraceResult" hidden>
        <div class="d-flex gap-2 mb-2">
            <a id="v3TraceCsv" class="btn btn-outline-secondary btn-sm" href="#">@(bn ? "CSV ডাউনলোড" : "Export CSV")</a>
            <button id="v3TracePrint" class="btn btn-outline-secondary btn-sm" type="button">@(bn ? "প্রিন্ট" : "Print")</button>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-striped" aria-label="@(bn ? "লেজার প্রমাণ" : "Ledger evidence")">
                <thead><tr><th>@(bn ? "ধরন" : "Type")</th><th>@(bn ? "নম্বর" : "Number")</th><th>@(bn ? "অবস্থা" : "State")</th><th>@(bn ? "ডেবিট" : "Debit")</th><th>@(bn ? "ক্রেডিট" : "Credit")</th><th>@(bn ? "রেকর্ডকৃত মূল্য" : "Recorded value")</th></tr></thead>
                <tbody id="v3TraceRows"></tbody>
            </table>
        </div>
        <p id="v3TraceStatus" class="small fw-semibold"></p>
    </div>

    <section class="mt-4" id="v3Register">
        <h3 class="h5 mb-2">@(bn ? "প্রমাণ রেজিস্টার" : "Evidence register")</h3>
        <form id="v3RegisterForm" class="row g-2 align-items-end mb-3">
            <div class="col-6 col-md-2">
                <label class="form-label" for="v3RegisterKind">@(bn ? "ধরন" : "Type")</label>
                <select id="v3RegisterKind" class="form-select">
                    <option value="stock">@(bn ? "স্টক" : "Stock")</option>
                    <option value="asset">@(bn ? "অবচয়" : "Depreciation")</option>
                    <option value="procurement">@(bn ? "ক্রয় আদেশ" : "Purchase orders")</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label" for="v3RegisterFrom">@(bn ? "শুরু" : "From")</label>
                <input id="v3RegisterFrom" type="date" class="form-control" required
                    value="@DateTime.UtcNow.AddDays(-30).ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label" for="v3RegisterTo">@(bn ? "শেষ" : "To")</label>
                <input id="v3RegisterTo" type="date" class="form-control" required
                    value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label" for="v3RegisterCampus">@(bn ? "ক্যাম্পাস আইডি" : "Campus ID")</label>
                <select id="v3RegisterCampus" class="form-select">
                    <option value="">@(bn ? "সব ক্যাম্পাস" : "All campuses")</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label" for="v3RegisterSize">@(bn ? "প্রতি পৃষ্ঠা" : "Page size")</label>
                <select id="v3RegisterSize" class="form-select">
                    <option value="25">25</option><option value="50">50</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <button class="btn btn-primary w-100" type="submit">@(bn ? "খুঁজুন" : "Search")</button>
            </div>
        </form>
        <p id="v3RegisterMessage" role="status" aria-live="polite" class="small"></p>
        <div id="v3RegisterResult" hidden>
            <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                <span id="v3RegisterCount" class="small"></span>
                <a id="v3RegisterCsv" class="btn btn-outline-secondary btn-sm" href="#">
                    @(bn ? "এই পৃষ্ঠার CSV" : "Export current page CSV")</a>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-striped">
                    <thead><tr>
                        <th>@(bn ? "তারিখ" : "Date")</th><th>@(bn ? "রেফারেন্স" : "Reference")</th>
                        <th>@(bn ? "অবস্থা" : "State")</th><th>@(bn ? "মূল্য" : "Value")</th>
                        <th>@(bn ? "লাইন" : "Lines")</th><th>@(bn ? "প্রমাণ" : "Evidence")</th>
                    </tr></thead>
                    <tbody id="v3RegisterRows"></tbody>
                </table>
            </div>
            <nav class="d-flex justify-content-between align-items-center" aria-label="@(bn ? "পৃষ্ঠা" : "Pages")">
                <button id="v3RegisterPrevious" type="button" class="btn btn-outline-secondary btn-sm">
                    @(bn ? "আগের" : "Previous")</button>
                <span id="v3RegisterPage" class="small"></span>
                <button id="v3RegisterNext" type="button" class="btn btn-outline-secondary btn-sm">
                    @(bn ? "পরের" : "Next")</button>
            </nav>
        </div>
    </section>
</section>
@section Scripts { <script type="module" src="~/js/inventory/v3-enterprise-trace.js" asp-append-version="true"></script> }
