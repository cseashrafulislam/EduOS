@using System.Globalization
@{
    var bn = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
    string L(string en, string bd) => bn ? bd : en;
    ViewData["Title"] = L("Student Invoice GL Posting", "শিক্ষার্থী ইনভয়েস GL পোস্টিং");
    var canPost = User.IsInRole("TenantAdmin") || User.IsInRole("Principal");
}
<section class="container-fluid py-2" id="studentInvoicePosting" data-post="@canPost.ToString().ToLowerInvariant()">
    <p class="small text-muted mb-2">@L("Post student invoices to the institutional receivable/income GL. Cash receipts are posted in their own authorized workflow; SaaS billing is separate.", "শিক্ষার্থীর ইনভয়েস প্রতিষ্ঠানিক প্রাপ্য ও আয় হিসাবখাতায় পোস্ট করুন। নগদ রসিদ আলাদা অনুমোদিত পেজে পোস্ট হবে; SaaS বিলিং আলাদা।")</p>
    @Html.AntiForgeryToken()
    <div id="invoicePostingNotice" class="alert d-none" role="alert"></div>
    <form id="invoicePostingFilters" class="card card-body mb-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-3"><label for="invoicePostingCampus" class="form-label">@L("Campus", "ক্যাম্পাস")</label>
                <select id="invoicePostingCampus" class="form-select"><option value="">@L("All authorized campuses", "অনুমোদিত সব ক্যাম্পাস")</option></select></div>
            <div class="col-md-3"><label for="invoicePostingSearch" class="form-label">@L("Invoice / student", "ইনভয়েস / শিক্ষার্থী")</label>
                <input id="invoicePostingSearch" class="form-control" maxlength="100" autocomplete="off" /></div>
            <div class="col-md-3"><label for="invoicePostingPeriod" class="form-label">@L("Open accounting period", "খোলা হিসাবকাল")</label>
                <select id="invoicePostingPeriod" class="form-select"><option value="">@L("Choose a period", "হিসাবকাল বাছুন")</option></select></div>
            <div class="col-md-3 d-flex align-items-center justify-content-end flex-wrap gap-2">
                <div class="form-check"><input id="invoicePostingUnposted" class="form-check-input" type="checkbox" checked /><label for="invoicePostingUnposted" class="form-check-label">@L("Unposted only", "শুধু পোস্ট হয়নি")</label></div>
                <button type="submit" class="btn btn-primary">@L("Find", "খুঁজুন")</button>
            </div>
        </div>
    </form>
    <div class="card card-body">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <h2 class="h6 mb-0">@L("Student invoices", "শিক্ষার্থীর ইনভয়েস")</h2>
            <a asp-controller="StudentPaymentPosting" asp-action="Index" class="btn btn-outline-primary btn-sm">@L("Post cash receipts", "নগদ রসিদ পোস্টিং")</a>
        </div>
        <div class="table-responsive"><table class="table table-striped table-sm align-middle">
            <thead><tr><th>@L("Invoice", "ইনভয়েস")</th><th>@L("Student", "শিক্ষার্থী")</th><th>@L("Campus", "ক্যাম্পাস")</th><th>@L("Date", "তারিখ")</th><th>@L("Amount", "পরিমাণ")</th><th>@L("Status", "অবস্থা")</th><th>@L("Journal", "জার্নাল")</th>@if(canPost){<th>@L("Action", "কাজ")</th>}</tr></thead>
            <tbody id="invoicePostingRows"></tbody>
        </table></div>
        <div class="d-flex align-items-center gap-2">
            <button id="invoicePostingPrev" type="button" class="btn btn-outline-secondary btn-sm">@L("Previous", "আগের")</button>
            <span id="invoicePostingPage" aria-live="polite"></span>
            <button id="invoicePostingNext" type="button" class="btn btn-outline-secondary btn-sm">@L("Next", "পরের")</button>
        </div>
    </div>
    <p class="small text-muted mt-2">@L("Posted journals are immutable. Corrections require an approved source-linked reversal, not manual edits.", "পোস্ট করা জার্নাল অপরিবর্তনীয়। সংশোধনে উৎস-সংযুক্ত অনুমোদিত রিভার্সাল প্রয়োজন; হাতে সম্পাদনা নয়।")</p>
</section>
@section Scripts { <script src="~/js/finance/student-invoice-posting.js" asp-append-version="true"></script> }
