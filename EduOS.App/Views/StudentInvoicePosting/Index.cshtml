@{
    ViewData["Title"] = "Student Invoice GL Posting";
    var canPost = User.IsInRole("TenantAdmin") || User.IsInRole("Principal");
}
<section class="container-fluid py-3" id="studentInvoicePosting" data-post="@canPost.ToString().ToLowerInvariant()">
    <h2>Student Invoice → Institutional GL</h2>
    <p class="text-muted">Post student fee invoices to balanced receivable/income journals. Platform SaaS billing is separate. Cash payment posting is not yet enabled.</p>
    @Html.AntiForgeryToken()
    <div id="invoicePostingNotice" class="alert d-none" role="alert"></div>
    <form id="invoicePostingFilters" class="card card-body mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3"><label for="invoicePostingCampus" class="form-label">Campus</label>
                <select id="invoicePostingCampus" class="form-select"><option value="">All authorized campuses</option></select></div>
            <div class="col-md-3"><label for="invoicePostingSearch" class="form-label">Invoice / student</label>
                <input id="invoicePostingSearch" class="form-control" maxlength="100" autocomplete="off" /></div>
            <div class="col-md-3"><label for="invoicePostingPeriod" class="form-label">Open accounting period</label>
                <select id="invoicePostingPeriod" class="form-select"><option value="">Choose a period</option></select></div>
            <div class="col-md-2"><label class="form-check"><input id="invoicePostingUnposted" class="form-check-input" type="checkbox" checked /> Unposted only</label></div>
            <div class="col-md-1"><button type="submit" class="btn btn-primary">Find</button></div>
        </div>
    </form>
    <div class="card card-body">
        <div class="table-responsive"><table class="table table-striped table-sm align-middle">
            <thead><tr><th>Invoice</th><th>Student</th><th>Campus</th><th>Date</th><th>Amount</th><th>Status</th><th>Journal</th>@if(canPost){<th>Action</th>}</tr></thead>
            <tbody id="invoicePostingRows"></tbody>
        </table></div>
        <div class="d-flex align-items-center gap-2">
            <button id="invoicePostingPrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
            <span id="invoicePostingPage" aria-live="polite"></span>
            <button id="invoicePostingNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
        </div>
    </div>
    <p class="small text-muted mt-2">Posted journals are immutable. Corrections require an approved source-linked reversal, not manual edits.</p>
</section>
@section Scripts { <script src="~/js/finance/student-invoice-posting.js" asp-append-version="true"></script> }
