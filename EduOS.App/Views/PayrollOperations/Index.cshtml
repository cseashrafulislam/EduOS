@{
    ViewData["Title"] = "Payroll Operations";
    // The canonical payroll run register is tenant-wide; campus-limited roles must not see it.
    var manager = User.IsInRole("TenantAdmin");
}
<section id="payrollApp" data-manager="@manager.ToString().ToLowerInvariant()" class="container-fluid py-3">
    <header class="mb-3"><h2 class="h4 mb-1">Payroll Operations</h2><p class="text-muted">Calculate monthly payroll, independently approve it, review employee snapshots and inspect posted payslips.</p></header>
    @Html.AntiForgeryToken()
    <div id="payrollAlert" class="alert d-none" role="alert" tabindex="-1" aria-live="polite"></div>
    @if(manager)
    {
        <p><a class="btn btn-sm btn-outline-primary" href="/PayrollSalaryStructures/Index">Salary structure register</a>
            <a class="btn btn-sm btn-outline-primary" href="/PayrollSalaryStatement/Index">Salary statement / CSV</a>
            <a class="btn btn-sm btn-outline-primary" href="/PayrollReconciliation/Index">Payment reconciliation</a>
            <a class="btn btn-sm btn-outline-primary" href="/PayrollBonuses/Index">Bonus register</a>
            <a class="btn btn-sm btn-outline-primary" href="/PayrollJournalPosting/Index">Institutional payroll GL posting</a>
            <a class="btn btn-sm btn-outline-primary" href="/PayrollPaymentPosting/Index">Payroll payment settlement</a>
            <a class="btn btn-sm btn-outline-primary" href="/PayrollLoanRegister/Index">Loan register</a>
            <a class="btn btn-sm btn-outline-primary" href="/LoanDisbursement/Index">Loan disbursement</a>
            <a class="btn btn-sm btn-outline-primary" href="/LoanRecovery/Index">Loan recovery</a>
            <a class="btn btn-sm btn-outline-secondary" href="/AccountingSetup/Index">Institute banks</a>
            <a class="btn btn-sm btn-outline-secondary" href="/HR/BankAccounts">Employee bank accounts</a></p>
        <section class="card card-body mb-3">
            <h3 class="h6">Monthly payroll run</h3>
            <div class="row g-2 align-items-end">
                <div class="col-md-3"><label for="payrollMonth" class="form-label">Month</label><select id="payrollMonth" class="form-select">@for(var m=1;m<=12;m++){<option value="@m">@System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m)</option>}</select></div>
                <div class="col-md-3"><label for="payrollYear" class="form-label">Year</label><input id="payrollYear" type="number" min="2000" max="2200" class="form-control" required /></div>
                <div class="col-md-3"><label for="payrollCampus" class="form-label">Payroll scope</label><select id="payrollCampus" class="form-select"><option value="">Institution-wide</option></select></div>
                <div class="col-md-3"><label for="payrollProration" class="form-label">Partial-month policy</label>
                    <select id="payrollProration" class="form-select">
                        <option value="FullMonthOnly">Full-month only</option>
                        <option value="CalendarDays">Calendar days (explicit)</option>
                    </select></div>
                <div class="col-md-3 d-flex gap-2"><button id="payrollLoad" type="button" class="btn btn-outline-primary">Load runs</button><button id="payrollGenerate" type="button" class="btn btn-primary">Calculate payroll</button></div>
            </div>
            <p class="small text-muted mt-2 mb-0">Calculation snapshots canonical salary components. A different authorized administrator must approve the run. Approval does not post a journal or pay employees.</p>
        </section>
        <section class="card mb-3">
            <div class="card-header"><h3 class="h6 m-0">Payroll run register</h3></div>
            <div class="table-responsive"><table class="table table-sm table-striped align-middle mb-0">
                <thead><tr><th>Run</th><th>Period</th><th>Campus</th><th>Employees</th><th>Gross (BDT)</th><th>Deductions (BDT)</th><th>Net (BDT)</th><th>State</th><th>Policy</th><th>Action</th></tr></thead>
                <tbody id="payrollRunRows"></tbody>
            </table></div>
            <div class="card-footer d-flex align-items-center gap-2"><button id="payrollRunPrev" type="button" class="btn btn-sm btn-outline-secondary">Previous</button><span id="payrollRunPageLabel" aria-live="polite"></span><button id="payrollRunNext" type="button" class="btn btn-sm btn-outline-secondary">Next</button></div>
        </section>
        <section id="payrollDetails" class="card mb-3 d-none">
            <div class="card-header"><h3 class="h6 m-0">Calculated employee payroll snapshots</h3></div>
            <div class="table-responsive"><table class="table table-sm table-striped mb-0">
                <thead><tr><th>Employee code</th><th>Name</th><th>Gross</th><th>Deductions</th><th>Net</th><th>Component breakdown</th><th>Payment request</th></tr></thead>
                <tbody id="payrollEmployeeRows"></tbody>
            </table></div>
            <div class="card-footer d-flex align-items-center gap-2"><button id="payrollDetailPrev" type="button" class="btn btn-sm btn-outline-secondary">Previous</button><span id="payrollDetailPageLabel" aria-live="polite"></span><button id="payrollDetailNext" type="button" class="btn btn-sm btn-outline-secondary">Next</button></div>
        </section>
        <section id="payrollPaymentRequestPanel" class="card card-body mb-3 d-none" aria-labelledby="payrollPaymentRequestTitle">
            <div class="d-flex align-items-center gap-2 mb-2">
                <h3 id="payrollPaymentRequestTitle" class="h6 m-0">Record payroll payment request</h3>
                <details><summary class="btn btn-sm btn-outline-secondary" aria-label="Payroll request help" title="Payroll request help">ⓘ</summary>
                    <div class="small">Only posted employee payroll is eligible. Cash requests need no bank details. Bank transfers require the institute source bank, employee destination and an external reference. Another administrator must verify settlement in Finance; recording this request does not transfer money.</div>
                </details>
            </div>
            <p id="payrollPaymentEmployee" class="fw-semibold mb-2"></p>
            <form id="payrollPaymentRequestForm">
                <div class="row g-2 align-items-end">
                    <div class="col-md-3"><label class="form-label" for="payrollPaymentDate">Payment date</label><input id="payrollPaymentDate" class="form-control" type="date" required /></div>
                    <div class="col-md-3"><label class="form-label" for="payrollPaymentAmount">Amount (BDT)</label><input id="payrollPaymentAmount" class="form-control" type="number" min="0.01" step="0.01" required /></div>
                    <div class="col-md-3"><label class="form-label" for="payrollPaymentMethod">Method</label><select id="payrollPaymentMethod" class="form-select"><option value="1">Cash</option><option value="2">Bank transfer</option></select></div>
                </div>
                <div id="payrollPaymentBankFields" class="row g-2 mt-1 d-none">
                    <div class="col-md-4"><label class="form-label" for="payrollPaymentSourceBank">Institute bank</label><select id="payrollPaymentSourceBank" class="form-select"></select></div>
                    <div class="col-md-4"><label class="form-label" for="payrollPaymentDestinationBank">Employee bank</label><select id="payrollPaymentDestinationBank" class="form-select"></select></div>
                    <div class="col-md-4"><label class="form-label" for="payrollPaymentExternalRef">External bank reference</label><input id="payrollPaymentExternalRef" class="form-control" maxlength="150" /></div>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button id="payrollPaymentRequestSubmit" type="submit" class="btn btn-primary">Record pending request</button>
                    <button id="payrollPaymentRequestCancel" type="button" class="btn btn-outline-secondary">Cancel</button>
                </div>
            </form>
        </section>
    }
    <section class="card">
        <div class="card-header d-flex justify-content-between align-items-center"><h3 class="h6 m-0">My posted payslips</h3><button id="payrollMy" type="button" class="btn btn-sm btn-outline-secondary">Refresh</button></div>
        <div class="table-responsive"><table class="table table-sm table-striped mb-0">
            <thead><tr><th>Period</th><th>Employee</th><th>Gross (BDT)</th><th>Deductions (BDT)</th><th>Net (BDT)</th><th>Components</th><th>Print</th></tr></thead>
            <tbody id="payrollSlipRows"></tbody>
        </table></div>
        <div class="card-footer d-flex align-items-center gap-2"><button id="payrollSlipPrev" type="button" class="btn btn-sm btn-outline-secondary">Previous</button><span id="payrollSlipPageLabel" aria-live="polite"></span><button id="payrollSlipNext" type="button" class="btn btn-sm btn-outline-secondary">Next</button></div>
    </section>
    <section id="payrollSlipPrintArea" class="d-none" aria-label="Printable payslip">
        <h2 class="h4">Employee Payslip</h2>
        <div class="d-flex justify-content-between"><span id="payrollSlipPrintPeriod"></span><strong id="payrollSlipPrintRun"></strong></div>
        <hr />
        <p id="payrollSlipPrintEmployee"></p>
        <div class="table-responsive"><table class="table table-bordered table-sm">
            <thead><tr><th>Component</th><th>Type</th><th class="text-end">Amount (BDT)</th></tr></thead>
            <tbody id="payrollSlipPrintLines"></tbody>
        </table></div>
        <table class="table table-sm"><tbody>
            <tr><th>Gross</th><td id="payrollSlipPrintGross" class="text-end"></td></tr>
            <tr><th>Deductions</th><td id="payrollSlipPrintDeduction" class="text-end"></td></tr>
            <tr><th>Net Payable (BDT)</th><td id="payrollSlipPrintNet" class="text-end fw-bold"></td></tr>
        </tbody></table>
        <small>Issued from a posted payroll snapshot; not a bank-payment receipt.</small>
    </section>
</section>
<style>
@@media print {
    body * {visibility:hidden !important;}
    #payrollSlipPrintArea, #payrollSlipPrintArea * {visibility:visible !important;}
    #payrollSlipPrintArea {display:block !important;position:absolute;inset:0 auto auto 0;width:100%;padding:24px;background:white;color:black;}
}
</style>
@section Scripts { <script src="~/js/payroll/index.js" asp-append-version="true"></script> }
