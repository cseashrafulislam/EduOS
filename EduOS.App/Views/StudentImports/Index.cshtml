@inject EduOS.Core.Interfaces.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Student Import Preflight";
}
<section class="container-fluid py-3" aria-labelledby="studentImportTitle" data-import-tenant="@CurrentUser.TenantId">
    <header class="mb-3">
        <div class="d-flex align-items-center gap-2">
            <h2 id="studentImportTitle" class="h4 mb-0">Student Import</h2>
            <details class="small"><summary class="btn btn-sm btn-outline-secondary" aria-label="Import help">ⓘ</summary>
                <div class="border rounded p-2 mt-2">Map columns, preview up to 5,000 rows, then commit in atomic 100-row windows. Re-select the same file to resume. Global learner identities are never auto-merged.</div>
            </details>
        </div>
        <a class="btn btn-outline-secondary btn-sm" asp-controller="Students" asp-action="Index">Back to Student Directory</a>
    </header>
    <div id="studentImportAlert" class="alert d-none" role="alert" aria-live="polite"></div>
    <form id="studentImportForm" class="card mb-3" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <label class="form-label" for="studentImportFile">Student source file</label>
            <input id="studentImportFile" class="form-control mb-3" type="file" accept=".csv,.xlsx" required />
            <button id="studentImportInspect" class="btn btn-outline-primary" type="button">Inspect columns</button>
            <div id="studentImportMapping" class="row g-3 mt-2 d-none" aria-label="Map source columns">
                <div class="col-12"></div>
                @foreach (var field in new[] { "SourceKey", "StudentCode", "FullName", "CampusId", "AcademicBatchId", "RollNo", "DateOfBirth", "GuardianName", "GuardianPhone", "GuardianSourceKey" })
                {
                    <div class="col-md-4">
                        <label class="form-label" for="map-@field">@field @(new[] { "SourceKey", "StudentCode", "FullName", "CampusId", "AcademicBatchId", "RollNo" }.Contains(field) ? "*" : "(optional)")</label>
                        <select class="form-select" id="map-@field" data-import-field="@field"></select>
                    </div>
                }
                <div class="col-12">
                    <button id="studentImportPreview" class="btn btn-primary" type="submit">Run dry-run validation</button>
                    <button id="studentImportResume" class="btn btn-outline-primary d-none" type="button">Resume previous import</button>
                </div>
            </div>
        </div>
    </form>
    <section id="studentImportResults" class="card d-none" aria-labelledby="studentImportResultsTitle">
        <div class="card-body">
            <h3 id="studentImportResultsTitle" class="h5">Preflight results</h3>
            <p id="studentImportSummary" aria-live="polite"></p>
            <button id="studentImportCommit" type="button" class="btn btn-success btn-sm mb-2 d-none">Commit validated file (100-row transactions)</button>
            <p id="studentImportProgress" class="small" role="status" aria-live="polite"></p>
            <p id="studentImportJobSummary" role="status" aria-live="polite"></p>
            <button id="studentImportJobExport" type="button" class="btn btn-outline-secondary btn-sm mb-2 d-none">Export committed rows CSV</button>
            <button id="studentImportDownloadErrors" type="button" class="btn btn-outline-secondary btn-sm mb-2">Download all validation errors CSV</button>
            <div class="table-responsive">
                <table class="table table-sm table-striped">
                    <thead><tr><th>Row</th><th>Source key</th><th>Student code</th><th>Validation errors</th></tr></thead>
                    <tbody id="studentImportErrorRows"></tbody>
                </table>
            </div>
        </div>
    </section>
    <section id="studentImportCommitted" class="card mt-3 d-none" aria-labelledby="studentImportCommittedTitle">
        <div class="card-body">
            <h3 id="studentImportCommittedTitle" class="h5">Committed batch reconciliation</h3>
            <p id="studentImportCommittedSummary"></p>
            <button id="studentImportReload" type="button" class="btn btn-outline-primary btn-sm">Refresh reconciliation</button>
            <div class="table-responsive mt-2">
                <table class="table table-sm"><thead><tr><th>Row</th><th>Source key</th><th>Status</th></tr></thead>
                    <tbody id="studentImportCommittedRows"></tbody></table>
            </div>
            <button id="studentImportMore" type="button" class="btn btn-outline-secondary btn-sm d-none">Next 50 rows</button>
        </div>
    </section>
</section>
@section Scripts {
    <script src="~/js/students/import-job.js" asp-append-version="true"></script>
    <script src="~/js/students/import-preview.js" asp-append-version="true"></script>
}
