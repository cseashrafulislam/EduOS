@{
    ViewData["Title"] = "Student Import Preflight";
}
<section class="container-fluid py-3" aria-labelledby="studentImportTitle">
    <header class="mb-3">
        <h2 id="studentImportTitle">Student Import — CSV / XLSX Dry Run</h2>
        <p class="text-muted">Inspect source columns, map your institution's student fields, then validate codes, current rolls, campus, batch capacity and previously imported source keys. <strong>No data is written.</strong> Maximum 5,000 rows and 6 MB per preview.</p>
        <a class="btn btn-outline-secondary btn-sm" asp-controller="Students" asp-action="Index">Back to Student Directory</a>
    </header>
    <div id="studentImportAlert" class="alert d-none" role="alert" aria-live="polite"></div>
    <form id="studentImportForm" class="card mb-3" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <label class="form-label" for="studentImportFile">Student source file</label>
            <input id="studentImportFile" class="form-control mb-3" type="file" accept=".csv,.xlsx" required />
            <button id="studentImportInspect" class="btn btn-outline-primary" type="button">Inspect columns</button>
            <div id="studentImportMapping" class="row g-3 mt-2 d-none" aria-label="Map source columns">
                <p class="small text-muted mb-0">Choose a different source column for every required field. Optional guardian details are validated only; no guardian or global Person will be automatically linked.</p>
                @foreach (var field in new[] { "SourceKey", "StudentCode", "FullName", "CampusId", "AcademicBatchId", "RollNo", "DateOfBirth", "GuardianName", "GuardianPhone" })
                {
                    <div class="col-md-4">
                        <label class="form-label" for="map-@field">@field @(new[] { "SourceKey", "StudentCode", "FullName", "CampusId", "AcademicBatchId", "RollNo" }.Contains(field) ? "*" : "(optional)")</label>
                        <select class="form-select" id="map-@field" data-import-field="@field"></select>
                    </div>
                }
                <div class="col-12">
                    <button id="studentImportPreview" class="btn btn-primary" type="submit">Run dry-run validation</button>
                </div>
            </div>
        </div>
    </form>
    <section id="studentImportResults" class="card d-none" aria-labelledby="studentImportResultsTitle">
        <div class="card-body">
            <h3 id="studentImportResultsTitle" class="h5">Preflight results</h3>
            <p id="studentImportSummary" aria-live="polite"></p>
            <p class="small text-muted">Errors are limited to the first 100 invalid rows. Preview is not a seat reservation or an import commit. The actual import must revalidate all data transactionally.</p>
            <button id="studentImportDownloadErrors" type="button" class="btn btn-outline-secondary btn-sm mb-2">Download shown errors CSV</button>
            <div class="table-responsive">
                <table class="table table-sm table-striped">
                    <thead><tr><th>Row</th><th>Source key</th><th>Student code</th><th>Validation errors</th></tr></thead>
                    <tbody id="studentImportErrorRows"></tbody>
                </table>
            </div>
        </div>
    </section>
</section>
@section Scripts {
    <script src="~/js/students/import-preview.js" asp-append-version="true"></script>
}
