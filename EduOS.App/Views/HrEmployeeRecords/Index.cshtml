@{
    ViewData["Title"] = "Employee Records";
}
<section id="employeeRecords" class="container-fluid py-3" data-can-create="@(User.IsInRole("TenantAdmin") ? "true" : "false")">
    <header class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div><h2 class="h4 mb-0">Employee Records</h2></div>
        <div class="d-flex gap-2 align-items-start">
            <a class="btn btn-sm btn-outline-secondary" href="/HR/Index">HR overview</a>
            <details class="position-relative">
                <summary class="btn btn-sm btn-outline-secondary" aria-label="Employee records help" title="Page help">ⓘ</summary>
                <div class="card card-body shadow-sm position-absolute end-0 mt-1" style="width:min(320px,85vw);z-index:10">
                    Search to edit an employee. Joining date and employee code are fixed after registration. Changing department or designation records assignment history. Employment exit is irreversible through this screen.
                </div>
            </details>
        </div>
    </header>
    @Html.AntiForgeryToken()
    <div id="employeeMessage" class="alert d-none" role="alert" aria-live="polite" tabindex="-1"></div>
    <div class="card mb-3"><div class="card-body">
        <form id="employeeLookup" class="row g-2 align-items-end">
            <div class="col-md-8"><label class="form-label" for="employeeSearch">Employee name or code</label><input class="form-control" id="employeeSearch" maxlength="100" type="search" autocomplete="off" /></div>
            <div class="col-md-4 d-flex gap-2"><button type="submit" class="btn btn-outline-primary">Search</button><button type="button" id="employeeNew" class="btn btn-primary">New employee</button></div>
        </form>
        <div class="table-responsive mt-3"><table class="table table-sm table-hover align-middle">
            <thead><tr><th>Code</th><th>Employee</th><th>Designation</th><th>Status</th><th>Action</th></tr></thead>
            <tbody id="employeeRows"><tr><td colspan="5" class="text-muted">Loading…</td></tr></tbody>
        </table></div>
        <div class="d-flex justify-content-between align-items-center">
            <button type="button" id="employeePrev" class="btn btn-sm btn-outline-secondary">Previous</button>
            <span id="employeePage" class="small" aria-live="polite"></span>
            <button type="button" id="employeeNext" class="btn btn-sm btn-outline-secondary">Next</button>
        </div>
    </div></div>
    <section class="card mb-3" id="employeeEditorPanel" hidden><div class="card-body">
        <div class="d-flex justify-content-between gap-2 align-items-center mb-3">
            <h3 class="h6 mb-0" id="employeeEditorTitle">Register employee</h3>
            <button type="button" id="employeeClose" class="btn btn-sm btn-outline-secondary">Close</button>
        </div>
        <form id="employeeForm">
            <div class="row g-3">
                <div class="col-md-4"><label for="employeeCode" class="form-label">Employee code *</label><input id="employeeCode" class="form-control" maxlength="50" required /></div>
                <div class="col-md-8"><label for="employeeName" class="form-label">Full name *</label><input id="employeeName" class="form-control" maxlength="200" required /></div>
                <div class="col-md-6"><label for="employeeDesignation" class="form-label">Designation *</label><select id="employeeDesignation" class="form-select" required><option value="">Select designation</option></select></div>
                <div class="col-md-6"><label for="employeeDepartment" class="form-label">Department</label><select id="employeeDepartment" class="form-select"><option value="">No department</option></select></div>
                <div class="col-md-4"><label for="employeeJoin" class="form-label">Joining date *</label><input id="employeeJoin" type="date" class="form-control" required /></div>
                <div class="col-md-4"><label for="employeePhone" class="form-label">Phone</label><input id="employeePhone" class="form-control" maxlength="30" type="tel" /></div>
                <div class="col-md-4"><label for="employeeEmail" class="form-label">Email</label><input id="employeeEmail" class="form-control" maxlength="200" type="email" /></div>
                <div class="col-12"><label for="employeeAddress" class="form-label">Address</label><textarea id="employeeAddress" class="form-control" maxlength="1000" rows="2"></textarea></div>
                <div class="col-12"><label class="form-check-label"><input id="employeeTeacher" type="checkbox" class="form-check-input me-2" />May teach classes</label></div>
            </div>
            <div class="d-flex gap-2 mt-3"><button id="employeeSave" class="btn btn-primary" type="submit">Save employee</button><button id="employeeCancel" type="button" class="btn btn-outline-secondary">Cancel</button></div>
        </form>
    </div></section>
    <section class="card mb-3" id="employeeStatusPanel" hidden><div class="card-body">
        <h3 class="h6">Employment status</h3>
        <form id="employeeStateForm">
            <div class="row g-2">
                <div class="col-md-4"><label for="employeeState" class="form-label">New status *</label><select id="employeeState" class="form-select" required><option value="">Choose status</option></select></div>
                <div class="col-md-4"><label for="employeeLeaving" class="form-label">Leaving date</label><input id="employeeLeaving" type="date" class="form-control" /></div>
                <div class="col-md-4"><label for="employeeReason" class="form-label">Reason</label><input id="employeeReason" class="form-control" maxlength="1000" /></div>
            </div>
            <button id="employeeStateSave" type="submit" class="btn btn-outline-danger mt-3">Change status</button>
        </form>
    </div></section>
    <section class="card mb-3" id="employeeHistoryPanel" hidden><div class="card-body">
        <h3 class="h6">Assignment history</h3>
        <div class="table-responsive"><table class="table table-sm"><thead><tr><th>From</th><th>To</th><th>Campus ID</th><th>Department ID</th><th>Designation ID</th><th>Reason</th></tr></thead><tbody id="employeeHistoryRows"></tbody></table></div>
        <div class="d-flex align-items-center gap-3"><button class="btn btn-sm btn-outline-secondary" type="button" id="employeeHistoryPrev">Previous</button><span id="employeeHistoryPage" aria-live="polite"></span><button class="btn btn-sm btn-outline-secondary" type="button" id="employeeHistoryNext">Next</button></div>
    </div></section>
</section>
@section Scripts {
    <script src="~/js/hr/employee-records.js" asp-append-version="true"></script>
}
