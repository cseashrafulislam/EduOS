@{
    ViewData["Title"]="Finance Adjustments";
}
<section class="container-fluid py-3" id="adjustRoot">
    <header class="d-flex justify-content-between align-items-center flex-wrap mb-3">
        <div><h2>Institutional Finance Adjustments</h2></div>
        <div class="d-flex gap-2"><a class="btn btn-outline-warning" href="/FinanceAdjustments/ReservationPreflight">Hostel / Transport finance preflight</a><a class="btn btn-outline-secondary" href="/FeeOperations/Index">Fees &amp; Billing</a><a class="btn btn-outline-primary" href="/FinanceAdjustments/DiscountAwards">Award register</a></div>
    </header>
    <div id="adjustAlert" class="d-none" role="alert" tabindex="-1"></div>
    <div class="row g-3 mb-3">
        <div class="col-xl-6"><div class="card h-100"><div class="card-body">
            <h3 class="h5">Discount rules</h3>
            <form id="adjustDiscountRuleForm" class="row g-2">
                <input id="adjustDrId" type="hidden" /><input id="adjustDrVersion" type="hidden" />
                <div class="col-md-6"><label for="adjustDrName" class="form-label">Name</label><input id="adjustDrName" class="form-control" maxlength="150" required /></div>
                <div class="col-md-3"><label for="adjustDrValue" class="form-label">Value</label><input id="adjustDrValue" type="number" step="0.0001" min="0" class="form-control" required /></div>
                <div class="col-md-3"><label for="adjustDrPercentage" class="form-label">Percent?</label><input id="adjustDrPercentage" type="checkbox" class="form-check-input d-block" /></div>
                <div class="col-md-6"><label for="adjustDrHead" class="form-label">Fee head</label><select id="adjustDrHead" class="form-select"><option value="">All fee heads</option></select></div>
                <div class="col-md-3"><label for="adjustDrFrom" class="form-label">Effective from</label><input id="adjustDrFrom" type="date" class="form-control" /></div>
                <div class="col-md-3"><label for="adjustDrTo" class="form-label">Effective to</label><input id="adjustDrTo" type="date" class="form-control" /></div>
                <div class="col-md-4"><label for="adjustDrActive" class="form-label">Active</label><input id="adjustDrActive" type="checkbox" class="form-check-input d-block" checked /></div>
                <div class="col-md-8 text-end"><button class="btn btn-primary" type="submit">Save discount rule</button> <button id="adjustDrNew" class="btn btn-outline-secondary" type="button">New</button></div>
            </form>
            <div class="table-responsive mt-3"><table class="table table-sm"><thead><tr><th>Name</th><th>Value</th><th>Active</th><th></th></tr></thead><tbody id="adjustDiscountRuleRows"></tbody></table></div>
        </div></div></div>
        <div class="col-xl-6"><div class="card h-100"><div class="card-body">
            <h3 class="h5">Fixed fine rules</h3>
            <form id="adjustFineRuleForm" class="row g-2">
                <input id="adjustFrId" type="hidden" /><input id="adjustFrVersion" type="hidden" />
                <div class="col-md-6"><label for="adjustFrName" class="form-label">Name</label><input id="adjustFrName" class="form-control" maxlength="150" required /></div>
                <div class="col-md-3"><label for="adjustFrAmount" class="form-label">Amount</label><input id="adjustFrAmount" type="number" step="0.01" min="0.01" class="form-control" required /></div>
                <div class="col-md-3"><label for="adjustFrGrace" class="form-label">Grace days</label><input id="adjustFrGrace" type="number" min="0" max="3650" value="0" class="form-control" required /></div>
                <div class="col-md-8"><label for="adjustFrHead" class="form-label">Fee head</label><select id="adjustFrHead" class="form-select"><option value="">Unassigned</option></select></div>
                <div class="col-md-4"><label for="adjustFrActive" class="form-label">Active</label><input id="adjustFrActive" type="checkbox" class="form-check-input d-block" checked /></div>
                <div class="col-12 text-end"><button class="btn btn-primary" type="submit">Save fine rule</button> <button id="adjustFrNew" class="btn btn-outline-secondary" type="button">New</button></div>
            </form>
            <div class="table-responsive mt-3"><table class="table table-sm"><thead><tr><th>Name</th><th>Amount</th><th>Active</th><th></th></tr></thead><tbody id="adjustFineRuleRows"></tbody></table></div>
        </div></div></div>
    </div>
    <div class="card mb-3"><div class="card-body">
        <h3 class="h5">Select student enrollment</h3>
        <div class="row g-2 align-items-end">
            <div class="col-md-5"><label for="adjustStudentSearch" class="form-label">Student code or name (at least 2 characters)</label><input id="adjustStudentSearch" class="form-control" maxlength="100" /></div>
            <div class="col-md-2"><button id="adjustSearchButton" type="button" class="btn btn-outline-primary w-100">Search</button></div>
            <div class="col-md-5"><label for="adjustEnrollment" class="form-label">Enrollment</label><select id="adjustEnrollment" class="form-select"><option value="">Select enrollment</option></select></div>
        </div>
    </div></div>
    <div class="row g-3 mb-3">
        <div class="col-xl-6"><div class="card h-100"><div class="card-body">
            <h3 class="h5">Assign discount</h3>
            <form id="adjustAssignForm" class="row g-2">
                <div class="col-md-6"><label for="adjustAssignRule" class="form-label">Active discount rule</label><select id="adjustAssignRule" class="form-select" required></select></div>
                <div class="col-md-3"><label for="adjustAssignFrom" class="form-label">From</label><input id="adjustAssignFrom" type="date" class="form-control" required /></div>
                <div class="col-md-3"><label for="adjustAssignTo" class="form-label">To (optional)</label><input id="adjustAssignTo" type="date" class="form-control" /></div>
                <div class="col-md-9"><label for="adjustAssignReason" class="form-label">Approval reason</label><input id="adjustAssignReason" class="form-control" maxlength="1000" /></div>
                <div class="col-md-3 align-self-end"><button class="btn btn-primary w-100" type="submit">Assign</button></div>
            </form>
        </div></div></div>
        <div class="col-xl-6"><div class="card h-100"><div class="card-body">
            <h3 class="h5">Assess fixed fine</h3>
            <form id="adjustApplyForm" class="row g-2">
                <div class="col-md-5"><label for="adjustApplyRule" class="form-label">Active fixed fine</label><select id="adjustApplyRule" class="form-select" required></select></div>
                <div class="col-md-3"><label for="adjustApplyDate" class="form-label">Fine date</label><input id="adjustApplyDate" type="date" class="form-control" required /></div>
                <div class="col-md-4"><label for="adjustApplyReason" class="form-label">Reason</label><input id="adjustApplyReason" class="form-control" maxlength="500" /></div>
                <div class="col-12 text-end"><button class="btn btn-warning" type="submit">Record fine</button></div>
            </form>
        </div></div></div>
    </div>
    <section class="card mb-3" id="fineRegisterRoot" aria-labelledby="fineRegisterHeading">
        <div class="card-body">
            <h3 class="h5" id="fineRegisterHeading">Institution-wide fine register</h3>
            <div id="fineRegisterAlert" class="alert d-none" role="status" aria-live="polite"></div>
            <div class="row g-2 align-items-end mb-3">
                <div class="col-md-2"><label class="form-label" for="fineRegisterCampus">Campus ID (optional)</label><input id="fineRegisterCampus" type="number" min="1" class="form-control" /></div>
                <div class="col-md-2"><label class="form-label" for="fineRegisterFrom">Fine from</label><input id="fineRegisterFrom" type="date" class="form-control" /></div>
                <div class="col-md-2"><label class="form-label" for="fineRegisterTo">Fine to</label><input id="fineRegisterTo" type="date" class="form-control" /></div>
                <div class="col-md-2"><label class="form-label" for="fineRegisterStatus">Status</label><select id="fineRegisterStatus" class="form-select"><option value="">All</option><option value="false">Unwaived</option><option value="true">Waived</option></select></div>
                <div class="col-md-2"><button id="fineRegisterLoad" type="button" class="btn btn-outline-primary w-100">Load fines</button></div>
            </div>
            <div class="row g-2 mb-3" aria-label="Administrative fine totals for selected campus and dates">
                <div class="col-md-3"><div class="border rounded p-2">Assessed (BDT): <strong id="fineRegisterRecorded">0.00</strong></div></div>
                <div class="col-md-3"><div class="border rounded p-2">Waived (BDT): <strong id="fineRegisterWaived">0.00</strong></div></div>
                <div class="col-md-3"><div class="border rounded p-2">Posted (BDT): <strong id="fineRegisterPosted">0.00</strong></div></div>
                <div class="col-md-3"><div class="border rounded p-2">Unposted (BDT): <strong id="fineRegisterOpen">0.00</strong></div></div>
            </div>
            <div class="table-responsive"><table class="table table-sm table-striped align-middle">
                <thead><tr><th>Fine date</th><th>Student</th><th>Campus</th><th>Rule</th><th>Amount (BDT)</th><th>Status</th><th>Reason</th><th>Action</th></tr></thead>
                <tbody id="fineRegisterRows"></tbody>
            </table></div>
            <div class="d-flex align-items-center gap-2">
                <button id="fineRegisterPrev" type="button" class="btn btn-sm btn-outline-secondary">Previous</button>
                <span id="fineRegisterPage" aria-live="polite">Page 1</span>
                <button id="fineRegisterNext" type="button" class="btn btn-sm btn-outline-secondary">Next</button>
            </div>
            <p class="small text-muted mt-2">Inspect opens the selected student's fine register. Posting requires a separate administrator, a dedicated fine fee head and an open accounting period.</p>
        </div>
    </section>
    <div class="card mb-3" id="adjustRefundSection"><div class="card-body">
        <h3 class="h5">Student cash refund review &amp; GL payout recording</h3>
        <p class="small text-warning">Record payout only after independently verified cash disbursement. This screen does not send money. Posted receipts and fully paid invoices remain immutable. A paid-invoice refund creates an additional income credit-note journal; partially paid invoices use a receivable contra journal. Every payout is independently approved and audited.</p>
        <div class="row g-2 mb-2 align-items-end">
            <div class="col-md-3"><label class="form-label" for="adjustRefundCampus">Campus ID (optional)</label><input id="adjustRefundCampus" type="number" min="1" class="form-control" /></div>
            <div class="col-md-3"><button id="adjustRefundRefresh" class="btn btn-outline-primary" type="button">Load cash receipts</button></div>
            <div class="col-md-6 text-end"><button id="adjustRefundPrev" class="btn btn-outline-secondary btn-sm" type="button">Previous</button> <span id="adjustRefundPage" class="small">Page 1</span> <button id="adjustRefundNext" class="btn btn-outline-secondary btn-sm" type="button">Next</button></div>
        </div>
        <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Receipt</th><th>Student</th><th>Campus</th><th>Cash received</th><th>Reserved/refunded</th><th></th></tr></thead><tbody id="adjustRefundPaymentRows"></tbody></table></div>
        <form id="adjustRefundRequestForm" class="row g-2 mb-3">
            <div class="col-md-4"><label class="form-label" for="adjustRefundPayment">Original posted cash receipt</label><select id="adjustRefundPayment" class="form-select" required></select></div>
            <div class="col-md-2"><label class="form-label" for="adjustRefundAmount">Amount (BDT)</label><input id="adjustRefundAmount" type="number" step="0.01" min="0.01" class="form-control" required /></div>
            <div class="col-md-4"><label class="form-label" for="adjustRefundReason">Reason</label><input id="adjustRefundReason" maxlength="1000" class="form-control" required /></div>
            <div class="col-md-2 align-self-end"><button class="btn btn-primary w-100" type="submit">Request refund</button></div>
        </form>
        <div class="row g-2 mb-3 align-items-end">
            <div class="col-md-4"><label class="form-label" for="adjustRefundPeriod">Open accounting period for verified payout</label><select id="adjustRefundPeriod" class="form-select"><option value="">Select open period</option></select></div>
            <div class="col-md-3"><label class="form-label" for="adjustRefundPayoutDate">Actual cash payout date</label><input id="adjustRefundPayoutDate" type="date" class="form-control" /></div>
            <div class="col-md-5"><label class="form-label" for="adjustRefundEvidence">Independently checked cash voucher/reference</label><input id="adjustRefundEvidence" class="form-control" maxlength="100" placeholder="Verified voucher number" /></div>
        </div>
        <h4 class="h6">Refund requests for displayed receipts</h4>
        <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Receipt</th><th>Amount</th><th>Status</th><th>Credit note journal</th><th>Requested by</th><th>Actions</th></tr></thead><tbody id="adjustRefundRows"></tbody></table></div>
    </div></div>
    <div class="card"><div class="card-body">
        <h3 class="h5">Enrollment adjustment register</h3>
        <button id="adjustRefresh" type="button" class="btn btn-sm btn-outline-secondary mb-3">Refresh register</button>
        <h4 class="h6">Discount assignments</h4>
        <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Rule</th><th>From</th><th>To</th><th>Approval reason</th><th>Status</th><th>Action</th></tr></thead><tbody id="adjustStudentDiscountRows"></tbody></table></div>
        <h4 class="h6 mt-3">Fine assessments and posted invoices</h4>
        <div class="row g-2 mb-2"><div class="col-md-4"><label class="form-label" for="adjustFinePeriod">Open period for fine posting</label><select id="adjustFinePeriod" class="form-select"><option value="">Select accounting period</option></select></div></div>
        <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Rule</th><th>Date</th><th>Amount</th><th>Status</th><th></th></tr></thead><tbody id="adjustStudentFineRows"></tbody></table></div>
    </div></div>
</section>
@section Scripts {
    <script src="~/js/finance/finance-adjustments.js" asp-append-version="true"></script>
    <script src="~/js/finance/finance-fine-register.js" asp-append-version="true"></script>
}
