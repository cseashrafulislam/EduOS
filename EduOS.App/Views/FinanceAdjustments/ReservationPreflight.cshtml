@{
    ViewData["Title"] = "Reservation Finance Preflight";
}
<section class="container-fluid py-3" id="reservationFinanceRoot">
    <header class="mb-3">
        <h2>Hostel / Transport finance preflight</h2>
        <p class="text-muted">Read-only institutional Finance review for reservation start-date, fixed-term, renewal, extension and occupied-transfer requests. This screen never approves or posts a monetary adjustment.</p>
        <a href="/FinanceAdjustments/Index" class="btn btn-outline-secondary btn-sm">Back to Finance Adjustments</a>
    </header>
    <div class="alert alert-warning">This screen can estimate automatic proration or a permitted manual override; it never changes rent, deposit, invoices, payments or journals. Charged reservation amendments still require an approved Finance adjustment before Operations can save them.</div>
    <section class="card mb-3" aria-label="Reservation Finance review queue">
        <div class="card-body">
            <h3 class="h5">Reservation Finance review queue</h3>
            <p class="small text-muted">Find canonical Hostel or Transport reservations needing Finance review before start-date, fixed-term, renewal or transfer changes. Campus is from enrollment; Inspect preflight checks resource linkage. No row grants approval.</p>
            <form id="reservationFinanceWorklistForm" class="row g-2 align-items-end mb-3">
                <div class="col-md-2"><label class="form-label" for="reservationFinanceWorklistKind">Module</label><select id="reservationFinanceWorklistKind" class="form-select"><option value="hostel">Hostel</option><option value="transport">Transport</option></select></div>
                <div class="col-md-2"><label class="form-label" for="reservationFinanceWorklistCampus">Campus ID (optional)</label><input id="reservationFinanceWorklistCampus" type="number" min="1" step="1" class="form-control" /></div>
                <div class="col-md-2"><label class="form-label" for="reservationFinanceWorklistFrom">Start date from</label><input id="reservationFinanceWorklistFrom" type="date" class="form-control" /></div>
                <div class="col-md-2"><label class="form-label" for="reservationFinanceWorklistTo">Start date to</label><input id="reservationFinanceWorklistTo" type="date" class="form-control" /></div>
                <div class="col-md-2"><label class="form-label" for="reservationFinanceWorklistReview">Review required only</label><div class="form-check"><input id="reservationFinanceWorklistReview" type="checkbox" class="form-check-input" checked /><label for="reservationFinanceWorklistReview" class="form-check-label">Exclude clear rows</label></div></div>
                <div class="col-md-2"><button class="btn btn-outline-primary w-100" type="submit">Load review queue</button></div>
            </form>
            <div id="reservationFinanceWorklistAlert" class="alert d-none" role="status" aria-live="polite"></div>
            <div class="table-responsive"><table class="table table-sm table-striped align-middle">
                <thead><tr><th>Reservation ID</th><th>Campus</th><th>Student</th><th>Start</th><th>Inclusive end</th><th>Monthly BDT</th><th>Deposit BDT</th><th>Exposure</th><th>Review</th></tr></thead>
                <tbody id="reservationFinanceWorklistRows"></tbody>
            </table></div>
            <div class="d-flex align-items-center gap-2">
                <button id="reservationFinanceWorklistPrev" type="button" class="btn btn-sm btn-outline-secondary" disabled>Previous</button>
                <span id="reservationFinanceWorklistPage" aria-live="polite">Not loaded</span>
                <button id="reservationFinanceWorklistNext" type="button" class="btn btn-sm btn-outline-secondary" disabled>Next</button>
            </div>
        </div>
    </section>
    <form id="reservationFinanceForm" class="card card-body mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-4"><label class="form-label" for="reservationFinanceKind">Reservation module</label><select id="reservationFinanceKind" class="form-select" required><option value="hostel">Hostel</option><option value="transport">Transport</option></select></div>
            <div class="col-md-4"><label class="form-label" for="reservationFinanceId">Canonical reservation ID</label><input id="reservationFinanceId" class="form-control" type="number" min="1" step="1" required /></div>
            <div class="col-md-4"><button class="btn btn-primary w-100" type="submit">Check Finance exposure</button></div>
        </div>
    </form>
    <section class="card mb-3" aria-label="Proposed reservation date review">
        <div class="card-body">
            <h3 class="h5">Review proposed start or end date</h3>
            <p class="small text-muted">First inspect the canonical reservation above. Finance evaluates proposed date boundaries against current invoice/payment exposure. No approval, proration or posting is performed.</p>
            <form id="reservationFinanceChangeReviewForm" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-4"><label for="reservationFinanceChangeReviewAction" class="form-label">Proposed change</label>
                    <select id="reservationFinanceChangeReviewAction" class="form-select">
                        <option value="reschedule-start">Reschedule start</option>
                        <option value="extend-end">Extend finite end</option>
                        <option value="shorten-end">Shorten finite end</option>
                    </select>
                </div>
                <div class="col-md-3"><label for="reservationFinanceChangeReviewStart" class="form-label">New start date</label>
                    <input type="date" id="reservationFinanceChangeReviewStart" class="form-control" />
                </div>
                <div class="col-md-3"><label for="reservationFinanceChangeReviewEnd" class="form-label">New inclusive end date</label>
                    <input type="date" id="reservationFinanceChangeReviewEnd" class="form-control" disabled />
                </div>
                <div class="col-md-2"><button type="submit" class="btn btn-outline-primary w-100" disabled>Review only</button></div>
                <div class="col-md-3"><label for="reservationFinanceChangeReviewSelection" class="form-label">Quotation selection</label>
                    <select id="reservationFinanceChangeReviewSelection" class="form-select"><option value="auto">Automatic</option><option value="manual">Manual final amount</option><option value="hybrid">Auto + Manual correction</option></select>
                </div>
                <div class="col-md-3"><label for="reservationFinanceChangeReviewManualAmount" class="form-label">Manual final / correction (BDT)</label>
                    <input id="reservationFinanceChangeReviewManualAmount" type="number" min="-999999999999.99" max="999999999999.99" step="0.01" class="form-control" disabled />
                </div>
                <div class="col-md-6"><label for="reservationFinanceChangeReviewManualReason" class="form-label">Manual adjustment reason</label>
                    <input id="reservationFinanceChangeReviewManualReason" type="text" minlength="20" maxlength="1000" class="form-control" disabled />
                </div>
            </form>
            <div id="reservationFinanceChangeReviewAlert" class="alert d-none mt-3" role="status" aria-live="polite"></div>
            <dl id="reservationFinanceChangeReviewDetails" class="row mt-3 mb-0"></dl>
        </div>
    </section>
    <section class="card mb-3" aria-label="Occupied Hostel transfer Finance review">
        <div class="card-body">
            <h3 class="h5">Occupied Hostel transfer — Finance review</h3>
            <p class="small text-muted">Inspect an active, already-started Hostel stay above, then enter a destination bed and effective date. Finance checks tenant/campus links and invoice/payment exposure; Operations still owns bed capacity and transfer execution. This is never approval.</p>
            <form id="hostelTransferFinanceReviewForm" class="row g-2 align-items-end">
                <div class="col-md-4"><label for="hostelTransferFinanceDestination" class="form-label">Destination bed ID</label>
                    <input id="hostelTransferFinanceDestination" class="form-control" type="number" min="1" step="1" required />
                </div>
                <div class="col-md-4"><label for="hostelTransferFinanceEffective" class="form-label">Effective date</label>
                    <input id="hostelTransferFinanceEffective" class="form-control" type="date" required />
                </div>
                <div class="col-md-4"><button type="submit" class="btn btn-outline-primary w-100" disabled>Review transfer only</button></div>
            </form>
            <div id="hostelTransferFinanceAlert" class="alert d-none mt-3" role="status" aria-live="polite"></div>
            <dl id="hostelTransferFinanceDetails" class="row mt-3 mb-0"></dl>
        </div>
    </section>
    <div id="reservationFinanceAlert" class="alert d-none" role="status" aria-live="polite"></div>
    <section id="reservationFinanceResult" class="card d-none" aria-label="Finance exposure">
        <div class="card-body">
            <h3 class="h5">Canonical reservation and posting exposure</h3>
            <dl id="reservationFinanceDetails" class="row mb-3"></dl>
            <div id="reservationFinanceDecision" class="alert alert-warning" role="status"></div>
            <p class="small text-muted">Financial exposure is conservatively enrollment/student-wide because invoices and receipts have no canonical Hostel/Transport reservation source reference. A clear preflight is informational only, not permission to change a reservation.</p>
            <section id="reservationFinanceEvidencePanel" class="border-top pt-3 d-none" aria-label="Invoice and payment evidence">
                <h4 class="h6">Invoice and payment evidence</h4>
                <p class="small text-muted">Read-only source records for Finance reconciliation. Invoices are enrollment-wide; payments are student-wide. These are NOT proven charges for this reservation and cannot approve any change.</p>
                <div class="row g-2 align-items-end mb-2">
                    <div class="col-sm-4"><label for="reservationFinanceEvidenceSource" class="form-label">Evidence source</label>
                        <select id="reservationFinanceEvidenceSource" class="form-select"><option value="invoice">Invoices</option><option value="payment">Payments / receipts</option></select>
                    </div>
                </div>
                <div id="reservationFinanceEvidenceAlert" class="alert d-none" role="status" aria-live="polite"></div>
                <div class="table-responsive"><table class="table table-sm table-striped align-middle">
                    <thead><tr><th>Reference</th><th>Date</th><th>State</th><th>Amount BDT</th><th>Paid BDT</th><th>Due BDT</th><th>Journal ID</th><th>Posting exposure</th></tr></thead>
                    <tbody id="reservationFinanceEvidenceRows"></tbody>
                </table></div>
                <div class="d-flex align-items-center gap-2">
                    <button id="reservationFinanceEvidencePrev" type="button" class="btn btn-sm btn-outline-secondary" disabled>Previous</button>
                    <span id="reservationFinanceEvidencePage" aria-live="polite">Not loaded</span>
                    <button id="reservationFinanceEvidenceNext" type="button" class="btn btn-sm btn-outline-secondary" disabled>Next</button>
                </div>
            </section>
        </div>
    </section>
</section>
@section Scripts {
    <script src="~/js/finance/reservation-finance-preflight.js" asp-append-version="true"></script>
    <script src="~/js/finance/reservation-finance-worklist.js" asp-append-version="true"></script>
    <script src="~/js/finance/reservation-finance-evidence.js" asp-append-version="true"></script>
    <script src="~/js/finance/reservation-finance-change-review.js" asp-append-version="true"></script>
    <script src="~/js/finance/hostel-transfer-finance-review.js" asp-append-version="true"></script>
}
