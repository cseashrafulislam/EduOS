@{
    var bn = System.Globalization.CultureInfo.CurrentUICulture.Name == "bn-BD";
    ViewData["Title"] = bn ? "বৃত্তি ও ছাড়ের বরাদ্দ" : "Scholarship & Discount Awards";
}
<section class="container-fluid py-3" id="discountAwardRegister">
    <header class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h1 class="h4 mb-0">@(bn ? "বৃত্তি ও ছাড়ের বরাদ্দ" : "Scholarship & Discount Awards")</h1>
        <a href="/FinanceAdjustments/Index" class="btn btn-outline-secondary btn-sm">@(bn ? "আর্থিক সমন্বয়" : "Adjustments")</a>
    </header>
    <div id="awardNotice" class="alert d-none" role="status" aria-live="polite"></div>
    <form id="awardFilters" class="card card-body row g-2 align-items-end mb-3">
        <div class="col-md-2"><label for="awardCampus" class="form-label">@(bn ? "ক্যাম্পাস আইডি" : "Campus ID")</label><input id="awardCampus" type="number" min="1" class="form-control" placeholder="@(bn ? "সব" : "All")" /></div>
        <div class="col-md-2"><label for="awardRule" class="form-label">@(bn ? "নিয়মের আইডি" : "Rule ID")</label><input id="awardRule" type="number" min="1" class="form-control" placeholder="@(bn ? "সব" : "All")" /></div>
        <div class="col-md-2"><label for="awardState" class="form-label">@(bn ? "বরাদ্দ" : "Assignment")</label><select id="awardState" class="form-select"><option value="">@(bn ? "সব" : "All")</option><option value="true">@(bn ? "সক্রিয়" : "Enabled")</option><option value="false">@(bn ? "নিষ্ক্রিয়" : "Deactivated")</option></select></div>
        <div class="col-md-3"><label for="awardSearch" class="form-label">@(bn ? "শিক্ষার্থী কোড / নিয়মের শুরুর অংশ" : "Student code / rule prefix")</label><input id="awardSearch" maxlength="100" class="form-control" /></div>
        <div class="col-md-1"><label for="awardSize" class="form-label">@(bn ? "সারি" : "Rows")</label><select id="awardSize" class="form-select"><option>25</option><option>50</option><option>100</option></select></div>
        <div class="col-md-2 d-grid"><button id="awardRun" type="submit" class="btn btn-primary">@(bn ? "তালিকা দেখুন" : "Run register")</button></div>
    </form>
    <section class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <strong id="awardTotals">@(bn ? "তালিকা লোড হয়নি" : "No register loaded")</strong>
            <button id="awardExport" type="button" class="btn btn-outline-primary btn-sm" disabled>@(bn ? "এই পৃষ্ঠার CSV" : "Export page CSV")</button>
        </div>
        <div class="table-responsive"><table class="table table-sm table-striped align-middle mb-0">
            <thead><tr><th>@(bn ? "শিক্ষার্থী কোড" : "Student code")</th><th>@(bn ? "ক্যাম্পাস" : "Campus")</th><th>@(bn ? "নিয়ম" : "Rule")</th><th>@(bn ? "মান" : "Value")</th><th>@(bn ? "শুরু" : "From")</th><th>@(bn ? "শেষ" : "To")</th><th>@(bn ? "অবস্থা" : "Status")</th><th>@(bn ? "অনুমোদনকারী আইডি" : "Approved by ID")</th></tr></thead>
            <tbody id="awardRows"><tr><td colspan="8" class="text-center p-3">@(bn ? "তালিকা চালু করুন।" : "Run the register.")</td></tr></tbody>
        </table></div>
        <div class="card-footer d-flex align-items-center flex-wrap gap-2">
            <button id="awardPrev" type="button" class="btn btn-outline-secondary btn-sm" disabled>@(bn ? "আগে" : "Previous")</button>
            <span id="awardPage" class="small" aria-live="polite">—</span>
            <button id="awardNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>@(bn ? "পরে" : "Next")</button>
        </div>
    </section>
</section>
@section Scripts {
    <script src="~/js/finance/discount-awards.js" asp-append-version="true"></script>
}
