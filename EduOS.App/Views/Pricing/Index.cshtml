@{
    ViewData["Title"] = "Pricing";
    Layout = "_PublicLayout";

    var pricingStrings = new
    {
        culture = CultureInfo.CurrentUICulture.Name,
        useBangla = CultureInfo.CurrentUICulture.Name.StartsWith("bn", StringComparison.OrdinalIgnoreCase),
        loading = T["LoadingPlans"].Value,
        loadFailed = T["PlansLoadFailed"].Value,
        noPlans = T["NoPlansAvailable"].Value,
        retry = T["Retry"].Value,
        mostPopular = T["MostPopular"].Value,
        free = T["Free"].Value,
        daysTrial = T["DaysTrialTemplate"].Value,
        startTrial = T["StartFreeTrial"].Value,
        getStarted = T["GetStarted"].Value,
        students = T["UpToStudentsTemplate"].Value,
        teachers = T["TeachersTemplate"].Value,
        campuses = T["CampusesTemplate"].Value,
        moreFeatures = T["MoreFeaturesTemplate"].Value,
        periods = new Dictionary<int, string>
        {
            [1] = T["PeriodMonth"].Value,
            [2] = T["PeriodThreeMonths"].Value,
            [3] = T["PeriodSixMonths"].Value,
            [4] = T["PeriodYear"].Value
        }
    };
    var pricingJson = System.Text.Json.JsonSerializer.Serialize(pricingStrings);
}

<div class="pricing-page">
    <section class="pricing-hero" aria-labelledby="pricingTitle">
        <h1 id="pricingTitle">@T["PricingTitle"]</h1>
        <p>@T["PricingSubtitle"]</p>
    </section>

    <section class="pricing-content" aria-label="@T["Pricing"]">
        <div class="text-center">
            <div class="billing-toggle" id="billingToggle" role="group" aria-label="@T["Pricing"]">
                <button type="button" data-cycle="1" class="active" aria-pressed="true">@T["Monthly"]</button>
                <button type="button" data-cycle="2" aria-pressed="false">@T["Quarterly"]</button>
                <button type="button" data-cycle="3" aria-pressed="false">@T["HalfYearly"]</button>
                <button type="button" data-cycle="4" aria-pressed="false">@T["Yearly"]</button>
            </div>
        </div>

        <div class="row g-3" id="plansGrid" aria-live="polite">
            <div class="col-12 text-center py-5 text-muted" role="status">
                <span class="spinner-border" aria-hidden="true"></span>
                <div class="mt-2">@T["LoadingPlans"]</div>
            </div>
        </div>
    </section>

    <section class="pricing-faq" aria-labelledby="faqTitle">
        <div class="pricing-faq-inner">
            <h2 id="faqTitle">@T["FrequentlyAskedQuestions"]</h2>

            <article class="faq-item">
                <button type="button" class="faq-question" aria-expanded="false" aria-controls="faqAnswer1">@T["FaqSwitchPlanQuestion"]</button>
                <div class="faq-answer" id="faqAnswer1" hidden>@T["FaqSwitchPlanAnswer"]</div>
            </article>
            <article class="faq-item">
                <button type="button" class="faq-question" aria-expanded="false" aria-controls="faqAnswer2">@T["FaqPaymentMethodsQuestion"]</button>
                <div class="faq-answer" id="faqAnswer2" hidden>@T["FaqPaymentMethodsAnswer"]</div>
            </article>
            <article class="faq-item">
                <button type="button" class="faq-question" aria-expanded="false" aria-controls="faqAnswer3">@T["FaqTrialQuestion"]</button>
                <div class="faq-answer" id="faqAnswer3" hidden>@T["FaqTrialAnswer"]</div>
            </article>
            <article class="faq-item">
                <button type="button" class="faq-question" aria-expanded="false" aria-controls="faqAnswer4">@T["FaqCancelQuestion"]</button>
                <div class="faq-answer" id="faqAnswer4" hidden>@T["FaqCancelAnswer"]</div>
            </article>
            <article class="faq-item">
                <button type="button" class="faq-question" aria-expanded="false" aria-controls="faqAnswer5">@T["FaqLargeInstitutionQuestion"]</button>
                <div class="faq-answer" id="faqAnswer5" hidden>@T["FaqLargeInstitutionAnswer"]</div>
            </article>
        </div>
    </section>
</div>

<script>
    (() => {
        'use strict';

        const i18n = @Html.Raw(pricingJson);
        const grid = document.getElementById('plansGrid');
        const billingToggle = document.getElementById('billingToggle');
        let plans = [];
        let selectedCycle = 1;

        function text(template, count) {
            return template.replace('{count}', Number(count || 0).toLocaleString(i18n.culture));
        }

        function displayName(item, banglaProperty, englishProperty) {
            return i18n.useBangla && item[banglaProperty]
                ? item[banglaProperty]
                : (item[englishProperty] || '');
        }

        function cyclePrice(plan) {
            const prices = {
                1: plan.monthlyPrice,
                2: plan.quarterlyPrice,
                3: plan.halfYearlyPrice,
                4: plan.yearlyPrice
            };
            return Number(prices[selectedCycle] || 0);
        }

        function formatMoney(amount, currency) {
            const currencyCode = String(currency || 'BDT').toUpperCase();
            try {
                return new Intl.NumberFormat(i18n.culture, {
                    style: 'currency',
                    currency: currencyCode,
                    maximumFractionDigits: 0
                }).format(amount);
            } catch {
                return `${currencyCode} ${Number(amount || 0).toLocaleString(i18n.culture)}`;
            }
        }

        function planLimitItem(label) {
            const item = document.createElement('li');
            const check = document.createElement('span');
            check.className = 'plan-feature-check';
            check.setAttribute('aria-hidden', 'true');
            check.textContent = '✓';
            const content = document.createElement('span');
            content.textContent = label;
            item.append(check, content);
            return item;
        }

        function createPlanCard(plan) {
            const column = document.createElement('div');
            column.className = 'col-md-6 col-xl-3';

            const card = document.createElement('article');
            card.className = `plan-card${plan.isRecommended ? ' recommended' : ''}`;

            if (plan.isRecommended) {
                const banner = document.createElement('div');
                banner.className = 'recommended-banner';
                banner.textContent = i18n.mostPopular;
                card.append(banner);
            }

            const name = document.createElement('h2');
            name.className = 'plan-name';
            name.textContent = displayName(plan, 'nameBangla', 'name');

            const description = document.createElement('p');
            description.className = 'plan-description';
            description.textContent = displayName(plan, 'shortDescriptionBangla', 'shortDescription');

            const price = document.createElement('div');
            price.className = 'plan-price';
            price.textContent = plan.isFreeTrial
                ? i18n.free
                : formatMoney(cyclePrice(plan), plan.currency);

            const period = document.createElement('div');
            period.className = 'plan-period';
            period.textContent = plan.isFreeTrial
                ? text(i18n.daysTrial, plan.trialDays)
                : `/ ${i18n.periods[selectedCycle]}`;

            const action = document.createElement('a');
            action.className = 'plan-cta';
            action.href = `/Account/Signup?plan=${encodeURIComponent(plan.code || '')}`;
            action.textContent = plan.isFreeTrial ? i18n.startTrial : i18n.getStarted;

            const features = document.createElement('ul');
            features.className = 'plan-features';
            features.append(
                planLimitItem(text(i18n.students, plan.maxStudents)),
                planLimitItem(text(i18n.teachers, plan.maxTeachers)),
                planLimitItem(text(i18n.campuses, plan.maxCampuses))
            );

            const planFeatures = Array.isArray(plan.features) ? plan.features : [];
            planFeatures.slice(0, 7).forEach(feature => {
                features.append(planLimitItem(
                    displayName(feature, 'featureNameBangla', 'featureName')));
            });
            if (planFeatures.length > 7) {
                const more = document.createElement('li');
                more.className = 'text-muted';
                more.textContent = text(i18n.moreFeatures, planFeatures.length - 7);
                features.append(more);
            }

            card.append(name, description, price, period, action, features);
            column.append(card);
            return column;
        }

        function renderPlans() {
            if (plans.length === 0) {
                const empty = document.createElement('p');
                empty.className = 'col-12 text-center py-5 text-muted';
                empty.textContent = i18n.noPlans;
                grid.replaceChildren(empty);
                return;
            }
            grid.replaceChildren(...plans.map(createPlanCard));
        }

        function showLoadError() {
            const wrapper = document.createElement('div');
            wrapper.className = 'col-12 text-center py-5';
            wrapper.setAttribute('role', 'alert');

            const message = document.createElement('p');
            message.className = 'text-danger';
            message.textContent = i18n.loadFailed;

            const retry = document.createElement('button');
            retry.type = 'button';
            retry.className = 'btn btn-outline-primary';
            retry.textContent = i18n.retry;
            retry.addEventListener('click', loadPlans);

            wrapper.append(message, retry);
            grid.replaceChildren(wrapper);
        }

        async function loadPlans() {
            try {
                const response = await fetch('/api/subscription-plans', {
                    cache: 'no-store',
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json' }
                });
                const payload = await response.json().catch(() => null);
                if (!response.ok || !payload?.success || !Array.isArray(payload.data)) {
                    throw new Error('Invalid plan response');
                }
                plans = payload.data;
                renderPlans();
            } catch (error) {
                console.warn('EduOS plans were unavailable.', error);
                showLoadError();
            }
        }

        billingToggle.addEventListener('click', event => {
            if (!(event.target instanceof Element)) return;
            const button = event.target.closest('button[data-cycle]');
            if (!button) return;
            selectedCycle = Number(button.dataset.cycle) || 1;
            billingToggle.querySelectorAll('button').forEach(candidate => {
                const isSelected = candidate === button;
                candidate.classList.toggle('active', isSelected);
                candidate.setAttribute('aria-pressed', String(isSelected));
            });
            renderPlans();
        });

        document.querySelectorAll('.faq-question').forEach(button => {
            button.addEventListener('click', () => {
                const answer = document.getElementById(button.getAttribute('aria-controls'));
                const expanded = button.getAttribute('aria-expanded') === 'true';
                button.setAttribute('aria-expanded', String(!expanded));
                if (answer) answer.hidden = expanded;
            });
        });

        document.addEventListener('DOMContentLoaded', loadPlans, { once: true });
    })();
</script>
