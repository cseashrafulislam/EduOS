@using System.Globalization
@{
    var bn = CultureInfo.CurrentUICulture.Name.StartsWith("bn", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = bn ? "ক্যাম্পাস রক্ষণাবেক্ষণ" : "Campus Maintenance";
    var manager = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("FacilitiesManager");
    var approver = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("FacilitiesApprover");
    var technician = User.IsInRole("FacilitiesTechnician");
}
<section class="container-fluid py-3" id="facilityWorkflow" data-bn="@bn.ToString().ToLowerInvariant()"
         data-manager="@manager.ToString().ToLowerInvariant()" data-approver="@approver.ToString().ToLowerInvariant()"
         data-technician="@technician.ToString().ToLowerInvariant()"
         data-user-id="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)">
    <header class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div><h2 class="h4 mb-1">@(bn ? "ক্যাম্পাস সার্ভিস অনুরোধ ও ওয়ার্ক অর্ডার" : "Campus Service Requests & Work Orders")</h2>
            <p class="small text-muted mb-0">@(bn ? "স্বতন্ত্র অনুমোদন, টেকনিশিয়ান কাজ ও যাচাইকৃত সমাপ্তি। নির্ধারিত টেকনিশিয়ান সময়ের মধ্যে এবং অনুমোদিত সরবরাহকারী বুকিং থাকলে তার সক্রিয় সময়ের মধ্যেই কাজ শুরু করুন। কাজ শুরু, বিরতি, পুনরায় শুরু, সমাপ্তি এবং পুনরায় জমার আগে সার্ভার টেকনিশিয়ানের বর্তমান অনুমতি যাচাই করে; অনুমতি বাতিল হলে ম্যানেজারকে সময়সূচি মুক্ত করে নতুন টেকনিশিয়ান দিতে হবে। স্টক ইস্যু ও ফাইন্যান্স পোস্টিং এখানে করা হয় না।" : "Independent approval, technician workflow and verified closure. Start work only during the active technician schedule and approved vendor window (when booked). The server rechecks live technician authorization before Start, Pause, Resume and Complete, including retries. Revoked assignments must be released and reassigned by a manager. Parts and Finance posting are not enabled here.")</p></div>
        <div class="d-flex flex-wrap gap-2"><a class="btn btn-outline-secondary btn-sm" asp-controller="FacilitySpaces" asp-action="Index">@(bn ? "স্থানসমূহ" : "Spaces")</a>
            <button class="btn btn-outline-secondary btn-sm" id="facilityExport" type="button">CSV</button>
            <button class="btn btn-outline-secondary btn-sm" type="button" onclick="window.print()">@(bn ? "প্রিন্ট" : "Print")</button></div>
    </header>
    <div id="workflowAlert" class="d-none" role="alert" aria-live="polite"></div>
    <div id="wfDashboard" class="row g-2 mb-3" role="status" aria-live="polite"
         aria-label="@(bn ? "সার্ভিস সারাংশ" : "Service dashboard")"></div>
    <div class="row g-3">
        <div class="col-12 col-xl-7">
            <div class="card mb-3"><div class="card-body">
                <form id="workflowSearch" class="row g-2 align-items-end">
                    <div class="col-sm-4"><label class="form-label" for="wfCampusFilter">@(bn ? "ক্যাম্পাস আইডি" : "Campus ID")</label><input id="wfCampusFilter" class="form-control" type="number" min="1" /></div>
                    <div class="col-sm-5"><label class="form-label" for="wfStateFilter">@(bn ? "অনুরোধের অবস্থা" : "Request status")</label>
                        <select id="wfStateFilter" class="form-select"><option value="">@(bn ? "সব" : "All")</option><option>Submitted</option><option>Triaged</option><option>Approved</option><option>Rejected</option></select></div>
                    <div class="col-12"><div class="form-check">
                        <input class="form-check-input" type="checkbox" id="wfOverdueOnly" />
                        <label class="form-check-label" for="wfOverdueOnly">@(bn ? "শুধু SLA সময় পেরোনো খোলা কাজ" : "Only overdue open work orders")</label>
                    </div></div>
                    <div class="col-sm-3"><button class="btn btn-primary w-100" type="submit">@(bn ? "খুঁজুন" : "Search")</button></div>
                </form>
                <div class="table-responsive mt-3"><table class="table table-sm table-striped align-middle">
                    <thead><tr><th>ID</th><th>@(bn ? "স্থান" : "Space")</th><th>@(bn ? "সমস্যা" : "Issue")</th><th>@(bn ? "অগ্রাধিকার" : "Priority")</th><th>@(bn ? "অবস্থা" : "State")</th><th>@(bn ? "নির্বাচন" : "Open")</th></tr></thead>
                    <tbody id="wfRows"></tbody></table></div>
                <div class="d-flex align-items-center gap-2"><button type="button" id="wfPrev" class="btn btn-outline-secondary btn-sm">@(bn ? "পূর্ববর্তী" : "Previous")</button><span id="wfPage" class="small" aria-live="polite"></span><button type="button" id="wfNext" class="btn btn-outline-secondary btn-sm">@(bn ? "পরবর্তী" : "Next")</button></div>
            </div></div>
            <div class="card"><div class="card-body">
                <h3 class="h6">@(bn ? "নতুন সার্ভিস অনুরোধ" : "New service request")</h3>
                <form id="wfCreate" class="row g-2">
                    <div class="col-12">
                        <label class="form-label" for="wfLocationSearch">@(bn ? "অনুমোদিত ক্যাম্পাস বা স্থানের নাম/কোড খুঁজুন" : "Find authorized campus or space by name/code")</label>
                        <div class="input-group">
                            <input id="wfLocationSearch" class="form-control" maxlength="100" autocomplete="off"
                                   placeholder="@(bn ? "ক্যাম্পাস বা স্থানের নাম" : "Campus or space name")" />
                            <button id="wfLocationFind" class="btn btn-outline-primary" type="button">@(bn ? "স্থান খুঁজুন" : "Find spaces")</button>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="wfLocationSelect">@(bn ? "অনুমোদিত সক্রিয় স্থান নির্বাচন" : "Select an authorized active space")</label>
                        <select id="wfLocationSelect" class="form-select" required disabled></select>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <button id="wfLocationPrev" class="btn btn-outline-secondary btn-sm" type="button" disabled>@(bn ? "আগের স্থান" : "Previous spaces")</button>
                            <span id="wfLocationPage" class="small" aria-live="polite"></span>
                            <button id="wfLocationNext" class="btn btn-outline-secondary btn-sm" type="button" disabled>@(bn ? "পরের স্থান" : "Next spaces")</button>
                        </div>
                    </div>
                    <div class="col-sm-6"><label class="form-label" for="wfCampus">@(bn ? "ক্যাম্পাস আইডি" : "Campus ID")</label><input id="wfCampus" type="number" min="1" required readonly class="form-control" /></div>
                    <div class="col-sm-6"><label class="form-label" for="wfSpace">@(bn ? "সুবিধা স্থানের আইডি" : "Facility space ID")</label><input id="wfSpace" type="number" min="1" required readonly class="form-control" /></div>
                    <div class="col-sm-6"><label class="form-label" for="wfCategory">@(bn ? "বিভাগ কোড" : "Category code")</label><input id="wfCategory" class="form-control" required maxlength="40" pattern="[A-Za-z0-9_]+" placeholder="ELECTRICAL" /></div>
                    <div class="col-sm-6"><label class="form-label" for="wfPriority">@(bn ? "অগ্রাধিকার" : "Priority")</label><select id="wfPriority" class="form-select"><option>Normal</option><option>Low</option><option>High</option><option>Urgent</option></select></div>
                    <div class="col-12"><label class="form-label" for="wfSummary">@(bn ? "সমস্যার সারাংশ" : "Issue summary")</label><input id="wfSummary" class="form-control" required minlength="5" maxlength="200" /></div>
                    <div class="col-12"><label class="form-label" for="wfDescription">@(bn ? "বিস্তারিত" : "Description")</label><textarea id="wfDescription" class="form-control" maxlength="2000" rows="2"></textarea></div>
                    <div class="col-12"><button type="submit" class="btn btn-success" disabled>@(bn ? "অনুরোধ জমা দিন" : "Submit request")</button></div>
                </form>
            </div></div>
        </div>
        <div class="col-12 col-xl-5"><div class="card"><div class="card-body">
            <h3 class="h6" id="wfSelected">@(bn ? "কাজ নির্বাচন করুন" : "Select a request")</h3>
            <p class="small text-muted" id="wfDetails" aria-live="polite"></p>
            @if (manager)
            {
                <section id="wfVendorPanel" class="border rounded p-2 mb-3 d-none" aria-label="@(bn ? "অনুমোদিত ক্যাম্পাস সরবরাহকারী" : "Approved campus vendors")">
                    <h4 class="h6">@(bn ? "নির্বাচিত সময়ে উপলব্ধ ক্যাম্পাস সরবরাহকারী" : "Available campus vendors for the selected window")</h4>
                    <p class="small text-muted">@(bn ? "আগে ভবিষ্যৎ বুকিং সময় দিন, তারপর সরবরাহকারী খুঁজুন। তালিকা সাময়িক; স্বতন্ত্র অনুমোদনের সময় সংঘাত আবার যাচাই হয়। স্টক বা হিসাব পোস্ট হয় না।" : "Enter a future booking window before searching. Availability is advisory; independent approval rechecks conflicts. No stock or Finance posting.")</p>
                    <div class="input-group input-group-sm">
                        <input id="wfVendorSearch" class="form-control" maxlength="100" autocomplete="off" aria-label="@(bn ? "সরবরাহকারীর নাম বা কোড" : "Vendor name or code")" />
                        <button id="wfVendorFind" class="btn btn-outline-primary" type="button">@(bn ? "খুঁজুন" : "Find vendors")</button>
                    </div>
                    <ul id="wfVendorRows" class="list-group list-group-flush small mt-2" aria-live="polite"></ul>
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <button id="wfVendorPrev" type="button" class="btn btn-outline-secondary btn-sm" disabled>@(bn ? "আগের" : "Previous")</button>
                        <span id="wfVendorPage" class="small" aria-live="polite"></span>
                        <button id="wfVendorNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>@(bn ? "পরের" : "Next")</button>
                    </div>
                </section>
            }
            <form id="wfTransition" class="row g-2 d-none">
                <div class="col-12"><label class="form-label" for="wfAction">@(bn ? "পরবর্তী পদক্ষেপ" : "Next action")</label><select id="wfAction" class="form-select" required></select></div>
                <div class="col-12"><label class="form-label" for="wfNote">@(bn ? "কারণ / প্রমাণ / যাচাই নোট" : "Reason / evidence / verification note")</label><textarea id="wfNote" class="form-control" rows="3" maxlength="1000"></textarea></div>
                <div class="col-12"><label class="form-label" for="wfDue">@(bn ? "SLA শেষ সময় (ট্রায়াজের জন্য)" : "SLA due (triage)")</label><input id="wfDue" class="form-control" type="datetime-local" /></div>
                <div class="col-12 d-none" id="wfTechnicianLookup">
                    <label class="form-label" for="wfTechSearch">@(bn ? "নির্বাচিত সময়ে উপলব্ধ টেকনিশিয়ান খুঁজুন" : "Find a technician available in the selected window")</label>
                    <p class="small text-muted mb-2">@(bn ? "ভবিষ্যতের শুরু ও তার পরের শেষ সময় দিন। সময় বদলালে টেকনিশিয়ান আবার নির্বাচন করুন। তালিকাটি সাময়িক; সংরক্ষণের আগে সার্ভার সংঘাত ও সময় শেষ হয়েছে কি না আবার যাচাই করে।" : "Enter a future start time and a later end time. Recheck availability after changing either time. The list is advisory; the server rechecks conflicts and elapsed windows before saving.")</p>
                    <div class="input-group">
                        <input id="wfTechSearch" class="form-control" maxlength="100" autocomplete="off" placeholder="@(bn ? "টেকনিশিয়ানের নাম" : "Technician name")" />
                        <button id="wfTechFind" class="btn btn-outline-primary" type="button">@(bn ? "খুঁজুন" : "Find")</button>
                    </div>
                    <label class="form-label mt-2" for="wfTechSelect">@(bn ? "এই ক্যাম্পাসের অনুমোদিত টেকনিশিয়ান" : "Eligible technicians for this campus")</label>
                    <select id="wfTechSelect" class="form-select" disabled></select>
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <button id="wfTechPrev" class="btn btn-outline-secondary btn-sm" type="button" disabled>@(bn ? "আগের" : "Previous")</button>
                        <span id="wfTechPage" class="small" aria-live="polite"></span>
                        <button id="wfTechNext" class="btn btn-outline-secondary btn-sm" type="button" disabled>@(bn ? "পরের" : "Next")</button>
                    </div>
                </div>
                <div class="col-12"><label class="form-label" for="wfVendorSelected">@(bn ? "নির্বাচিত অনুমোদিত সরবরাহকারী আইডি" : "Selected approved vendor ID")</label><input id="wfVendorSelected" class="form-control" type="number" min="1" readonly /></div>
                <div class="col-12"><label class="form-label" for="wfTech">@(bn ? "নির্বাচিত টেকনিশিয়ান আইডি" : "Selected technician ID")</label><input id="wfTech" class="form-control" type="number" min="1" readonly /></div>
                <div class="col-sm-6"><label class="form-label" for="wfStart">@(bn ? "কাজ শুরু" : "Scheduled start")</label><input id="wfStart" class="form-control" type="datetime-local" /></div>
                <div class="col-sm-6"><label class="form-label" for="wfEnd">@(bn ? "কাজ শেষ" : "Scheduled end")</label><input id="wfEnd" class="form-control" type="datetime-local" /></div>
                <div class="col-12"><p class="small text-muted mb-0">@(bn ? "অনুমোদিত সরবরাহকারী বুকিং থাকলে টেকনিশিয়ানের সময়সূচির সঙ্গে অন্তত কিছু সময় মিলতে হবে। দুটি সময়সীমা সম্পূর্ণ আলাদা হলে নতুন বুকিং বা সময়সূচি সংরক্ষণ করা যাবে না।" : "An approved vendor booking and technician schedule must overlap. Disjoint windows cannot be proposed, approved or scheduled.")</p></div>
                <div class="col-12"><button type="submit" class="btn btn-primary">@(bn ? "পরিবর্তন সংরক্ষণ" : "Apply transition")</button></div>
            </form>
            <hr /><h4 class="h6">@(bn ? "পরিবর্তনের ইতিহাস" : "Transition history")</h4>
            <div id="wfHistory" class="small" aria-live="polite"></div>
        </div></div></div>
    </div>
</section>
@section Scripts { <script src="~/js/facilities/work-orders.js" asp-append-version="true"></script> }