@model IReadOnlyList<EduOS.Core.DTOs.SaaS.TenantTerminologyDto>
@using EduOS.Core.DTOs.SaaS
@{
    ViewData["Title"] = "Institution Terminology";
    var selected = ViewBag.Edit as TenantTerminologyDto;
}
<div class="container-fluid py-3" id="tenantTerminologyPage">
    <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
        <div><h2 class="mb-1">Institution Terminology</h2>
            <p class="text-muted mb-0">Maintain English and Bangla terminology overrides for your tenant.</p></div>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Refresh</a>
    </div>
    @if (TempData["TerminologyError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    @if (TempData["TerminologySuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    <section class="card mb-3" aria-labelledby="ttDirectoryTitle">
        <div class="card-header"><h3 class="h5 mb-0" id="ttDirectoryTitle">Terminology directory</h3></div>
        <div class="card-body">
            <label for="ttFilter" class="form-label">Filter terminology</label>
            <input id="ttFilter" class="form-control mb-3" type="search" placeholder="Search by key or label" />
            <div class="table-responsive"><table class="table table-striped table-sm align-middle">
                <thead><tr><th scope="col">Key</th><th scope="col">Singular</th><th scope="col">Plural</th><th scope="col">Bangla singular</th><th scope="col">Bangla plural</th><th scope="col">Action</th></tr></thead>
                <tbody id="ttRows">
                    @foreach (var row in Model)
                    {
                        <tr>
                            <td>@row.Key</td><td>@row.SingularLabel</td><td>@row.PluralLabel</td>
                            <td>@row.SingularLabelBangla</td><td>@row.PluralLabelBangla</td>
                            <td>
                                <a class="btn btn-outline-primary btn-sm" asp-action="Index" asp-route-editId="@row.Id">Edit</a>
                                <form asp-controller="TenantTerminology" asp-action="Reset" method="post" class="d-inline tt-reset-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@row.Id" />
                                    <input type="hidden" name="rowVersion" value="@row.RowVersion" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm" aria-label="Reset @row.Key override">Reset override</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table></div>
            <p id="ttCount" class="small text-muted mb-0" aria-live="polite">@Model.Count entries loaded (maximum 500).</p>
        </div>
    </section>
    <section class="card" aria-labelledby="ttEditorTitle">
        <div class="card-header"><h3 class="h5 mb-0" id="ttEditorTitle">@(selected == null ? "New terminology" : "Edit terminology")</h3></div>
        <div class="card-body">
            <form asp-controller="TenantTerminology" asp-action="Save" method="post" id="ttForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@selected?.Id" />
                <input type="hidden" name="RowVersion" value="@selected?.RowVersion" />
                <div class="row g-2">
                    <div class="col-md-4"><label for="ttKey" class="form-label">Key *</label>
                        <input id="ttKey" name="Key" class="form-control" maxlength="100" required value="@selected?.Key" readonly="@(selected != null)" /></div>
                    <div class="col-md-4"><label for="ttSingular" class="form-label">Singular *</label>
                        <input id="ttSingular" name="SingularLabel" class="form-control" maxlength="100" required value="@selected?.SingularLabel" /></div>
                    <div class="col-md-4"><label for="ttPlural" class="form-label">Plural *</label>
                        <input id="ttPlural" name="PluralLabel" class="form-control" maxlength="100" required value="@selected?.PluralLabel" /></div>
                    <div class="col-md-6"><label for="ttSingularBn" class="form-label">Bangla singular</label>
                        <input id="ttSingularBn" name="SingularLabelBangla" class="form-control" maxlength="100" value="@selected?.SingularLabelBangla" /></div>
                    <div class="col-md-6"><label for="ttPluralBn" class="form-label">Bangla plural</label>
                        <input id="ttPluralBn" name="PluralLabelBangla" class="form-control" maxlength="100" value="@selected?.PluralLabelBangla" /></div>
                    <div class="col-auto"><button id="ttSave" class="btn btn-primary" type="submit">Save terminology</button></div>
                    <div class="col-auto"><a class="btn btn-outline-secondary" asp-action="Index">Clear form</a></div>
                </div>
            </form>
        </div>
    </section>
</div>
@section Scripts { <script src="~/js/platform/tenant-terminology.js" asp-append-version="true"></script> }
