@{
    var bn = System.Globalization.CultureInfo.CurrentUICulture.Name == "bn-BD";
    ViewData["Title"] = bn ? "উন্মুক্ত শিক্ষক শিক্ষাসামগ্রী" : "Public Teaching Materials";
}
<section id="teacherPublicCatalogue" class="container-fluid py-3">
    <header class="content-header-card d-flex justify-content-between align-items-center gap-2 flex-wrap mb-3">
        <h2 class="h4 mb-0">@(bn ? "উন্মুক্ত শিক্ষক শিক্ষাসামগ্রী" : "Public Teaching Materials")</h2>
        <a class="btn btn-sm btn-outline-secondary" href="/TeacherStudio">@(bn ? "রিসোর্স স্টুডিও" : "Resource Studio")</a>
        <details class="position-relative">
            <summary class="btn btn-sm btn-outline-secondary" aria-label="@(bn ? "পৃষ্ঠা সহায়তা" : "Page help")">ⓘ</summary>
            <div class="card card-body shadow-sm position-absolute end-0" style="width:min(22rem,85vw);z-index:10">
                <h3 class="h6">@(bn ? "ব্যবহার নির্দেশিকা" : "Page manual")</h3>
                <ol class="small mb-2">
                    <li>@(bn ? "শিরোনাম বা টপিক দিয়ে অনুসন্ধান করুন।" : "Search by title or topic.")</li>
                    <li>@(bn ? "স্বত্বাধিকারী, উৎস প্রতিষ্ঠান ও লাইসেন্স দেখে নিন।" : "Check the rights holder, source institution and licence.")</li>
                    <li>@(bn ? "লিংকটি মূল HTTPS প্রকাশকের পাতায় খুলুন; সেখানে ব্যবহারের শর্ত মানুন।" : "Open the original HTTPS publisher link and follow its reuse conditions.")</li>
                    <li>@(bn ? "উৎস প্রতিষ্ঠান রিসোর্স প্রত্যাহার করলে তালিকা থেকে মুছে যাবে।" : "Withdrawn or expired source resources disappear from this list.")</li>
                </ol>
                <p class="small mb-0">@(bn ? "অন্য প্রতিষ্ঠানের private upload, শিক্ষকের পরিচয়, বা অভ্যন্তরীণ লাইসেন্স প্রমাণ এখানে পাওয়া যাবে না।" : "Private uploads, teacher identities and internal licence evidence are not shared across institutions.")</p>
            </div>
        </details>
    </header>
    <form id="publicResourceSearch" class="card card-body mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-9"><label for="publicResourceTerm" class="form-label">@(bn ? "শিরোনাম বা টপিক" : "Title or topic")</label><input id="publicResourceTerm" class="form-control" maxlength="100" /></div>
            <div class="col-md-3"><button type="submit" class="btn btn-primary w-100">@(bn ? "খুঁজুন" : "Search")</button></div>
        </div>
    </form>
    <div id="publicResourceMessage" class="d-none alert" role="status" aria-live="polite"></div>
    <section class="card">
        <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>@(bn ? "শিক্ষাসামগ্রী" : "Material")</th><th>@(bn ? "শ্রেণি/বিষয়" : "Level / subject")</th><th>@(bn ? "উৎস ও লাইসেন্স" : "Source and licence")</th><th>@(bn ? "লিংক" : "Link")</th></tr></thead>
            <tbody id="publicResourceRows"><tr><td colspan="4">@(bn ? "লোড হচ্ছে…" : "Loading…")</td></tr></tbody>
        </table></div>
        <footer class="card-footer d-flex justify-content-end align-items-center gap-2">
            <button id="publicResourcePrev" type="button" class="btn btn-sm btn-outline-secondary" disabled>@(bn ? "আগে" : "Previous")</button>
            <span id="publicResourcePage" aria-live="polite"></span>
            <button id="publicResourceNext" type="button" class="btn btn-sm btn-outline-secondary" disabled>@(bn ? "পরে" : "Next")</button>
        </footer>
    </section>
</section>
@section Scripts { <script src="~/js/lms/teacher-public-catalogue.js" asp-append-version="true"></script> }
