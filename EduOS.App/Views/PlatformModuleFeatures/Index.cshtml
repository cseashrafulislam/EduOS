@{
    ViewData["Title"] = "Product Module Feature Mapping";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section id="platformModuleFeatures" class="container-fluid py-3">
    @Html.AntiForgeryToken()
    <h1 class="h4">Product Module Feature Mapping</h1>
    <p class="text-muted">Configure which product modules expose each feature. This does not change subscription-plan entitlements or tenant overrides. Removing a mapping is blocked until affected institutions are reconciled.</p>
    <div class="d-flex gap-2 align-items-end mb-3">
        <div>
            <label for="moduleFeatureModule" class="form-label">Product module</label>
            <select id="moduleFeatureModule" class="form-select"><option value="">Select module</option></select>
        </div>
        <button id="moduleFeatureRefresh" type="button" class="btn btn-outline-secondary">Refresh</button>
    </div>
    <p id="moduleFeatureStatus" role="status" aria-live="polite"></p>
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead><tr><th>Feature</th><th>Active</th><th>Mapped</th><th>Action</th></tr></thead>
            <tbody id="moduleFeatureRows"><tr><td colspan="4">Choose a product module.</td></tr></tbody>
        </table>
    </div>
</section>
@section Scripts {
    <script src="~/js/platform/module-feature-mapping.js" asp-append-version="true"></script>
}
