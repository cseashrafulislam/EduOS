@{
    ViewData["Title"] = "Salary Structure Register";
}
<section id="salaryWorkspace" class="container-fluid py-3">
    <div class="d-flex align-items-center gap-2 mb-2">
        <h2 class="h4 mb-0">Employee salary structures</h2>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle" data-bs-toggle="popover" data-bs-trigger="focus" data-bs-placement="bottom" data-bs-title="Salary structure guide" data-bs-content="Choose effective date and salary lines. Active STAT_ deductions are listed automatically but need your reviewed amount or rate (enter 0 only for a reviewed exemption). Tax/PF support Manual BDT or Auto percentage; PF needs an earning base. Preview excludes bonus, loans and proration. Auto Tax is not an NBR tax-slab engine. History is retained." aria-label="Salary structure guide">ⓘ</button>
    </div>
    <p class="d-flex flex-wrap gap-2"><a href="/PayrollOperations/Index" class="btn btn-sm btn-outline-secondary">Payroll operations</a><a href="/PayrollSalaryComponents/Index" class="btn btn-sm btn-outline-primary">Manage salary components</a></p>
    @Html.AntiForgeryToken()
    <div id="salaryNotice" class="alert d-none" role="alert" aria-live="polite"></div>
    <div class="card card-body mb-3">
        <h3 class="h6">Select employee</h3>
        <div class="row g-2 align-items-end">
            <div class="col-md-5"><label for="salaryEmployeeSearch" class="form-label">Name or employee code</label><input id="salaryEmployeeSearch" class="form-control" maxlength="100" minlength="2" /></div>
            <div class="col-md-2"><button id="salaryFind" type="button" class="btn btn-outline-primary">Search</button></div>
            <div class="col-md-5"><label for="salaryEmployee" class="form-label">Employee</label><select id="salaryEmployee" class="form-select"><option value="">Search and select an employee</option></select></div>
        </div>
    </div>
    <div class="card card-body mb-3">
        <h3 class="h6">Register salary structure</h3>
        <form id="salaryForm">
            <div class="row g-2 mb-3"><div class="col-md-4"><label for="salaryEffective" class="form-label">Effective from</label><input id="salaryEffective" type="date" class="form-control" required /></div></div>
            <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Salary component</th><th>Method</th><th>Amount (BDT) / Rate (%)</th><th>Auto basis</th><th></th></tr></thead><tbody id="salaryLines"></tbody></table></div>
            <div id="salaryEstimate" class="small fw-semibold mb-3" role="status" aria-live="polite"></div>
            <div class="d-flex gap-2"><button id="salaryAdd" type="button" class="btn btn-outline-secondary">Add component</button><button id="salarySave" type="submit" class="btn btn-primary">Save new structure</button></div>
        </form>
    </div>
    <div class="card card-body">
        <h3 class="h6">Effective-dated history</h3>
        <div class="table-responsive"><table class="table table-striped table-sm"><thead><tr><th>Effective from</th><th>Effective to</th><th>Status</th><th>Gross monthly (BDT)</th><th>Components</th><th>Action</th></tr></thead><tbody id="salaryHistory"></tbody></table></div>
        <div class="d-flex align-items-center gap-2"><button id="salaryPrev" type="button" class="btn btn-sm btn-outline-secondary">Previous</button><span id="salaryPage" aria-live="polite"></span><button id="salaryNext" type="button" class="btn btn-sm btn-outline-secondary">Next</button></div>
    </div>
</section>
@section Scripts { <script src="~/js/payroll/salary-structures.js" asp-append-version="true"></script> }
