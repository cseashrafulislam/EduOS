@using System.Globalization
@{
    var bn = CultureInfo.CurrentUICulture.Name == "bn-BD";
    ViewData["Title"] = bn ? "শিক্ষার্থী ফি বকেয়া ও সমন্বয়" : "Student Fee Receivables Aging";
}
<section class="container-fluid py-3" id="feeAgingApp">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
        <div><h2 class="h4 mb-1">@(bn ? "শিক্ষার্থী ফি বকেয়া ও সমন্বয়" : "Student Fee Receivables Aging")</h2>
            <p class="text-muted small mb-0">@(bn ? "শুধু প্রতিষ্ঠানের শিক্ষার্থী ইনভয়েস। প্ল্যাটফর্ম SaaS ইনভয়েস এখানে নেই।" : "Institutional student invoices only. Platform SaaS invoices are excluded.")</p></div>
        <a href="/FeeOperations/Index" class="btn btn-outline-secondary btn-sm">@(bn ? "ফি ও বিলিং" : "Fees & Billing")</a>
    </div>
    <div id="agingAlert" class="alert d-none" role="alert" tabindex="-1" aria-live="polite"></div>
    <div class="alert alert-info py-2 small">@(bn ? "এটি বর্তমান বকেয়ার সময়ভাগ: " : "This is a live aging of ")<strong>@(bn ? "বর্তমান অপরিশোধিত অর্থ" : "current unpaid balances")</strong>@(bn ? " রেফারেন্স তারিখ অনুযায়ী। এটি অতীতের নির্দিষ্ট দিনের হিসাব, পোস্ট করা সাধারণ লেজার বা নগদ প্রবাহ বিবরণী নয়।" : " against the reference date. It is not a historical as-of balance, a posted general ledger, or a cash-flow statement.")</div>
    <form id="agingFilters" class="card card-body mb-3 row g-2 align-items-end">
        <div class="col-lg-2"><label for="agingDate" class="form-label">@(bn ? "রেফারেন্স তারিখ" : "Reference date")</label>
            <input id="agingDate" type="date" class="form-control" required /></div>
        <div class="col-lg-3"><label for="agingCampus" class="form-label">@(bn ? "ক্যাম্পাস" : "Campus")</label>
            <select id="agingCampus" class="form-select"><option value="">@(bn ? "অনুমোদিত সব ক্যাম্পাস" : "All accessible campuses")</option></select></div>
        <div class="col-lg-4"><label for="agingSearch" class="form-label">@(bn ? "ইনভয়েস / শিক্ষার্থী কোড / নামের শুরু" : "Invoice / student code / name prefix")</label>
            <input id="agingSearch" maxlength="100" class="form-control" autocomplete="off" /></div>
        <div class="col-lg-1"><label for="agingPageSize" class="form-label">@(bn ? "সারি" : "Rows")</label>
            <select id="agingPageSize" class="form-select"><option>25</option><option>50</option><option>100</option></select></div>
        <div class="col-lg-2 d-grid"><button id="agingRun" type="submit" class="btn btn-primary">@(bn ? "প্রতিবেদন চালান" : "Run report")</button></div>
    </form>
    <section class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>@(bn ? "মুদ্রাভিত্তিক বকেয়ার সারাংশ" : "Currency-wise aging summary")</strong>
            <button type="button" id="agingExport" class="btn btn-outline-primary btn-sm" disabled>@(bn ? "বর্তমান পৃষ্ঠার CSV রপ্তানি" : "Export current page CSV")</button>
        </div>
        <div class="table-responsive"><table class="table table-sm table-striped mb-0">
            <thead><tr><th>@(bn ? "মুদ্রা" : "Currency")</th><th class="text-end">@(bn ? "ইনভয়েস" : "Invoices")</th><th class="text-end">@(bn ? "চলতি" : "Current")</th>
                <th class="text-end">@(bn ? "১–৩০ দিন" : "1–30 days")</th><th class="text-end">@(bn ? "৩১–৬০" : "31–60")</th><th class="text-end">@(bn ? "৬১–৯০" : "61–90")</th>
                <th class="text-end">@(bn ? "৯০ দিনের বেশি" : "Over 90")</th><th class="text-end">@(bn ? "বকেয়া" : "Outstanding")</th></tr></thead>
            <tbody id="agingTotals"><tr><td colspan="8" class="text-muted text-center p-3">@(bn ? "প্রতিবেদন চালান।" : "Run the report.")</td></tr></tbody>
        </table></div>
    </section>
    <section class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>@(bn ? "বকেয়া ইনভয়েস" : "Outstanding invoices")</strong><span id="agingCount" class="text-muted small">—</span>
        </div>
        <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>@(bn ? "ইনভয়েস" : "Invoice")</th><th>@(bn ? "শিক্ষার্থী" : "Student")</th><th>@(bn ? "ক্যাম্পাস" : "Campus")</th><th>@(bn ? "ইস্যুকৃত" : "Issued")</th><th>@(bn ? "শেষ তারিখ" : "Due date")</th>
                <th>@(bn ? "মুদ্রা" : "Currency")</th><th class="text-end">@(bn ? "ইনভয়েসের মোট" : "Invoice total")</th><th class="text-end">@(bn ? "পরিশোধিত" : "Paid")</th>
                <th class="text-end">@(bn ? "বকেয়া" : "Outstanding")</th><th class="text-end">@(bn ? "বিলম্বের দিন" : "Days overdue")</th><th>@(bn ? "সময়ভাগ" : "Bucket")</th></tr></thead>
            <tbody id="agingRows"><tr><td colspan="11" class="text-center text-muted p-3">@(bn ? "প্রতিবেদন লোড হয়নি।" : "No report loaded.")</td></tr></tbody>
        </table></div>
        <div class="card-footer d-flex align-items-center gap-2">
            <button type="button" id="agingPrev" class="btn btn-outline-secondary btn-sm" disabled>@(bn ? "আগের" : "Previous")</button>
            <span id="agingPage" class="small text-muted" aria-live="polite">—</span>
            <button type="button" id="agingNext" class="btn btn-outline-secondary btn-sm" disabled>@(bn ? "পরের" : "Next")</button>
        </div>
    </section>
    <section class="card mt-3" id="feeReconciliation">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div><strong>@(bn ? "ইনভয়েস / রসিদ সমন্বয়" : "Invoice / receipt reconciliation")</strong>
                <div class="small text-muted">@(bn ? "বর্তমান বকেয়া, সফল রসিদ বণ্টন, পরিশোধিত ফেরত, পোস্ট করা রিজার্ভেশন ক্রেডিট ও সংশ্লিষ্ট GL তথ্য। এটি পৃষ্ঠাভিত্তিক যাচাই, অতীতের স্ন্যাপশট নয়।" : "Current balances, successful receipt allocations, paid refunds, posted reservation credits (AR reduction and student liability) and linked GL provenance. Page-scoped review, not a historical as-of statement.")</div></div>
            <button type="button" class="btn btn-outline-primary btn-sm" id="reconcileRun">@(bn ? "বর্তমান ফিল্টার যাচাই" : "Check current filters")</button>
        </div>
        <div class="card-body">
            <div id="reconcileNotice" class="small text-muted mb-2" aria-live="polite">@(bn ? "সমন্বয় চালিয়ে ইনভয়েস দেখুন।" : "Run reconciliation to inspect invoices.")</div>
            <div class="table-responsive"><table class="table table-striped table-sm align-middle">
                <thead><tr><th>@(bn ? "ইনভয়েস" : "Invoice")</th><th>@(bn ? "শিক্ষার্থী" : "Student")</th><th>@(bn ? "ক্যাম্পাস" : "Campus")</th><th>@(bn ? "মোট" : "Total")</th><th>@(bn ? "পরিশোধিত" : "Paid")</th><th>@(bn ? "নিট বণ্টন" : "Net allocated")</th><th>@(bn ? "সব ক্রেডিট নোট" : "Credit notes (all)")</th><th>@(bn ? "রিজার্ভেশন ক্রেডিট" : "Reservation credit")</th><th>@(bn ? "শিক্ষার্থীর প্রাপ্য" : "Student payable")</th><th>@(bn ? "ক্রেডিট-পরবর্তী বকেয়া" : "Due after credit")</th><th>@(bn ? "অবস্থা" : "Status")</th><th>@(bn ? "অসংগতি" : "Exception")</th></tr></thead>
                <tbody id="reconcileRows"></tbody>
            </table></div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="reconcilePrev">@(bn ? "আগের" : "Previous")</button>
                <span class="small" id="reconcilePage" aria-live="polite">—</span>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="reconcileNext">@(bn ? "পরের" : "Next")</button>
            </div>
        </div>
    </section>
    <section class="card mt-3" id="feePaymentReconciliation">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div><strong>@(bn ? "রসিদ / বণ্টন সমন্বয়" : "Receipt / allocation reconciliation")</strong>
                <div class="small text-muted">@(bn ? "সফল ও ফেরত দেওয়া রসিদ, ইনভয়েস বণ্টন, পরিশোধিত ফেরত এবং GL তথ্য। TenantAdmin অবণ্টিত ও একাধিক ক্যাম্পাসের রসিদ দেখতে পারেন।" : "Successful and refunded institutional receipts, invoice allocations, paid refunds and GL provenance. Tenant administrators can review unallocated and mixed-campus receipts.")</div></div>
            <button type="button" class="btn btn-outline-primary btn-sm" id="paymentReconcileRun">@(bn ? "বর্তমান ফিল্টার যাচাই" : "Check current filters")</button>
        </div>
        <div class="card-body">
            <div id="paymentReconcileNotice" class="small text-muted mb-2" aria-live="polite">@(bn ? "সমন্বয় চালিয়ে রসিদ দেখুন।" : "Run reconciliation to inspect receipts.")</div>
            <div class="table-responsive"><table class="table table-striped table-sm align-middle">
                <thead><tr><th>@(bn ? "রসিদ" : "Receipt")</th><th>@(bn ? "শিক্ষার্থী" : "Student")</th><th>@(bn ? "ক্যাম্পাস" : "Campus")</th><th>@(bn ? "পরিমাণ" : "Amount")</th><th>@(bn ? "বণ্টিত" : "Allocated")</th><th>@(bn ? "পরিশোধিত ফেরত" : "Paid refunds")</th><th>@(bn ? "নিট বণ্টন" : "Net allocated")</th><th>@(bn ? "অবস্থা" : "Status")</th><th>@(bn ? "অসংগতি" : "Exception")</th></tr></thead>
                <tbody id="paymentReconcileRows"></tbody>
            </table></div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="paymentReconcilePrev" disabled>@(bn ? "আগের" : "Previous")</button>
                <span class="small" id="paymentReconcilePage" aria-live="polite">—</span>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="paymentReconcileNext" disabled>@(bn ? "পরের" : "Next")</button>
            </div>
        </div>
    </section>
    <section class="card mt-3" id="dailyCashCollections">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <strong>@(bn ? "দৈনিক নগদ সংগ্রহ তালিকা" : "Daily cash collection register")</strong>
        </div>
        <form id="dailyCashFilters" class="card-body row g-2 align-items-end">
            <div class="col-md-3"><label class="form-label" for="dailyCashFrom">@(bn ? "শুরু" : "From")</label><input id="dailyCashFrom" type="date" class="form-control" required /></div>
            <div class="col-md-3"><label class="form-label" for="dailyCashTo">@(bn ? "শেষ" : "To")</label><input id="dailyCashTo" type="date" class="form-control" required /></div>
            <div class="col-md-4"><label class="form-label" for="dailyCashCampus">@(bn ? "ক্যাম্পাস" : "Campus")</label><select id="dailyCashCampus" class="form-select"><option value="">@(bn ? "অনুমোদিত সব ক্যাম্পাস" : "All accessible campuses")</option></select></div>
            <div class="col-md-2 d-grid"><button id="dailyCashRun" type="submit" class="btn btn-primary">@(bn ? "প্রতিবেদন চালান" : "Run report")</button></div>
        </form>
        <div id="dailyCashNotice" class="alert d-none mx-3" role="status" aria-live="polite"></div>
        <div class="card-body pt-0">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <strong>@(bn ? "ক্যাম্পাসভিত্তিক মোট সংগ্রহ" : "Gross collection by campus")</strong>
                <button id="dailyCashExport" type="button" class="btn btn-outline-primary btn-sm" disabled>@(bn ? "দৃশ্যমান পৃষ্ঠার CSV রপ্তানি" : "Export visible page CSV")</button>
            </div>
            <div class="table-responsive"><table class="table table-sm table-striped">
                <thead><tr><th>@(bn ? "ক্যাম্পাস" : "Campus")</th><th>@(bn ? "মুদ্রা" : "Currency")</th><th class="text-end">@(bn ? "রসিদ" : "Receipts")</th><th class="text-end">@(bn ? "মোট সংগ্রহ" : "Gross collected")</th></tr></thead>
                <tbody id="dailyCashSummary"></tbody>
            </table></div>
            <div class="table-responsive"><table class="table table-sm table-striped">
                <thead><tr><th>@(bn ? "তারিখ" : "Date")</th><th>@(bn ? "রসিদ" : "Receipt")</th><th>@(bn ? "শিক্ষার্থী কোড" : "Student code")</th><th>@(bn ? "ক্যাম্পাস" : "Campus")</th><th>@(bn ? "ক্যাশিয়ার আইডি" : "Cashier ID")</th><th class="text-end">@(bn ? "মোট টাকা" : "Gross BDT")</th><th>@(bn ? "পরিশোধের অবস্থা" : "Payment state")</th><th>@(bn ? "GL সংযোগ (যাচাই নয়)" : "GL link (not verification)")</th></tr></thead>
                <tbody id="dailyCashRows"></tbody>
            </table></div>
            <div class="d-flex align-items-center gap-2">
                <button id="dailyCashPrev" type="button" class="btn btn-outline-secondary btn-sm" disabled>@(bn ? "আগের" : "Previous")</button>
                <span id="dailyCashPage" class="small text-muted">—</span>
                <button id="dailyCashNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>@(bn ? "পরের" : "Next")</button>
            </div>
        </div>
    </section>
</section>
@section Scripts { <script src="~/js/finance/fee-receivables-aging.js" asp-append-version="true"></script> <script src="~/js/finance/fee-reconciliation.js" asp-append-version="true"></script> <script src="~/js/finance/fee-payment-reconciliation.js" asp-append-version="true"></script> <script src="~/js/finance/daily-cash-collections.js" asp-append-version="true"></script> }
