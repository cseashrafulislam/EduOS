@using System.Globalization
@{
    ViewData["Title"] = CultureInfo.CurrentUICulture.Name == "bn-BD" ? "ওয়ার্কস্পেস ডিজাইন" : "Workspace Appearance";
    var bn = CultureInfo.CurrentUICulture.Name == "bn-BD";
}
<section class="container-fluid py-3" id="workspacePreferencesPage" aria-labelledby="workspaceTitle">
    <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
        <h2 class="h4 mb-0" id="workspaceTitle">@(bn ? "আপনার ওয়ার্কস্পেস" : "Your Workspace")</h2>
        <details id="workspaceHelp" class="position-relative">
            <summary class="btn btn-outline-secondary btn-sm" aria-label="@(bn ? "ওয়ার্কস্পেস সহায়তা" : "Workspace help")" title="@(bn ? "সহায়তা" : "Help")">ⓘ</summary>
            <div class="dropdown-menu show end-0 mt-1 p-3 shadow-sm page-header-help-panel" role="note">
                <p class="small mb-2">@(bn ? "থিম, রঙ, নেভিগেশন ও লেখার আকার এই প্রতিষ্ঠানের জন্য আলাদাভাবে সংরক্ষিত হয়।" : "Theme, color, navigation and text size are saved separately for this institution.")</p>
                <p class="small mb-0">@(bn ? "প্যানেল বা অনুমোদিত তালিকার কলাম সাজিয়ে সংরক্ষণ করুন। অন্য ডিভাইসে পরিবর্তন হলে বর্তমান সেটিং আবার লোড হবে।" : "Arrange panels or allowed table columns, then save. Changes from another device require a reload.")</p>
            </div>
        </details>
    </div>
    <div class="card shadow-sm">
        <div class="card-body">
            <form id="workspacePreferencesForm" autocomplete="off">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label" for="workspaceTheme">@(bn ? "থিম" : "Theme")</label>
                        <select class="form-select" id="workspaceTheme" name="theme">
                            <option value="system">@(bn ? "ডিভাইস অনুযায়ী" : "System")</option>
                            <option value="light">@(bn ? "লাইট" : "Light")</option>
                            <option value="dark">@(bn ? "ডার্ক" : "Dark")</option>
                        </select></div>
                    <div class="col-md-6"><label class="form-label" for="workspacePalette">@(bn ? "রঙের প্যালেট" : "Color palette")</label>
                        <select class="form-select" id="workspacePalette" name="palette">
                            <option value="blue">@(bn ? "নীল" : "Blue")</option>
                            <option value="teal">@(bn ? "সবুজাভ" : "Teal")</option>
                            <option value="violet">@(bn ? "বেগুনি" : "Violet")</option>
                        </select></div>
                    <div class="col-md-6"><label class="form-label" for="workspaceNavigation">@(bn ? "নেভিগেশন অবস্থান" : "Navigation position")</label>
                        <select class="form-select" id="workspaceNavigation" name="navigation">
                            <option value="left">@(bn ? "বামে" : "Left")</option>
                            <option value="right">@(bn ? "ডানে" : "Right")</option>
                            <option value="top">@(bn ? "উপরে" : "Top")</option>
                        </select></div>
                    <div class="col-md-6"><label class="form-label" for="workspaceDensity">@(bn ? "স্পেসিং" : "Spacing")</label>
                        <select class="form-select" id="workspaceDensity" name="density">
                            <option value="comfortable">@(bn ? "স্বাভাবিক" : "Comfortable")</option>
                            <option value="compact">@(bn ? "কমপ্যাক্ট" : "Compact")</option>
                        </select></div>
                    <div class="col-md-6"><label class="form-label" for="workspaceFontScale">@(bn ? "লেখার আকার" : "Text size")</label>
                        <select class="form-select" id="workspaceFontScale" name="fontScale">
                            <option value="normal">@(bn ? "স্বাভাবিক" : "Normal")</option>
                            <option value="large">@(bn ? "বড়" : "Large")</option>
                        </select></div>
                </div>
                <fieldset class="mt-4" aria-labelledby="workspacePanelsTitle">
                    <legend class="fs-6 fw-bold mb-2" id="workspacePanelsTitle">@(bn ? "ড্যাশবোর্ড প্যানেল" : "Dashboard panels")</legend>
                    <div class="list-group" id="workspaceDashboardPanels">
                        @foreach (var panel in new[] {
                            (Id: "capacity", En: "Capacity usage", Bn: "ব্যবহারের সীমা"),
                            (Id: "quick-actions", En: "Quick actions", Bn: "দ্রুত কাজ"),
                            (Id: "setup-checklist", En: "Setup checklist", Bn: "সেটআপ তালিকা")
                        })
                        {
                            <div class="list-group-item d-flex flex-wrap align-items-center gap-2" data-panel-row="@panel.Id">
                                <label class="form-check flex-grow-1 mb-0">
                                    <input type="checkbox" class="form-check-input me-2" checked />
                                    <span class="form-check-label">@(bn ? panel.Bn : panel.En)</span>
                                </label>
                                <div class="btn-group btn-group-sm" role="group" aria-label="@(bn ? panel.Bn : panel.En)">
                                    <button type="button" class="btn btn-outline-secondary" data-panel-move="up" aria-label="@(bn ? panel.Bn + " উপরে" : "Move " + panel.En + " up")">↑</button>
                                    <button type="button" class="btn btn-outline-secondary" data-panel-move="down" aria-label="@(bn ? panel.Bn + " নিচে" : "Move " + panel.En + " down")">↓</button>
                                </div>
                            </div>
                        }
                    </div>
                </fieldset>
                @if (User.IsInRole("TenantAdmin"))
                {
                    <fieldset class="mt-4" aria-labelledby="workspaceTablesTitle">
                        <legend class="fs-6 fw-bold mb-2" id="workspaceTablesTitle">@(bn ? "তালিকার কলাম" : "Table columns")</legend>
                        @foreach (var table in new[] {
                            (Id: "institution-users", En: "Institution users", Bn: "প্রতিষ্ঠানের ব্যবহারকারী",
                                Columns: new[] {
                                    (Id: "user", En: "User", Bn: "ব্যবহারকারী", Required: true),
                                    (Id: "membership", En: "Membership", Bn: "সদস্যপদ", Required: false),
                                    (Id: "roles", En: "Roles", Bn: "ভূমিকা", Required: false),
                                    (Id: "action", En: "Action", Bn: "কার্যক্রম", Required: true)
                                }),
                            (Id: "institution-invitations", En: "Invitation history", Bn: "আমন্ত্রণের ইতিহাস",
                                Columns: new[] {
                                    (Id: "email", En: "Email", Bn: "ইমেইল", Required: true),
                                    (Id: "role", En: "Initial role", Bn: "প্রাথমিক ভূমিকা", Required: false),
                                    (Id: "campus", En: "Campus", Bn: "ক্যাম্পাস", Required: false),
                                    (Id: "expires", En: "Expires", Bn: "মেয়াদ", Required: false),
                                    (Id: "status", En: "Status", Bn: "অবস্থা", Required: true),
                                    (Id: "action", En: "Action", Bn: "কার্যক্রম", Required: true)
                                }),
                            (Id: "institution-feature-audit", En: "Feature entitlement audit", Bn: "ফিচার অনুমতির নিরীক্ষা",
                                Columns: new[] {
                                    (Id: "feature", En: "Feature", Bn: "ফিচার", Required: true),
                                    (Id: "code", En: "Code", Bn: "কোড", Required: true),
                                    (Id: "plan", En: "Included in plan", Bn: "প্ল্যানে অন্তর্ভুক্ত", Required: false),
                                    (Id: "override", En: "Override", Bn: "ব্যতিক্রম", Required: false),
                                    (Id: "restriction", En: "Restriction", Bn: "সীমাবদ্ধতা", Required: true),
                                    (Id: "reason", En: "Reason", Bn: "কারণ", Required: false)
                                }),
                            (Id: "institution-activity-audit", En: "Activity audit log", Bn: "কার্যক্রম নিরীক্ষা",
                                Columns: new[] {
                                    (Id: "time", En: "UTC time", Bn: "ইউটিসি সময়", Required: true),
                                    (Id: "user", En: "User", Bn: "ব্যবহারকারী", Required: true),
                                    (Id: "action", En: "Action", Bn: "কার্যক্রম", Required: true),
                                    (Id: "entity", En: "Entity", Bn: "সত্তা", Required: false),
                                    (Id: "record", En: "Record", Bn: "রেকর্ড", Required: false),
                                    (Id: "ip", En: "IP address", Bn: "আইপি ঠিকানা", Required: false),
                                    (Id: "outcome", En: "Outcome", Bn: "ফলাফল", Required: true)
                                }),
                            (Id: "institution-campuses", En: "Campus directory", Bn: "ক্যাম্পাস তালিকা",
                                Columns: new[] {
                                    (Id: "campus", En: "Campus", Bn: "ক্যাম্পাস", Required: true),
                                    (Id: "code", En: "Code", Bn: "কোড", Required: true),
                                    (Id: "contact", En: "Contact", Bn: "যোগাযোগ", Required: false),
                                    (Id: "type", En: "Type", Bn: "ধরন", Required: false),
                                    (Id: "action", En: "Manage", Bn: "পরিচালনা", Required: true)
                                }),
                            (Id: "institution-change-history", En: "Institution change history", Bn: "প্রতিষ্ঠান পরিবর্তনের ইতিহাস",
                                Columns: new[] {
                                    (Id: "when", En: "When", Bn: "সময়", Required: true),
                                    (Id: "action", En: "Action", Bn: "কার্যক্রম", Required: true),
                                    (Id: "fields", En: "Changed fields", Bn: "পরিবর্তিত ক্ষেত্র", Required: false),
                                    (Id: "actor", En: "Actor", Bn: "সম্পাদনকারী", Required: true)
                                }),
                            (Id: "institution-settings", En: "Institution settings", Bn: "প্রতিষ্ঠানের সেটিং",
                                Columns: new[] {
                                    (Id: "key", En: "Key", Bn: "কী", Required: true),
                                    (Id: "category", En: "Category", Bn: "বিভাগ", Required: false),
                                    (Id: "value", En: "Value", Bn: "মান", Required: false),
                                    (Id: "protection", En: "Protection", Bn: "সুরক্ষা", Required: true),
                                    (Id: "action", En: "Action", Bn: "কার্যক্রম", Required: true)
                                }),
                            (Id: "institution-permission-exceptions", En: "Permission exceptions", Bn: "অনুমতির ব্যতিক্রম",
                                Columns: new[] {
                                    (Id: "permission", En: "Permission", Bn: "অনুমতি", Required: true),
                                    (Id: "mode", En: "Mode", Bn: "ধরন", Required: true),
                                    (Id: "reason", En: "Reason", Bn: "কারণ", Required: false),
                                    (Id: "expires", En: "Expires", Bn: "মেয়াদ", Required: true),
                                    (Id: "action", En: "Action", Bn: "কার্যক্রম", Required: true)
                                })
                        })
                        {
                            <div class="mb-3" data-table-row="@table.Id">
                                <h3 class="h6 mb-2">@(bn ? table.Bn : table.En)</h3>
                                <div class="list-group" data-table-columns>
                                    @foreach (var column in table.Columns)
                                    {
                                        <div class="list-group-item d-flex flex-wrap align-items-center gap-2" data-column-row="@column.Id" data-column-required="@(column.Required ? "true" : "false")">
                                            <label class="form-check flex-grow-1 mb-0">
                                                <input type="checkbox" class="form-check-input me-2" checked disabled="@(column.Required ? "disabled" : null)" />
                                                <span class="form-check-label">@(bn ? column.Bn : column.En)</span>
                                            </label>
                                            <div class="btn-group btn-group-sm" role="group" aria-label="@(bn ? column.Bn : column.En)">
                                                <button type="button" class="btn btn-outline-secondary" data-column-move="up" aria-label="@(bn ? column.Bn + " উপরে" : "Move " + column.En + " up")">↑</button>
                                                <button type="button" class="btn btn-outline-secondary" data-column-move="down" aria-label="@(bn ? column.Bn + " নিচে" : "Move " + column.En + " down")">↓</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </fieldset>
                }
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button class="btn btn-primary" type="submit" id="workspaceSave">@(bn ? "ডিজাইন সংরক্ষণ" : "Save appearance")</button>
                    <button class="btn btn-outline-secondary" type="button" id="workspaceReset">@(bn ? "ডিফল্টে ফিরুন" : "Reset to defaults")</button>
                </div>
                <p class="mt-3 mb-0" id="workspaceStatus" role="status" aria-live="polite"></p>
            </form>
        </div>
    </div>
</section>
@section Scripts {
    <script src="~/js/platform/workspace-preferences.js" asp-append-version="true"></script>
}
