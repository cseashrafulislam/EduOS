@{
    ViewData["Title"] = "Student Leave Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="studentLeavesApp" class="container-fluid py-4">
    @Html.AntiForgeryToken()
    <header class="mb-3"><h1 class="h4">Student Leave Management</h1><p class="text-muted">Applications, approval and attendance integration.</p></header>
    <div id="leaveNotice" class="alert d-none" role="alert" aria-live="polite"></div>
    <div class="row g-3">
        <section class="col-lg-5">
            <div class="card"><div class="card-body">
                <h2 class="h5">Select enrolled student</h2>
                <form id="leaveStudentSearch" class="input-group mb-3">
                    <input id="leaveStudentTerm" class="form-control" maxlength="100" placeholder="Student name or code" required />
                    <button type="submit" class="btn btn-outline-primary">Search</button>
                </form>
                <div id="leaveStudentResults" class="list-group mb-2"></div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <button id="leaveStudentPrevious" type="button" class="btn btn-sm btn-outline-secondary" disabled>Previous</button>
                    <span id="leaveStudentPageText" class="small text-muted" role="status"></span>
                    <button id="leaveStudentNext" type="button" class="btn btn-sm btn-outline-secondary" disabled>Next</button>
                </div>
                <p id="leaveStudentLabel" class="small text-muted"></p>
                <h2 class="h5 mt-4">Submit student leave</h2>
                <form id="leaveApplyForm" class="row g-3">
                    <div class="col-md-6"><label for="leaveStart" class="form-label">From *</label><input id="leaveStart" type="date" class="form-control" required /></div>
                    <div class="col-md-6"><label for="leaveEnd" class="form-label">To *</label><input id="leaveEnd" type="date" class="form-control" required /></div>
                    <div class="col-12"><label for="leaveReason" class="form-label">Reason *</label><textarea id="leaveReason" class="form-control" maxlength="2000" rows="3" required></textarea></div>
                    <div class="col-12"><label for="leaveFile" class="form-label">Supporting document (optional, max 5 MB)</label><input id="leaveFile" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx" /></div>
                    <div class="col-12"><button id="leaveSubmit" type="submit" class="btn btn-primary" disabled>Submit Leave</button></div>
                </form>
            </div></div>
        </section>
        <section class="col-lg-7">
            <div class="card"><div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2"><h2 class="h5">Applications &amp; review</h2><button id="leaveRefresh" type="button" class="btn btn-outline-secondary btn-sm">Refresh</button></div>
                <div class="mb-2"><label for="leaveFilter" class="form-label">Status</label><select id="leaveFilter" class="form-select"><option value="">All</option><option value="2">Submitted</option><option value="3">Approved</option><option value="4">Rejected</option><option value="5">Cancelled</option></select></div>
                <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Dates</th><th>Reason</th><th>State</th><th>Evidence / Decision</th></tr></thead><tbody id="leaveRows"><tr><td colspan="4">Loading...</td></tr></tbody></table></div>
                <div class="d-flex justify-content-between"><span id="leavePageText" class="small text-muted"></span><div class="btn-group"><button id="leavePrevious" type="button" class="btn btn-outline-secondary btn-sm">Previous</button><button id="leaveNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button></div></div>
            </div></div>
        </section>
    </div>
    <section id="studentLeavePeriodReport" class="card mt-4" aria-labelledby="leaveReportTitle">
        <div class="card-body">
            <h2 id="leaveReportTitle" class="h5">Student leave period report</h2>
            <p class="small text-muted">Historical enrollment and roll, approved or pending requests, and calendar days within the selected period.</p>
            <form id="leaveReportFilters" class="row g-3 align-items-end">
                <div class="col-md-4"><label for="leaveReportBatch" class="form-label">Academic batch</label>
                    <select id="leaveReportBatch" class="form-select" required><option value="">Loading batches…</option></select></div>
                <div class="col-md-2"><label for="leaveReportFrom" class="form-label">From</label>
                    <input id="leaveReportFrom" class="form-control" type="date" required /></div>
                <div class="col-md-2"><label for="leaveReportTo" class="form-label">To</label>
                    <input id="leaveReportTo" class="form-control" type="date" required /></div>
                <div class="col-md-2"><label for="leaveReportState" class="form-label">Status</label>
                    <select id="leaveReportState" class="form-select">
                        <option value="">All</option><option value="2">Submitted</option>
                        <option value="3">Approved</option><option value="4">Rejected</option>
                        <option value="5">Cancelled</option>
                    </select></div>
                <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Load report</button></div>
            </form>
            <p id="leaveReportStatus" class="small text-muted mt-3" role="status" aria-live="polite">Select filters to load the report.</p>
            <div class="d-flex gap-2 mb-2">
            <button id="leaveReportCsv" type="button" class="btn btn-sm btn-outline-primary" disabled>Export visible page CSV</button>
        </div>
        <div class="table-responsive"><table class="table table-sm table-striped align-middle">
                <thead><tr><th>Roll</th><th>Student code</th><th>Student</th><th>Leave dates</th>
                    <th>Days in period</th><th>Status</th><th>Reviewed</th></tr></thead>
                <tbody id="leaveReportRows"></tbody>
            </table></div>
            <div class="d-flex justify-content-between align-items-center">
                <button id="leaveReportPrevious" type="button" class="btn btn-sm btn-outline-secondary" disabled>Previous</button>
                <span id="leaveReportPage" class="small"></span>
                <button id="leaveReportNext" type="button" class="btn btn-sm btn-outline-secondary" disabled>Next</button>
            </div>
        </div>
    </section>
</div>
@section Scripts {
    <script src="~/js/attendance/student-leaves.js" asp-append-version="true"></script>
    <script src="~/js/attendance/leave-period-report.js" asp-append-version="true"></script>
}