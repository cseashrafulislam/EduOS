@{
    ViewData["Title"] = "HR Master Setup";
    var canEdit = User?.IsInRole("TenantAdmin") == true;
}
<section class="container-fluid py-3" id="hrSetupRoot" data-can-edit="@canEdit.ToString().ToLowerInvariant()">
    <header class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div><h2>HR Master Setup</h2><p class="text-muted mb-0">Institution-wide departments, designations and work shifts. Campus-specific departments are managed separately.</p></div>
        <a class="btn btn-outline-secondary" href="/HR/Index">Employee Administration</a>
    </header>
    <div id="hrSetupAlert" class="d-none" role="alert" tabindex="-1"></div>
    <div class="row g-3">
        <section class="col-xl-4">
            <div class="card h-100"><div class="card-body">
                <h3 class="h5">Departments</h3>
                @if (canEdit)
                {
                    <form id="hrSetupDepartmentForm" class="mb-3">
                        <input id="hrSetupDepartmentId" type="hidden" /><input id="hrSetupDepartmentVersion" type="hidden" />
                        <label class="form-label" for="hrSetupDepartmentCode">Code</label><input class="form-control mb-2" id="hrSetupDepartmentCode" required maxlength="50" />
                        <label class="form-label" for="hrSetupDepartmentName">Name</label><input class="form-control mb-2" id="hrSetupDepartmentName" required maxlength="150" />
                        <label class="form-label" for="hrSetupDepartmentParent">Parent department</label><select class="form-select mb-2" id="hrSetupDepartmentParent"><option value="">None</option></select>
                        <label class="form-check mb-2"><input class="form-check-input" type="checkbox" id="hrSetupDepartmentActive" checked /> Active</label>
                        <button class="btn btn-primary" type="submit">Save department</button><button class="btn btn-outline-secondary" type="reset">Clear</button>
                    </form>
                }
                <div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>Code</th><th>Department</th><th>Parent</th><th>Status</th><th></th></tr></thead><tbody id="hrSetupDepartmentRows"></tbody></table></div>
                <div class="d-flex justify-content-between align-items-center"><button class="btn btn-outline-secondary btn-sm" id="hrSetupDepartmentPrev" type="button">Previous</button><span id="hrSetupDepartmentPage" class="small"></span><button class="btn btn-outline-secondary btn-sm" id="hrSetupDepartmentNext" type="button">Next</button></div>
            </div></div>
        </section>
        <section class="col-xl-4">
            <div class="card h-100"><div class="card-body">
                <h3 class="h5">Designations</h3>
                @if (canEdit)
                {
                    <form id="hrSetupDesignationForm" class="mb-3">
                        <input id="hrSetupDesignationId" type="hidden" /><input id="hrSetupDesignationVersion" type="hidden" />
                        <label class="form-label" for="hrSetupDesignationCode">Code</label><input class="form-control mb-2" id="hrSetupDesignationCode" required maxlength="50" />
                        <label class="form-label" for="hrSetupDesignationName">Name</label><input class="form-control mb-2" id="hrSetupDesignationName" required maxlength="150" />
                        <label class="form-label" for="hrSetupDesignationRank">Rank</label><input class="form-control mb-2" id="hrSetupDesignationRank" type="number" min="0" max="100000" value="0" required />
                        <label class="form-check mb-2"><input class="form-check-input" type="checkbox" id="hrSetupDesignationActive" checked /> Active</label>
                        <button class="btn btn-primary" type="submit">Save designation</button><button class="btn btn-outline-secondary" type="reset">Clear</button>
                    </form>
                }
                <div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>Code</th><th>Designation</th><th>Rank</th><th>Status</th><th></th></tr></thead><tbody id="hrSetupDesignationRows"></tbody></table></div>
            </div></div>
        </section>
        <section class="col-xl-4">
            <div class="card h-100"><div class="card-body">
                <h3 class="h5">Work shifts</h3>
                @if (canEdit)
                {
                    <form id="hrSetupShiftForm" class="mb-3">
                        <input id="hrSetupShiftId" type="hidden" /><input id="hrSetupShiftVersion" type="hidden" />
                        <label class="form-label" for="hrSetupShiftCode">Code</label><input class="form-control mb-2" id="hrSetupShiftCode" required maxlength="50" />
                        <label class="form-label" for="hrSetupShiftName">Name</label><input class="form-control mb-2" id="hrSetupShiftName" required maxlength="100" />
                        <div class="row g-2"><div class="col-6"><label class="form-label" for="hrSetupShiftStart">Start</label><input class="form-control mb-2" id="hrSetupShiftStart" type="time" required /></div>
                        <div class="col-6"><label class="form-label" for="hrSetupShiftEnd">End</label><input class="form-control mb-2" id="hrSetupShiftEnd" type="time" required /></div></div>
                        <label class="form-label" for="hrSetupShiftGrace">Grace minutes</label><input class="form-control mb-2" id="hrSetupShiftGrace" type="number" min="0" max="240" value="0" required />
                        <label class="form-check mb-2"><input class="form-check-input" type="checkbox" id="hrSetupShiftActive" checked /> Active</label>
                        <button class="btn btn-primary" type="submit">Save shift</button><button class="btn btn-outline-secondary" type="reset">Clear</button>
                    </form>
                }
                <div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>Code</th><th>Shift</th><th>Hours</th><th>Grace</th><th>Status</th><th></th></tr></thead><tbody id="hrSetupShiftRows"></tbody></table></div>
            </div></div>
        </section>
    </div>
</section>
@section Scripts {
    <script src="~/js/hr/setup.js" asp-append-version="true"></script>
}
