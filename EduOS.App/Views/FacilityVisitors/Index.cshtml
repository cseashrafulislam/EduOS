@using System.Globalization
@{
    var bn = CultureInfo.CurrentUICulture.Name.StartsWith("bn", StringComparison.OrdinalIgnoreCase);
    var manager = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("FacilitiesManager");
    var privacyReviewer = User.IsInRole("TenantAdmin") || User.IsInRole("Principal");
    ViewData["Title"] = bn ? "ক্যাম্পাস ভিজিটর নিবন্ধন" : "Campus Visitor Visits";
}
<section class="container-fluid py-3" id="facilityVisitors"
         data-bn="@bn.ToString().ToLowerInvariant()" data-manager="@manager.ToString().ToLowerInvariant()"
         data-privacy-reviewer="@privacyReviewer.ToString().ToLowerInvariant()"
         data-user-id="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)">
    <header class="mb-3">
        <h2 class="h4">@(bn ? "ভিজিটর প্রি-রেজিস্ট্রেশন ও প্রবেশ নিয়ন্ত্রণ" : "Visitor Preregistration & Access Control")</h2>
        <p class="text-muted small">@(bn
            ? "ডেস্ক কর্মকর্তা ভবিষ্যৎ ভিজিট নিবন্ধন করবেন; আলাদা হোস্ট অনুমোদন দেবেন; অনুমোদিত সময়ের মধ্যে ব্যাজ দিয়ে প্রবেশ এবং পরে প্রস্থান নথিভুক্ত হবে। জাতীয় পরিচয়পত্র, ফোন বা ছবি সংগ্রহ করা হয় না। ঘটনা নথিভুক্ত করা যায়; স্বয়ংক্রিয় ডিলিট বন্ধ; ক্যাম্পাসের retention policy এবং legal hold/incident না থাকলে আলাদা কর্মকর্তার অনুমোদনে তথ্য মুছতে পারবেন; ক্যাম্পাসভিত্তিক উপস্থিতির সীমা ও ঐচ্ছিক আগাম প্রবেশ/ভিজিটের সময়সীমা কার্যকর হয়। পরিচয়বিহীন উপস্থিতি প্রতিবেদনে সময় পার হওয়া ভিজিটের সংখ্যা দেখা যায়; ডেস্ক যাচাই ছাড়া স্বয়ংক্রিয় প্রস্থান হয় না। অনুমতি বাতিল হলে পরবর্তী প্রত্যাখ্যাত অনুরোধে সংবেদনশীল তালিকা মুছে যায়। ডেস্ক কর্মকর্তা পরিচয়বিহীন সীমিত সারাংশ CSV নিতে পারবেন; প্রতিটি সফল এক্সপোর্টের অ্যাক্সেস অডিট সংরক্ষিত হয়।"
            : "The desk preregisters a future visit, a separate host approves it, and the desk records badge check-in and check-out within the approved window. No ID document, phone or photo is collected. The desk can record an incident; automatic deletion is disabled; manual two-person redaction requires a configured campus retention policy and no legal hold or incident; a configured occupancy ceiling and optional early-entry/duration limits are enforced. The PII-free occupancy view flags overdue checked-in visits for desk review, never automatic checkout. Revoked host/desk access blocks further writes and clears sensitive cards on the next denied request. Managers may export a bounded summary without visitor identity or incident narrative; each successful snapshot records an access audit.")</p>
    </header>
    @Html.AntiForgeryToken()
    <div id="fvStatus" class="alert alert-secondary small" role="status" aria-live="polite">
        @(bn ? "অনুমোদিত ভিজিট লোড হচ্ছে…" : "Loading authorized visits…")
    </div>
    @if (manager)
    {
        <form id="fvCreate" class="card card-body mb-3">
            <h3 class="h6">@(bn ? "নতুন ভিজিট নিবন্ধন" : "Preregister a visit")</h3>
            <div class="row g-2">
                <div class="col-md-3"><label for="fvCampus" class="form-label">@(bn ? "ক্যাম্পাস আইডি" : "Campus ID")</label>
                    <input id="fvCampus" class="form-control" type="number" min="1" required /></div>
                <div class="col-md-3"><label for="fvHost" class="form-label">@(bn ? "হোস্ট" : "Host")</label>
                    <select id="fvHost" class="form-select" required><option value="">@(bn ? "ক্যাম্পাস নির্বাচন করুন" : "Select campus first")</option></select></div>
                <div class="col-md-3"><label for="fvName" class="form-label">@(bn ? "ভিজিটরের নাম" : "Visitor name")</label>
                    <input id="fvName" class="form-control" maxlength="100" required autocomplete="off" /></div>
                <div class="col-md-3"><label for="fvPurpose" class="form-label">@(bn ? "উদ্দেশ্য" : "Purpose")</label>
                    <input id="fvPurpose" class="form-control" maxlength="200" required /></div>
                <div class="col-md-3"><label for="fvStart" class="form-label">@(bn ? "প্রবেশের নির্ধারিত সময়" : "Visit start")</label>
                    <input id="fvStart" class="form-control" type="datetime-local" required /></div>
                <div class="col-md-3"><label for="fvEnd" class="form-label">@(bn ? "প্রস্থানের নির্ধারিত সময়" : "Visit end")</label>
                    <input id="fvEnd" class="form-control" type="datetime-local" required /></div>
                <div class="col-12"><button class="btn btn-primary" type="submit">@(bn ? "প্রি-রেজিস্টার" : "Preregister")</button></div>
            </div>
        </form>
        <form id="fvOccupancy" class="card card-body mb-3">
            <h3 class="h6">@(bn ? "ক্যাম্পাসে বর্তমানে উপস্থিত" : "Current campus visitor occupancy")</h3>
            <div class="row g-2 align-items-end">
                <div class="col-md-3"><label for="fvOccupancyCampus" class="form-label">@(bn ? "ক্যাম্পাস আইডি" : "Campus ID")</label>
                    <input id="fvOccupancyCampus" class="form-control" type="number" min="1" required /></div>
                <div class="col-md-3"><button class="btn btn-outline-primary w-100" type="submit">@(bn ? "উপস্থিতি দেখুন" : "View occupancy")</button></div>
                <div id="fvOccupancyResult" class="col-md-6 small" role="status" aria-live="polite"></div>
            </div>
        </form>
        <form id="fvExport" class="card card-body mb-3">
            <h3 class="h6">@(bn ? "সীমিত তথ্যের ভিজিট সারাংশ CSV" : "PII-minimized visit summary CSV")</h3>
            <div class="row g-2 align-items-end">
                <div class="col-md-3"><label for="fvExportCampus" class="form-label">@(bn ? "ক্যাম্পাস আইডি" : "Campus ID")</label>
                    <input id="fvExportCampus" class="form-control" type="number" min="1" required /></div>
                <div class="col-md-3"><label for="fvExportFrom" class="form-label">@(bn ? "শুরু (স্থানীয় সময়)" : "From (local time)")</label>
                    <input id="fvExportFrom" class="form-control" type="datetime-local" required /></div>
                <div class="col-md-3"><label for="fvExportTo" class="form-label">@(bn ? "শেষ (স্থানীয় সময়)" : "To (local time)")</label>
                    <input id="fvExportTo" class="form-control" type="datetime-local" required /></div>
                <div class="col-md-3"><button id="fvExportButton" class="btn btn-outline-secondary w-100" type="submit">@(bn ? "CSV এক্সপোর্ট" : "Export CSV")</button></div>
            </div>
        </form>
    }
    <div class="card card-body">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <h3 class="h6 mb-0">@(bn ? "অনুমোদিত ভিজিট তালিকা" : "Authorized visits")</h3>
            <button id="fvRefresh" class="btn btn-outline-secondary btn-sm" type="button">@(bn ? "রিফ্রেশ" : "Refresh")</button>
        </div>
        <div class="row g-2 mb-3">
            <div class="col-md-3"><label class="form-label" for="fvBadge">@(bn ? "ব্যাজ কোড (৪–২০ অক্ষর)" : "Badge code (4–20 characters)")</label>
                <input id="fvBadge" class="form-control" maxlength="20" autocomplete="off" /></div>
            <div class="col-md-6"><label class="form-label" for="fvReason">@(bn ? "কারণ (প্রত্যাখ্যান/ঘটনায় ১০+ অক্ষর; পরিচয় তথ্য নয়)" : "Reason (10+ characters for rejection/incident; no sensitive identity data)")</label>
                <input id="fvReason" class="form-control" maxlength="200" /></div>
        </div>
        <div id="fvRows" class="vstack gap-2" aria-live="polite"></div>
    </div>
</section>
@section Scripts { <script src="~/js/facilities/visitors.js" asp-append-version="true"></script> }
