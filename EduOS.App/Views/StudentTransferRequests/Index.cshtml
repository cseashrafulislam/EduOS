@{
    ViewData["Title"] = "Student Transfer Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="transferRequestsApp" class="container-fluid py-4">
    @Html.AntiForgeryToken()
    <header class="mb-3 d-flex justify-content-between align-items-start gap-3 flex-wrap">
        <div>
            <h1 class="h4">Student Transfer Requests</h1>
            <p class="text-muted mb-0">Source-institution submission and approval. Approval does not issue a TC, close enrollment or transfer private records.</p>
        </div>
        <a class="btn btn-outline-secondary" href="/StudentLifecycle/Index">Final Exit &amp; TC</a>
    </header>
    <div id="transferNotice" class="alert alert-info" role="status" aria-live="polite">Search for an active student.</div>
    <div class="row g-3">
        <div class="col-lg-5">
            <section class="card border-0 shadow-sm"><div class="card-body">
                <h2 class="h6">Find student</h2>
                <form id="transferSearchForm" class="input-group mb-3">
                    <input id="transferSearch" class="form-control" maxlength="100" placeholder="Student code or name" aria-label="Student search" required />
                    <button type="submit" class="btn btn-outline-primary">Search</button>
                </form>
                <div id="transferMatches" class="list-group" aria-live="polite"></div>
                <div id="transferSelected" class="border rounded p-3 mt-3 d-none">
                    <strong id="transferStudentName"></strong>
                    <div id="transferEnrollment" class="small text-muted"></div>
                </div>
            </div></section>
        </div>
        <div class="col-lg-7">
            <section class="card border-0 shadow-sm mb-3"><div class="card-body">
                <h2 class="h6">Submit transfer request</h2>
                <form id="transferSubmitForm" class="row g-3">
                    <div class="col-12">
                        <label class="form-label" for="transferDestination">Destination institution tenant ID (optional)</label>
                        <input id="transferDestination" type="number" min="1" step="1" class="form-control" placeholder="Leave blank if not yet known" />
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="transferReason">Reason *</label>
                        <textarea id="transferReason" class="form-control" maxlength="1000" rows="3" required></textarea>
                    </div>
                    <div class="col-12">
                        <button id="transferSubmit" type="submit" class="btn btn-primary" disabled>Submit for source review</button>
                    </div>
                </form>
                <p class="small text-muted mt-3 mb-0">Current student and enrollment versions are validated atomically. The source institution must approve before a separate destination workflow can proceed.</p>
            </div></section>
            <section class="card border-0 shadow-sm"><div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h6 mb-0">Transfer request history</h2>
                    <button id="transferRefresh" type="button" class="btn btn-sm btn-outline-secondary" disabled>Refresh</button>
                </div>
                <div class="table-responsive"><table class="table table-sm align-middle">
                    <thead><tr><th>Requested (UTC)</th><th>Destination</th><th>State</th><th>Reason</th><th>Review</th></tr></thead>
                    <tbody id="transferHistory"><tr><td colspan="5">Select a student.</td></tr></tbody>
                </table></div>
            </div></section>
        </div>
    </div>
    <section id="destinationInbox" class="card border-0 shadow-sm mt-4" aria-labelledby="destinationInboxTitle">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                <div>
                    <h2 id="destinationInboxTitle" class="h5 mb-1">Incoming destination transfers</h2>
                    <p class="small text-muted mb-0">Only source-approved requests addressed to your institution appear here. No source learner or guardian details are disclosed. Acceptance acknowledges the handoff; it does not enroll a student or complete a transfer.</p>
                </div>
                <button id="destinationRefresh" type="button" class="btn btn-outline-primary btn-sm">Refresh inbox</button>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead><tr><th>Transfer reference</th><th>Source institution ID</th><th>Requested (UTC)</th><th>State</th><th>Decision</th></tr></thead>
                    <tbody id="destinationRows"><tr><td colspan="5">Loading incoming transfers…</td></tr></tbody>
                </table>
            </div>
        </div>
    </section>
</div>
@section Scripts {
    <script src="~/js/students/transfer-requests.js" asp-append-version="true"></script>
}
