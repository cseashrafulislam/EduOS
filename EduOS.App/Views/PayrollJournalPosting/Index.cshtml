@{
    ViewData["Title"] = "Institutional Payroll GL Posting";
    var canPost = User.IsInRole("TenantAdmin");
}
<section class="container-fluid py-3" id="payrollJournalPosting" data-post="@canPost.ToString().ToLowerInvariant()">
    <h2>Payroll → Institutional General Ledger</h2>
    <p class="text-muted">Review calculated runs, approve with a separate approver, then post payroll to salary expense, withholding liabilities and net salary payable. This is institutional accounting, not SaaS billing.</p>
    <p><a href="/PayrollOperations/Index" class="btn btn-sm btn-outline-secondary">Payroll operations</a> <a href="/AccountingJournals/Index" class="btn btn-sm btn-outline-secondary">Journal register</a></p>
    @Html.AntiForgeryToken()
    <div id="payrollPostingNotice" class="alert d-none" role="alert" aria-live="polite"></div>
    <form id="payrollPostingFilter" class="card card-body mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3"><label for="payrollPostingPeriod" class="form-label">Open accounting period</label><select id="payrollPostingPeriod" class="form-select"><option value="">Select period</option></select></div>
            <div class="col-md-3"><label for="payrollPostingPayable" class="form-label">Net salary payable liability</label><select id="payrollPostingPayable" class="form-select"><option value="">Select liability</option></select></div>
            <div class="col-md-3"><label class="form-check"><input id="payrollPostingUnposted" class="form-check-input" type="checkbox" checked /> Unposted only</label></div>
            <div class="col-md-3"><button type="submit" class="btn btn-primary">Load payroll</button></div>
        </div>
    </form>
    <div class="card card-body mb-3">
        <div class="table-responsive"><table class="table table-sm table-striped align-middle">
            <thead><tr><th>Run</th><th>Period end</th><th>Campus</th><th>Gross</th><th>Deductions</th><th>Net payable</th><th>GL status</th><th>Action</th></tr></thead>
            <tbody id="payrollPostingRows"></tbody>
        </table></div>
        <div class="d-flex align-items-center gap-2">
            <button id="payrollPostingPrev" type="button" class="btn btn-sm btn-outline-secondary">Previous</button>
            <span id="payrollPostingPage" aria-live="polite"></span>
            <button id="payrollPostingNext" type="button" class="btn btn-sm btn-outline-secondary">Next</button>
        </div>
    </div>
    @if(canPost)
    {
        <section id="payrollPostingMappingPanel" class="card card-body d-none">
            <h3 class="h6">Component → institutional COA mappings</h3>
            <p class="small text-muted">Each earning debits an expense ledger. Ordinary deductions credit withholding liabilities. LOAN_RECOVERY credits the original employee-loan receivable asset, settles each loan separately, and reduces its outstanding balance atomically. Only loans disbursed and unchanged since payroll calculation can be posted. Employer contributions require expense and liability accounts.</p>
            <div id="payrollPostingSelected" class="mb-2"></div>
            <div id="payrollPostingMappings" class="table-responsive"></div>
            <div class="d-flex gap-2"><button id="payrollPostingConfirm" type="button" class="btn btn-danger">Post balanced payroll GL</button><button id="payrollPostingCancel" type="button" class="btn btn-outline-secondary">Cancel</button></div>
        </section>
    }
</section>
@section Scripts { <script src="~/js/finance/payroll-journal-posting.js" asp-append-version="true"></script> }
