@{
    ViewData["Title"] = "Payment Reconciliation History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid py-4" id="paymentReconciliationApp">
    <header class="mb-4">
        <h1 class="h4 fw-bold">Subscription Payment Reconciliation</h1>
        <p class="text-muted mb-0">Read-only verification history. A paid invoice does not necessarily mean a future subscription period has started.</p>
    </header>
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <form id="reconciliationFilters" class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label" for="reconciliationSearch">Institution, invoice or transaction</label>
                    <input class="form-control" id="reconciliationSearch" type="search" maxlength="100" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="reconciliationOutcome">Verification decision</label>
                    <select class="form-select" id="reconciliationOutcome">
                        <option value="All">All</option>
                        <option value="Approved">Approved</option>
                        <option value="Rejected">Rejected</option>
                    </select>
                </div>
                <div class="col-md-3"><button type="submit" class="btn btn-primary w-100">Apply filters</button></div>
            </form>
            <div id="reconciliationStatus" class="small text-muted my-3" role="status" aria-live="polite"></div>
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle">
                    <thead><tr>
                        <th>Institution / Invoice</th><th>Decision / Verified</th><th>Payment</th>
                        <th>Invoice reconciliation</th><th>Subscription period</th><th>Review note</th>
                    </tr></thead>
                    <tbody id="reconciliationRows"></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center gap-2">
                <button id="reconciliationPrevious" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
                <span id="reconciliationPage" class="small text-muted"></span>
                <button id="reconciliationNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
            </div>
        </div>
    </div>
    <section class="card border-0 shadow-sm mt-4" aria-labelledby="gatewayRecoveryHeading">
        <div class="card-body">
            <h2 class="h5" id="gatewayRecoveryHeading">Gateway payment exception queue</h2>
            <p class="text-muted small">Triage AamarPay payments unresolved for at least 10 minutes. Overdue means 24+ hours; blocked means the invoice cannot currently accept settlement. Neither age nor a blocked invoice proves payment failure. Recovery independently verifies AamarPay and never approves from browser input.</p>
            <form id="gatewayRecoveryFilters" class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label" for="gatewayRecoverySearch">Institution, invoice or transaction</label>
                    <input class="form-control" id="gatewayRecoverySearch" type="search" maxlength="100" autocomplete="off" />
                </div>
                <div class="col-md-3"><label class="form-label" for="gatewayRecoveryCategory">Exception category</label>
                    <select id="gatewayRecoveryCategory" class="form-select"><option value="All">All unresolved</option><option value="Overdue">Overdue (24+ hours)</option><option value="Blocked">Blocked invoice</option><option value="Awaiting">Awaiting (&lt;24 hours)</option></select>
                </div>
                <div class="col-md-3"><button type="submit" class="btn btn-outline-primary w-100">Find exceptions</button></div>
            </form>
            <form id="gatewayRecoveryAntiforgery" method="post" class="d-none">@Html.AntiForgeryToken()</form>
            <div id="gatewayRecoveryStatus" class="small text-muted my-3" role="status" aria-live="polite"></div>
            <div id="gatewayInspectionResult" class="alert alert-warning d-none" role="status" aria-live="polite"></div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead><tr><th>Institution / Invoice</th><th>Transaction</th><th>Amount / Due</th><th>Initiated</th><th>Exception / Age</th><th>Action</th></tr></thead>
                    <tbody id="gatewayRecoveryRows"></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center gap-2">
                <button id="gatewayRecoveryPrevious" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
                <span id="gatewayRecoveryPage" class="small text-muted"></span>
                <button id="gatewayRecoveryNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
            </div>
        </div>
    </section>
    <section id="gatewayFinancePanel" class="card border-0 shadow-sm mt-4 d-none" aria-labelledby="gatewayFinanceHeading">
        <div class="card-body">
            <h2 class="h5" id="gatewayFinanceHeading">Gateway finance review trail</h2>
            <p class="text-muted small">Append-only investigation notes linked to independently verified AamarPay escalation evidence. Recording a review does not settle, refund, cancel, or adjust any payment or invoice. Do not enter bank account numbers or personal information in notes.</p>
            <div id="gatewayFinancePayment" class="fw-semibold mb-2"></div>
            <div id="gatewayFinanceStatus" class="small text-muted mb-3" role="status" aria-live="polite"></div>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead><tr><th>Recorded</th><th>Action</th><th>Reviewer</th><th>Finding / Note</th><th>Evidence</th></tr></thead>
                    <tbody id="gatewayFinanceRows"></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                <button id="gatewayFinancePrevious" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
                <span id="gatewayFinancePage" class="small text-muted"></span>
                <button id="gatewayFinanceNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
            </div>
            <form id="gatewayFinanceForm" class="row g-2">
                <div class="col-md-4">
                    <label for="gatewayFinanceDecision" class="form-label">Finance follow-up</label>
                    <select id="gatewayFinanceDecision" class="form-select" required>
                        <option value="Investigating">Investigating</option>
                        <option value="ProviderDisputeOpened">Provider dispute opened</option>
                        <option value="FinanceEscalated">Escalated to finance</option>
                        <option value="AwaitingRefundInstructions">Awaiting refund instructions</option>
                    </select>
                </div>
                <div class="col-md-8">
                    <label for="gatewayFinanceNote" class="form-label">Investigation note (10–500 characters)</label>
                    <textarea id="gatewayFinanceNote" class="form-control" rows="2" minlength="10" maxlength="500" required></textarea>
                </div>
                <div class="col-12"><button id="gatewayFinanceSave" type="submit" class="btn btn-outline-warning btn-sm" disabled>Record finance review</button></div>
            </form>
        </div>
    </section>
    <a class="btn btn-link mt-3" href="/Account/PaymentVerification">Review pending bank transfers</a>
</div>
@section Scripts {
    <script src="~/js/platform/payment-reconciliation-history.js" asp-append-version="true"></script>
}
