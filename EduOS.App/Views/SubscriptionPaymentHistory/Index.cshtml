@{
    var bn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
    ViewData["Title"] = bn ? "সাবস্ক্রিপশন পেমেন্ট ইতিহাস" : "Payment Reconciliation History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid py-2" id="paymentReconciliationApp" data-bangla="@(bn ? "true" : "false")">
    <header class="mb-2">
        <p class="text-muted mb-0">@(bn ? "যাচাইকৃত পেমেন্টের ইতিহাস। ইনভয়েস পরিশোধিত হলেও ভবিষ্যৎ সাবস্ক্রিপশন সময়কাল শুরু হয়েছে এমন নয়।" : "Read-only verification history. A paid invoice does not necessarily mean a future subscription period has started.")</p>
    </header>
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <form id="reconciliationFilters" class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label" for="reconciliationSearch">@(bn ? "প্রতিষ্ঠান, ইনভয়েস বা ট্রানজ্যাকশন" : "Institution, invoice or transaction")</label>
                    <input class="form-control" id="reconciliationSearch" type="search" maxlength="100" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="reconciliationOutcome">@(bn ? "যাচাইয়ের সিদ্ধান্ত" : "Verification decision")</label>
                    <select class="form-select" id="reconciliationOutcome">
                        <option value="All">@(bn ? "সব" : "All")</option>
                        <option value="Approved">@(bn ? "অনুমোদিত" : "Approved")</option>
                        <option value="Rejected">@(bn ? "প্রত্যাখ্যাত" : "Rejected")</option>
                    </select>
                </div>
                <div class="col-md-3"><button type="submit" class="btn btn-primary w-100">@(bn ? "ফিল্টার প্রয়োগ" : "Apply filters")</button></div>
            </form>
            <div id="reconciliationStatus" class="small text-muted my-3" role="status" aria-live="polite"></div>
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle">
                    <th scope="col"ead><tr>
                        <th scope="col">@(bn ? "প্রতিষ্ঠান / ইনভয়েস" : "Institution / Invoice")</th><th scope="col">@(bn ? "সিদ্ধান্ত / যাচাই" : "Decision / Verified")</th><th scope="col">@(bn ? "পেমেন্ট" : "Payment")</th>
                        <th scope="col">@(bn ? "ইনভয়েস মিল" : "Invoice reconciliation")</th><th scope="col">@(bn ? "সাবস্ক্রিপশনের সময়কাল" : "Subscription period")</th><th scope="col">@(bn ? "পর্যালোচনার মন্তব্য" : "Review note")</th>
                    </tr></thead>
                    <tbody id="reconciliationRows"></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center gap-2">
                <button id="reconciliationPrevious" type="button" class="btn btn-outline-secondary btn-sm">@(bn ? "আগের" : "Previous")</button>
                <span id="reconciliationPage" class="small text-muted"></span>
                <button id="reconciliationNext" type="button" class="btn btn-outline-secondary btn-sm">@(bn ? "পরের" : "Next")</button>
            </div>
        </div>
    </div>
    <section class="card border-0 shadow-sm mt-4" aria-labelledby="gatewayRecoveryHeading">
        <div class="card-body">
            <h2 class="h5" id="gatewayRecoveryHeading">@(bn ? "গেটওয়ে পেমেন্ট ব্যতিক্রমের তালিকা" : "Gateway payment exception queue")</h2>
            <p class="text-muted small">@(bn ? "১০ মিনিট বা তার বেশি সময় অমীমাংসিত AamarPay পেমেন্ট পর্যালোচনা করুন। ২৪ ঘণ্টার বেশি হলে বিলম্বিত; Blocked মানে ইনভয়েস এখন নিষ্পত্তি গ্রহণ করতে পারছে না। কোনো অবস্থাই পেমেন্ট ব্যর্থতার প্রমাণ নয়। Recovery নিজেই AamarPay যাচাই করে; ব্রাউজারের তথ্যের ওপর ভিত্তি করে পেমেন্ট অনুমোদন করে না।" : "Triage AamarPay payments unresolved for at least 10 minutes. Overdue means 24+ hours; blocked means the invoice cannot currently accept settlement. Neither age nor a blocked invoice proves payment failure. Recovery independently verifies AamarPay and never approves from browser input.")</p>
            <form id="gatewayRecoveryFilters" class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label" for="gatewayRecoverySearch">@(bn ? "প্রতিষ্ঠান, ইনভয়েস বা ট্রানজ্যাকশন" : "Institution, invoice or transaction")</label>
                    <input class="form-control" id="gatewayRecoverySearch" type="search" maxlength="100" autocomplete="off" />
                </div>
                <div class="col-md-3"><label class="form-label" for="gatewayRecoveryCategory">@(bn ? "ব্যতিক্রমের ধরন" : "Exception category")</label>
                    <select id="gatewayRecoveryCategory" class="form-select"><option value="All">@(bn ? "সব অমীমাংসিত" : "All unresolved")</option><option value="Overdue">@(bn ? "বিলম্বিত (২৪+ ঘণ্টা)" : "Overdue (24+ hours)")</option><option value="Blocked">@(bn ? "বাধাপ্রাপ্ত ইনভয়েস" : "Blocked invoice")</option><option value="Awaiting">@(bn ? "অপেক্ষমাণ (২৪ ঘণ্টার কম)" : "Awaiting (&lt;24 hours)")</option></select>
                </div>
                <div class="col-md-3"><button type="submit" class="btn btn-outline-primary w-100">@(bn ? "ব্যতিক্রম খুঁজুন" : "Find exceptions")</button></div>
            </form>
            <form id="gatewayRecoveryAntiforgery" method="post" class="d-none">@Html.AntiForgeryToken()</form>
            <div id="gatewayRecoveryStatus" class="small text-muted my-3" role="status" aria-live="polite"></div>
            <div id="gatewayInspectionResult" class="alert alert-warning d-none" role="status" aria-live="polite"></div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <th scope="col"ead><tr><th scope="col">@(bn ? "প্রতিষ্ঠান / ইনভয়েস" : "Institution / Invoice")</th><th scope="col">@(bn ? "ট্রানজ্যাকশন" : "Transaction")</th><th scope="col">@(bn ? "পরিমাণ / বকেয়া" : "Amount / Due")</th><th scope="col">@(bn ? "শুরু" : "Initiated")</th><th scope="col">@(bn ? "ব্যতিক্রম / সময়" : "Exception / Age")</th><th scope="col">@(bn ? "কাজ" : "Action")</th></tr></thead>
                    <tbody id="gatewayRecoveryRows"></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center gap-2">
                <button id="gatewayRecoveryPrevious" type="button" class="btn btn-outline-secondary btn-sm">@(bn ? "আগের" : "Previous")</button>
                <span id="gatewayRecoveryPage" class="small text-muted"></span>
                <button id="gatewayRecoveryNext" type="button" class="btn btn-outline-secondary btn-sm">@(bn ? "পরের" : "Next")</button>
            </div>
        </div>
    </section>
    <section id="gatewayFinancePanel" class="card border-0 shadow-sm mt-4 d-none" aria-labelledby="gatewayFinanceHeading">
        <div class="card-body">
            <h2 class="h5" id="gatewayFinanceHeading">@(bn ? "গেটওয়ে আর্থিক পর্যালোচনার ইতিহাস" : "Gateway finance review trail")</h2>
            <p class="text-muted small">@(bn ? "স্বতন্ত্রভাবে যাচাইকৃত AamarPay প্রমাণের সঙ্গে যুক্ত অপরিবর্তনীয় তদন্ত নোট। বাইরের কেস বন্ধ করতে পূর্ববর্তী পর্যালোচনা, নতুন প্রোভাইডার প্রমাণ ও কেস নম্বর প্রয়োজন। এটি কেবল প্রশাসনিক অনুসরণ বন্ধ করে; কোনো পেমেন্ট নিষ্পত্তি, রিফান্ড বা ইনভয়েস পরিবর্তন করে না। মন্তব্যে ব্যাংক নম্বর বা ব্যক্তিগত তথ্য দেবেন না।" : "Append-only investigation notes linked to independently verified AamarPay escalation evidence. External case closure requires a prior review, fresh provider evidence and an external case reference. It closes only administrative follow-up: it does not prove settlement, refund, cancel, or adjust any payment or invoice. Do not enter bank account numbers or personal information in notes.")</p>
            <div id="gatewayFinancePayment" class="fw-semibold mb-2"></div>
            <div id="gatewayFinanceStatus" class="small text-muted mb-3" role="status" aria-live="polite"></div>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <th scope="col"ead><tr><th scope="col">@(bn ? "নথিভুক্ত" : "Recorded")</th><th scope="col">@(bn ? "কাজ" : "Action")</th><th scope="col">@(bn ? "পর্যালোচনাকারী" : "Reviewer")</th><th scope="col">@(bn ? "পর্যবেক্ষণ / মন্তব্য" : "Finding / Note")</th><th scope="col">@(bn ? "প্রমাণ" : "Evidence")</th></tr></thead>
                    <tbody id="gatewayFinanceRows"></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                <button id="gatewayFinancePrevious" type="button" class="btn btn-outline-secondary btn-sm">@(bn ? "আগের" : "Previous")</button>
                <span id="gatewayFinancePage" class="small text-muted"></span>
                <button id="gatewayFinanceNext" type="button" class="btn btn-outline-secondary btn-sm">@(bn ? "পরের" : "Next")</button>
            </div>
            <form id="gatewayFinanceForm" class="row g-2">
                <div class="col-md-4">
                    <label for="gatewayFinanceDecision" class="form-label">@(bn ? "আর্থিক অনুসরণ" : "Finance follow-up")</label>
                    <select id="gatewayFinanceDecision" class="form-select" required>
                        <option value="Investigating">@(bn ? "তদন্ত চলছে" : "Investigating")</option>
                        <option value="ProviderDisputeOpened">@(bn ? "প্রোভাইডার অভিযোগ খোলা" : "Provider dispute opened")</option>
                        <option value="FinanceEscalated">@(bn ? "অর্থ বিভাগে পাঠানো" : "Escalated to finance")</option>
                        <option value="AwaitingRefundInstructions">@(bn ? "রিফান্ড নির্দেশনার অপেক্ষা" : "Awaiting refund instructions")</option>
                        <option value="ExternalCaseClosed">@(bn ? "বাইরের অনুসরণ বন্ধ (আর্থিক পরিবর্তন নয়)" : "Close external follow-up (no financial adjustment)")</option>
                    </select>
                </div>
                <div class="col-md-8">
                    <label for="gatewayFinanceNote" class="form-label">@(bn ? "তদন্ত মন্তব্য (১০–৫০০ অক্ষর)" : "Investigation note (10–500 characters)")</label>
                    <textarea id="gatewayFinanceNote" class="form-control" rows="2" minlength="10" maxlength="500" required></textarea>
                </div>
                <div id="gatewayFinanceExternalCaseGroup" class="col-md-4 d-none">
                    <label for="gatewayFinanceExternalCaseReference" class="form-label">@(bn ? "প্রোভাইডার / আর্থিক কেস নম্বর" : "External provider / finance case reference")</label>
                    <input id="gatewayFinanceExternalCaseReference" class="form-control" type="text"
                           minlength="6" maxlength="100" autocomplete="off" pattern="[A-Za-z0-9._/-]{6,100}" />
                    <small class="text-muted">@(bn ? "শুধু রেফারেন্স; পেমেন্টের গোপন তথ্য বা ব্যক্তিগত তথ্য লিখবেন না।" : "Reference only; never enter payment credentials or personal data.")</small>
                </div>
                <div class="col-12"><button id="gatewayFinanceSave" type="submit" class="btn btn-outline-warning btn-sm" disabled>@(bn ? "আর্থিক পর্যালোচনা সংরক্ষণ" : "Record finance review")</button></div>
            </form>
        </div>
    </section>
    <a class="btn btn-link mt-3" href="/Account/PaymentVerification">@(bn ? "অপেক্ষমাণ ব্যাংক ট্রান্সফার দেখুন" : "Review pending bank transfers")</a>
</div>
@section Scripts {
    <script src="~/js/platform/payment-reconciliation-history.js" asp-append-version="true"></script>
}
