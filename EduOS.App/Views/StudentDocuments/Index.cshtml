@{
    ViewData["Title"] = "Student Documents";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="studentDocumentsApp" class="container-fluid py-4">
    @Html.AntiForgeryToken()
    <header class="mb-3">
        <h1 class="h4">Student Documents</h1>
        <p class="text-muted">Private, malware-scanned student document attachments. Only institution administrators can access files. Sensitive or verification-required types use the separate protected verification process.</p>
    </header>
    <div id="documentNotice" class="alert alert-info" role="status" aria-live="polite">Find a student to begin.</div>
    <div class="row g-3">
        <div class="col-lg-5">
            <section class="card border-0 shadow-sm"><div class="card-body">
                <h2 class="h6">Find student</h2>
                <form id="documentSearchForm" class="input-group">
                    <input id="documentSearch" class="form-control" maxlength="100" required placeholder="Student name or code" aria-label="Search students" />
                    <button type="submit" class="btn btn-outline-primary">Search</button>
                </form>
                <div id="documentMatches" class="list-group mt-3" aria-live="polite"></div>
                <h3 id="documentSelected" class="h6 mt-3"></h3>
            </div></section>
            <section class="card border-0 shadow-sm mt-3"><div class="card-body">
                <h2 class="h6">Upload and attach</h2>
                <form id="documentAttachForm" class="row g-2">
                    <div class="col-12"><label for="documentType" class="form-label">Document type</label>
                        <select id="documentType" class="form-select" required></select></div>
                    <div class="col-12"><label for="documentTitle" class="form-label">Title (optional)</label>
                        <input id="documentTitle" class="form-control" maxlength="250" /></div>
                    <div class="col-12"><label for="documentFile" class="form-label">File (PDF, image or Word; maximum 5 MB)</label>
                        <input id="documentFile" class="form-control" type="file" accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx" required /></div>
                    <div class="col-12"><button id="documentAttach" class="btn btn-primary" disabled>Upload &amp; attach</button></div>
                </form>
            </div></section>
        </div>
        <div class="col-lg-7">
            <section class="card border-0 shadow-sm"><div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h6 mb-0">Student document history</h2>
                    <button id="documentRefresh" class="btn btn-sm btn-outline-secondary" type="button" disabled>Refresh</button>
                </div>
                <div class="table-responsive"><table class="table table-sm align-middle">
                    <thead><tr><th>Type</th><th>Title / file</th><th>Status</th><th>Action</th></tr></thead>
                    <tbody id="documentRows"><tr><td colspan="4">Select a student.</td></tr></tbody>
                </table></div>
            </div></section>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/students/documents.js" asp-append-version="true"></script>
}
