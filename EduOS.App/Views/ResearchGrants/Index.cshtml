@{
    var bn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
    ViewData["Title"] = bn ? "গবেষণা অনুদান ও প্রকল্প" : "Research Grants & Projects";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var coordinator = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("ResearchCoordinator");
}
<div id="researchGrantWorkspace" class="container-fluid py-4">
    @Html.AntiForgeryToken()
    <div id="grantNotice" class="alert d-none" role="status" aria-live="polite"></div>
    <div class="row g-3">
        <div class="col-xl-4">
            @if (coordinator)
            {
                <section class="card border-0 shadow-sm mb-3" aria-label="Grant scheme configuration">
                    <div class="card-body">
                        <h2 class="h5" data-g-en="Grant scheme settings" data-g-bn="অনুদান স্কিম সেটিংস">Grant scheme settings</h2>
                        <form id="grantSchemeForm">
                            <label for="grantSchemeCode" class="form-label" data-g-en="Scheme code" data-g-bn="স্কিম কোড">Scheme code</label>
                            <input id="grantSchemeCode" class="form-control mb-2" maxlength="40" required pattern="[A-Za-z0-9_]+" />
                            <label for="grantSchemeName" class="form-label" data-g-en="Scheme name" data-g-bn="স্কিমের নাম">Scheme name</label>
                            <input id="grantSchemeName" class="form-control mb-2" maxlength="200" required />
                            <label for="grantCurrency" class="form-label" data-g-en="Currency (ISO code)" data-g-bn="মুদ্রা (ISO কোড)">Currency (ISO code)</label>
                            <input id="grantCurrency" class="form-control mb-2" maxlength="3" pattern="[A-Za-z]{3}" value="BDT" required />
                            <label for="grantSchemeMax" class="form-label" data-g-en="Maximum award" data-g-bn="সর্বোচ্চ অনুমোদন">Maximum award</label>
                            <input id="grantSchemeMax" class="form-control mb-2" type="number" min="0.01" step="0.01" required />
                            <button class="btn btn-outline-primary" type="submit" data-g-en="Create scheme" data-g-bn="স্কিম তৈরি">Create scheme</button>
                        </form>
                    </div>
                </section>
                <section class="card border-0 shadow-sm mb-3" aria-labelledby="grantFinanceConfigHeading">
                    <div class="card-body">
                        <h2 id="grantFinanceConfigHeading" class="h5" data-g-en="Research Finance GL account mapping" data-g-bn="গবেষণা অনুদান ফাইন্যান্স লেজার ম্যাপিং">Research Finance GL account mapping</h2>
                        <p class="small text-muted" data-g-en="Choose the scheme above. Assign each posting account to one cash flow and a normal debit/credit direction. No duplicate ledger is created." data-g-bn="উপরের স্কিম নির্বাচন করুন। প্রতিটি হিসাবকে একটি প্রবাহ ও ডেবিট/ক্রেডিট দিক নির্ধারণ করুন। কোনো দ্বিতীয় লেজার তৈরি হয় না।">Choose the scheme above. Assign each posting account to one cash flow and a normal debit/credit direction. No duplicate ledger is created.</p>
                        <form id="grantFinanceAccountForm">
                            <label for="grantFinanceAccountId" class="form-label" data-g-en="Finance account ID" data-g-bn="ফাইন্যান্স অ্যাকাউন্ট আইডি">Finance account ID</label>
                            <input id="grantFinanceAccountId" class="form-control mb-2" type="number" min="1" step="1" required />
                            <label for="grantFinanceFlow" class="form-label" data-g-en="Cash flow" data-g-bn="অর্থপ্রবাহ">Cash flow</label>
                            <select id="grantFinanceFlow" class="form-select mb-2"><option value="Disbursement">Disbursement</option><option value="Expense">Expense</option><option value="Refund">Refund</option></select>
                            <label for="grantFinanceSide" class="form-label" data-g-en="Normal account side" data-g-bn="স্বাভাবিক হিসাবের দিক">Normal account side</label>
                            <select id="grantFinanceSide" class="form-select mb-2"><option value="Debit">Debit</option><option value="Credit">Credit</option></select>
                            <button class="btn btn-sm btn-outline-primary" type="submit" data-g-en="Save classification" data-g-bn="শ্রেণিবিভাগ সংরক্ষণ">Save classification</button>
                        </form>
                        <div id="grantFinanceAccounts" class="small mt-2"></div>
                    </div>
                </section>
            }
            <section class="card border-0 shadow-sm" aria-labelledby="grantCreateHeading">
                <div class="card-body">
                    <h2 class="h5" id="grantCreateHeading" data-g-en="New grant application" data-g-bn="নতুন অনুদান আবেদন">New grant application</h2>
                    <p class="small text-muted" data-g-en="A proposal must already have independent ethics approval. Find its reference on the Research & Ethics page." data-g-bn="প্রস্তাবে আগে স্বতন্ত্র নৈতিক অনুমোদন থাকতে হবে। Research & Ethics পৃষ্ঠা থেকে রেফারেন্স নিন।">A proposal must already have independent ethics approval. Find its reference on the Research & Ethics page.</p>
                    <form id="grantCreateForm">
                        <label for="grantProposal" class="form-label" data-g-en="Ethics-approved proposal reference" data-g-bn="নৈতিকভাবে অনুমোদিত প্রস্তাব রেফারেন্স">Ethics-approved proposal reference</label>
                        <input id="grantProposal" class="form-control mb-2" required maxlength="36" />
                        <label for="grantScheme" class="form-label" data-g-en="Grant scheme" data-g-bn="অনুদান স্কিম">Grant scheme</label>
                        <select id="grantScheme" class="form-select mb-2" required></select>
                        <label for="grantTitle" class="form-label" data-g-en="Project title" data-g-bn="প্রকল্পের শিরোনাম">Project title</label>
                        <input id="grantTitle" class="form-control mb-2" minlength="5" maxlength="200" required />
                        <label for="grantRequested" class="form-label" data-g-en="Requested budget" data-g-bn="আবেদনকৃত বাজেট">Requested budget</label>
                        <input id="grantRequested" type="number" min="0.01" step="0.01" class="form-control mb-2" required />
                        <button id="grantCreateButton" class="btn btn-primary" type="submit" data-g-en="Save application" data-g-bn="আবেদন সংরক্ষণ">Save application</button>
                    </form>
                </div>
            </section>
        </div>
        <div class="col-xl-8">
            <section class="card border-0 shadow-sm" aria-labelledby="grantQueueHeading">
                <div class="card-body">
                    <div class="d-flex justify-content-between gap-2 align-items-center mb-2">
                        <h2 id="grantQueueHeading" class="h5 mb-0" data-g-en="Grant applications & projects" data-g-bn="অনুদান আবেদন ও প্রকল্প">Grant applications & projects</h2>
                        <button id="grantRefresh" type="button" class="btn btn-sm btn-outline-secondary" data-g-en="Refresh" data-g-bn="রিফ্রেশ">Refresh</button>
                    </div>
                    <div class="table-responsive"><table class="table table-sm table-striped align-middle">
                        <thead><tr><th data-g-en="Project" data-g-bn="প্রকল্প">Project</th><th data-g-en="Status" data-g-bn="অবস্থা">Status</th><th data-g-en="Budget" data-g-bn="বাজেট">Budget</th><th data-g-en="Action" data-g-bn="কার্যক্রম">Action</th></tr></thead>
                        <tbody id="grantRows"></tbody>
                    </table></div>
                    <div class="d-flex justify-content-between gap-2 align-items-center">
                        <button id="grantPrevious" class="btn btn-sm btn-outline-secondary" type="button" data-g-en="Previous" data-g-bn="আগের">Previous</button>
                        <span id="grantPage" aria-live="polite"></span>
                        <button id="grantNext" class="btn btn-sm btn-outline-secondary" type="button" data-g-en="Next" data-g-bn="পরের">Next</button>
                    </div>
                </div>
            </section>
            <section id="grantDetail" class="card border-0 shadow-sm mt-3 d-none" aria-labelledby="grantDetailHeading">
                <div class="card-body">
                    <h2 id="grantDetailHeading" class="h5" data-g-en="Selected grant" data-g-bn="নির্বাচিত অনুদান">Selected grant</h2>
                    <div id="grantSummary" class="mb-3"></div>
                    @if (coordinator)
                    {
                        <section id="grantFinanceBox" class="border rounded p-3 mb-3">
                            <h3 class="h6" data-g-en="Posted Finance ledger reconciliation" data-g-bn="পোস্টকৃত ফাইন্যান্স লেজার মিল">Posted Finance ledger reconciliation</h3>
                            <p class="small text-muted" data-g-en="Only posted manual GL journals can be associated. Reversals are included automatically; awards never create cash postings." data-g-bn="শুধু পোস্টকৃত ম্যানুয়াল GL জার্নাল সংযুক্ত করা যায়। রিভার্সাল স্বয়ংক্রিয়ভাবে গণনায় আসে; অনুদান অনুমোদনে নগদ পোস্টিং হয় না।">Only posted manual GL journals can be associated. Reversals are included automatically; awards never create cash postings.</p>
                            <form id="grantFinanceJournalForm" class="d-flex gap-2 align-items-end flex-wrap mb-2">
                                <div><label for="grantFinanceJournalId" class="form-label" data-g-en="Posted journal ID" data-g-bn="পোস্টকৃত জার্নাল আইডি">Posted journal ID</label>
                                    <input id="grantFinanceJournalId" type="number" min="1" step="1" class="form-control" required /></div>
                                <button class="btn btn-sm btn-outline-primary" type="submit" data-g-en="Link verified journal" data-g-bn="যাচাইকৃত জার্নাল সংযুক্ত করুন">Link verified journal</button>
                            </form>
                            <div id="grantFinanceReport" class="small" aria-live="polite"></div>
                        </section>
                    }
                    <form id="grantActionForm">
                        <label for="grantAction" class="form-label" data-g-en="Available action" data-g-bn="অনুমোদিত কার্যক্রম">Available action</label>
                        <select id="grantAction" class="form-select mb-2" required></select>
                        <div id="grantAmountBox" class="d-none">
                            <label for="grantAmount" class="form-label" data-g-en="Amount" data-g-bn="অর্থের পরিমাণ">Amount</label>
                            <input id="grantAmount" type="number" class="form-control mb-2" step="0.01" min="0.01" />
                        </div>
                        <div id="grantMilestoneBox" class="d-none">
                            <label for="grantMilestoneTitle" class="form-label" data-g-en="Milestone title" data-g-bn="মাইলস্টোন শিরোনাম">Milestone title</label>
                            <input id="grantMilestoneTitle" class="form-control mb-2" maxlength="200" />
                            <label for="grantDueDate" class="form-label" data-g-en="Due date" data-g-bn="শেষ তারিখ">Due date</label>
                            <input id="grantDueDate" type="date" class="form-control mb-2" />
                        </div>
                        <div id="grantOutcomeBox" class="d-none">
                            <label for="grantMilestoneId" class="form-label" data-g-en="Milestone" data-g-bn="মাইলস্টোন">Milestone</label>
                            <select id="grantMilestoneId" class="form-select mb-2"></select>
                            <label for="grantOutcome" class="form-label" data-g-en="Outcome / evidence summary" data-g-bn="ফলাফল / প্রমাণের সারসংক্ষেপ">Outcome / evidence summary</label>
                            <textarea id="grantOutcome" class="form-control mb-2" maxlength="2000" rows="3"></textarea>
                        </div>
                        <label for="grantReason" class="form-label" data-g-en="Reason / decision note" data-g-bn="কারণ / সিদ্ধান্ত মন্তব্য">Reason / decision note</label>
                        <textarea id="grantReason" class="form-control mb-2" maxlength="500" rows="2"></textarea>
                        <button id="grantConfirm" type="submit" class="btn btn-primary" data-g-en="Confirm action" data-g-bn="কার্যক্রম নিশ্চিত করুন">Confirm action</button>
                    </form>
                    <h3 class="h6 mt-4" data-g-en="Milestones" data-g-bn="মাইলস্টোন">Milestones</h3>
                    <div id="grantMilestones" class="small mb-3"></div>
                    <section class="border-top pt-3 mt-3" aria-labelledby="grantOutputsHeading">
                        <h3 id="grantOutputsHeading" class="h6" data-g-en="Verified research outcomes" data-g-bn="যাচাইকৃত গবেষণা ফলাফল">Verified research outcomes</h3>
                        <p class="small text-muted" data-g-en="Submit an immutable output with an HTTPS reference or completed milestone. Independent review is required." data-g-bn="HTTPS রেফারেন্স বা সম্পন্ন মাইলস্টোনসহ অপরিবর্তনীয় ফলাফল জমা দিন। স্বতন্ত্র পর্যালোচনা আবশ্যক।">Submit an immutable output with an HTTPS reference or completed milestone. Independent review is required.</p>
                        <form id="grantOutputForm" class="d-none mb-3">
                            <div class="row g-2">
                                <div class="col-md-6"><label class="form-label" for="grantOutputType" data-g-en="Output category" data-g-bn="ফলাফলের ধরন">Output category</label>
                                    <select id="grantOutputType" class="form-select" required>
                                        <option value="Publication">Publication</option><option value="Dataset">Dataset</option>
                                        <option value="Patent">Patent</option><option value="Prototype">Prototype</option>
                                        <option value="CommunityImpact">Community impact</option><option value="Other">Other</option>
                                    </select></div>
                                <div class="col-md-6"><label class="form-label" for="grantOutputDate" data-g-en="Achievement date" data-g-bn="অর্জনের তারিখ">Achievement date</label>
                                    <input id="grantOutputDate" class="form-control" type="date" required /></div>
                            </div>
                            <label class="form-label mt-2" for="grantOutputTitle" data-g-en="Outcome title" data-g-bn="ফলাফলের শিরোনাম">Outcome title</label>
                            <input id="grantOutputTitle" class="form-control" minlength="5" maxlength="200" required />
                            <label class="form-label mt-2" for="grantOutputSummary" data-g-en="Verified evidence summary" data-g-bn="প্রমাণের সারসংক্ষেপ">Verified evidence summary</label>
                            <textarea id="grantOutputSummary" class="form-control" minlength="20" maxlength="2000" rows="3" required></textarea>
                            <div class="row g-2 mt-1">
                                <div class="col-md-6"><label class="form-label" for="grantOutputMilestone" data-g-en="Completed milestone (optional with URL)" data-g-bn="সম্পন্ন মাইলস্টোন (URL থাকলে ঐচ্ছিক)">Completed milestone (optional with URL)</label>
                                    <select id="grantOutputMilestone" class="form-select"></select></div>
                                <div class="col-md-6"><label class="form-label" for="grantOutputUrl" data-g-en="HTTPS evidence URL (optional with milestone)" data-g-bn="HTTPS প্রমাণ URL (মাইলস্টোন থাকলে ঐচ্ছিক)">HTTPS evidence URL (optional with milestone)</label>
                                    <input id="grantOutputUrl" class="form-control" maxlength="500" type="url" placeholder="https://" /></div>
                            </div>
                            <button id="grantOutputSubmit" type="submit" class="btn btn-sm btn-outline-primary mt-2" data-g-en="Submit outcome for review" data-g-bn="যাচাইয়ের জন্য ফলাফল জমা দিন">Submit outcome for review</button>
                        </form>
                        <div id="grantOutputRows" class="small mb-2"></div>
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <button id="grantOutputsPrev" type="button" class="btn btn-sm btn-outline-secondary" data-g-en="Previous outcomes" data-g-bn="আগের ফলাফল">Previous outcomes</button>
                            <span id="grantOutputsPage" class="small" aria-live="polite"></span>
                            <button id="grantOutputsNext" type="button" class="btn btn-sm btn-outline-secondary" data-g-en="Next outcomes" data-g-bn="পরের ফলাফল">Next outcomes</button>
                        </div>
                        <form id="grantOutputReviewForm" class="d-none border rounded p-3 mb-3">
                            <p id="grantOutputReviewTitle" class="fw-semibold mb-2"></p>
                            <label class="form-label" for="grantOutputDecision" data-g-en="Independent decision" data-g-bn="স্বতন্ত্র সিদ্ধান্ত">Independent decision</label>
                            <select id="grantOutputDecision" class="form-select mb-2" required>
                                <option value="verify">Verify</option><option value="reject">Reject</option>
                            </select>
                            <label class="form-label" for="grantOutputReason" data-g-en="Review reason (minimum 10 characters)" data-g-bn="সিদ্ধান্তের কারণ (কমপক্ষে ১০ অক্ষর)">Review reason (minimum 10 characters)</label>
                            <textarea id="grantOutputReason" class="form-control mb-2" minlength="10" maxlength="500" required></textarea>
                            <label class="d-block mb-2"><input id="grantOutputNoConflict" type="checkbox" required /> <span data-g-en="I declare no conflict of interest" data-g-bn="আমার স্বার্থের সংঘাত নেই বলে ঘোষণা করছি">I declare no conflict of interest</span></label>
                            <button id="grantOutputReviewConfirm" type="submit" class="btn btn-sm btn-primary" data-g-en="Save review decision" data-g-bn="পর্যালোচনার সিদ্ধান্ত সংরক্ষণ">Save review decision</button>
                        </form>
                        @if (coordinator)
                        {
                            <div class="border-top pt-3" aria-label="Outcome report">
                                <h4 class="h6" data-g-en="Campus outcome report" data-g-bn="ক্যাম্পাস ফলাফল রিপোর্ট">Campus outcome report</h4>
                                <div class="d-flex gap-2 flex-wrap align-items-end">
                                    <div><label class="form-label" for="grantOutputReportFrom" data-g-en="From" data-g-bn="শুরু">From</label><input id="grantOutputReportFrom" type="date" class="form-control" /></div>
                                    <div><label class="form-label" for="grantOutputReportTo" data-g-en="To" data-g-bn="শেষ">To</label><input id="grantOutputReportTo" type="date" class="form-control" /></div>
                                    <button id="grantOutcomeReportRun" type="button" class="btn btn-sm btn-outline-secondary" data-g-en="Load report" data-g-bn="রিপোর্ট দেখুন">Load report</button>
                                </div>
                                <div id="grantOutcomeReportRows" class="small mt-2"></div>
                            </div>
                        }
                    </section>
                    <h3 class="h6" data-g-en="Command history" data-g-bn="কার্যক্রমের ইতিহাস">Command history</h3>
                    <div id="grantHistory" class="small"></div>
                </div>
            </section>
        </div>
    </div>
</div>
@section Scripts { <script src="~/js/research/research-grants.js" asp-append-version="true"></script> }
