@{
    var bn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
    ViewData["Title"] = bn ? "ফিচার পরিচালনা" : "Feature Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section id="platformFeatureAdministration" class="container-fluid px-0" data-bangla="@(bn ? "true" : "false")">
    @Html.AntiForgeryToken()
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <p class="small text-muted mb-0">@(bn ? "নতুন প্ল্যানে ফিচারের নাম ও উপলব্ধতা নির্ধারণ করুন। বিদ্যমান প্ল্যান, ফিচার কোড ও মডিউল ম্যাপিং অপরিবর্তিত থাকবে।" : "Edit feature labels and future plan availability. Existing plan assignments, codes and module mappings stay intact.")</p>
        <button id="featureRetry" type="button" class="btn btn-sm btn-outline-secondary" hidden>@(bn ? "আবার চেষ্টা করুন" : "Try again")</button>
    </div>
    <p id="featureMessage" class="small mb-2" role="status" aria-live="polite"></p>
    <div class="table-responsive border rounded-3">
        <table class="table table-hover table-sm align-middle mb-0">
            <caption class="visually-hidden">@(bn ? "ফিচার ও নতুন প্ল্যানের উপলব্ধতা" : "Feature catalog and new-plan availability")</caption>
            <thead class="table-light"><tr>
                <th scope="col">@(bn ? "কোড" : "Code")</th>
                <th scope="col">@(bn ? "নাম" : "Name")</th>
                <th scope="col">@(bn ? "বিবরণ" : "Description")</th>
                <th scope="col">@(bn ? "উপলব্ধতা" : "Availability")</th>
                <th scope="col">@(bn ? "কাজ" : "Actions")</th>
            </tr></thead>
            <tbody id="featureRows"><tr><td colspan="5">@(bn ? "ফিচার তালিকা আনা হচ্ছে…" : "Loading features…")</td></tr></tbody>
        </table>
    </div>
    <section id="featureEditor" class="card border rounded-3 p-3 mt-3" aria-labelledby="featureEditorTitle" hidden>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 id="featureEditorTitle" class="h6 mb-0">@(bn ? "ফিচার সম্পাদনা" : "Edit feature")</h2>
            <span id="featureEditCode" class="badge text-bg-secondary" aria-label="@(bn ? "অপরিবর্তনীয় সিস্টেম কোড" : "Immutable system code")"></span>
        </div>
        <form id="featureForm">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label" for="featureEditName">@(bn ? "ফিচারের নাম" : "Feature name")</label>
                    <input id="featureEditName" class="form-control" maxlength="150" required />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label" for="featureEditDescription">@(bn ? "বিবরণ" : "Description")</label>
                    <textarea id="featureEditDescription" class="form-control" maxlength="500" rows="2"></textarea>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input id="featureEditActive" type="checkbox" role="switch" class="form-check-input" />
                        <label class="form-check-label" for="featureEditActive">@(bn ? "নতুন প্ল্যানের জন্য উপলব্ধ" : "Available for new plan configuration")</label>
                    </div>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button id="featureSave" class="btn btn-primary" type="submit">@(bn ? "সংরক্ষণ করুন" : "Save changes")</button>
                <button id="featureCancel" class="btn btn-outline-secondary" type="button">@(bn ? "বাতিল" : "Cancel")</button>
            </div>
        </form>
    </section>
</section>
@section Scripts {
    <script src="~/js/platform/feature-catalog-administration.js" asp-append-version="true"></script>
}
