@{
    ViewData["Title"] = "Employee Campus Assignments";
}
<section id="hrCampusWorkspace" class="container-fluid py-3">
    <header class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="h4">Employee Campus Assignments</h2>
            <p class="text-muted mb-0">Assign primary or secondary campuses with effective dates and review the original campus assignment records. Tenant administrator access only.</p>
        </div>
        <a class="btn btn-outline-secondary" href="/HR/Index">Employee Administration</a>
    </header>
    <div id="hrCampusAlert" class="d-none" role="alert" tabindex="-1"></div>
    <section class="card mb-3"><div class="card-body">
        <h3 class="h6">Find employee</h3>
        <div class="row g-2 align-items-end">
            <div class="col-md-5"><label class="form-label" for="hrCampusSearch">Employee name or code</label><input id="hrCampusSearch" class="form-control" maxlength="100" placeholder="At least 2 characters" /></div>
            <div class="col-md-2"><button id="hrCampusFind" class="btn btn-outline-primary w-100" type="button">Search</button></div>
            <div class="col-md-5"><label class="form-label" for="hrCampusEmployee">Employee</label><select id="hrCampusEmployee" class="form-select"><option value="">Search first</option></select></div>
        </div>
    </div></section>
    <section class="card mb-3"><div class="card-body">
        <h3 class="h6">Assign campus</h3>
        <form id="hrCampusForm" class="row g-2 align-items-end">
            <div class="col-md-3"><label class="form-label" for="hrCampusId">Active campus</label><select id="hrCampusId" class="form-select" required><option value="">Loading campuses…</option></select></div>
            <div class="col-md-2"><label class="form-label" for="hrCampusFrom">Effective from</label><input id="hrCampusFrom" type="date" class="form-control" required /></div>
            <div class="col-md-2"><label class="form-label" for="hrCampusTo">Effective to (optional)</label><input id="hrCampusTo" type="date" class="form-control" /></div>
            <div class="col-md-3"><div class="form-check mt-4"><input id="hrCampusPrimary" type="checkbox" class="form-check-input" /><label class="form-check-label" for="hrCampusPrimary">Primary campus</label></div></div>
            <div class="col-md-2"><button id="hrCampusSave" class="btn btn-primary w-100" type="submit">Assign</button></div>
        </form>
        <p class="text-muted small mt-2 mb-0">Changing a primary campus closes the previous primary assignment. Historical rows are retained. A successful assignment does not retroactively change payroll or attendance.</p>
    </div></section>
    <section class="card"><div class="card-body">
        <h3 class="h6">Campus assignment history</h3>
        <div class="table-responsive"><table class="table table-sm table-hover">
            <thead><tr><th>Campus</th><th>Primary</th><th>From</th><th>To</th><th>Status</th></tr></thead>
            <tbody id="hrCampusRows"><tr><td colspan="5">Select an employee.</td></tr></tbody>
        </table></div>
        <div class="d-flex align-items-center justify-content-between gap-2">
            <button id="hrCampusPrev" class="btn btn-outline-secondary btn-sm" type="button" disabled>Previous</button>
            <span id="hrCampusPage" class="small text-muted" aria-live="polite"></span>
            <button id="hrCampusNext" class="btn btn-outline-secondary btn-sm" type="button" disabled>Next</button>
        </div>
    </div></section>
</section>
@section Scripts {
    <script src="~/js/hr/campus-assignments.js" asp-append-version="true"></script>
}
