@{
    var bangla = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
    var feature = ViewData["HrFeature"] as string == "leaves" ? "leaves" : "directory";
    ViewData["Title"] = feature == "leaves" ? (bangla ? "কর্মীর ছুটির আবেদন" : "Employee Leave Review") : (bangla ? "কর্মী তালিকা" : "Employee Directory");
}
<section id="hrWorkspaceRoot" class="container-fluid py-3" data-active-feature="@feature" aria-labelledby="hrTitle">
    @Html.AntiForgeryToken()
    <header class="mb-3">
        <h2 id="hrTitle">@ViewData["Title"]</h2>
        <p class="text-muted">@(feature == "leaves" ? (bangla ? "কর্মীর ছুটির আবেদন যাচাই ও সিদ্ধান্ত দিন। সব সিদ্ধান্ত প্রতিষ্ঠানের অনুমতি অনুযায়ী যাচাই হয়।" : "Review and decide employee leave requests. Every decision is checked against your institution and role.") : (bangla ? "কর্মীর নাম, কোড, পদবি ও অবস্থা অনুসন্ধান করুন।" : "Search employees by name, code, designation and status."))</p>
    </header>
    <div id="hrAlert" class="d-none" role="alert" tabindex="-1"></div>
    <section class="card mb-4 @(feature == "leaves" ? "d-none" : "")">
        <div class="card-body">
            <h3 class="h5">Employees</h3>
            <form id="hrEmployeeSearch" class="row g-2 align-items-end">
                <div class="col-md-5"><label class="form-label" for="hrEmployeeText">Employee name or code</label><input id="hrEmployeeText" class="form-control" type="search" maxlength="100" /></div>
                <div class="col-md-3"><label class="form-label" for="hrEmployeeTeacher">Type</label><select id="hrEmployeeTeacher" class="form-select"><option value="">All</option><option value="true">Teachers</option><option value="false">Other staff</option></select></div>
                <div class="col-md-2"><label class="form-label" for="hrEmployeeActive">State</label><select id="hrEmployeeActive" class="form-select"><option value="">All</option><option value="1">Active</option><option value="2">Suspended</option><option value="3">Resigned</option><option value="4">Terminated</option><option value="5">Retired</option></select></div>
                <div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Search</button></div>
            </form>
            <div class="table-responsive mt-3">
                <table class="table table-hover align-middle"><thead><tr><th>Code</th><th>Employee</th><th>Designation</th><th>Department</th><th>Joined</th><th>Status</th></tr></thead><tbody id="hrEmployeeRows"><tr><td colspan="6">Loading…</td></tr></tbody></table>
            </div>
            <div class="d-flex justify-content-between align-items-center gap-2">
                <button id="hrEmployeePrev" class="btn btn-outline-secondary btn-sm" type="button">Previous</button>
                <span id="hrEmployeePage" class="small text-muted" aria-live="polite"></span>
                <button id="hrEmployeeNext" class="btn btn-outline-secondary btn-sm" type="button">Next</button>
            </div>
        </div>
    </section>
    <section class="card @(feature == "directory" ? "d-none" : "")">
        <div class="card-body">
            <h3 class="h5">Employee leave review</h3>
            <form id="hrLeaveSearch" class="row g-2 align-items-end">
                <div class="col-md-4"><label class="form-label" for="hrLeaveText">Employee name or code</label><input id="hrLeaveText" class="form-control" type="search" maxlength="100" /></div>
                <div class="col-md-3"><label class="form-label" for="hrLeaveStatus">Status</label><select id="hrLeaveStatus" class="form-select"><option value="">All</option><option value="2" selected>Submitted</option><option value="3">Approved</option><option value="4">Rejected</option><option value="1">Draft</option><option value="5">Cancelled</option></select></div>
                <div class="col-md-3"><label class="form-label" for="hrLeaveFrom">Starting from</label><input id="hrLeaveFrom" class="form-control" type="date" /></div>
                <div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Filter</button></div>
            </form>
            <div class="table-responsive mt-3">
                <table class="table table-hover align-middle"><thead><tr><th>Employee</th><th>Leave</th><th>Dates</th><th>Days</th><th>Status</th><th>Remarks / Action</th></tr></thead><tbody id="hrLeaveRows"><tr><td colspan="6">Loading…</td></tr></tbody></table>
            </div>
            <div class="d-flex justify-content-between align-items-center gap-2">
                <button id="hrLeavePrev" class="btn btn-outline-secondary btn-sm" type="button">Previous</button>
                <span id="hrLeavePage" class="small text-muted" aria-live="polite"></span>
                <button id="hrLeaveNext" class="btn btn-outline-secondary btn-sm" type="button">Next</button>
            </div>
        </div>
    </section>
</section>
@section Scripts {
    <script src="~/js/hr/index.js" asp-append-version="true"></script>
}
