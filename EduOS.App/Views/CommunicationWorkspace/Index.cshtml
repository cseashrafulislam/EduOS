@{ ViewData["Title"] = "Notices & Notifications"; var canManage = User.IsInRole("TenantAdmin"); }
<div id="communicationWorkspace" class="container-fluid py-3" data-can-manage="@(canManage ? "true" : "false")">
    <header class="mb-3"><h2>Notices &amp; Notifications</h2><p class="text-muted">Tenant notices and your private notification inbox.</p></header>
    <div id="cwAlert" class="alert d-none" role="alert" aria-live="polite"></div>
    @if (canManage)
    {
        <section class="card mb-3"><div class="card-body">
            <h4>Create or edit notice</h4>
            <form id="cwNoticeForm">
                <input id="cwReference" type="hidden" /><input id="cwVersion" type="hidden" />
                <div class="row g-2">
                    <div class="col-md-8"><label class="form-label" for="cwTitle">Title</label><input id="cwTitle" class="form-control" maxlength="250" required /></div>
                    <div class="col-md-4"><label class="form-label" for="cwCategory">Category</label><select id="cwCategory" class="form-select"><option value="">No category</option></select></div>
                    <div class="col-12"><label class="form-label" for="cwBody">Notice</label><textarea id="cwBody" class="form-control" rows="5" maxlength="20000" required></textarea></div>
                    <div class="col-md-4"><label class="form-label" for="cwPublishAt">Publish at (your local time)</label><input id="cwPublishAt" class="form-control" type="datetime-local" required /></div>
                    <div class="col-md-4"><label class="form-label" for="cwExpiresAt">Expires at (optional)</label><input id="cwExpiresAt" class="form-control" type="datetime-local" /></div>
                    <div class="col-md-4"><label class="form-label" for="cwPublished">Status</label><select id="cwPublished" class="form-select"><option value="false">Draft</option><option value="true">Published</option></select></div>
                    <div class="col-md-4"><label class="form-label" for="cwAudienceType">Audience</label><select id="cwAudienceType" class="form-select"><option value="All">Everyone in this tenant</option><option value="User">One user</option><option value="Campus">Campus</option><option value="Program">Academic program</option><option value="Batch">Academic batch</option></select></div>
                    <div class="col-md-4"><label class="form-label" for="cwAudienceId">Audience ID (targeted only)</label><input id="cwAudienceId" type="number" min="1" step="1" class="form-control" disabled /></div>
                    <div class="col-md-4 d-flex align-items-end"><button id="cwAddAudience" type="button" class="btn btn-outline-primary">Add audience</button></div>
                </div>
                <div id="cwAudiences" class="d-flex flex-wrap gap-2 mt-2" aria-label="Selected audiences"></div>
                <div class="mt-3 d-flex gap-2"><button id="cwSave" class="btn btn-primary" type="submit">Save notice</button><button id="cwReset" class="btn btn-outline-secondary" type="button">New notice</button></div>
            </form>
        </div></section>
    }
    <section class="card mb-3"><div class="card-body">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2"><h4 class="mb-0">Notices</h4>
            @if (canManage) { <label class="form-label mb-0" for="cwNoticeFilter">Filter <select id="cwNoticeFilter" class="form-select form-select-sm"><option value="">All</option><option value="true">Published</option><option value="false">Draft</option></select></label> }
        </div>
        <div class="table-responsive mt-2"><table class="table table-striped table-sm"><thead><tr><th>Title</th><th>Category</th><th>Publish</th><th>Expires</th><th>Status</th><th>Action</th></tr></thead><tbody id="cwNoticeRows"></tbody></table></div>
        <div class="d-flex gap-2 align-items-center"><button id="cwNoticePrev" class="btn btn-outline-secondary btn-sm" type="button">Previous</button><span id="cwNoticePage"></span><button id="cwNoticeNext" class="btn btn-outline-secondary btn-sm" type="button">Next</button></div>
    </div></section>
    <section class="card"><div class="card-body"><h4>Your notifications</h4>
        <div class="table-responsive"><table class="table table-striped table-sm"><thead><tr><th>Received</th><th>Title</th><th>Message</th><th>Status</th><th>Action</th></tr></thead><tbody id="cwNotificationRows"></tbody></table></div>
        <div class="d-flex gap-2 align-items-center"><button id="cwNotificationPrev" class="btn btn-outline-secondary btn-sm" type="button">Previous</button><span id="cwNotificationPage"></span><button id="cwNotificationNext" class="btn btn-outline-secondary btn-sm" type="button">Next</button></div>
    </div></section>
    <section class="card mt-3" id="cwMessaging"><div class="card-body">
        <h4>Messages</h4><p class="text-muted">Private conversations with active tenant members.</p>
        <div class="row g-3"><div class="col-lg-4">
            <label for="cwRecipientQuery" class="form-label">Find recipient by name</label>
            <div class="input-group mb-2"><input id="cwRecipientQuery" class="form-control" maxlength="80" placeholder="2+ characters" />
                <button id="cwFindRecipients" class="btn btn-outline-secondary" type="button">Find</button></div>
            <div id="cwRecipientResults" class="list-group mb-3"></div>
            <div class="d-flex justify-content-between"><h5>Conversations</h5><button id="cwNewConversation" type="button" class="btn btn-outline-primary btn-sm">New</button></div>
            <div id="cwThreadRows" class="list-group mb-2"></div>
            <div class="d-flex gap-2 align-items-center"><button id="cwThreadPrev" class="btn btn-outline-secondary btn-sm" type="button">Previous</button>
                <span id="cwThreadPage"></span><button id="cwThreadNext" class="btn btn-outline-secondary btn-sm" type="button">Next</button></div>
        </div><div class="col-lg-8">
            <h5 id="cwConversationTitle">Select a conversation</h5>
            <div id="cwConversationMessages" class="border rounded p-3 mb-2" style="min-height:180px;max-height:420px;overflow-y:auto"></div>
            <button id="cwOlderMessages" type="button" class="btn btn-link btn-sm d-none">Older messages</button>
            <form id="cwMessageForm"><label for="cwMessageSubject" class="form-label">Subject (new conversation)</label>
                <input id="cwMessageSubject" class="form-control mb-2" maxlength="250" />
                <label for="cwMessageBody" class="form-label">Message</label>
                <textarea id="cwMessageBody" class="form-control mb-2" maxlength="4000" rows="3" required></textarea>
                <button id="cwSendMessage" type="submit" class="btn btn-primary" disabled>Send</button></form>
        </div></div>
    </div></section>


    <section class="card mt-3" id="cwPreferences"><div class="card-body">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div><h4>Notification preferences</h4><p class="text-muted mb-2">Configure delivery per channel and event code. Only events emitted by the system can be affected.</p></div>
            <button id="cwPrefRefresh" type="button" class="btn btn-outline-secondary btn-sm">Refresh</button>
        </div>
        <form id="cwPrefForm" class="row g-2 align-items-end">
            <div class="col-md-3"><label for="cwPrefChannel" class="form-label">Channel</label><select id="cwPrefChannel" class="form-select" required>
                <option value="1">In-app</option><option value="2">Email</option><option value="3">SMS</option><option value="4">Push</option>
            </select></div>
            <div class="col-md-5"><label for="cwPrefEvent" class="form-label">Event code</label><input id="cwPrefEvent" class="form-control" maxlength="100" minlength="2" pattern="[A-Za-z][A-Za-z0-9_.-]+" placeholder="e.g. EXAM.RESULT" required /></div>
            <div class="col-md-2"><label class="form-label d-block" for="cwPrefEnabled">Delivery</label><label class="form-check-label"><input id="cwPrefEnabled" type="checkbox" class="form-check-input me-1" checked /> Enabled</label></div>
            <div class="col-md-2 d-flex gap-2"><button id="cwPrefSave" type="submit" class="btn btn-primary">Save</button><button id="cwPrefCancel" type="button" class="btn btn-outline-secondary">Clear</button></div>
        </form>
        <p id="cwPrefEditing" class="small text-muted mt-2" aria-live="polite">Create a preference or edit an existing row.</p>
        <div class="table-responsive mt-2"><table class="table table-striped table-sm"><thead><tr><th>Channel</th><th>Event code</th><th>Delivery</th><th>Actions</th></tr></thead><tbody id="cwPrefRows"></tbody></table></div>
    </div></section>

</div>
@section Scripts { <script type="module" src="~/js/communication/workspace.js" asp-append-version="true"></script> }
