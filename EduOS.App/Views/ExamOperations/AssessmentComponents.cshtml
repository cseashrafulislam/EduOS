@{
    ViewData["Title"] = "Assessment Component Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="container-fluid py-4" id="assessmentComponentWorkspace">
    @Html.AntiForgeryToken()
    <header class="d-flex justify-content-between flex-wrap gap-2 mb-3">
        <div><h1 class="h4 mb-1">Assessment components</h1>
            <p class="text-muted mb-0">Configure component marks and weightage for draft assessments. Existing marks and published results remain protected.</p></div>
        <a asp-controller="ExamOperations" asp-action="Index" class="btn btn-outline-secondary">Marks &amp; results</a>
    </header>
    <div id="componentNotice" class="alert d-none" role="alert" aria-live="polite"></div>
    <div class="card mb-3"><div class="card-body">
        <form id="componentForm">
            <h2 class="h6" id="componentFormTitle">New assessment component</h2>
            <div class="row g-3">
                <div class="col-lg-6"><label for="componentSubject" class="form-label">Assessment / Batch / Subject</label>
                    <select id="componentSubject" class="form-select" required><option value="">Loading assessment subjects…</option></select></div>
                <div class="col-md-3"><label for="componentCode" class="form-label">Code</label>
                    <input id="componentCode" class="form-control" maxlength="50" required /></div>
                <div class="col-md-3"><label for="componentName" class="form-label">Component name</label>
                    <input id="componentName" class="form-control" maxlength="100" required /></div>
                <div class="col-md-2"><label for="componentFull" class="form-label">Full marks</label>
                    <input id="componentFull" type="number" class="form-control" min="0.01" max="100000" step="0.01" required /></div>
                <div class="col-md-2"><label for="componentPass" class="form-label">Pass marks</label>
                    <input id="componentPass" type="number" class="form-control" min="0" max="100000" step="0.01" required /></div>
                <div class="col-md-2"><label for="componentWeight" class="form-label">Weightage (%)</label>
                    <input id="componentWeight" type="number" class="form-control" min="0.01" max="100" step="0.01" required /></div>
                <div class="col-md-2"><label for="componentOrder" class="form-label">Display order</label>
                    <input id="componentOrder" type="number" class="form-control" min="0" max="10000" step="1" value="0" required /></div>
                <div class="col-md-4 d-flex align-items-end"><div class="form-check mb-2">
                    <input id="componentMandatory" type="checkbox" class="form-check-input" />
                    <label for="componentMandatory" class="form-check-label">Mandatory pass</label></div></div>
            </div>
            <div class="d-flex gap-2 mt-3">
                <button id="componentSave" class="btn btn-primary" type="submit">Save component</button>
                <button id="componentClear" class="btn btn-outline-secondary" type="button">Cancel edit</button>
            </div>
            <p class="small text-muted mt-2 mb-0">Combined weightage for a subject cannot exceed 100%. Editing is limited to draft assessments and components without recorded marks.</p>
        </form>
    </div></div>
    <div class="card"><div class="card-body">
        <h2 class="h6">Component register</h2>
        <div class="row g-2 align-items-end mb-3">
            <div class="col-md-5"><label for="componentSearchText" class="form-label">Search component / assessment / subject</label>
                <input id="componentSearchText" class="form-control" maxlength="100" /></div>
            <div class="col-auto"><button id="componentSearch" type="button" class="btn btn-outline-primary">Search</button></div>
            <div class="col-auto"><button id="componentCsv" type="button" class="btn btn-outline-secondary">CSV (current page)</button></div>
            <div class="col-auto"><button id="componentPrint" type="button" class="btn btn-outline-secondary">Print</button></div>
        </div>
        <div class="table-responsive"><table class="table table-sm table-hover align-middle">
            <thead><tr><th>Assessment</th><th>Batch</th><th>Subject</th><th>Code</th><th>Name</th><th>Full</th><th>Pass</th><th>Weight %</th><th>Mandatory</th><th>Order</th><th class="component-action">Action</th></tr></thead>
            <tbody id="componentRows"></tbody>
        </table></div>
        <div class="d-flex justify-content-between align-items-center">
            <span id="componentCount" class="text-muted small"></span>
            <div class="d-flex gap-2"><button id="componentPrev" type="button" class="btn btn-sm btn-outline-secondary">Previous</button>
                <button id="componentNext" type="button" class="btn btn-sm btn-outline-secondary">Next</button></div>
        </div>
    </div></div>
</section>
<style>
@@media print {
    #componentForm, #componentSearch, #componentCsv, #componentPrint,
    #componentSearchText, #componentPrev, #componentNext, #componentNotice,
    .component-action { display: none !important; }
}
</style>
@section Scripts { <script src="~/js/exams/assessment-components.js" asp-append-version="true"></script> }
