@{
    ViewData["Title"] = "Transcript Issue Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="container-fluid py-4" id="transcriptWorkspace">
    @Html.AntiForgeryToken()
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        <div><h1 class="h4 mb-1">Transcript issue register</h1>
            <p class="text-muted mb-0">Issue and revoke transcript records against published, released results. This register is not a signed transcript document.</p></div>
        <a class="btn btn-outline-secondary" asp-controller="ExamOperations" asp-action="Index">Exam marks &amp; results</a>
    </div>
    <div id="transcriptNotice" class="alert d-none" role="alert" aria-live="polite"></div>
    <div class="card mb-3"><div class="card-body">
        <h2 class="h6">Issue transcript</h2>
        <form id="transcriptIssueForm" class="row g-2 align-items-end">
            <div class="col-lg-4"><label class="form-label" for="transcriptStudentSearch">Find eligible student (name/code)</label>
                <input class="form-control" id="transcriptStudentSearch" maxlength="100" minlength="2" placeholder="Enter at least 2 characters" autocomplete="off" required /></div>
            <div class="col-lg-2"><button type="button" id="transcriptFindStudent" class="btn btn-outline-primary w-100">Find student</button></div>
            <div class="col-lg-3"><label class="form-label" for="transcriptStudent">Student with released results</label>
                <select id="transcriptStudent" class="form-select" required><option value="">Search first</option></select></div>
            <div class="col-lg-2"><label class="form-label" for="transcriptDate">Issue date</label><input id="transcriptDate" class="form-control" type="date" required /></div>
            <div class="col-lg-1"><button id="transcriptIssue" class="btn btn-primary w-100" type="submit">Issue</button></div>
        </form>
        <p class="small text-muted mt-2 mb-0">A stable request ID prevents duplicate records on network retries. No PDF is generated by this action.</p>
    </div></div>
    <div class="card"><div class="card-body">
        <div class="row g-2 align-items-end mb-3">
            <div class="col-lg-5"><label class="form-label" for="transcriptSearch">Search issued transcripts</label>
                <input id="transcriptSearch" class="form-control" maxlength="100" placeholder="Transcript number, student name or code" /></div>
            <div class="col-lg-7 d-flex flex-wrap gap-2">
                <button id="transcriptRefresh" class="btn btn-outline-primary" type="button">Search</button>
                <button id="transcriptCsv" class="btn btn-outline-secondary" type="button">CSV (current page)</button>
                <button id="transcriptPrint" class="btn btn-outline-secondary" type="button">Print register</button>
            </div>
        </div>
        <div class="table-responsive"><table class="table table-sm table-hover" id="transcriptTable">
            <thead><tr><th>Transcript number</th><th>Student code</th><th>Student</th><th>Issue date</th><th>Status</th><th class="transcript-action">Action</th></tr></thead>
            <tbody id="transcriptRows"><tr><td colspan="6">Loading…</td></tr></tbody>
        </table></div>
        <div class="d-flex justify-content-between align-items-center">
            <span class="text-muted small" id="transcriptCount"></span>
            <div class="d-flex gap-2"><button id="transcriptPrev" class="btn btn-sm btn-outline-secondary" type="button">Previous</button>
                <button id="transcriptNext" class="btn btn-sm btn-outline-secondary" type="button">Next</button></div>
        </div>
    </div></div>
</section>
<style>
@@media print {
    #transcriptIssueForm, #transcriptFindStudent, #transcriptRefresh, #transcriptCsv, #transcriptPrint,
    #transcriptPrev, #transcriptNext, .transcript-action, #transcriptSearch, #transcriptNotice { display: none !important; }
}
</style>
@section Scripts { <script src="~/js/exams/transcripts.js" asp-append-version="true"></script> }
