@{
    ViewData["Title"] = "Library Overdue Ageing";
}
<section id="libraryOverdueApp" class="container-fluid py-3">
    <header class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div class="d-flex align-items-center gap-2">
            <h2 class="h4 mb-0">Overdue Ageing</h2>
            <details class="position-relative">
                <summary class="btn btn-sm btn-outline-secondary" aria-label="Overdue report help" title="Overdue report help">ⓘ</summary>
                <div class="card card-body position-absolute shadow-sm end-0 mt-1" style="width:min(19rem,85vw);z-index:5">
                    Counts are based on the current UTC date. Select a campus to narrow the report. Exports contain only this authorized page and no borrower details.
                </div>
            </details>
        </div>
        <a asp-controller="Library" asp-action="Circulation" class="btn btn-outline-secondary btn-sm">Circulation</a>
    </header>
    <div id="libraryOverdueAlert" class="d-none" role="alert" aria-live="polite"></div>
    <form id="libraryOverdueFilters" class="card card-body row g-2 align-items-end mb-3">
        <div class="col-md-5">
            <label for="libraryOverdueSearch" class="form-label">Branch name or code</label>
            <input id="libraryOverdueSearch" class="form-control" maxlength="100" autocomplete="off" />
        </div>
        <div class="col-md-3">
            <label for="libraryOverdueCampus" class="form-label">Campus ID (optional)</label>
            <input id="libraryOverdueCampus" class="form-control" type="number" min="1" step="1" placeholder="All authorized campuses" />
        </div>
        <div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Apply</button></div>
        <div class="col-md-2"><button id="libraryOverdueCsv" class="btn btn-outline-secondary w-100" type="button">CSV (page)</button></div>
    </form>
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Overdue branches</strong><span id="libraryOverdueCount" class="text-muted small"></span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead><tr><th>Campus</th><th>Branch</th><th>Code</th><th>Total overdue</th><th>1–7 days</th><th>8–30 days</th><th>31+ days</th><th>Oldest due</th></tr></thead>
                <tbody id="libraryOverdueRows"><tr><td colspan="8">Loading…</td></tr></tbody>
            </table>
        </div>
        <div class="card-footer d-flex justify-content-end align-items-center gap-2">
            <button id="libraryOverduePrevious" class="btn btn-sm btn-outline-secondary" type="button">Previous</button>
            <span id="libraryOverduePage" class="small text-muted"></span>
            <button id="libraryOverdueNext" class="btn btn-sm btn-outline-secondary" type="button">Next</button>
        </div>
    </div>
</section>
@section Scripts { <script src="~/js/library/overdue.js" asp-append-version="true"></script> }
