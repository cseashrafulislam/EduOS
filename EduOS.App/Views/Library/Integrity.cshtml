@{
    ViewData["Title"] = "Library Copy Integrity";
}
<section id="libraryIntegrityApp" class="container-fluid py-3">
    <header class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div class="d-flex align-items-center gap-2">
            <h2 class="h4 mb-0">Copy Integrity</h2>
            <details class="position-relative">
                <summary class="btn btn-sm btn-outline-secondary" aria-label="Copy integrity help" title="Copy integrity help">ⓘ</summary>
                <div class="card card-body position-absolute shadow-sm end-0 mt-1" style="width:min(19rem,85vw);z-index:5">
                    Read-only reconciliation of physical copy state and outstanding loans. Resolve discrepancies through approved circulation workflows; no automatic historical edits.
                </div>
            </details>
        </div>
        <a asp-controller="Library" asp-action="Circulation" class="btn btn-outline-secondary btn-sm">Circulation</a>
    </header>
    <div id="libraryIntegrityAlert" class="d-none" role="alert" aria-live="polite"></div>
    <form id="libraryIntegrityFilters" class="card card-body row g-2 align-items-end mb-3">
        <div class="col-md-5">
            <label for="libraryIntegrityAccession" class="form-label">Accession</label>
            <input id="libraryIntegrityAccession" class="form-control" maxlength="100" autocomplete="off" />
        </div>
        <div class="col-md-3">
            <label for="libraryIntegrityCampus" class="form-label">Campus ID (optional)</label>
            <input id="libraryIntegrityCampus" class="form-control" type="number" min="1" step="1" placeholder="Authorized campuses" />
        </div>
        <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Apply</button></div>
        <div class="col-md-2"><button id="libraryIntegrityCsv" type="button" class="btn btn-outline-secondary w-100">CSV (page)</button></div>
    </form>
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Copy discrepancies</strong><span id="libraryIntegrityCount" class="text-muted small"></span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead><tr><th>Accession</th><th>Book</th><th>Campus</th><th>Branch</th><th>Copy state</th><th>Open loans</th><th>Discrepancies</th></tr></thead>
                <tbody id="libraryIntegrityRows"><tr><td colspan="7">Loading…</td></tr></tbody>
            </table>
        </div>
        <div class="card-footer d-flex justify-content-end align-items-center gap-2">
            <button id="libraryIntegrityPrevious" class="btn btn-sm btn-outline-secondary" type="button">Previous</button>
            <span id="libraryIntegrityPage" class="small text-muted"></span>
            <button id="libraryIntegrityNext" class="btn btn-sm btn-outline-secondary" type="button">Next</button>
        </div>
    </div>
</section>
@section Scripts { <script src="~/js/library/integrity.js" asp-append-version="true"></script> }
