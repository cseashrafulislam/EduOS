@{
    ViewData["Title"] = "Library Copy Conditions";
    var isAdmin = User.IsInRole("TenantAdmin");
}
<section id="libraryConditionsApp" class="container-fluid py-3" data-can-retire="@(isAdmin ? "true" : "false")">
    <header class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div class="d-flex align-items-center gap-2">
            <h2 class="h4 mb-0" id="conditionHeading">Copy conditions</h2>
            <details class="position-relative">
                <summary class="btn btn-sm btn-outline-secondary" aria-label="Copy condition help">ⓘ</summary>
                <div class="card card-body position-absolute shadow-sm mt-1" style="width:min(19rem,85vw);z-index:5">
                    Record lost or damaged copies. Only tenant administrators may recover or retire copies. Financial charges require separate Finance approval.
                </div>
            </details>
        </div>
        <a asp-controller="Library" asp-action="Circulation" class="btn btn-outline-secondary btn-sm" id="conditionBack">Circulation</a>
    </header>
    <div id="conditionAlert" class="d-none" role="alert" aria-live="polite"></div>
    <form id="conditionFilters" class="card card-body row g-2 align-items-end mb-3">
        <div class="col-md-5"><label class="form-label" for="conditionAccession" id="conditionSearchLabel">Accession</label>
            <input id="conditionAccession" class="form-control" maxlength="100" autocomplete="off" /></div>
        <div class="col-md-3"><label class="form-label" for="conditionState" id="conditionStateLabel">Condition</label>
            <select id="conditionState" class="form-select">
                <option value="all">All</option><option value="available">Available</option>
                <option value="issued">Issued</option><option value="lost">Lost</option>
                <option value="damaged">Damaged</option><option value="retired">Retired</option>
            </select></div>
        <div class="col-md-2"><button class="btn btn-primary w-100" type="submit" id="conditionApply">Apply</button></div>
        <div class="col-md-2"><button id="conditionExport" class="btn btn-outline-secondary w-100" type="button">CSV (page)</button></div>
    </form>
    <div class="card">
        <div class="card-header d-flex justify-content-between"><strong id="conditionRegisterTitle">Copy register</strong><span id="conditionCount" class="small text-muted"></span></div>
        <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>Accession</th><th>Book</th><th>Campus</th><th>Branch</th><th>Condition</th><th>Open loans</th><th>Actions</th></tr></thead>
            <tbody id="conditionRows"><tr><td colspan="7">Loading…</td></tr></tbody>
        </table></div>
        <div class="card-footer d-flex justify-content-end gap-2 align-items-center">
            <button id="conditionPrevious" class="btn btn-sm btn-outline-secondary" type="button">Previous</button>
            <span id="conditionPage" aria-live="polite"></span>
            <button id="conditionNext" class="btn btn-sm btn-outline-secondary" type="button">Next</button>
        </div>
    </div>
    <dialog id="conditionDialog" class="border-0 rounded shadow p-4" aria-labelledby="conditionDialogTitle" style="width:min(30rem,92vw)">
        <h3 class="h5" id="conditionDialogTitle">Record copy condition</h3>
        <form id="conditionForm">
            <p id="conditionSelected" class="fw-semibold mb-2"></p>
            <label class="form-label" for="conditionTarget">New condition</label>
            <select id="conditionTarget" class="form-select mb-3" required></select>
            <label class="form-label" for="conditionReason">Reason (no personal details)</label>
            <textarea id="conditionReason" class="form-control mb-3" maxlength="300" rows="3" required></textarea>
            <div class="d-flex justify-content-end gap-2">
                <button id="conditionCancel" class="btn btn-outline-secondary" type="button">Cancel</button>
                <button id="conditionSave" class="btn btn-primary" type="submit">Save condition</button>
            </div>
        </form>
    </dialog>
    <dialog id="conditionHistoryDialog" class="border-0 rounded shadow p-4" aria-labelledby="conditionHistoryTitle" style="width:min(42rem,94vw)">
        <h3 class="h5" id="conditionHistoryTitle">Condition history</h3>
        <div id="conditionHistoryRows" class="small mb-3" aria-live="polite"></div>
        <button id="conditionHistoryClose" class="btn btn-outline-secondary" type="button">Close</button>
    </dialog>
</section>
@section Scripts { <script src="~/js/library/conditions.js" asp-append-version="true"></script> }
