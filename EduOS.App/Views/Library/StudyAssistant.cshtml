@{
    var bn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
    var reviewer = User.IsInRole("TenantAdmin") || User.IsInRole("Teacher");
    ViewData["Title"] = bn ? "AI অধ্যয়ন সহকারী" : "AI Study Assistant";
}
<section class="admission-page" aria-labelledby="assistantHeading">
    <header class="content-header-card d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h2 id="assistantHeading" class="h4 mb-1">@(bn ? "AI অধ্যয়ন সহকারী" : "AI Study Assistant")</h2>
            <p class="small text-muted mb-0">@(bn ? "অনুমোদিত বইয়ের নির্দিষ্ট অধ্যায়ের প্রমাণভিত্তিক উদ্ধৃতি। উত্তর না পাওয়া গেলে অধ্যায়টি পড়ুন।" : "Short cited answers from reviewed licensed chapters. An unsupported question returns no answer.")</p>
        </div>
        <a asp-controller="Library" asp-action="Study" class="btn btn-sm btn-outline-secondary">@(bn ? "অধ্যয়ন সংগ্রহ" : "Study collections")</a>
    </header>
    <div id="assistantAlert" class="d-none" role="alert" tabindex="-1"></div>
    <form id="assistantForm" class="content-card row g-3 mt-3" autocomplete="off">
        @Html.AntiForgeryToken()
        <div class="col-12 col-lg-7">
            <label for="assistantSearch" class="form-label">@(bn ? "বই/অধ্যায় খুঁজুন" : "Find book or chapter")</label>
            <div class="input-group">
                <input id="assistantSearch" class="form-control" maxlength="100" />
                <button id="assistantFind" class="btn btn-outline-primary" type="button">@(bn ? "খুঁজুন" : "Find")</button>
            </div>
        </div>
        <div class="col-12 col-lg-5">
            <label for="assistantSource" class="form-label">@(bn ? "অনুমোদিত অধ্যায়" : "Reviewed chapter")</label>
            <select id="assistantSource" class="form-select" required><option value="">@(bn ? "অধ্যায় নির্বাচন করুন" : "Select a chapter")</option></select>
            <div class="d-flex align-items-center justify-content-end gap-2 mt-1">
                <button id="assistantSourcePrev" class="btn btn-sm btn-outline-secondary" type="button" disabled>@(bn ? "আগে" : "Prev")</button>
                <span id="assistantSourcePage" class="small text-muted" aria-live="polite"></span>
                <button id="assistantSourceNext" class="btn btn-sm btn-outline-secondary" type="button" disabled>@(bn ? "পরে" : "Next")</button>
            </div>
        </div>
        <div class="col-12">
            <label for="assistantQuestion" class="form-label">@(bn ? "অধ্যায় থেকে প্রশ্ন করুন" : "Ask about the chapter")</label>
            <textarea id="assistantQuestion" class="form-control" maxlength="300" minlength="2" rows="3" required placeholder="@(bn ? "যেমন: সালোকসংশ্লেষণ কী?" : "For example: What is photosynthesis?")"></textarea>
        </div>
        <div class="col-12 d-flex justify-content-between align-items-center gap-2 flex-wrap">
            <span id="assistantCount" class="small text-muted" aria-live="polite"></span>
            <button id="assistantAsk" type="submit" class="btn btn-primary">@(bn ? "উত্তর দেখুন" : "Get cited answer")</button>
        </div>
    </form>
    <section class="content-card mt-3" aria-labelledby="assistantAnswerHeading">
        <h3 id="assistantAnswerHeading" class="h5">@(bn ? "অধ্যায়ভিত্তিক উত্তর" : "Grounded answer")</h3>
        <p id="assistantResult" class="mb-2" aria-live="polite">@(bn ? "একটি অধ্যায় নির্বাচন করে প্রশ্ন করুন।" : "Choose a chapter and ask a question.")</p>
        <p id="assistantCitation" class="small text-muted mb-0"></p>
        <p class="small text-muted mt-2 mb-0">@(bn ? "শিক্ষকের অনুমোদিত উদ্ধৃতি—পূর্ণ বই নয়। শিক্ষার গুরুত্বপূর্ণ সিদ্ধান্তে মূল বই যাচাই করুন।" : "Teacher-reviewed excerpt, not a full book. Verify important learning decisions in the original source.")</p>
    </section>
    @if (reviewer)
    {
        <section class="content-card mt-3" id="assistantReviewPanel" aria-labelledby="assistantReviewHeading">
            <h3 id="assistantReviewHeading" class="h5">@(bn ? "শিক্ষক: উদ্ধৃতি জমা ও পর্যালোচনা" : "Teacher: submit and review passages")</h3>
            <p class="small text-muted">@(bn ? "শুধু নিজ প্রতিষ্ঠানের অনুমোদিত লাইসেন্সধারী অধ্যায় ব্যবহার করুন। নিজের জমা দেওয়া উদ্ধৃতি নিজে অনুমোদন করা যাবে না।" : "Use only approved licensed chapters in your campus. A different reviewer must approve your passage.")</p>
            <div class="row g-2">
                <div class="col-sm-7"><label for="assistantReviewSearch" class="form-label">@(bn ? "উৎস খুঁজুন" : "Find reviewable source")</label><input id="assistantReviewSearch" class="form-control" maxlength="100" /></div>
                <div class="col-sm-5 d-flex align-items-end"><button id="assistantReviewFind" class="btn btn-outline-primary" type="button">@(bn ? "লোড" : "Load sources")</button></div>
                <div class="col-12"><label for="assistantReviewSource" class="form-label">@(bn ? "লাইসেন্সধারী অধ্যায়" : "Licensed chapter")</label><select id="assistantReviewSource" class="form-select"><option value="">@(bn ? "নির্বাচন করুন" : "Select")</option></select></div>
                <div class="col-12 d-flex justify-content-end gap-2 align-items-center">
                    <button id="assistantReviewSourcePrev" class="btn btn-sm btn-outline-secondary" type="button" disabled>@(bn ? "আগে" : "Prev")</button>
                    <span id="assistantReviewSourcePage" class="small text-muted" aria-live="polite"></span>
                    <button id="assistantReviewSourceNext" class="btn btn-sm btn-outline-secondary" type="button" disabled>@(bn ? "পরে" : "Next")</button>
                </div>
            </div>
            <form id="assistantExcerptForm" class="row g-2 mt-2">
                <div class="col-sm-6"><label for="assistantLocator" class="form-label">@(bn ? "পৃষ্ঠা/অনুচ্ছেদ" : "Page / paragraph locator")</label><input id="assistantLocator" class="form-control" maxlength="160" minlength="2" required /></div>
                <div class="col-sm-6"><label for="assistantLanguage" class="form-label">@(bn ? "ভাষা" : "Language")</label><select id="assistantLanguage" class="form-select"><option value="bn-BD">বাংলা</option><option value="en-BD">English</option></select></div>
                <div class="col-12"><label for="assistantExcerptText" class="form-label">@(bn ? "যাচাইকৃত সংক্ষিপ্ত উদ্ধৃতি" : "Verified short passage")</label><textarea id="assistantExcerptText" class="form-control" minlength="10" maxlength="1200" rows="3" required></textarea></div>
                <div class="col-12 text-end"><button type="submit" class="btn btn-primary">@(bn ? "রিভিউয়ের জন্য জমা" : "Submit for review")</button></div>
            </form>
            <h4 class="h6 mt-4">@(bn ? "উদ্ধৃতি ও অনুমোদন" : "Passages and decisions")</h4>
            <div id="assistantReviewRows" class="d-grid gap-2" aria-live="polite"></div>
            <div class="d-flex justify-content-end gap-2 mt-2">
                <button type="button" id="assistantReviewPrev" class="btn btn-sm btn-outline-secondary" disabled>@(bn ? "আগে" : "Previous")</button>
                <span id="assistantReviewPage" class="small align-self-center"></span>
                <button type="button" id="assistantReviewNext" class="btn btn-sm btn-outline-secondary" disabled>@(bn ? "পরে" : "Next")</button>
            </div>
        </section>
    }
</section>
@section Scripts {
    <script src="~/js/library/study-assistant.js" asp-append-version="true"></script>
}
