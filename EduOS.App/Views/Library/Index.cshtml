@{
    ViewData["Title"] = "Library";
    var canManage = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("Librarian");
}
<section class="admission-page" aria-labelledby="libraryTitle">
    <header class="content-header-card d-flex justify-content-between align-items-center gap-3 flex-wrap">
        <div><p class="dashboard-eyebrow">Library Operations</p><h2 id="libraryTitle">Library</h2><p>Search books, check availability and review your borrowing history.</p></div>
        <button id="printLibrary" type="button" class="btn btn-outline-secondary">Print current page</button>
    </header>
    <div id="libraryAlert" class="d-none" role="alert" tabindex="-1"></div>
    <section class="content-card">
        <form id="librarySearch" class="row g-3 align-items-end">
            <div class="col-md-8"><label class="form-label" for="libraryQuery">Title, author or ISBN</label><input id="libraryQuery" class="form-control" maxlength="150" autocomplete="off" /></div>
            <div class="col-md-4 d-flex gap-2"><button class="btn btn-primary" type="submit">Search</button><button id="clearLibrarySearch" class="btn btn-outline-secondary" type="button">Clear</button></div>
        </form>
    </section>
    <section class="content-card mt-3" aria-labelledby="catalogTitle">
        <div class="content-card-heading d-flex justify-content-between align-items-center"><h3 id="catalogTitle">Catalog</h3><span id="catalogCount" class="small text-muted"></span></div>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Title</th><th>Author</th><th>ISBN</th><th>Category</th><th class="text-end">Available / Total</th>@if (canManage) { <th>Actions</th> }</tr></thead><tbody id="catalogRows"><tr><td colspan="@(canManage ? 6 : 5)" class="text-center text-muted py-4">Loading catalog…</td></tr></tbody></table></div>
        <nav class="d-flex justify-content-end align-items-center gap-2 mt-3" aria-label="Catalog pagination"><button id="catalogPrevious" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous</button><span id="catalogPage" aria-live="polite">Page 1</span><button id="catalogNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next</button></nav>
    </section>
    @if (canManage)
    {
        <section class="content-card mt-3" aria-labelledby="bookEditorTitle">
            <h3 id="bookEditorTitle" class="h5">Create / edit book metadata</h3>
            <form id="libraryBookForm" class="row g-3">
                <input id="bookReference" type="hidden" /><input id="bookRowVersion" type="hidden" />
                <div class="col-md-6"><label class="form-label" for="bookTitle">Title *</label><input id="bookTitle" maxlength="300" class="form-control" required /></div>
                <div class="col-md-6"><label class="form-label" for="bookAuthor">Author</label><input id="bookAuthor" maxlength="200" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label" for="bookIsbn">ISBN</label><input id="bookIsbn" maxlength="30" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label" for="bookPublisher">Publisher</label><input id="bookPublisher" maxlength="200" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label" for="bookEdition">Edition</label><input id="bookEdition" maxlength="100" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label" for="bookReplacement">Replacement price (BDT)</label><input id="bookReplacement" type="number" min="0" max="999999999999" step="0.01" class="form-control" /></div>
                <div class="col-md-8"><label class="form-label" for="bookCover">Cover image URL</label><input id="bookCover" maxlength="500" type="url" class="form-control" /></div>
                <div class="col-12 d-flex gap-2 flex-wrap">
                    <button id="bookSave" type="submit" class="btn btn-success">Save book</button>
                    <button id="bookReset" type="button" class="btn btn-outline-secondary">Clear / new book</button>
                </div>
            </form>
            <p class="small text-muted mt-2 mb-0">This form edits book metadata only. Copies and circulation are separate records; creating a book does not automatically add stock.</p>
        </section>
    }
    <section class="content-card mt-3" aria-labelledby="issuesTitle">
        <div class="content-card-heading d-flex justify-content-between align-items-center"><h3 id="issuesTitle">My borrowing history</h3><span id="issueCount" class="small text-muted"></span></div>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Book</th><th>Accession</th><th>Issued</th><th>Due</th><th>Returned</th><th>Status</th><th class="text-end">Fine</th></tr></thead><tbody id="issueRows"><tr><td colspan="7" class="text-center text-muted py-4">Loading issues…</td></tr></tbody></table></div>
        <nav class="d-flex justify-content-end align-items-center gap-2 mt-3" aria-label="Borrowing history pagination"><button id="issuePrevious" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous</button><span id="issuePage" aria-live="polite">Page 1</span><button id="issueNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next</button></nav>
    </section>
</section>
@section Scripts {
    <script src="~/js/library/index.js" asp-append-version="true"></script>
}
