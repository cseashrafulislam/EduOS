@{
    ViewData["Title"] = "Library";
    var canManage = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("Librarian");
    var isStudentBorrower = User.IsInRole("Student");
    var canViewMyLoans = isStudentBorrower || User.IsInRole("Teacher") || User.IsInRole("Employee") ||
        User.IsInRole("Staff") || User.IsInRole("Principal") || User.IsInRole("Librarian");
}
<section class="admission-page" aria-labelledby="libraryTitle">
    <header class="content-header-card d-flex justify-content-between align-items-center gap-3 flex-wrap">
        <div class="d-flex align-items-center gap-2"><h2 id="libraryTitle" class="mb-0">Library</h2>
            <details class="position-relative"><summary class="btn btn-sm btn-outline-secondary" aria-label="Library help" title="Help">ⓘ</summary>
                <div class="card position-absolute p-2 shadow-sm" style="width:min(20rem,80vw);z-index:10;">Search the catalog, review your own loans, and use reservations for unavailable books. Recorded fines are not payment balances.</div>
            </details></div>
        @if (User.IsInRole("TenantAdmin")) { <a asp-controller="Library" asp-action="Branches" class="btn btn-outline-primary">Manage library branches</a> }
        @if (canManage) { <a asp-controller="Library" asp-action="Circulation" class="btn btn-outline-primary">Circulation register</a> }
        @if (canManage) { <a asp-controller="Library" asp-action="Conditions" class="btn btn-outline-primary">Copy conditions</a> }
        @if (User.IsInRole("TenantAdmin")) { <a asp-controller="Library" asp-action="Liabilities" class="btn btn-outline-primary">Liabilities &amp; Finance</a> }
        <a asp-controller="Library" asp-action="Reservations" class="btn btn-primary">Book reservations</a>
        @if (canManage || canViewMyLoans || User.IsInRole("Teacher") || User.IsInRole("Employee") || User.IsInRole("Staff"))
        { <a asp-controller="Library" asp-action="Digital" class="btn btn-outline-primary">Digital resources</a> }
        <button id="printLibrary" type="button" class="btn btn-outline-secondary">Print current page</button>
    </header>
    <div id="libraryAlert" class="d-none" role="alert" tabindex="-1"></div>
    <section class="content-card">
        <form id="librarySearch" class="row g-3 align-items-end">
            <div class="col-md-8"><label class="form-label" for="libraryQuery">Title, author or ISBN</label><input id="libraryQuery" class="form-control" maxlength="150" autocomplete="off" /></div>
            <div class="col-md-4 d-flex gap-2"><button class="btn btn-primary" type="submit">Search</button><button id="clearLibrarySearch" class="btn btn-outline-secondary" type="button">Clear</button></div>
        </form>
    </section>
    <section class="content-card mt-3" aria-labelledby="catalogTitle">
        <div class="content-card-heading d-flex justify-content-between align-items-center"><h3 id="catalogTitle">Catalog</h3><span id="catalogCount" class="small text-muted"></span></div>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Title</th><th>Author</th><th>ISBN</th><th>Category</th><th class="text-end">Available / Total</th>@if (canManage) { <th>Actions</th> }</tr></thead><tbody id="catalogRows"><tr><td colspan="@(canManage ? 6 : 5)" class="text-center text-muted py-4">Loading catalog…</td></tr></tbody></table></div>
        <nav class="d-flex justify-content-end align-items-center gap-2 mt-3" aria-label="Catalog pagination"><button id="catalogPrevious" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous</button><span id="catalogPage" aria-live="polite">Page 1</span><button id="catalogNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next</button></nav>
    </section>
    @if (canManage)
    {
        <section class="content-card mt-3" aria-labelledby="categoryEditorTitle">
            <h3 id="categoryEditorTitle" class="h5">Book categories</h3>
            <form id="libraryCategoryForm" class="row g-2 align-items-end">
                <input id="categoryId" type="hidden" /><input id="categoryRowVersion" type="hidden" />
                <div class="col-md-4"><label class="form-label" for="categoryName">Category name</label><input id="categoryName" class="form-control" maxlength="150" required /></div>
                <div class="col-md-3"><label class="form-label" for="categoryCode">Code</label><input id="categoryCode" class="form-control" maxlength="50" required /></div>
                <div class="col-md-2"><label class="form-label d-block"><input id="categoryActive" type="checkbox" checked /> Active</label></div>
                <div class="col-md-3 d-flex gap-2"><button id="categorySave" type="submit" class="btn btn-primary">Save</button><button id="categoryReset" type="button" class="btn btn-outline-secondary">Clear</button></div>
            </form>
            <div class="table-responsive mt-3"><table class="table table-sm table-hover"><thead><tr><th>Name</th><th>Code</th><th>Status</th><th>Action</th></tr></thead><tbody id="categoryRows"><tr><td colspan="4">Loading categories…</td></tr></tbody></table></div>
        </section>
        <section class="content-card mt-3" aria-labelledby="bookEditorTitle">
            <h3 id="bookEditorTitle" class="h5">Create / edit book metadata</h3>
            <form id="libraryBookForm" class="row g-3">
                <input id="bookReference" type="hidden" /><input id="bookRowVersion" type="hidden" />
                <div class="col-md-6"><label class="form-label" for="bookTitle">Title *</label><input id="bookTitle" maxlength="300" class="form-control" required /></div>
                <div class="col-md-6"><label class="form-label" for="bookAuthor">Author</label><input id="bookAuthor" maxlength="200" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label" for="bookCategory">Category</label><select id="bookCategory" class="form-select"><option value="">Uncategorized</option></select></div>
                <div class="col-md-4"><label class="form-label" for="bookIsbn">ISBN</label><input id="bookIsbn" maxlength="30" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label" for="bookPublisher">Publisher</label><input id="bookPublisher" maxlength="200" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label" for="bookEdition">Edition</label><input id="bookEdition" maxlength="100" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label" for="bookReplacement">Replacement price (BDT)</label><input id="bookReplacement" type="number" min="0" max="999999999999" step="0.01" class="form-control" /></div>
                <div class="col-md-8"><label class="form-label" for="bookCover">Cover image URL</label><input id="bookCover" maxlength="500" type="url" class="form-control" /></div>
                <div class="col-12 d-flex gap-2 flex-wrap">
                    <button id="bookSave" type="submit" class="btn btn-success">Save book</button>
                    <button id="bookReset" type="button" class="btn btn-outline-secondary">Clear / new book</button>
                </div>
            </form>
            <p class="small text-muted mt-2 mb-0">This form edits book metadata only. Copies and circulation are separate records; creating a book does not automatically add stock.</p>
        </section>
    }
    @if (canManage)
    {
        <section id="libraryCopiesPanel" class="content-card mt-3 d-none" aria-labelledby="copyPanelTitle">
            <h3 id="copyPanelTitle" class="h5">Book copy administration</h3>
            <p id="copyBookTitle" class="text-muted"></p>
            <form id="libraryCopyForm" class="row g-2 align-items-end">
                <input id="copyId" type="hidden" /><input id="copyRowVersion" type="hidden" />
                <div class="col-md-4"><label for="copyAccession" class="form-label">Accession number *</label><input id="copyAccession" class="form-control" maxlength="100" required /></div>
                <div class="col-md-3"><label for="copyBarcode" class="form-label">Barcode</label><input id="copyBarcode" class="form-control" maxlength="100" /></div>
                <div class="col-md-3"><label for="copyShelf" class="form-label">Shelf</label><input id="copyShelf" class="form-control" maxlength="100" /></div>
                <div class="col-md-4"><label for="copyBranchSearch" class="form-label">Find branch</label>
                    <div class="input-group"><input id="copyBranchSearch" class="form-control" maxlength="100" placeholder="Name or code" />
                    <button id="copyBranchFind" type="button" class="btn btn-outline-secondary">Find</button></div></div>
                <div class="col-md-5"><label for="copyBranch" class="form-label">Library branch *</label>
                    <select id="copyBranch" class="form-select" required><option value="">Select a branch</option></select>
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <button id="copyBranchPrevious" type="button" class="btn btn-sm btn-outline-secondary">Previous</button>
                        <span id="copyBranchPage" class="small text-muted"></span>
                        <button id="copyBranchNext" type="button" class="btn btn-sm btn-outline-secondary">Next</button>
                    </div></div>
                <div class="col-md-2 d-flex gap-1"><button id="copySave" type="submit" class="btn btn-primary">Save copy</button><button id="copyReset" type="button" class="btn btn-outline-secondary">Clear</button></div>
            </form>
            <p class="small text-muted mt-2">Copies start Available. Select an active branch on the correct campus; issue/return controls circulation status.</p>
            <div class="table-responsive mt-2"><table class="table table-sm align-middle"><thead><tr><th>Accession</th><th>Barcode</th><th>Shelf</th><th>Branch</th><th>State</th><th>Action</th></tr></thead><tbody id="copyRows"></tbody></table></div>
            <nav class="d-flex gap-2 justify-content-end align-items-center"><button id="copyPrevious" type="button" class="btn btn-outline-secondary btn-sm">Previous</button><span id="copyPage"></span><button id="copyNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button></nav>
        </section>
    }
    @if (canViewMyLoans)
    {
    <section id="myLibraryLoans" class="content-card mt-3" aria-labelledby="issuesTitle"
             data-loan-endpoint="@(isStudentBorrower ? "my-issues" : "my-employee-issues")">
        <div class="content-card-heading d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h3 id="issuesTitle"><span data-bn="আমার বই ধার নেওয়ার ইতিহাস">My borrowing history</span> <span id="issueCount" class="small text-muted"></span></h3>
            <div class="d-flex align-items-center gap-2">
                <label for="issueStatus" class="visually-hidden">Loan status</label>
                <select id="issueStatus" class="form-select form-select-sm" aria-label="Filter my loans">
                    <option value="all">All loans</option><option value="issued">Outstanding</option>
                    <option value="overdue">Overdue</option><option value="returned">Returned</option>
                </select>
                <button id="issueCsv" type="button" class="btn btn-sm btn-outline-secondary">CSV (current page)</button>
            </div>
        </div>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Book</th><th>Accession</th><th>Issued</th><th>Due</th><th>Returned</th><th>Status</th><th class="text-end">Recorded fine</th></tr></thead><tbody id="issueRows"><tr><td colspan="7" class="text-center text-muted py-4">Loading issues…</td></tr></tbody></table></div>
        <nav class="d-flex justify-content-end align-items-center gap-2 mt-3" aria-label="Borrowing history pagination"><button id="issuePrevious" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous</button><span id="issuePage" aria-live="polite">Page 1</span><button id="issueNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next</button></nav>
    </section>
    }
</section>
@section Scripts {
    <script src="~/js/library/index.js" asp-append-version="true"></script>
}
