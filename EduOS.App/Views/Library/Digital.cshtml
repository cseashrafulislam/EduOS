@{
    ViewData["Title"] = "Digital Library";
    var admin = User.IsInRole("TenantAdmin");
    var bn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
}
<section class="admission-page" aria-labelledby="digitalLibraryTitle">
    <header class="content-header-card d-flex justify-content-between align-items-center gap-3 flex-wrap">
        <div class="d-flex align-items-center gap-2">
            <h2 id="digitalLibraryTitle" class="mb-0">@(bn ? "ডিজিটাল লাইব্রেরি" : "Digital library")</h2>
            <details class="position-relative">
                <summary class="btn btn-sm btn-outline-secondary" aria-label="@(bn ? "সহায়তা" : "Digital library help")" title="@(bn ? "সহায়তা" : "Help")">ⓘ</summary>
                <div class="card position-absolute p-2 shadow-sm" style="width:min(20rem,80vw);z-index:10;">
                    @(bn ? "রিসোর্স সব ক্যাম্পাসে অথবা একটি নির্বাচিত ক্যাম্পাসে প্রকাশ করা যায়। নতুন সংস্করণ আগের অনুমতি বজায় রাখে। ফাইল সর্বোচ্চ ৫ এমবি এবং নিরাপত্তা যাচাই বাধ্যতামূলক।" : "Publish to all active campuses or one selected campus. Replacement versions inherit access. Files must pass scanning and are limited to 5 MB.")
                </div>
            </details>
        </div>
        <div class="d-flex gap-2"><a asp-controller="Library" asp-action="Study" class="btn btn-outline-primary">@(bn ? "বাংলাদেশ অধ্যয়ন সংগ্রহ" : "Bangladesh study collections")</a><a asp-controller="Library" asp-action="Index" class="btn btn-outline-secondary">@(bn ? "বইয়ের তালিকা" : "Book catalog")</a></div>
    </header>
    <div id="digitalAlert" class="d-none" role="alert" tabindex="-1"></div>
    @if (admin)
    {
        <section class="content-card mt-3" aria-labelledby="digitalUploadTitle">
            <h3 id="digitalUploadTitle" class="h5">@(bn ? "নতুন রিসোর্স প্রকাশ" : "Publish a digital resource")</h3>
            <form id="digitalUploadForm" class="row g-3" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="col-md-5">
                    <label for="digitalBookSearch" class="form-label">@(bn ? "বই খুঁজুন" : "Find book")</label>
                    <div class="input-group">
                        <input id="digitalBookSearch" class="form-control" maxlength="100" autocomplete="off" />
                        <button id="digitalBookFind" type="button" class="btn btn-outline-secondary">@(bn ? "খুঁজুন" : "Find")</button>
                    </div>
                </div>
                <div class="col-md-7">
                    <label for="digitalBook" class="form-label">@(bn ? "বই নির্বাচন *" : "Book *")</label>
                    <select id="digitalBook" class="form-select" required><option value="">@(bn ? "বই নির্বাচন করুন" : "Select a book")</option></select>
                </div>
                <div class="col-md-6">
                    <label for="digitalTitle" class="form-label">@(bn ? "রিসোর্সের নাম *" : "Resource title *")</label>
                    <input id="digitalTitle" class="form-control" maxlength="250" required />
                </div>
                <div class="col-md-6">
                    <label for="digitalFile" class="form-label">@(bn ? "ফাইল (সর্বোচ্চ ৫ এমবি) *" : "File (max 5 MB) *")</label>
                    <input id="digitalFile" class="form-control" type="file" accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx" required />
                </div>
                <div class="col-md-6">
                    <label for="digitalExpiresOn" class="form-label">@(bn ? "প্রবেশাধিকার শেষের তারিখ (ঐচ্ছিক, UTC)" : "Access expiry date (optional, UTC)")</label>
                    <input id="digitalExpiresOn" class="form-control" type="date" />
                </div>
                <div class="col-md-6">
                    <label for="digitalCampus" class="form-label">@(bn ? "প্রবেশাধিকার" : "Campus access")</label>
                    <select id="digitalCampus" class="form-select" disabled>
                        <option value="">@(bn ? "সব সক্রিয় ক্যাম্পাস" : "All active campuses")</option>
                    </select>
                </div>
                <div class="col-12"><h4 class="h6">@(bn ? "শিক্ষাক্রম ও বৈধ প্রকাশনার তথ্য" : "Curriculum and lawful publication details")</h4></div>
                <div class="col-md-6">
                    <label for="digitalCurriculumSearch" class="form-label">@(bn ? "শিক্ষাক্রম/বিষয় খুঁজুন (ঐচ্ছিক)" : "Find curriculum/subject (optional)")</label>
                    <div class="input-group"><input id="digitalCurriculumSearch" class="form-control" maxlength="100" />
                        <button id="digitalCurriculumFind" class="btn btn-outline-secondary" type="button">@(bn ? "খুঁজুন" : "Find")</button></div>
                </div>
                <div class="col-md-6">
                    <label for="digitalCurriculum" class="form-label">@(bn ? "শিক্ষাক্রম → শ্রেণি → বিষয়" : "Curriculum → level → subject")</label>
                    <select id="digitalCurriculum" class="form-select"><option value="">@(bn ? "সাধারণ লাইব্রেরি রিসোর্স" : "General library resource")</option></select>
                </div>
                <div class="col-md-6"><label for="digitalChapter" class="form-label">@(bn ? "অধ্যায়" : "Chapter")</label><input id="digitalChapter" class="form-control" maxlength="150" /></div>
                <div class="col-md-6"><label for="digitalTopic" class="form-label">@(bn ? "বিষয়বস্তু" : "Topic")</label><input id="digitalTopic" class="form-control" maxlength="150" /></div>
                <div class="col-md-4"><label for="digitalLanguage" class="form-label">@(bn ? "ভাষা" : "Language")</label><select id="digitalLanguage" class="form-select"><option value="bn-BD">বাংলা</option><option value="en-BD">English</option></select></div>
                <div class="col-md-8"><label for="digitalSourceUrl" class="form-label">@(bn ? "মূল উৎসের HTTPS লিংক (প্রতিষ্ঠানের নিজস্ব হলে ঐচ্ছিক)" : "Original HTTPS source URL (optional for institution-owned)")</label><input id="digitalSourceUrl" class="form-control" type="url" maxlength="1000" pattern="https://.*" /></div>
                <div class="col-md-5"><label for="digitalRightsHolder" class="form-label">@(bn ? "স্বত্বাধিকারী *" : "Rights holder *")</label><input id="digitalRightsHolder" class="form-control" maxlength="200" required /></div>
                <div class="col-md-3"><label for="digitalLicenceCode" class="form-label">@(bn ? "ব্যবহারের অধিকার *" : "Licence basis *")</label><select id="digitalLicenceCode" class="form-select" required><option value="">@(bn ? "নির্বাচন করুন" : "Select")</option><option value="InstitutionOwned">Institution owned</option><option value="PublicDomain">Public domain</option><option value="PublisherLicensed">Publisher licensed</option><option value="OpenLicence">Open licence</option></select></div>
                <div class="col-md-4"><label for="digitalLicenceEvidence" class="form-label">@(bn ? "লাইসেন্স/অনুমতির প্রমাণ *" : "Licence/permission evidence *")</label><input id="digitalLicenceEvidence" class="form-control" maxlength="500" required /></div>
                <div class="col-12"><label class="form-check-label"><input id="digitalOfflineAllowed" type="checkbox" class="form-check-input me-2" />@(bn ? "এই শিক্ষাসামগ্রী ২৪ ঘণ্টা মেয়াদি এনক্রিপ্টেড অফলাইন কপি হিসেবে সংরক্ষণের অধিকার আছে" : "Rights explicitly permit 24-hour encrypted offline learning copies")</label></div>
                <div class="col-12"><h4 class="h6">@(bn ? "বাংলাদেশ পরীক্ষা প্রস্তুতি (ঐচ্ছিক)" : "Bangladesh exam study classification (optional)")</h4></div>
                <div class="col-md-4"><label for="digitalExamCode" class="form-label">@(bn ? "পরীক্ষা" : "Exam track")</label><select id="digitalExamCode" class="form-select"><option value="">@(bn ? "সাধারণ রিসোর্স" : "General resource")</option><option value="SSC">SSC</option><option value="HSC">HSC</option><option value="UniversityAdmission">@(bn ? "বিশ্ববিদ্যালয় ভর্তি" : "University admission")</option><option value="NTRCAStudy">@(bn ? "শুধু NTRCA অধ্যয়ন" : "NTRCA study only")</option></select></div>
                <div class="col-md-4"><label for="digitalBoardCode" class="form-label">@(bn ? "শিক্ষা বোর্ড/প্রতিষ্ঠান কোড" : "Education board/institution code")</label><input id="digitalBoardCode" class="form-control" maxlength="40" /></div>
                <div class="col-md-4"><label for="digitalSyllabusYear" class="form-label">@(bn ? "সিলেবাসের বছর" : "Syllabus year")</label><input id="digitalSyllabusYear" class="form-control" type="number" min="2000" max="2100" /></div>
                <div class="col-md-4"><label for="digitalSyllabusVersion" class="form-label">@(bn ? "সিলেবাস সংস্করণ" : "Syllabus version")</label><input id="digitalSyllabusVersion" class="form-control" maxlength="50" /></div>
                <div class="col-md-8"><label for="digitalSyllabusSourceUrl" class="form-label">@(bn ? "সরকারি/মূল সিলেবাসের HTTPS লিংক" : "Official/original syllabus HTTPS link")</label><input id="digitalSyllabusSourceUrl" class="form-control" type="url" maxlength="1000" pattern="https://.*" /></div>
                <div class="col-md-4"><label for="digitalPreviousPaperYear" class="form-label">@(bn ? "পূর্ববর্তী প্রশ্নের বছর" : "Previous paper year")</label><input id="digitalPreviousPaperYear" class="form-control" type="number" min="1990" max="2100" /></div>
                <div class="col-md-8"><label for="digitalStudyExplanation" class="form-label">@(bn ? "শিক্ষামূলক ব্যাখ্যা/নোট" : "Study explanation/notes")</label><textarea id="digitalStudyExplanation" class="form-control" rows="2" maxlength="2000"></textarea></div>
                <p class="small text-muted mb-0">@(bn ? "ফাইল প্রথমে রিভিউয়ের জন্য জমা হবে; অনুমোদনের আগে শিক্ষার্থীরা দেখতে পারবে না।" : "Submission starts in Pending Review; learners cannot access the file until approval.")</p>
                <div class="col-12">
                    <button id="digitalPublish" type="submit" class="btn btn-primary">@(bn ? "রিভিউয়ের জন্য জমা দিন" : "Submit for review")</button>
                </div>
            </form>
        </section>
    }
    @if (admin)
    {
        <dialog id="digitalEditDialog" class="border rounded shadow p-4" aria-labelledby="digitalEditHeading">
            <h3 id="digitalEditHeading" class="h5">@(bn ? "রিসোর্সের তথ্য পরিবর্তন" : "Edit resource access")</h3>
            <form id="digitalEditForm" class="row g-3">
                @Html.AntiForgeryToken()
                <div class="col-12">
                    <label for="digitalEditName" class="form-label">@(bn ? "রিসোর্সের নাম" : "Resource title")</label>
                    <input id="digitalEditName" class="form-control" maxlength="250" required />
                </div>
                <div class="col-12">
                    <label for="digitalEditExpiry" class="form-label">@(bn ? "প্রবেশাধিকার শেষের তারিখ (UTC)" : "Access expiry date (UTC)")</label>
                    <input id="digitalEditExpiry" class="form-control" type="date" />
                </div>
                <div class="col-12">
                    <label for="digitalEditCampus" class="form-label">@(bn ? "প্রবেশাধিকার" : "Campus access")</label>
                    <select id="digitalEditCampus" class="form-select" disabled>
                        <option value="">@(bn ? "সব সক্রিয় ক্যাম্পাস" : "All active campuses")</option>
                    </select>
                </div>
                <div class="col-12 d-flex justify-content-end gap-2">
                    <button id="digitalEditCancel" type="button" class="btn btn-outline-secondary">@(bn ? "বাতিল" : "Cancel")</button>
                    <button id="digitalEditSave" type="submit" class="btn btn-primary">@(bn ? "সংরক্ষণ" : "Save")</button>
                </div>
            </form>
        </dialog>
    }
    @if (admin)
    {
        <dialog id="digitalReplaceDialog" class="border rounded shadow p-4" aria-labelledby="digitalReplaceHeading">
            <h3 id="digitalReplaceHeading" class="h5">@(bn ? "নতুন সংস্করণ প্রকাশ" : "Publish replacement version")</h3>
            <form id="digitalReplaceForm" class="row g-3" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="col-12">
                    <label for="digitalReplaceTitle" class="form-label">@(bn ? "রিসোর্সের নাম" : "Resource title")</label>
                    <input id="digitalReplaceTitle" class="form-control" maxlength="250" required />
                </div>
                <div class="col-md-6">
                    <label for="digitalReplaceFile" class="form-label">@(bn ? "নতুন ফাইল (সর্বোচ্চ ৫ এমবি)" : "New file (max 5 MB)")</label>
                    <input id="digitalReplaceFile" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx" required />
                </div>
                <div class="col-md-6">
                    <label for="digitalReplaceExpiry" class="form-label">@(bn ? "মেয়াদ শেষ (UTC)" : "Access expiry (UTC)")</label>
                    <input id="digitalReplaceExpiry" class="form-control" type="date" />
                </div>
                <div class="col-md-6"><label for="digitalReplaceChapter" class="form-label">@(bn ? "অধ্যায়" : "Chapter")</label><input id="digitalReplaceChapter" class="form-control" maxlength="150" /></div>
                <div class="col-md-6"><label for="digitalReplaceTopic" class="form-label">@(bn ? "বিষয়বস্তু" : "Topic")</label><input id="digitalReplaceTopic" class="form-control" maxlength="150" /></div>
                <div class="col-md-4"><label for="digitalReplaceLanguage" class="form-label">@(bn ? "ভাষা" : "Language")</label><select id="digitalReplaceLanguage" class="form-select"><option value="bn-BD">বাংলা</option><option value="en-BD">English</option></select></div>
                <div class="col-md-8"><label for="digitalReplaceSourceUrl" class="form-label">@(bn ? "মূল উৎসের HTTPS লিংক (প্রতিষ্ঠানের নিজস্ব হলে ঐচ্ছিক)" : "Original HTTPS source URL (optional for institution-owned)")</label><input id="digitalReplaceSourceUrl" class="form-control" type="url" maxlength="1000" pattern="https://.*" /></div>
                <div class="col-md-5"><label for="digitalReplaceRightsHolder" class="form-label">@(bn ? "স্বত্বাধিকারী *" : "Rights holder *")</label><input id="digitalReplaceRightsHolder" class="form-control" maxlength="200" required /></div>
                <div class="col-md-3"><label for="digitalReplaceLicenceCode" class="form-label">@(bn ? "লাইসেন্স *" : "Licence *")</label><select id="digitalReplaceLicenceCode" class="form-select" required><option value="">@(bn ? "নির্বাচন করুন" : "Select")</option><option value="InstitutionOwned">Institution owned</option><option value="PublicDomain">Public domain</option><option value="PublisherLicensed">Publisher licensed</option><option value="OpenLicence">Open licence</option></select></div>
                <div class="col-md-4"><label for="digitalReplaceLicenceEvidence" class="form-label">@(bn ? "অনুমতির প্রমাণ *" : "Permission evidence *")</label><input id="digitalReplaceLicenceEvidence" class="form-control" maxlength="500" required /></div>
                <div class="col-12"><label class="form-check-label"><input id="digitalReplaceOfflineAllowed" type="checkbox" class="form-check-input me-2" />@(bn ? "নতুন সংস্করণের জন্য অফলাইন অধিকার অনুমোদন করা হয়েছে" : "Offline rights have been granted for this replacement")</label></div>
                <div class="col-md-4"><label for="digitalReplaceExamCode" class="form-label">@(bn ? "পরীক্ষা" : "Exam track")</label><select id="digitalReplaceExamCode" class="form-select"><option value="">@(bn ? "সাধারণ রিসোর্স" : "General resource")</option><option value="SSC">SSC</option><option value="HSC">HSC</option><option value="UniversityAdmission">@(bn ? "বিশ্ববিদ্যালয় ভর্তি" : "University admission")</option><option value="NTRCAStudy">@(bn ? "শুধু NTRCA অধ্যয়ন" : "NTRCA study only")</option></select></div>
                <div class="col-md-4"><label for="digitalReplaceBoardCode" class="form-label">@(bn ? "বোর্ড/প্রতিষ্ঠান কোড" : "Board/institution code")</label><input id="digitalReplaceBoardCode" class="form-control" maxlength="40" /></div>
                <div class="col-md-4"><label for="digitalReplaceSyllabusYear" class="form-label">@(bn ? "সিলেবাসের বছর" : "Syllabus year")</label><input id="digitalReplaceSyllabusYear" class="form-control" type="number" min="2000" max="2100" /></div>
                <div class="col-md-4"><label for="digitalReplaceSyllabusVersion" class="form-label">@(bn ? "সিলেবাস সংস্করণ" : "Syllabus version")</label><input id="digitalReplaceSyllabusVersion" class="form-control" maxlength="50" /></div>
                <div class="col-md-8"><label for="digitalReplaceSyllabusSourceUrl" class="form-label">@(bn ? "মূল সিলেবাস HTTPS লিংক" : "Syllabus HTTPS link")</label><input id="digitalReplaceSyllabusSourceUrl" class="form-control" type="url" maxlength="1000" pattern="https://.*" /></div>
                <div class="col-md-4"><label for="digitalReplacePreviousPaperYear" class="form-label">@(bn ? "প্রশ্নের বছর" : "Paper year")</label><input id="digitalReplacePreviousPaperYear" class="form-control" type="number" min="1990" max="2100" /></div>
                <div class="col-md-8"><label for="digitalReplaceStudyExplanation" class="form-label">@(bn ? "শিক্ষামূলক ব্যাখ্যা" : "Study explanation")</label><textarea id="digitalReplaceStudyExplanation" class="form-control" rows="2" maxlength="2000"></textarea></div>
                <div class="col-12 d-flex justify-content-end gap-2">
                    <button id="digitalReplaceCancel" type="button" class="btn btn-outline-secondary">@(bn ? "বাতিল" : "Cancel")</button>
                    <button id="digitalReplaceSave" type="submit" class="btn btn-primary">@(bn ? "রিভিউয়ের জন্য জমা দিন" : "Submit replacement for review")</button>
                </div>
            </form>
        </dialog>
    }
    @if (admin)
    {
        <dialog id="digitalHistoryDialog" class="border rounded shadow p-3 p-md-4" aria-labelledby="digitalHistoryHeading">
            <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                <h3 id="digitalHistoryHeading" class="h5 mb-0">@(bn ? "প্রকাশিত সংস্করণের ইতিহাস" : "Publication version history")</h3>
                <button id="digitalHistoryExport" type="button" class="btn btn-sm btn-outline-secondary">@(bn ? "CSV (এই পৃষ্ঠা)" : "CSV (current page)")</button>
            </div>
            <div class="table-responsive mt-3">
                <table class="table table-sm table-hover align-middle">
                    <thead><tr>
                        <th>@(bn ? "সংস্করণ" : "Version")</th>
                        <th>@(bn ? "নাম" : "Title")</th>
                        <th>@(bn ? "অবস্থা" : "State")</th>
                        <th>@(bn ? "ক্যাম্পাস" : "Campus")</th>
                        <th>@(bn ? "মেয়াদ (UTC)" : "Expiry (UTC)")</th>
                        <th>@(bn ? "প্রকাশ (UTC)" : "Published (UTC)")</th>
                    </tr></thead>
                    <tbody id="digitalHistoryRows"></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-end align-items-center gap-2 flex-wrap">
                <button id="digitalHistoryPrevious" type="button" class="btn btn-sm btn-outline-secondary" disabled>@(bn ? "আগে" : "Previous")</button>
                <span id="digitalHistoryPage" aria-live="polite"></span>
                <button id="digitalHistoryNext" type="button" class="btn btn-sm btn-outline-secondary" disabled>@(bn ? "পরে" : "Next")</button>
                <button id="digitalHistoryClose" type="button" class="btn btn-sm btn-primary">@(bn ? "বন্ধ করুন" : "Close")</button>
            </div>
        </dialog>
    }
    <section class="content-card mt-3" aria-labelledby="digitalListTitle">
        <div class="content-card-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h3 id="digitalListTitle" class="h5 mb-0">@(bn ? "অনুমোদিত রিসোর্স" : "Available resources") <span id="digitalCount" class="small text-muted"></span></h3>
            @if (admin) { <button id="digitalExport" type="button" class="btn btn-sm btn-outline-secondary">@(bn ? "CSV (এই পৃষ্ঠা)" : "CSV (current page)")</button> }
        </div>
        <form id="digitalSearchForm" class="row g-2 align-items-end mt-2">
            <div class="col-md-7">
                <label for="digitalQuery" class="form-label">@(bn ? "বই, বিভাগ, লেখক, প্রকাশক, সংস্করণ, ISBN বা রিসোর্স খুঁজুন" : "Search book, category, author, publisher, edition, ISBN or resource")</label>
                <input id="digitalQuery" class="form-control" maxlength="100" />
            </div>
            @if (admin)
            {
                <div class="col-md-3">
                    <label for="digitalStatus" class="form-label">@(bn ? "অবস্থা" : "Status")</label>
                    <select id="digitalStatus" class="form-select"><option value="active">@(bn ? "সক্রিয়" : "Active")</option><option value="all">@(bn ? "সব" : "All")</option></select>
                </div>
            }
            <div class="col-md-2"><button type="submit" class="btn btn-outline-primary w-100">@(bn ? "খুঁজুন" : "Search")</button></div>
            <div class="col-sm-6 col-lg-3">
                <label for="digitalCategoryFilter" class="form-label">@(bn ? "বিভাগ" : "Category")</label>
                <input id="digitalCategoryFilter" class="form-control" maxlength="100" autocomplete="off" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <label for="digitalAuthorFilter" class="form-label">@(bn ? "লেখক" : "Author")</label>
                <input id="digitalAuthorFilter" class="form-control" maxlength="100" autocomplete="off" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <label for="digitalPublisherFilter" class="form-label">@(bn ? "প্রকাশক" : "Publisher")</label>
                <input id="digitalPublisherFilter" class="form-control" maxlength="100" autocomplete="off" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <label for="digitalEditionFilter" class="form-label">@(bn ? "সংস্করণ" : "Edition")</label>
                <input id="digitalEditionFilter" class="form-control" maxlength="100" autocomplete="off" />
            </div>
            <div class="col-sm-6 col-lg-3"><label for="digitalChapterFilter" class="form-label">@(bn ? "অধ্যায়" : "Chapter")</label><input id="digitalChapterFilter" class="form-control" maxlength="100" /></div>
            <div class="col-sm-6 col-lg-3"><label for="digitalLanguageFilter" class="form-label">@(bn ? "ভাষা" : "Language")</label><select id="digitalLanguageFilter" class="form-select"><option value="">@(bn ? "সব ভাষা" : "All languages")</option><option value="bn-BD">বাংলা</option><option value="en-BD">English</option></select></div>
            <div class="col-12">
                <button id="digitalClearFilters" type="button" class="btn btn-sm btn-outline-secondary">@(bn ? "ফিল্টার মুছুন" : "Clear filters")</button>
            </div>
        </form>
        <div class="table-responsive mt-3">
            <table class="table table-hover align-middle">
                <thead><tr><th>@(bn ? "বই" : "Book")</th><th>@(bn ? "রিসোর্স" : "Resource")</th><th>@(bn ? "ফাইল" : "File")</th><th>@(bn ? "অবস্থা" : "Status")</th><th>@(bn ? "শেষের তারিখ (UTC)" : "Expiry (UTC)")</th><th>@(bn ? "কাজ" : "Actions")</th></tr></thead>
                <tbody id="digitalRows"><tr><td colspan="6" class="text-center text-muted">@(bn ? "লোড হচ্ছে…" : "Loading…")</td></tr></tbody>
            </table>
        </div>
        <nav class="d-flex justify-content-end align-items-center gap-2" aria-label="Digital library pagination">
            <button id="digitalPrevious" type="button" class="btn btn-sm btn-outline-secondary" disabled>@(bn ? "আগে" : "Previous")</button>
            <span id="digitalPage" aria-live="polite">1</span>
            <button id="digitalNext" type="button" class="btn btn-sm btn-outline-secondary" disabled>@(bn ? "পরে" : "Next")</button>
        </nav>
    </section>
    @if (admin)
    {
        <section class="content-card mt-3" aria-labelledby="digitalAuditTitle">
            <div class="content-card-heading d-flex justify-content-between gap-2 flex-wrap">
                <h3 id="digitalAuditTitle" class="h5">@(bn ? "প্রবেশ ও পরিবর্তনের ইতিহাস" : "Access and change audit")</h3>
                <button id="digitalAuditExport" type="button" class="btn btn-sm btn-outline-secondary">@(bn ? "CSV (এই পৃষ্ঠা)" : "CSV (current page)")</button>
            </div>
            <form id="digitalAuditFilters" class="row g-2 align-items-end mt-2">
                <div class="col-md-3"><label for="digitalAuditFrom" class="form-label">@(bn ? "শুরু (UTC)" : "From (UTC)")</label><input id="digitalAuditFrom" type="date" class="form-control" required /></div>
                <div class="col-md-3"><label for="digitalAuditTo" class="form-label">@(bn ? "শেষ (UTC)" : "To (UTC)")</label><input id="digitalAuditTo" type="date" class="form-control" required /></div>
                <div class="col-md-4"><label for="digitalAuditAction" class="form-label">@(bn ? "ঘটনা" : "Event")</label>
                    <select id="digitalAuditAction" class="form-select">
                        <option value="all">@(bn ? "সব" : "All")</option>
                        <option value="publish">Publish</option><option value="replace">Replace</option>
                        <option value="submit">Submit</option><option value="approve">Approve</option><option value="reject">Reject</option>
                        <option value="update">Update</option><option value="revoke">Revoke</option>
                        <option value="download">Download</option>
                    </select></div>
                <div class="col-md-2"><button type="submit" class="btn btn-outline-primary w-100">@(bn ? "দেখুন" : "Apply")</button></div>
            </form>
            <div class="table-responsive mt-3"><table class="table table-sm table-hover align-middle">
                <thead><tr><th>Resource</th><th>Reference</th><th>Event</th><th>Version</th><th>UTC</th><th>Actor ID</th></tr></thead>
                <tbody id="digitalAuditRows"></tbody>
            </table></div>
            <nav class="d-flex justify-content-end align-items-center gap-2" aria-label="Digital audit pagination">
                <button id="digitalAuditPrevious" type="button" class="btn btn-sm btn-outline-secondary" disabled>Previous</button>
                <span id="digitalAuditPage" aria-live="polite"></span>
                <button id="digitalAuditNext" type="button" class="btn btn-sm btn-outline-secondary" disabled>Next</button>
            </nav>
        </section>
    }
</section>
@section Scripts {
    <script src="~/js/library/digital.js" asp-append-version="true"></script>
}
