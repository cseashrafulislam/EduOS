@{
    ViewData["Title"] = "Library Reservations";
    var canManage = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("Librarian");
    var canExportMine = User.IsInRole("Student");
}
<section id="reservationApp" class="container-fluid py-3" data-staff="@(canManage ? "true" : "false")">
    <header class="content-header-card d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div class="d-flex align-items-center gap-2"><h2 class="h4 mb-0">Library reservations</h2>
            <details class="position-relative"><summary class="btn btn-sm btn-outline-secondary" aria-label="Reservation help" title="Help">ⓘ</summary>
                <div class="card position-absolute p-2 shadow-sm" style="width:min(20rem,80vw);z-index:10;">Choose a circulating book and submit a reservation. Students reserve for themselves; staff select an eligible learner. Pending reservations expire after seven days and are fulfilled in queue order.</div>
            </details>
        </div>
        <a asp-controller="Library" asp-action="Index" class="btn btn-outline-secondary">Back to catalog</a>
    </header>
    <div id="reservationAlert" class="d-none" role="alert" tabindex="-1"></div>
    <section class="card mb-3">
        <div class="card-header"><h3 class="h6 mb-0">Find and reserve a book</h3></div>
        <div class="card-body">
            <form id="reservationSearch" class="row g-2 mb-3">
                <div class="col-md-9"><label for="reservationQuery" class="form-label">Book title, author or ISBN</label><input id="reservationQuery" class="form-control" maxlength="150" autocomplete="off" /></div>
                <div class="col-md-3 d-flex align-items-end"><button type="submit" class="btn btn-outline-primary w-100">Search books</button></div>
            </form>
            @if (canManage) {
                <form id="reservationStudentSearchForm" class="row g-2 mb-2">
                    <div class="col-md-7"><label for="reservationStudentSearch" class="form-label">Find active student by name or code</label><input id="reservationStudentSearch" type="search" class="form-control" maxlength="100" minlength="2" autocomplete="off" placeholder="First letters of name or student code" /></div>
                    <div class="col-md-3 d-flex align-items-end"><button type="submit" class="btn btn-outline-secondary w-100">Find students</button></div>
                    <div class="col-md-2 d-flex align-items-end"><button id="reservationStudentMore" type="button" class="btn btn-outline-secondary w-100" hidden>More</button></div>
                </form>
                <p id="reservationStudentStatus" class="small text-muted" role="status" aria-live="polite"></p>
            }
            <form id="reservationCreate" class="row g-2 align-items-end">
                <div class="col-md-@(canManage ? "5" : "9")"><label for="reservationBook" class="form-label">Book *</label><select id="reservationBook" class="form-select" required><option value="">Select a book</option></select></div>
                @if (canManage) {
                    <div class="col-md-4"><label for="reservationStudent" class="form-label">Student</label><select id="reservationStudent" class="form-select"><option value="">My linked student account</option></select></div>
                }
                <div class="col-md-3"><button id="reservationCreateButton" type="submit" class="btn btn-primary w-100">Reserve book</button></div>
            </form>
        </div>
    </section>
    <section class="card mb-3">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2"><h3 class="h6 mb-0">My reservations</h3>
            <div class="d-flex align-items-center gap-2">
                <label for="reservationMineStatus" class="visually-hidden">Reservation status</label>
                <select id="reservationMineStatus" class="form-select form-select-sm" aria-label="Filter my reservations">
                    <option value="all">All</option><option value="pending">Pending</option>
                    <option value="fulfilled">Fulfilled</option><option value="cancelled">Cancelled</option>
                    <option value="expired">Expired</option>
                </select>
                @if (canExportMine) { <button id="reservationMineCsv" type="button" class="btn btn-outline-secondary btn-sm">CSV (current page)</button> }
                <button id="reservationMineRefresh" type="button" class="btn btn-outline-primary btn-sm">Refresh</button>
            </div>
        </div>
        <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead><tr><th>Book</th><th>Reserved</th><th>Expires</th><th>Status</th><th>Action</th></tr></thead><tbody id="reservationMineRows"><tr><td colspan="5">Loading…</td></tr></tbody></table></div>
        <div class="card-footer d-flex justify-content-end align-items-center gap-2"><button id="reservationMinePrevious" class="btn btn-outline-secondary btn-sm" type="button">Previous</button><span id="reservationMinePage"></span><button id="reservationMineNext" class="btn btn-outline-secondary btn-sm" type="button">Next</button></div>
    </section>
    @if (canManage) {
        <section class="card">
            <div class="card-header d-flex justify-content-between align-items-center"><h3 class="h6 mb-0">Active queue for selected book</h3><button id="reservationQueueRefresh" type="button" class="btn btn-outline-primary btn-sm">Refresh</button></div>
            <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead><tr><th>Student</th><th>Reserved</th><th>Expires</th><th>Copy</th><th>Action</th></tr></thead><tbody id="reservationQueueRows"><tr><td colspan="5">Select a book to view its queue.</td></tr></tbody></table></div>
            <div class="card-footer d-flex justify-content-end align-items-center gap-2"><button id="reservationQueuePrevious" class="btn btn-outline-secondary btn-sm" type="button">Previous</button><span id="reservationQueuePage"></span><button id="reservationQueueNext" class="btn btn-outline-secondary btn-sm" type="button">Next</button></div>
        </section>
    }
</section>
@section Scripts { <script src="~/js/library/reservations.js" asp-append-version="true"></script> }
