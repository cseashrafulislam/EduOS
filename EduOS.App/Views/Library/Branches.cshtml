@{
    ViewData["Title"] = "Library Branch Administration";
}
<section class="container-fluid py-3" id="libraryBranchApp">
    <header class="d-flex justify-content-between align-items-center mb-3">
        <div><h2 class="h4 mb-1">Library branches</h2><p class="text-muted mb-0">Configure campus-specific library locations and assign books to branches.</p></div>
        <a asp-controller="Library" asp-action="Index" class="btn btn-outline-secondary">Back to library</a>
    </header>
    <div id="branchAlert" role="alert" tabindex="-1" class="d-none"></div>
    <section class="card mb-3">
        <div class="card-header"><h3 class="h6 m-0">Create or update branch</h3></div>
        <form id="branchForm" class="card-body row g-3">
            <input id="branchId" type="hidden" /><input id="branchVersion" type="hidden" />
            <div class="col-md-4"><label for="branchCampus" class="form-label">Campus *</label><select id="branchCampus" class="form-select" required><option value="">Loading campuses…</option></select></div>
            <div class="col-md-4"><label for="branchName" class="form-label">Branch name *</label><input id="branchName" class="form-control" maxlength="150" required /></div>
            <div class="col-md-4"><label for="branchCode" class="form-label">Code *</label><input id="branchCode" class="form-control" maxlength="50" required /></div>
            <div class="col-md-8"><label for="branchLocation" class="form-label">Location</label><input id="branchLocation" class="form-control" maxlength="500" /></div>
            <div class="col-md-4 d-flex align-items-end gap-3"><label><input id="branchActive" type="checkbox" checked /> Active</label><button id="branchSave" type="submit" class="btn btn-primary">Save</button><button id="branchReset" type="button" class="btn btn-outline-secondary">Clear</button></div>
        </form>
    </section>
    <section class="card">
        <div class="card-header d-flex justify-content-between align-items-center"><h3 class="h6 m-0">Configured branches</h3><button id="branchRefresh" type="button" class="btn btn-sm btn-outline-primary">Refresh</button></div>
        <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead><tr><th>Campus</th><th>Branch</th><th>Code</th><th>Location</th><th>Status</th><th>Action</th></tr></thead><tbody id="branchRows"><tr><td colspan="6" class="text-muted text-center p-3">Loading…</td></tr></tbody></table></div>
    </section>
</section>
@section Scripts { <script src="~/js/library/branches.js" asp-append-version="true"></script> }