@{
    ViewData["Title"] = "AccessDeniedTitle";
    Layout = "_PublicLayout";
}

<section class="error-card error-card-warning" aria-labelledby="errorTitle">
    <div class="error-code" aria-hidden="true">403</div>
    <h1 id="errorTitle">@T["AccessDeniedTitle"]</h1>
    <p>@T["AccessDeniedMessage"]</p>
    <a href="/" class="btn btn-warning auth-primary-action mt-4 px-4">@T["BackToDashboard"]</a>
</section>
