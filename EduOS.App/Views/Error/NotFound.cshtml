@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <title>Page Not Found</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>

        body {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f8fafc;
            font-family: Segoe UI;
        }

        .error-box {
            text-align: center;
        }

        .error-code {
            font-size: 90px;
            font-weight: 800;
            color: #1d4ed8;
        }

    </style>

</head>

<body>

    <div class="error-box">

        <div class="error-code">404</div>

        <h3>Page Not Found</h3>

        <p>
            The page you are looking for does not exist.
        </p>

        <a href="/" class="btn btn-primary mt-3">
            Back to Dashboard
        </a>

    </div>

</body>
</html>