@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Server Error</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>

        body {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(120deg,#1d4ed8,#06b6d4);
            color: white;
            font-family: Segoe UI;
        }

        .error-box {
            text-align: center;
            max-width: 500px;
        }

        .error-code {
            font-size: 90px;
            font-weight: 800;
        }

    </style>
</head>

<body>

    <div class="error-box">

        <div class="error-code">500</div>

        <h3>Server Error</h3>

        <p>
            Something went wrong in the system.
            Please try again later.
        </p>

        <a href="/" class="btn btn-light mt-3">
            Back to Dashboard
        </a>

    </div>

</body>
</html>