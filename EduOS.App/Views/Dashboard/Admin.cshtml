@{
    ViewData["Title"] = "AdminDashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-page platform-dashboard">
    <section class="dashboard-hero platform-dashboard-hero" aria-labelledby="platformTitle">
        <div class="dashboard-hero-copy">
            <p class="dashboard-eyebrow">@T["SuperAdminWorkspace"]</p>
            <h2 id="platformTitle">@T["PlatformControlCenter"]</h2>
            <p>@T["PlatformControlCenterHelp"]</p>
            <div class="dashboard-badges">
                <span class="status-chip status-chip-neutral">@T["RestrictedAccess"]</span>
                <span class="status-chip status-chip-success">@T["AuthenticatedSession"]</span>
            </div>
        </div>
        <div class="dashboard-progress-card platform-safety-card">
            <span class="dashboard-stat-icon dashboard-stat-icon-green" aria-hidden="true">
                <svg class="edu-icon"><use href="/images/eduos-icons.svg#shield" /></svg>
            </span>
            <div>
                <strong>@T["PlatformSafetyTitle"]</strong>
                <p>@T["PlatformSafetyHelp"]</p>
            </div>
        </div>
    </section>

    <section aria-labelledby="adminToolsTitle">
        <div class="dashboard-section-heading">
            <div>
                <p class="dashboard-eyebrow">@T["AvailableNow"]</p>
                <h2 id="adminToolsTitle">@T["PlatformTools"]</h2>
            </div>
        </div>
        <div class="platform-tools-grid">
            <article class="dashboard-panel platform-tool-card">
                <span class="dashboard-stat-icon" aria-hidden="true">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#finance" /></svg>
                </span>
                <h3>@T["PricingCatalog"]</h3>
                <p>@T["PricingCatalogHelp"]</p>
                <a asp-controller="Pricing" asp-action="Index">@T["ReviewPublicPricing"]</a>
            </article>
            <article class="dashboard-panel platform-tool-card">
                <span class="dashboard-stat-icon dashboard-stat-icon-violet" aria-hidden="true">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#dashboard" /></svg>
                </span>
                <h3>@T["BackgroundJobs"]</h3>
                <p>@T["BackgroundJobsHelp"]</p>
                <a href="/hangfire">@T["OpenJobDashboard"]</a>
            </article>
            <article class="dashboard-panel platform-tool-card">
                <span class="dashboard-stat-icon dashboard-stat-icon-green" aria-hidden="true">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#attendance" /></svg>
                </span>
                <h3>@T["ServiceHealth"]</h3>
                <p>@T["ServiceHealthHelp"]</p>
                <a href="/health">@T["CheckServiceHealth"]</a>
            </article>
        </div>
    </section>

    <section class="dashboard-panel platform-guidance" aria-labelledby="platformGuidanceTitle">
        <div class="dashboard-section-heading">
            <div>
                <p class="dashboard-eyebrow">@T["OperatingRule"]</p>
                <h2 id="platformGuidanceTitle">@T["TenantPrivacyBoundary"]</h2>
            </div>
        </div>
        <p>@T["TenantPrivacyBoundaryHelp"]</p>
    </section>
</div>
