@model EduOS.Core.DTOs.Dashboard.PlatformDashboardVm
@{
    var isBangla = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
    ViewData["Title"] = isBangla ? "প্ল্যাটফর্ম পরিচালনা" : "Platform Operations";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string StatusLabel(string value)
    {
        if (!isBangla) return value;
        return value switch
        {
            "PendingVerification" => "যাচাই বাকি", "Active" => "সক্রিয়",
            "Suspended" => "স্থগিত", "Closed" => "বন্ধ",
            "EmailVerification" => "ইমেইল যাচাই", "InstitutionProfile" => "প্রতিষ্ঠানের তথ্য",
            "PlanSelection" => "প্ল্যান নির্বাচন", "Payment" => "পেমেন্ট",
            "CampusSetup" => "ক্যাম্পাস সেটআপ", "AcademicSetup" => "একাডেমিক সেটআপ",
            "ModuleSetup" => "মডিউল সেটআপ", "BrandingSetup" => "ব্র্যান্ডিং",
            "GeneralSettings" => "সাধারণ সেটিংস", "GatewaySetup" => "গেটওয়ে সেটআপ",
            "Completed" => "সম্পূর্ণ", "Trial" => "ট্রায়াল", "Grace" => "গ্রেস পিরিয়ড",
            "Cancelled" => "বাতিল", "Expired" => "মেয়াদ শেষ",
            "PendingPayment" => "পেমেন্ট বাকি", _ => value
        };
    }
}
<div class="dashboard-page platform-dashboard gap-3" id="platformDashboard">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 small text-muted">
        <span>@(isBangla ? "প্রতিষ্ঠান, সাবস্ক্রিপশন ও পেমেন্ট পর্যালোচনা" : "Institution, subscription and payment oversight")</span>
        <span>@(isBangla ? "তথ্য হালনাগাদ (UTC)" : "Updated (UTC)"):
            <time datetime="@Model.GeneratedAtUtc.ToString("O")">@Model.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm")</time>
        </span>
    </div>
    <section aria-label="@(isBangla ? "প্ল্যাটফর্মের সারসংক্ষেপ" : "Platform summary")">
        <div class="dashboard-stats-grid">
            <article class="dashboard-stat-card"><div><p>@(isBangla ? "মোট প্রতিষ্ঠান" : "Total institutions")</p><strong>@Model.TotalTenants</strong></div></article>
            <article class="dashboard-stat-card"><div><p>@(isBangla ? "সক্রিয় প্রতিষ্ঠান" : "Active institutions")</p><strong>@Model.ActiveTenants</strong></div></article>
            <article class="dashboard-stat-card"><div><p>@(isBangla ? "ইমেইল যাচাই বাকি" : "Email verification pending")</p><strong>@Model.PendingVerificationTenants</strong></div></article>
            <article class="dashboard-stat-card"><div><p>@(isBangla ? "অনবোর্ডিং অসম্পূর্ণ" : "Onboarding incomplete")</p><strong>@Model.IncompleteOnboardingTenants</strong></div></article>
            <article class="dashboard-stat-card"><div><p>@(isBangla ? "নতুন প্রতিষ্ঠান (৩০ দিন)" : "New institutions (30 days)")</p><strong>@Model.NewTenantsLast30Days</strong></div></article>
            <article class="dashboard-stat-card"><div><p>@(isBangla ? "মেয়াদ শেষ হবে (৭ দিন)" : "Expiring (7 days)")</p><strong>@Model.SubscriptionsExpiringNext7Days</strong></div></article>
            <article class="dashboard-stat-card"><div><p>@(isBangla ? "মেয়াদোত্তীর্ণ সাবস্ক্রিপশন" : "Overdue subscriptions")</p><strong>@Model.OverdueActiveSubscriptions</strong></div></article>
            <article class="dashboard-stat-card"><div><p>@(isBangla ? "পেমেন্ট যাচাই বাকি" : "Payments awaiting review")</p><strong>@(Model.PendingManualPayments.HasValue ? Model.PendingManualPayments.Value.ToString() : "—")</strong></div></article>
        </div>
    </section>
    <section aria-labelledby="platformActionsTitle">
        <div class="dashboard-section-heading mb-2"><h2 id="platformActionsTitle">@(isBangla ? "দ্রুত কাজ" : "Quick actions")</h2></div>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-2">
            <div class="col"><article class="dashboard-panel platform-tool-card h-100">
                <h3>@(isBangla ? "প্রতিষ্ঠান" : "Institutions")</h3>
                <a asp-controller="PlatformTenants" asp-action="Index">@(isBangla ? "প্রতিষ্ঠান পরিচালনা" : "Manage institutions")</a>
            </article></div>
            <div class="col"><article class="dashboard-panel platform-tool-card h-100">
                <h3>@(isBangla ? "পেমেন্ট যাচাই" : "Payment verification")</h3>
                <a asp-controller="Account" asp-action="PaymentVerification">@(isBangla ? "যাচাইয়ের তালিকা" : "Review payments")</a>
            </article></div>
            <div class="col"><article class="dashboard-panel platform-tool-card h-100">
                <h3>@(isBangla ? "সাবস্ক্রিপশন" : "Subscriptions")</h3>
                <a asp-controller="SubscriptionPaymentHistory" asp-action="Index">@(isBangla ? "পেমেন্টের ইতিহাস" : "Payment history")</a>
            </article></div>
            <div class="col"><article class="dashboard-panel platform-tool-card h-100">
                <h3>@(isBangla ? "প্ল্যান" : "Plans")</h3>
                <a asp-controller="SubscriptionPlanAdministration" asp-action="Index">@(isBangla ? "প্ল্যান পরিচালনা" : "Manage plans")</a>
            </article></div>
        </div>
    </section>
    <div class="dashboard-main-grid">
        <section class="dashboard-panel" aria-labelledby="recentTenantsTitle">
            <div class="dashboard-section-heading"><h2 id="recentTenantsTitle">@(isBangla ? "সাম্প্রতিক প্রতিষ্ঠান" : "Recently registered institutions")</h2></div>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <caption class="visually-hidden">@(isBangla ? "সর্বশেষ নিবন্ধিত আটটি প্রতিষ্ঠান" : "Eight most recently registered institutions")</caption>
                    <thead><tr>
                        <th scope="col">@(isBangla ? "প্রতিষ্ঠান" : "Institution")</th>
                        <th scope="col">@(isBangla ? "অবস্থা" : "State")</th>
                        <th scope="col">@(isBangla ? "অনবোর্ডিং" : "Onboarding")</th>
                        <th scope="col">@(isBangla ? "নিবন্ধনের তারিখ" : "Created (UTC)")</th>
                    </tr></thead>
                    <tbody>
                    @if (Model.RecentTenants.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-muted py-3">@(isBangla ? "কোনো প্রতিষ্ঠান পাওয়া যায়নি" : "No institutions found")</td></tr>
                    }
                    else
                    {
                        @foreach (var tenant in Model.RecentTenants)
                        {
                            <tr>
                                <td>@tenant.Name</td>
                                <td>@StatusLabel(tenant.State)</td>
                                <td>@StatusLabel(tenant.OnboardingStage)</td>
                                <td><time datetime="@tenant.CreatedAt.ToString("O")">@tenant.CreatedAt.ToString("yyyy-MM-dd")</time></td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </section>
        <section class="dashboard-panel" aria-labelledby="expiringTitle">
            <div class="dashboard-section-heading"><h2 id="expiringTitle">@(isBangla ? "শিগগির মেয়াদ শেষ হবে" : "Subscriptions expiring soon")</h2></div>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <caption class="visually-hidden">@(isBangla ? "আসন্ন মেয়াদোত্তীর্ণ সাবস্ক্রিপশন" : "Upcoming subscription expirations")</caption>
                    <thead><tr>
                        <th scope="col">@(isBangla ? "প্রতিষ্ঠান" : "Institution")</th>
                        <th scope="col">@(isBangla ? "অবস্থা" : "State")</th>
                        <th scope="col">@(isBangla ? "শেষ তারিখ (UTC)" : "Ends (UTC)")</th>
                    </tr></thead>
                    <tbody>
                    @if (Model.UpcomingExpirations.Count == 0)
                    {
                        <tr><td colspan="3" class="text-center text-muted py-3">@(isBangla ? "আসন্ন মেয়াদোত্তীর্ণ সাবস্ক্রিপশন নেই" : "No upcoming expirations")</td></tr>
                    }
                    else
                    {
                        @foreach (var subscription in Model.UpcomingExpirations)
                        {
                            <tr>
                                <td>@subscription.TenantName</td>
                                <td>@StatusLabel(subscription.SubscriptionState)</td>
                                <td><time datetime="@subscription.EndsAtUtc.ToString("O")">@subscription.EndsAtUtc.ToString("yyyy-MM-dd")</time></td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
