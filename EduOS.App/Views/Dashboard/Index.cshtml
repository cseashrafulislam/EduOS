@model EduOS.Core.DTOs.Dashboard.DashboardVm
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var culture = CultureInfo.CurrentCulture;
    var useBangla = CultureInfo.CurrentUICulture.Name.StartsWith(
        "bn", StringComparison.OrdinalIgnoreCase);
    var progress = Math.Clamp(Model.OnboardingPercent, 0, 100);
    var studentUsage = Model.MaxStudents > 0
        ? Math.Clamp((int)Math.Round((double)Model.CurrentStudents / Model.MaxStudents * 100), 0, 100)
        : 0;
    var teacherUsage = Model.MaxTeachers > 0
        ? Math.Clamp((int)Math.Round((double)Model.CurrentTeachers / Model.MaxTeachers * 100), 0, 100)
        : 0;
    var planName = useBangla && !string.IsNullOrWhiteSpace(Model.PlanNameBangla)
        ? Model.PlanNameBangla
        : Model.PlanName;
    if (string.IsNullOrWhiteSpace(Model.PlanCode))
        planName = T["NoPlan"];

    var onboardingSteps = new[]
    {
        (Step: 0, Key: "EmailVerification", Controller: "Account", Action: "VerifyEmail"),
        (Step: 1, Key: "InstitutionProfile", Controller: "Account", Action: "InstitutionProfile"),
        (Step: 2, Key: "PlanSelection", Controller: "Account", Action: "PlanSelection"),
        (Step: 3, Key: "Payment", Controller: "Account", Action: "PlanSelection"),
        (Step: 4, Key: "CampusSetup", Controller: "Account", Action: "CampusSetup"),
        (Step: 5, Key: "AcademicSetup", Controller: "Account", Action: "AcademicSetup"),
        (Step: 6, Key: "BrandingSetup", Controller: "Account", Action: "BrandingSetup"),
        (Step: 7, Key: "GeneralSettings", Controller: "Account", Action: "GeneralSettings"),
        (Step: 8, Key: "GatewaySetup", Controller: "Account", Action: "GatewaySetup")
    };
    var currentStep = onboardingSteps.FirstOrDefault(x => x.Step == Model.OnboardingStep);
    var currentStepLabel = Model.OnboardingComplete
        ? T["Completed"].Value
        : T[$"Onboarding_{currentStep.Key ?? "EmailVerification"}_Name"].Value;

    string Number(int value) => value.ToString("N0", culture);
    string Format(string key, params object[] values) =>
        string.Format(culture, T[key].Value, values);
    string SafeAlertType(string? type) => type?.ToLowerInvariant() switch
    {
        "success" => "success",
        "warning" => "warning",
        "danger" => "danger",
        _ => "info"
    };
    string? SafeLocalUrl(string? url) =>
        !string.IsNullOrWhiteSpace(url)
        && url.StartsWith("/", StringComparison.Ordinal)
        && !url.StartsWith("//", StringComparison.Ordinal)
            ? url
            : null;
    string AlertMessage(EduOS.Core.DTOs.Dashboard.DashboardAlert alert) => alert.Code switch
    {
        "EMAIL_UNVERIFIED" => T["AlertEmailUnverified"],
        "ONBOARDING_INCOMPLETE" => T["AlertOnboardingIncomplete"],
        "SUBSCRIPTION_MISSING" => T["AlertSubscriptionMissing"],
        "TRIAL_EXPIRED" => T["AlertTrialExpired"],
        "TRIAL_EXPIRING" => Format("AlertTrialExpiring", alert.Days ?? 0),
        "TRIAL_ENDING" => Format("AlertTrialEnding", alert.Days ?? 0),
        "SUBSCRIPTION_EXPIRING" => Format("AlertSubscriptionExpiring", alert.Days ?? 0),
        "SUBSCRIPTION_EXPIRED" => T["AlertSubscriptionExpired"],
        "PAYMENT_PENDING" => T["AlertPaymentPending"],
        "STUDENT_LIMIT_REACHED" => Format(
            "AlertStudentLimitReached", Number(alert.CurrentValue ?? 0), Number(alert.LimitValue ?? 0)),
        "STUDENT_LIMIT_WARNING" => Format(
            "AlertStudentLimitWarning", Number(alert.Percentage ?? 0),
            Number(alert.CurrentValue ?? 0), Number(alert.LimitValue ?? 0)),
        _ => alert.Message
    };
    string AlertAction(EduOS.Core.DTOs.Dashboard.DashboardAlert alert) => alert.ActionCode switch
    {
        "VERIFY_EMAIL" => T["VerifyEmailAction"],
        "CONTINUE_SETUP" => T["ContinueSetup"],
        "CHOOSE_PLAN" => T["ChoosePlan"],
        "UPGRADE_NOW" => T["UpgradeNow"],
        "VIEW_PLANS" => T["ViewPlans"],
        "RENEW_NOW" => T["RenewNow"],
        "RENEW_SUBSCRIPTION" => T["RenewSubscription"],
        "VIEW_PAYMENT_STATUS" => T["ViewPaymentStatus"],
        "UPGRADE_PLAN" => T["UpgradePlan"],
        _ => alert.ActionLabel ?? T["Open"]
    };
    string SubscriptionStatusLabel(string? status) => status?.ToUpperInvariant() switch
    {
        "ACTIVE" => T["StatusActive"],
        "TRIALING" => T["StatusTrial"],
        "PENDINGPAYMENT" => T["StatusPendingPayment"],
        "PASTDUE" => T["StatusPastDue"],
        "EXPIRED" => T["StatusExpired"],
        "CANCELATPERIODEND" => T["StatusCancelAtPeriodEnd"],
        "CANCELLED" => T["StatusCancelled"],
        "SUSPENDED" => T["StatusSuspended"],
        _ => T["StatusUnavailable"]
    };
}

<div class="dashboard-page">
    <section class="dashboard-hero" aria-labelledby="dashboardWelcome">
        <div class="dashboard-hero-copy">
            <p class="dashboard-eyebrow">@T["SaasControlCenter"]</p>
            <h2 id="dashboardWelcome">@Model.InstitutionName</h2>
            <p class="dashboard-institution-meta">
                <span>@(string.IsNullOrWhiteSpace(Model.InstitutionType) ? T["NotAvailable"] : Model.InstitutionType)</span>
                <span aria-hidden="true">•</span>
                <span>@T["Owner"]: @(string.IsNullOrWhiteSpace(Model.OwnerName) ? T["NotAvailable"] : Model.OwnerName)</span>
            </p>
            <div class="dashboard-badges" aria-label="@T["AccountStatus"]">
                <span class="status-chip status-chip-neutral">@T["Plan"]: @planName</span>
                <span class="status-chip @(Model.EmailVerified ? "status-chip-success" : "status-chip-warning")">
                    @(Model.EmailVerified ? T["EmailVerifiedStatus"] : T["EmailPendingStatus"])
                </span>
                <span class="status-chip @(Model.OnboardingComplete ? "status-chip-success" : "status-chip-info")">
                    @(Model.OnboardingComplete ? T["SetupCompleteStatus"] : T["SetupInProgressStatus"])
                </span>
            </div>
        </div>

        <div class="dashboard-progress-card">
            <div class="dashboard-progress-heading">
                <span>@T["OnboardingProgress"]</span>
                <strong>@progress%</strong>
            </div>
            <progress class="dashboard-progress" max="100" value="@progress">@progress%</progress>
            <dl class="dashboard-progress-meta">
                <div>
                    <dt>@T["CurrentStep"]</dt>
                    <dd>@currentStepLabel</dd>
                </div>
                <div>
                    <dt>@T["TrialEnds"]</dt>
                    <dd>@(Model.TrialEndDate?.ToString("d", culture) ?? T["NotAvailable"])</dd>
                </div>
            </dl>
        </div>
    </section>

    @if (Model.Alerts.Count > 0)
    {
        <section class="dashboard-alerts" aria-labelledby="attentionTitle">
            <h2 id="attentionTitle" class="visually-hidden">@T["NeedsAttention"]</h2>
            @foreach (var alert in Model.Alerts)
            {
                var actionUrl = SafeLocalUrl(alert.ActionUrl);
                <div class="dashboard-alert dashboard-alert-@SafeAlertType(alert.Type)" role="status">
                    <span class="dashboard-alert-dot" aria-hidden="true"></span>
                    <p>@AlertMessage(alert)</p>
                    @if (actionUrl != null)
                    {
                        <a href="@actionUrl">@AlertAction(alert)</a>
                    }
                </div>
            }
        </section>
    }

    <section aria-labelledby="overviewTitle">
        <div class="dashboard-section-heading">
            <div>
                <p class="dashboard-eyebrow">@T["LiveOverview"]</p>
                <h2 id="overviewTitle">@T["InstitutionOverview"]</h2>
            </div>
        </div>

        <div class="dashboard-stats-grid">
            <article class="dashboard-stat-card">
                <span class="dashboard-stat-icon" aria-hidden="true">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#students" /></svg>
                </span>
                <div>
                    <p>@T["CurrentStudents"]</p>
                    <strong>@Number(Model.CurrentStudents)</strong>
                    <span>@(Model.MaxStudents > 0 ? Format("OfPlanLimit", Number(Model.MaxStudents)) : T["NoConfiguredLimit"])</span>
                </div>
            </article>
            <article class="dashboard-stat-card">
                <span class="dashboard-stat-icon dashboard-stat-icon-green" aria-hidden="true">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#teacher" /></svg>
                </span>
                <div>
                    <p>@T["CurrentTeachers"]</p>
                    <strong>@Number(Model.CurrentTeachers)</strong>
                    <span>@(Model.MaxTeachers > 0 ? Format("OfPlanLimit", Number(Model.MaxTeachers)) : T["NoConfiguredLimit"])</span>
                </div>
            </article>
            <article class="dashboard-stat-card">
                <span class="dashboard-stat-icon dashboard-stat-icon-amber" aria-hidden="true">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#campus" /></svg>
                </span>
                <div>
                    <p>@T["CampusCapacity"]</p>
                    <strong>@Number(Model.MaxCampuses)</strong>
                    <span>@T["IncludedInPlan"]</span>
                </div>
            </article>
            <article class="dashboard-stat-card">
                <span class="dashboard-stat-icon dashboard-stat-icon-violet" aria-hidden="true">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#dashboard" /></svg>
                </span>
                <div>
                    <p>@T["ActiveFeatures"]</p>
                    <strong>@Number(Model.ActiveFeatures)</strong>
                    <span>@T["EnabledByPlan"]</span>
                </div>
            </article>
        </div>
    </section>

    <div class="dashboard-main-grid">
        <section class="dashboard-panel" aria-labelledby="capacityTitle">
            <div class="dashboard-section-heading">
                <div>
                    <p class="dashboard-eyebrow">@T["PlanUsage"]</p>
                    <h2 id="capacityTitle">@T["CapacityUsage"]</h2>
                </div>
                <a asp-controller="Account" asp-action="PlanSelection" class="dashboard-text-link">@T["ManagePlan"]</a>
            </div>

            <div class="capacity-list">
                <div class="capacity-item">
                    <div class="capacity-copy">
                        <span>@T["Students"]</span>
                        <strong>@(Model.MaxStudents > 0
                            ? Format("UsageCount", Number(Model.CurrentStudents), Number(Model.MaxStudents))
                            : Number(Model.CurrentStudents))</strong>
                    </div>
                    @if (Model.MaxStudents > 0)
                    {
                        <progress max="100" value="@studentUsage" aria-label="@T["StudentCapacity"]">@studentUsage%</progress>
                    }
                </div>
                <div class="capacity-item">
                    <div class="capacity-copy">
                        <span>@T["Teachers"]</span>
                        <strong>@(Model.MaxTeachers > 0
                            ? Format("UsageCount", Number(Model.CurrentTeachers), Number(Model.MaxTeachers))
                            : Number(Model.CurrentTeachers))</strong>
                    </div>
                    @if (Model.MaxTeachers > 0)
                    {
                        <progress max="100" value="@teacherUsage" aria-label="@T["TeacherCapacity"]">@teacherUsage%</progress>
                    }
                </div>
            </div>

            <dl class="dashboard-details">
                <div><dt>@T["Institution"]</dt><dd>@Model.InstitutionName</dd></div>
                <div><dt>@T["InstitutionType"]</dt><dd>@(Model.InstitutionType ?? T["NotAvailable"])</dd></div>
                <div><dt>@T["SubscriptionStatus"]</dt><dd>@SubscriptionStatusLabel(Model.SubscriptionStatus)</dd></div>
                <div><dt>@T["SubscriptionEnds"]</dt><dd>@(Model.SubscriptionEndDate?.ToString("d", culture) ?? T["NotAvailable"])</dd></div>
            </dl>
        </section>

        <aside class="dashboard-side-stack">
            <section class="dashboard-panel" aria-labelledby="quickActionsTitle">
                <div class="dashboard-section-heading">
                    <h2 id="quickActionsTitle">@T["QuickActions"]</h2>
                </div>
                <nav class="dashboard-actions" aria-label="@T["QuickActions"]">
                    <a asp-controller="Account" asp-action="InstitutionProfile">@T["CompleteInstitutionProfile"]</a>
                    <a asp-controller="Account" asp-action="CampusSetup">@T["SetupCampus"]</a>
                    <a asp-controller="Account" asp-action="AcademicSetup">@T["SetupAcademicYear"]</a>
                    <a asp-controller="Account" asp-action="GeneralSettings">@T["ConfigurePreferences"]</a>
                    <a asp-controller="Account" asp-action="PlanSelection">@T["ManagePlan"]</a>
                </nav>
            </section>

            <section class="dashboard-panel" aria-labelledby="systemStatusTitle">
                <div class="dashboard-section-heading">
                    <h2 id="systemStatusTitle">@T["AccountStatus"]</h2>
                </div>
                <dl class="dashboard-status-list">
                    <div>
                        <dt>@T["EmailVerification"]</dt>
                        <dd class="@(Model.EmailVerified ? "text-success" : "text-warning-emphasis")">
                            @(Model.EmailVerified ? T["Completed"] : T["Pending"])
                        </dd>
                    </div>
                    <div><dt>@T["Subscription"]</dt><dd>@planName</dd></div>
                    <div><dt>@T["SetupProgress"]</dt><dd>@progress%</dd></div>
                </dl>
            </section>
        </aside>
    </div>

    <section class="dashboard-panel setup-checklist-panel" aria-labelledby="checklistTitle">
        <div class="dashboard-section-heading">
            <div>
                <p class="dashboard-eyebrow">@T["GuidedSetup"]</p>
                <h2 id="checklistTitle">@T["SetupChecklist"]</h2>
            </div>
        </div>
        <ol class="setup-checklist">
            @foreach (var item in onboardingSteps)
            {
                var isCompleted = Model.OnboardingComplete || Model.OnboardingStep > item.Step;
                var isCurrent = !Model.OnboardingComplete && Model.OnboardingStep == item.Step;
                <li class="@(isCompleted ? "completed" : isCurrent ? "current" : string.Empty)">
                    <span class="setup-step-marker" aria-hidden="true">@(isCompleted ? "✓" : (item.Step + 1).ToString(culture))</span>
                    <div>
                        <strong>@T[$"Onboarding_{item.Key}_Name"]</strong>
                        <span>@T[$"Onboarding_{item.Key}_Description"]</span>
                    </div>
                    <a asp-controller="@item.Controller" asp-action="@item.Action">
                        @(isCompleted ? T["Review"] : isCurrent ? T["Continue"] : T["Open"])
                    </a>
                </li>
            }
        </ol>
    </section>
</div>
