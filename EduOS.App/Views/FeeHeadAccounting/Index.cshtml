@using System.Globalization
@{
    var bn = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
    string L(string en, string bd) => bn ? bd : en;
    ViewData["Title"] = L("Fee Heads & Institutional GL Mapping", "ফি খাত ও GL হিসাব ম্যাপিং");
    var writable = User.IsInRole("TenantAdmin") || User.IsInRole("Principal");
}
<section class="container-fluid py-2" id="feeHeadAccounting" data-write="@writable.ToString().ToLowerInvariant()">
     @Html.AntiForgeryToken()
    <div id="feeHeadNotice" class="alert d-none" role="alert"></div>
    @if (writable)
    {
        <form id="feeHeadForm" class="card card-body mb-3">
            <h2 class="h6 mb-2">@L("Create / edit fee head", "ফি খাত তৈরি বা সংশোধন")</h2>
            <input id="feeHeadId" type="hidden" /><input id="feeHeadVersion" type="hidden" />
            <div class="row g-2 align-items-end">
                <input id="feeHeadCode" type="hidden" />
                <div class="col-md-5"><label class="form-label" for="feeHeadName">@L("Name", "নাম")</label><input id="feeHeadName" class="form-control" maxlength="100" required /></div>
                <div class="col-md-3"><label class="form-label" for="feeHeadFrequency">@L("Default frequency", "নির্ধারিত পুনরাবৃত্তি")</label>
                    <select id="feeHeadFrequency" class="form-select"><option value="1">@L("One-time", "একবার")</option><option value="2">@L("Monthly", "মাসিক")</option><option value="3">@L("Quarterly", "ত্রৈমাসিক")</option><option value="4">@L("Half-yearly", "ষাণ্মাসিক")</option><option value="5">@L("Yearly", "বার্ষিক")</option><option value="6">@L("Per term", "প্রতি টার্ম")</option></select>
                </div>
                <div class="col-md-2"><div class="form-check mb-2"><input id="feeHeadRefundable" type="checkbox" class="form-check-input" /><label for="feeHeadRefundable" class="form-check-label">@L("Refundable", "ফেরতযোগ্য")</label></div></div>
                <div class="col-md-2"><div class="form-check mb-2"><input id="feeHeadActive" type="checkbox" class="form-check-input" checked /><label for="feeHeadActive" class="form-check-label">@L("Active", "সক্রিয়")</label></div></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-2"><button class="btn btn-primary" type="submit">@L("Save fee head", "ফি খাত সংরক্ষণ")</button><button id="feeHeadReset" class="btn btn-outline-secondary" type="button">@L("New", "নতুন")</button></div>
        </form>
    }
    <div class="card card-body">
        <h2 class="h6 mb-2">@L("Account mapping register", "হিসাব ম্যাপিং তালিকা")</h2>
        <div class="table-responsive">
            <table class="table table-sm table-striped">
                <thead><tr><th>@L("Code", "কোড")</th><th>@L("Fee head", "ফি খাত")</th><th>@L("Frequency", "পুনরাবৃত্তি")</th><th>@L("Income ledger", "আয়ের হিসাব")</th><th>@L("Receivable ledger", "প্রাপ্য হিসাব")</th><th>@L("Mapping", "ম্যাপিং")</th><th>@L("Invoice history", "ইনভয়েস ইতিহাস")</th>@if(writable){<th>@L("Action", "কাজ")</th>}</tr></thead>
                <tbody id="feeHeadRows"></tbody>
            </table>
        </div>
        <p class="small text-muted">@L("Mapped means valid active BDT posting accounts. Posted journal integration is a separate release gate; mapping alone does not post entries.", "ম্যাপিং মানে সক্রিয় BDT পোস্টিং খাতা নির্বাচন। শুধু ম্যাপিং করলেই কোনো জার্নাল পোস্ট হয় না।")</p>
    </div>
</section>
@section Scripts {
    <script src="~/js/platform/form-guard.js" asp-append-version="true"></script>
    <script src="~/js/finance/fee-head-accounting.js" asp-append-version="true"></script>
}
