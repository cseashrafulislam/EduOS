@{
    ViewData["Title"] = "Fee Heads & Institutional GL Mapping";
    var writable = User.IsInRole("TenantAdmin") || User.IsInRole("Principal");
}
<section class="container-fluid py-2" id="feeHeadAccounting" data-write="@writable.ToString().ToLowerInvariant()">
     @Html.AntiForgeryToken()
    <div id="feeHeadNotice" class="alert d-none" role="alert"></div>
    @if (writable)
    {
        <form id="feeHeadForm" class="card card-body mb-3">
            <h2 class="h6 mb-2">Create / edit fee head</h2>
            <input id="feeHeadId" type="hidden" /><input id="feeHeadVersion" type="hidden" />
            <div class="row g-2 align-items-end">
                <input id="feeHeadCode" type="hidden" />
                <div class="col-md-5"><label class="form-label" for="feeHeadName">Name</label><input id="feeHeadName" class="form-control" maxlength="100" required /></div>
                <div class="col-md-3"><label class="form-label" for="feeHeadFrequency">Default frequency</label>
                    <select id="feeHeadFrequency" class="form-select"><option value="1">One-time</option><option value="2">Monthly</option><option value="3">Quarterly</option><option value="4">Half-yearly</option><option value="5">Yearly</option><option value="6">Per term</option></select>
                </div>
                <div class="col-md-2"><div class="form-check mb-2"><input id="feeHeadRefundable" type="checkbox" class="form-check-input" /><label for="feeHeadRefundable" class="form-check-label">Refundable</label></div></div>
                <div class="col-md-2"><div class="form-check mb-2"><input id="feeHeadActive" type="checkbox" class="form-check-input" checked /><label for="feeHeadActive" class="form-check-label">Active</label></div></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-2"><button class="btn btn-primary" type="submit">Save fee head</button><button id="feeHeadReset" class="btn btn-outline-secondary" type="button">New</button></div>
        </form>
    }
    <div class="card card-body">
        <h2 class="h6 mb-2">Account mapping register</h2>
        <div class="table-responsive">
            <table class="table table-sm table-striped">
                <thead><tr><th>Code</th><th>Fee head</th><th>Frequency</th><th>Income ledger</th><th>Receivable ledger</th><th>Mapping</th><th>Invoice history</th>@if(writable){<th>Action</th>}</tr></thead>
                <tbody id="feeHeadRows"></tbody>
            </table>
        </div>
        <p class="small text-muted">Mapped means valid active BDT posting accounts. Posted journal integration is a separate release gate; mapping alone does not post entries.</p>
    </div>
</section>
@section Scripts {
    <script src="~/js/platform/form-guard.js" asp-append-version="true"></script>
    <script src="~/js/finance/fee-head-accounting.js" asp-append-version="true"></script>
}
