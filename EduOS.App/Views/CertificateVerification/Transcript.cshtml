@{
    ViewData["Title"] = "Transcript verification";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    var reference = ViewData["Reference"]?.ToString() ?? "";
}
<section class="container py-4" id="transcriptVerification" data-reference="@reference">
    <header class="d-flex align-items-center gap-2 mb-3">
        <h1 class="h4 mb-0">Transcript verification / ট্রান্সক্রিপ্ট যাচাই</h1>
        <details class="ms-auto small">
            <summary class="btn btn-sm btn-outline-secondary" aria-label="Verification help / যাচাই সহায়তা">ⓘ</summary>
            <div class="border rounded p-2 mt-1" role="note">Only status is public; no learner identity, grades or marks are shown. / শুধু ট্রান্সক্রিপ্টের অবস্থা প্রকাশিত হয়।</div>
        </details>
    </header>
    <div class="card shadow-sm"><div class="card-body">
        <div id="transcriptVerificationStatus" class="alert alert-secondary" role="status" aria-live="polite">Checking transcript / ট্রান্সক্রিপ্ট যাচাই হচ্ছে…</div>
        <dl class="row mb-0">
            <dt class="col-sm-4">Issuing institute / প্রতিষ্ঠান</dt><dd class="col-sm-8" id="transcriptIssuer">—</dd>
            <dt class="col-sm-4">Transcript / ট্রান্সক্রিপ্ট নম্বর</dt><dd class="col-sm-8" id="transcriptNumber">—</dd>
            <dt class="col-sm-4">Issue date / ইস্যুর তারিখ</dt><dd class="col-sm-8" id="transcriptIssueDate">—</dd>
        </dl>
        <button type="button" id="transcriptVerifyAgain" class="btn btn-outline-primary mt-2">Recheck / আবার যাচাই</button>
    </div></div>
</section>
@section Scripts {
    <script src="~/js/public-credentials/transcript-verification.js" asp-append-version="true"></script>
}
