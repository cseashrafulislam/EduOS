@{ ViewData["Title"] = "Institution Invitation History"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<div id="invitationApp" class="container-fluid py-4">
    @Html.AntiForgeryToken()
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h2 class="h4 mb-1">Institution Invitations</h2><p class="text-muted mb-0">Review invitation status and revoke unused links. Only this institution's invitations are visible.</p></div>
        <a href="/TenantUsers/Index" class="btn btn-outline-secondary">Back to User Management</a>
    </div>
    <div id="invitationNotice" class="alert d-none" role="alert" aria-live="polite"></div>
    <div class="card border-0 shadow-sm"><div class="card-body">
        <div class="d-flex justify-content-end mb-3"><button id="refreshInvitations" type="button" class="btn btn-outline-primary btn-sm">Refresh</button></div>
        <div class="table-responsive"><table class="table table-striped table-sm align-middle">
            <thead><tr><th>Email</th><th>Initial role</th><th>Expires (local time)</th><th>Status</th><th>Action</th></tr></thead>
            <tbody id="invitationRows"><tr><td colspan="5">Loading...</td></tr></tbody>
        </table></div>
        <div class="d-flex justify-content-between align-items-center">
            <small id="invitationCount" class="text-muted"></small>
            <div><button id="prevInvitations" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
                <button id="nextInvitations" type="button" class="btn btn-outline-secondary btn-sm">Next</button></div>
        </div>
    </div></div>
</div>
@section Scripts { <script src="~/js/tenant-users/invitations.js" asp-append-version="true"></script> }
