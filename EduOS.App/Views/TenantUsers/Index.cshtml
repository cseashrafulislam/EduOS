@{
    var bn = System.Globalization.CultureInfo.CurrentUICulture.Name == "bn-BD";
    ViewData["Title"] = bn ? "ব্যবহারকারী ও ভূমিকা ব্যবস্থাপনা" : "User & Role Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid py-4" id="tenantUsersApp">
    @Html.AntiForgeryToken()
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="h4 fw-bold mb-1">@(bn ? "ব্যবহারকারী ও ভূমিকা ব্যবস্থাপনা" : "User & Role Management")</h2>
            <p class="text-muted mb-0">Manage only users and permissions belonging to this institution.</p>
        </div>
        <div class="d-flex gap-2"><a href="/TenantUsers/Invitations" class="btn btn-outline-primary">Invitation History</a><a href="/TenantPermissionOverrides/Index" class="btn btn-outline-primary">Permission Exceptions</a><a href="/Account/Profile" class="btn btn-outline-secondary">My Profile</a></div>
    </div>
    <div id="adminMessage" class="alert d-none" role="alert" aria-live="polite"></div>
    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item"><button id="tabUsers" class="nav-link active" type="button">Institution Users</button></li>
        <li class="nav-item"><button id="tabRoles" class="nav-link" type="button">Roles &amp; Permissions</button></li>
    </ul>
    <section id="usersSection">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <h5>Invite a user</h5>
                <p class="small text-muted">An email invitation lets the user choose a password or authenticate an existing account. No password is shared with administrators.</p>
                <form id="inviteUserForm" class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label" for="inviteEmail">Email address</label>
                        <input id="inviteEmail" class="form-control" type="email" maxlength="200" required autocomplete="off" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="inviteRole">Initial institution role (optional)</label>
                        <select id="inviteRole" class="form-select"></select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="inviteCampus">Initial campus (optional)</label>
                        <select id="inviteCampus" class="form-select" aria-label="Initial campus"><option value="">No campus (assign later)</option></select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-primary" type="submit">Send Invitation</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <form id="memberSearchForm" class="row g-2 mb-3">
                    <div class="col-md-8">
                        <label for="memberSearch" class="form-label">Search by name or email (starts with)</label>
                        <input type="search" class="form-control" id="memberSearch" maxlength="100" autocomplete="off" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary me-2">Search</button>
                        <button type="button" id="refreshUsers" class="btn btn-outline-secondary">Refresh</button>
                    </div>
                </form>
                <div class="table-responsive">
                    <table class="table table-hover align-middle" data-workspace-table="institution-users">
                        <thead><tr><th scope="col" data-table-column="user">User</th><th scope="col" data-table-column="membership">Membership</th><th scope="col" data-table-column="roles">Roles</th><th scope="col" data-table-column="action">Action</th></tr></thead>
                        <tbody id="tenantUsersBody"><tr><td colspan="4">Loading...</td></tr></tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <small id="memberCount" class="text-muted"></small>
                    <div>
                        <button id="prevMembers" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
                        <button id="nextMembers" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
                    </div>
                </div>
            </div>
        </div>
        <div id="memberEditor" class="card border-0 shadow-sm mt-3 d-none">
            <div class="card-body">
                <h5 id="memberEditorTitle"></h5>
                <p class="small text-muted">Changes revoke the selected user's old sessions. Ownership cannot be changed here.</p>
                <button id="memberHistoryButton" type="button" class="btn btn-outline-secondary btn-sm mb-3">@(bn ? "প্রবেশাধিকার পরিবর্তনের ইতিহাস" : "View access history")</button>
                <div id="memberHistoryPanel" class="border rounded p-3 mb-3 d-none">
                    <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-2"><h6 class="mb-0">@(bn ? "সদস্যের প্রবেশাধিকার পরিবর্তনের ইতিহাস" : "Member access history")</h6><button id="memberHistoryExport" type="button" class="btn btn-outline-primary btn-sm">@(bn ? "CSV ডাউনলোড" : "Export CSV")</button></div>
                    
                    <div class="table-responsive"><table class="table table-sm align-middle">
                        <thead><tr><th scope="col">@(bn ? "সময়" : "When")</th><th scope="col">@(bn ? "পরিবর্তন" : "Change")</th><th scope="col">@(bn ? "পরিবর্তনকারী" : "Actor")</th><th scope="col">@(bn ? "আগে" : "Previous")</th><th scope="col">@(bn ? "পরে" : "New")</th></tr></thead>
                        <tbody id="memberHistoryRows"></tbody>
                    </table></div>
                    <div class="d-flex justify-content-between align-items-center">
                        <small id="memberHistoryCount" class="text-muted"></small>
                        <div><button id="memberHistoryPrev" type="button" class="btn btn-outline-secondary btn-sm">@(bn ? "আগে" : "Previous")</button>
                        <button id="memberHistoryNext" type="button" class="btn btn-outline-secondary btn-sm">@(bn ? "পরে" : "Next")</button></div>
                    </div>
                </div>
                <div id="memberUnscopedIdentityRoleNotice" class="alert alert-warning d-none" role="status"></div>
                <form id="saveMemberRolesForm">
                    <div id="memberRoleOptions" class="row row-cols-1 row-cols-md-3 g-2 mb-3"></div>
                    <label id="memberUnscopedIdentityRoleApprovalLabel" class="form-check mb-3 d-none"><input id="memberUnscopedIdentityRoleApproval" class="form-check-input" type="checkbox" /><span class="form-check-label">I reviewed the existing global grants and approve removing them for this user's sole institution.</span></label>
                    <button id="saveMemberRoles" class="btn btn-primary" type="submit">Save roles</button>
                </form>
                <hr />
                <h6>Campus access</h6>
                <p class="small text-muted">Available campuses are always restricted to the selected institution.</p>
                <div id="memberCampusOptions" class="row g-2 mb-2"></div>
                <label for="memberDefaultCampus" class="form-label">Default campus</label>
                <select id="memberDefaultCampus" class="form-select mb-2" style="max-width:320px"></select>
                <button id="saveMemberCampuses" type="button" class="btn btn-outline-primary">Save campus access</button>
                <hr />
                <label for="memberStatusSelect" class="form-label">Membership status</label>
                <div class="d-flex gap-2 align-items-center">
                    <select id="memberStatusSelect" class="form-select" style="max-width:260px">
                        <option value="2">Active</option>
                        <option value="3">Suspended</option>
                        <option value="4">Left</option>
                    </select>
                    <button id="saveMemberStatus" type="button" class="btn btn-outline-danger">Update status</button>
                </div>
            </div>
        </div>
    </section>
    <section id="rolesSection" class="d-none">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <h5>Create institution role</h5>
                <form id="createTenantRoleForm" class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label" for="newRoleName">Role name</label>
                        <input id="newRoleName" class="form-control" maxlength="100" minlength="2" required />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label" for="newRoleDescription">Description</label>
                        <input id="newRoleDescription" class="form-control" maxlength="300" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-primary" type="submit">Create Role</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5>Permission assignment</h5>
                <p class="text-muted small">Permissions shown here are the current global permission catalogue; assignments remain institution scoped.</p>
                <div class="mb-3">
                    <label for="permissionRole" class="form-label">Institution role</label>
                    <select id="permissionRole" class="form-select"></select>
                </div>
                <div class="row g-2 align-items-end mb-3">
                    <div class="col-md-7">
                        <label for="editRoleDescription" class="form-label">Role description</label>
                        <input id="editRoleDescription" class="form-control" maxlength="300" />
                    </div>
                    <div class="col-md-2">
                        <label for="editRoleActive" class="form-label d-block">Role active</label>
                        <input id="editRoleActive" type="checkbox" class="form-check-input" />
                    </div>
                    <div class="col-md-3">
                        <button id="saveRoleSettings" type="button" class="btn btn-outline-secondary">Save role settings</button>
                    </div>
                </div>
                <form id="saveRolePermissionsForm">
                    <div id="permissionOptions" class="row g-2 mb-3"></div>
                    <button type="submit" class="btn btn-primary">Save permissions</button>
                </form>
            </div>
        </div>
    </section>
</div>
@section Scripts {
    <script src="~/js/tenant-users/index.js" asp-append-version="true"></script>
    <script src="~/js/platform/table-column-preferences.js" asp-append-version="true"></script>
}
