@{
    var bn = System.Globalization.CultureInfo.CurrentUICulture.Name == "bn-BD";
    ViewData["Title"] = bn ? "ব্যবহারকারী ও ভূমিকা ব্যবস্থাপনা" : "User & Role Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid py-2" id="tenantUsersApp" data-bangla="@(bn ? "true" : "false")">
    @Html.AntiForgeryToken()
    <div class="d-flex flex-wrap justify-content-end gap-2 mb-2">
        <a href="/TenantUsers/Invitations" class="btn btn-sm btn-outline-primary">@(bn ? "আমন্ত্রণ ইতিহাস" : "Invitation History")</a>
        <a href="/TenantPermissionOverrides/Index" class="btn btn-sm btn-outline-primary">@(bn ? "বিশেষ অনুমতি" : "Permission Exceptions")</a>
    </div>
    <div id="adminMessage" class="alert d-none" role="alert" aria-live="polite"></div>
    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item"><button id="tabUsers" class="nav-link active" type="button">@(bn ? "প্রতিষ্ঠানের ব্যবহারকারী" : "Institution Users")</button></li>
        <li class="nav-item"><button id="tabRoles" class="nav-link" type="button">@(bn ? "ভূমিকা ও অনুমতি" : "Roles &amp; Permissions")</button></li>
    </ul>
    <section id="usersSection">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <h5>@(bn ? "ব্যবহারকারীকে আমন্ত্রণ" : "Invite a user")</h5>
                <p class="small text-muted">@(bn ? "ইমেইল আমন্ত্রণে ব্যবহারকারী নিজেই পাসওয়ার্ড নির্ধারণ করবেন বা নিজের বিদ্যমান অ্যাকাউন্টে ঢুকবেন। প্রশাসক কোনো পাসওয়ার্ড জানতে পারবেন না।" : "An email invitation lets the user choose a password or authenticate an existing account. No password is shared with administrators.")</p>
                <form id="inviteUserForm" class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label" for="inviteEmail">@(bn ? "ইমেইল ঠিকানা" : "Email address")</label>
                        <input id="inviteEmail" class="form-control" type="email" maxlength="200" required autocomplete="off" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="inviteRole">@(bn ? "প্রাথমিক ভূমিকা (ঐচ্ছিক)" : "Initial institution role (optional)")</label>
                        <select id="inviteRole" class="form-select"></select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="inviteCampus">@(bn ? "প্রাথমিক ক্যাম্পাস (ঐচ্ছিক)" : "Initial campus (optional)")</label>
                        <select id="inviteCampus" class="form-select" aria-label="@(bn ? "প্রাথমিক ক্যাম্পাস" : "Initial campus")"><option value="">@(bn ? "ক্যাম্পাস পরে দিন" : "No campus (assign later)")</option></select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-primary" type="submit">@(bn ? "আমন্ত্রণ পাঠান" : "Send Invitation")</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <form id="memberSearchForm" class="row g-2 mb-3">
                    <div class="col-md-8">
                        <label for="memberSearch" class="form-label">@(bn ? "নাম বা ইমেইলের শুরু দিয়ে খুঁজুন" : "Search by name or email (starts with)")</label>
                        <input type="search" class="form-control" id="memberSearch" maxlength="100" autocomplete="off" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary me-2">@(bn ? "খুঁজুন" : "Search")</button>
                    </div>
                </form>
                <div class="table-responsive">
                    <table class="table table-hover align-middle" data-workspace-table="institution-users">
                        <thead><tr><th scope="col" data-table-column="user">@(bn ? "ব্যবহারকারী" : "User")</th><th scope="col" data-table-column="membership">@(bn ? "সদস্যপদ" : "Membership")</th><th scope="col" data-table-column="roles">@(bn ? "ভূমিকা" : "Roles")</th><th scope="col" data-table-column="action">@(bn ? "কাজ" : "Action")</th></tr></thead>
                        <tbody id="tenantUsersBody"><tr><td colspan="4">@(bn ? "লোড হচ্ছে…" : "Loading...")</td></tr></tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <small id="memberCount" class="text-muted"></small>
                    <div>
                        <button id="prevMembers" type="button" class="btn btn-outline-secondary btn-sm">@(bn ? "আগের" : "Previous")</button>
                        <button id="nextMembers" type="button" class="btn btn-outline-secondary btn-sm">@(bn ? "পরের" : "Next")</button>
                    </div>
                </div>
            </div>
        </div>
        <div id="memberEditor" class="card border-0 shadow-sm mt-3 d-none">
            <div class="card-body">
                <h5 id="memberEditorTitle"></h5>
                <p class="small text-muted">@(bn ? "সদস্যের অনুমতি পরিবর্তন করলে পুরোনো লগইন সেশন বাতিল হবে। প্রতিষ্ঠানের মালিকানা এখানে পরিবর্তন করা যাবে না।" : "Changes revoke the selected user's old sessions. Ownership cannot be changed here.")</p>
                <button id="memberHistoryButton" type="button" class="btn btn-outline-secondary btn-sm mb-3">@(bn ? "প্রবেশাধিকার পরিবর্তনের ইতিহাস" : "View access history")</button>
                <div id="memberHistoryPanel" class="border rounded p-3 mb-3 d-none">
                    <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-2">
                        <h6 class="mb-0">@(bn ? "সদস্যের প্রবেশাধিকার পরিবর্তনের ইতিহাস" : "Member access history")</h6>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <label for="memberHistoryChangeFilter" class="visually-hidden">@(bn ? "পরিবর্তনের ধরন" : "Change type")</label>
                            <select id="memberHistoryChangeFilter" class="form-select form-select-sm" aria-label="@(bn ? "পরিবর্তনের ধরন" : "Change type")">
                                <option value="all">@(bn ? "সব পরিবর্তন" : "All changes")</option>
                                <option value="roles">@(bn ? "ভূমিকা" : "Roles")</option>
                                <option value="campuses">@(bn ? "ক্যাম্পাস" : "Campuses")</option>
                                <option value="status">@(bn ? "সদস্যপদের অবস্থা" : "Membership status")</option>
                                <option value="permissions">@(bn ? "অনুমতির ব্যতিক্রম" : "Permission exceptions")</option>
                            </select>
                            <label for="memberHistoryFrom" class="visually-hidden">@(bn ? "শুরু (UTC)" : "From (UTC)")</label>
                            <input id="memberHistoryFrom" type="date" class="form-control form-control-sm" aria-label="@(bn ? "শুরু (UTC)" : "From (UTC)")" />
                            <label for="memberHistoryTo" class="visually-hidden">@(bn ? "শেষ (UTC)" : "To (UTC)")</label>
                            <input id="memberHistoryTo" type="date" class="form-control form-control-sm" aria-label="@(bn ? "শেষ (UTC)" : "To (UTC)")" />
                            <button id="memberHistoryExport" type="button" class="btn btn-outline-primary btn-sm">@(bn ? "CSV ডাউনলোড" : "Export CSV")</button>
                        </div>
                    </div>
                    
                    <div class="table-responsive"><table class="table table-sm align-middle">
                        <thead><tr><th scope="col">@(bn ? "সময়" : "When")</th><th scope="col">@(bn ? "পরিবর্তন" : "Change")</th><th scope="col">@(bn ? "পরিবর্তনকারী" : "Actor")</th><th scope="col">@(bn ? "আগে" : "Previous")</th><th scope="col">@(bn ? "পরে" : "New")</th></tr></thead>
                        <tbody id="memberHistoryRows"></tbody>
                    </table></div>
                    <div class="d-flex justify-content-between align-items-center">
                        <small id="memberHistoryCount" class="text-muted"></small>
                        <div><button id="memberHistoryPrev" type="button" class="btn btn-outline-secondary btn-sm">@(bn ? "আগে" : "Previous")</button>
                        <button id="memberHistoryNext" type="button" class="btn btn-outline-secondary btn-sm">@(bn ? "পরে" : "Next")</button></div>
                    </div>
                </div>
                <div id="memberUnscopedIdentityRoleNotice" class="alert alert-warning d-none" role="status"></div>
                <form id="saveMemberRolesForm">
                    <div id="memberRoleOptions" class="row row-cols-1 row-cols-md-3 g-2 mb-3"></div>
                    <label id="memberUnscopedIdentityRoleApprovalLabel" class="form-check mb-3 d-none"><input id="memberUnscopedIdentityRoleApproval" class="form-check-input" type="checkbox" /><span class="form-check-label">I reviewed the existing global grants and approve removing them for this user's sole institution.</span></label>
                    <button id="saveMemberRoles" class="btn btn-primary" type="submit">@(bn ? "ভূমিকা সংরক্ষণ" : "Save roles")</button>
                </form>
                <hr />
                <h6>@(bn ? "ক্যাম্পাস অনুমতি" : "Campus access")</h6>
                <p class="small text-muted">@(bn ? "ক্যাম্পাস অনুমতি শুধু নির্বাচিত প্রতিষ্ঠানের মধ্যেই প্রযোজ্য।" : "Available campuses are always restricted to the selected institution.")</p>
                <div id="memberCampusOptions" class="row g-2 mb-2"></div>
                <label for="memberDefaultCampus" class="form-label">@(bn ? "ডিফল্ট ক্যাম্পাস" : "Default campus")</label>
                <select id="memberDefaultCampus" class="form-select mb-2" style="max-width:320px"></select>
                <button id="saveMemberCampuses" type="button" class="btn btn-outline-primary">@(bn ? "ক্যাম্পাস অনুমতি সংরক্ষণ" : "Save campus access")</button>
                <hr />
                <label for="memberStatusSelect" class="form-label">@(bn ? "সদস্যপদের অবস্থা" : "Membership status")</label>
                <div class="d-flex gap-2 align-items-center">
                    <select id="memberStatusSelect" class="form-select" style="max-width:260px">
                        <option value="2">@(bn ? "সক্রিয়" : "Active")</option>
                        <option value="3">@(bn ? "স্থগিত" : "Suspended")</option>
                        <option value="4">@(bn ? "চলে গেছেন" : "Left")</option>
                    </select>
                    <button id="saveMemberStatus" type="button" class="btn btn-outline-danger">@(bn ? "অবস্থা পরিবর্তন" : "Update status")</button>
                </div>
            </div>
        </div>
    </section>
    <section id="rolesSection" class="d-none">
        <div class="card border-0 shadow-sm mb-2">
            <div class="card-body py-3">
                <h5 class="h6 fw-bold mb-1">@(bn ? "বিল্ট-ইন রোলসমূহ" : "Built-in roles")</h5>
                <p class="small text-muted mb-2">@(bn ? "এগুলো সিস্টেমের রোল নাম। প্রয়োজন হলে এই প্রতিষ্ঠানে Enable করুন। TenantAdmin শুধু প্রতিষ্ঠানের মালিক পাবেন।"
                    : "Built-in names are shared templates, not cross-institution grants. Enable roles per institution; TenantAdmin is owner-managed.")</p>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead><tr>
                            <th scope="col">@(bn ? "রোল" : "Role")</th>
                            <th scope="col">@(bn ? "অবস্থা" : "Status")</th>
                            <th scope="col" class="text-end">@(bn ? "কাজ" : "Action")</th>
                        </tr></thead>
                        <tbody id="builtInRoleRows"><tr><td colspan="3" class="small text-muted">@(bn ? "লোড হচ্ছে..." : "Loading roles...")</td></tr></tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="card border-0 shadow-sm mb-2">
            <div class="card-body">
                <h5 class="h6 fw-bold">@(bn ? "নতুন কাস্টম রোল" : "Create custom institution role")</h5>
                <form id="createTenantRoleForm" class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label" for="newRoleName">@(bn ? "ভূমিকার নাম" : "Role name")</label>
                        <input id="newRoleName" class="form-control" maxlength="100" minlength="2" required />
                        <small id="newRoleHint" class="form-text text-muted">@(bn ? "বিল্ট-ইন রোল থাকলে ওপরের Enable ব্যবহার করুন" : "Use Enable above for built-in roles")</small>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label" for="newRoleDescription">@(bn ? "বিবরণ" : "Description")</label>
                        <input id="newRoleDescription" class="form-control" maxlength="300" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button id="createRoleButton" class="btn btn-primary btn-sm" type="submit">@(bn ? "রোল তৈরি করুন" : "Create role")</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5>@(bn ? "অনুমতি নির্ধারণ" : "Permission assignment")</h5>
                <p class="text-muted small">Permissions shown here are the current global permission catalogue; assignments remain institution scoped.</p>
                <div class="mb-3">
                    <label for="permissionRole" class="form-label">@(bn ? "প্রতিষ্ঠানের ভূমিকা" : "Institution role")</label>
                    <select id="permissionRole" class="form-select"></select>
                </div>
                <div class="row g-2 align-items-end mb-3">
                    <div class="col-md-7">
                        <label for="editRoleDescription" class="form-label">@(bn ? "ভূমিকার বিবরণ" : "Role description")</label>
                        <input id="editRoleDescription" class="form-control" maxlength="300" />
                    </div>
                    <div class="col-md-2">
                        <label for="editRoleActive" class="form-label d-block">@(bn ? "ভূমিকা সক্রিয়" : "Role active")</label>
                        <input id="editRoleActive" type="checkbox" class="form-check-input" />
                    </div>
                    <div class="col-md-3">
                        <button id="saveRoleSettings" type="button" class="btn btn-outline-secondary">@(bn ? "ভূমিকার সেটিংস সংরক্ষণ" : "Save role settings")</button>
                    </div>
                </div>
                <form id="saveRolePermissionsForm">
                    <div id="permissionOptions" class="row g-2 mb-3"></div>
                    <button type="submit" class="btn btn-primary">@(bn ? "অনুমতি সংরক্ষণ" : "Save permissions")</button>
                </form>
            </div>
        </div>
    </section>
</div>
@section Scripts {
    <script src="~/js/tenant-users/index.js" asp-append-version="true"></script>
    <script src="~/js/platform/table-column-preferences.js" asp-append-version="true"></script>
}
