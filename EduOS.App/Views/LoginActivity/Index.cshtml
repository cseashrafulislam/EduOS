@{ ViewData["Title"] = "Sign-in Activity"; }
<section class="container-fluid py-3" aria-labelledby="loginActivityTitle">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div><h2 id="loginActivityTitle">Sign-in activity</h2><p class="text-muted mb-0">Review successful and unsuccessful sign-ins for your account. Only sign-ins associated with this institution or unattributed legacy attempts are included.</p></div>
        <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Profile">Account security</a>
    </div>
    <div id="loginActivityAlert" class="alert alert-danger d-none" role="alert"></div>
    <div class="card"><div class="card-body">
        <div class="d-flex flex-wrap align-items-end gap-2 mb-3">
            <div><label for="loginActivityStatus" class="form-label">Result</label><select id="loginActivityStatus" class="form-select"><option value="">All attempts</option><option value="true">Successful</option><option value="false">Unsuccessful</option></select></div>
            <button id="loginActivityRefresh" class="btn btn-outline-secondary" type="button">Refresh</button>
        </div>
        <div class="table-responsive"><table class="table table-striped table-hover align-middle"><thead><tr><th>Time</th><th>Result</th></tr></thead><tbody id="loginActivityRows"><tr><td colspan="2">Loading...</td></tr></tbody></table></div>
        <div class="d-flex justify-content-between align-items-center gap-2"><span id="loginActivityPageInfo" class="small text-muted" aria-live="polite"></span><div class="btn-group"><button id="loginActivityPrev" class="btn btn-outline-secondary btn-sm" type="button">Previous</button><button id="loginActivityNext" class="btn btn-outline-secondary btn-sm" type="button">Next</button></div></div>
    </div></div>
</section>
@section Scripts { <script src="~/js/account/login-activity.js" asp-append-version="true"></script> }
