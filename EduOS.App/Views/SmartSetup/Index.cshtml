@{
    ViewData["Title"] = "Smart Institution Setup";
    var bn = CultureInfo.CurrentUICulture.Name.StartsWith("bn", StringComparison.OrdinalIgnoreCase);
}
<div id="smartSetupWorkspace" class="container-fluid py-4" data-language="@(bn ? "bn-BD" : "en-BD")">
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
        <div>
            <h1 class="h4 fw-bold mb-1">@(bn ? "স্মার্ট প্রতিষ্ঠান সেটআপ" : "Smart Institution Setup")</h1>
            <p class="text-muted mb-0">
                @(bn ? "প্রতিষ্ঠানের ধরন অনুযায়ী প্রস্তুত Master Data দেখুন, যাচাই করুন এবং নিরাপদে যোগ করুন।" :
                    "Review organization-based reference data before creating only missing, safe master records.")
            </p>
        </div>
        <a href="/TenantSettings/Index" class="btn btn-outline-secondary btn-sm">
            @(bn ? "প্রতিষ্ঠানের সেটিংস" : "Institution Settings")
        </a>
    </div>
    <div id="smartSetupNotice" class="alert d-none" role="alert" aria-live="assertive" tabindex="-1"></div>
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div>
                    <div class="small text-muted">@(bn ? "প্রতিষ্ঠানের ধরন" : "Organization type")</div>
                    <h2 class="h5 mb-0" id="smartSetupInstitution">@(bn ? "লোড হচ্ছে..." : "Loading...")</h2>
                    <div id="smartSetupVersion" class="small text-muted mt-1"></div>
                </div>
                <button type="button" id="smartSetupReload" class="btn btn-outline-primary btn-sm">
                    @(bn ? "আবার যাচাই করুন" : "Refresh preview")
                </button>
            </div>
        </div>
    </div>
    <div class="alert alert-info" role="note">
        <strong>@(bn ? "নিরাপদ প্রক্রিয়া:" : "Safe setup:")</strong>
        @(bn ? "শুধু নির্বাচিত ও অনুমোদিত Module-এর অনুপস্থিত reference data তৈরি হবে। পুরোনো Master Data, Fee Amount, Bank, Salary, Stock, Student বা হিসাবের লেনদেন পরিবর্তন হবে না।" :
            "Only missing safe reference records from enabled modules are created. Existing masters, fee amounts, banks, salaries, stock, students and financial transactions are never modified.")
    </div>
    <p id="smartSetupReadinessSummary" class="small text-muted" role="status" aria-live="polite"></p>

    @* These are the existing protected setup forms, not copied or reimplemented forms.
       Save/edit still occurs through each module's normal server-side validation. *@
    <section id="smartSetupInline" class="card border-0 shadow-sm mb-3" hidden
             aria-labelledby="smartSetupInlineTitle">
        <div class="card-header bg-white d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <h2 id="smartSetupInlineTitle" class="h6 fw-bold mb-1">@(bn ? "এখানেই সেটআপ করুন" : "Complete setup here")</h2>
                <p id="smartSetupInlineInfo" class="small text-muted mb-0">
                    @(bn ? "মূল সেটিংসের অনুমোদিত ফর্ম; এখানে Save হলে একই মূল ডাটাবেসে সংরক্ষণ হবে।" :
                        "The original authorized settings form. Saving here updates the same master records.")
                </p>
            </div>
            <div class="d-flex gap-2">
                <button id="smartSetupInlineRefresh" type="button" class="btn btn-sm btn-outline-primary">
                    @(bn ? "সেটআপ স্ট্যাটাস যাচাই" : "Refresh setup status")
                </button>
                <button id="smartSetupInlineClose" type="button" class="btn btn-sm btn-outline-secondary">
                    @(bn ? "বন্ধ করুন" : "Close")
                </button>
            </div>
        </div>
        <div class="card-body p-1 p-sm-2">
            <iframe id="smartSetupFrame" class="w-100 bg-white rounded"
                    title="@(bn ? "নির্বাচিত সেটিংস ফর্ম" : "Selected setting form")"
                    loading="lazy" referrerpolicy="same-origin"
                    style="height:min(80vh,880px);min-height:560px;border:1px solid var(--edu-border);"></iframe>
        </div>
    </section>

    <form id="smartSetupForm">
        @Html.AntiForgeryToken()
        <div id="smartSetupModules" class="row g-3" aria-live="polite">
            <div class="col-12"><div class="card"><div class="card-body text-muted">
                @(bn ? "Setup Preview লোড হচ্ছে..." : "Loading setup preview...")
            </div></div></div>
        </div>
        <div class="card border-0 shadow-sm mt-3 position-sticky bottom-0" style="z-index:10;">
            <div class="card-body py-3">
                <div class="form-check">
                    <input id="smartSetupConfirm" class="form-check-input" type="checkbox" required />
                    <label for="smartSetupConfirm" class="form-check-label">
                        @(bn ? "স্বয়ংক্রিয়ভাবে পূরণ করা নির্বাচিত Row-গুলোর তথ্য যাচাই করেছি; শুধু এগুলো সংরক্ষণ করুন।" :
                            "I reviewed the checked, pre-filled rows. Save only these records.")
                    </label>
                </div>
                <div class="d-flex flex-wrap gap-2 align-items-center mt-3">
                    <button id="smartSetupSelectAll" type="button" class="btn btn-sm btn-outline-primary">
                        @(bn ? "সব Missing Defaults নির্বাচন" : "Select all missing defaults")
                    </button>
                    <button id="smartSetupClearSelected" type="button" class="btn btn-sm btn-outline-secondary">
                        @(bn ? "নির্বাচন বাদ" : "Clear selection")
                    </button>
                    <button id="smartSetupApply" type="submit" class="btn btn-primary" disabled>
                        @(bn ? "নির্বাচিত Row সংরক্ষণ করুন" : "Save Checked Records")
                    </button>
                    <span id="smartSetupSelection" class="small text-muted"></span>
                </div>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    <script src="~/js/tenant/smart-setup.js" asp-append-version="true"></script>
}
