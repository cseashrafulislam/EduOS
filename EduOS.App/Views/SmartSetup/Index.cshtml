@{
    var bn = CultureInfo.CurrentUICulture.Name.StartsWith("bn", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = bn ? "স্মার্ট প্রতিষ্ঠান সেটআপ" : "Smart Institution Setup";
}
<div id="smartSetupWorkspace" class="container-fluid institution-settings-workspace smart-setup-page" data-language="@(bn ? "bn-BD" : "en-BD")">
    <div id="smartSetupNotice" class="alert d-none" role="alert" aria-live="assertive" tabindex="-1"></div>
    <div class="smart-setup-toolbar">
        <div class="smart-setup-context">
            <span class="smart-setup-context-label">@(bn ? "প্রতিষ্ঠানের ধরন" : "Institution type")</span>
            <strong id="smartSetupInstitution">@(bn ? "লোড হচ্ছে..." : "Loading...")</strong>
            <span id="smartSetupVersion" class="smart-setup-version"></span>
        </div>
        <div class="smart-setup-search">
            <label class="visually-hidden" for="smartSetupSearch">@(bn ? "সেটিংস খুঁজুন" : "Find a setting")</label>
            <input id="smartSetupSearch" type="search" class="form-control form-control-sm"
                   placeholder="@(bn ? "মডিউল বা সেটিংস খুঁজুন" : "Search module or setting")"
                   maxlength="80" autocomplete="off" />
        </div>
    </div>
    <div id="smartSetupReadinessSummary" class="smart-setup-summary" role="status" aria-live="polite"></div>

    @* Settings use the original authorized module forms. There is no second editable master store. *@
    <section id="smartSetupInline" class="card smart-setup-embedded mb-2" hidden aria-labelledby="smartSetupInlineTitle">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <h2 id="smartSetupInlineTitle" class="h6 mb-0">@(bn ? "সেটআপ" : "Setup")</h2>
            <button id="smartSetupInlineClose" type="button" class="btn btn-sm btn-outline-secondary">@(bn ? "বন্ধ করুন" : "Close")</button>
        </div>
        <div class="card-body p-1">
            <iframe id="smartSetupFrame" class="w-100 bg-white rounded"
                    title="@(bn ? "নির্বাচিত সেটিংস ফর্ম" : "Selected setting form")"
                    loading="lazy" referrerpolicy="same-origin"></iframe>
        </div>
    </section>

    <form id="smartSetupForm">
        @Html.AntiForgeryToken()
        <div id="smartSetupModules" class="smart-setup-modules" aria-live="polite">
            <div class="smart-setup-loading" role="status">@(bn ? "সেটিংস লোড হচ্ছে..." : "Loading settings...")</div>
        </div>
        <div id="smartSetupActions" class="smart-setup-actions" hidden>
            <div class="smart-setup-actions-top">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button id="smartSetupSelectAll" type="button" class="btn btn-sm btn-outline-primary">@(bn ? "সব অনুপস্থিত নির্বাচন" : "Select all missing")</button>
                    <button id="smartSetupClearSelected" type="button" class="btn btn-sm btn-outline-secondary">@(bn ? "নির্বাচন বাদ" : "Clear")</button>
                    <span id="smartSetupSelection" class="small text-muted" aria-live="polite"></span>
                </div>
                <div class="smart-setup-confirm-group">
                    <div class="form-check">
                        <input id="smartSetupConfirm" class="form-check-input" type="checkbox" required />
                        <label for="smartSetupConfirm" class="form-check-label">@(bn ? "নির্বাচিত তথ্য যাচাই করেছি" : "I reviewed the selected records")</label>
                    </div>
                    <button id="smartSetupApply" type="submit" class="btn btn-primary btn-sm" disabled>@(bn ? "নির্বাচিত তথ্য সংরক্ষণ" : "Save selected")</button>
                </div>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    <script src="~/js/tenant/smart-setup.js" asp-append-version="true"></script>
}
