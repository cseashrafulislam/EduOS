@{
    ViewData["Title"] = "Academic Instruction";
    var canManage = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("VicePrincipal");
}
<section id="instructionApp" data-can-manage="@canManage.ToString().ToLowerInvariant()" data-can-teach="@User.IsInRole("Teacher").ToString().ToLowerInvariant()" class="container-fluid py-3">
    <header class="mb-3 d-flex align-items-center justify-content-between gap-2"><h2 class="h4 mb-0">Academic Instruction</h2><button id="instructionHelp" type="button" class="btn btn-sm btn-outline-secondary" title="Page guide" aria-label="Academic instruction guide" aria-controls="instructionHelpText" aria-expanded="false">ⓘ</button></header>
    <div id="instructionHelpText" class="d-none small text-muted mb-3" role="note">Choose a batch and date range. Search subject offerings when creating a lesson plan; only assigned instructors can progress approved lessons. Substitutions require an active routine and a different eligible teacher.</div>
    <div id="instructionAlert" class="d-none" tabindex="-1" role="alert" aria-live="polite"></div>
    <form id="instructionFilters" class="card card-body mb-3">
        <div class="row g-3 align-items-end">
            <div class="col-lg-5"><label for="instructionBatch" class="form-label">Academic batch</label><select id="instructionBatch" class="form-select" required><option value="">Loading batches…</option></select></div>
            <div class="col-lg-2"><label for="instructionFrom" class="form-label">From</label><input type="date" id="instructionFrom" class="form-control" required /></div>
            <div class="col-lg-2"><label for="instructionTo" class="form-label">To</label><input type="date" id="instructionTo" class="form-control" required /></div>
            <div class="col-lg-3"><button id="instructionLoad" type="submit" class="btn btn-primary w-100">Load instruction</button></div>
        </div>
    </form>
    <div class="card mb-3">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <h3 class="h6 mb-0">Lesson plans <small class="text-muted fw-normal">Approved → In progress → Completed (assigned teacher only)</small></h3><div class="d-flex gap-2">
                <button id="lessonCsv" class="btn btn-sm btn-outline-secondary" type="button" disabled>CSV (current page)</button>
                <button id="lessonPrint" class="btn btn-sm btn-outline-secondary" type="button">Print</button>
                <button id="lessonNew" class="btn btn-sm btn-primary" type="button" disabled>New lesson plan</button>
            </div>
        </div>
        <div class="table-responsive"><table class="table table-hover table-sm align-middle mb-0"><thead><tr><th>Lesson date</th><th>Subject</th><th>Chapter / Title</th><th>Teacher</th><th>Status</th><th>Actions</th></tr></thead><tbody id="lessonRows"><tr><td colspan="6" class="text-muted text-center p-3">Select a batch.</td></tr></tbody></table></div>
        <div class="card-footer d-flex justify-content-end align-items-center gap-2">
            <button id="lessonPrevious" type="button" class="btn btn-sm btn-outline-secondary" disabled>Previous</button>
            <span id="lessonPage" class="small text-muted" aria-live="polite">Page 1 / 1</span>
            <button id="lessonNext" type="button" class="btn btn-sm btn-outline-secondary" disabled>Next</button>
        </div>
    </div>
    <section id="lessonEditor" class="card mb-3 d-none">
        <div class="card-header"><h3 id="lessonEditorTitle" class="h6 m-0">New lesson plan</h3></div>
        <form id="lessonForm" class="card-body">
            <div class="row g-3">
                <div class="col-lg-5"><label class="form-label" for="lessonOfferingSearch">Find subject offering</label><div class="input-group"><input id="lessonOfferingSearch" class="form-control" maxlength="100" placeholder="Name or code" /><button id="lessonFindOfferings" type="button" class="btn btn-outline-secondary">Find</button></div></div>
                <div class="col-lg-7 d-flex align-items-end gap-2"><button id="lessonOfferingsPrevious" type="button" class="btn btn-sm btn-outline-secondary" disabled>Previous</button><span id="lessonOfferingPage" class="small text-muted" aria-live="polite">Page 1 / 1</span><button id="lessonOfferingsNext" type="button" class="btn btn-sm btn-outline-secondary" disabled>Next</button></div>
                <div class="col-md-6"><label class="form-label" for="lessonAssignment">Subject offering</label><select id="lessonAssignment" class="form-select" required></select></div>
                <div class="col-md-3"><label class="form-label" for="lessonDate">Lesson date</label><input id="lessonDate" type="date" class="form-control" required /></div>
                <div class="col-md-3"><label class="form-label" for="lessonTitle">Chapter / title</label><input id="lessonTitle" maxlength="250" class="form-control" required /></div>
                <div class="col-md-12"><label class="form-label" for="lessonObjectives">Learning objectives</label><textarea id="lessonObjectives" rows="2" class="form-control" maxlength="2000"></textarea></div>
                <div class="col-md-12"><label class="form-label" for="lessonContent">Lesson content / teaching notes</label><textarea id="lessonContent" rows="3" class="form-control" maxlength="2000"></textarea></div>
                <div class="col-md-12"><label class="form-label" for="lessonResources">Resources</label><textarea id="lessonResources" rows="2" class="form-control" maxlength="2000"></textarea></div>
                <div class="col-12"><button id="lessonSave" type="submit" class="btn btn-primary">Save draft</button><button id="lessonCancel" type="button" class="btn btn-outline-secondary ms-2">Cancel</button></div>
            </div>
        </form>
    </section>
    <section class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center gap-2">
            <h3 class="h6 m-0">Teacher substitutions</h3>
            <button id="substitutionCsv" type="button" class="btn btn-sm btn-outline-secondary">CSV (current page)</button>
        </div>
        @if (canManage)
        {
            <div class="card-body border-bottom">
                <h4 class="h6">Schedule a substitution</h4>
                <form id="substitutionForm" class="row g-2 align-items-end">
                    <div class="col-lg-2"><label for="substitutionDate" class="form-label">Date</label><input id="substitutionDate" type="date" class="form-control" required /></div>
                    <div class="col-lg-4"><label for="substitutionRoutineSearch" class="form-label">Find scheduled routine</label>
                        <div class="input-group"><input id="substitutionRoutineSearch" class="form-control" maxlength="100" placeholder="Subject, period or teacher" /><button id="substitutionRoutineFind" type="button" class="btn btn-outline-secondary">Find</button></div>
                        <select id="substitutionRoutine" class="form-select mt-1" required><option value="">Select a date and batch</option></select>
                        <div class="d-flex justify-content-between align-items-center gap-2 mt-1">
                            <button id="substitutionRoutinePrevious" type="button" class="btn btn-sm btn-outline-secondary" disabled>Previous</button>
                            <span id="substitutionRoutinePage" class="small text-muted" aria-live="polite">Page 1 / 1</span>
                            <button id="substitutionRoutineNext" type="button" class="btn btn-sm btn-outline-secondary" disabled>Next</button>
                        </div>
                    </div>
                    <div class="col-lg-3"><label for="substitutionTeacherSearch" class="form-label">Find substitute teacher</label>
                        <div class="input-group"><input id="substitutionTeacherSearch" class="form-control" maxlength="100" placeholder="Name or code" />
                        <button id="substitutionTeacherFind" type="button" class="btn btn-outline-secondary">Find</button></div>
                        <select id="substitutionTeacher" class="form-select mt-1" required><option value="">Search teachers</option></select></div>
                    <div class="col-lg-3"><label for="substitutionReason" class="form-label">Reason</label><input id="substitutionReason" class="form-control" maxlength="500" /></div>
                    <div class="col-12"><button id="substitutionSave" class="btn btn-primary" type="submit">Schedule substitution</button></div>
                </form>
            </div>
        }
        <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead><tr><th>Date</th><th>Batch / Subject</th><th>Time slot</th><th>Original teacher</th><th>Substitute</th><th>Reason</th><th>Status</th>@if(canManage){<th>Action</th>}</tr></thead><tbody id="substitutionRows"><tr><td colspan="8" class="p-3 text-muted text-center">Choose a batch.</td></tr></tbody></table></div>
        <div class="card-footer d-flex justify-content-end align-items-center gap-2">
            <button id="substitutionPrevious" type="button" class="btn btn-sm btn-outline-secondary" disabled>Previous</button>
            <span id="substitutionPage" class="small text-muted" aria-live="polite">Page 1 / 1</span>
            <button id="substitutionNext" type="button" class="btn btn-sm btn-outline-secondary" disabled>Next</button>
        </div>
    </section>
</section>
@section Scripts {
    <script src="~/js/academic/instruction.js" asp-append-version="true"></script>
}
