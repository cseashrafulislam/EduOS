<section class="content-card mt-3" aria-labelledby="gatewayTitle">
    <h3 id="gatewayTitle" class="h5" data-gateway-en="Provider settings" data-gateway-bn="প্রোভাইডার সেটিংস">Provider settings</h3>
    <p class="small text-muted" data-gateway-en="Each institution configures its own provider and sender. Saved credentials are encrypted and never displayed. Leave the password blank to keep it." data-gateway-bn="প্রতিটি প্রতিষ্ঠান নিজস্ব প্রোভাইডার ও প্রেরকের তথ্য নির্ধারণ করে। সংরক্ষিত ক্রেডেনশিয়াল এনক্রিপ্ট করা থাকে এবং আর দেখানো হয় না। আগের পাসওয়ার্ড রাখতে ঘরটি ফাঁকা রাখুন।">Each institution configures its own provider and sender. Saved credentials are encrypted and never displayed. Leave the password blank to keep it.</p>
    <form id="gatewayForm" class="row g-3">
        <input id="gatewayId" type="hidden" /><input id="gatewayVersion" type="hidden" />
        <div class="col-md-5"><label for="gatewayCode" class="form-label" data-gateway-en="Provider code" data-gateway-bn="প্রোভাইডার কোড">Provider code</label><input id="gatewayCode" class="form-control" maxlength="100" required /></div>
        <div class="col-md-3"><label for="gatewayChannel" class="form-label" data-gateway-en="Channel" data-gateway-bn="চ্যানেল">Channel</label><select id="gatewayChannel" class="form-select"><option value="1" data-gateway-en="In-app" data-gateway-bn="অ্যাপের ভেতরে">In-app</option><option value="2" data-gateway-en="Email" data-gateway-bn="ইমেইল">Email</option><option value="3" data-gateway-en="SMS" data-gateway-bn="SMS">SMS</option><option value="4" data-gateway-en="Push" data-gateway-bn="পুশ">Push</option></select></div>
        <div class="col-md-4"><label for="gatewayActive" class="form-label" data-gateway-en="Status" data-gateway-bn="অবস্থা">Status</label><select id="gatewayActive" class="form-select"><option value="true" data-gateway-en="Active" data-gateway-bn="সক্রিয়">Active</option><option value="false" data-gateway-en="Inactive" data-gateway-bn="নিষ্ক্রিয়">Inactive</option></select></div>
        <div class="col-md-6" data-gateway-endpoint><label for="gatewayEndpoint" class="form-label" data-gateway-en="Provider HTTPS API endpoint" data-gateway-bn="প্রোভাইডারের HTTPS API ঠিকানা">Provider HTTPS API endpoint</label><input id="gatewayEndpoint" class="form-control" type="url" maxlength="1000" /></div>
        <div class="col-md-6" data-gateway-sms><label for="gatewaySmsSenderId" class="form-label" data-gateway-en="SMS sender ID" data-gateway-bn="SMS প্রেরক আইডি">SMS sender ID</label><input id="gatewaySmsSenderId" class="form-control" maxlength="20" /></div>
        <div class="col-md-6" data-gateway-smtp><label for="gatewaySmtpHost" class="form-label" data-gateway-en="SMTP host" data-gateway-bn="SMTP হোস্ট">SMTP host</label><input id="gatewaySmtpHost" class="form-control" maxlength="253" /></div>
        <div class="col-md-3" data-gateway-smtp><label for="gatewaySmtpPort" class="form-label" data-gateway-en="SMTP TLS port" data-gateway-bn="SMTP TLS পোর্ট">SMTP TLS port</label><input id="gatewaySmtpPort" type="number" min="1" max="65535" class="form-control" /></div>
        <div class="col-md-3" data-gateway-smtp><label for="gatewayUseSsl" class="form-label" data-gateway-en="Encrypted connection" data-gateway-bn="এনক্রিপ্টেড সংযোগ">Encrypted connection</label><select id="gatewayUseSsl" class="form-select"><option value="true" data-gateway-en="TLS enabled" data-gateway-bn="TLS চালু">TLS enabled</option><option value="false" data-gateway-en="TLS disabled" data-gateway-bn="TLS বন্ধ">TLS disabled</option></select></div>
        <div class="col-md-6" data-gateway-smtp><label for="gatewaySmtpUsername" class="form-label" data-gateway-en="SMTP username" data-gateway-bn="SMTP ব্যবহারকারীর নাম">SMTP username</label><input id="gatewaySmtpUsername" class="form-control" maxlength="320" autocomplete="off" /></div>
        <div class="col-md-6" data-gateway-smtp><label for="gatewayFromEmail" class="form-label" data-gateway-en="Sender email address" data-gateway-bn="প্রেরকের ইমেইল ঠিকানা">Sender email address</label><input id="gatewayFromEmail" type="email" class="form-control" maxlength="320" /></div>
        <div class="col-md-6" data-gateway-smtp><label for="gatewayFromName" class="form-label" data-gateway-en="Sender display name" data-gateway-bn="প্রেরকের প্রদর্শিত নাম">Sender display name</label><input id="gatewayFromName" class="form-control" maxlength="150" /></div>
        <div class="col-md-6"><label for="gatewayCredential" class="form-label" data-gateway-en="Password / API credential" data-gateway-bn="পাসওয়ার্ড / API ক্রেডেনশিয়াল">Password / API credential</label><input id="gatewayCredential" class="form-control" type="password" autocomplete="new-password" maxlength="4000" /></div>
        <div class="col-12"><label class="me-4"><input id="gatewayDefault" type="checkbox" /> <span data-gateway-en="Default for this channel" data-gateway-bn="এই চ্যানেলের ডিফল্ট">Default for this channel</span></label><label><input id="gatewayClear" type="checkbox" /> <span data-gateway-en="Remove saved credential" data-gateway-bn="সংরক্ষিত ক্রেডেনশিয়াল মুছুন">Remove saved credential</span></label></div>
        <div class="col-12 d-flex gap-2"><button type="submit" class="btn btn-primary" data-gateway-en="Save provider" data-gateway-bn="প্রোভাইডার সংরক্ষণ করুন">Save provider</button><button type="button" class="btn btn-outline-secondary" data-clear="gateway" data-gateway-en="New" data-gateway-bn="নতুন">New</button></div>
    </form>
    <div class="table-responsive mt-3"><table class="table table-hover"><thead><tr><th data-gateway-en="Provider" data-gateway-bn="প্রোভাইডার">Provider</th><th data-gateway-en="Channel" data-gateway-bn="চ্যানেল">Channel</th><th data-gateway-en="Default" data-gateway-bn="ডিফল্ট">Default</th><th data-gateway-en="Credential" data-gateway-bn="ক্রেডেনশিয়াল">Credential</th><th data-gateway-en="Status" data-gateway-bn="অবস্থা">Status</th><th data-gateway-en="Action" data-gateway-bn="কাজ">Action</th></tr></thead><tbody id="gatewayRows"></tbody></table></div>
</section>
