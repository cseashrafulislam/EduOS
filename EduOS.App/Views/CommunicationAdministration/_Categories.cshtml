<section class="content-card" aria-labelledby="categoryTitle">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
        <h3 id="categoryTitle" class="h6 mb-0">Notice categories</h3>
        <a class="btn btn-outline-primary btn-sm" asp-controller="IntegrationAdministration" asp-action="Index">Integrations and API credentials</a>
    </div>
    <form id="categoryForm" class="row g-2">
        <input id="categoryId" type="hidden" /><input id="categoryVersion" type="hidden" />
        <input id="categoryCode" type="hidden" />
        <div class="col-md-9"><label for="categoryName" class="form-label">Name</label><input id="categoryName" class="form-control" maxlength="100" required /></div>
        <div class="col-md-3"><label for="categoryActive" class="form-label">Status</label><select id="categoryActive" class="form-select"><option value="true">Active</option><option value="false">Inactive</option></select></div>
        <div class="col-12 d-flex gap-2"><button type="submit" class="btn btn-primary">Save category</button><button type="button" class="btn btn-outline-secondary" data-clear="category">New</button></div>
    </form>
    <div class="table-responsive mt-2"><table class="table table-hover"><thead><tr><th>Code</th><th>Name</th><th>Status</th><th>Action</th></tr></thead><tbody id="categoryRows"></tbody></table></div>
</section>
