<section class="content-card mt-3" aria-labelledby="categoryTitle">
    <h3 id="categoryTitle" class="h5">Notice categories</h3>
    <form id="categoryForm" class="row g-3">
        <input id="categoryId" type="hidden" /><input id="categoryVersion" type="hidden" />
        <div class="col-md-4"><label for="categoryCode" class="form-label">Code</label><input id="categoryCode" class="form-control" maxlength="50" required /></div>
        <div class="col-md-5"><label for="categoryName" class="form-label">Name</label><input id="categoryName" class="form-control" maxlength="100" required /></div>
        <div class="col-md-3"><label for="categoryActive" class="form-label">Status</label><select id="categoryActive" class="form-select"><option value="true">Active</option><option value="false">Inactive</option></select></div>
        <div class="col-12 d-flex gap-2"><button type="submit" class="btn btn-primary">Save category</button><button type="button" class="btn btn-outline-secondary" data-clear="category">New</button></div>
    </form>
    <div class="table-responsive mt-3"><table class="table table-hover"><thead><tr><th>Code</th><th>Name</th><th>Status</th><th>Action</th></tr></thead><tbody id="categoryRows"></tbody></table></div>
</section>
