@{
    ViewData["Title"] = "Student Attendance";
}

@Html.AntiForgeryToken()
<section class="admission-page" aria-labelledby="attendanceTitle" data-can-correct="@((User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("VicePrincipal")).ToString().ToLowerInvariant())">
    <header class="content-header-card">
        <div>
            <p class="dashboard-eyebrow">Academic Operations</p>
            <h2 id="attendanceTitle">Student Attendance</h2>
        </div>
        <details class="ms-auto">
            <summary class="btn btn-sm btn-outline-secondary" aria-label="Attendance help" title="Attendance help">ⓘ</summary>
            <div class="small border rounded bg-body p-2">
                Save each roster page before continuing. Finalize only after all eligible learners are marked.
                Later corrections require a reason and are audited.
            </div>
        </details>
    </header>

    <div id="attendanceAlert" class="d-none" role="alert" tabindex="-1"></div>

    <section class="content-card" aria-labelledby="attendanceFilterTitle">
        <div class="content-card-heading"><h3 id="attendanceFilterTitle">Attendance register</h3></div>
        <form id="attendanceFilters" class="row g-3 align-items-end">
            <div class="col-md-3"><label class="form-label" for="attendanceDate">Date</label><input id="attendanceDate" class="form-control" type="date" required /></div>
            <div class="col-md-3"><label class="form-label" for="attendanceBatchSearch">Find academic batch</label>
                <div class="input-group"><input id="attendanceBatchSearch" class="form-control" maxlength="100" placeholder="Name, code, year or level" />
                    <button id="attendanceBatchFind" class="btn btn-outline-secondary" type="button">Search</button></div></div>
            <div class="col-md-4"><label class="form-label" for="sectionId">Academic batch / section</label>
                <select id="sectionId" class="form-select" required disabled><option value="">Loading authorized batches…</option></select>
                <div class="d-flex justify-content-between align-items-center mt-1">
                    <button id="attendanceBatchPrevious" class="btn btn-sm btn-outline-secondary" type="button" disabled>Previous</button>
                    <span id="attendanceBatchPage" class="small text-muted" aria-live="polite"></span>
                    <button id="attendanceBatchNext" class="btn btn-sm btn-outline-secondary" type="button" disabled>Next</button>
                </div></div>

            <div class="col-md-4">
                <label class="form-label" for="attendanceSubjectSearch">Subject offering</label>
                <div class="input-group">
                    <input id="attendanceSubjectSearch" class="form-control" maxlength="100" placeholder="Subject name or code" />
                    <button id="attendanceSubjectFind" class="btn btn-outline-secondary" type="button">Search</button>
                </div>
                <select id="attendanceSubject" class="form-select mt-2" disabled>
                    <option value="">All subjects (batch register)</option>
                </select>
                <div class="d-flex justify-content-between align-items-center mt-1">
                    <button id="attendanceSubjectPrevious" class="btn btn-sm btn-outline-secondary" type="button" disabled>Previous</button>
                    <span id="attendanceSubjectPage" class="small text-muted" aria-live="polite"></span>
                    <button id="attendanceSubjectNext" class="btn btn-sm btn-outline-secondary" type="button" disabled>Next</button>
                </div>
            </div>
            <div class="col-12 d-flex gap-2 flex-wrap">
                <button class="btn btn-primary" type="submit">Load roster</button>
                <button id="markAllPresent" class="btn btn-outline-success" type="button" disabled>Mark all present</button>
                <button id="saveAttendance" class="btn btn-success" type="button" disabled>Save attendance</button>
                @if (User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("VicePrincipal"))
                {
                    <button id="finalizeAttendance" class="btn btn-outline-danger" type="button" disabled>Finalize register</button>
                }
            </div>
        </form>
    </section>

    <section class="content-card mt-3" aria-labelledby="attendanceRosterTitle">
        <div class="content-card-heading d-flex justify-content-between align-items-center gap-3 flex-wrap">
            <h3 id="attendanceRosterTitle">Roster</h3>
            <div id="attendanceSummary" class="small text-muted" aria-live="polite"></div>
            @if (User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("VicePrincipal"))
            {
                <div class="d-flex gap-2 flex-wrap">
                    <button id="attendanceHistoricalCsv" type="button" class="btn btn-sm btn-outline-secondary" disabled>Export historical page CSV</button>
                    <button id="attendanceHistoricalPrint" type="button" class="btn btn-sm btn-outline-secondary" disabled>Print historical page</button>
                </div>
            }
        </div>
        @if (User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("VicePrincipal"))
        {
            <div id="attendanceHistoricalFilters" class="row g-2 align-items-end mb-2 d-none">
                <div class="col-sm-5">
                    <label for="attendanceHistoricalSearch" class="form-label">Find historical learner</label>
                    <input id="attendanceHistoricalSearch" class="form-control form-control-sm"
                           maxlength="100" placeholder="Roll, student code or name" />
                </div>
                <div class="col-sm-3">
                    <label for="attendanceHistoricalState" class="form-label">Posted status</label>
                    <select id="attendanceHistoricalState" class="form-select form-select-sm">
                        <option value="">All statuses</option>
                        <option value="1">Present</option><option value="2">Absent</option>
                        <option value="3">Late</option><option value="4">Leave</option>
                        <option value="5">Excused</option>
                    </select>
                </div>
                <div class="col-sm-4 d-flex gap-2">
                    <button id="attendanceHistoricalFind" type="button" class="btn btn-sm btn-outline-primary">Search</button>
                    <button id="attendanceHistoricalClear" type="button" class="btn btn-sm btn-outline-secondary">Clear</button>
                </div>
            </div>
        }
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Roll</th><th>Student</th><th>Status</th><th>Check-in</th><th>Remarks</th></tr></thead>
                <tbody id="attendanceRows"><tr><td colspan="5" class="text-center text-muted py-4">Select a date, batch and optional subject to load the roster.</td></tr></tbody>
            </table>
        </div>
        <nav class="d-flex justify-content-between align-items-center mt-2" aria-label="Attendance roster pages">
            <button id="attendanceRosterPrevious" type="button" class="btn btn-sm btn-outline-secondary" disabled>Previous</button>
            <span id="attendanceRosterPage" class="small text-muted" aria-live="polite"></span>
            <button id="attendanceRosterNext" type="button" class="btn btn-sm btn-outline-secondary" disabled>Next</button>
        </nav>
    </section>
</section>


@if (User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("VicePrincipal"))
{
    <section class="content-card mt-3" aria-labelledby="attendanceReportTitle">
        <div class="content-card-heading"><h3 id="attendanceReportTitle">Finalized attendance report</h3></div>
        <form id="attendanceReportFilters" class="row g-3 align-items-end">
            <div class="col-md-4"><label for="attendanceReportBatchSearch" class="form-label">Find historical batch</label>
                <div class="input-group"><input id="attendanceReportBatchSearch" class="form-control" maxlength="100" placeholder="Batch, year or level" />
                    <button id="attendanceReportBatchFind" class="btn btn-outline-secondary" type="button">Search</button></div>
                <label for="attendanceReportBatch" class="form-label mt-2">Academic batch</label>
                <select id="attendanceReportBatch" class="form-select" required disabled><option value="">Loading authorized batches…</option></select>
                <div class="d-flex justify-content-between align-items-center mt-1">
                    <button id="attendanceReportBatchPrevious" class="btn btn-sm btn-outline-secondary" type="button" disabled>Previous</button>
                    <span id="attendanceReportBatchPage" class="small text-muted" aria-live="polite"></span>
                    <button id="attendanceReportBatchNext" class="btn btn-sm btn-outline-secondary" type="button" disabled>Next</button>
                </div></div>
            <div class="col-md-4"><label for="attendanceReportSubjectSearch" class="form-label">Subject offering</label>
                <div class="input-group">
                    <input id="attendanceReportSubjectSearch" class="form-control" maxlength="100" placeholder="Subject name or code" />
                    <button id="attendanceReportSubjectFind" class="btn btn-outline-secondary" type="button">Search</button>
                </div>
                <select id="attendanceReportSubject" class="form-select mt-2" disabled>
                    <option value="">All subjects</option>
                </select>
                <div class="d-flex justify-content-between align-items-center mt-1">
                    <button id="attendanceReportSubjectPrevious" class="btn btn-sm btn-outline-secondary" type="button" disabled>Previous</button>
                    <span id="attendanceReportSubjectPage" class="small text-muted" aria-live="polite"></span>
                    <button id="attendanceReportSubjectNext" class="btn btn-sm btn-outline-secondary" type="button" disabled>Next</button>
                </div>
            </div>
            <div class="col-md-3"><label for="attendanceReportFrom" class="form-label">From</label>
                <input id="attendanceReportFrom" class="form-control" type="date" required /></div>
            <div class="col-md-3"><label for="attendanceReportTo" class="form-label">To</label>
                <input id="attendanceReportTo" class="form-control" type="date" required /></div>
            <div class="col-md-2"><label for="attendanceReportRisk" class="form-label">Attendance risk</label>
                <select id="attendanceReportRisk" class="form-select">
                    <option value="">All percentages</option>
                    <option value="75">Below 75%</option>
                    <option value="90">Below 90%</option>
                    <option value="100">Below 100%</option>
                </select></div>
            <div class="col-md-2"><label for="attendanceReportMinSessions" class="form-label">Minimum marks</label>
                <input id="attendanceReportMinSessions" type="number" class="form-control" min="1" max="1000" value="1" required /></div>
            <div class="col-md-2"><label for="attendanceReportSort" class="form-label">Order by</label>
                <select id="attendanceReportSort" class="form-select">
                    <option value="roll">Roll</option>
                    <option value="lowest">Lowest attendance</option>
                    <option value="absent">Most absences</option>
                </select></div>
            <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Load report</button></div>
        </form>
        <p id="attendanceReportStatus" class="small text-muted mt-3" role="status" aria-live="polite">Select filters to load the report.</p>
        <div id="attendanceRiskSummary" class="small fw-semibold mb-2" role="status" aria-live="polite"></div>
        <div class="d-flex gap-2 mb-2">
            <button id="attendanceReportCsv" type="button" class="btn btn-sm btn-outline-primary" disabled>Export visible page CSV</button>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-striped">
                <thead><tr><th>Roll</th><th>Student code</th><th>Name</th><th>Marked</th><th>Present</th><th>Absent</th><th>Late</th><th>Leave</th><th>Excused</th><th>Attendance %</th></tr></thead>
                <tbody id="attendanceReportRows"></tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center">
            <button id="attendanceReportPrevious" type="button" class="btn btn-sm btn-outline-secondary" disabled>Previous</button>
            <span id="attendanceReportPage" class="small"></span>
            <button id="attendanceReportNext" type="button" class="btn btn-sm btn-outline-secondary" disabled>Next</button>
        </div>
        <section class="mt-3 pt-3 border-top" aria-labelledby="attendanceCoverageTitle">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <h4 id="attendanceCoverageTitle" class="h6 mb-0">Subject attendance coverage</h4>
                <button id="attendanceCoverageCsv" type="button" class="btn btn-sm btn-outline-secondary" disabled>Export visible page CSV</button>
            </div>
            <div class="row g-2 align-items-end mb-2">
                <div class="col-md-5">
                    <label for="attendanceCoverageSearch" class="form-label">Find subject</label>
                    <div class="input-group">
                        <input id="attendanceCoverageSearch" class="form-control" maxlength="100" placeholder="Subject or offering code" />
                        <button id="attendanceCoverageFind" type="button" class="btn btn-outline-secondary">Search</button>
                    </div>
                </div>
                <div class="col-md-3">
                    <label for="attendanceCoverageSort" class="form-label">Order by</label>
                    <select id="attendanceCoverageSort" class="form-select">
                        <option value="subject">Subject</option>
                        <option value="lowest">Lowest attendance</option>
                        <option value="absent">Most absences</option>
                    </select>
                </div>
            </div>
            <div id="attendanceCoverageStatus" class="small text-muted mb-2" role="status" aria-live="polite"></div>
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle">
                    <thead><tr><th>Subject</th><th>Code</th><th>Offering</th><th>Marked</th><th>Present</th><th>Absent</th><th>Late</th><th>Leave</th><th>Excused</th><th>Attendance %</th></tr></thead>
                    <tbody id="attendanceCoverageRows"></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <button id="attendanceCoveragePrevious" type="button" class="btn btn-sm btn-outline-secondary" disabled>Previous</button>
                <span id="attendanceCoveragePage" class="small" aria-live="polite"></span>
                <button id="attendanceCoverageNext" type="button" class="btn btn-sm btn-outline-secondary" disabled>Next</button>
            </div>
        </section>
        <section class="mt-3 pt-3 border-top" aria-labelledby="attendanceSessionsTitle">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <h4 id="attendanceSessionsTitle" class="h6 mb-0">Attendance session register</h4>
                <button id="attendanceSessionsCsv" type="button" class="btn btn-sm btn-outline-secondary" disabled>Export authorized page CSV</button>
                <button id="attendanceSessionsPrint" type="button" class="btn btn-sm btn-outline-secondary" disabled>Print authorized page</button>
            </div>
            <div class="row g-2 align-items-end mb-2">
                <div class="col-md-3">
                    <label for="attendanceSessionsStatusFilter" class="form-label">Session status</label>
                    <select id="attendanceSessionsStatusFilter" class="form-select">
                        <option value="draft">Not finalized</option>
                        <option value="all">All sessions</option>
                        <option value="finalized">Finalized</option>
                        <option value="empty-draft">Empty drafts</option>
                        <option value="empty-finalized">Empty finalized (review)</option>
                        <option value="empty">All empty sessions</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button id="attendanceSessionsLoad" type="button" class="btn btn-outline-primary">Load sessions</button>
                </div>
            </div>
            <div id="attendanceSessionsStatus" class="small text-muted mb-1" role="status" aria-live="polite"></div>
            <div id="attendanceSessionsOverview" class="small fw-semibold mb-2" role="status" aria-live="polite"></div>
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle">
                    <thead><tr><th>Date</th><th>Offering</th><th>Status</th><th>Marked</th><th>Present</th><th>Absent</th><th>Late</th><th>Leave</th><th>Excused</th><th>Action</th></tr></thead>
                    <tbody id="attendanceSessionsRows"></tbody>
                </table>
            </div>
            <nav class="d-flex justify-content-between align-items-center" aria-label="Attendance session pages">
                <button id="attendanceSessionsPrevious" type="button" class="btn btn-sm btn-outline-secondary" disabled>Previous</button>
                <span id="attendanceSessionsPage" class="small" aria-live="polite"></span>
                <button id="attendanceSessionsNext" type="button" class="btn btn-sm btn-outline-secondary" disabled>Next</button>
            </nav>
        </section>
        <div class="mt-3 pt-3 border-top">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <h4 class="h6 mb-0">Daily finalized attendance</h4>
                <button id="attendanceDailyCsv" type="button" class="btn btn-sm btn-outline-secondary" disabled>Export daily CSV</button>
            </div>
            <div id="attendanceDailyStatus" class="small text-muted mb-2" role="status" aria-live="polite"></div>
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle">
                    <thead><tr><th>Date</th><th>Marked</th><th>Present</th><th>Absent</th><th>Late</th><th>Leave</th><th>Excused</th><th>Attendance %</th></tr></thead>
                    <tbody id="attendanceDailyRows"></tbody>
                </table>
            </div>
        </div>
    </section>
}


@if (User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("VicePrincipal"))
{
    <section class="content-card mt-3" aria-labelledby="attendanceCorrectionAuditTitle">
        <div class="content-card-heading"><h3 id="attendanceCorrectionAuditTitle">Attendance correction audit</h3></div>
        <div class="row g-2 mb-2 align-items-end">
            <div class="col-md-4">
                <label for="attendanceCorrectionAuditStudent" class="form-label">Find student</label>
                <input id="attendanceCorrectionAuditStudent" class="form-control form-control-sm"
                       maxlength="100" autocomplete="off" placeholder="Roll, code or name prefix" />
            </div>
            <div class="col-md-2">
                <label for="attendanceCorrectionAuditActor" class="form-label">Changed by user ID</label>
                <input id="attendanceCorrectionAuditActor" class="form-control form-control-sm"
                       type="number" min="1" step="1" inputmode="numeric" />
            </div>
            <div class="col-md-3">
                <label for="attendanceCorrectionAuditPreviousState" class="form-label">Previous status</label>
                <select id="attendanceCorrectionAuditPreviousState" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option value="1">Present</option><option value="2">Absent</option>
                    <option value="3">Late</option><option value="4">Leave</option>
                    <option value="5">Excused</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="attendanceCorrectionAuditNewState" class="form-label">New status</label>
                <select id="attendanceCorrectionAuditNewState" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option value="1">Present</option><option value="2">Absent</option>
                    <option value="3">Late</option><option value="4">Leave</option>
                    <option value="5">Excused</option>
                </select>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mb-2">
            <button id="attendanceCorrectionAuditLoad" type="button" class="btn btn-sm btn-primary">Load corrections for report filters</button>
            <button id="attendanceCorrectionAuditCsv" type="button" class="btn btn-sm btn-outline-primary" disabled>Export visible page CSV</button>
        </div>
        <div id="attendanceCorrectionAuditStatus" class="small text-muted" role="status" aria-live="polite"></div>
        <div class="table-responsive">
            <table class="table table-sm table-striped align-middle">
                <thead><tr><th>Attendance date</th><th>Roll</th><th>Student code</th><th>Student</th><th>Subject offering</th><th>Previous</th><th>New</th><th>Reason</th><th>Changed at (UTC)</th><th>Changed by</th></tr></thead>
                <tbody id="attendanceCorrectionAuditRows"></tbody>
            </table>
        </div>
        <nav class="d-flex justify-content-between align-items-center" aria-label="Correction audit pages">
            <button id="attendanceCorrectionAuditPrevious" class="btn btn-sm btn-outline-secondary" type="button" disabled>Previous</button>
            <span id="attendanceCorrectionAuditPage" class="small text-muted" aria-live="polite"></span>
            <button id="attendanceCorrectionAuditNext" class="btn btn-sm btn-outline-secondary" type="button" disabled>Next</button>
        </nav>
    </section>
}

@if (User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("VicePrincipal"))
{

    <div class="modal fade" id="attendanceCorrectionModal" tabindex="-1"
         aria-labelledby="attendanceCorrectionTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="attendanceCorrectionTitle">Audited attendance correction</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="attendanceCorrectionStudent" class="fw-semibold mb-3"></div>
                    <div class="mb-3">
                        <label for="attendanceCorrectionState" class="form-label">Corrected status</label>
                        <select id="attendanceCorrectionState" class="form-select" required>
                            <option value="1">Present</option>
                            <option value="2">Absent</option>
                            <option value="3">Late</option>
                            <option value="4">Leave</option>
                            <option value="5">Excused</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label for="attendanceCorrectionReason" class="form-label">Reason for correction</label>
                        <textarea id="attendanceCorrectionReason" class="form-control" rows="3"
                                  maxlength="1000" required></textarea>
                    </div>
                    <div id="attendanceCorrectionError" class="small text-danger" role="alert" aria-live="polite"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="attendanceCorrectionConfirm" class="btn btn-primary">Save audited correction</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="attendanceCorrectionHistoryModal" tabindex="-1"
         aria-labelledby="attendanceCorrectionHistoryTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="attendanceCorrectionHistoryTitle">Attendance correction history</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p id="attendanceCorrectionHistoryStudent" class="small text-muted"></p>
                    <div id="attendanceCorrectionHistoryStatus" role="status" aria-live="polite"></div>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead><tr><th>Changed at (UTC)</th><th>Previous</th><th>New</th><th>Reason</th><th>Changed by user</th></tr></thead>
                            <tbody id="attendanceCorrectionHistoryRows"></tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <button type="button" id="attendanceHistoryPrevious" class="btn btn-sm btn-outline-secondary">Previous</button>
                        <span id="attendanceHistoryPage" class="small"></span>
                        <button type="button" id="attendanceHistoryNext" class="btn btn-sm btn-outline-secondary">Next</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/attendance/index.js" asp-append-version="true"></script>
    @if (User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("VicePrincipal"))
    {
        <script src="~/js/attendance/correction-history.js" asp-append-version="true"></script>
        <script src="~/js/attendance/report.js" asp-append-version="true"></script>
        <script src="~/js/attendance/session-register.js" asp-append-version="true"></script>
        <script src="~/js/attendance/correction-report.js" asp-append-version="true"></script>
    }
}
