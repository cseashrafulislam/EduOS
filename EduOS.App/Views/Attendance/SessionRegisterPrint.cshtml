@model EduOS.Core.Common.PagedResult<EduOS.Core.DTOs.Attendance.StudentAttendanceSessionRegisterDto>
@using System.Globalization
@{
    Layout = null;
}
<!doctype html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Attendance session register — page @Model.Page</title>
    <style>
        body { font-family: system-ui, sans-serif; color: #17212d; margin: 1rem; }
        h1 { font-size: 1.3rem; margin: 0 0 .5rem; }
        .scope { font-size: .85rem; margin-bottom: 1rem; }
        table { width: 100%; border-collapse: collapse; font-size: .8rem; }
        th, td { border: 1px solid #c7cdd3; padding: .4rem; text-align: left; overflow-wrap: anywhere; }
        th { background: #f1f4f7; }
        .actions { margin-bottom: 1rem; }
        .actions button { padding: .5rem 1rem; cursor: pointer; }
        @@page { size: A4 landscape; margin: 12mm; }
        @@media print { .actions { display: none; } body { margin: 0; } }
    </style>
    <script src="~/js/attendance/print-roster.js" asp-append-version="true" defer></script>
</head>
<body>
    <div class="actions"><button id="printRoster" type="button">Print this page</button></div>
    <h1>Attendance session register</h1>
    <div class="scope">
        Academic batch: @ViewData["BatchId"]
        · @ViewData["FromDate"] to @ViewData["ToDate"]
        · Status: @ViewData["StatusFilter"]
        · Page @Model.Page of @Model.TotalPages
        · Showing @Model.Items.Count of @Model.TotalCount matching sessions
    </div>
    <table>
        <thead><tr><th>Session</th><th>Date</th><th>Offering</th><th>Status</th>
            <th>Marked</th><th>Present</th><th>Absent</th><th>Late</th><th>Leave</th><th>Excused</th></tr></thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.SessionId</td>
                <td>@item.AttendanceDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                <td>@item.SubjectOfferingCode</td>
                <td>@(item.IsFinalized ? "Finalized" : "Draft")</td>
                <td>@item.Marked</td><td>@item.Present</td><td>@item.Absent</td>
                <td>@item.Late</td><td>@item.Leave</td><td>@item.Excused</td>
            </tr>
        }
        </tbody>
    </table>
</body>
</html>
