@{
    var bn = System.Globalization.CultureInfo.CurrentUICulture.Name == "bn-BD";
    ViewData["Title"] = bn ? "কেন্দ্রীয় হিসাব ও অর্থ বিভাগ" : "Central Accounts & Finance";
}
<section class="container-fluid py-3" id="institutionAccountingReports">
    <h2>@(bn ? "কেন্দ্রীয় হিসাব ও অর্থ বিভাগ" : "Central Accounts & Finance")</h2>
    <p class="text-muted">@(bn ? "ফি, বেতন, ক্রয়, সম্পদ ও অন্যান্য বিভাগের হিসাব একটি কেন্দ্রীয় GL থেকে। আলাদা হিসাবখাতা নয়; SaaS সাবস্ক্রিপশন বিলিং এখানে নেই।" : "One institutional General Ledger for fees, payroll, procurement, assets and other operations. No parallel ledgers; SaaS subscription billing is excluded.")</p>
    <p class="small text-muted">@(bn ? "আয়-ব্যয় রিপোর্ট হলো পোস্ট করা উপার্জন ও খরচের হিসাব। বাস্তবে নগদ/ব্যাংকে টাকা আসা-যাওয়া দেখতে Bank Book ব্যবহার করুন; দুটো এক নয়।" : "Income/expense reports show posted earnings and costs; use the Bank Book for actual bank movements. Accrual earnings and cash receipts are not the same.")</p>
    <div id="reportNotice" class="alert d-none" role="alert" aria-live="polite"></div>
    <ul class="nav nav-tabs mb-3">
        @if (User.IsInRole("TenantAdmin"))
        {
            <li class="nav-item"><button type="button" class="nav-link active" data-bs-toggle="tab" data-bs-target="#incomeDetailsPanel">Income &amp; Cost Details</button></li>
        }
        <li class="nav-item"><button type="button" class="nav-link @(!User.IsInRole("TenantAdmin") ? "active" : "")" data-bs-toggle="tab" data-bs-target="#ledgerPanel">General Ledger</button></li>
        <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#trialPanel">Trial Balance</button></li>
        @if (User.IsInRole("TenantAdmin"))
        {
            <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#dayBookPanel">Day Book</button></li>
            <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#incomePanel">Income Statement</button></li>
            <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#balancePanel">Balance Sheet</button></li>
            <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#compareIncomePanel">Income Comparison</button></li>
            <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#compareBalancePanel">Balance Comparison</button></li>
            <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#incomeExpenseBreakdownPanel">Income / Expense Breakdown</button></li>
            <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#sourcePostingAuditPanel">Module Posting Audit</button></li>
            <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#bankBookPanel">Bank Book</button></li>
            <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#bankStatementPanel">Bank Statement Comparison</button></li>
            <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#bankLiquidityPanel">Bank Liquidity</button></li>
        }
    </ul>
    <div class="tab-content">
        @if (User.IsInRole("TenantAdmin"))
        {
            <div class="tab-pane fade" id="sourcePostingAuditPanel">
                <h3 class="h6">Operational Source → Central GL Reconciliation</h3>
                <p class="small text-muted">Read-only source-by-source control. Unposted documents and missing/invalid posted journals need investigation; this report never creates or edits a financial posting.</p>
                <form id="sourceAuditForm" class="row g-2 align-items-end mb-3">
                    <div class="col-md-3"><label for="sourceAuditKind" class="form-label">Source module</label><select id="sourceAuditKind" class="form-select">
                        <option value="fee-invoices">Student Fee Invoices</option><option value="fee-payments">Student Payments</option>
                        <option value="admission-payments">Admission Payments</option><option value="payroll">Payroll Runs</option>
                        <option value="procurement">Procurement Supplier Invoices</option><option value="facilities">Facility Service Bills</option>
                        <option value="assets">Asset Capitalizations</option>
                    </select></div>
                    <div class="col-md-3"><label for="sourceAuditFrom" class="form-label">Source date from</label><input type="date" class="form-control" id="sourceAuditFrom" required /></div>
                    <div class="col-md-3"><label for="sourceAuditTo" class="form-label">Source date to</label><input type="date" class="form-control" id="sourceAuditTo" required /></div>
                    <div class="col-md-2"><button id="sourceAuditRun" class="btn btn-primary w-100" type="submit">Check Postings</button></div>
                    <div class="col-md-1"><button id="sourceAuditCsv" class="btn btn-outline-secondary w-100" type="button" disabled>CSV</button></div>
                </form>
                <div id="sourceAuditSummary" class="small fw-semibold mb-2" aria-live="polite"></div>
                <div class="table-responsive"><table class="table table-sm table-striped">
                    <thead><tr><th>Date</th><th>Source ID</th><th>Document</th><th>Source state</th><th>Campus</th><th class="text-end">Source BDT</th><th>GL Journal</th><th>Posting status</th><th>Finding</th></tr></thead>
                    <tbody id="sourceAuditRows"></tbody>
                </table></div>
                <div class="d-flex justify-content-end gap-2 align-items-center">
                    <button id="sourceAuditPrevious" class="btn btn-outline-secondary btn-sm" type="button" disabled>Previous</button>
                    <span id="sourceAuditPage" class="small" aria-live="polite"></span>
                    <button id="sourceAuditNext" class="btn btn-outline-secondary btn-sm" type="button" disabled>Next</button>
                </div>
            </div>
        }
        @if (User.IsInRole("TenantAdmin"))
        {
            <div class="tab-pane fade show active" id="incomeDetailsPanel">
                <p class="text-muted">@(bn ? "প্রতিটি আয়ের উৎস ও খরচের খাত, মূল জার্নাল, বিভাগীয় উৎস ও রেফারেন্স দেখুন। এখানে শুধু পোস্ট করা GL লাইন আসে; বকেয়া ও অপরিশোধিত লেনদেনের জন্য নিচের Source/Subledger রিপোর্ট দেখুন।" : "Trace every posted revenue and cost to its GL account, source module, journal and reference. Unposted invoices and outstanding balances remain in their source/subledger reports below.")</p>
                <form id="incomeDetailsForm" class="row g-2 align-items-end mb-3">
                    <div class="col-lg-2 col-md-3"><label for="incomeDetailsFrom" class="form-label">From</label><input type="date" id="incomeDetailsFrom" class="form-control" required /></div>
                    <div class="col-lg-2 col-md-3"><label for="incomeDetailsTo" class="form-label">To</label><input type="date" id="incomeDetailsTo" class="form-control" required /></div>
                    <div class="col-lg-2 col-md-3"><label for="incomeDetailsCategory" class="form-label">Transaction type</label><select id="incomeDetailsCategory" class="form-select"><option value="all">All income &amp; expenses</option><option value="income">Income only</option><option value="expense">Expense only</option></select></div>
                    <div class="col-lg-3 col-md-3"><label for="incomeDetailsAccount" class="form-label">GL account</label><select id="incomeDetailsAccount" class="form-select"><option value="">All income / expense accounts</option></select></div>
                    <div class="col-lg-3 col-md-5"><label for="incomeDetailsSource" class="form-label">Journal source (exact, optional)</label><input id="incomeDetailsSource" class="form-control" maxlength="100" placeholder="e.g. PayrollRun" /></div>
                    <div class="col-md-3"><button id="incomeDetailsRun" type="submit" class="btn btn-primary w-100">Run Central Report</button></div>
                    <div class="col-md-3"><button id="incomeDetailsCsv" type="button" class="btn btn-outline-secondary w-100" disabled>Export Visible Page CSV</button></div>
                </form>
                <div class="row g-2 mb-3">
                    <div class="col-md-4"><div class="border rounded p-3 h-100"><div class="small text-muted">Posted Income (BDT)</div><strong id="incomeDetailsIncome" class="h5">—</strong></div></div>
                    <div class="col-md-4"><div class="border rounded p-3 h-100"><div class="small text-muted">Posted Expenses (BDT)</div><strong id="incomeDetailsExpenses" class="h5">—</strong></div></div>
                    <div class="col-md-4"><div class="border rounded p-3 h-100"><div class="small text-muted">Surplus / Deficit (BDT)</div><strong id="incomeDetailsNet" class="h5">—</strong></div></div>
                </div>
                <p id="incomeDetailsSummary" class="small fw-semibold" role="status" aria-live="polite"></p>
                <div class="table-responsive"><table class="table table-sm table-striped">
                    <thead><tr><th>Date</th><th>Type</th><th>GL account</th><th>Source</th><th>Source ID</th><th>Journal</th><th>Reference</th><th>Campus ID</th><th>Description</th><th>Status</th><th class="text-end">Signed Amount BDT</th><th>Details</th></tr></thead>
                    <tbody id="incomeDetailsRows"></tbody>
                </table></div>
                <div class="d-flex align-items-center justify-content-end gap-2">
                    <button id="incomeDetailsPrevious" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous</button>
                    <span id="incomeDetailsPage" class="small" aria-live="polite"></span>
                    <button id="incomeDetailsNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next</button>
                </div>
                <section id="incomeDetailsJournalPanel" class="border rounded p-3 mt-3 d-none" aria-label="Central income or expense source journal">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4 id="incomeDetailsJournalTitle" class="h6 mb-0">Posted journal details</h4>
                        <button id="incomeDetailsJournalClose" class="btn btn-outline-secondary btn-sm" type="button">Close</button>
                    </div>
                    <div class="table-responsive"><table class="table table-sm">
                        <thead><tr><th>Line</th><th>Account code</th><th>Account</th><th>Description</th><th class="text-end">Debit</th><th class="text-end">Credit</th></tr></thead>
                        <tbody id="incomeDetailsJournalRows"></tbody>
                    </table></div>
                </section>
            </div>
        }
        <div class="tab-pane fade @(!User.IsInRole("TenantAdmin") ? "show active" : "")" id="ledgerPanel">
            <form id="ledgerForm" class="row g-2 align-items-end mb-3">
                <div class="col-md-4"><label for="ledgerAccount" class="form-label">Account</label>
                    <select id="ledgerAccount" class="form-select" required><option value="">Loading accounts...</option></select></div>
                <div class="col-md-3"><label for="ledgerFrom" class="form-label">From</label><input type="date" id="ledgerFrom" class="form-control" required /></div>
                <div class="col-md-3"><label for="ledgerTo" class="form-label">To</label><input type="date" id="ledgerTo" class="form-control" required /></div>
                <div class="col-md-2"><button id="ledgerRun" type="submit" class="btn btn-primary w-100">Run Ledger</button></div>
            </form>
            <div class="d-flex justify-content-between mb-2"><strong id="ledgerTitle">Select an account and date range.</strong>
                <button id="ledgerCsv" type="button" class="btn btn-outline-secondary btn-sm" disabled>Export CSV</button></div>
            <div class="table-responsive"><table class="table table-sm table-striped">
                <thead><tr><th>Date</th><th>Journal</th><th>Description</th><th class="text-end">Debit</th><th class="text-end">Credit</th><th class="text-end">Running balance (Dr - Cr)</th></tr></thead>
                <tbody id="ledgerRows"></tbody><tfoot><tr><th colspan="5">Opening balance</th><th id="ledgerOpening" class="text-end"></th></tr>
                    <tr><th colspan="5">Closing balance</th><th id="ledgerClosing" class="text-end"></th></tr></tfoot></table></div>
            @if (User.IsInRole("TenantAdmin"))
            {
                <section class="mt-3 border-top pt-3" id="ledgerAuditPanel" aria-label="Posted journal activity audit">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <h3 class="h6 mb-0">Posted Journal Activity Audit</h3>
                        <div class="d-flex gap-2">
                            <button id="ledgerAuditRun" type="button" class="btn btn-outline-primary btn-sm">Load Activity</button>
                            <button id="ledgerAuditCsv" type="button" class="btn btn-outline-secondary btn-sm" disabled>Export Page CSV</button>
                        </div>
                    </div>
                    <div id="ledgerAuditSummary" class="small fw-semibold mb-2" aria-live="polite"></div>
                    <div class="table-responsive"><table class="table table-sm table-striped">
                        <thead><tr><th>Date</th><th>Journal</th><th>Line</th><th>Campus ID</th><th>Source</th><th>Reference</th><th>Description</th><th>Status</th><th class="text-end">Debit</th><th class="text-end">Credit</th></tr></thead>
                        <tbody id="ledgerAuditRows"></tbody>
                    </table></div>
                    <div class="d-flex align-items-center justify-content-end gap-2">
                        <button id="ledgerAuditPrevious" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous</button>
                        <span id="ledgerAuditPage" class="small" aria-live="polite"></span>
                        <button id="ledgerAuditNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next</button>
                    </div>
                </section>
            }
        </div>
        <div class="tab-pane fade" id="trialPanel">
            <form id="trialForm" class="row g-2 align-items-end mb-3">
                <div class="col-md-3"><label for="trialAsOf" class="form-label">As of date</label><input type="date" id="trialAsOf" class="form-control" required /></div>
                <div class="col-md-3"><button id="trialRun" type="submit" class="btn btn-primary">Run Trial Balance</button></div>
                <div class="col-md-3"><button id="trialCsv" type="button" class="btn btn-outline-secondary" disabled>Export CSV</button></div>
            </form>
            <div class="table-responsive"><table class="table table-sm table-striped">
                <thead><tr><th>Code</th><th>Account</th><th class="text-end">Debit balance</th><th class="text-end">Credit balance</th></tr></thead>
                <tbody id="trialRows"></tbody><tfoot><tr><th colspan="2">Total</th><th id="trialDebit" class="text-end"></th><th id="trialCredit" class="text-end"></th></tr></tfoot></table></div>
        </div>
        @if (User.IsInRole("TenantAdmin"))
        {
            <div class="tab-pane fade" id="dayBookPanel">
                <p class="text-muted">Posted and reversed-original journal entries, including compensating reversals. One row per journal; totals cover the full selected period, independent of page.</p>
                <form id="dayBookForm" class="row g-2 align-items-end mb-3">
                    <div class="col-md-3"><label for="dayBookFrom" class="form-label">From</label><input id="dayBookFrom" type="date" class="form-control" required /></div>
                    <div class="col-md-3"><label for="dayBookTo" class="form-label">To</label><input id="dayBookTo" type="date" class="form-control" required /></div>
                    <div class="col-md-3"><button id="dayBookRun" type="submit" class="btn btn-primary">Run Day Book</button></div>
                    <div class="col-md-3"><button id="dayBookCsv" type="button" class="btn btn-outline-secondary" disabled>Export Page CSV</button></div>
                </form>
                <p id="dayBookSummary" class="fw-semibold" aria-live="polite"></p>
                <div class="table-responsive"><table class="table table-sm table-striped">
                    <thead><tr><th>Date</th><th>Journal</th><th>Campus ID</th><th>Source</th><th>Reference</th><th>Description</th><th>Status</th><th class="text-end">Lines</th><th class="text-end">Debit</th><th class="text-end">Credit</th><th>Action</th></tr></thead>
                    <tbody id="dayBookRows"></tbody>
                    <tfoot><tr><th colspan="8">Full-period total</th><th id="dayBookDebit" class="text-end"></th><th id="dayBookCredit" class="text-end"></th><th></th></tr></tfoot>
                </table></div>
                <div class="d-flex justify-content-end align-items-center gap-2">
                    <button id="dayBookPrevious" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous</button>
                    <span id="dayBookPage" class="small" aria-live="polite"></span>
                    <button id="dayBookNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next</button>
                </div>
                <section id="dayBookDetail" class="border rounded p-3 mt-3 d-none" aria-label="Selected posted journal detail">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4 id="dayBookDetailTitle" class="h6 mb-0">Journal details</h4>
                        <button type="button" id="dayBookDetailClose" class="btn btn-outline-secondary btn-sm">Close</button>
                    </div>
                    <div class="table-responsive"><table class="table table-sm">
                        <thead><tr><th>Line</th><th>Ledger code</th><th>Ledger account</th><th>Description</th><th class="text-end">Debit</th><th class="text-end">Credit</th></tr></thead>
                        <tbody id="dayBookDetailRows"></tbody>
                    </table></div>
                </section>
            </div>
            <div class="tab-pane fade" id="incomePanel">
                <p class="text-muted">Institution-wide BDT income and expenses from posted institutional journals, including compensating reversals. Contra balances may be negative.</p>
                <form id="incomeForm" class="row g-2 align-items-end mb-3">
                    <div class="col-md-3"><label class="form-label" for="incomeFrom">From</label><input id="incomeFrom" type="date" class="form-control" required /></div>
                    <div class="col-md-3"><label class="form-label" for="incomeTo">To</label><input id="incomeTo" type="date" class="form-control" required /></div>
                    <div class="col-md-3"><button id="incomeRun" class="btn btn-primary" type="submit">Run Income Statement</button></div>
                    <div class="col-md-3"><button id="incomeCsv" class="btn btn-outline-secondary" type="button" disabled>Export CSV</button></div>
                </form>
                <div class="table-responsive"><table class="table table-sm table-striped">
                    <thead><tr><th>Account code</th><th>Account name</th><th class="text-end">Amount (BDT)</th></tr></thead>
                    <tbody id="incomeRows"></tbody>
                    <tfoot><tr><th colspan="2">Total income</th><th id="incomeTotal" class="text-end"></th></tr>
                    <tr><th colspan="2">Total expenses</th><th id="expenseTotal" class="text-end"></th></tr>
                    <tr><th colspan="2">Net surplus / (deficit)</th><th id="incomeNet" class="text-end"></th></tr></tfoot>
                </table></div>
            </div>

            <div class="tab-pane fade" id="balancePanel">
                <p class="text-muted">Institution-wide BDT position from all posted journals through the selected date, including reversals. Unclosed lifetime income less expenses is presented separately from posted equity. Signed contra balances are preserved.</p>
                <form id="balanceForm" class="row g-2 align-items-end mb-3">
                    <div class="col-md-3"><label class="form-label" for="balanceAsOf">As of date</label><input id="balanceAsOf" type="date" class="form-control" required /></div>
                    <div class="col-md-3"><button id="balanceRun" class="btn btn-primary" type="submit">Run Balance Sheet</button></div>
                    <div class="col-md-3"><button id="balanceCsv" class="btn btn-outline-secondary" type="button" disabled>Export CSV</button></div>
                </form>
                <div class="table-responsive"><table class="table table-sm table-striped">
                    <thead><tr><th>Account code</th><th>Account name</th><th class="text-end">Amount (BDT)</th></tr></thead>
                    <tbody id="balanceRows"></tbody>
                    <tfoot>
                        <tr><th colspan="2">Total assets</th><th id="balanceAssets" class="text-end"></th></tr>
                        <tr><th colspan="2">Total liabilities</th><th id="balanceLiabilities" class="text-end"></th></tr>
                        <tr><th colspan="2">Posted equity</th><th id="balanceEquity" class="text-end"></th></tr>
                        <tr><th colspan="2">Unclosed net surplus / (deficit)</th><th id="balanceSurplus" class="text-end"></th></tr>
                        <tr><th colspan="2">Liabilities + equity + unclosed surplus</th><th id="balanceRight" class="text-end"></th></tr>
                    </tfoot>
                </table></div>
            </div>

            <div class="tab-pane fade" id="compareIncomePanel">
                <p class="text-muted">Compare two separately reconciled posted-journal income statements. Signed contra accounts and prior-only accounts are included. Variance = current minus comparison.</p>
                <form id="compareIncomeForm" class="row g-2 align-items-end mb-3">
                    <div class="col-md-2"><label for="compareIncomeFrom" class="form-label">Current from</label><input id="compareIncomeFrom" type="date" class="form-control" required /></div>
                    <div class="col-md-2"><label for="compareIncomeTo" class="form-label">Current to</label><input id="compareIncomeTo" type="date" class="form-control" required /></div>
                    <div class="col-md-2"><label for="compareIncomePreviousFrom" class="form-label">Compare from</label><input id="compareIncomePreviousFrom" type="date" class="form-control" required /></div>
                    <div class="col-md-2"><label for="compareIncomePreviousTo" class="form-label">Compare to</label><input id="compareIncomePreviousTo" type="date" class="form-control" required /></div>
                    <div class="col-md-2"><button id="compareIncomeRun" class="btn btn-primary" type="submit">Compare</button></div>
                    <div class="col-md-2"><button id="compareIncomeCsv" class="btn btn-outline-secondary" type="button" disabled>Export CSV</button></div>
                </form>
                <div class="table-responsive"><table class="table table-sm table-striped">
                    <thead><tr><th>Section</th><th>Account code</th><th>Account</th><th class="text-end">Current BDT</th><th class="text-end">Comparison BDT</th><th class="text-end">Variance BDT</th></tr></thead>
                    <tbody id="compareIncomeRows"></tbody><tfoot id="compareIncomeTotals"></tfoot>
                </table></div>
            </div>
            <div class="tab-pane fade" id="compareBalancePanel">
                <p class="text-muted">Compare two independently reconciled balance-sheet dates. Unclosed surplus remains separate from posted equity; it is not counted twice.</p>
                <form id="compareBalanceForm" class="row g-2 align-items-end mb-3">
                    <div class="col-md-3"><label for="compareBalanceAsOf" class="form-label">Current as of</label><input id="compareBalanceAsOf" type="date" class="form-control" required /></div>
                    <div class="col-md-3"><label for="compareBalancePreviousAsOf" class="form-label">Comparison as of</label><input id="compareBalancePreviousAsOf" type="date" class="form-control" required /></div>
                    <div class="col-md-3"><button id="compareBalanceRun" class="btn btn-primary" type="submit">Compare</button></div>
                    <div class="col-md-3"><button id="compareBalanceCsv" class="btn btn-outline-secondary" type="button" disabled>Export CSV</button></div>
                </form>
                <div class="table-responsive"><table class="table table-sm table-striped">
                    <thead><tr><th>Section</th><th>Account code</th><th>Account</th><th class="text-end">Current BDT</th><th class="text-end">Comparison BDT</th><th class="text-end">Variance BDT</th></tr></thead>
                    <tbody id="compareBalanceRows"></tbody><tfoot id="compareBalanceTotals"></tfoot>
                </table></div>
            </div>
            <div class="tab-pane fade" id="incomeExpenseBreakdownPanel">
                <p class="text-muted">Income and expenses from posted GL lines only. Group by recorded campus or journal source; missing campus attribution is shown as Unassigned, never guessed. Totals must reconcile to the Income Statement.</p>
                <form id="breakdownForm" class="row g-2 align-items-end mb-3">
                    <div class="col-md-2"><label for="breakdownFrom" class="form-label">From</label><input id="breakdownFrom" type="date" class="form-control" required /></div>
                    <div class="col-md-2"><label for="breakdownTo" class="form-label">To</label><input id="breakdownTo" type="date" class="form-control" required /></div>
                    <div class="col-md-3"><label for="breakdownGroup" class="form-label">Group by</label><select id="breakdownGroup" class="form-select"><option value="campus">Campus / Unassigned</option><option value="source">Journal Source</option></select></div>
                    <div class="col-md-2"><button id="breakdownRun" type="submit" class="btn btn-primary">Run Breakdown</button></div>
                    <div class="col-md-3"><button id="breakdownCsv" type="button" class="btn btn-outline-secondary" disabled>Export CSV</button></div>
                </form>
                <div class="table-responsive"><table class="table table-sm table-striped">
                    <thead><tr><th>Campus / Source</th><th class="text-end">Income BDT</th><th class="text-end">Expenses BDT</th><th class="text-end">Net surplus BDT</th></tr></thead>
                    <tbody id="breakdownRows"></tbody><tfoot><tr><th>Institution total</th><th id="breakdownIncome" class="text-end"></th><th id="breakdownExpenses" class="text-end"></th><th id="breakdownNet" class="text-end"></th></tr></tfoot>
                </table></div>
            </div>
            <div class="tab-pane fade" id="bankLiquidityPanel">
                <p class="text-muted">Consolidated BDT bank movements, including posted reversals. Internal bank-to-bank transfers are shown separately and cancel in the institution total. Non-bank counterparties can include cash-in-hand transfers, not necessarily external institutional cash flow. This excludes unconfigured cash-in-hand and is NOT a classified cash-flow statement.</p>
                <form id="bankLiquidityForm" class="row g-2 align-items-end mb-3">
                    <div class="col-md-3"><label for="bankLiquidityFrom" class="form-label">From</label><input id="bankLiquidityFrom" type="date" class="form-control" required /></div>
                    <div class="col-md-3"><label for="bankLiquidityTo" class="form-label">To</label><input id="bankLiquidityTo" type="date" class="form-control" required /></div>
                    <div class="col-md-3"><button id="bankLiquidityRun" type="submit" class="btn btn-primary">Run Bank Liquidity</button></div>
                    <div class="col-md-3"><button id="bankLiquidityCsv" type="button" class="btn btn-outline-secondary" disabled>Export CSV</button></div>
                </form>
                <div class="table-responsive"><table class="table table-sm table-striped">
                    <thead><tr><th>Bank / ledger</th><th class="text-end">Opening</th><th class="text-end">Non-bank in</th><th class="text-end">Non-bank out</th><th class="text-end">Transfer in</th><th class="text-end">Transfer out</th><th class="text-end">Closing</th></tr></thead>
                    <tbody id="bankLiquidityRows"></tbody>
                    <tfoot><tr><th>Institution total</th><th id="bankLiquidityOpening" class="text-end"></th><th id="bankLiquidityExternalIn" class="text-end"></th><th id="bankLiquidityExternalOut" class="text-end"></th><th id="bankLiquidityTransferIn" class="text-end"></th><th id="bankLiquidityTransferOut" class="text-end"></th><th id="bankLiquidityClosing" class="text-end"></th></tr></tfoot>
                </table></div>
            </div>


            <div class="tab-pane fade" id="bankStatementPanel">
                <form id="bankStatementForm" class="row g-2 mb-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-4"><label for="statementBank" class="form-label">Bank</label><select id="statementBank" class="form-select" required><option value="">Loading...</option></select></div>
                    <div class="col-md-2"><label for="statementFrom" class="form-label">From</label><input id="statementFrom" type="date" class="form-control" required /></div>
                    <div class="col-md-2"><label for="statementTo" class="form-label">To</label><input id="statementTo" type="date" class="form-control" required /></div>
                    <div class="col-md-2"><label for="statementOpening" class="form-label">Statement opening BDT</label><input id="statementOpening" class="form-control" inputmode="decimal" value="0.00" required /></div>
                    <div class="col-md-2"><label for="statementClosing" class="form-label">Statement closing BDT</label><input id="statementClosing" class="form-control" inputmode="decimal" required /></div>
                    <div class="col-12"><label for="statementCsv" class="form-label">CSV: date,reference,deposit,withdrawal (1–500 rows)</label><textarea id="statementCsv" rows="5" maxlength="80000" class="form-control font-monospace" placeholder="date,reference,deposit,withdrawal&#10;2026-10-15,DEP-1,100.00,0.00" required></textarea></div>
                    <div class="col-md-4"><label for="statementFile" class="form-label">Load local CSV</label><input id="statementFile" type="file" accept=".csv,text/csv" class="form-control" /></div>
                    <div class="col-md-4"><label for="statementIdentifier" class="form-label">Bank statement identifier</label><input id="statementIdentifier" class="form-control" maxlength="100" autocomplete="off" placeholder="Statement number / period" /></div>
                    <div class="col-md-4 d-flex align-items-end gap-2"><button id="statementRun" type="submit" class="btn btn-primary flex-fill">Compare</button><button id="statementSave" type="button" class="btn btn-outline-primary flex-fill" disabled>Save Draft</button></div>
                    <div class="col-12"><button id="statementExport" type="button" class="btn btn-outline-secondary btn-sm" disabled>Export Comparison CSV</button></div>
                </form>
                <section id="bankCandidatePanel" class="border-top pt-3 mb-3" aria-label="Posted bank ledger candidate register">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <h3 class="h6 mb-0">Posted Ledger Candidates</h3>
                        <div class="d-flex gap-2">
                            <button id="bankCandidateRun" type="button" class="btn btn-outline-primary btn-sm">Find Movements</button>
                            <button id="bankCandidateExport" type="button" class="btn btn-outline-secondary btn-sm" disabled>Export Page CSV</button>
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-5"><label for="bankCandidateReference" class="form-label">Reference starts with (optional)</label>
                            <input id="bankCandidateReference" class="form-control form-control-sm" maxlength="100" /></div>
                        <div class="col-md-7 d-flex align-items-end"><div id="bankCandidateSummary" class="small" role="status" aria-live="polite"></div></div>
                    </div>
                    <div class="table-responsive"><table class="table table-sm table-striped">
                        <thead><tr><th>Date</th><th>Journal</th><th>Line ID</th><th>Reference</th><th>Campus</th><th class="text-end">Deposit</th><th class="text-end">Withdrawal</th></tr></thead>
                        <tbody id="bankCandidateRows"></tbody>
                    </table></div>
                    <div class="d-flex justify-content-end align-items-center gap-2">
                        <button id="bankCandidatePrev" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous</button>
                        <span id="bankCandidatePage" class="small" aria-live="polite"></span>
                        <button id="bankCandidateNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next</button>
                    </div>
                </section>
                <section class="border-top pt-3 mb-3" aria-label="Saved bank statement drafts">
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                        <h3 class="h6 mb-0">Saved Statement Drafts</h3>
                        <button id="statementDraftRefresh" type="button" class="btn btn-outline-secondary btn-sm">Refresh</button>
                    </div>
                    <div id="statementDraftSummary" class="small mb-2" role="status" aria-live="polite"></div>
                    <div class="table-responsive"><table class="table table-sm table-striped">
                        <thead><tr><th>Statement</th><th>Period</th><th>Rows</th><th>State</th><th>Prepared</th><th>Action</th></tr></thead>
                        <tbody id="statementDraftRows"></tbody>
                    </table></div>
                    <div class="d-flex justify-content-end align-items-center gap-2">
                        <button id="statementDraftPrev" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous</button>
                        <span id="statementDraftPage" class="small" aria-live="polite"></span>
                        <button id="statementDraftNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next</button>
                    </div>
                    <section id="statementEvidencePanel" class="d-none border-top mt-3 pt-3" aria-label="Historical bank reconciliation evidence">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <h4 class="h6 mb-0">Historical Reconciliation Evidence</h4>
                            <div class="d-flex gap-2">
                                <button id="statementEvidenceCsv" type="button" class="btn btn-outline-secondary btn-sm" disabled>Export Evidence CSV</button>
                                <button id="statementEvidencePrint" type="button" class="btn btn-outline-secondary btn-sm" disabled>Print Evidence</button>
                            </div>
                        </div>
                        <div id="statementEvidenceSummary" class="small fw-semibold mb-2" role="status" aria-live="polite"></div>
                        <div class="table-responsive"><table class="table table-sm table-striped">
                            <thead><tr><th>Row</th><th>Date</th><th>Reference</th><th class="text-end">Deposit</th><th class="text-end">Withdrawal</th><th>Match event</th><th>Ledger line</th><th>Archived version</th></tr></thead>
                            <tbody id="statementEvidenceRows"></tbody>
                        </table></div>
                        <h5 class="h6">Approval &amp; Reversal History</h5>
                        <div class="table-responsive"><table class="table table-sm table-striped">
                            <thead><tr><th>Action</th><th>Actor</th><th>UTC</th><th>Matches</th><th>Evidence SHA-256</th><th>Reason</th></tr></thead>
                            <tbody id="statementEvidenceApprovals"></tbody>
                        </table></div>
                    </section>
                    <div id="statementDraftDetail" class="small" aria-live="polite"></div>
                    <button id="statementDraftExport" type="button" class="btn btn-outline-secondary btn-sm d-none">Export Saved CSV</button>
                    <section id="statementSavedReview" class="d-none border-top mt-3 pt-2" aria-label="Saved statement live reconciliation review">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <h4 class="h6 mb-0">Saved Statement — Live Review</h4>
                            <button id="statementSavedReviewExport" type="button" class="btn btn-outline-secondary btn-sm">Export Review CSV</button>
                        </div>
                        <div id="statementSavedReviewSummary" class="small fw-semibold mb-2" role="status" aria-live="polite"></div>
                        <div class="table-responsive"><table class="table table-sm table-striped">
                            <thead><tr><th>Source</th><th>Date</th><th>Ledger line</th><th>Statement row</th><th>Reference</th><th class="text-end">Deposit</th><th class="text-end">Withdrawal</th><th>Result / Draft action</th></tr></thead>
                            <tbody id="statementSavedReviewRows"></tbody>
                        </table></div>
                        <section class="border-top mt-3 pt-2 mb-3" aria-label="Reconciliation clearance workflow">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                <h5 class="h6 mb-0">Reconciliation Approval &amp; Clearance</h5>
                                <button id="statementApprovalCsv" type="button" class="btn btn-outline-secondary btn-sm" disabled>Export Approval Evidence</button>
                            </div>
                            <div id="statementApprovalSummary" class="small fw-semibold mb-2" role="status" aria-live="polite"></div>
                            <div class="row g-2 mb-2">
                                <div class="col-md-8"><label for="statementApprovalReason" class="form-label">Reversal reason (required for reversal)</label>
                                    <input id="statementApprovalReason" class="form-control form-control-sm" maxlength="250" /></div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <button id="statementApprovalAction" type="button" class="btn btn-outline-primary btn-sm" disabled>Submit</button>
                                </div>
                            </div>
                            <div class="table-responsive"><table class="table table-sm table-striped">
                                <thead><tr><th>Action</th><th>Actor</th><th>Recorded UTC</th><th>Matched</th><th>Evidence hash</th><th>Reason</th></tr></thead>
                                <tbody id="statementApprovalRows"></tbody>
                            </table></div>
                        </section>
                        <section class="border-top mt-3 pt-2" aria-label="Draft matching decisions">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                <h5 class="h6 mb-0">Explicit Draft Matches</h5>
                                <button id="statementMatchHistoryCsv" type="button" class="btn btn-outline-secondary btn-sm" disabled>Export History Page</button>
                            </div>
                            <div id="statementMatchHistorySummary" class="small mb-2" role="status" aria-live="polite"></div>
                            <div class="table-responsive"><table class="table table-sm table-striped">
                                <thead><tr><th>Action</th><th>Statement row</th><th>Ledger line</th><th>Date</th><th>Amount BDT</th><th>Actor</th><th>Recorded UTC</th><th>Action</th></tr></thead>
                                <tbody id="statementMatchHistoryRows"></tbody>
                            </table></div>
                            <div class="d-flex justify-content-end align-items-center gap-2">
                                <button id="statementMatchHistoryPrev" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous</button>
                                <span id="statementMatchHistoryPage" class="small" aria-live="polite"></span>
                                <button id="statementMatchHistoryNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next</button>
                            </div>
                        </section>
                    </section>
                </section>
                <div id="statementNotice" class="alert d-none" role="status" aria-live="polite"></div>
                <p id="statementSummary" class="fw-semibold"></p>
                <div class="table-responsive"><table class="table table-sm table-striped">
                    <thead><tr><th>Source</th><th>Date</th><th>Journal</th><th>Ledger line ID</th><th>Statement row</th><th>Reference</th><th class="text-end">Deposit</th><th class="text-end">Withdrawal</th><th>Reason</th></tr></thead>
                    <tbody id="statementExceptions"></tbody>
                </table></div>
                <details class="mt-2 mb-2">
                    <summary class="btn btn-link btn-sm px-0">Review exact matches (<span id="statementMatchCount">0</span>)</summary>
                    <div class="table-responsive"><table class="table table-sm table-striped">
                        <thead><tr><th>Date</th><th>Journal</th><th>Ledger line ID</th><th>Statement row</th><th>Reference</th><th class="text-end">Deposit</th><th class="text-end">Withdrawal</th></tr></thead>
                        <tbody id="statementMatches"></tbody>
                    </table></div>
                </details>
            </div>
            <div class="tab-pane fade" id="bankBookPanel">
                <p class="text-muted">BDT bank-ledger movements from posted institutional journals, including reversal entries. Bank accounts must have a unique asset-ledger mapping; this is not a classified cash-flow statement.</p>
                <form id="bankBookForm" class="row g-2 align-items-end mb-3">
                    <div class="col-md-4"><label class="form-label" for="bankBookAccount">Bank account</label><select id="bankBookAccount" class="form-select" required><option value="">Loading banks...</option></select></div>
                    <div class="col-md-2"><label class="form-label" for="bankBookFrom">From</label><input id="bankBookFrom" type="date" class="form-control" required /></div>
                    <div class="col-md-2"><label class="form-label" for="bankBookTo">To</label><input id="bankBookTo" type="date" class="form-control" required /></div>
                    <div class="col-md-2"><button id="bankBookRun" class="btn btn-primary" type="submit">Run Bank Book</button></div>
                    <div class="col-md-2"><button id="bankBookCsv" class="btn btn-outline-secondary" type="button" disabled>Export CSV</button></div>
                </form>
                <strong id="bankBookTitle"></strong>
                <div class="table-responsive"><table class="table table-sm table-striped">
                    <thead><tr><th>Date</th><th>Journal</th><th>Source</th><th>Reference</th><th>Description</th><th class="text-end">Deposit</th><th class="text-end">Withdrawal</th><th class="text-end">Balance</th></tr></thead>
                    <tbody id="bankBookRows"></tbody>
                    <tfoot>
                        <tr><th colspan="7">Opening balance</th><th id="bankBookOpening" class="text-end"></th></tr>
                        <tr><th colspan="7">Total deposits</th><th id="bankBookInflows" class="text-end"></th></tr>
                        <tr><th colspan="7">Total withdrawals</th><th id="bankBookOutflows" class="text-end"></th></tr>
                        <tr><th colspan="7">Closing balance</th><th id="bankBookClosing" class="text-end"></th></tr>
                    </tfoot>
                </table></div>
            </div>
        }
    </div>
    @if (User.IsInRole("TenantAdmin"))
    {
        <section class="border rounded p-3 mt-4" aria-label="Related accounting subledger reports">
            <h3 class="h6">Related Source / Subledger Reports</h3>
            <p class="small text-muted mb-2">Fees, supplier invoices, payroll and facilities retain their own source-level reports. Their posted amounts must reconcile to the canonical journal ledger; availability depends on the enabled module.</p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary btn-sm" href="/AccountingJournals/Index">Journal / Voucher Register</a>
                <a class="btn btn-outline-secondary btn-sm" href="/FeeReceivablesAging/Index">Fee Receivables Aging</a>
                <a class="btn btn-outline-secondary btn-sm" href="/FeeOperations/Ledger">Student Fee Collection</a>
                <a class="btn btn-outline-secondary btn-sm" href="/ProcurementSupplierInvoiceMatching/Index">Supplier Payables &amp; Aging</a>
                <a class="btn btn-outline-secondary btn-sm" href="/FacilityCosts/Index">Facilities Supplier Bills</a>
                <a class="btn btn-outline-secondary btn-sm" href="/PayrollReconciliation/Index">Payroll Reconciliation</a>
                <a class="btn btn-outline-secondary btn-sm" href="/AccountingSetup/Index">Chart of Accounts &amp; Periods</a>
            </div>
        </section>
    }
</section>
@section Scripts { <script src="~/js/platform/task-workspace-locales.js" asp-append-version="true"></script><script type="module" src="~/js/finance/bank-reconciliation-candidates.js" asp-append-version="true"></script>
<script type="module" src="~/js/finance/accounting-reports.js" asp-append-version="true"></script>
<script type="module" src="~/js/finance/accounting-additional-reports.js" asp-append-version="true"></script>
<script type="module" src="~/js/finance/bank-statement-preview.js" asp-append-version="true"></script> }
