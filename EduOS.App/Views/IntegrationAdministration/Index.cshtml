@{ ViewData["Title"] = "Integration Administration"; }
<div class="container-fluid py-3">
    <h2>Integration Administration</h2>
    <p class="text-muted">Tenant-scoped webhook configuration, delivery history and API credential lifecycle.</p>
    <div class="alert alert-warning" role="note">Outbound webhook dispatch and API-key authentication are not enabled by this administration page. Transport and authentication require a separate reviewed integration.</div>
    <div id="iaNotice" class="alert d-none" role="alert"></div>
    <div class="card mb-3"><div class="card-body">
        <h4>Webhook endpoints</h4>
        <div class="table-responsive"><table class="table table-striped table-sm">
            <thead><tr><th>Name</th><th>HTTPS destination</th><th>Events</th><th>Secret</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody id="iaWebhookRows"></tbody></table></div>
        <div class="d-flex gap-2 align-items-center">
            <button id="iaWebhookPrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
            <span id="iaWebhookPage"></span>
            <button id="iaWebhookNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
        </div>
    </div></div>
    <div class="card mb-3"><div class="card-body">
        <h4>Add / edit webhook</h4>
        <form id="iaWebhookForm">
            @Html.AntiForgeryToken()
            <input id="iaWebhookId" type="hidden" /><input id="iaWebhookVersion" type="hidden" />
            <div class="row g-2">
                <div class="col-md-3"><label class="form-label" for="iaWebhookName">Name</label>
                    <input id="iaWebhookName" class="form-control" maxlength="150" required /></div>
                <div class="col-md-5"><label class="form-label" for="iaWebhookUrl">Public HTTPS URL (port 443, no query)</label>
                    <input id="iaWebhookUrl" class="form-control" type="url" maxlength="1000" placeholder="https://hooks.example.org/eduos" required /></div>
                <div class="col-md-4"><label class="form-label" for="iaWebhookEvents">Event codes (comma separated)</label>
                    <input id="iaWebhookEvents" class="form-control" maxlength="1000" placeholder="STUDENT.CREATED, PAYMENT.POSTED" required /></div>
                <div class="col-md-5"><label class="form-label" for="iaWebhookSecret">Signing secret (min 16 characters)</label>
                    <input id="iaWebhookSecret" class="form-control" type="password" maxlength="256" autocomplete="new-password" />
                    <small class="text-muted">Leave blank on edit to retain existing protected secret. Never displayed after save.</small></div>
                <div class="col-md-3"><label class="form-label" for="iaWebhookActive">Status</label>
                    <select id="iaWebhookActive" class="form-select"><option value="true">Active configuration</option><option value="false">Inactive</option></select></div>
                <div class="col-md-4 d-flex align-items-center"><label class="form-check-label">
                    <input id="iaWebhookClear" class="form-check-input" type="checkbox" /> Clear secret (inactive only)</label></div>
            </div>
            <div class="mt-3 d-flex gap-2"><button class="btn btn-primary" type="submit">Save webhook</button>
                <button id="iaWebhookReset" type="button" class="btn btn-outline-secondary">Reset</button></div>
        </form>
    </div></div>
    <div class="card mb-3"><div class="card-body">
        <h4>Delivery history <small id="iaDeliveryFor" class="text-muted"></small></h4>
        <div class="table-responsive"><table class="table table-sm table-striped">
            <thead><tr><th>Event</th><th>Event ID</th><th>State</th><th>Attempts</th><th>Last attempt</th><th>Next attempt</th><th>Failure</th></tr></thead>
            <tbody id="iaDeliveryRows"></tbody></table></div>
        <div class="d-flex gap-2 align-items-center">
            <button id="iaDeliveryPrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
            <span id="iaDeliveryPage"></span>
            <button id="iaDeliveryNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
        </div>
    </div></div>
    <div class="card mb-3"><div class="card-body">
        <h4>API credentials</h4>
        <div class="table-responsive"><table class="table table-sm table-striped">
            <thead><tr><th>Name</th><th>Prefix</th><th>Scopes</th><th>Expiry</th><th>Last used</th><th>Status</th><th></th></tr></thead>
            <tbody id="iaCredentialRows"></tbody></table></div>
        <div class="d-flex gap-2 align-items-center">
            <button id="iaCredentialPrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
            <span id="iaCredentialPage"></span>
            <button id="iaCredentialNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
        </div>
        <hr />
        <h5>Create API credential</h5>
        <form id="iaCredentialForm">
            <div class="row g-2">
                <div class="col-md-4"><label class="form-label" for="iaCredentialName">Name</label>
                    <input id="iaCredentialName" class="form-control" maxlength="150" required /></div>
                <div class="col-md-4"><label class="form-label" for="iaCredentialScopes">Scopes (comma separated)</label>
                    <input id="iaCredentialScopes" class="form-control" maxlength="1000" value="integration:read" required /></div>
                <div class="col-md-4"><label class="form-label" for="iaCredentialExpiry">Expires at (optional)</label>
                    <input id="iaCredentialExpiry" class="form-control" type="datetime-local" /></div>
            </div>
            <button class="btn btn-primary mt-3" type="submit">Generate credential</button>
        </form>
        <div id="iaKeyPanel" class="alert alert-success mt-3 d-none" role="status">
            <strong>Copy this key now. It will never be displayed again.</strong>
            <pre id="iaOneTimeKey" class="mt-2 mb-0 text-break" style="white-space:pre-wrap"></pre>
            <button id="iaHideKey" type="button" class="btn btn-outline-secondary btn-sm mt-2">Hide key</button>
        </div>
    </div></div>
</div>
@section Scripts { <script src="~/js/integration-admin/admin.js" asp-append-version="true"></script> }
