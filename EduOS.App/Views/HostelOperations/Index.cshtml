@{
    ViewData["Title"] = "Hostel";
    var canManage = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("HostelWarden");
}
<section class="container-fluid py-3" aria-labelledby="hostelTitle">
    <header class="mb-3"><h2 id="hostelTitle">Hostel operations</h2><p class="text-muted">Tenant-scoped rooms, bed allocation and release.</p>@if (canManage) { <a class="btn btn-outline-secondary btn-sm" href="#hostelHistoryPanel">Allocation history</a> }</header>
    <div id="hostelAlert" class="d-none" role="alert" tabindex="-1"></div>
    <section class="card mb-3"><div class="card-body"><h3 class="h5">My current allocation</h3><div id="hostelMine" class="text-muted">Loading…</div></div></section>
    @if (canManage)
    {
    <section class="card mb-3"><div class="card-body">
        <h3 class="h5">Rooms and occupancy</h3>
        <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Hostel</th><th>Room</th><th>Capacity</th><th>Occupied</th><th>Rent per bed</th></tr></thead>
        <tbody id="hostelRoomRows"><tr><td colspan="5">Loading rooms…</td></tr></tbody></table></div>
    </div></section>
    }
    @if (canManage)
    {
        <section class="card mb-3"><div class="card-body">
            <h3 class="h5">Allocate a bed</h3>
            <form id="hostelAllocationForm" class="row g-3">
                <div class="col-md-6"><label for="hostelStudentSearch" class="form-label">Find student</label><input id="hostelStudentSearch" class="form-control" maxlength="100" placeholder="Name or student code" /></div>
                <div class="col-md-6 d-flex align-items-end gap-2"><button id="hostelFindStudents" type="button" class="btn btn-outline-primary">Find</button><button id="hostelNextStudent" type="button" class="btn btn-outline-secondary">Next page</button></div>
                <div class="col-12"><label for="hostelStudent" class="form-label">Student enrollment</label><select id="hostelStudent" class="form-select" required><option value="">Choose student</option></select></div>
                <div class="col-md-6"><label for="hostelBedSearch" class="form-label">Find available bed</label><input id="hostelBedSearch" class="form-control" maxlength="100" placeholder="Hostel or room" /></div>
                <div class="col-md-6 d-flex align-items-end gap-2"><button id="hostelFindBeds" type="button" class="btn btn-outline-primary">Find</button><button id="hostelNextBed" type="button" class="btn btn-outline-secondary">Next page</button></div>
                <div class="col-12"><label for="hostelBed" class="form-label">Unoccupied bed</label><select id="hostelBed" class="form-select" required><option value="">Choose bed</option></select></div>
                <div class="col-md-6"><label for="hostelStart" class="form-label">Start date</label><input id="hostelStart" type="date" class="form-control" required /></div>
                <div class="col-md-6"><label for="hostelRent" class="form-label">Monthly rent (optional)</label><input id="hostelRent" type="number" min="0" step="0.01" class="form-control" placeholder="Use room default" /></div>
                <div class="col-12"><button id="hostelAllocate" class="btn btn-primary" type="submit">Allocate bed</button></div>
            </form>
            <p class="small text-muted mt-2 mb-0">The service validates tenant, campus, student eligibility, occupancy, gender restriction and capacity before allocating.</p>
        </div></section>
        <section class="card"><div class="card-body">
            <h3 class="h5">Active allocations</h3>
            <p class="small text-muted">Future reservations can be cancelled before arrival. Started allocations must be closed. Cancellation releases the bed without changing payment records.</p>
            <form id="hostelAllocationSearch" class="d-flex gap-2"><input id="hostelAllocationTerm" maxlength="100" class="form-control" placeholder="Search student" /><button type="submit" class="btn btn-outline-primary">Search</button></form>
            <div class="table-responsive mt-3"><table class="table table-hover align-middle"><thead><tr><th>Student</th><th>Hostel</th><th>Room / Bed</th><th>Start</th><th>Action</th></tr></thead>
                <tbody id="hostelActiveRows"><tr><td colspan="5">Loading…</td></tr></tbody></table></div>
            <section id="hostelBedMovePanel" class="border rounded p-3 mt-3 d-none" aria-labelledby="hostelBedMoveTitle">
                <h4 id="hostelBedMoveTitle" class="h6">Change bed before arrival (same room only)</h4>
                <p id="hostelBedMoveContext" class="small text-muted"></p>
                <label for="hostelBedMoveTarget" class="form-label">Available bed</label>
                <select id="hostelBedMoveTarget" class="form-select mb-2"><option value="">Select a bed</option></select>
                <p id="hostelBedMovePageInfo" class="small text-muted" role="status" aria-live="polite"></p>
                <div class="d-flex gap-2 flex-wrap">
                    <button id="hostelBedMovePrev" type="button" class="btn btn-outline-secondary btn-sm">Previous beds</button>
                    <button id="hostelBedMoveNext" type="button" class="btn btn-outline-secondary btn-sm">Next beds</button>
                    <button id="hostelBedMoveSave" type="button" class="btn btn-primary btn-sm">Confirm bed change</button>
                    <button id="hostelBedMoveCancel" type="button" class="btn btn-outline-secondary btn-sm">Cancel</button>
                </div>
            </section>
            <section id="hostelRoomMovePanel" class="border rounded p-3 mt-3 d-none" aria-labelledby="hostelRoomMoveTitle">
                <h4 id="hostelRoomMoveTitle" class="h6">Change room before arrival (same hostel and tariff)</h4>
                <p id="hostelRoomMoveContext" class="small text-muted"></p>
                <label for="hostelRoomMoveTarget" class="form-label">Available room and bed</label>
                <select id="hostelRoomMoveTarget" class="form-select mb-2"><option value="">Select a room and bed</option></select>
                <p id="hostelRoomMovePageInfo" class="small text-muted" role="status" aria-live="polite"></p>
                <div class="d-flex gap-2 flex-wrap">
                    <button id="hostelRoomMovePrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
                    <button id="hostelRoomMoveNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
                    <button id="hostelRoomMoveSave" type="button" class="btn btn-primary btn-sm">Confirm room change</button>
                    <button id="hostelRoomMoveCancel" type="button" class="btn btn-outline-secondary btn-sm">Cancel</button>
                </div>
            </section>
            <div class="d-flex gap-3 justify-content-between align-items-center"><button id="hostelPrev" class="btn btn-outline-secondary btn-sm" type="button">Previous</button><span id="hostelPageInfo" class="small text-muted"></span><button id="hostelNext" class="btn btn-outline-secondary btn-sm" type="button">Next</button></div>
        </div></section>
    }

    @if (canManage)
    {
        @await Html.PartialAsync("_AllocationHistory")
        @await Html.PartialAsync("_AllocationReadiness")
        @await Html.PartialAsync("_OccupancyInsights")
        @await Html.PartialAsync("_TurnoverReport")
        <section id="hostelCapacityPanel" class="card mb-3"><div class="card-body">
            <h3 class="h5">Capacity and occupancy report</h3>
            <p class="small text-muted">Campus-authorized room inventory only. Use Needs review to triage occupancy, inactive-bed and provisioning risks before pagination. Risk-only mode requires at most 1,000 matching candidate rooms; narrow the campus/search if needed. CSV excludes student identifiers and payments.</p>
            <form id="hostelCapacityFilter" class="row g-2 mb-2">
                <div class="col-md-3"><label class="visually-hidden" for="hostelCapacityCampus">Campus</label>
                    <select id="hostelCapacityCampus" class="form-select" aria-label="Filter hostel capacity by campus"><option value="">All permitted campuses</option></select></div>
                <div class="col-md-4"><label class="visually-hidden" for="hostelCapacitySearch">Search hostel or room</label>
                    <input id="hostelCapacitySearch" class="form-control" maxlength="100" placeholder="Hostel or room" /></div>
                <div class="col-md-2 d-flex align-items-center"><div class="form-check">
                    <input id="hostelCapacityAttentionOnly" class="form-check-input" type="checkbox" />
                    <label class="form-check-label" for="hostelCapacityAttentionOnly">Needs review</label>
                </div></div>
                <div class="col-md-3 d-flex gap-2 flex-wrap">
                    <button class="btn btn-outline-primary" type="submit">Filter</button>
                    <button id="hostelCapacityCsv" class="btn btn-outline-secondary" type="button" disabled>Export all filtered rooms (CSV)</button>
                </div>
            </form>
            <div id="hostelCapacityStatus" class="small text-muted" role="status" aria-live="polite"></div>
            <div class="table-responsive"><table class="table table-sm table-hover">
                <thead><tr><th>Hostel</th><th>Room</th><th>Capacity</th><th>Active beds</th><th>Occupied</th><th>Available</th><th>Inactive beds</th><th>Risk</th></tr></thead>
                <tbody id="hostelCapacityRows"></tbody>
            </table></div>
            <div class="d-flex align-items-center justify-content-between">
                <button id="hostelCapacityPrev" class="btn btn-outline-secondary btn-sm" type="button">Previous</button>
                <span id="hostelCapacityPage" class="small text-muted"></span>
                <button id="hostelCapacityNext" class="btn btn-outline-secondary btn-sm" type="button">Next</button>
            </div>
        </div></section>
    }
    @if (canManage)
    {
        <section id="hostelRoomCreatePanel" class="card mb-3"><div class="card-body">
            <h3 class="h5">Create hostel room</h3>
            <p class="small text-muted">Select an active, campus-authorized facility. Pricing is managed separately by Finance.</p>
            <form id="hostelRoomFacilitySearchForm" class="row g-2 mb-2">
                <div class="col-md-8"><label class="form-label" for="hostelRoomFacilitySearch">Find facility</label>
                    <input id="hostelRoomFacilitySearch" class="form-control" maxlength="100" placeholder="Facility, campus or code" /></div>
                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-outline-secondary">Find</button>
                    <button id="hostelRoomFacilityNext" type="button" class="btn btn-outline-secondary">More</button>
                </div>
            </form>
            <form id="hostelRoomCreateForm" class="row g-2 mb-2">
                <div class="col-md-6"><label class="form-label" for="hostelRoomFacilitySelect">Facility</label>
                    <select id="hostelRoomFacilitySelect" class="form-select" required><option value="">Find an active facility</option></select></div>
                <div class="col-md-3"><label class="form-label" for="hostelRoomNewNumber">Room number</label>
                    <input id="hostelRoomNewNumber" class="form-control" maxlength="50" required /></div>
                <div class="col-md-2"><label class="form-label" for="hostelRoomNewCapacity">Capacity</label>
                    <input id="hostelRoomNewCapacity" type="number" class="form-control" min="1" max="1000" step="1" required /></div>
                <div class="col-md-1 d-flex align-items-end"><button id="hostelRoomCreateButton" class="btn btn-primary" type="submit">Create</button></div>
            </form>
            <div id="hostelRoomCreateStatus" class="small text-muted" role="status" aria-live="polite"></div>
        </div></section>
        <section id="hostelRoomCapacityPanel" class="card mb-3"><div class="card-body">
            <h3 class="h5">Edit room capacity</h3>
            <p class="small text-muted">Capacity cannot be reduced below physical beds or occupied beds. Room rent is not changed.</p>
            <div class="d-flex gap-2 mb-2">
                <input id="hostelRoomCapacitySearch" type="search" maxlength="100" class="form-control" placeholder="Search hostel or room" aria-label="Find room to edit capacity" />
                <button id="hostelCapacityFind" type="button" class="btn btn-outline-secondary">Find rooms</button>
            </div>
            <form id="hostelCapacityForm" class="row g-2">
                <div class="col-md-7"><label for="hostelCapacityRoom" class="form-label">Room</label><select id="hostelCapacityRoom" class="form-select" required><option value="">Loading rooms…</option></select></div>
                <div class="col-md-3"><label for="hostelCapacityValue" class="form-label">New capacity</label><input id="hostelCapacityValue" class="form-control" type="number" min="1" max="1000" step="1" required /></div>
                <div class="col-md-2 d-flex align-items-end"><button id="hostelCapacitySave" type="submit" class="btn btn-primary w-100">Save capacity</button></div>
            </form>
            <div id="hostelRoomCapacityStatus" class="small text-muted mt-2" role="status" aria-live="polite"></div>
        </div></section>
        <section id="hostelRoomInventoryPanel" class="card mb-3"><div class="card-body">
            <h3 class="h5">Room inventory and controlled closure</h3>
            <p class="small text-muted">Rooms with active allocations cannot be closed. Room status does not modify rent.</p>
            <form id="hostelRoomInventoryFilter" class="d-flex gap-2 mb-2 flex-wrap">
                <select id="hostelRoomInventoryCampus" class="form-select" aria-label="Filter room inventory by campus">
                    <option value="">All permitted campuses</option>
                </select>
                <input id="hostelRoomInventorySearch" class="form-control" maxlength="100" aria-label="Search hostel rooms" placeholder="Hostel or room" />
                <button type="submit" class="btn btn-outline-primary">Search</button>
                <button id="hostelRoomInventoryCsv" type="button" class="btn btn-outline-secondary" disabled>Export filtered rooms (CSV)</button>
            </form>
            <div id="hostelRoomInventoryStatus" role="status" aria-live="polite" class="small text-muted"></div>
            <div class="table-responsive"><table class="table table-sm table-hover">
                <thead><tr><th>Hostel</th><th>Room</th><th>Capacity</th><th>Active beds</th><th>Occupied today</th><th>Active reservations</th><th>Status</th><th>Action</th></tr></thead>
                <tbody id="hostelRoomInventoryRows"></tbody>
            </table></div>
            <div class="d-flex justify-content-between align-items-center">
                <button id="hostelRoomInventoryPrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
                <span id="hostelRoomInventoryPage" class="small text-muted"></span>
                <button id="hostelRoomInventoryNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
            </div>
        </div></section>
    }
    @if (canManage)
    {
        <section id="hostelBedCreatePanel" class="card mb-3"><div class="card-body">
            <h3 class="h5">Create hostel bed</h3>
            <p class="small text-muted">Choose an active campus-authorized room. Physical bed count cannot exceed room capacity; existing beds are never duplicated.</p>
            <form id="hostelBedCreateSearchForm" class="row g-2 mb-2">
                <div class="col-md-8"><label for="hostelBedCreateSearch" class="form-label">Find room</label>
                    <input id="hostelBedCreateSearch" class="form-control" maxlength="100" placeholder="Hostel or room" /></div>
                <div class="col-md-4 d-flex align-items-end gap-2"><button class="btn btn-outline-secondary" type="submit">Search</button>
                    <button id="hostelBedCreateMore" class="btn btn-outline-secondary" type="button">More</button></div>
            </form>
            <form id="hostelBedCreateForm" class="row g-2 mb-2">
                <div class="col-md-7"><label for="hostelBedCreateRoom" class="form-label">Room</label>
                    <select id="hostelBedCreateRoom" class="form-select" required><option value="">Find an active room</option></select></div>
                <div class="col-md-3"><label for="hostelBedNewNumber" class="form-label">Bed number</label>
                    <input id="hostelBedNewNumber" class="form-control" maxlength="50" required /></div>
                <div class="col-md-2 d-flex align-items-end"><button id="hostelBedCreateButton" class="btn btn-primary" type="submit">Create bed</button></div>
            </form>
            <div id="hostelBedCreateStatus" class="small text-muted" role="status" aria-live="polite"></div>
        </div></section>
    }
    @if (canManage)
    {
        <section id="hostelBedInventoryPanel" class="card mb-3"><div class="card-body">
            <h3 class="h5">Bed inventory and controlled closure</h3>
            <p class="small text-muted">Only unoccupied beds can be deactivated. Campus access and room capacity are enforced server-side.</p>
            <form id="hostelBedInventoryFilter" class="d-flex gap-2 mb-2">
                <input id="hostelBedInventorySearch" class="form-control" maxlength="100" aria-label="Search beds" placeholder="Hostel, room or bed" />
                <button class="btn btn-outline-primary" type="submit">Search</button>
            </form>
            <div id="hostelBedInventoryStatus" role="status" aria-live="polite" class="small text-muted"></div>
            <div class="table-responsive"><table class="table table-sm table-hover">
                <thead><tr><th>Hostel</th><th>Room</th><th>Bed</th><th>State</th><th>Occupied today</th><th>Active reservations</th><th>Action</th></tr></thead>
                <tbody id="hostelBedInventoryRows"></tbody>
            </table></div>
            <div class="d-flex justify-content-between align-items-center">
                <button id="hostelBedInventoryPrev" class="btn btn-outline-secondary btn-sm" type="button">Previous</button>
                <span id="hostelBedInventoryPage" class="small text-muted"></span>
                <button id="hostelBedInventoryNext" class="btn btn-outline-secondary btn-sm" type="button">Next</button>
            </div>
        </div></section>
    }
    @if (canManage)
    {
        <section id="hostelFacilityPanel" class="card mb-3"><div class="card-body">
            <h3 class="h5">Hostel facilities and controlled closure</h3>
            <p class="small text-muted">Create campus-authorized facilities. Deactivation requires every room and allocation to be closed. No financial settings are changed.</p>
            <form id="hostelFacilityCreate" class="row g-2 mb-3">
                <div class="col-md-3"><label class="form-label" for="hostelFacilityCampus">Campus</label><select id="hostelFacilityCampus" class="form-select" required><option value="">Loading campuses…</option></select></div>
                <div class="col-md-3"><label class="form-label" for="hostelFacilityName">Facility name</label><input id="hostelFacilityName" class="form-control" maxlength="150" minlength="2" required /></div>
                <div class="col-md-2"><label class="form-label" for="hostelFacilityCode">Code</label><input id="hostelFacilityCode" class="form-control" maxlength="50" minlength="2" required /></div>
                <div class="col-md-2"><label class="form-label" for="hostelFacilityGender">Restriction</label><select id="hostelFacilityGender" class="form-select"><option value="">None</option><option value="Male">Male</option><option value="Female">Female</option><option value="Other">Other</option></select></div>
                <div class="col-md-2"><label class="form-label" for="hostelFacilityAddress">Address</label><input id="hostelFacilityAddress" class="form-control" maxlength="500" /></div>
                <div class="col-12"><button id="hostelFacilityCreateButton" type="submit" class="btn btn-primary">Create facility</button></div>
            </form>
            <form id="hostelFacilityEdit" class="row g-2 mb-3 border rounded p-3 d-none">
                <div class="col-12"><h4 class="h6">Edit facility details</h4>
                    <p class="small text-muted mb-0">Campus and code are fixed. Changing gender restriction requires all active allocations to be closed.</p></div>
                <div class="col-md-4"><label class="form-label" for="hostelFacilityEditName">Facility name</label>
                    <input id="hostelFacilityEditName" class="form-control" maxlength="150" minlength="2" required /></div>
                <div class="col-md-3"><label class="form-label" for="hostelFacilityEditGender">Gender restriction</label>
                    <select id="hostelFacilityEditGender" class="form-select"><option value="">None</option><option value="Male">Male</option><option value="Female">Female</option><option value="Other">Other</option></select></div>
                <div class="col-md-5"><label class="form-label" for="hostelFacilityEditAddress">Address</label>
                    <input id="hostelFacilityEditAddress" class="form-control" maxlength="500" /></div>
                <div class="col-12 small text-muted" id="hostelFacilityEditIdentity"></div>
                <div class="col-12 d-flex gap-2"><button id="hostelFacilityEditSave" type="submit" class="btn btn-primary">Save changes</button>
                    <button id="hostelFacilityEditCancel" type="button" class="btn btn-outline-secondary">Cancel</button></div>
            </form>
            <form id="hostelFacilityFilter" class="d-flex gap-2 mb-2">
                <input id="hostelFacilitySearch" class="form-control" maxlength="100" aria-label="Search facilities" placeholder="Campus, facility or code" />
                <button type="submit" class="btn btn-outline-primary">Search</button>
            </form>
            <div id="hostelFacilityStatus" class="small text-muted" role="status" aria-live="polite"></div>
            <div class="table-responsive"><table class="table table-sm table-hover">
                <thead><tr><th>Campus</th><th>Facility</th><th>Code</th><th>Active rooms</th><th>Occupied today</th><th>Active reservations</th><th>Status</th><th>Action</th></tr></thead>
                <tbody id="hostelFacilityRows"></tbody>
            </table></div>
            <div class="d-flex justify-content-between align-items-center">
                <button id="hostelFacilityPrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button>
                <span id="hostelFacilityPage" class="small text-muted"></span>
                <button id="hostelFacilityNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button>
            </div>
        </div></section>
    }
</section>
@section Scripts {
    <script src="~/js/hostel-operations/index.js" asp-append-version="true"></script>
    @if (canManage) {
        <script src="~/js/hostel-operations/upcoming-room-change.js" asp-append-version="true"></script>
        <script src="~/js/hostel-operations/capacity.js" asp-append-version="true"></script>
        <script src="~/js/hostel-operations/occupancy-insights.js" asp-append-version="true"></script>
        <script src="~/js/hostel-operations/turnover-report.js" asp-append-version="true"></script>
        <script src="~/js/hostel-operations/bed-create.js" asp-append-version="true"></script>
        <script src="~/js/hostel-operations/bed-inventory.js" asp-append-version="true"></script>
        <script src="~/js/hostel-operations/room-inventory.js" asp-append-version="true"></script>
        <script src="~/js/hostel-operations/room-capacity.js" asp-append-version="true"></script>
        <script src="~/js/hostel-operations/room-create.js" asp-append-version="true"></script>
        <script src="~/js/hostel-operations/facilities.js" asp-append-version="true"></script>
        <script src="~/js/hostel-operations/allocation-history.js" asp-append-version="true"></script>
        <script src="~/js/hostel-operations/allocation-readiness.js" asp-append-version="true"></script>
    }
}
