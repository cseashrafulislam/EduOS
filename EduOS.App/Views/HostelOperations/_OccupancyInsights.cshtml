<section class="card mb-3" id="hostelOccupancyInsightsPanel"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center gap-2">
        <div><h3 class="h5 mb-1">Hostel occupancy and capacity risk</h3>
            <p class="small text-muted mb-0">Uses the capacity report search filter and campus permissions. Aggregate counts only; no student or payment data.</p></div>
        @if (User.IsInRole("TenantAdmin") || User.IsInRole("Principal"))
        {
            <a href="/OperationsInsights/Index" class="btn btn-outline-secondary btn-sm">Combined insights</a>
        }
        <div class="d-flex gap-2"><button id="hostelOccupancyInsightsExport" class="btn btn-outline-success btn-sm" type="button" disabled>Export CSV</button><button id="hostelOccupancyInsightsRefresh" class="btn btn-outline-primary btn-sm" type="button">Refresh</button></div>
    </div>
    <div id="hostelOccupancyInsightsStatus" role="status" aria-live="polite" class="small text-muted mt-2">Loading…</div>
    <div id="hostelOccupancyInsightsMetrics" class="row row-cols-2 row-cols-md-4 g-2 mt-1" aria-label="Hostel occupancy metrics"></div>
</div></section>
