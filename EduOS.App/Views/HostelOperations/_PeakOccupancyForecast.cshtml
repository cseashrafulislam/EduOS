<section class="card mb-3" id="hostelPeakOccupancyPanel"><div class="card-body">
    <h3 class="h5">Peak room occupancy over a future period</h3>
    <p class="small text-muted">Advisory 1–90 day forecast from existing room, bed and allocation history. Peak is concurrent reserved beds, not the total distinct beds used over the period. No student or billing data. Recheck availability before allocating.</p>
    <form id="hostelPeakOccupancyFilters" class="row g-2 mb-2">
        <div class="col-md-2"><label for="hostelPeakOccupancyFrom" class="form-label">From</label><input id="hostelPeakOccupancyFrom" type="date" class="form-control" required /></div>
        <div class="col-md-2"><label for="hostelPeakOccupancyTo" class="form-label">To (inclusive)</label><input id="hostelPeakOccupancyTo" type="date" class="form-control" required /></div>
        <div class="col-md-2"><label for="hostelPeakOccupancyCampus" class="form-label">Campus</label><select id="hostelPeakOccupancyCampus" class="form-select"><option value="">All permitted campuses</option></select></div>
        <div class="col-md-3"><label for="hostelPeakOccupancySearch" class="form-label">Campus, hostel or room</label><input id="hostelPeakOccupancySearch" class="form-control" maxlength="100" type="search" /></div>
        <div class="col-md-2 d-flex align-items-center"><div class="form-check"><input id="hostelPeakOccupancyAttention" class="form-check-input" type="checkbox" checked /><label for="hostelPeakOccupancyAttention" class="form-check-label">Needs attention</label></div></div>
        <div class="col-md-1 d-flex align-items-end"><button type="submit" class="btn btn-outline-primary w-100">Run</button></div>
    </form>
    <button id="hostelPeakOccupancyExport" class="btn btn-outline-success btn-sm mb-2" type="button" disabled>Export filtered CSV</button>
    <div id="hostelPeakOccupancyStatus" role="status" aria-live="polite" class="small text-muted mb-2"></div>
    <div class="table-responsive"><table class="table table-sm table-hover align-middle">
        <thead><tr><th>Campus</th><th>Hostel</th><th>Room</th><th>Capacity</th><th>Active beds</th><th>Peak reserved</th><th>Peak date</th><th>Minimum free</th><th>Max duplicates</th><th>Max inactive reserved</th><th>Attention days</th><th>Status</th></tr></thead>
        <tbody id="hostelPeakOccupancyRows"></tbody>
    </table></div>
    <div class="d-flex align-items-center justify-content-between gap-2">
        <button id="hostelPeakOccupancyPrev" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous</button>
        <span id="hostelPeakOccupancyPage" class="small text-muted"></span>
        <button id="hostelPeakOccupancyNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next</button>
    </div>
</div></section>
