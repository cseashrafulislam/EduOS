<section id="hostelBedRelocationPanel" class="card mb-3 d-none" aria-labelledby="hostelBedRelocationTitle">
    <div class="card-body">
        <h3 id="hostelBedRelocationTitle" class="h5">Move an unused physical bed</h3>
        <p id="hostelBedRelocationContext" class="small text-muted"></p>
        <p class="small text-muted">Only a bed that has never had any student allocation can move. Destination must be an active room in the same hostel, with spare physical capacity and no duplicate bed number. This does not move students or change billing.</p>
        <form id="hostelBedRelocationSearchForm" class="row g-2 mb-2">
            <div class="col-md-8"><label for="hostelBedRelocationSearch" class="form-label">Search destination room</label>
                <input id="hostelBedRelocationSearch" class="form-control" maxlength="100" placeholder="Room number" /></div>
            <div class="col-md-4 d-flex align-items-end gap-2"><button type="submit" class="btn btn-outline-primary">Search</button>
                <button id="hostelBedRelocationMore" type="button" class="btn btn-outline-secondary">More rooms</button></div>
        </form>
        <label for="hostelBedRelocationRoom" class="form-label">Available destination room</label>
        <select id="hostelBedRelocationRoom" class="form-select mb-2"><option value="">Select a room</option></select>
        <div id="hostelBedRelocationStatus" role="status" aria-live="polite" class="small text-muted mb-2"></div>
        <div class="d-flex gap-2">
            <button id="hostelBedRelocationSave" type="button" class="btn btn-primary btn-sm">Move unused bed</button>
            <button id="hostelBedRelocationCancel" type="button" class="btn btn-outline-secondary btn-sm">Cancel</button>
        </div>
    </div>
</section>
