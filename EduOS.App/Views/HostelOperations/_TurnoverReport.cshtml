<section class="card mb-3" id="hostelTurnoverPanel"><div class="card-body">
    <h3 class="h5">Hostel allocation turnover</h3>
    <p class="small text-muted">Monthly allocation starts and closures (not physical check-ins or check-outs). Uses permitted campuses only. Counts of 1–4 are suppressed for privacy. No student or payment details.</p>
    <form id="hostelTurnoverFilter" class="row g-2 align-items-end mb-2">
        <div class="col-md-3"><label for="hostelTurnoverFrom" class="form-label">From month</label><input id="hostelTurnoverFrom" type="month" class="form-control" required /></div>
        <div class="col-md-3"><label for="hostelTurnoverTo" class="form-label">To month</label><input id="hostelTurnoverTo" type="month" class="form-control" required /></div>
        <div class="col-md-6 d-flex gap-2"><button id="hostelTurnoverLoad" type="submit" class="btn btn-outline-primary">Show turnover</button>
            <button id="hostelTurnoverExport" type="button" class="btn btn-outline-secondary" disabled>Export CSV</button></div>
    </form>
    <div id="hostelTurnoverStatus" role="status" aria-live="polite" class="small text-muted"></div>
    <div class="table-responsive"><table class="table table-sm table-hover">
        <thead><tr><th scope="col">Month</th><th scope="col">Allocation starts</th><th scope="col">Allocation closures</th></tr></thead>
        <tbody id="hostelTurnoverRows"><tr><td colspan="3">Choose a month range.</td></tr></tbody>
    </table></div>
</div></section>
