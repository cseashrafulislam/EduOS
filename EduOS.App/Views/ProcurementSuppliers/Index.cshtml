@{
 ViewData["Title"]="Suppliers";
 var maker=User.IsInRole("TenantAdmin")||User.IsInRole("Principal")||User.IsInRole("InventoryManager")||User.IsInRole("StoreKeeper");
 var checker=User.IsInRole("TenantAdmin")||User.IsInRole("Principal")||User.IsInRole("InventoryManager");
}
<section class="container-fluid py-3" id="supplierWorkspace" data-maker="@maker.ToString().ToLowerInvariant()" data-checker="@checker.ToString().ToLowerInvariant()" data-user-id="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)">
<header class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-3"><div class="d-flex align-items-center gap-2"><h1 class="h4 mb-0" data-i18n="title">Suppliers</h1><button type="button" id="spHelp" class="btn btn-outline-secondary btn-sm" aria-expanded="false" aria-controls="spHelpText" aria-label="Page help">ⓘ</button></div>
<div class="d-flex gap-2"><a asp-controller="ProcurementRequisitions" asp-action="Index" class="btn btn-outline-secondary btn-sm" data-i18n="requisitions">Requisitions</a><button id="spExport" type="button" class="btn btn-outline-secondary btn-sm" data-i18n="export">CSV</button>@if(maker){<button id="spNew" type="button" class="btn btn-primary btn-sm" data-i18n="new">New supplier</button>}</div></header>
<div id="spHelpText" class="alert alert-light border d-none" role="note" data-i18n="help">Submit supplier details for independent approval.</div><div id="spAlert" class="d-none" role="status" aria-live="polite"></div>
<form id="spFilters" class="row g-2 mb-3"><div class="col-12 col-md-3"><label for="spCampus" class="form-label" data-i18n="campus">Campus ID</label><input id="spCampus" type="number" min="1" class="form-control"/></div><div class="col-6 col-md-3"><label for="spState" class="form-label" data-i18n="status">Status</label><select id="spState" class="form-select"><option value="" data-i18n="all">All</option><option>Draft</option><option>Submitted</option><option>Approved</option><option>Rejected</option><option>Inactive</option></select></div><div class="col-6 col-md-4"><label for="spSearch" class="form-label" data-i18n="search">Search</label><input id="spSearch" class="form-control" maxlength="100"/></div><div class="col-12 col-md-2 d-flex align-items-end"><button type="submit" class="btn btn-outline-primary w-100" data-i18n="filter">Filter</button></div></form>
<div class="table-responsive"><table class="table table-striped table-hover"><thead><tr><th data-i18n="code">Code</th><th data-i18n="name">Name</th><th data-i18n="campus">Campus</th><th data-i18n="status">Status</th><th data-i18n="actions">Actions</th></tr></thead><tbody id="spRows"></tbody></table></div><div class="d-flex gap-2 align-items-center"><button id="spPrev" type="button" class="btn btn-outline-secondary btn-sm" data-i18n="previous">Previous</button><span id="spPage" aria-live="polite"></span><button id="spNext" type="button" class="btn btn-outline-secondary btn-sm" data-i18n="next">Next</button></div>
<dialog id="spDialog" class="border rounded shadow p-0" style="width:min(94vw,720px);max-height:90vh"><form id="spForm" class="p-3"><div class="d-flex justify-content-between mb-3"><h2 class="h5" data-i18n="details">Supplier details</h2><button type="button" id="spClose" class="btn-close" aria-label="Close"></button></div><input id="spId" type="hidden"/><input id="spVersion" type="hidden"/><input id="spRequestId" type="hidden"/><div class="row g-2">
<div class="col-md-4"><label for="spFormCampus" class="form-label" data-i18n="campus">Campus ID</label><input id="spFormCampus" type="number" min="1" class="form-control" required/></div><div class="col-md-4"><label for="spCode" class="form-label" data-i18n="code">Code</label><input id="spCode" class="form-control" maxlength="40" minlength="2" pattern="[A-Za-z0-9][A-Za-z0-9_-]{1,39}" required/></div><div class="col-md-4"><label for="spName" class="form-label" data-i18n="name">Name</label><input id="spName" class="form-control" maxlength="200" minlength="3" required/></div>
<div class="col-md-6"><label for="spEmail" class="form-label" data-i18n="email">Email</label><input id="spEmail" type="email" maxlength="200" class="form-control"/></div><div class="col-md-6"><label for="spPhone" class="form-label" data-i18n="phone">Phone</label><input id="spPhone" maxlength="40" class="form-control"/></div><div class="col-12"><label for="spTax" class="form-label" data-i18n="tax">Tax registration</label><input id="spTax" maxlength="100" class="form-control"/></div></div><div class="d-flex justify-content-end gap-2 mt-3"><button type="button" id="spDismiss" class="btn btn-outline-secondary" data-i18n="close">Close</button><button type="submit" id="spSave" class="btn btn-primary" data-i18n="save">Save</button></div></form></dialog>
<dialog id="spDecisionDialog" class="border rounded shadow p-3" style="width:min(92vw,440px)"><form id="spDecisionForm"><h2 class="h5" data-i18n="decision">Decision</h2><label for="spReason" class="form-label" data-i18n="reason">Reason</label><textarea id="spReason" maxlength="500" rows="3" class="form-control"></textarea><div class="d-flex justify-content-end gap-2 mt-3"><button type="button" id="spDecisionClose" class="btn btn-outline-secondary" data-i18n="close">Close</button><button type="submit" id="spDecisionConfirm" class="btn btn-primary" data-i18n="confirm">Confirm</button></div></form></dialog></section>
@section Scripts {<script src="~/js/procurement/suppliers.js" asp-append-version="true"></script>}
