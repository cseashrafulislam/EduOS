@{
    var bn = System.Globalization.CultureInfo.CurrentUICulture.Name == "bn-BD";
    ViewData["Title"] = bn ? "নম্বর সিরিজ" : "Number Series";
}
<div class="container-fluid py-3">
    <h2>@(bn ? "নম্বর সিরিজ" : "Number Series")</h2>
    <div id="nsNotice" class="alert d-none" role="alert"></div>
    <div class="card mb-3"><div class="card-body">
        <form id="nsForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="nsId" /><input type="hidden" id="nsVersion" />
            <div class="row g-2">
                <div class="col-md-3"><label for="nsKey" class="form-label">@(bn ? "সিরিজের কী" : "Series key")</label><input id="nsKey" class="form-control" maxlength="100" required /></div>
                <div class="col-md-3"><label for="nsPrefix" class="form-label">@(bn ? "উপসর্গ" : "Prefix")</label><input id="nsPrefix" class="form-control" maxlength="50" /></div>
                <div class="col-md-2"><label for="nsPadding" class="form-label">@(bn ? "সংখ্যার দৈর্ঘ্য" : "Padding")</label><input id="nsPadding" class="form-control" type="number" min="1" max="30" value="6" required /></div>
                <div class="col-md-2"><label for="nsSuffix" class="form-label">@(bn ? "প্রত্যয়" : "Suffix")</label><input id="nsSuffix" class="form-control" maxlength="50" /></div>
                <div class="col-md-2"><label for="nsActive" class="form-label">@(bn ? "অবস্থা" : "Status")</label><select id="nsActive" class="form-select"><option value="true">@(bn ? "সক্রিয়" : "Active")</option><option value="false">@(bn ? "নিষ্ক্রিয়" : "Inactive")</option></select></div>
            </div>
            <div class="mt-3 d-flex gap-2 flex-wrap"><button class="btn btn-primary" type="submit">@(bn ? "সিরিজ সংরক্ষণ" : "Save series")</button> <button id="nsReset" class="btn btn-outline-secondary" type="button">@(bn ? "ফর্ম পরিষ্কার" : "Reset")</button></div>
        </form>
    </div></div>
    <div class="card"><div class="card-body">
        <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
            <h3 class="h5 mb-0">@(bn ? "সংরক্ষিত সিরিজ" : "Configured series")</h3>
            <input id="nsSearch" class="form-control" style="max-width:280px" placeholder="@(bn ? "কী দিয়ে খুঁজুন" : "Search key")" aria-label="@(bn ? "সিরিজ খুঁজুন" : "Search series")" />
        </div>
        <div class="table-responsive"><table class="table table-striped table-sm">
            <thead><tr><th>@(bn ? "কী" : "Key")</th><th>@(bn ? "ফরম্যাট" : "Format")</th><th>@(bn ? "পরবর্তী নম্বর" : "Next value")</th><th>@(bn ? "অবস্থা" : "Status")</th><th>@(bn ? "কাজ" : "Action")</th></tr></thead>
            <tbody id="nsRows"></tbody></table></div>
        <div class="d-flex gap-2 align-items-center">
            <button id="nsPrev" type="button" class="btn btn-outline-secondary btn-sm">@(bn ? "আগে" : "Previous")</button>
            <span id="nsPage"></span>
            <button id="nsNext" type="button" class="btn btn-outline-secondary btn-sm">@(bn ? "পরে" : "Next")</button>
        </div>
    </div></div>
</div>
@section Scripts { <script src="~/js/number-series/index.js" asp-append-version="true"></script> }
