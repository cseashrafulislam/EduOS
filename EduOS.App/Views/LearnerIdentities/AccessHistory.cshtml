@{
    ViewData["Title"] = "Learner Identity Access History";
}
<section class="container-fluid py-3" aria-labelledby="identityHistoryTitle">
    <header class="d-flex flex-wrap justify-content-between gap-2 align-items-start mb-3">
        <div>
            <h2 id="identityHistoryTitle">Learner Identity Access History</h2>
            <p class="text-muted mb-0">Read-only, institution-scoped identity registrations, consent decisions and grant revocations. Dates are UTC.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-controller="LearnerIdentities" asp-action="Index">Identity registration</a>
    </header>
    <div id="identityHistoryAlert" class="d-none" role="alert" tabindex="-1"></div>
    <section class="card mb-3" aria-labelledby="identityHistoryFiltersTitle">
        <div class="card-body">
            <h3 id="identityHistoryFiltersTitle" class="h6">Filter access records</h3>
            <form id="identityHistoryFilters" class="row g-2 align-items-end">
                <div class="col-sm-6 col-xl-2"><label for="identityHistoryFrom" class="form-label">From (UTC)</label><input id="identityHistoryFrom" type="date" class="form-control" /></div>
                <div class="col-sm-6 col-xl-2"><label for="identityHistoryTo" class="form-label">To (UTC)</label><input id="identityHistoryTo" type="date" class="form-control" /></div>
                <div class="col-sm-6 col-xl-3"><label for="identityHistoryStudent" class="form-label">Student reference (optional)</label><input id="identityHistoryStudent" class="form-control" maxlength="36" autocomplete="off" placeholder="Student UUID" /></div>
                <div class="col-sm-6 col-xl-2"><label for="identityHistoryUser" class="form-label">Actor user ID</label><input id="identityHistoryUser" type="number" min="1" step="1" class="form-control" /></div>
                <div class="col-sm-6 col-xl-2"><label for="identityHistoryAction" class="form-label">Action</label>
                    <select id="identityHistoryAction" class="form-select"><option value="">All actions</option><option value="RegisterOrLink">Register/link</option><option value="RequestConsent">Consent requested</option><option value="ResolveConsent">Consent decision</option><option value="RevokeDataGrant">Grant revoked</option></select></div>
                <div class="col-sm-6 col-xl-1"><label for="identityHistoryOutcome" class="form-label">Outcome</label><input id="identityHistoryOutcome" class="form-control" maxlength="100" placeholder="Any" /></div>
                <div class="col-12 d-flex flex-wrap gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">Apply filters</button>
                    <button type="button" id="identityHistoryReset" class="btn btn-outline-secondary">Reset</button>
                </div>
            </form>
        </div>
    </section>
    <section class="card" aria-labelledby="identityHistoryResultsTitle">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between gap-2 mb-2"><h3 id="identityHistoryResultsTitle" class="h6 mb-0">Audit events</h3><span id="identityHistoryCount" class="small text-muted" aria-live="polite"></span></div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead><tr><th scope="col">UTC time</th><th scope="col">Student</th><th scope="col">Person</th><th scope="col">User</th><th scope="col">Action</th><th scope="col">Outcome</th><th scope="col">Reason</th><th scope="col">Purpose</th><th scope="col">IP address</th></tr></thead>
                    <tbody id="identityHistoryRows"><tr><td colspan="9" class="text-center text-muted">Loading…</td></tr></tbody>
                </table>
            </div>
            <nav class="d-flex flex-wrap align-items-center justify-content-between gap-2" aria-label="Learner identity audit pages">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="identityHistoryPrevious" disabled>Previous</button>
                <span id="identityHistoryPage" class="small text-muted" aria-live="polite"></span>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="identityHistoryNext" disabled>Next</button>
            </nav>
        </div>
    </section>
</section>
@section Scripts {
    <script src="~/js/learners/identity-access-history.js" asp-append-version="true"></script>
}
