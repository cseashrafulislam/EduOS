                        (Action: "Reports", En: "Stock Reports", Bn: "স্টক প্রতিবেদন")
                    })
                    {
                        if ((inventoryTask.Action == "Transactions" || inventoryTask.Action == "Adjustments") && User?.IsInRole("Accountant") == true &&
                            User?.IsInRole("TenantAdmin") != true && User?.IsInRole("Principal") != true &&
                            User?.IsInRole("InventoryManager") != true && User?.IsInRole("StoreKeeper") != true) continue;
                        var inventoryPath = "/InventoryMovements/" + inventoryTask.Action;
                        <a class="nav-link @ActiveFor(inventoryPath)" href="@inventoryPath">
                            <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                            <span>@(currentCulture == "bn-BD" ? inventoryTask.Bn : inventoryTask.En)</span>
                        </a>
                    }
                    <a class="nav-link @ActiveFor("/AssetLifecycle")" href="/AssetLifecycle/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>@(currentCulture == "bn-BD" ? "স্থায়ী সম্পদ ও রক্ষণাবেক্ষণ" : "Fixed Assets & Maintenance")</span>
                    </a>
                }
                @if (showFacilities && (User?.IsInRole("TenantAdmin") == true || User?.IsInRole("Principal") == true ||
                     User?.IsInRole("FacilitiesManager") == true || User?.IsInRole("FacilitiesApprover") == true ||
                     User?.IsInRole("FacilitiesTechnician") == true || User?.IsInRole("FacilitiesRequester") == true))
                {
                    <a class="nav-link @ActiveFor("/FacilityWorkOrders")" href="/FacilityWorkOrders/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#campus" /></svg>
                        <span>@(currentCulture.StartsWith("bn", StringComparison.OrdinalIgnoreCase) ? "ক্যাম্পাস সার্ভিস ও ওয়ার্ক অর্ডার" : "Campus Service & Work Orders")</span>
                    </a>
                    <a class="nav-link @ActiveFor("/FacilitySpaces")" href="/FacilitySpaces/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#campus" /></svg>
                        <span>@(currentCulture.StartsWith("bn", StringComparison.OrdinalIgnoreCase) ? "ক্যাম্পাস সুবিধা স্থান" : "Facility Spaces")</span>
                    </a>
                }
                @if (showHostel)
                {
                @if (User?.IsInRole("TenantAdmin") == true || User?.IsInRole("Principal") == true || User?.IsInRole("HostelWarden") == true)
                {
                    @foreach (var hostelTask in new[] {
                        (Action: "Applications", En: "Hostel Applications", Bn: "আবাসিক আবেদন"),
                        (Action: "Setup", En: "Rooms & Beds Setup", Bn: "কক্ষ ও শয্যা সেটআপ"),
                        (Action: "Allocations", En: "Bed Allocations", Bn: "শয্যা বরাদ্দ"),
                        (Action: "Reports", En: "Hostel Reports", Bn: "হোস্টেল প্রতিবেদন")
                    })
                    {
                        var hostelPath = "/HostelOperations/" + hostelTask.Action;
                        <a class="nav-link @ActiveFor(hostelPath)" href="@hostelPath">
                            <svg class="edu-icon"><use href="/images/eduos-icons.svg#campus" /></svg>
                            <span>@(currentCulture == "bn-BD" ? hostelTask.Bn : hostelTask.En)</span>
                        </a>
                    }
                }
                else
                {
                <a class="nav-link @ActiveFor("/HostelOperations")" href="/HostelOperations/Index">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#campus" /></svg>
                    <span>@T["V2Hostel"]</span>
                </a>
                }
                @foreach (var link in v2RoleLinks.Where(x => x.ModuleCode == "HOSTEL"))
                {
                    <a class="nav-link @ActiveFor(link.Path)" href="@link.Path">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#campus" /></svg>
                        <span>@T[link.LabelKey]</span>
                    </a>
                }
                }
                @if (showTransport)
                {
                @if (User?.IsInRole("TenantAdmin") == true || User?.IsInRole("Principal") == true || User?.IsInRole("TransportManager") == true)
                {
                    @foreach (var transportTask in new[] {
                        (Action: "Setup", En: "Routes & Fleet Setup", Bn: "রুট ও গাড়ি সেটআপ"),
                        (Action: "Assignments", En: "Transport Assignments", Bn: "পরিবহন বরাদ্দ"),
                        (Action: "Reports", En: "Transport Reports", Bn: "পরিবহন প্রতিবেদন")
                    })
                    {
                        var transportPath = "/TransportOperations/" + transportTask.Action;
                        <a class="nav-link @ActiveFor(transportPath)" href="@transportPath">
                            <svg class="edu-icon"><use href="/images/eduos-icons.svg#campus" /></svg>
                            <span>@(currentCulture == "bn-BD" ? transportTask.Bn : transportTask.En)</span>
                        </a>
                    }
                }
                else
                {
                <a class="nav-link @ActiveFor("/TransportOperations")" href="/TransportOperations/Index">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#campus" /></svg>
                    <span>@T["V2Transport"]</span>
                </a>
                }
                @foreach (var link in v2RoleLinks.Where(x => x.ModuleCode == "TRANSPORT"))
                {
                    <a class="nav-link @ActiveFor(link.Path)" href="@link.Path">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#campus" /></svg>
                        <span>@T[link.LabelKey]</span>
                    </a>
                }
                }
                @if (User?.IsInRole("TenantAdmin") == true || User?.IsInRole("Principal") == true)
                {
                    @if (showHostel || showTransport)
                    {
                    <a class="nav-link @ActiveFor("/OperationsInsights")" href="/OperationsInsights/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>@T["V2OperationsInsights"]</span>
                    </a>
                    }
                    <a class="nav-link @ActiveFor("/AuditLogs")" href="/AuditLogs/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#shield" /></svg>
                        <span>@(currentCulture == "bn-BD" ? "নিরীক্ষার লগ" : "Audit Logs")</span>
                    </a>
                    <a class="nav-link @ActiveFor("/ImportHistory")" href="/ImportHistory/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>@(currentCulture == "bn-BD" ? "আমদানির ইতিহাস" : "Import History")</span>
                    </a>
                }
                <a class="nav-link @ActiveFor("/CommunicationWorkspace")" href="/CommunicationWorkspace/Index">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                    <span>@(currentCulture == "bn-BD" ? "নোটিশ ও বিজ্ঞপ্তি" : "Notices & Notifications")</span>
                </a>
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/CommunicationAdministration")" href="/CommunicationAdministration/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>@(currentCulture == "bn-BD" ? "যোগাযোগ ব্যবস্থাপনা" : "Communication Administration")</span>
                    </a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/CustomFields")" href="/CustomFields/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>@(currentCulture == "bn-BD" ? "প্রতিষ্ঠানের কাস্টম ফিল্ড" : "Institution Custom Fields")</span>
                    </a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/DocumentAdministration")" href="/DocumentAdministration/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>@(currentCulture == "bn-BD" ? "নথি ব্যবস্থাপনা" : "Document Administration")</span>
                    </a>
                }
                @if (showLibrary)
                {
                    <a class="nav-link @ActiveFor("/Library/Index")" href="/Library/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#book" /></svg>
                        <span>@T["V2Library"]</span>
                    </a>
                    @foreach (var libraryTask in new[] {
                        (Action: "Reservations", En: "Reservations", Bn: "বই সংরক্ষণ"),
                        (Action: "Branches", En: "Library Branches", Bn: "গ্রন্থাগার শাখা"),
                        (Action: "Overdue", En: "Overdue & Notices", Bn: "বিলম্ব ও নোটিশ"),
                        (Action: "Conditions", En: "Book Conditions", Bn: "বইয়ের অবস্থা"),
                        (Action: "Integrity", En: "Copy Integrity", Bn: "বইয়ের কপি যাচাই"),
                        (Action: "Liabilities", En: "Library Liabilities", Bn: "গ্রন্থাগারের দায়")
                    })
                    {
                        var allowed = libraryTask.Action switch {
                            "Branches" or "Liabilities" => User?.IsInRole("TenantAdmin") == true,
                            "Overdue" or "Conditions" or "Integrity" => User?.IsInRole("TenantAdmin") == true || User?.IsInRole("Principal") == true || User?.IsInRole("Librarian") == true,
                            _ => true
                        };
                        if (!allowed) continue;
                        var libraryPath = "/Library/" + libraryTask.Action;
                        <a class="nav-link @ActiveFor(libraryPath)" href="@libraryPath">
                            <svg class="edu-icon"><use href="/images/eduos-icons.svg#book" /></svg>
                            <span>@(currentCulture == "bn-BD" ? libraryTask.Bn : libraryTask.En)</span>
                        </a>
                    }
                    @foreach (var link in v2RoleLinks.Where(x => x.ModuleCode == "LIBRARY"))
                    {
                        <a class="nav-link @ActiveFor(link.Path)" href="@link.Path">
                            <svg class="edu-icon"><use href="/images/eduos-icons.svg#book" /></svg>
                            <span>@T[link.LabelKey]</span>
                        </a>
                    }
                }
                @if (User?.IsInRole("Teacher") == true || User?.IsInRole("Staff") == true)
                {
                    <a class="nav-link @ActiveFor("/EmployeePortal")" href="/EmployeePortal/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#users" /></svg>
                        <span>@(currentCulture == "bn-BD" ? "কর্মীর স্বসেবা" : "Employee self-service")</span>
                    </a>
                }




            </nav>
            }
        </aside>

        <button class="sidebar-backdrop" type="button" data-sidebar-close aria-label="@T["CloseMenu"]" tabindex="-1"></button>

        <div class="main-area">
            <header class="topbar">
                <div class="topbar-left">
                    <button class="icon-button mobile-toggle" id="btnSidebarToggle" type="button"
                            aria-controls="sidebarMenu" aria-expanded="false" aria-label="@T["OpenMenu"]">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#menu" /></svg>
                    </button>
                    <div class="page-heading">
                        <h1>@pageTitle</h1>
                        <p>@T["ManageInstitution"]</p>
                    </div>
                </div>

                <div class="topbar-right">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <button class="feature-search-trigger" id="featureSearchOpen" type="button"
                                aria-haspopup="dialog" aria-controls="featureSearchDialog"
                                aria-label="@(currentCulture == "bn-BD" ? "অনুমোদিত ফিচার খুঁজুন" : "Find an available feature")">
                            <span aria-hidden="true">⌕</span>
                            <span class="feature-search-trigger-label">@(currentCulture == "bn-BD" ? "ফিচার খুঁজুন" : "Find feature")</span>
                            <kbd>Ctrl K</kbd>
                        </button>
                    }
                    <button class="icon-button page-help-trigger" id="pageContextHelp" type="button"
                            aria-haspopup="dialog" aria-controls="pageHelpDrawer"
                            aria-label="@(currentCulture == "bn-BD" ? "এই পৃষ্ঠার সম্পূর্ণ নির্দেশিকা" : "Full user manual for this page")"
                            title="@(currentCulture == "bn-BD" ? "পৃষ্ঠার নির্দেশিকা" : "Page user manual")">ⓘ</button>
                    <button class="install-button" type="button" data-install-app hidden>
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#download" /></svg>
                        <span>@T["InstallApp"]</span>
                    </button>

                    <form asp-controller="Localization" asp-action="SetLanguage" method="post" class="language-form">
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <label class="visually-hidden" for="uiCulture">@T["Language"]</label>
                        <svg class="edu-icon language-icon" aria-hidden="true"><use href="/images/eduos-icons.svg#globe" /></svg>
                        <select id="uiCulture" name="culture" data-language-selector aria-label="@T["Language"]">
                            <option value="en-BD" selected="@(currentCulture == "en-BD" ? "selected" : null)">@T["English"]</option>
                            <option value="bn-BD" selected="@(currentCulture == "bn-BD" ? "selected" : null)">@T["Bangla"]</option>
                        </select>
                    </form>

                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <button class="user-box" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@T["AccountMenu"]">
                                <span class="user-avatar" aria-hidden="true">@userInitial</span>
                                <span class="user-info">
                                    <span class="name">@userName</span>
                                    <span class="role">@(User?.IsInRole("SuperAdmin") == true ? "SuperAdmin" : T["TenantAdmin"].Value)</span>
                                </span>
                                <svg class="edu-icon user-chevron" aria-hidden="true"><use href="/images/eduos-icons.svg#chevron-down" /></svg>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 p-2">
                                <li><a class="dropdown-item rounded-3" data-feature-discovery-link data-feature-discovery-section="@(currentCulture == "bn-BD" ? "অ্যাকাউন্ট" : "Account")" href="/Account/Profile">@T["Profile"]</a></li>
                                @if (User?.IsInRole("SuperAdmin") != true)
                                {
                                    <li><a class="dropdown-item rounded-3" data-feature-discovery-link data-feature-discovery-section="@(currentCulture == "bn-BD" ? "সেটিংস" : "Settings")" href="/workspace">@(currentCulture == "bn-BD" ? "ওয়ার্কস্পেস ডিজাইন" : "Workspace Appearance")</a></li>
                                     <li><button type="button" class="dropdown-item rounded-3" data-bs-toggle="modal" data-bs-target="#institutionSwitchModal">@(currentCulture == "bn-BD" ? "প্রতিষ্ঠান পরিবর্তন" : "Switch institution")</button></li>
                                }
                                <li><a class="dropdown-item rounded-3" href="/LoginActivity/Index">Sign-in activity</a></li>
                                <li><a class="dropdown-item rounded-3" href="/LegalDocuments/My">My Legal Agreements</a></li>
                                <li><a class="dropdown-item rounded-3" href="/Account/Profile#passwordForm">@T["ChangePassword"]</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit" class="dropdown-item rounded-3 text-danger">@T["Logout"]</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-primary topbar-login" href="/Account/Login">@T["Login"]</a>
                    }
                </div>
            </header>

            @if (User?.Identity?.IsAuthenticated == true)
            {
                <dialog class="feature-search-dialog" id="featureSearchDialog" aria-labelledby="featureSearchTitle">
                    <div class="feature-search-heading">
                        <h2 id="featureSearchTitle">@(currentCulture == "bn-BD" ? "ফিচার খুঁজুন" : "Find a feature")</h2>
                        <button type="button" class="feature-search-close" id="featureSearchClose"
                                aria-label="@(currentCulture == "bn-BD" ? "বন্ধ করুন" : "Close")">×</button>
                    </div>
                    <label class="visually-hidden" for="featureSearchInput">@(currentCulture == "bn-BD" ? "ফিচারের নাম" : "Feature name")</label>
                    <input class="form-control" type="search" id="featureSearchInput" maxlength="80"
                           autocomplete="off" placeholder="@(currentCulture == "bn-BD" ? "নাম বা বিভাগ লিখুন" : "Search by feature or group")" />
                    <div class="feature-search-results" id="featureSearchResults" aria-live="polite"></div>
                </dialog>
            }

            <dialog class="page-help-drawer" id="pageHelpDrawer" aria-labelledby="pageHelpTitle" aria-modal="true" lang="@currentCulture">
                <div class="page-help-heading">
                    <h2 id="pageHelpTitle">@(currentCulture == "bn-BD" ? "পৃষ্ঠার নির্দেশিকা" : "Page user manual")</h2>
                    <button type="button" id="pageHelpClose" class="icon-button"
                            aria-label="@(currentCulture == "bn-BD" ? "নির্দেশিকা বন্ধ করুন" : "Close user manual")">×</button>
                </div>
                <div id="pageHelpContent" class="page-help-content"></div>
            </dialog>

            <div class="connectivity-notice" data-connectivity-notice hidden role="status" aria-live="polite">
                @(currentCulture == "bn-BD"
                    ? "ইন্টারনেট সংযোগ পাওয়া যাচ্ছে না। সংযোগ ফিরে এলে আবার চেষ্টা করুন; অফলাইনে তথ্য সংরক্ষণ করা হবে না।"
                    : "You appear to be offline. Reconnect before saving; changes are not queued offline.")
            </div>
            <main class="page-body" id="main-content" tabindex="-1">
                @RenderBody()
            </main>

            <footer class="footer-bar">
                <span>© @DateTime.Now.Year EduOS</span>
                <span aria-hidden="true">•</span>
                <span>@T["Footer"]</span>
            </footer>
        </div>
    </div>


    @if (User?.Identity?.IsAuthenticated == true && User?.IsInRole("SuperAdmin") != true)
    {
        <div class="modal fade" id="institutionSwitchModal" tabindex="-1" aria-labelledby="institutionSwitchTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-6" id="institutionSwitchTitle">@(currentCulture == "bn-BD" ? "প্রতিষ্ঠান পরিবর্তন" : "Switch institution")</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["CloseMenu"]"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label" for="institutionSwitchSelect">@(currentCulture == "bn-BD" ? "প্রতিষ্ঠান" : "Institution")</label>
                        <select class="form-select" id="institutionSwitchSelect" disabled></select>
                        <div id="institutionSwitchStatus" class="small mt-2" role="status" aria-live="polite"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@(currentCulture == "bn-BD" ? "বাতিল" : "Cancel")</button>
                        <button type="button" class="btn btn-primary" id="institutionSwitchSubmit" disabled>@(currentCulture == "bn-BD" ? "পরিবর্তন করুন" : "Switch")</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(sessionReference))
    {
        <section class="auth-session-shield" id="eduosSessionShield" role="alertdialog" aria-modal="true" aria-labelledby="eduosSessionShieldTitle" hidden>
            <div class="auth-session-shield-card">
                <h2 id="eduosSessionShieldTitle" class="fs-5">@(currentCulture == "bn-BD" ? "সেশন যাচাই" : "Verifying session")</h2>
                <p id="eduosSessionShieldMessage" role="status" aria-live="polite">@(currentCulture == "bn-BD" ? "আপনার অ্যাকাউন্টের নিরাপত্তা যাচাই হচ্ছে…" : "Checking your account session…")</p>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-primary" id="eduosSessionRetry">@(currentCulture == "bn-BD" ? "আবার চেষ্টা করুন" : "Retry")</button>
                    <a class="btn btn-outline-secondary" href="/Account/Login">@(currentCulture == "bn-BD" ? "সাইন ইন" : "Sign in")</a>
                </div>
            </div>
        </section>
    }
    <div class="visually-hidden" aria-live="polite" data-app-status></div>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/sidebar-navigation.js" asp-append-version="true"></script>
    <script src="~/js/platform/session-context-guard.js" asp-append-version="true"></script>
    <script src="~/js/platform/feature-discovery.js" asp-append-version="true"></script>
    <script src="~/js/platform/institution-switch.js" asp-append-version="true"></script>
    <script src="~/js/platform/page-context-help.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
