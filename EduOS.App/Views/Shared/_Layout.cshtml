@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var titleKey = ViewData["Title"]?.ToString() ?? "Dashboard";
    var localizedTitle = T[titleKey];
    var pageTitle = localizedTitle.ResourceNotFound ? titleKey : localizedTitle.Value;
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var userName = User?.Identity?.Name;
    var userInitial = string.IsNullOrWhiteSpace(userName)
        ? "U"
        : userName[..1].ToUpper(CultureInfo.CurrentCulture);
    var currentPath = Context.Request.Path.Value ?? string.Empty;
    string ActiveFor(string routePrefix) =>
        currentPath.StartsWith(routePrefix, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    var requestVerificationToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="color-scheme" content="light" />
    <meta name="application-name" content="EduOS" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="EduOS" />
    <meta name="description" content="@T["EducationOperatingSystem"]" />
    <meta name="request-verification-token" content="@requestVerificationToken" />
    <title>@pageTitle - EduOS</title>

    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" href="~/images/eduos-icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">@T["SkipToContent"]</a>

    <div class="app-shell">
        <aside class="sidebar" id="sidebarMenu" aria-label="@T["MainNavigation"]">
            <div class="brand-box">
                <a class="brand-link" href="@(User?.IsInRole("SuperAdmin") == true ? "/Dashboard/Admin" : "/Dashboard/Index")" aria-label="EduOS @T["Dashboard"]">
                    <span class="brand-logo" aria-hidden="true">
                        <svg class="edu-icon edu-icon-lg"><use href="/images/eduos-icons.svg#graduation" /></svg>
                    </span>
                    <span>
                        <span class="brand-title">EduOS</span>
                        <span class="brand-subtitle">@T["EducationERP"]</span>
                    </span>
                </a>
                <button class="icon-button sidebar-close" type="button" data-sidebar-close aria-label="@T["CloseMenu"]">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#close" /></svg>
                </button>
            </div>

            @if (User?.IsInRole("SuperAdmin") == true)
            {
                <div class="menu-title">Platform Administration</div>
                <nav class="nav flex-column">
                    <a class="nav-link @ActiveFor("/Dashboard/Admin")" href="/Dashboard/Admin">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#dashboard" /></svg>
                        <span>@T["Dashboard"]</span>
                    </a>
                    <a class="nav-link @ActiveFor("/PlatformTenants")" href="/PlatformTenants/Index"><span>Institution Lifecycle</span></a>
                    <a class="nav-link @ActiveFor("/PlatformCatalogAdministration")" href="/PlatformCatalogAdministration/Index"><span>Institution Type Availability</span></a>
                    <a class="nav-link @ActiveFor("/SubscriptionPlanAdministration")" href="/SubscriptionPlanAdministration/Index"><span>Subscription Plan Availability</span></a>
                    <a class="nav-link @ActiveFor("/LegalDocuments/Index")" href="/LegalDocuments/Index"><span>Legal Publications</span></a>
                    <a class="nav-link @ActiveFor("/Account/PaymentVerification")" href="/Account/PaymentVerification">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>@T["ManualPaymentVerification"]</span>
                    </a>
                </nav>
            }
            else
            {
            <div class="menu-title">@T["Main"]</div>
            <nav class="nav flex-column">
                <a class="nav-link @ActiveFor("/Dashboard")" href="/Dashboard/Index">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#dashboard" /></svg>
                    <span>@T["Dashboard"]</span>
                </a>
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/TenantUsers")" href="/TenantUsers/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#users" /></svg>
                        <span>User &amp; Role Management</span>
                    </a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/InstitutionManagement")" href="/InstitutionManagement/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#institution" /></svg>
                        <span>Institution &amp; Campuses</span>
                    </a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/TenantDomains")" href="/TenantDomains/Index"><span>Custom Domains</span></a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/TenantTerminology")" href="/TenantTerminology/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>Institution Terminology</span>
                    </a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/TenantSettings")" href="/TenantSettings/Index"><span>Institution Settings</span></a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/NumberSeries")" href="/NumberSeries/Index"><span>Number Series</span></a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/TenantModules")" href="/TenantModules/Index"><span>Institution Modules</span></a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/SubscriptionBilling")" href="/SubscriptionBilling/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>Subscription &amp; Billing</span>
                    </a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/IntegrationAdministration")" href="/IntegrationAdministration/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>Integration Administration</span>
                    </a>
                }
                <a class="nav-link @ActiveFor("/Account/InstitutionProfile")" href="/Account/InstitutionProfile">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#institution" /></svg>
                    <span>@T["InstitutionSetup"]</span>
                </a>
                <a class="nav-link @ActiveFor("/Account/CampusSetup")" href="/Account/CampusSetup">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#campus" /></svg>
                    <span>@T["Campus"]</span>
                </a>
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/StudentLifecycle")" href="/StudentLifecycle/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#students" /></svg>
                        <span>Student Transfer / Exit</span>
                    </a>
                    <a class="nav-link @ActiveFor("/StudentTransferRequests")" href="/StudentTransferRequests/Index#destinationInbox">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#students" /></svg>
                        <span>Transfer Requests / Inbox</span>
                    </a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/EnrollmentManagement")" href="/EnrollmentManagement/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#students" /></svg>
                        <span>Student Enrollment</span>
                    </a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/AcademicManagement")" href="/AcademicManagement/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#calendar" /></svg>
                        <span>Academic Setup &amp; Management</span>
                    </a>
                }
                <a class="nav-link @ActiveFor("/Account/AcademicSetup")" href="/Account/AcademicSetup">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#calendar" /></svg>
                    <span>@T["AcademicYear"]</span>
                </a>
                <a class="nav-link @ActiveFor("/Account/ModuleSetup")" href="/Account/ModuleSetup">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                    <span>@T["Modules"]</span>
                </a>
            </nav>

            <hr class="sidebar-divider" />
            <div class="menu-title">@T["Academics"]</div>
            <nav class="nav flex-column">
                @if (User?.IsInRole("Student") == true || User?.IsInRole("Guardian") == true || User?.IsInRole("Parent") == true)
                {
                    <a class="nav-link @ActiveFor("/StudentPortal")" href="/StudentPortal/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#students" /></svg>
                        <span>Student / Guardian Portal</span>
                    </a>
                }
                <a class="nav-link @ActiveFor("/Admissions")" href="/Admissions/Index">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#institution" /></svg>
                    <span>@T["AdmissionApplications"]</span>
                </a>
                <a class="nav-link @ActiveFor("/Students")" href="/Students/Index">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#students" /></svg>
                    <span>@T["Students"]</span>
                </a>


                @if (User?.IsInRole("TenantAdmin") == true || User?.IsInRole("Principal") == true ||
                     User?.IsInRole("Teacher") == true || User?.IsInRole("Student") == true)
                {
                    <a class="nav-link @ActiveFor("/Learning")" href="/Learning/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#book" /></svg>
                        <span>Learning Management</span>
                    </a>
                }
                <a class="nav-link @ActiveFor("/ExamOperations")" href="/ExamOperations/Index">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                    <span>Exam Marks &amp; Results</span>
                </a>
                @if (User?.IsInRole("TenantAdmin") == true || User?.IsInRole("Principal") == true ||
                     User?.IsInRole("VicePrincipal") == true || User?.IsInRole("ExamController") == true)
                {
                    <a class="nav-link @ActiveFor("/ExamOperations/Transcripts")" href="/ExamOperations/Transcripts">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>Transcript Issue Register</span>
                    </a>
                }
                <a class="nav-link @ActiveFor("/AcademicRoutines")" href="/AcademicRoutines/Index">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#calendar" /></svg>
                    <span>Class Routines</span>
                </a>
                <a class="nav-link @ActiveFor("/AcademicInstruction")" href="/AcademicInstruction/Index">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#book" /></svg>
                    <span>Lesson Plans &amp; Substitutions</span>
                </a>
                <a class="nav-link @ActiveFor("/AcademicCalendar")" href="/AcademicCalendar/Index">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#calendar" /></svg>
                    <span>Academic Calendar</span>
                </a>
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/StudentLeaves")" href="/StudentLeaves/Index">
                        <span>Student Leave Management</span>
                    </a>
                }
                <a class="nav-link @ActiveFor("/Attendance")" href="/Attendance/Index">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#attendance" /></svg>
                    <span>@T["Attendance"]</span>
                </a>

            </nav>

            <hr class="sidebar-divider" />
            <div class="menu-title">@T["Management"]</div>
            <nav class="nav flex-column">
                @if (User?.IsInRole("TenantAdmin") == true || User?.IsInRole("Principal") == true || User?.IsInRole("HR") == true)
                {
                    <a class="nav-link @ActiveFor("/HR")" href="/HR/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#users" /></svg>
                        <span>HR Administration</span>
                    </a>
                    <a class="nav-link @ActiveFor("/EmployeeAttendance")" href="/EmployeeAttendance/Index">Employee Attendance</a>
                    <a class="nav-link @ActiveFor("/LeaveEntitlements")" href="/LeaveEntitlements/Index">Leave Entitlements</a>
                }
                @if (User?.IsInRole("TenantAdmin") == true || User?.IsInRole("Principal") == true ||
                     User?.IsInRole("HR") == true || User?.IsInRole("Accountant") == true ||
                     User?.IsInRole("Staff") == true || User?.IsInRole("Teacher") == true)
                {
                    <a class="nav-link @ActiveFor("/PayrollOperations")" href="/PayrollOperations/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>Payroll</span>
                    </a>
                }
                @if (User?.IsInRole("TenantAdmin") == true || User?.IsInRole("Principal") == true ||
                     User?.IsInRole("Accountant") == true)
                {
                    <a class="nav-link @ActiveFor("/FeeOperations")" href="/FeeOperations/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>Fees &amp; Billing</span>
                    </a>
                    <a class="nav-link @ActiveFor("/FeeReceivablesAging")" href="/FeeReceivablesAging/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>Fee Receivables Aging</span>
                    </a>
                    @if (User?.IsInRole("TenantAdmin") == true)
                    {
                        <a class="nav-link @ActiveFor("/FinanceAdjustments")" href="/FinanceAdjustments/Index">Finance Adjustments</a>
                    }
                    <a class="nav-link @ActiveFor("/FeeHeadAccounting")" href="/FeeHeadAccounting/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>Fee Heads &amp; GL Mapping</span>
                    </a>
                    <a class="nav-link @ActiveFor("/AccountingSetup")" href="/AccountingSetup/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>Institution COA &amp; Periods</span>
                    </a>
                    <a class="nav-link @ActiveFor("/AccountingJournals")" href="/AccountingJournals/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>Journal Posting &amp; Reversal</span>
                    </a>
                    <a class="nav-link @ActiveFor("/AccountingReports")" href="/AccountingReports/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>General Ledger &amp; Trial Balance</span>
                    </a>
                }
                @if (User?.IsInRole("TenantAdmin") == true || User?.IsInRole("Principal") == true ||
                     User?.IsInRole("InventoryManager") == true || User?.IsInRole("StoreKeeper") == true ||
                     User?.IsInRole("Accountant") == true)
                {
                    <a class="nav-link @ActiveFor("/InventoryCatalog")" href="/InventoryCatalog/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>Inventory Catalog</span>
                    </a>
                    <a class="nav-link @ActiveFor("/InventoryMovements")" href="/InventoryMovements/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>Stock Movements</span>
                    </a>
                }
                <a class="nav-link @ActiveFor("/HostelOperations")" href="/HostelOperations/Index">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#campus" /></svg>
                    <span>Hostel</span>
                </a>
                <a class="nav-link @ActiveFor("/TransportOperations")" href="/TransportOperations/Index">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#campus" /></svg>
                    <span>Transport</span>
                </a>
                @if (User?.IsInRole("TenantAdmin") == true || User?.IsInRole("Principal") == true)
                {
                    <a class="nav-link @ActiveFor("/OperationsInsights")" href="/OperationsInsights/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>Operations Insights</span>
                    </a>
                    <a class="nav-link @ActiveFor("/AuditLogs")" href="/AuditLogs/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#shield" /></svg>
                        <span>Audit Logs</span>
                    </a>
                    <a class="nav-link @ActiveFor("/ImportHistory")" href="/ImportHistory/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>Import History</span>
                    </a>
                }
                <a class="nav-link @ActiveFor("/CommunicationWorkspace")" href="/CommunicationWorkspace/Index">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                    <span>Notices &amp; Notifications</span>
                </a>
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/CommunicationAdministration")" href="/CommunicationAdministration/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>Communication Administration</span>
                    </a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/CustomFields")" href="/CustomFields/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>Institution Custom Fields</span>
                    </a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/DocumentAdministration")" href="/DocumentAdministration/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>Document Administration</span>
                    </a>
                }
                <a class="nav-link @ActiveFor("/Library")" href="/Library/Index">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#book" /></svg>
                    <span>Library</span>
                </a>
                @if (User?.IsInRole("Teacher") == true || User?.IsInRole("Staff") == true)
                {
                    <a class="nav-link @ActiveFor("/EmployeePortal")" href="/EmployeePortal/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#users" /></svg>
                        <span>Employee self-service</span>
                    </a>
                }




            </nav>
            }
        </aside>

        <button class="sidebar-backdrop" type="button" data-sidebar-close aria-label="@T["CloseMenu"]" tabindex="-1"></button>

        <div class="main-area">
            <header class="topbar">
                <div class="topbar-left">
                    <button class="icon-button mobile-toggle" id="btnSidebarToggle" type="button"
                            aria-controls="sidebarMenu" aria-expanded="false" aria-label="@T["OpenMenu"]">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#menu" /></svg>
                    </button>
                    <div class="page-heading">
                        <h1>@pageTitle</h1>
                        <p>@T["ManageInstitution"]</p>
                    </div>
                </div>

                <div class="topbar-right">
                    <button class="install-button" type="button" data-install-app hidden>
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#download" /></svg>
                        <span>@T["InstallApp"]</span>
                    </button>

                    <form asp-controller="Localization" asp-action="SetLanguage" method="post" class="language-form">
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <label class="visually-hidden" for="uiCulture">@T["Language"]</label>
                        <svg class="edu-icon language-icon" aria-hidden="true"><use href="/images/eduos-icons.svg#globe" /></svg>
                        <select id="uiCulture" name="culture" data-language-selector aria-label="@T["Language"]">
                            <option value="en-BD" selected="@(currentCulture == "en-BD" ? "selected" : null)">@T["English"]</option>
                            <option value="bn-BD" selected="@(currentCulture == "bn-BD" ? "selected" : null)">@T["Bangla"]</option>
                        </select>
                    </form>

                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <button class="user-box" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@T["AccountMenu"]">
                                <span class="user-avatar" aria-hidden="true">@userInitial</span>
                                <span class="user-info">
                                    <span class="name">@userName</span>
                                    <span class="role">@(User?.IsInRole("SuperAdmin") == true ? "SuperAdmin" : T["TenantAdmin"].Value)</span>
                                </span>
                                <svg class="edu-icon user-chevron" aria-hidden="true"><use href="/images/eduos-icons.svg#chevron-down" /></svg>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 p-2">
                                <li><a class="dropdown-item rounded-3" href="/Account/Profile">@T["Profile"]</a></li>
                                <li><a class="dropdown-item rounded-3" href="/LoginActivity/Index">Sign-in activity</a></li>
                                <li><a class="dropdown-item rounded-3" href="/LegalDocuments/My">My Legal Agreements</a></li>
                                <li><a class="dropdown-item rounded-3" href="/Account/Profile#passwordForm">@T["ChangePassword"]</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit" class="dropdown-item rounded-3 text-danger">@T["Logout"]</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-primary topbar-login" href="/Account/Login">@T["Login"]</a>
                    }
                </div>
            </header>

            <main class="page-body" id="main-content" tabindex="-1">
                @RenderBody()
            </main>

            <footer class="footer-bar">
                <span>© @DateTime.Now.Year EduOS</span>
                <span aria-hidden="true">•</span>
                <span>@T["Footer"]</span>
            </footer>
        </div>
    </div>

    <div class="visually-hidden" aria-live="polite" data-app-status></div>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
