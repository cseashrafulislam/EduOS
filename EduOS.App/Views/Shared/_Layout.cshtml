@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Microsoft.Extensions.Configuration.IConfiguration PilotConfiguration
@inject EduOS.Core.Interfaces.IServices.ITenantModuleService TenantModuleService
@{
    var pilotCoreOnly = string.Equals(PilotConfiguration["PilotRelease:Enabled"], "true", StringComparison.OrdinalIgnoreCase);
    // One current-tenant entitlement read per shell render; never cache it across users or institutes.
    var availableOptionalModules = await EduOS.App.Authorization.OptionalModuleNavigation.GetAvailableAsync(
        TenantModuleService, pilotCoreOnly,
        User?.Identity?.IsAuthenticated == true && User?.IsInRole("SuperAdmin") != true);
    var showLms = availableOptionalModules.Contains("LMS");
    var showLibrary = availableOptionalModules.Contains("LIBRARY");
    var showHostel = availableOptionalModules.Contains("HOSTEL");
    var showTransport = availableOptionalModules.Contains("TRANSPORT");
    var showInventory = availableOptionalModules.Contains("INVENTORY");
    var showFacilities = availableOptionalModules.Contains("FACILITIES");
    var showAlumni = availableOptionalModules.Contains("ALUMNI");
    var v2RoleLinks = EduOS.App.Authorization.V2RolePortalNavigation.GetLinks(availableOptionalModules, User);
    var titleKey = ViewData["Title"]?.ToString() ?? "Dashboard";
    var localizedTitle = T[titleKey];
    var pageTitle = localizedTitle.ResourceNotFound ? titleKey : localizedTitle.Value;
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var userName = User?.Identity?.Name;
    var userInitial = string.IsNullOrWhiteSpace(userName)
        ? "U"
        : userName[..1].ToUpper(CultureInfo.CurrentCulture);
    var currentPath = Context.Request.Path.Value ?? string.Empty;
    string ActiveFor(string routePrefix) =>
        currentPath.StartsWith(routePrefix, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    var requestVerificationToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var sessionClaim = User?.FindFirst(EduOS.App.Security.AuthSessionRegistry.ClaimType)?.Value;
    var sessionReference = string.IsNullOrWhiteSpace(sessionClaim) ? "" : EduOS.App.Security.AuthSessionRegistry.ToPublicReference(sessionClaim);
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="color-scheme" content="light" />
    <meta name="application-name" content="EduOS" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="EduOS" />
    <meta name="description" content="@T["EducationOperatingSystem"]" />
    <meta name="request-verification-token" content="@requestVerificationToken" />
    <title>@pageTitle - EduOS</title>

    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" href="~/images/eduos-icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-auth-session-reference="@sessionReference" data-auth-tenant-id="@(User?.FindFirst("TenantId")?.Value ?? "")" data-workspace-preferences="@(User?.Identity?.IsAuthenticated == true && User?.IsInRole("SuperAdmin") != true ? "enabled" : "disabled")">
    <a class="skip-link" href="#main-content">@T["SkipToContent"]</a>

    <div class="app-shell">
        <aside class="sidebar" id="sidebarMenu" aria-label="@T["MainNavigation"]">
            <div class="brand-box">
                <a class="brand-link" href="@(User?.IsInRole("SuperAdmin") == true ? "/Dashboard/Admin" : "/Dashboard/Index")" aria-label="EduOS @T["Dashboard"]">
                    <span class="brand-logo" aria-hidden="true">
                        <svg class="edu-icon edu-icon-lg"><use href="/images/eduos-icons.svg#graduation" /></svg>
                    </span>
                    <span>
                        <span class="brand-title">EduOS</span>
                        <span class="brand-subtitle">@T["EducationERP"]</span>
                    </span>
                </a>
                <button class="icon-button sidebar-close" type="button" data-sidebar-close aria-label="@T["CloseMenu"]">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#close" /></svg>
                </button>
            </div>

            @if (User?.IsInRole("SuperAdmin") == true)
            {
                <div class="menu-title">@(currentCulture == "bn-BD" ? "প্ল্যাটফর্ম প্রশাসন" : "Platform Administration")</div>
                <nav class="nav flex-column" data-sidebar-section="platform">
                    <a class="nav-link @ActiveFor("/Dashboard/Admin")" href="/Dashboard/Admin">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#dashboard" /></svg>
                        <span>@T["Dashboard"]</span>
                    </a>
                    <a class="nav-link @ActiveFor("/PlatformTenants")" href="/PlatformTenants/Index"><span>@(currentCulture == "bn-BD" ? "প্রতিষ্ঠান পরিচালনা" : "Institution Lifecycle")</span></a>
                    <a class="nav-link @ActiveFor("/PlatformCatalogAdministration")" href="/PlatformCatalogAdministration/Index"><span>@(currentCulture == "bn-BD" ? "প্রতিষ্ঠানের ধরন ব্যবস্থাপনা" : "Institution Type Management")</span></a>
                    <a class="nav-link @ActiveFor("/PlatformFeatureAdministration")" href="/PlatformFeatureAdministration/Index"><span>@(currentCulture == "bn-BD" ? "ফিচার ক্যাটালগ ব্যবস্থাপনা" : "Feature Catalog Management")</span></a>
                    <a class="nav-link @ActiveFor("/PlatformProductModuleAdministration")" href="/PlatformProductModuleAdministration/Index"><span>@(currentCulture == "bn-BD" ? "প্রোডাক্ট মডিউল ক্যাটালগ" : "Product Module Catalog")</span></a>
                    <a class="nav-link @ActiveFor("/PlatformInstitutionModulePresets")" href="/PlatformInstitutionModulePresets/Index"><span>@(currentCulture == "bn-BD" ? "প্রতিষ্ঠানের মডিউল প্রিসেট" : "Institution Module Presets")</span></a>
                    <a class="nav-link @ActiveFor("/PlatformModuleFeatures")" href="/PlatformModuleFeatures/Index"><span>@(currentCulture == "bn-BD" ? "প্রোডাক্ট মডিউলের ফিচার" : "Product Module Features")</span></a>
                    <a class="nav-link @ActiveFor("/SubscriptionPlanAdministration")" href="/SubscriptionPlanAdministration/Index"><span>@(currentCulture == "bn-BD" ? "সাবস্ক্রিপশন প্ল্যান ব্যবস্থাপনা" : "Subscription Plan Management")</span></a>
                    <a class="nav-link @ActiveFor("/LegalDocuments/Index")" href="/LegalDocuments/Index"><span>@(currentCulture == "bn-BD" ? "আইনি প্রকাশনা" : "Legal Publications")</span></a>
                    <a class="nav-link @ActiveFor("/SubscriptionPaymentHistory")" href="/SubscriptionPaymentHistory/Index"><span>@(currentCulture == "bn-BD" ? "পেমেন্ট সমন্বয়ের ইতিহাস" : "Payment Reconciliation History")</span></a>
                    <a class="nav-link @ActiveFor("/Account/PaymentVerification")" href="/Account/PaymentVerification">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>@T["ManualPaymentVerification"]</span>
                    </a>
                </nav>
            }
            else
            {
            <div class="menu-title">@T["Main"]</div>
            <nav class="nav flex-column" data-sidebar-section="setup">
                <a class="nav-link @ActiveFor("/Dashboard")" href="/Dashboard/Index">
                    <svg class="edu-icon"><use href="/images/eduos-icons.svg#dashboard" /></svg>
                    <span>@T["Dashboard"]</span>
                </a>
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/TenantUsers")" href="/TenantUsers/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#users" /></svg>
                        <span>@(currentCulture == "bn-BD" ? "ব্যবহারকারী ও ভূমিকা ব্যবস্থাপনা" : "User & Role Management")</span>
                    </a>
                    <a class="nav-link @ActiveFor("/TenantPermissionOverrides")" href="/TenantPermissionOverrides/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#shield" /></svg>
                        <span>@(currentCulture == "bn-BD" ? "সদস্যের বিশেষ অনুমতি" : "Member Permission Exceptions")</span>
                    </a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    @foreach (var institutionTask in new[] {
                        (Path: "/InstitutionManagement/Profile", En: "Institution Profile", Bn: "প্রতিষ্ঠানের প্রোফাইল"),
                        (Path: "/InstitutionManagement/Campuses", En: "Campus Management", Bn: "ক্যাম্পাস পরিচালনা"),
                        (Path: "/InstitutionManagement/Regional", En: "Language & Region", Bn: "ভাষা ও আঞ্চলিক সেটিংস"),
                        (Path: "/InstitutionManagement/Branding", En: "Institution Branding", Bn: "প্রতিষ্ঠানের ব্র্যান্ডিং"),
                        (Path: "/InstitutionManagement/Subdomain", En: "Portal Subdomain", Bn: "পোর্টাল সাবডোমেইন"),
                        (Path: "/InstitutionManagement/History", En: "Change History", Bn: "পরিবর্তনের ইতিহাস")
                    })
                    {
                        <a class="nav-link @ActiveFor(institutionTask.Path)" href="@institutionTask.Path">
                            <svg class="edu-icon"><use href="/images/eduos-icons.svg#institution" /></svg>
                            <span>@(currentCulture == "bn-BD" ? institutionTask.Bn : institutionTask.En)</span>
                        </a>
                    }
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/TenantDomains")" href="/TenantDomains/Index"><span>@(currentCulture == "bn-BD" ? "নিজস্ব ডোমেইন" : "Custom Domains")</span></a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/TenantTerminology")" href="/TenantTerminology/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>@(currentCulture == "bn-BD" ? "প্রতিষ্ঠানের পরিভাষা" : "Institution Terminology")</span>
                    </a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/TenantSettings")" href="/TenantSettings/Index"><span>@(currentCulture == "bn-BD" ? "প্রতিষ্ঠানের সেটিংস" : "Institution Settings")</span></a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/NumberSeries")" href="/NumberSeries/Index"><span>@(currentCulture == "bn-BD" ? "নম্বর সিরিজ" : "Number Series")</span></a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/TenantModules")" href="/TenantModules/Index"><span>@(currentCulture == "bn-BD" ? "প্রতিষ্ঠানের মডিউল" : "Institution Modules")</span></a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/SubscriptionBilling")" href="/SubscriptionBilling/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>@(currentCulture == "bn-BD" ? "সাবস্ক্রিপশন ও বিলিং" : "Subscription & Billing")</span>
                    </a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/IntegrationAdministration")" href="/IntegrationAdministration/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#reports" /></svg>
                        <span>@(currentCulture == "bn-BD" ? "ইন্টিগ্রেশন পরিচালনা" : "Integration Administration")</span>
                    </a>
                }
                @* The Account/InstitutionProfile and Account/CampusSetup routes belong to the
                   onboarding wizard. The post-onboarding institution workspace is canonical here. *@
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/StudentLifecycle")" href="/StudentLifecycle/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#students" /></svg>
                        <span>@(currentCulture == "bn-BD" ? "শিক্ষার্থী স্থানান্তর / প্রস্থান" : "Student Transfer / Exit")</span>
                    </a>
                    <a class="nav-link @ActiveFor("/StudentDocuments")" href="/StudentDocuments/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#students" /></svg>
                        <span>@(currentCulture == "bn-BD" ? "শিক্ষার্থীর নথি" : "Student Documents")</span>
                    </a>
                    <a class="nav-link @ActiveFor("/StudentGuardians")" href="/StudentGuardians/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#users" /></svg>
                        <span>@(currentCulture == "bn-BD" ? "শিক্ষার্থীর অভিভাবক" : "Student Guardians")</span>
                    </a>
                    <a class="nav-link @ActiveFor("/StudentTransferRequests")" href="/StudentTransferRequests/Index#destinationInbox">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#students" /></svg>
                        <span>@(currentCulture == "bn-BD" ? "স্থানান্তর আবেদন ও ইনবক্স" : "Transfer Requests / Inbox")</span>
                    </a>
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/EnrollmentManagement")" href="/EnrollmentManagement/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#students" /></svg>
                        <span>@(currentCulture == "bn-BD" ? "শিক্ষার্থী ভর্তি" : "Student Enrollment")</span>
                    </a>
                    @foreach (var studentAction in new[] {
                        (Path: "/StudentImports/Index", En: "Student Import", Bn: "শিক্ষার্থী আমদানি"),
                        (Path: "/StudentReadmissions/Index", En: "Student Readmission", Bn: "শিক্ষার্থী পুনঃভর্তি"),
                        (Path: "/StudentProgressions/Index", En: "Promotion & Repeat", Bn: "উত্তরণ ও শ্রেণি পুনরাবৃত্তি")
                    })
                    {
                        <a class="nav-link @ActiveFor(studentAction.Path)" href="@studentAction.Path">
                            <svg class="edu-icon"><use href="/images/eduos-icons.svg#students" /></svg>
                            <span>@(currentCulture == "bn-BD" ? studentAction.Bn : studentAction.En)</span>
                        </a>
                    }
                }
                @if (User?.IsInRole("TenantAdmin") == true)
                {
                    @* Onboarding Account/AcademicSetup and Account/ModuleSetup remain valid
                       wizard URLs, but are not duplicate daily-management sidebar entries. *@
                    @foreach (var academicLink in new[] {
                        (Action: "Years", En: "Academic Years", Bn: "শিক্ষাবর্ষ"),
                        (Action: "Terms", En: "Terms / Semesters", Bn: "টার্ম / সেমিস্টার"),
                        (Action: "Departments", En: "Departments", Bn: "বিভাগ"),
                        (Action: "Classes", En: "Programmes, Classes & Grades", Bn: "প্রোগ্রাম, শ্রেণি ও গ্রেড"),
                        (Action: "Sections", En: "Sections / Cohorts", Bn: "শাখা / ব্যাচ"),
                        (Action: "Rooms", En: "Rooms", Bn: "কক্ষ"),
                        (Action: "Subjects", En: "Subjects", Bn: "বিষয়"),
                        (Action: "Curricula", En: "Curriculum", Bn: "পাঠ্যক্রম"),
                        (Action: "Prerequisites", En: "Subject Prerequisites", Bn: "বিষয়ের পূর্বশর্ত"),
                        (Action: "Offerings", En: "Subject Offerings", Bn: "ব্যাচের বিষয় অফার")
                    })
                    {
                        var academicPath = "/AcademicManagement/" + academicLink.Action;
                        <a class="nav-link @ActiveFor(academicPath)" href="@academicPath">
                            <svg class="edu-icon"><use href="/images/eduos-icons.svg#calendar" /></svg>
                            <span>@(currentCulture == "bn-BD" ? academicLink.Bn : academicLink.En)</span>
                        </a>
                    }
                }
            </nav>

            <hr class="sidebar-divider" />
            <div class="menu-title">@T["Academics"]</div>
            <nav class="nav flex-column" data-sidebar-section="academics">
                @if (User?.IsInRole("Student") == true || User?.IsInRole("Guardian") == true || User?.IsInRole("Parent") == true)
                {
                    <a class="nav-link @ActiveFor("/StudentPortal")" href="/StudentPortal/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#students" /></svg>
                        <span>@(currentCulture == "bn-BD" ? "শিক্ষার্থী ও অভিভাবক পোর্টাল" : "Student / Guardian Portal")</span>
                    </a>
                }
                @if (User?.IsInRole("TenantAdmin") == true || User?.IsInRole("Principal") == true ||
                     User?.IsInRole("VicePrincipal") == true || User?.IsInRole("Student") == true ||
                     User?.IsInRole("Guardian") == true || User?.IsInRole("Parent") == true)
                {
                    <a class="nav-link @ActiveFor("/StudentSubjects")" href="/StudentSubjects/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#book" /></svg>
                        <span>@(currentCulture == "bn-BD" ? "ঐচ্ছিক বিষয়ের আবেদন" : "Optional Subject Requests")</span>
                    </a>
                }
                @if (User?.IsInRole("TenantAdmin") == true || User?.IsInRole("AdmissionOfficer") == true)
                {
                    @if (User?.IsInRole("TenantAdmin") == true)
                    {
                        <a class="nav-link @ActiveFor("/Admissions/Forms")" href="/Admissions/Forms">
                            <svg class="edu-icon"><use href="/images/eduos-icons.svg#institution" /></svg>
                            <span>@(currentCulture == "bn-BD" ? "ভর্তি ফরম সেটআপ" : "Admission Form Setup")</span>
                        </a>
                    }
                    @foreach (var admissionTask in new[] {
                        (Path: "/Admissions/NewApplication", En: "New Application", Bn: "নতুন ভর্তি আবেদন"),
                        (Path: "/Admissions/Applications", En: "Application Review", Bn: "আবেদন যাচাই"),
                        (Path: "/Admissions/AssessmentSetup", En: "Assessment Setup", Bn: "ভর্তি পরীক্ষা সেটআপ"),
                        (Path: "/Admissions/Merit", En: "Marks & Merit", Bn: "নম্বর ও মেধাতালিকা")
                    })
                    {
                        <a class="nav-link @ActiveFor(admissionTask.Path)" href="@admissionTask.Path">
                            <svg class="edu-icon"><use href="/images/eduos-icons.svg#institution" /></svg>
                            <span>@(currentCulture == "bn-BD" ? admissionTask.Bn : admissionTask.En)</span>
                        </a>
                    }
                    @if (User?.IsInRole("TenantAdmin") == true)
                    {
                        <a class="nav-link @ActiveFor("/Admissions/Offers")" href="/Admissions/Offers">
                            <svg class="edu-icon"><use href="/images/eduos-icons.svg#institution" /></svg>
                            <span>@(currentCulture == "bn-BD" ? "ভর্তির অফার" : "Admission Offers")</span>
                        </a>
                    }
                    <a class="nav-link @ActiveFor("/Students")" href="/Students/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#students" /></svg>
                        <span>@T["Students"]</span>
                    </a>
                }
                @if (showAlumni && (User?.IsInRole("TenantAdmin") == true || User?.IsInRole("Student") == true))
                {
                    <a class="nav-link @ActiveFor("/Alumni")" href="/Alumni/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#graduation" /></svg>
                        <span>@(currentCulture == "bn-BD" ? "প্রাক্তন শিক্ষার্থী" : "Alumni")</span>
                    </a>
                }
                @if (showAlumni && User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/CareerEmployers")" href="/CareerEmployers/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#institution" /></svg>
                        <span>@(currentCulture.StartsWith("bn", StringComparison.OrdinalIgnoreCase) ? "ক্যারিয়ার নিয়োগদাতা যাচাই" : "Career Employer Verification")</span>
                    </a>
                }
                @if (showAlumni && (User?.IsInRole("TenantAdmin") == true || User?.IsInRole("Student") == true))
                {
                    <a class="nav-link @ActiveFor("/CareerOpportunities")" href="/CareerOpportunities/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#graduation" /></svg>
                        <span>@(currentCulture.StartsWith("bn", StringComparison.OrdinalIgnoreCase) ? "চাকরি ও ইন্টার্নশিপ" : "Jobs & Internships")</span>
                    </a>
                }
                @if (showAlumni && User?.IsInRole("TenantAdmin") == true)
                {
                    <a class="nav-link @ActiveFor("/CareerPlacements")" href="/CareerPlacements/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#graduation" /></svg>
                        <span>@(currentCulture.StartsWith("bn", StringComparison.OrdinalIgnoreCase) ? "প্লেসমেন্ট ও রিপোর্ট" : "Placement & Reports")</span>
                    </a>
                }
                @if (User?.IsInRole("TenantAdmin") == true || User?.IsInRole("AdmissionOfficer") == true)
                {
                    <a class="nav-link @ActiveFor("/LearnerIdentities")" href="/LearnerIdentities/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#students" /></svg>
                        <span>@(currentCulture == "bn-BD" ? "শিক্ষার্থীর পরিচয় নিবন্ধন" : "Learner Identity Registration")</span>
                    </a>
                    @if (User?.IsInRole("TenantAdmin") == true)
                    {
                        <a class="nav-link @ActiveFor("/LearnerIdentities/AccessHistory")" href="/LearnerIdentities/AccessHistory"><span>@(currentCulture == "bn-BD" ? "পরিচয় তথ্য দেখার ইতিহাস" : "Identity Access History")</span></a>
                    }
                }


                @if (showLms && (User?.IsInRole("TenantAdmin") == true || User?.IsInRole("Principal") == true ||
                     User?.IsInRole("Teacher") == true || User?.IsInRole("Student") == true))
                {
                    <a class="nav-link @ActiveFor("/Learning") href="/Learning/Index">
                        <svg class="edu-icon"><use href="/images/eduos-icons.svg#book" /></svg>
                        <span>@T["V2LearningManagement"]</span>
                    </a>
