@{
    ViewData["Title"] = "Student & Guardian Portal";
}
<section class="container-fluid py-3" aria-labelledby="studentPortalTitle">
    <header class="mb-3">
        <h2 id="studentPortalTitle">Student & guardian portal</h2>
        <p class="text-muted">Only your own or explicitly linked students are visible. Each section respects institutional module access.</p>
        <a class="btn btn-outline-primary btn-sm" href="/MyStudentLeaves/Index">Request Student Leave</a>
        @if (User.IsInRole("Guardian") || User.IsInRole("Parent"))
        {
            <a class="btn btn-outline-secondary btn-sm" href="#guardianPreferences">Communication preferences</a>
        }
    </header>
    @if (User.IsInRole("Student") || User.IsInRole("Parent") || User.IsInRole("Guardian"))
    {
        <section class="card mb-3" id="learnerConsents" aria-labelledby="learnerConsentsTitle">
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
                    <h3 id="learnerConsentsTitle" class="h5 mb-0">Learner data-sharing consent</h3>
                    <button id="learnerConsentRefresh" class="btn btn-outline-primary btn-sm" type="button">Refresh consents</button>
                </div>
                <p class="text-muted small mt-2">Review which institutions request learner information, approve or deny requests, and revoke existing grants. Only students you control or are linked to can be managed. Approvals may share data across institutions.</p>
                @Html.AntiForgeryToken()
                <div id="learnerConsentAlert" class="d-none" role="status" aria-live="polite"></div>
                <h4 class="h6 mt-3">Pending requests</h4>
                <div id="learnerConsentPending" aria-live="polite"><p class="text-muted">Loading pending requests…</p></div>
                <h4 class="h6 mt-3">Active data grants</h4>
                <div id="learnerConsentGrants" aria-live="polite"><p class="text-muted">Loading active grants…</p></div>
            </div>
        </section>
    }
    @if (User.IsInRole("Guardian") || User.IsInRole("Parent"))
    {
        <section class="card mb-3" id="guardianPreferences" aria-labelledby="guardianPreferencesTitle">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <h3 class="h5 mb-0" id="guardianPreferencesTitle">Guardian communication preferences</h3>
                    <button class="btn btn-outline-primary btn-sm" type="button" id="guardianPreferenceRefresh">Refresh</button>
                </div>
                <p class="text-muted small mt-2">Choose whether your linked students' school may contact you by SMS or email. Student relationships, primary guardian and pickup permissions are managed by the institution.</p>
                @Html.AntiForgeryToken()
                <div class="d-none" id="guardianPreferenceAlert" role="status" aria-live="polite"></div>
                <div id="guardianPreferenceList" aria-live="polite"><p class="text-muted">Loading preferences…</p></div>
            </div>
        </section>
    }
    <div id="studentPortalAlert" class="d-none" role="alert" tabindex="-1"></div>
    <section class="card mb-3"><div class="card-body row g-3 align-items-end">
        <div class="col-md-6"><label class="form-label" for="studentPortalStudent">Student</label>
            <select id="studentPortalStudent" class="form-select"><option value="">Loading linked students…</option></select>
        </div>
        <div class="col-md-3"><label for="studentPortalFrom" class="form-label">Attendance from</label><input id="studentPortalFrom" type="date" class="form-control" /></div>
        <div class="col-md-3"><label for="studentPortalTo" class="form-label">Attendance to</label><input id="studentPortalTo" type="date" class="form-control" /></div>
    </div></section>
    <nav class="d-flex flex-wrap gap-2 mb-3" aria-label="Student portal sections" id="studentPortalTabs">
        <button type="button" class="btn btn-primary" data-portal-tab="timetable">Timetable</button>
        <button type="button" class="btn btn-outline-primary" data-portal-tab="attendance">Attendance</button>
        <button type="button" class="btn btn-outline-primary" data-portal-tab="results">Results</button>
        <button type="button" class="btn btn-outline-primary" data-portal-tab="fees">Fees</button>
        <button type="button" class="btn btn-outline-primary" data-portal-tab="transport">Transport</button>
        <button type="button" class="btn btn-outline-primary" data-portal-tab="homework">Homework</button>
        <button type="button" class="btn btn-outline-primary" data-portal-tab="assignments">Assignments</button>
    </nav>
    <section class="card"><div class="card-body">
        <div class="d-flex gap-2 justify-content-between align-items-center">
            <h3 id="studentPortalSectionTitle" class="h5 mb-2">Timetable</h3>
            <button id="studentPortalRefresh" class="btn btn-outline-secondary btn-sm" type="button">Refresh</button>
        </div>
        <div id="studentPortalSummary" class="small text-muted mb-2" aria-live="polite"></div>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
            <thead id="studentPortalHeaders"></thead><tbody id="studentPortalRows"><tr><td>Choose a student to load data.</td></tr></tbody>
        </table></div>
        <div id="studentPortalExtra" class="mt-3"></div>
    </div></section>
</section>
@section Scripts {
    <script src="~/js/student-portal/consents.js" asp-append-version="true"></script>
    <script src="~/js/student-portal/guardian-preferences.js" asp-append-version="true"></script>
    <script src="~/js/student-portal/index.js" asp-append-version="true"></script>
}
