@model EduOS.Core.DTOs.Portals.PortalFeeDocumentDto
@{
    ViewData["Title"] = Model.DocumentType + " " + Model.DocumentNumber;
    var kind = Model.DocumentType == "Invoice" ? "invoice" : "receipt";
    var csvUrl = Url.Action("FeeDocumentCsv", "StudentPortal", new {
        studentReference = Model.StudentReference, documentReference = Model.Reference, kind });
}
<section class="container py-3" id="portalFeeDocument" aria-labelledby="portalFeeDocumentTitle">
    <header class="d-flex justify-content-between align-items-start gap-2 mb-3">
        <div>
            <h1 class="h4 mb-1" id="portalFeeDocumentTitle">@Model.DocumentType — @Model.DocumentNumber</h1>
            <div class="text-muted small">Date: @Model.DocumentDate.ToString("yyyy-MM-dd") · Status: @Model.Status</div>
        </div>
        <details class="d-print-none small">
            <summary class="btn btn-outline-secondary btn-sm" aria-label="Document guide" title="Document guide">ⓘ</summary>
            <p class="mt-2 mb-0">This document is read from your linked student's institutional finance records. Save or print only on a trusted device.</p>
        </details>
    </header>
    <div class="d-flex gap-2 mb-3 d-print-none">
        <a class="btn btn-outline-secondary btn-sm" href="/StudentPortal/Index">Back</a>
        <button type="button" id="portalFeePrint" class="btn btn-primary btn-sm">Print / Save PDF</button>
        <a class="btn btn-outline-primary btn-sm" href="@csvUrl">Export CSV</a>
    </div>
    <div class="card">
        <div class="card-body">
            <dl class="row mb-3">
                <dt class="col-sm-3">Student</dt><dd class="col-sm-9">@Model.StudentName (@Model.StudentCode)</dd>
                <dt class="col-sm-3">Currency</dt><dd class="col-sm-9">@Model.CurrencyCode</dd>
                @if (Model.DueDate.HasValue) {
                    <dt class="col-sm-3">Due date</dt><dd class="col-sm-9">@Model.DueDate.Value.ToString("yyyy-MM-dd")</dd>
                }
                @if (!string.IsNullOrWhiteSpace(Model.PaymentMethod)) {
                    <dt class="col-sm-3">Payment method</dt><dd class="col-sm-9">@Model.PaymentMethod</dd>
                }
            </dl>
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle">
                    <thead><tr><th scope="col">Description</th><th scope="col" class="text-end">Amount</th><th scope="col" class="text-end">Discount</th><th scope="col" class="text-end">Fine</th><th scope="col" class="text-end">Net</th></tr></thead>
                    <tbody>
                    @foreach (var line in Model.Lines) {
                        <tr><td>@line.Description</td><td class="text-end">@line.Amount.ToString("N2")</td><td class="text-end">@line.DiscountAmount.ToString("N2")</td><td class="text-end">@line.FineAmount.ToString("N2")</td><td class="text-end">@line.NetAmount.ToString("N2")</td></tr>
                    }
                    </tbody>
                    <tfoot><tr class="fw-semibold"><th scope="row">Total</th><td class="text-end">@Model.Subtotal.ToString("N2")</td><td class="text-end">@Model.DiscountAmount.ToString("N2")</td><td class="text-end">@Model.FineAmount.ToString("N2")</td><td class="text-end">@Model.TotalAmount.ToString("N2")</td></tr></tfoot>
                </table>
            </div>
            @if (Model.DocumentType == "Invoice") {
                <div class="d-flex gap-3 justify-content-end"><span>Paid: @Model.PaidAmount.ToString("N2")</span><strong>Due: @Model.DueAmount.ToString("N2")</strong></div>
            }
        </div>
    </div>
</section>
@section Scripts { <script src="~/js/finance/portal-fee-document.js" asp-append-version="true"></script> }
