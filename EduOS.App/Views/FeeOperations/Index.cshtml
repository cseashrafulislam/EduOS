@{ ViewData["Title"] = "Student Fees & Billing"; }
<section id="feeApp" class="container-fluid py-3">
    <header class="mb-3"><h2 class="h4 mb-1">Student Fees &amp; Billing</h2></header>
    <div class="mb-2"><a class="btn btn-outline-primary btn-sm" href="/FeeDiscountRules/Index">Discount Rule Administration</a> <a class="btn btn-outline-primary btn-sm" href="/StudentInvoicePosting/Index">Student Invoice GL Posting</a> <a class="btn btn-outline-primary btn-sm" href="/StudentPaymentPosting/Index">Student Cash Receipt GL Posting</a> <a class="btn btn-outline-primary btn-sm" href="/FinanceAdjustments/Index#adjustRefundSection">Cash Refunds &amp; GL Settlement</a></div>
    <div class="d-none" tabindex="-1" id="feeAlert" role="alert" aria-live="polite"></div>
    <div class="row g-3 mb-3">
        <div class="col-xl-6"><section class="card h-100">
            <div class="card-header"><h3 class="h6 m-0">Fee structure</h3></div>
            <form id="feeStructureForm" class="card-body row g-2 align-items-end">
                <div class="col-md-6"><label for="feeCampus" class="form-label">Campus</label><select id="feeCampus" class="form-select" required></select></div>
                <div class="col-md-6"><label for="feeYear" class="form-label">Academic year</label><select id="feeYear" class="form-select" required><option value="">Loading…</option></select></div>
                <div class="col-md-6"><label for="feeLevel" class="form-label">Academic level</label><select id="feeLevel" class="form-select" required><option value="">Loading…</option></select></div>
                <div class="col-md-6"><label for="feeStructureBatch" class="form-label">Batch scope (optional)</label><select id="feeStructureBatch" class="form-select"></select></div>
                <div class="col-md-6"><label for="feeStructureName" class="form-label">Structure name</label><input id="feeStructureName" maxlength="150" class="form-control" required /></div>
                <div class="col-md-6"><label for="feeEffectiveFrom" class="form-label">Effective from</label><input id="feeEffectiveFrom" type="date" class="form-control" required /></div>
                <div class="col-md-6"><label for="feeEffectiveTo" class="form-label">Effective to (optional)</label><input id="feeEffectiveTo" type="date" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label d-block">Status</label><label><input id="feeStructureActive" type="checkbox" checked /> Active</label></div>
                <div class="col-12"><div class="d-flex justify-content-between"><strong>Fee heads (BDT)</strong><button id="feeAddLine" type="button" class="btn btn-outline-secondary btn-sm">Add fee head</button></div>
                <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Fee head</th><th>Frequency</th><th>Amount</th><th>Due day</th><th>Mandatory</th><th>Action</th></tr></thead><tbody id="feeLineRows"></tbody></table></div></div>
                <div class="col-12"><p id="feeStructureMode" class="small text-muted mb-2">Creating a new fee structure.</p><button id="feeSaveStructure" class="btn btn-primary" type="submit">Save fee structure</button> <button id="feeStructureReset" class="btn btn-outline-secondary" type="button">New structure</button></div>
            </form>
        </section></div>
        <div class="col-xl-6"><section class="card h-100">
            <div class="card-header"><h3 class="h6 m-0">Generate monthly invoices</h3></div>
            <form id="feeInvoiceForm" class="card-body row g-2 align-items-end">
                <div class="col-12"><label for="feeBatch" class="form-label">Active batch</label><select id="feeBatch" class="form-select" required></select></div>
                <div class="col-12"><label for="feeInvoiceStructure" class="form-label">Applicable fee structure</label><select id="feeInvoiceStructure" class="form-select" required></select></div>
                <div class="col-4"><label for="feeMonth" class="form-label">Month</label><select id="feeMonth" class="form-select">@for(var m=1;m<=12;m++){<option value="@m">@System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m)</option>}</select></div>
                <div class="col-4"><label for="feeBillingYear" class="form-label">Year</label><input id="feeBillingYear" type="number" min="2000" max="2200" class="form-control" required /></div>
                <div class="col-4"><label for="feeDueDate" class="form-label">Due date</label><input id="feeDueDate" type="date" class="form-control" required /></div>
                <div class="col-12"><button id="feeGenerate" class="btn btn-primary" type="submit">Generate invoices</button></div>
                <p id="feeGenerationInfo" class="text-muted small mb-0">Existing invoices will not be duplicated for the same request.</p>
            </form>
        </section></div>
    </div>
    @if (User.IsInRole("TenantAdmin"))
    {
        <section class="card mb-3" id="feeStructureRegister">
            <div class="card-header"><h3 class="h6 m-0">Fee structure register and amendments</h3></div>
            <div class="card-body row g-2 align-items-end">
                <div class="col-md-5"><label for="feeRegisterCampus" class="form-label">Campus</label><select id="feeRegisterCampus" class="form-select"><option value="">All campuses</option></select></div>
                <div class="col-md-7 small text-muted">View historical/inactive structures, amend unbilled versions or copy a structure as a new one. Billed financial terms cannot be edited.</div>
            </div>
            <div class="table-responsive"><table class="table table-sm table-hover mb-0"><thead><tr><th>Name</th><th>Campus</th><th>Academic year</th><th>Effective</th><th>Status</th><th>Action</th></tr></thead><tbody id="feeRegisterRows"><tr><td colspan="6">Loading…</td></tr></tbody></table></div>
            <form id="feeStructureCloseForm" class="card-body border-top d-none" autocomplete="off">
                <div class="alert alert-warning small mb-2">Close future monthly billing for the selected structure. Existing invoices, payments and fee lines are preserved. The closure date must be the last day of the current or a future month; reopening or extending a closure is not supported.</div>
                <input id="feeCloseId" type="hidden" /><input id="feeCloseVersion" type="hidden" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-5"><label class="form-label" for="feeCloseName">Selected structure</label><input id="feeCloseName" class="form-control" readonly /></div>
                    <div class="col-md-3"><label class="form-label" for="feeCloseDate">Final effective date</label><input id="feeCloseDate" type="date" class="form-control" required /></div>
                    <div class="col-md-4"><button id="feeCloseSubmit" class="btn btn-danger" type="submit">Close future billing</button> <button id="feeCloseCancel" class="btn btn-outline-secondary" type="button">Cancel</button></div>
                </div>
            </form>
            <div class="card-footer d-flex gap-2 align-items-center"><button id="feeRegisterPrev" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous</button><span id="feeRegisterPage" class="small">—</span><button id="feeRegisterNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next</button></div>
        </section>
    }
    <section class="card mb-3">
        <div class="card-header"><h3 class="h6 m-0">Student ledger and cash collection</h3></div>
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-5"><label for="feeStudentSearch" class="form-label">Search student by name/code</label><div class="input-group"><input id="feeStudentSearch" maxlength="100" class="form-control" /><button id="feeFindStudent" type="button" class="btn btn-outline-primary">Search</button></div></div>
                <div class="col-md-5"><label for="feeStudent" class="form-label">Select student</label><select id="feeStudent" class="form-select"><option value="">Find student</option></select></div>
                <div class="col-md-2"><button id="feeLoadLedger" type="button" class="btn btn-primary w-100">View ledger</button></div>
            </div>
            <p id="feeLedgerSummary" class="mt-3 mb-2 text-muted">No ledger loaded.</p>
        </div>
        <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead><tr><th>Invoice</th><th>Date</th><th>Due date</th><th>Total</th><th>Paid</th><th>Outstanding</th><th>Action</th></tr></thead><tbody id="feeInvoices"><tr><td colspan="7" class="text-center text-muted p-3">Select a student.</td></tr></tbody></table></div>
        <div class="card-footer d-flex gap-2 align-items-center"><button type="button" id="feeInvoicePrev" class="btn btn-outline-secondary btn-sm" disabled>Previous</button><span id="feeInvoicePage" class="small text-muted">—</span><button type="button" id="feeInvoiceNext" class="btn btn-outline-secondary btn-sm" disabled>Next</button></div>
    </section>
    @if (User.IsInRole("TenantAdmin"))
    {
        <section id="feeAllocationAudit" class="card mb-3 d-none" aria-labelledby="feeAuditTitle">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="h6 m-0" id="feeAuditTitle">Invoice receipt allocation audit</h3>
                <button type="button" id="feeAuditClose" class="btn btn-outline-secondary btn-sm">Close</button>
            </div>
            <div class="card-body">
                <p id="feeAuditSummary" class="mb-2" role="status" aria-live="polite"></p>
                <button type="button" id="feeAuditCsv" class="btn btn-outline-primary btn-sm" disabled>Export displayed page (CSV)</button>
            </div>
            <div class="table-responsive"><table class="table table-sm mb-0">
                <thead><tr><th>Receipt</th><th>Date</th><th>Allocation (BDT)</th><th>Payment state</th><th>GL journal</th></tr></thead>
                <tbody id="feeAuditRows"></tbody>
            </table></div>
            <div class="card-footer d-flex gap-2 align-items-center">
                <button type="button" id="feeAuditPrev" class="btn btn-outline-secondary btn-sm" disabled>Previous</button>
                <span id="feeAuditPage" class="small" aria-live="polite"></span>
                <button type="button" id="feeAuditNext" class="btn btn-outline-secondary btn-sm" disabled>Next</button>
            </div>
        </section>
    }
    <section id="feePaymentPanel" class="card mb-3 d-none">
        <div class="card-header"><h3 class="h6 m-0">Collect cash payment</h3></div>
        <form id="feePaymentForm" class="card-body row g-2 align-items-end">
            <div class="col-md-3"><label for="feePaymentDate" class="form-label">Payment date</label><input id="feePaymentDate" type="date" class="form-control" required /></div>
            <div class="col-md-6"><label for="feePaymentInvoice" class="form-label">Selected invoice</label><input id="feePaymentInvoice" class="form-control" readonly /></div>
            <div class="col-md-3"><label for="feePaymentAmount" class="form-label">Cash amount</label><input id="feePaymentAmount" min=".01" step=".01" type="number" class="form-control" required /></div>
            <div class="col-md-3"><button id="feeCollect" type="submit" class="btn btn-primary w-100">Record cash receipt</button></div>
        </form>
    </section>
    <section class="card mb-3"><div class="card-header"><h3 class="h6 m-0">Receipt history</h3></div>
        <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Receipt</th><th>Date</th><th>Amount</th><th>Method</th><th>Allocation</th><th>Document</th></tr></thead><tbody id="feeReceipts"><tr><td colspan="6">Select a student.</td></tr></tbody></table></div>
        <div class="card-footer d-flex gap-2 align-items-center"><button type="button" id="feeReceiptPrev" class="btn btn-outline-secondary btn-sm" disabled>Previous</button><span id="feeReceiptPage" class="small text-muted">—</span><button type="button" id="feeReceiptNext" class="btn btn-outline-secondary btn-sm" disabled>Next</button></div>
    </section>
</section>
@section Scripts { <script src="~/js/finance/fees.js" asp-append-version="true"></script> }
