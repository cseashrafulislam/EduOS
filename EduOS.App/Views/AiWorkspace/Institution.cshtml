@{
    var bn = System.Globalization.CultureInfo.CurrentUICulture.Name == "bn-BD";
    ViewData["Title"] = bn ? "Ask EduOS — প্রতিষ্ঠান রিপোর্ট" : "Ask EduOS — Institution Reports";
}
<section id="aiInstitutionWorkspace" class="container-fluid py-2" data-lang="@(bn ? "bn" : "en")">
    @Html.AntiForgeryToken()
    <header class="mb-3">
        <h1 class="h4 mb-1">@ViewData["Title"]</h1>
        <p class="text-muted small mb-0">@(bn ?
            "বিদ্যমান MIS রিপোর্ট থেকে যাচাইকৃত উত্তর; বাইরের AI-তে তথ্য যায় না। Current ও Period-এর পার্থক্য দেখানো হবে।" :
            "Verified existing MIS reports. No external AI processing. Current and period values are labelled separately.")</p>
    </header>
    <div class="card border-0 shadow-sm"><div class="card-body">
        <form id="aiInstitutionForm" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label for="aiInstitutionFrom" class="form-label">@(bn ? "শুরু" : "From")</label>
                <input id="aiInstitutionFrom" type="date" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label for="aiInstitutionTo" class="form-label">@(bn ? "শেষ" : "To")</label>
                <input id="aiInstitutionTo" type="date" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label for="aiInstitutionQuestion" class="form-label">@(bn ? "কোন তথ্য জানতে চান?" : "Ask one metric")</label>
                <input id="aiInstitutionQuestion" type="text" list="aiInstitutionSuggestions"
                       maxlength="120" minlength="3" class="form-control" required
                       placeholder="@(bn ? "যেমন: বকেয়া ফি" : "e.g. outstanding fee amount")" />
                <datalist id="aiInstitutionSuggestions">
                    <option value="@(bn ? "বকেয়া ফি" : "outstanding fee amount")"></option>
                    <option value="@(bn ? "বকেয়া ফি ইনভয়েস" : "outstanding fee invoices")"></option>
                    <option value="@(bn ? "সক্রিয় শিক্ষার্থী" : "active students")"></option>
                    <option value="@(bn ? "সক্রিয় কর্মচারী" : "active employees")"></option>
                    <option value="@(bn ? "চূড়ান্ত অনুপস্থিতি" : "finalized absences")"></option>
                    <option value="@(bn ? "প্রকাশিত ফলাফলের সংস্করণ" : "published result versions")"></option>
                    <option value="@(bn ? "পোস্টেড আয়" : "posted income")"></option>
                    <option value="@(bn ? "পোস্টেড ব্যয়" : "posted expenses")"></option>
                    <option value="@(bn ? "নিট উদ্বৃত্ত" : "net surplus")"></option>
                    <option value="@(bn ? "চূড়ান্ত হাজিরা সেশন" : "finalized attendance sessions")"></option>
                    <option value="@(bn ? "খোলা ওয়ার্ক অর্ডার" : "open work orders")"></option>
                </datalist>
            </div>
            <div class="col-12">
                <button id="aiInstitutionAsk" type="submit" class="btn btn-primary">
                    @(bn ? "যাচাইকৃত উত্তর দেখুন" : "Get verified answer")
                </button>
            </div>
        </form>
        <div id="aiInstitutionNotice" class="small mt-2" role="status" aria-live="polite"></div>
        <div id="aiInstitutionAnswer" class="border rounded mt-3 p-3 d-none" aria-live="polite">
            <div id="aiInstitutionMetric" class="h6 mb-1"></div>
            <div id="aiInstitutionValue" class="h4 mb-2"></div>
            <p id="aiInstitutionDefinition" class="small mb-2"></p>
            <p id="aiInstitutionSource" class="small text-muted mb-0"></p>
        </div>
    </div></div>
</section>
@section Scripts {
    <script src="~/js/ai/institution-questions.js" asp-append-version="true"></script>
}
