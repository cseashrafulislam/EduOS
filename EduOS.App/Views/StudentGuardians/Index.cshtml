@{
    ViewData["Title"] = "Student Guardians";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="guardianWorkspace" class="container-fluid py-4">
    @Html.AntiForgeryToken()
    <header class="mb-3">
        <h1 class="h4">Student Guardians</h1>
        <p class="text-muted">Manage guardian relationships, primary, emergency and financial contacts, and communication/pickup permissions. Changes are limited to your institution.</p>
    </header>
    <div id="guardianNotice" class="alert alert-info" role="status" aria-live="polite">Search for a student to begin.</div>
    <div class="row g-3">
        <div class="col-lg-5">
            <section class="card shadow-sm border-0"><div class="card-body">
                <h2 class="h6">Find student</h2>
                <form id="guardianSearchForm" class="input-group">
                    <input id="guardianSearch" class="form-control" maxlength="100" placeholder="Student code or name" aria-label="Student search" required />
                    <button type="submit" class="btn btn-outline-primary">Search</button>
                </form>
                <div id="guardianMatches" class="list-group mt-3" aria-live="polite"></div>
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <h2 id="guardianSelected" class="h6 mb-0"></h2>
                    <button id="guardianRefresh" class="btn btn-sm btn-outline-secondary" type="button" disabled>Refresh</button>
                </div>
            </div></section>
            <section class="card shadow-sm border-0 mt-3"><div class="card-body">
                <h2 class="h6">Link a new guardian</h2>
                <form id="guardianCreateForm" class="row g-2">
                    <div class="col-12"><label class="form-label" for="guardianName">Full name *</label>
                        <input id="guardianName" class="form-control" required maxlength="200" autocomplete="off" /></div>
                    <div class="col-md-6"><label class="form-label" for="guardianPhone">Phone</label>
                        <input id="guardianPhone" class="form-control" maxlength="30" autocomplete="off" /></div>
                    <div class="col-md-6"><label class="form-label" for="guardianEmail">Email</label>
                        <input id="guardianEmail" class="form-control" type="email" maxlength="200" autocomplete="off" /></div>
                    <div class="col-md-6"><label class="form-label" for="guardianOccupation">Occupation</label>
                        <input id="guardianOccupation" class="form-control" maxlength="150" /></div>
                    <div class="col-md-6"><label class="form-label" for="guardianRelation">Relationship *</label>
                        <select id="guardianRelation" class="form-select" required>
                            <option value="Father">Father</option><option value="Mother">Mother</option>
                            <option value="LegalGuardian">Legal guardian</option><option value="Other">Other</option>
                        </select></div>
                    <div class="col-12"><label class="form-label" for="guardianAddress">Address</label>
                        <textarea id="guardianAddress" class="form-control" maxlength="1000" rows="2"></textarea></div>
                    <div class="col-12 form-check ms-2"><input id="guardianPrimary" class="form-check-input" type="checkbox" />
                        <label for="guardianPrimary" class="form-check-label">Primary guardian</label></div>
                    <div class="col-12 form-check ms-2"><input id="guardianSms" class="form-check-input" type="checkbox" checked />
                        <label for="guardianSms" class="form-check-label">May receive SMS</label></div>
                    <div class="col-12 form-check ms-2"><input id="guardianEmailAllowed" class="form-check-input" type="checkbox" checked />
                        <label for="guardianEmailAllowed" class="form-check-label">May receive email</label></div>
                    <div class="col-12 form-check ms-2"><input id="guardianPickup" class="form-check-input" type="checkbox" />
                        <label for="guardianPickup" class="form-check-label">Authorized to pick up student</label></div>
                    <div class="col-12 form-check ms-2"><input id="guardianFinancial" class="form-check-input" type="checkbox" />
                        <label for="guardianFinancial" class="form-check-label">Financial contact (institution-authorized)</label></div>
                    <div class="col-12 form-check ms-2"><input id="guardianEmergency" class="form-check-input" type="checkbox" />
                        <label for="guardianEmergency" class="form-check-label">Emergency contact (institution-authorized)</label></div>
                    <div class="col-12"><button id="guardianCreate" class="btn btn-primary" type="submit" disabled>Save guardian</button></div>
                </form>
            </div></section>
        </div>
        <div class="col-lg-7">
            <section class="card shadow-sm border-0"><div class="card-body">
                <h2 class="h6">Linked guardians</h2>
                <p class="small text-muted">Edit relationships and permissions below. Assign a new primary guardian before removing the only primary contact. Concurrent edits require a refresh.</p>
                <div id="guardianLinks" aria-live="polite"><p class="text-muted">Select a student to view guardians.</p></div>
            </div></section>
        </div>
    </div>
</div>
@section Scripts {
    <script type="module" src="~/js/students/guardians.js" asp-append-version="true"></script>
}
