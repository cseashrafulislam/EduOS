@{
    ViewData["Title"] = "Admission assessments";
}
<section class="admission-page" aria-labelledby="assessmentTitle">
    <header class="content-header-card">
        <div><p class="dashboard-eyebrow">Admissions / ভর্তি</p><h2 id="assessmentTitle">Assessment &amp; Merit / ভর্তি পরীক্ষা ও মেধাতালিকা</h2>
        <p>Manage intake assessments, record marks and publish results.</p></div>
        <a class="btn btn-outline-secondary" asp-controller="Admissions" asp-action="Index">Applications</a>
    </header>
    @Html.AntiForgeryToken()
    <div id="assessmentAlert" class="d-none" role="alert" tabindex="-1"></div>
    <section class="content-card mb-3" aria-labelledby="createAssessmentTitle">
        <div class="content-card-heading"><h3 id="createAssessmentTitle">Create assessment</h3></div>
        <form id="assessmentCreateForm" class="row g-3">
            <div class="col-md-6"><label for="assessmentForm" class="form-label">Admission intake *</label><select id="assessmentForm" class="form-select" required></select></div>
            <div class="col-md-6"><label for="assessmentName" class="form-label">Assessment name *</label><input id="assessmentName" class="form-control" maxlength="150" required /></div>
            <div class="col-md-3"><label for="assessmentDate" class="form-label">Date *</label><input id="assessmentDate" class="form-control" type="date" required /></div>
            <div class="col-md-3"><label for="assessmentTotal" class="form-label">Total marks *</label><input id="assessmentTotal" class="form-control" type="number" min="0.01" max="1000000" step="0.01" value="100" required /></div>
            <div class="col-md-3"><label for="assessmentPass" class="form-label">Pass marks *</label><input id="assessmentPass" class="form-control" type="number" min="0" max="1000000" step="0.01" value="40" required /></div>
            <div class="col-md-3"><label for="assessmentDuration" class="form-label">Minutes *</label><input id="assessmentDuration" class="form-control" type="number" min="1" max="1440" value="60" required /></div>
            <div class="col-md-6"><label for="assessmentVenue" class="form-label">Venue</label><input id="assessmentVenue" class="form-control" maxlength="200" /></div>
            <div class="col-12"><button id="assessmentCreateButton" class="btn btn-primary" type="submit">Create assessment</button></div>
        </form>
    </section>
    <section class="content-card mb-3" aria-labelledby="marksTitle">
        <div class="content-card-heading"><h3 id="marksTitle">Applicant marks</h3></div>
        <div class="row g-2 mb-3">
            <div class="col-md-6"><label for="assessmentSelect" class="form-label">Assessment</label><select id="assessmentSelect" class="form-select"></select></div>
            <div class="col-md-4"><label for="assessmentSearch" class="form-label">Search applicant</label><input id="assessmentSearch" class="form-control" maxlength="100" /></div>
            <div class="col-md-2 d-flex align-items-end"><button id="assessmentSearchButton" type="button" class="btn btn-outline-primary w-100">Search</button></div>
        </div>
        <div class="table-responsive"><table class="table table-sm align-middle">
            <thead><tr><th scope="col">Application</th><th scope="col">Applicant</th><th scope="col">Marks</th><th scope="col">Grade</th><th scope="col">Remarks</th></tr></thead>
            <tbody id="assessmentRoster" aria-live="polite"></tbody>
        </table></div>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <button id="assessmentSave" class="btn btn-primary" type="button">Save page marks</button>
            <button id="assessmentPrev" class="btn btn-outline-secondary" type="button">Previous</button>
            <span id="assessmentPage" aria-live="polite"></span>
            <button id="assessmentNext" class="btn btn-outline-secondary" type="button">Next</button>
            <button id="assessmentMerit" class="btn btn-outline-primary" type="button">View merit</button>
            <button id="assessmentPublish" class="btn btn-danger" type="button">Publish merit</button>
        </div>
    </section>
    <section class="content-card" aria-labelledby="meritTitle">
        <div class="content-card-heading"><h3 id="meritTitle">Merit preview / মেধাতালিকা</h3></div>
        <div id="assessmentMeritList" aria-live="polite"></div>
    </section>
</section>
@section Scripts {
    <script type="module" src="~/js/admissions/assessments.js" asp-append-version="true"></script>
}
