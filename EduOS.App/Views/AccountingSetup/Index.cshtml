@{
    ViewData["Title"] = "Institution Accounting Setup";
    var canWrite = User.IsInRole("TenantAdmin") || User.IsInRole("Principal");
    var canReview = User.IsInRole("TenantAdmin");
}
<section class="container-fluid py-3" id="accountingSetup" data-write="@canWrite.ToString().ToLowerInvariant()" data-admin="@canReview.ToString().ToLowerInvariant()">
    <h2>Institution Accounting Setup</h2>
    <p class="text-muted">Chart of accounts, accounting periods and bank ledgers. Separate from SaaS billing.</p>
    @Html.AntiForgeryToken()
    <div id="accountingNotice" class="alert d-none" role="alert"></div>
    <ul class="nav nav-tabs mb-3">
        <li><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#coaPanel">Accounts</button></li>
        <li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#periodPanel">Periods</button></li>
        @if (canWrite) { <li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#bankPanel">Banks</button></li> }
        @if (canWrite) { <li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#historicalCashPanel">Historical Cash Review</button></li> }
        @if (canWrite) { <li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#cashFlowPolicyPanel">Cash Flow Classification</button></li> }
    </ul>
    <div class="tab-content">
        <div class="tab-pane fade show active" id="coaPanel">
            <div class="d-flex gap-2 mb-2"><input id="accountSearch" class="form-control" maxlength="100" placeholder="Code or name" /><button id="accountSearchBtn" class="btn btn-secondary" type="button">Search</button></div>
            @if (canWrite) {
                <form id="accountForm" class="card card-body mb-2">
                    <input type="hidden" id="accountId" /><input type="hidden" id="accountVersion" />
                    <div class="row g-2">
                        <div class="col-md-2"><label for="accountCode">Code</label><input id="accountCode" class="form-control" maxlength="50" required /></div>
                        <div class="col-md-3"><label for="accountName">Name</label><input id="accountName" class="form-control" maxlength="200" required /></div>
                        <div class="col-md-2"><label for="accountType">Type</label><select id="accountType" class="form-select"><option value="1">Asset</option><option value="2">Liability</option><option value="3">Equity</option><option value="4">Income</option><option value="5">Expense</option></select></div>
                        <div class="col-md-3"><label for="accountParent">Parent group</label><select id="accountParent" class="form-select"><option value="">Root</option></select></div>
                        <div class="col-md-2"><label><input id="accountGroup" type="checkbox" /> Group</label><br /><label><input id="accountActive" type="checkbox" checked /> Active</label><br /><label><input id="accountCash" type="checkbox" /> Cash in hand</label></div>
                    </div>
                    <div class="mt-2"><button class="btn btn-primary" type="submit">Save account</button><button id="accountReset" class="btn btn-outline-secondary" type="button">New</button></div>
                </form>
            }
            <p class="small text-muted">Mark new physical cash ledgers explicitly; a bank-linked ledger cannot be cash. Historical cash classification is locked once any journal exists. Existing cash accounts with history require separately audited conversion, not automatic name matching.</p>
            <div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>Code</th><th>Name</th><th>Type</th><th>Parent</th><th>Cash</th><th>Group</th><th>Active</th>@if(canWrite){<th>Action</th>}</tr></thead><tbody id="accountRows"></tbody></table></div>
            <div class="d-flex gap-2"><button id="accountPrev" type="button" class="btn btn-outline-secondary">Previous</button><span id="accountPage"></span><button id="accountNext" type="button" class="btn btn-outline-secondary">Next</button></div>
        </div>
        <div class="tab-pane fade" id="periodPanel">
            @if (canWrite) {
                <form id="periodForm" class="card card-body mb-2">
                    <input type="hidden" id="periodId" /><input type="hidden" id="periodVersion" />
                    <div class="row g-2">
                        <div class="col-md-4"><label for="periodName">Name</label><input id="periodName" class="form-control" maxlength="100" required /></div>
                        <div class="col-md-3"><label for="periodFrom">Start</label><input id="periodFrom" type="date" class="form-control" required /></div>
                        <div class="col-md-3"><label for="periodTo">End</label><input id="periodTo" type="date" class="form-control" required /></div>
                        <div class="col-md-2"><button class="btn btn-primary" type="submit">Save period</button></div>
                    </div>
                    <button id="periodReset" class="btn btn-link" type="button">New period</button>
                </form>
            }
            <p class="small text-muted">Period closure reconciles posted journals and refuses to ignore legacy soft-deleted journal headers or lines. Resolve historical discrepancies before closing.</p>
            @if (canWrite) { <div id="periodCloseReadiness" class="alert alert-info d-none" role="status" aria-live="polite"></div> }
            <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Period</th><th>Start</th><th>End</th><th>Status</th>@if(canWrite){<th>Action</th>}</tr></thead><tbody id="periodRows"></tbody></table></div>
        </div>
        @if (canWrite) {
            <div class="tab-pane fade" id="bankPanel">
                <form id="bankForm" class="card card-body mb-2">
                    <input type="hidden" id="bankId" /><input type="hidden" id="bankVersion" />
                    <div class="row g-2">
                        <div class="col-md-4"><label for="bankLedger">Asset ledger</label><select id="bankLedger" class="form-select" required></select></div>
                        <div class="col-md-4"><label for="bankName">Bank</label><input id="bankName" class="form-control" maxlength="150" required /></div>
                        <div class="col-md-4"><label for="bankAccountName">Account holder</label><input id="bankAccountName" class="form-control" maxlength="150" required /></div>
                        <div class="col-md-4"><label for="bankNumber">Account number</label><input id="bankNumber" class="form-control" maxlength="100" required /></div>
                        <div class="col-md-3"><label for="bankBranch">Branch</label><input id="bankBranch" class="form-control" maxlength="100" /></div>
                        <div class="col-md-3"><label for="bankRouting">Routing</label><input id="bankRouting" class="form-control" maxlength="100" /></div>
                        <div class="col-md-2"><label><input id="bankActive" type="checkbox" checked /> Active</label></div>
                    </div>
                    <div class="mt-2"><button class="btn btn-primary" type="submit">Save bank</button><button id="bankReset" class="btn btn-outline-secondary" type="button">New</button></div>
                </form>
                <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Bank</th><th>Account</th><th>Ledger</th><th>Status</th><th>Action</th></tr></thead><tbody id="bankRows"></tbody></table></div>
            </div>
            <div class="tab-pane fade" id="historicalCashPanel">
                <h3 class="h6 mt-2">Audited Historical Cash-in-Hand Designation</h3>
                <p class="text-muted small">Only for a cash asset ledger already containing journals. This is a non-monetary classification with independent submitter and TenantAdmin reviewer; no posted journal or balance is modified. Confirm the ledger's actual physical-cash nature against supporting evidence before approval.</p>
                <form id="historicalCashForm" class="card card-body mb-3">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-4"><label class="form-label" for="historicalCashLedger">Unclassified asset posting ledger</label><select id="historicalCashLedger" class="form-select" required></select></div>
                        <div class="col-md-6"><label class="form-label" for="historicalCashReason">Evidence / justification (20–500 characters)</label><textarea id="historicalCashReason" class="form-control" rows="2" minlength="20" maxlength="500" required></textarea></div>
                        <div class="col-md-2"><button type="submit" id="historicalCashSubmit" class="btn btn-primary w-100">Submit review</button></div>
                    </div>
                </form>
                <p id="historicalCashStatus" class="small fw-semibold" role="status" aria-live="polite"></p>
                <div class="table-responsive"><table class="table table-sm table-striped">
                    <thead><tr><th>Ledger</th><th>Status</th><th>Evidence</th><th>Submitted by</th><th>Submitted UTC</th><th>Reviewed by</th><th>Review</th></tr></thead>
                    <tbody id="historicalCashRows"></tbody>
                </table></div>
                <div class="d-flex justify-content-end gap-2 align-items-center mb-3">
                    <button type="button" id="historicalCashPrev" class="btn btn-outline-secondary btn-sm" disabled>Previous</button>
                    <span id="historicalCashPage" class="small"></span>
                    <button type="button" id="historicalCashNext" class="btn btn-outline-secondary btn-sm" disabled>Next</button>
                </div>
                @if (User.IsInRole("TenantAdmin")) {
                    <div id="historicalCashReview" class="card card-body d-none">
                        <h4 class="h6">Independent approval</h4>
                        <p id="historicalCashReviewTitle" class="small"></p>
                        <label for="historicalCashReviewReason">Review reason (required for rejection)</label>
                        <textarea id="historicalCashReviewReason" class="form-control mb-2" maxlength="500" rows="2"></textarea>
                        <div class="d-flex gap-2">
                            <button id="historicalCashApprove" type="button" class="btn btn-success">Approve designation</button>
                            <button id="historicalCashReject" type="button" class="btn btn-outline-danger">Reject request</button>
                            <button id="historicalCashReviewCancel" type="button" class="btn btn-outline-secondary">Cancel</button>
                        </div>
                    </div>
                }
            </div>
            <div class="tab-pane fade" id="cashFlowPolicyPanel">
                <h3 class="h6 mt-2">@(System.Globalization.CultureInfo.CurrentUICulture.Name == "bn-BD" ? "নগদ প্রবাহ শ্রেণিবিন্যাস অনুমোদন" : "Cash Flow Activity Policy Approval")</h3>
                <p class="text-muted small">@(System.Globalization.CultureInfo.CurrentUICulture.Name == "bn-BD" ? "নগদ/ব্যাংক ছাড়া অন্য GL খাতার কার্যক্রম ও কার্যকর তারিখ নির্ধারণ করুন। স্বাধীন TenantAdmin অনুমোদনের পরেই রিপোর্টে গণনা হবে। আগের নীতির ইতিহাস ও মূল journal অপরিবর্তিত থাকবে।" : "Classify a non-cash GL counterparty with an effective date. Only independent TenantAdmin approval affects the statement. Older approved policies and posted journals remain untouched.")</p>
                <form id="cashFlowRuleForm" class="card card-body mb-3">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3"><label class="form-label" for="cashFlowRuleAccount">Non-cash GL account</label><select id="cashFlowRuleAccount" class="form-select" required></select></div>
                        <div class="col-md-2"><label class="form-label" for="cashFlowRuleDate">Effective from</label><input id="cashFlowRuleDate" type="date" class="form-control" required /></div>
                        <div class="col-md-2"><label class="form-label" for="cashFlowRuleActivity">Activity</label><select id="cashFlowRuleActivity" class="form-select"><option value="Operating">Operating</option><option value="Investing">Investing</option><option value="Financing">Financing</option></select></div>
                        <div class="col-md-3"><label class="form-label" for="cashFlowRuleReason">Classification evidence (20–500 characters)</label><textarea id="cashFlowRuleReason" class="form-control" rows="2" minlength="20" maxlength="500" required></textarea></div>
                        <div class="col-md-2"><button id="cashFlowRuleSubmit" type="submit" class="btn btn-primary w-100">Submit for review</button></div>
                    </div>
                </form>
                <p id="cashFlowRuleStatus" class="small fw-semibold" role="status" aria-live="polite"></p>
                <div class="table-responsive"><table class="table table-sm table-striped">
                    <thead><tr><th>GL account</th><th>Effective</th><th>Activity</th><th>Status</th><th>Evidence</th><th>Maker</th><th>Checker</th><th>Action</th></tr></thead><tbody id="cashFlowRuleRows"></tbody>
                </table></div>
                <div class="d-flex justify-content-end align-items-center gap-2">
                    <button id="cashFlowRulePrev" type="button" class="btn btn-outline-secondary btn-sm" disabled>Previous</button><span id="cashFlowRulePage"></span>
                    <button id="cashFlowRuleNext" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next</button>
                </div>
                @if (canReview) {
                    <div id="cashFlowRuleReviewPanel" class="card card-body d-none mt-3">
                        <h4 class="h6">Independent policy review</h4><p id="cashFlowRuleReviewTitle" class="small"></p>
                        <label for="cashFlowRuleReviewReason">Checker reason (required for rejection)</label>
                        <textarea id="cashFlowRuleReviewReason" rows="2" maxlength="500" class="form-control mb-2"></textarea>
                        <div class="d-flex gap-2"><button id="cashFlowRuleApprove" type="button" class="btn btn-success">Approve</button>
                            <button id="cashFlowRuleReject" type="button" class="btn btn-outline-danger">Reject</button>
                            <button id="cashFlowRuleCancel" type="button" class="btn btn-outline-secondary">Cancel</button></div>
                    </div>
                }
            </div>
        }
    </div>
</section>
@section Scripts { <script type="module" src="~/js/finance/accounting-setup.js" asp-append-version="true"></script>
<script type="module" src="~/js/finance/accounting-cash-flow-policies.js" asp-append-version="true"></script> }
