@{
    ViewData["Title"] = "Academic Routines";
    var canManage = User.IsInRole("TenantAdmin") || User.IsInRole("Principal") || User.IsInRole("VicePrincipal");
}
@Html.AntiForgeryToken()
<section id="routineApp" class="container-fluid py-3" data-can-manage="@canManage.ToString().ToLowerInvariant()">
    <header class="mb-3 d-flex align-items-center gap-2"><h2 class="h4 mb-0">Academic Routines</h2><details class="ms-auto"><summary class="btn btn-sm btn-outline-secondary" title="Routine field guide" aria-label="Routine field guide">ⓘ</summary><div class="small p-2 border rounded bg-body">Choose a batch, assign an instructor to an offered subject, then schedule an available slot. Teacher timetable export includes the displayed page only.</div></details></header>
    <div id="routineAlert" role="alert" tabindex="-1" aria-live="polite" class="d-none"></div>
    <form id="routineFilters" class="card card-body mb-3">
        <div class="row g-3 align-items-end">
            <div class="col-lg-3"><label for="routineBatchSearch" class="form-label">Find batch by name/code</label><div class="input-group"><input id="routineBatchSearch" class="form-control" maxlength="100" placeholder="Search" /><button id="routineFindBatches" type="button" class="btn btn-outline-secondary">Find</button></div></div>
            <div class="col-lg-7"><label for="routineBatch" class="form-label">Active academic batch</label><select id="routineBatch" class="form-select" required><option value="">Loading academic batches…</option></select></div>
            <div class="col-lg-2"><button type="submit" id="routineLoad" class="btn btn-primary w-100">Load routine</button></div>
        </div>
    </form>
    <div class="card mb-3">
        <div class="card-header"><h3 class="h6 m-0">Routine time slots</h3></div>
        <div class="card-body">
            <p id="routineSlotSummary" class="small text-muted">No time slots loaded.</p>
            @if(canManage)
            {
                <form id="routineSlotForm" class="row g-2 align-items-end">
                    <div class="col-md-4"><label for="routineSlotName" class="form-label">Name</label><input id="routineSlotName" maxlength="100" class="form-control" required /></div>
                    <div class="col-md-2"><label for="routineStartTime" class="form-label">From</label><input id="routineStartTime" type="time" class="form-control" required /></div>
                    <div class="col-md-2"><label for="routineEndTime" class="form-label">To</label><input id="routineEndTime" type="time" class="form-control" required /></div>
                    <div class="col-md-2"><label class="form-check"><input id="routineIsBreak" class="form-check-input" type="checkbox" /><span class="form-check-label">Break</span></label></div>
                    <div class="col-md-2"><button id="routineSaveSlot" type="submit" class="btn btn-outline-primary w-100">Add slot</button></div>
                </form>
            }
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-header"><h3 class="h6 m-0">Assigned teachers</h3></div>
        @if(canManage)
        {
            <form id="routineAssignmentForm" class="card-body border-bottom">
                <div class="row g-2 align-items-end">
                    <div class="col-lg-3"><label for="routineTeacherSearch" class="form-label">Search teacher</label><div class="input-group"><input id="routineTeacherSearch" class="form-control" maxlength="100" placeholder="Name/code prefix" /><button id="routineFindTeachers" class="btn btn-outline-secondary" type="button">Find</button></div></div>
                    <div class="col-lg-3"><label for="routineTeacher" class="form-label">Active teacher</label><select id="routineTeacher" class="form-select" required><option value="">Search teachers</option></select></div>
                    <div class="col-lg-3"><label for="routineSubject" class="form-label">Offered subject</label><select id="routineSubject" class="form-select" required><option value="">Load a batch</option></select></div>
                    <div class="col-lg-2"><label class="form-check"><input type="checkbox" class="form-check-input" id="routinePrimary" checked /><span class="form-check-label">Primary</span></label></div>
                    <div class="col-lg-1"><button id="routineAssign" class="btn btn-primary w-100" type="submit">Assign</button></div>
                    <div class="col-lg-4"><label for="routineOfferingSearch" class="form-label">Find offered subject</label><div class="input-group"><input id="routineOfferingSearch" class="form-control" maxlength="100" placeholder="Subject/code prefix" /><button id="routineFindOfferings" type="button" class="btn btn-outline-secondary">Find</button></div></div>
                    <div class="col-lg-4 d-flex align-items-end gap-2"><button id="routineOfferingsPrev" type="button" class="btn btn-outline-secondary btn-sm">Previous</button><span id="routineOfferingPage" class="small text-muted" aria-live="polite">No offerings loaded</span><button id="routineOfferingsNext" type="button" class="btn btn-outline-secondary btn-sm">Next</button></div>
                    <div class="col-lg-2"><label for="routineAssignFrom" class="form-label">Assignment from</label><input id="routineAssignFrom" type="date" class="form-control" required /></div>
                    <div class="col-lg-2"><label for="routineAssignTo" class="form-label">Assignment to (optional)</label><input id="routineAssignTo" type="date" class="form-control" /></div>
                </div>
            </form>
        }
        <div class="card-body border-bottom">
            <div class="row g-2 align-items-end">
                <div class="col-md-7"><label for="routineAssignmentSearch" class="form-label">Find assigned teacher / offering</label><input id="routineAssignmentSearch" class="form-control" maxlength="100" placeholder="Teacher name, code or offering" /></div>
                <div class="col-md-2"><button id="routineFindAssignments" type="button" class="btn btn-outline-secondary w-100">Find</button></div>
                <div class="col-md-3 d-flex align-items-center justify-content-end gap-2">
                    <button id="routineAssignmentsPrev" type="button" class="btn btn-sm btn-outline-secondary" disabled>Previous</button>
                    <span id="routineAssignmentsPage" class="small text-muted" aria-live="polite">No assignments loaded</span>
                    <button id="routineAssignmentsNext" type="button" class="btn btn-sm btn-outline-secondary" disabled>Next</button>
                </div>
            </div>
        </div>
        <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Teacher</th><th>Employee code</th><th>Offering ID</th><th>Role</th></tr></thead><tbody id="routineAssignments"><tr><td colspan="4" class="text-muted text-center p-3">Load a batch.</td></tr></tbody></table></div>
    </div>
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center"><h3 class="h6 m-0">Class timetable</h3><button id="routineExportBatch" type="button" class="btn btn-sm btn-outline-secondary">Export current page CSV</button></div>
        @if(canManage)
        {
            <form id="routineEntryForm" class="card-body border-bottom row g-2 align-items-end">
                <div class="col-lg-3"><label for="routineAssignment" class="form-label">Instructor / offering</label><select id="routineAssignment" class="form-select" required><option value="">Select batch</option></select></div>
                <div class="col-lg-2"><label for="routineSlot" class="form-label">Time slot</label><select id="routineSlot" class="form-select" required><option value="">Select a slot</option></select></div>
                <div class="col-lg-2"><label for="routineDay" class="form-label">Day</label><select id="routineDay" class="form-select">@foreach(var day in Enum.GetValues<DayOfWeek>()){<option value="@((int)day)">@day</option>}</select></div>
                <div class="col-lg-3"><label for="routineRoom" class="form-label">Room (optional)</label><select id="routineRoom" class="form-select"><option value="">No room</option></select></div>
                <div class="col-lg-2"><button id="routineAddEntry" type="submit" class="btn btn-primary w-100">Add class</button></div>
                <div class="col-lg-3"><label for="routineEntryFrom" class="form-label">Routine effective from</label><input id="routineEntryFrom" type="date" class="form-control" required /></div>
                <div class="col-lg-3"><label for="routineEntryTo" class="form-label">Routine effective to (optional)</label><input id="routineEntryTo" type="date" class="form-control" /></div>
            </form>
        }
        <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead><tr><th>Day</th><th>Time slot</th><th>Subject</th><th>Room</th><th>Effective</th>@if(canManage){<th>Action</th>}</tr></thead><tbody id="routineEntries"><tr><td colspan="6" class="text-muted text-center p-3">Load a batch.</td></tr></tbody></table></div>
        <nav class="card-body d-flex align-items-center gap-2 justify-content-end" aria-label="Class timetable pages">
            <button id="routineBatchPrev" type="button" class="btn btn-sm btn-outline-secondary" disabled>Previous</button>
            <span id="routineBatchPage" class="small text-muted" aria-live="polite">No timetable loaded</span>
            <button id="routineBatchNext" type="button" class="btn btn-sm btn-outline-secondary" disabled>Next</button>
        </nav>
    </div>
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center"><h3 class="h6 m-0">Teacher timetable</h3><button id="routineExportTeacher" type="button" class="btn btn-sm btn-outline-secondary">Export CSV</button></div>
        <div class="card-body">
            <div class="row g-2 align-items-end mb-3"><div class="col-lg-8"><label for="routineTeacherTimetable" class="form-label">Teacher assigned to this batch</label><select id="routineTeacherTimetable" class="form-select"><option value="">Select batch</option></select></div><div class="col-lg-4"><button id="routineShowTeacher" class="btn btn-outline-primary w-100" type="button">View schedule</button></div></div>
            <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Day</th><th>Slot</th><th>Subject</th><th>Room</th></tr></thead><tbody id="routineTeacherEntries"></tbody></table></div>
            <nav class="d-flex align-items-center gap-2 justify-content-end" aria-label="Teacher timetable pages">
                <button id="routineTeacherPrev" type="button" class="btn btn-sm btn-outline-secondary" disabled>Previous</button>
                <span id="routineTeacherPage" class="small text-muted" aria-live="polite">No timetable loaded</span>
                <button id="routineTeacherNext" type="button" class="btn btn-sm btn-outline-secondary" disabled>Next</button>
            </nav>
        </div>
    </div>
</section>
@section Scripts { <script src="~/js/academic/routines.js" asp-append-version="true"></script> }
