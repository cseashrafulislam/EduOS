@{
    ViewData["Title"] = "Institution Type Availability";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section id="institutionTypeAdministration" class="container-fluid py-3">
    @Html.AntiForgeryToken()
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div><h1 class="h4">Institution Type Availability</h1>
            <p class="text-muted">Control which institution types appear during new registration. Existing institutions are not modified.</p></div>
        <button id="catalogRefresh" class="btn btn-outline-secondary" type="button">Refresh</button>
    </div>
    <p id="catalogMessage" role="status" aria-live="polite"></p>
    <div class="table-responsive"><table class="table table-striped table-sm">
        <thead><tr><th>Institution type</th><th>Code</th><th>Academic cycle</th><th>Registration</th><th>Action</th></tr></thead>
        <tbody id="catalogRows"><tr><td colspan="5">Loading…</td></tr></tbody>
    </table></div>
</section>
@section Scripts {
    <script src="~/js/platform/institution-type-administration.js" asp-append-version="true"></script>
}
