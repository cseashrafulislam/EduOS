{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=EduOS;Trusted_Connection=true;TrustServerCertificate=true;"
  },
  "DatabaseInitialization": {
    "Enabled": false,
    "ApplyMigrations": false
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "https://api.eduos.com",
    "Audience": "https://app.eduos.com",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ClockSkewSeconds": 5
  },
  "TenantSettings": {
    "ResolutionStrategy": "Subdomain"
  },
  "TenantPortal": {
    "BaseDomain": "eduos.com"
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderName": "EduOS",
    "SenderEmail": "",
    "Password": "",
    "EnableSsl": true
  },
  "SmsSettings": {
    "ApiUrl": "https://api.bulksmsbd.com/api/sms/send",
    "ApiKey": "",
    "ApiSecret": "",
    "SenderId": "EduOS",
    "TimeoutSeconds": 30,
    "MaxRetries": 3,
    "EnableLogging": false,
    "CountryCode": "88"
  },
  "FileStorage": {
    "BasePath": "wwwroot/uploads",
    "PrivateBasePath": "App_Data/private-uploads",
    "MaxFileSizeMB": 10,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp", ".pdf", ".doc", ".docx", ".xls", ".xlsx" ],
    "AllowedMimeTypes": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "application/pdf",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
    ],
    "EnableVirusScan": false,
    "GenerateThumbnails": true,
    "MaxFilesPerFolder": 10000,
    "UrlPrefix": "/uploads"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "EduOS:"
  },
  "Hangfire": {
    "DashboardPath": "/hangfire",
    "WorkerCount": 5
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "https://eduos.com" ]
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/eduos-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Payments": {
    "AamarPay": {
      "IsSandbox": true,
      "StoreId": "",
      "SignatureKey": "",
      "CallbackBaseUrl": ""
    }
  },
  "ManualPayment": {
    "BankName": "",
    "AccountName": "",
    "AccountNumber": "",
    "RoutingNumber": "",
    "BranchName": "",
    "Instructions": ""
  },
  "SSLCommerz": {
    "IsSandbox": true,
    "StoreId": "",
    "StorePassword": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
