  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "https://eduos.com" ]
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/eduos-.log",
          "rollingInterval": "Day"
