<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EduOS.Core\EduOS.Core.csproj" />
    <ProjectReference Include="..\EduOS.Persistence\EduOS.Persistence.csproj" />
    <ProjectReference Include="..\EduOS.Service\EduOS.Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\EduOS.App\Resources\Localization\SharedResource.resx"
          Link="TestAssets\SharedResource.resx"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EduOS.App\Resources\Localization\SharedResource.bn-BD.resx"
          Link="TestAssets\SharedResource.bn-BD.resx"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EduOS.App\Views\Shared\_Layout.cshtml"
          Link="TestAssets\_Layout.cshtml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EduOS.App\Views\Account\_OnboardingLayout.cshtml"
          Link="TestAssets\_OnboardingLayout.cshtml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EduOS.App\Views\Shared\_PublicLayout.cshtml"
          Link="TestAssets\_PublicLayout.cshtml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EduOS.App\Views\Account\Login.cshtml"
          Link="TestAssets\Login.cshtml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EduOS.App\Views\Account\Signup.cshtml"
          Link="TestAssets\Signup.cshtml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EduOS.App\Views\Pricing\Index.cshtml"
          Link="TestAssets\Pricing.cshtml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EduOS.App\wwwroot\js\account\login.js"
          Link="TestAssets\login.js"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EduOS.App\wwwroot\js\account\signup.js"
          Link="TestAssets\signup.js"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EduOS.App\wwwroot\js\account\auth-forms.js"
          Link="TestAssets\auth-forms.js"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EduOS.App\wwwroot\manifest.webmanifest"
          Link="TestAssets\manifest.webmanifest"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EduOS.App\wwwroot\service-worker.js"
          Link="TestAssets\service-worker.js"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
